/**
 * @file artifact_handler.cppm
 * @brief Writes generated client files and registers them with CMake.
 */
module;

#include <filesystem>
#include <sstream>
#include <string>
#include <string_view>
#include <utility>

module bioseq.codegen.external:artifact_handler;

import :client_renderer;
import :model;
import bioseq.codegen.support;

namespace fs = std::filesystem;

namespace bioseq::codegen::external {

/// @brief Returns the output directory for one  client.
/// @param output_root Root of all external-codegen output.
/// @param client_name Client name.
/// @return `<output_root>/api/<client_name>`.
[[nodiscard]] fs::path client_artifact_root(
    const fs::path& output_root,
    std::string_view client_name) {
    return output_root / "api" / client_name;
}

/// @brief Returns a client's integration-test path.
/// @param client_name Client name.
/// @return Path relative to the client's output directory.
[[nodiscard]] fs::path client_integration_test_path(
    std::string_view client_name) {
    return fs::path("tests") / "integration"
        / (std::string(client_name) + "_client_test.cpp");
}

/// @brief Generates CMake code that registers a client with the build.
/// @param api Validated API description.
/// @return CMakeLists.txt contents for the client.
[[nodiscard]] std::string render_client_cmake(const generated_api& api) {
    std::ostringstream cmake_source;
    cmake_source
        << "# Generated by bioseq_external_codegen.\n"
        << "include(\"${CMAKE_CURRENT_LIST_DIR}/../../generated_client.cmake\")\n"
        << "bioseq_register_generated_api_client(\n"
        << "  CLIENT_NAME \"" << api.client_name << "\"\n"
        << "  CLIENT_ROOT \"${CMAKE_CURRENT_LIST_DIR}\")\n";
    return cmake_source.str();
}

/// @brief Writes the generated client, tests and build metadata.
/// @param api Validated API description.
/// @param output_root Directory for generated output.
/// @param compiler_id Compiler name recorded in provenance.txt.
/// @details Files keep their timestamps when theii contents have not changed.
void emit_client_artifacts(
    const generated_api& api,
    const fs::path& output_root,
    std::string_view compiler_id) {
    const fs::path client_root = client_artifact_root(output_root, api.client_name);
    publish_artifact_if_changed(client_root / "client/index.cppm", render_module(api));
    publish_artifact_if_changed(
        client_root / client_integration_test_path(api.client_name),
        render_test(api));
    publish_artifact_if_changed(
        client_root / "CMakeLists.txt",
        render_client_cmake(api));

    std::ostringstream manifest;
    manifest << "client\t" << api.client_name << '\n'
             << "module\tbioseq.external.api." << make_cpp_identifier(api.client_name) << '\n'
             << "class\t" << api.declared_type << '\n'
             << "get_operations\t" << api.document.get_operations.size() << '\n'
             << "integration_cases\t" << api.document.integration_cases.size() << '\n';
    publish_artifact_if_changed(client_root / "manifest.tsv", manifest.str());

    std::ostringstream provenance;
    provenance << "generator_compiler=GCC-16\n"
               << "client_compiler=" << compiler_id << '\n'
               << "parser=cppast/libclang\n"
               << "openapi_title=" << api.document.title << '\n';
    publish_artifact_if_changed(client_root / "provenance.txt", provenance.str());
}

/// @brief Takes the client name from its descriptor filename.
/// @param source_path Descriptor path.
/// @return Filename without its extension.
[[nodiscard]] std::string derive_client_output_name(
    const fs::path& source_path) {
    return source_path.stem().string();
}

/// @brief Returns a client's output  directory relative to the generator root.
/// @param output_name Client name.
/// @return Relative `api/<name>` path.
[[nodiscard]] fs::path derive_client_owned_output_path(
    std::string_view output_name) {
    return fs::path("api") / output_name;
}

/// @brief Checks whether every required artifact for one client exists.
/// @param output_root Generator-owned artifact root.
/// @param output_name Client output identity.
/// @return True only when the complete current output set is present.
[[nodiscard]] bool has_complete_client_output(
    const fs::path& output_root,
    std::string_view output_name) {
    const fs::path client_root = client_artifact_root(output_root, output_name);
    return fs::exists(client_root / "client/index.cppm")
        && fs::exists(client_root / client_integration_test_path(output_name))
        && fs::exists(client_root / "CMakeLists.txt")
        && fs::exists(client_root / "manifest.tsv")
        && fs::exists(client_root / "provenance.txt");
}

/// @brief Adds a generated client directory to the CMake build list.
/// @param inventory Output stream for the list.
/// @param output_name Client name.
void append_client_build_inventory(
    std::ostringstream& inventory,
    std::string_view output_name) {
    inventory << "add_subdirectory(\"${CMAKE_CURRENT_LIST_DIR}/api/"
              << output_name << "\")\n";
}

} // namespace bioseq::codegen::external
