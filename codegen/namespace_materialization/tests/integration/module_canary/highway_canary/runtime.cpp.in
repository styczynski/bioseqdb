// The Clang and GCC tests use Highway headers without linkig libhwy.
// Highway 1.3.0 still needs definitions of SupportedTargets() and
// GetChosenTarget(), so  this file supplies them. Highway's own headers
// provide the target table, dispatch macros and vector operations.
// HWY_HEADER_ONLY supplies Warn and Abort inline. The GCC test also checks
// the installed header hashes before compilation.
#define HWY_COMPILE_ALL_ATTAINABLE 1
#define HWY_DISABLED_TARGETS (~(@SIMD_TARGET_TOKEN@ | HWY_EMU128))
#define HWY_HEADER_ONLY 1
#define HWY_STATIC_DEFINE 1
@PLATFORM_HEADER_OVERRIDES@
#include <hwy/highway.h>

#include <cstdint>

namespace hwy {

HWY_DLLEXPORT auto SupportedTargets() -> std::int64_t {
  // Report the host's baseline SIMD target and the EMU128 software fallback.
  // The extra attribute-test target is compiled and linked but never selected
  // by this runtime mask.
  return @SIMD_TARGET_TOKEN@ | HWY_EMU128;
}

HWY_DLLEXPORT auto GetChosenTarget() -> ChosenTarget& {
  static ChosenTarget chosen_target;
  return chosen_target;
}

}  // namespace hwy
