module;

// Runtime dispatch includes the baseline SIMD target and EMU128. The
// extra target used to test attributes is compiled separately and stays
// outside this dispatch table.
#define HWY_COMPILE_ALL_ATTAINABLE 1
#define HWY_DISABLED_TARGETS (~(@SIMD_TARGET_TOKEN@ | HWY_EMU128))
#define HWY_HEADER_ONLY 1
#define HWY_STATIC_DEFINE 1
@PLATFORM_HEADER_OVERRIDES@
#include <hwy/highway.h>

#include <cstdint>

module bioseq.highway.gcc_canary:highway_registry;

import bioseq.highway.gcc_canary;
import bioseq.highway.gcc_canary.contract;
import @SIMD_TARGET_MODULE@;
import @ATTRIBUTED_TARGET_MODULE@;
import @FALLBACK_TARGET_MODULE@;

namespace bioseq::highway_gcc_canary {

static_assert(HWY_TARGETS == (@SIMD_TARGET_TOKEN@ | HWY_EMU128));
static_assert(HWY_STATIC_TARGET == @SIMD_TARGET_TOKEN@);

// This is the test's only HWY_EXPORT dispatch table.
HWY_EXPORT(bind_highway_target);

using target_binder = const target_binding* (*)();

// Taking a volatile function address forces the attributed target to link.
// It stays outside HWY_TARGETS, so runtime dispatch cannot select it.
[[nodiscard]] auto attributed_binder_is_linked() noexcept -> bool {
  static target_binder volatile binder =
      &@ATTRIBUTED_TARGET_NAMESPACE@::bind_highway_target;
  return binder != nullptr;
}

[[nodiscard]] auto select_target(
    const std::int64_t target) noexcept -> const target_binding* {
  constexpr std::int64_t compiled_targets =
      @SIMD_TARGET_TOKEN@ | HWY_EMU128;
  if (target != 0
      && ((target & (target - 1)) != 0
          || (compiled_targets & target) == 0)) {
    return nullptr;
  }
  if (target == 0) {
    // Reset the target cache so the first dispatch calls hwy::SupportedTargets().
    hwy::GetChosenTarget().DeInit();
  } else {
    hwy::GetChosenTarget().Update(target);
  }
  const auto* binding = HWY_DYNAMIC_DISPATCH(bind_highway_target)();
  const std::int64_t expected_target =
      target == 0 ? @SIMD_TARGET_TOKEN@ : target;
  return binding != nullptr && binding->complete()
          && binding->target == expected_target
      ? binding
      : nullptr;
}

[[nodiscard]] constexpr auto second_target() noexcept -> std::int64_t {
  return HWY_EMU128;
}

}  // namespace bioseq::highway_gcc_canary
