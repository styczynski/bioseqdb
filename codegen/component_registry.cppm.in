module;

#include <array>
#include <span>
#include <string_view>

export module bioseq.codegen:components;

// Generated by codegen/CMakeLists.txt (configure_file). The CLI uses this
// list to find the components compiled into the binary. Change the component
// set in CMake and regenerate this file.
@BIOSEQ_CODEGEN_COMPONENT_IMPORTS@

export namespace bioseq::codegen {

/// @brief A generator component's name, command handler and self-test handler.
struct component_entry {
    std::string_view name;
    int (*self_test)();
    int (*run)(std::span<std::string_view const>);
};

/// @brief The components CMake compiled into this binary, in registration order.
[[nodiscard]] inline auto registered_components()
    -> std::span<const component_entry> {
    static constexpr auto table = std::to_array<component_entry>({
@BIOSEQ_CODEGEN_COMPONENT_ENTRIES@
    });
    return table;
}

}  // namespace bioseq::codegen
