#ifndef BIOSEQ_TEST_INDEXES
#error "fixed-target unit probes require BIOSEQ_TEST_INDEXES"
#endif

#include "common/simd/highway_test_probes/contract.h"

module @BIOSEQ_HIGHWAY_PROBE_PRIMARY_MODULE@;

import std;
import :simd_utils;

namespace bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail {

namespace hn = hwy::HWY_NAMESPACE;

template<class p_element>
[[nodiscard]] bool matrix_equal(
    const std::vector<std::vector<p_element>>& actual,
    const std::vector<std::vector<p_element>>& expected) {
    return actual == expected;
}

template<class p_element>
[[nodiscard]] std::vector<p_element> increasing(
    const std::size_t size,
    p_element value = p_element{}) {
    std::vector<p_element> result(size);
    for (p_element& element : result) element = value++;
    return result;
}

template<class p_element>
[[nodiscard]] std::vector<std::vector<p_element>> square_increasing(
    const std::size_t lanes) {
    std::vector<std::vector<p_element>> result(
        lanes, std::vector<p_element>(lanes));
    p_element value{};
    for (auto& row : result) {
        for (p_element& element : row) element = value++;
    }
    return result;
}

template<class p_element>
[[nodiscard]] std::vector<p_element> flatten(
    const std::vector<std::vector<p_element>>& matrix) {
    std::vector<p_element> result;
    for (const auto& row : matrix) {
        result.insert(result.end(), row.begin(), row.end());
    }
    return result;
}

template<std::size_t p_row_count>
[[nodiscard]] std::array<std::size_t, p_row_count> matrix_row_offsets(
    const std::size_t lanes,
    const std::size_t row_context) {
    std::array<std::size_t, p_row_count> offsets{};
    const std::size_t row_stride = lanes - row_context;
    for (std::size_t row = 0u; row < p_row_count; ++row) {
        offsets[row] = row * row_stride;
    }
    return offsets;
}

template<class p_element, class p_simd_tag, std::size_t p_row_count>
[[nodiscard]] std::vector<std::vector<p_element>> materialize_matrix_rows(
    const p_simd_tag& simd_tag,
    const std::array<hn::Vec<p_simd_tag>, p_row_count>& storage) {
    const std::size_t lanes = hn::Lanes(simd_tag);
    std::vector<std::vector<p_element>> result(
        lanes, std::vector<p_element>(lanes));
    for (std::size_t row = 0u; row < lanes; ++row) {
        hn::StoreU(storage[row], simd_tag, result[row].data());
    }
    return result;
}

template<class p_element>
[[nodiscard]] bool check_load_rows() {
    using simd_tag_type = hn::ScalableTag<p_element>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    const auto expected = square_increasing<p_element>(lanes);
    const auto input = flatten(expected);
    HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
    square_lane_matrix<simd_tag_type> matrix{buffer.data()};
    const auto offsets = matrix_row_offsets<k_maximum_lanes>(lanes, 0u);
    matrix.load_rows_at_offsets(simd_tag, offsets, input.data());
    return matrix_equal(
        materialize_matrix_rows<p_element>(simd_tag, buffer), expected);
}

template<class p_element>
[[nodiscard]] bool check_transpose_in_place() {
    using simd_tag_type = hn::ScalableTag<p_element>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    if (lanes != 1u && lanes != 2u && lanes != 4u && lanes != 8u
        && lanes != 16u) {
        return false;
    }
    const auto source = square_increasing<p_element>(lanes);
    const auto input = flatten(source);
    std::vector<std::vector<p_element>> expected(
        lanes, std::vector<p_element>(lanes));
    for (std::size_t row = 0u; row < lanes; ++row) {
        for (std::size_t column = 0u; column < lanes; ++column) {
            expected[row][column] = source[column][row];
        }
    }
    HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
    square_lane_matrix<simd_tag_type> matrix{buffer.data()};
    const auto offsets = matrix_row_offsets<k_maximum_lanes>(lanes, 0u);
    matrix.load_rows_at_offsets(simd_tag, offsets, input.data());
    matrix.transpose_in_place(simd_tag);
    return matrix_equal(
        materialize_matrix_rows<p_element>(simd_tag, buffer), expected);
}

template<class p_element>
[[nodiscard]] bool check_load_bounded_rows(std::uint32_t& cases) {
    using simd_tag_type = hn::ScalableTag<p_element>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    const std::size_t storage_size = lanes * lanes * 4u;
    const auto data = increasing<p_element>(storage_size, p_element{1});
    for (const std::size_t context : {0u, 1u, 3u}) {
        if (context > lanes) continue;
        const std::size_t row_offset = lanes - context;
        const std::size_t available = std::min(
            storage_size, lanes + (lanes - 1u) * row_offset);
        for (const bool full : {false, true}) {
            HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
            square_lane_matrix<simd_tag_type> matrix{buffer.data()};
            const auto offsets =
                matrix_row_offsets<k_maximum_lanes>(lanes, context);
            if (full) {
                matrix.load_rows_at_offsets(
                    simd_tag, offsets, data.data());
            } else {
                matrix.load_bounded_rows_at_offsets(
                    simd_tag, available, offsets, data.data());
            }
            std::vector<std::vector<p_element>> expected(
                lanes, std::vector<p_element>(lanes));
            for (std::size_t row = 0u; row < lanes; ++row) {
                for (std::size_t column = 0u; column < lanes; ++column) {
                    const std::size_t source = row * row_offset + column;
                    expected[row][column] = full || source < available
                        ? data[source]
                        : p_element{};
                }
            }
            ++cases;
            if (!matrix_equal(
                    materialize_matrix_rows<p_element>(simd_tag, buffer),
                    expected)) {
                return false;
            }
        }
    }
    return true;
}

template<class p_element>
[[nodiscard]] bool check_load_rows_at_explicit_offsets() {
    using simd_tag_type = hn::ScalableTag<p_element>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    const auto expected = square_increasing<p_element>(lanes);
    const auto input = flatten(expected);
    std::array<std::size_t, k_maximum_lanes> offsets{};
    for (std::size_t lane = 0u; lane < lanes; ++lane) {
        offsets[lane] = lane * lanes;
    }
    HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
    square_lane_matrix<simd_tag_type> matrix{buffer.data()};
    return matrix.load_rows_at_offsets(
               simd_tag, offsets, input.data()) == lanes
        && matrix_equal(
            materialize_matrix_rows<p_element>(simd_tag, buffer), expected);
}

[[nodiscard]] bool check_load_bounded_rows_at_explicit_offsets(
    std::uint32_t& cases) {
    using element_type = std::uint8_t;
    using simd_tag_type = hn::ScalableTag<element_type>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    const std::size_t storage_size = lanes * lanes * 4u;
    const auto data = increasing<element_type>(
        storage_size, element_type{1});
    for (const std::int32_t fake_context : {0, -1, -3, 1, 3, 5}) {
        const std::int64_t signed_offset =
            static_cast<std::int64_t>(lanes) + fake_context;
        if (signed_offset <= 0) continue;
        const std::size_t equal_offset =
            static_cast<std::size_t>(signed_offset);
        std::array<std::size_t, k_maximum_lanes> offsets{};
        for (std::size_t lane = 0u; lane < lanes; ++lane) {
            offsets[lane] = equal_offset * lane;
        }
        const std::size_t available = std::min(
            storage_size, lanes + (lanes - 1u) * equal_offset);
        for (const bool full : {false, true}) {
            HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
            square_lane_matrix<simd_tag_type> matrix{buffer.data()};
            std::size_t loaded_full = lanes;
            std::size_t loaded_partial = 0u;
            if (full) {
                if (matrix.load_rows_at_offsets(
                        simd_tag, offsets, data.data())
                    != lanes) {
                    return false;
                }
            } else {
                std::tie(loaded_full, loaded_partial) =
                    matrix.load_bounded_rows_at_offsets(
                        simd_tag, available, offsets, data.data());
            }
            std::vector<std::vector<element_type>> expected(
                lanes, std::vector<element_type>(lanes));
            std::size_t expected_full = 0u;
            std::size_t expected_partial = 0u;
            for (std::size_t row = 0u; row < lanes; ++row) {
                std::size_t missing = 0u;
                for (std::size_t column = 0u; column < lanes; ++column) {
                    const std::size_t source = row * equal_offset + column;
                    const bool present = full || source < available;
                    expected[row][column] =
                        present ? data[source] : element_type{};
                    if (!present) ++missing;
                }
                if (missing == 0u) {
                    ++expected_full;
                } else if (missing != lanes) {
                    expected_partial = lanes - missing;
                }
            }
            if (!full) expected_full += k_maximum_lanes - lanes;
            ++cases;
            if (!matrix_equal(
                    materialize_matrix_rows<element_type>(simd_tag, buffer),
                    expected)
                || (!full && (loaded_full != expected_full
                    || loaded_partial != expected_partial))) {
                return false;
            }
        }
    }
    return true;
}

template<class p_element>
[[nodiscard]] bool check_double_transpose_in_place() {
    using simd_tag_type = hn::ScalableTag<p_element>;
    using vector_type = hn::Vec<simd_tag_type>;
    simd_tag_type simd_tag;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    const std::size_t lanes = hn::Lanes(simd_tag);
    if (lanes != 1u && lanes != 2u && lanes != 4u && lanes != 8u
        && lanes != 16u) {
        return false;
    }
    const auto expected = square_increasing<p_element>(lanes);
    const auto input = flatten(expected);
    HWY_ALIGN std::array<vector_type, k_maximum_lanes> buffer{};
    square_lane_matrix<simd_tag_type> matrix{buffer.data()};
    const auto offsets = matrix_row_offsets<k_maximum_lanes>(lanes, 0u);
    matrix.load_rows_at_offsets(simd_tag, offsets, input.data());
    matrix.transpose_in_place(simd_tag);
    matrix.transpose_in_place(simd_tag);
    return matrix_equal(
        materialize_matrix_rows<p_element>(simd_tag, buffer), expected);
}

template<class p_function>
[[nodiscard]] bool run_for_widths(
    p_function&& function,
    std::uint32_t& cases) {
    bool result = true;
    const auto run = [&]<class p_element>() {
        ++cases;
        result = result && function.template operator()<p_element>();
    };
    run.template operator()<std::uint8_t>();
    run.template operator()<std::uint16_t>();
    run.template operator()<std::uint32_t>();
    run.template operator()<std::uint64_t>();
    return result;
}

}  // namespace bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail

extern "C" bool bioseq_highway_run_simd_utils_probe(
    bioseq_highway_simd_utils_probe_receipt* receipt) noexcept {
    if (receipt == nullptr) return false;
    *receipt = {};
    receipt->target = static_cast<std::int64_t>(HWY_TARGET);
    namespace probe =
        bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail;
    try {
        const auto record = [&] (const std::uint64_t bit, const bool passed) {
            if (passed) receipt->passed_properties |= bit;
        };
        std::uint32_t cases = 0u;
        record(1u << 0u, probe::run_for_widths(
            []<class p_element> {
                return probe::check_load_rows<p_element>();
            }, cases));
        record(1u << 1u, probe::run_for_widths(
            []<class p_element> {
                return probe::check_transpose_in_place<p_element>();
            }, cases));
        bool partial = true;
        const auto partial_width = [&]<class p_element>() {
            partial = partial
                && probe::check_load_bounded_rows<p_element>(cases);
        };
        partial_width.template operator()<std::uint8_t>();
        partial_width.template operator()<std::uint16_t>();
        partial_width.template operator()<std::uint32_t>();
        partial_width.template operator()<std::uint64_t>();
        record(1u << 2u, partial);
        record(1u << 3u, probe::run_for_widths(
            []<class p_element> {
                return probe::check_load_rows_at_explicit_offsets<p_element>();
            },
            cases));
        record(
            1u << 4u,
            probe::check_load_bounded_rows_at_explicit_offsets(cases));
        record(1u << 5u, probe::run_for_widths(
            []<class p_element> {
                return probe::check_double_transpose_in_place<p_element>();
            },
            cases));
        receipt->cases_run = cases;
        receipt->cases_passed = receipt->passed_properties == 0x3fu
            ? cases
            : 0u;
        receipt->u8_lanes = static_cast<std::uint32_t>(
            hwy::HWY_NAMESPACE::Lanes(
                hwy::HWY_NAMESPACE::ScalableTag<std::uint8_t>{}));
        receipt->u16_lanes = static_cast<std::uint32_t>(
            hwy::HWY_NAMESPACE::Lanes(
                hwy::HWY_NAMESPACE::ScalableTag<std::uint16_t>{}));
        receipt->u32_lanes = static_cast<std::uint32_t>(
            hwy::HWY_NAMESPACE::Lanes(
                hwy::HWY_NAMESPACE::ScalableTag<std::uint32_t>{}));
        receipt->u64_lanes = static_cast<std::uint32_t>(
            hwy::HWY_NAMESPACE::Lanes(
                hwy::HWY_NAMESPACE::ScalableTag<std::uint64_t>{}));
        return receipt->passed_properties == 0x3fu;
    } catch (...) {
        return false;
    }
}
