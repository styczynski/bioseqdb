/**
 * @file
 * @brief Tests that scalar and SIMD hashers agree on each compiled CPU target
 */

#ifndef BIOSEQ_TEST_INDEXES
#error "fixed-target unit probes require BIOSEQ_TEST_INDEXES"
#endif

module @BIOSEQ_HIGHWAY_PROBE_PRIMARY_MODULE@;

import std;
import bioseq.highway.test_probe_contract;
import bioseq.common.seqan_adapter;
import bioseq.sequences;
import bioseq.sequences.kmers.hashers.base;
import bioseq.sequences.kmers.hashers.lexic;
import bioseq.sequences.kmers.hashers.minimap_int;
import :hasher_base;
import :hasher_lexic;
import :hasher_minimap_int;
import :sequence_ops;

namespace bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail {

namespace hn = hwy::HWY_NAMESPACE;

/**
 * @brief Builds the fixed DNA4 sequence used by both hash implementations.
 */
[[nodiscard]] auto short_dna4_sequence() -> std::vector<seq::dna4> {
    constexpr std::string_view k_bases =
        "ACTGTAGCTGATCGTAGCTAGTCACTGTAGCT"
        "GTCGTAGCTAGTCCGTAATCGTAGCTAGTCAA"
        "ACTGTATCGTAGCTAGTCCGTAGCTACTGTAG"
        "CTGATCGTAGCTAGTCACTGTAGGATCGTAGC"
        "TAGTCCGTACTGTAGCTGATCGTAGCCCTAGT"
        "CACTGTAGCTGATCGTAGCTAGTCACTGTAGC"
        "TGATCGTAGCTAGTCTCGTAGCTAGTCCGTAA"
        "CTGTAGCTGATCGTAGCTAGTCACTGTAGCTG"
        "ATCGTAGCTAGTC";
    std::vector<seq::dna4> result(k_bases.size());
    for (std::size_t index = 0U; index < k_bases.size(); ++index) {
        result[index].assign_char(k_bases[index]);
    }
    return result;
}

/**
 * @brief Compares scalar and SIMD position/hash sets for one packed word type.
 *
 * Both paths hash  the same DNA4 sequence. Comparing sets allows SIMD
 * lanes to emit pairs in a different order and removes duplicate pairs.
 * @tparam p_input Unsigned packed storage type.
 * @tparam p_scalar_hasher Scalar hasher.
 * @tparam p_simd_hasher SIMD hasher compiled for this CPU target.
 * @return True when the sets match.
 */
template<
    class p_input,
    template<class p_alphabet> class p_scalar_hasher,
    template<class p_alphabet> class p_simd_hasher>
[[nodiscard]] auto hasher_set_parity() -> bool {
    using alphabet_storage_type =
        sequence_custom_alphabet<seq::dna4, p_input>;
    using range_type = compact_sequence_range<alphabet_storage_type>;
    using traits_type = typename range_type::traits;
    using simd_tag_type = hn::ScalableTag<p_input>;
    constexpr std::size_t k_maximum_lanes =
        hn::MaxLanes(simd_tag_type{});
    constexpr std::size_t k_kmer_length = 10U;

    auto source = short_dna4_sequence();
    range_type sequence{source};
    typename p_scalar_hasher<seq::dna4>::template scalar_hash<p_input>
        scalar_hasher{k_kmer_length};
    simd_tag_type simd_tag;
    typename p_simd_hasher<seq::dna4>::template simd_hash<
        p_input, simd_tag_type> simd_hasher{simd_tag, k_kmer_length};

    std::vector<std::pair<std::size_t, p_input>> scalar_results;
    std::vector<std::pair<std::size_t, p_input>> simd_results;
    scalar_results.reserve(sequence.bp_size());
    simd_results.reserve(sequence.bp_size());

    std::size_t position = 0U;
    for (const auto rank : sequence.template iterable<logical_rank>()) {
        const auto [hash, strand] = scalar_hasher.next(
            static_cast<p_input>(rank), static_cast<p_input>(rank));
        (void)strand;
        if (position >= k_kmer_length) {
            scalar_results.emplace_back(position, hash);
        }
        ++position;
    }

    position = 0U;
    iterate_sequence_bp_simd_offsets(
        sequence, sequence.begin(), sequence.end(), k_kmer_length,
        [&simd_hasher, &position, &simd_results]<bool p_is_full>(
            std::bool_constant<p_is_full>,
            const auto& offsets,
            auto& callback_simd_tag,
            auto& mask,
            auto&& incoming,
            auto,
            auto outgoing) -> void {
            const auto hash = simd_hasher.next(
                callback_simd_tag, incoming, outgoing);
            if (position >= k_kmer_length) {
                std::array<p_input, k_maximum_lanes> values{};
                std::array<p_input, k_maximum_lanes> masks{};
                hn::Store(hash, callback_simd_tag, values.data());
                hn::Store(
                    hn::VecFromMask(callback_simd_tag, mask),
                    callback_simd_tag, masks.data());
                const std::size_t lanes = hn::Lanes(callback_simd_tag);
                for (std::size_t lane = 0U; lane < lanes; ++lane) {
                    if (masks[lane] == p_input{}) continue;
                    simd_results.emplace_back(
                        offsets[lane] * traits_type::letters_per_unit
                            + position,
                        values[lane]);
                }
            }
            ++position;
        },
        [](const auto&, auto&, auto&) -> void {}, 0U);

    return std::set(scalar_results.begin(), scalar_results.end())
        == std::set(simd_results.begin(), simd_results.end());
}

/**
 * @brief Checks lexicographic hashing for one packed-lane type.
 * @tparam p_input Unsigned packed-lane type.
 * @return `true` when scalar and SIMD outputs match.
 */
template<class p_input>
[[nodiscard]] auto lexic_parity() -> bool {
    return hasher_set_parity<
        p_input,
        ::bioseq::simd::lexic_hasher,
        bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::lexic_hasher>();
}

/**
 * @brief Checks minimap integer hashing for one packed-lane type.
 * @tparam p_input Unsigned packed-lane type.
 * @return `true` when scalar and SIMD outputs match.
 */
template<class p_input>
[[nodiscard]] auto minimap_int_parity() -> bool {
    return hasher_set_parity<
        p_input,
        ::bioseq::simd::minimap_int_hasher,
        bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::minimap_int_hasher>();
}

}  // namespace bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail

/** @copydoc bioseq_highway_run_hashers_probe */
extern "C" auto bioseq_highway_run_hashers_probe(
    bioseq_highway_hashers_probe_receipt* receipt) noexcept -> bool {
    if (receipt == nullptr) return false;
    *receipt = {};
    receipt->target = static_cast<std::int64_t>(HWY_TARGET);
    namespace probe =
        bioseq::simd::@BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::probe_detail;
    try {
        const auto record = [&receipt](
                                const std::uint64_t bit,
                                const bool passed) -> void {
            ++receipt->cases_run;
            if (passed) {
                receipt->passed_properties |= bit;
                ++receipt->cases_passed;
            }
        };
        record(1U << 0U, probe::lexic_parity<std::uint8_t>());
        record(1U << 1U, probe::lexic_parity<std::uint16_t>());
        record(1U << 2U, probe::lexic_parity<std::uint32_t>());
        record(1U << 3U, probe::lexic_parity<std::uint64_t>());
        record(1U << 4U, probe::minimap_int_parity<std::uint8_t>());
        record(1U << 5U, probe::minimap_int_parity<std::uint16_t>());
        record(1U << 6U, probe::minimap_int_parity<std::uint32_t>());
        record(1U << 7U, probe::minimap_int_parity<std::uint64_t>());
        return receipt->passed_properties == 0xffU
            && receipt->cases_run == 8U
            && receipt->cases_run == receipt->cases_passed;
    } catch (...) {
        return false;
    }
}
