{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioseq.dev/schemas/cache-benchmark-report.schema.json",
  "title": "Bioseq cache native benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_revision",
    "metadata",
    "scenario",
    "measurement_cohort",
    "exact_2gbp_host_qualification",
    "fixture",
    "correctness_digest",
    "cold_producer",
    "samples",
    "summary",
    "cache_counter_deltas",
    "logical_bytes",
    "stored_bytes",
    "peak_rss_bytes",
    "peak_temp_bytes",
    "cleanup"
  ],
  "properties": {
    "schema_revision": {
      "type": "integer",
      "const": 2
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "scenario": {
      "enum": [
        "standalone",
        "bioseq-2gbp"
      ]
    },
    "measurement_cohort": {
      "type": "string",
      "minLength": 1
    },
    "exact_2gbp_host_qualification": {
      "$ref": "#/$defs/exact_2gbp_host_qualification"
    },
    "fixture": {
      "$ref": "#/$defs/fixture"
    },
    "correctness_digest": {
      "type": "string"
    },
    "cold_producer": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/producer_sample"
        }
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warm_sample"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "cache_counter_deltas": {
      "$ref": "#/$defs/counter"
    },
    "logical_bytes": {
      "$ref": "#/$defs/non_negative_integer"
    },
    "stored_bytes": {
      "$ref": "#/$defs/non_negative_integer"
    },
    "peak_rss_bytes": {
      "$ref": "#/$defs/non_negative_integer"
    },
    "peak_temp_bytes": {
      "$ref": "#/$defs/non_negative_integer"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metadata": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "configured_samples": {
                "minimum": 3
              },
              "artifacts": {
                "minItems": 1
              },
              "resource_sampling": {
                "properties": {
                  "rss_samples": {
                    "minimum": 2
                  },
                  "rss_sampling_failures": {
                    "const": 0
                  },
                  "temp_samples": {
                    "minimum": 2
                  },
                  "temp_sampling_failures": {
                    "const": 0
                  }
                }
              }
            }
          },
          "correctness_digest": {
            "pattern": "^[0-9a-f]{64}$"
          },
          "cold_producer": {
            "$ref": "#/$defs/producer_sample"
          },
          "samples": {
            "minItems": 3
          },
          "summary": {
            "properties": {
              "sample_count": {
                "minimum": 3
              }
            }
          },
          "logical_bytes": {
            "minimum": 1
          },
          "stored_bytes": {
            "minimum": 1
          },
          "peak_rss_bytes": {
            "minimum": 1
          },
          "peak_temp_bytes": {
            "minimum": 1
          },
          "cleanup": {
            "properties": {
              "attempted": {
                "const": true
              },
              "succeeded": {
                "const": true
              },
              "private_root_removed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "bioseq-2gbp"
          },
          "metadata": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "scenario",
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "fixture": {
            "properties": {
              "source_rows": {
                "const": 1
              },
              "query_bases": {
                "const": 5000000
              },
              "target_bases": {
                "const": 1995000000
              },
              "aggregate_input_bases": {
                "const": 2000000000
              }
            }
          },
          "measurement_cohort": {
            "const": "bioseq-cpu-column-cache-on"
          },
          "exact_2gbp_host_qualification": {
            "properties": {
              "required": {
                "const": true
              },
              "performed": {
                "const": true
              },
              "same_execution_host": {
                "const": true
              },
              "status": {
                "const": "passed"
              },
              "host_identity_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "effective_total_ram_bytes": {
                "minimum": 1
              },
              "effective_available_ram_bytes": {
                "minimum": 1
              },
              "required_total_ram_bytes": {
                "const": 0
              },
              "required_available_ram_bytes": {
                "const": 0
              },
              "data_filesystem_capacity_bytes": {
                "minimum": 34359738368
              },
              "data_filesystem_available_bytes": {
                "minimum": 34359738368
              },
              "required_data_filesystem_available_bytes": {
                "minimum": 34359738368
              },
              "effective_cpu_cores": {
                "minimum": 8
              },
              "required_logical_cores": {
                "minimum": 8
              },
              "io_probe_bytes": {
                "minimum": 1073741824
              },
              "io_write_mib_per_second": {
                "minimum": 150
              },
              "io_read_mib_per_second": {
                "minimum": 150
              },
              "required_io_mib_per_second": {
                "minimum": 150
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "standalone"
          },
          "metadata": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "scenario",
          "metadata"
        ]
      },
      "then": {
        "properties": {
          "measurement_cohort": {
            "const": "standalone-sql"
          }
        }
      }
    }
