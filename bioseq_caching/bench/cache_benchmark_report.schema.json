    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "produced",
        "completed_hits",
        "inflight_waits",
        "reuse_hits",
        "fallbacks",
        "invalidations",
        "evictions",
        "logical_bytes",
        "stored_bytes"
      ],
      "properties": {
        "produced": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "completed_hits": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "inflight_waits": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "reuse_hits": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "fallbacks": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "invalidations": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "evictions": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "logical_bytes": {
          "$ref": "#/$defs/non_negative_integer"
        },
        "stored_bytes": {
