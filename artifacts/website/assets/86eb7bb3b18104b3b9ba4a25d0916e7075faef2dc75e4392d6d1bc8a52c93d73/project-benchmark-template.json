{"html": "<div class=\"bd-s0059\">\n                <table class=\"bd-s0060\">\n                  <thead>\n                    <tr>\n                      <th class=\"bd-s0061\">Execution tuple</th>\n                      \n                        <th data-bench-mouseenter=\"c.onEnter\" data-bench-mouseleave=\"onTipOut\" data-bench-for=\"cols\" data-bench-as=\"c\" class=\"bd-s0062\">[[ c.name ]]<span class=\"bd-s0063\">[[ c.sub ]]</span></th>\n                      \n                    </tr>\n                  </thead>\n                  \n                    <tbody data-bench-for=\"groups\" data-bench-as=\"grp\">\n                      \n                        <tr data-bench-if=\"grp.showHeader\">\n                          <td colspan=\"[[ grp.span ]]\" class=\"bd-s0064\">\n                            <span class=\"bd-s0065\">parameters</span>\n                            <span class=\"bd-s0066\">[[ grp.label ]]</span>\n                          </td>\n                        </tr>\n                      \n                      \n                        <tr data-bench-for=\"grp.rows\" data-bench-as=\"r\">\n                          <td data-bench-mouseenter=\"r.onEnter\" data-bench-mouseleave=\"onTipOut\" class=\"bd-s0067\" data-bench-style=\"background:[[ r.rowBg ]]\">\n                            <div class=\"bd-s0068\">\n                              <span class=\"bd-s0069\" data-bench-style=\"color:[[ r.nameColor ]]\">[[ r.algo ]]</span>\n                              <span data-bench-if=\"r.isBaseline\" class=\"bd-s0070\">BASE</span>\n                            </div>\n                            \n                              <div data-bench-if=\"r.hasDetail\" class=\"bd-s0071\">[[ r.detail ]]</div>\n                            \n                          </td>\n                          \n                            <td data-bench-mouseenter=\"cell.onEnter\" data-bench-mouseleave=\"onTipOut\" data-bench-for=\"r.cells\" data-bench-as=\"cell\" class=\"bd-s0072\" data-bench-style=\"background:[[ cell.bg ]];box-shadow:[[ cell.ring ]]\">\n                              <div class=\"bd-s0073\" data-bench-style=\"color:[[ cell.valueColor ]]\">[[ cell.text ]]</div>\n                              <div class=\"bd-s0074\" data-bench-style=\"color:[[ cell.chipColor ]]\">\n                                <span class=\"bd-s0075\">[[ cell.arrow ]]</span>[[ cell.ratioText ]]\n                              </div><div class=\"project-benchmark-b\"><div class=\"bd-s0073\" data-bench-style=\"color:[[ cell.secondColor ]]\">[[ cell.secondText ]]</div>\n                              <div class=\"bd-s0074\" data-bench-style=\"color:[[ cell.secondChipColor ]]\">\n                                <span class=\"bd-s0075\">[[ cell.secondArrow ]]</span>[[ cell.secondRatioText ]]\n                              </div></div>\n                            </td>\n                          \n                        </tr>\n                      \n                    </tbody>\n                  \n                </table>\n              </div><div data-benchmark-tip role=\"tooltip\" class=\"bd-s0131\" data-bench-style=\"left:[[ tipX ]]px;top:[[ tipY ]]px;opacity:[[ tipOpacity ]]\">\n    \n      <div data-bench-if=\"hasTip\">\n        <div class=\"bd-s0132\">[[ tipTitle ]]</div>\n        <div class=\"bd-s0133\">[[ tipSub ]]</div>\n        \n          <p data-bench-if=\"tipHasNote\" class=\"bd-s0134\">[[ tipNote ]]</p>\n        \n        <div class=\"bd-s0135\">\n          \n            <div data-bench-for=\"tipRows\" data-bench-as=\"row\" class=\"bd-s0136\">\n              <span class=\"bd-s0137\">[[ row.k ]]</span>\n              <span class=\"bd-s0138\" data-bench-style=\"color:[[ row.color ]]\">[[ row.v ]]</span>\n            </div>\n          \n        </div>\n        \n          <div data-bench-if=\"tipHasHist\" class=\"bd-s0139\">\n            \n              <span data-bench-for=\"tipHist\" data-bench-as=\"b\" class=\"bd-s0140\" data-bench-style=\"background:[[ b.color ]];height:[[ b.h ]]%\"></span>\n            \n          </div>\n        \n      </div>\n    \n  </div>\n"}
