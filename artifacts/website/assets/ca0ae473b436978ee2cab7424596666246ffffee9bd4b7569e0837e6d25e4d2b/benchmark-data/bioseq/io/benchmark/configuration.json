              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fastq" } ]
          ]
        },
        "output_bytes_nonzero":   { "type": "evaluation" },
        "bytes_on_disk":          { "type": "evaluation" },
        "record_count":           { "type": "evaluation" }
      }
    }
  },

  "regression_rules": [
    {
      "name": "wall_clock_p50_no_blowup",
      "metric": "wall_clock_ns",
      "aggregate": "p50",
      "operator": { "compare": "<", "tolerance%": 25 }
    },
    {
      "name": "wall_clock_p99_no_runaway_outlier",
      "metric": "wall_clock_ns",
      "aggregate": "p99",
      "operator": { "compare": "<", "tolerance%": 50 }
    },
    {
      "name": "record_count_deterministic",
      "metric": "record_count",
      "aggregate": "p50",
      "operator": { "compare": "=", "tolerance%": 0 }
    },
    {
      "name": "observed_body_bytes_deterministic",
      "metric": "observed_body_bytes",
      "aggregate": "p50",
      "operator": { "compare": "=", "tolerance%": 0 }
    },
    {
      "name": "records_nonzero_deterministic",
      "metric": "records_nonzero",
      "aggregate": "p50",
      "operator": { "compare": "=", "tolerance%": 0 }
    },
    {
      "name": "output_bytes_nonzero_deterministic",
      "benchmarks": ["bench_io_writers_fasta", "bench_io_writers_fastq"],
      "metric": "output_bytes_nonzero",
      "aggregate": "p50",
      "operator": { "compare": "=", "tolerance%": 0 }
    },
    {
      "name": "roundtrip_record_match_deterministic",
