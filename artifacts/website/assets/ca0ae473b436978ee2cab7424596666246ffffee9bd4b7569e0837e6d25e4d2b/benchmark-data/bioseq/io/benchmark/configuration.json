  "bench_io_readers_gz": {
    "tags": ["io", "reader", "gz"],
    "description": "Gzip-aware reader paths (parallel-gzip + zlib fallback) on the .fastq.gz real-data cell. Asserts pgzip beats single-thread zlib by >= 25%, and that both report the same record count and body bytes.",
    "fast": true,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "FASTQ_REAL_HUMAN_FASTQ_GZ": 2 },
      "over": {
        "bioseq_io_pgzip_fastq": {},
        "bioseq_io_zlib_fastq":  {},
        "kseqpp_fastq":          {}
      },
      "by_regions": false,
      "metrics": {
        "wall_clock_ns": {
          "rules": [
            [ "pgzip_faster_than_zlib_fastq",
              { "key": "bioseq_io_pgzip_fastq" },
              { "compare": "<", "threshold%": 30, "tolerance%": 5, "aggregate": "p50" },
              { "key": "bioseq_io_zlib_fastq" } ]
          ]
        },
        "record_count": {
          "type": "evaluation",
          "rules": [
            [ "pgzip_records_match_zlib_fastq",
              { "key": "bioseq_io_pgzip_fastq" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_io_zlib_fastq" } ]
          ]
        },
        "observed_body_bytes": {
          "type": "evaluation",
          "rules": [
            [ "pgzip_body_bytes_match_zlib_fastq",
              { "key": "bioseq_io_pgzip_fastq" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_io_zlib_fastq" } ]
          ]
        },
        "records_nonzero":    { "type": "evaluation" },
        "bytes_on_disk":      { "type": "evaluation" },
        "decompressed_bytes": { "type": "evaluation" }
      }
    }
  },

  "bench_io_writers_fasta": {
    "tags": ["io", "writer", "fasta"],
    "description": "FASTA writer paths. sync vs parallel4 vs parallel8 vs mmap-sink bioseq writers + naive_ofstream baseline. Each iteration writes the corpus, measures, and validates byte-faithful roundtrip via XOR-aggregated content hash.",
    "fast": true,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": {
        "FASTA_SHORT": 6, "FASTA_MEDIUM": 4, "FASTA_LONG": 3, "FASTA_VERY_LONG": 2, "FASTA_REAL_HUMAN_GENOME": 3
      },
      "over": {
        "bioseq_writer_sync_fasta":      {},
        "bioseq_writer_parallel4_fasta": {},
        "bioseq_writer_parallel8_fasta": {},
        "bioseq_writer_mmap_fasta":      {},
        "naive_ofstream_fasta":          {}
      },
      "by_regions": false,
      "metrics": {
        "wall_clock_ns": {
          "rules": [
            [ "writer_sync_fasta_within_50pct_of_naive",
              { "key": "bioseq_writer_sync_fasta" },
              { "compare": "<", "threshold%": 0, "tolerance%": 50, "aggregate": "p50" },
              { "key": "naive_ofstream_fasta" } ],

            [ "writer_parallel4_at_most_30pct_slower_than_sync_fasta",
              { "key": "bioseq_writer_parallel4_fasta" },
              { "compare": "<", "threshold%": 0, "tolerance%": 30, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fasta" } ],

            [ "writer_parallel8_at_most_30pct_slower_than_parallel4_fasta",
              { "key": "bioseq_writer_parallel8_fasta" },
              { "compare": "<", "threshold%": 0, "tolerance%": 30, "aggregate": "p50" },
              { "key": "bioseq_writer_parallel4_fasta" } ],

            [ "writer_mmap_within_50pct_of_naive_fasta",
              { "key": "bioseq_writer_mmap_fasta" },
              { "compare": "<", "threshold%": 0, "tolerance%": 50, "aggregate": "p50" },
              { "key": "naive_ofstream_fasta" } ]
          ]
        },
        "roundtrip_record_match": {
          "type": "evaluation",
          "rules": [
            [ "writer_parallel4_fasta_roundtrip_matches_sync",
              { "key": "bioseq_writer_parallel4_fasta" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fasta" } ],
            [ "writer_parallel8_fasta_roundtrip_matches_sync",
              { "key": "bioseq_writer_parallel8_fasta" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fasta" } ],
            [ "writer_mmap_fasta_roundtrip_matches_sync",
              { "key": "bioseq_writer_mmap_fasta" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fasta" } ],
            [ "writer_naive_fasta_roundtrip_matches_sync",
              { "key": "naive_ofstream_fasta" },
              { "compare": "=", "tolerance%": 0, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fasta" } ]
          ]
        },
        "output_bytes_nonzero":   { "type": "evaluation" },
        "bytes_on_disk":          { "type": "evaluation" },
        "record_count":           { "type": "evaluation" }
      }
    }
  },

  "bench_io_writers_fastq": {
    "tags": ["io", "writer", "fastq"],
    "description": "FASTQ writer paths. sync vs parallel4 vs parallel8 vs mmap-sink bioseq writers + naive_ofstream baseline. Each iteration writes the corpus, measures, and validates byte-faithful roundtrip via XOR-aggregated content hash. The dna5 SRR file is intentionally NOT included here: the bench's dna4 reader drops 'N's during slurp, so any roundtrip through dna4 is destructive on dna5 input. The reader matrix above keeps the 6 GiB dna5 cell to exercise mmap-parallel + parallel-gzip throughput; the writer matrix sticks to dna4-only corpora for byte-faithful roundtrip.",
    "fast": true,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": {
        "FASTQ_SHORT": 6, "FASTQ_MEDIUM": 4, "FASTQ_LONG": 3, "FASTQ_VERY_LONG": 2
      },
      "over": {
        "bioseq_writer_sync_fastq":      {},
        "bioseq_writer_parallel4_fastq": {},
        "bioseq_writer_parallel8_fastq": {},
        "bioseq_writer_mmap_fastq":      {},
        "naive_ofstream_fastq":          {}
      },
      "by_regions": false,
      "metrics": {
        "wall_clock_ns": {
          "rules": [
            [ "writer_sync_fastq_within_50pct_of_naive",
              { "key": "bioseq_writer_sync_fastq" },
              { "compare": "<", "threshold%": 0, "tolerance%": 50, "aggregate": "p50" },
              { "key": "naive_ofstream_fastq" } ],

            [ "writer_parallel4_at_most_30pct_slower_than_sync_fastq",
              { "key": "bioseq_writer_parallel4_fastq" },
              { "compare": "<", "threshold%": 0, "tolerance%": 30, "aggregate": "p50" },
              { "key": "bioseq_writer_sync_fastq" } ],

            [ "writer_parallel8_at_most_30pct_slower_than_parallel4_fastq",
              { "key": "bioseq_writer_parallel8_fastq" },
              { "compare": "<", "threshold%": 0, "tolerance%": 30, "aggregate": "p50" },
              { "key": "bioseq_writer_parallel4_fastq" } ],

            [ "writer_mmap_within_50pct_of_naive_fastq",
