cmake_minimum_required(VERSION 4.2)
if(NOT OUTPUT OR NOT STAMP)
  message(FATAL_ERROR "biological alphabet registry scan requires OUTPUT and STAMP")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/bioseq_build_config_codegen.cmake")
_bioseq_biological_alphabet_entries(_entries)
set(_contents "${_entries}\n")
set(_old_contents "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old_contents)
endif()
if(NOT _old_contents STREQUAL _contents)
  file(WRITE "${OUTPUT}" "${_contents}")
endif()
file(TOUCH "${STAMP}")
