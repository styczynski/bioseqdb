# Base configuration for disposable private PostgreSQL clusters.
# private_postgres.py appends the unique socket, port, build-tree library path,
# and any requested preload settings for each invocation.
listen_addresses = ''
fsync = off
full_page_writes = off
synchronous_commit = off
log_min_messages = info
log_error_verbosity = verbose
log_line_prefix = '%m [%p] %q%u@%d '
logging_collector = on
log_directory = 'pg_log'
log_filename = 'postgresql.log'
max_worker_processes = 16
max_prepared_transactions = 16
shared_buffers = '64MB'
