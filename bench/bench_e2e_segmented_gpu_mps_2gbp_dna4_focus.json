    },
    "bioseq_block_gpu_dp_gpu_seed_no_index": {
      "_": {"type": "integer", "default": 0, "description": "2 Gbp segmented GPU dna4 MPS no_index focused proof"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_sequence", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index"},
