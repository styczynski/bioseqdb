        "min_tmp_available_gib":  { "type": "evaluation", "rules": [] },
        "peak_swap_used_mb":      { "type": "evaluation", "rules": [] },
        "audit_selected_minimizer_is_sequence": { "type": "evaluation", "rules": [] },
        "audit_mpf_rows":         { "type": "evaluation", "rules": [] },
        "audit_mps_rows":         { "type": "evaluation", "rules": [] },
