{
  "params": {
    "bioseq_block_gpu_dp_gpu_seed_just_index": {
      "_": {"type": "integer", "default": 0, "description": "Resident GPU-index frontend (Vulkan GPU seeding + tiled-DP chaining + block aligner); index prebuilt (untimed); GPU-driven alignment via SQL, timed (cold read after a PostgreSQL restart)"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "Scheduler concurrency mode for the bioseq SQL persisted-index read path"}
    },
    "bioseq_block_gpu_dp_gpu_seed_no_index": {
      "_": {"type": "integer", "default": 0, "description": "Resident GPU-index frontend (Vulkan GPU seeding + tiled-DP chaining + block aligner); load(no index)+GPU recompute align, all via SQL, timed end-to-end"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before load/recompute"},
      "recompute_async_persist": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "stage the recompute minimizer index for async persistence (off = pure from-scratch no-index measure)"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "Scheduler concurrency mode for the bioseq SQL recompute path"}
    },
    "minimap2_no_index": {
      "_": {"type": "integer", "default": 0, "description": "minimap2 rebuild-each (build+map) on split FASTA"},
      "threads": {"type": "integer", "default": 1, "description": "minimap2 -t value for rebuild+map"}
    },
    "minimap2_just_index": {
      "_": {"type": "integer", "default": 0, "description": "minimap2 prebuilt .mmi (map only)"},
      "threads": {"type": "integer", "default": 1, "description": "minimap2 -t value for map-only with prebuilt .mmi"}
    }
  },

  "test_cases": {
    "E2E_4GBP_DNA4": { "concurrency": 1, "data": {
        "alphabet": "dna4", "size_label": "4gbp_dna4", "reference_length": 4000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna4 4 Gbp reference, one 5 Mbp HiFi-error query; minimap2 ref split into two records" },

    "E2E_4GBP_DNA5": { "concurrency": 1, "data": {
        "alphabet": "dna5", "size_label": "4gbp_dna5", "reference_length": 4000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna5 4 Gbp reference with deterministic N bases; same biological parameters as dna4" }
  },

  "bench_e2e": {
    "tags": ["e2e", "gpu", "4gbp"],
    "description": "GPU benchmark 4 Gbp pass: Vulkan GPU seeding+chaining (production, no XPC fallback) vs minimap2 baseline at 4 Gbp dna4/dna5. Split from 2 Gbp pass due to 16 GiB local RAM constraint. SIMD + minimap2 numbers carried from SUMMARY.md report 7.",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_4GBP_DNA4": 3, "E2E_4GBP_DNA5": 3 },
      "over": {
        "bioseq_block_gpu_dp_gpu_seed_just_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "bioseq_block_gpu_dp_gpu_seed_no_index":   {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]}
      },
      "by_regions": true,
      "metrics": {
