case $CONFIG_STATUS in #(
  -*) :
    CONFIG_STATUS=./$CONFIG_STATUS ;; #(
  */*) :
     ;; #(
  *) :
    CONFIG_STATUS=./$CONFIG_STATUS ;;
esac

ac_write_fail=0
ac_clean_CONFIG_STATUS='"$CONFIG_STATUS"'
{ printf '%s\n' "$as_me:${as_lineno-$LINENO}: creating $CONFIG_STATUS" >&5
printf '%s\n' "$as_me: creating $CONFIG_STATUS" >&6;}
as_write_fail=0
