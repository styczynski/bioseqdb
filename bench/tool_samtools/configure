  withval=$with_htslib;
else case e in #(
  e) with_htslib=search ;;
esac
fi

# Check whether --enable-configure-htslib was given.
if test ${enable_configure_htslib+y}
then :
  enableval=$enable_configure_htslib;
else case e in #(
  e) enable_configure_htslib=only_in_subdir ;;
esac
fi


case $with_htslib in
yes|search)
  { printf '%s\n' "$as_me:${as_lineno-$LINENO}: checking location of HTSlib source tree" >&5
printf %s "checking location of HTSlib source tree... " >&6; }
  case $srcdir in
    .) srcp= ;;
    *) srcp=$srcdir/ ;;
  esac
  found=
  for dir in ${srcp}htslib* -- ${srcp}../htslib -- ${srcp}../htslib*
  do
    if test "$dir" = "--"; then
      test -n "$found" && break
    elif test -f "$dir/hts.c" && test -f "$dir/htslib/hts.h"; then
      found="${found}1"
      HTSDIR=$dir
    fi
  done
  if test -z "$found"; then
    { printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: none found" >&5
printf '%s\n' "none found" >&6; }
    ax_cv_htslib_which=system
  elif test "$found" = 1; then
    { printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: $HTSDIR" >&5
printf '%s\n' "$HTSDIR" >&6; }
    ax_cv_htslib_which=source
    if test "x$enable_configure_htslib" = "xonly_in_subdir" ; then
      case $HTSDIR in
        "${srcp}htslib"*) enable_configure_htslib=yes ;;
        *) ;;
      esac
    fi
  else
    { printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: several directories found" >&5
printf '%s\n' "several directories found" >&6; }
    as_fn_error $? "use --with-htslib=DIR to select which HTSlib to use" "$LINENO" 5
  fi
  ;;
no) ax_cv_htslib_which=none ;;
system) ax_cv_htslib_which=system ;;
*)
  HTSDIR=$with_htslib
  if test -f "$HTSDIR/hts.c" && test -f "$HTSDIR/htslib/hts.h"; then
    ax_cv_htslib_which=source
  elif test -f "$HTSDIR/htslib_vars.mk"; then
    ax_cv_htslib_which=build
  else
    ax_cv_htslib_which=install
  fi
  ;;
esac

case $ax_cv_htslib_which in
source)
  ax_cv_htslib=yes
  HTSLIB_CPPFLAGS="-I$HTSDIR"
  HTSLIB_LDFLAGS="-L$HTSDIR"
  if test "x$enable_configure_htslib" = "xyes"; then
    # We can't use a literal, because $HTSDIR is user-provided and variable
    subdirs="$subdirs $HTSDIR"

  fi
  ;;
build)
  ax_cv_htslib=yes
  ax_cv_htslib_which=source
  # Ensure this is fully expanded, as the caller might not be using @HTSDIR@
  HTSSRCDIR=$(sed -n 's:\$(HTSDIR):'$HTSDIR':
                      s/^HTSSRCDIR *= *//p' "$HTSDIR/htslib_vars.mk")
  HTSLIB_CPPFLAGS="-I$HTSSRCDIR"
  HTSLIB_LDFLAGS="-L$HTSDIR"
  ;;
system)
  ac_fn_c_check_header_compile "$LINENO" "htslib/sam.h" "ac_cv_header_htslib_sam_h" ";
"
