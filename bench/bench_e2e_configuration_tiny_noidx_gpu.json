      "_": {"type": "integer", "default": 0, "description": "GPU no_index recompute (tiled build_gpu_index_on_device for contiguous leaf)"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy index"},
      "recompute_async_persistence": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "off"},
      "pipeline_mode": {"type": "string", "default": "single_thread", "enum": ["single_thread", "parallel_dispatch", "task_parallel"], "description": "mode"}
