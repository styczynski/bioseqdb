{
  "params": {
    "bioseq_block_gpu_dp_gpu_seed_just_index": {
      "_": {"type": "integer", "default": 0, "description": "Resident GPU-index frontend; index prebuilt (untimed); GPU-driven alignment via SQL, timed (cold read after a PostgreSQL restart)"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"},
      "pipeline_mode": {"type": "string", "default": "single_thread", "enum": ["single_thread", "parallel_dispatch", "task_parallel"], "description": "scheduler concurrency mode"}
    },
    "bioseq_block_gpu_dp_gpu_seed_no_index": {
      "_": {"type": "integer", "default": 0, "description": "Resident GPU-index frontend; load(no index)+GPU recompute align, all via SQL, timed end-to-end"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before load/recompute"},
      "recompute_async_persistence": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "off = pure from-scratch no-index measure"},
      "pipeline_mode": {"type": "string", "default": "single_thread", "enum": ["single_thread", "parallel_dispatch", "task_parallel"], "description": "scheduler concurrency mode"}
    }
  },

  "test_cases": {
    "E2E_300MBP_DNA4": { "concurrency": 1, "data": {
        "alphabet": "dna4", "size_label": "300mbp_dna4", "reference_length": 300000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 300000352, "seed": 3219876 },
      "description": "dna4 300 Mbp de-risk reference (~19 max-size 16M-bp GPU windows), one 5 Mbp HiFi-error query" }
  },

  "bench_e2e": {
    "tags": ["e2e", "gpu", "derisk"],
    "description": "DE-RISK GPU pass: confirm Vulkan GPU seeding runs end-to-end in the forked PG backend at the real (run-buffer-capped, ~16M bp) window size before the full 2/4 Gbp matrix.",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_300MBP_DNA4": 1 },
      "over": {
        "bioseq_block_gpu_dp_gpu_seed_just_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "bioseq_block_gpu_dp_gpu_seed_no_index":   {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]}
      },
      "by_regions": true,
      "metrics": {
        "wall_clock_ns":   { "rules": [] },
        "region_total_ns": { "type": "region", "rules": [] },
        "region_visits":   { "type": "region", "rules": [] },
        "match_count":            { "type": "evaluation" },
        "mean_position_offset_bp":{ "type": "evaluation", "rules": [] },
        "found_fraction":         { "type": "evaluation", "rules": [] },
        "measured_region_ns_manual": { "type": "evaluation", "rules": [] },
        "peak_postgres_rss_mb":   { "type": "evaluation", "rules": [] },
        "peak_bench_rss_mb":      { "type": "evaluation", "rules": [] },
        "peak_swap_used_mb":      { "type": "evaluation", "rules": [] },
        "audit_selected_minimizer_is_sequence": { "type": "evaluation", "rules": [] },
        "audit_minimizer_fragment_rows":         { "type": "evaluation", "rules": [] },
        "audit_minimizer_sequence_rows":         { "type": "evaluation", "rules": [] }
      }
    }
  },

  "regression_rules": []
}
