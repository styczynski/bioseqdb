@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads REQUIRED)
find_dependency(type_safe CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/cppast-targets.cmake")

if(DEFINED LIBCLANG_LIBRARY AND EXISTS "${LIBCLANG_LIBRARY}")
  set(_cppast_libclang_library "${LIBCLANG_LIBRARY}")
else()
  find_library(_cppast_libclang_library NAMES clang libclang REQUIRED)
endif()
set_property(TARGET cppast::cppast APPEND PROPERTY
  INTERFACE_LINK_LIBRARIES "${_cppast_libclang_library}"
)
unset(_cppast_libclang_library)

check_required_components(cppast)
