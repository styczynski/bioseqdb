#!/usr/bin/env bash
set -euo pipefail
. /etc/os-release
{% if distro != 'arch' %}
test "$ID" = '{{ os_id }}'
test "$VERSION_ID" = '{{ os_version }}'
export DEBIAN_FRONTEND=noninteractive
printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
chmod 0755 /usr/sbin/policy-rc.d
apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y --no-install-recommends ca-certificates curl locales postgresql-common util-linux
printf 'create_main_cluster = false\n' > /etc/postgresql-common/createcluster.conf
install -d /usr/share/postgresql-common/pgdg
curl -fsSL --retry 3 https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
printf '%s\n' 'deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt {{ suite }} {{ components }}' > /etc/apt/sources.list.d/pgdg.list
apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y --no-install-recommends {% if major >= 20 %}-t {{ suite }} {% endif %}postgresql-{{ major }} /tmp/bioseq-packages/*.deb
rm -rf /var/lib/apt/lists/*
{% else %}
case "$ID" in arch|archarm) ;; *) exit 1;; esac
sed -i '/^\[options\]/a DisableSandbox' /etc/pacman.conf
pacman -Syu --noconfirm --needed ca-certificates util-linux icu readline openssl lz4 zstd zlib vulkan-icd-loader
{% if not has_sdk %}
pacman -S --noconfirm --needed postgresql{% if major == 17 %} postgresql-old-upgrade{% endif %}
{% endif %}
pacman -U --noconfirm /tmp/bioseq-packages/*.pkg.tar.*
rm -rf /var/cache/pacman/pkg/*
{% endif %}
id postgres >/dev/null 2>&1 || useradd -r -d /var/lib/postgresql -s /bin/bash postgres
install -d -m 3775 -o postgres -g postgres /var/run/postgresql
install -d -m 0755 -o postgres -g postgres /var/lib/postgresql
install -d /docker-entrypoint-initdb.d /opt/bioseq-postgres
found=false
while IFS= read -r server; do
    bindir="$(dirname "$server")"
    version="$("$server" --version)"
    if [[ "$version" =~ PostgreSQL\)\ {{ major }}([.a-z]|$) ]] && [[ -x "$bindir/initdb" && -x "$bindir/pg_ctl" ]]; then
        ln -s "$bindir" /opt/bioseq-postgres/bin
        libdir='{{ extension_libdir }}'
        ln -s "$libdir" /opt/bioseq-postgres/lib
        test -f "$libdir/bioseq.so"
        found=true
        break
    fi
done < <(find /usr /opt -type f -name postgres -executable)
$found || { echo 'Requested PostgreSQL runtime not found' >&2; exit 1; }
