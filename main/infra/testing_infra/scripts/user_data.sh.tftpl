#!/usr/bin/env bash
# AUTO-GENERATED EC2 user-data (rendered by OpenTofu from user_data.sh.tftpl).
#
# Stage-0 bootstrap. EC2 user-data is capped at 16 KiB, so this stays tiny: it
# installs just enough to read the GitHub secret + clone the private repo, runs
# the separate fetch_repo.sh (shipped here base64-embedded, and also versioned
# in the repo), then hands off to the in-repo heavy bootstrap.sh. All real work
# and all secret handling live in those two scripts.
set -xuo pipefail
exec > >(tee -a /var/log/bioseq-provision.log) 2>&1
echo "[stage0] $(date -u) starting"

export DEBIAN_FRONTEND=noninteractive
mkdir -p /opt/bioseq

# Provisioning parameters injected by OpenTofu (no secret VALUES here — just the
# secret's id/region/arn, which the instance role is scoped to read).
cat > /opt/bioseq/provision.env <<EOF
export REPO='${repo}'
export BRANCH='${branch}'
export SECRET_NAME='${secret_name}'
export SECRET_REGION='${secret_region}'
export SECRET_ARN='${secret_arn}'
export RUN_VERIFY='${run_verify}'
export TARGET_USER='ubuntu'
export REPO_DEST='/home/ubuntu/bioseqdb'
export NAMED_ENV_TYPE='AWS_MACHINE_X64'
EOF
chmod 0644 /opt/bioseq/provision.env

# Minimal prerequisites for the clone step.
for i in 1 2 3 4 5; do apt-get update -y && break || sleep 15; done
apt-get install -y git jq curl unzip ca-certificates

# awscli v2 (uses IMDSv2 + the instance role to read the secret).
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  ( cd /tmp && unzip -q awscliv2.zip && ./aws/install )
fi

# Materialise the separate, re-runnable fetch_repo.sh (verbatim copy).
base64 -d > /opt/bioseq/fetch_repo.sh <<'B64'
${fetch_repo_b64}
B64
chmod +x /opt/bioseq/fetch_repo.sh

# Load params and fetch the repo (installs SSH key + gh auth from the secret).
set -a; . /opt/bioseq/provision.env; set +a
if ! /opt/bioseq/fetch_repo.sh; then
  echo "[stage0] ERROR: fetch_repo.sh failed" >&2
  echo "STAGE0_FETCH_FAILED" > /opt/bioseq/PROVISION_STATUS
  exit 1
fi

# Hand off to the heavy provisioner that lives inside the repo.
BOOTSTRAP="$${REPO_DEST}/main/infra/testing_infra/scripts/bootstrap.sh"
if [ -f "$${BOOTSTRAP}" ]; then
  chmod +x "$${REPO_DEST}/main/infra/testing_infra/scripts/"*.sh 2>/dev/null || true
  exec "$${BOOTSTRAP}"
else
  echo "[stage0] ERROR: bootstrap.sh not found at $${BOOTSTRAP}" >&2
  echo "STAGE0_NO_BOOTSTRAP" > /opt/bioseq/PROVISION_STATUS
  exit 1
fi
