# Required. Copy this file to package_build.auto.tfvars and replace the
# documentation-only address with the operator/CI egress IPv4 address. The
# stack accepts only an explicit /32 and has no fail-open default.
ssh_ingress_cidr = "203.0.113.10/32"

# Optional overrides. Empty AMI ids select Canonical Ubuntu 24.04 for the native
# architecture; the orchestrator supplies architecture-specific cached AMIs.
region          = "us-east-1"
arm64_ami_id    = ""
x64_ami_id      = ""
artifact_prefix = "bioseq"

# DOC0390 requires at least 500 GiB. Validation rejects smaller values.
root_volume_size_gb = 500
