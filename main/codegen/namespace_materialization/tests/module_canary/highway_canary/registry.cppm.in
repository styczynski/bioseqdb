module;

// This is the conservative runtime/export policy. The attributed probe widens
// only its private fixed-target units and is absent from this dispatch table.
#define HWY_COMPILE_ALL_ATTAINABLE 1
#define HWY_DISABLED_TARGETS (~(@SIMD_TARGET_TOKEN@ | HWY_EMU128))
#define HWY_HEADER_ONLY 1
#define HWY_STATIC_DEFINE 1
@PLATFORM_HEADER_OVERRIDES@
#include <hwy/highway.h>

#include <cstdint>

module bioseq.highway.gcc_canary:highway_registry;

import bioseq.highway.gcc_canary;
import bioseq.highway.gcc_canary.contract;
import @SIMD_TARGET_MODULE@;
import @ATTRIBUTED_TARGET_MODULE@;
import @FALLBACK_TARGET_MODULE@;

namespace bioseq::highway_gcc_canary {

static_assert(HWY_TARGETS == (@SIMD_TARGET_TOKEN@ | HWY_EMU128));
static_assert(HWY_STATIC_TARGET == @SIMD_TARGET_TOKEN@);

// This is the canary closure's sole literal Highway dispatch registry.
HWY_EXPORT(BindHighwayTarget);

using TargetBinder = const TargetBinding* (*)();

// This volatile address is a link-time anchor only. The attributed target is
// deliberately absent from HWY_TARGETS and can never enter runtime dispatch.
[[nodiscard]] bool attributed_binder_is_linked() noexcept {
  static TargetBinder volatile binder =
      &@ATTRIBUTED_TARGET_NAMESPACE@::BindHighwayTarget;
  return binder != nullptr;
}

[[nodiscard]] const TargetBinding* select_target(
    const std::int64_t target) noexcept {
  constexpr std::int64_t compiled_targets =
      @SIMD_TARGET_TOKEN@ | HWY_EMU128;
  if (target != 0
      && ((target & (target - 1)) != 0
          || (compiled_targets & target) == 0)) {
    return nullptr;
  }
  if (target == 0) {
    // Exercise the table's real cache entry and the authenticated
    // hwy::SupportedTargets ABI hook on the first dispatch.
    hwy::GetChosenTarget().DeInit();
  } else {
    hwy::GetChosenTarget().Update(target);
  }
  const auto* binding = HWY_DYNAMIC_DISPATCH(BindHighwayTarget)();
  const std::int64_t expected_target =
      target == 0 ? @SIMD_TARGET_TOKEN@ : target;
  return binding != nullptr && binding->complete()
          && binding->target == expected_target
      ? binding
      : nullptr;
}

[[nodiscard]] constexpr std::int64_t second_target() noexcept {
  return HWY_EMU128;
}

}  // namespace bioseq::highway_gcc_canary
