module;

// Runtime targets use the conservative export mask. The compile-only
// attributed probe widens only its private fixed-target units.
#define HWY_COMPILE_ALL_ATTAINABLE 1
#define HWY_DISABLED_TARGETS (~(@TARGET_POLICY_MASK@))
#define HWY_HEADER_ONLY 1
#define HWY_STATIC_DEFINE 1
@PLATFORM_HEADER_OVERRIDES@
#include <hwy/detect_targets.h>
#undef HWY_TARGET
#define HWY_TARGET @TARGET_TOKEN@
#include <hwy/highway.h>

module @TARGET_MODULE@;

import bioseq.highway.gcc_canary.contract;
import :kernel;
@ATTRIBUTE_PARTITION_IMPORT@

namespace bioseq::highway_gcc_canary::HWY_NAMESPACE {

HWY_ATTR const TargetBinding* BindHighwayTarget() {
@ATTRIBUTE_COVERAGE_CHECK@
  static const KernelTable kernels{
      .add_one = &AddOne,
  };
  static const TargetBinding binding{
      .target = HWY_TARGET,
      .target_name = hwy::TargetName(HWY_TARGET),
      .kernels = &kernels,
  };
  return binding.complete() ? &binding : nullptr;
}

}  // namespace bioseq::highway_gcc_canary::HWY_NAMESPACE
