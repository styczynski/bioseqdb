module;

#include <span>
#include <string_view>

export module bioseq.codegen:components;

// Generated by main/codegen/CMakeLists.txt (configure_file). It lists exactly
// the components CMake compiled into this binary, so the CLI dispatches without
// any per-component preprocessor gating. Do not edit; change the component set
// in CMake instead.
@BIOSEQ_CODEGEN_COMPONENT_IMPORTS@

export namespace bioseq::codegen {

/// @brief One enabled component's name and uniform entrypoints.
struct component_entry {
    std::string_view name;
    int (*self_test)();
    int (*run)(std::span<std::string_view const>);
};

/// @brief The components CMake compiled into this binary, in registration order.
[[nodiscard]] inline std::span<const component_entry> registered_components() {
    static const component_entry table[] = {
@BIOSEQ_CODEGEN_COMPONENT_ENTRIES@
    };
    return table;
}

}  // namespace bioseq::codegen
