{
  "params": {
    "bioseq_no_index": {
      "_": {"type": "integer", "default": 0, "description": "load(no index)+recompute align, all via SQL, timed end-to-end"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before load/recompute; only affects no-index runtime when recompute_async_persist=on"},
      "recompute_async_persist": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "stage the selected no-index recompute minimizer index for async persistence"}
    },
    "bioseq_load_only":     {"_": {"type": "integer", "default": 0, "description": "DOC0296 split: TRUNCATE + bioseq.load only, timed"}},
    "bioseq_recompute_only":{
      "_": {"type": "integer", "default": 0, "description": "DOC0296 split: mmsearch recompute only, after untimed load"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before untimed load/recompute"},
      "recompute_async_persist": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "DOC0296: stage a no-index recompute minimizer index for async persistence"}
    },
    "bioseq_just_index": {
      "_": {"type": "integer", "default": 0, "description": "index prebuilt (untimed); assemble align via SQL, timed"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"}
    },
    "bioseq_block_vulkan_phase_c_frontend_just_index": {
      "_": {"type": "integer", "default": 0, "description": "DOC0310 Phase C Vulkan frontend: index prebuilt (untimed); Vulkan-driven alignment via SQL, timed — measures GPU seeding + tiled-DP chaining + block aligner e2e impact"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"}
    },
    "minimap2_no_index":    {"_": {"type": "integer", "default": 0, "description": "minimap2 rebuild-each (build+map) on split FASTA"}},
    "minimap2_just_index":  {"_": {"type": "integer", "default": 0, "description": "minimap2 prebuilt .mmi (map only)"}}
  },

  "test_cases": {
    "E2E_2GBP_DNA4": { "concurrency": 1, "data": {
        "alphabet": "dna4", "size_label": "2gbp_dna4", "reference_length": 2000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna4 2 Gbp reference, one 5 Mbp HiFi-error query (DOC0283 seed)" },

    "E2E_2GBP_DNA5": { "concurrency": 1, "data": {
        "alphabet": "dna5", "size_label": "2gbp_dna5", "reference_length": 2000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna5 2 Gbp reference with deterministic N bases; same biological parameters as dna4" },

    "E2E_4GBP_DNA4": { "concurrency": 1, "data": {
        "alphabet": "dna4", "size_label": "4gbp_dna4", "reference_length": 4000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna4 4 Gbp reference, one 5 Mbp HiFi-error query; minimap2 ref split into two records" },

    "E2E_4GBP_DNA5": { "concurrency": 1, "data": {
        "alphabet": "dna5", "size_label": "4gbp_dna5", "reference_length": 4000000000,
        "fragment_count": 1, "fragment_length_mean": 5000000, "fragment_length_stddev": 100000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 2000000352, "seed": 3219876 },
      "description": "dna5 4 Gbp reference with deterministic N bases; same biological parameters as dna4" }
  },

  "bench_e2e": {
    "description": "End-to-end SQL-driven 2/4 Gbp benchmark. bioseq via bioseq.load + SELECT mmsearch; minimap2 via CLI on the split FASTA. no_index = build counted; just_index = build excluded. Forces block-aligner SIMD + SIMD DP chaining + the selected minimizer GUC on the bioseq path.",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_2GBP_DNA4": 3, "E2E_2GBP_DNA5": 3,
               "E2E_4GBP_DNA4": 3, "E2E_4GBP_DNA5": 3 },
      "over": {
        "bioseq_no_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "recompute_async_persist": ["off", "on"]},
        "bioseq_just_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"]},
        "bioseq_block_vulkan_phase_c_frontend_just_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"]},
        "minimap2_no_index": {},
        "minimap2_just_index": {}
      },
      "by_regions": true,
      "metrics": {
        "wall_clock_ns":   { "rules": [] },
        "region_total_ns": { "type": "region", "rules": [] },
        "region_visits":   { "type": "region", "rules": [] },
        "match_count":            { "type": "evaluation" },
        "mean_position_offset_bp":{ "type": "evaluation", "rules": [] },
        "found_fraction":         { "type": "evaluation", "rules": [] },
        "measured_region_ns_manual": { "type": "evaluation", "rules": [] },
        "peak_postgres_rss_mb":   { "type": "evaluation", "rules": [] },
        "peak_minimap2_rss_mb":   { "type": "evaluation", "rules": [] },
        "peak_bench_rss_mb":      { "type": "evaluation", "rules": [] },
        "min_tmp_available_gib":  { "type": "evaluation", "rules": [] },
        "peak_swap_used_mb":      { "type": "evaluation", "rules": [] },
        "audit_selected_minimizer_is_sequence": { "type": "evaluation", "rules": [] },
        "audit_mpf_rows":         { "type": "evaluation", "rules": [] },
        "audit_mps_rows":         { "type": "evaluation", "rules": [] },
        "audit_mpf_update_on_insert": { "type": "evaluation", "rules": [] },
        "audit_mps_update_on_insert": { "type": "evaluation", "rules": [] },
        "audit_mpf_active_read":  { "type": "evaluation", "rules": [] },
        "audit_mps_active_read":  { "type": "evaluation", "rules": [] },
        "audit_async_persist_jobs_waiting": { "type": "evaluation", "rules": [] },
        "audit_index_rows_wait_attempts": { "type": "evaluation", "rules": [] }
      }
    }
  },

  "regression_rules": []
}
