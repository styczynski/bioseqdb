{
  "params": {
    "bioseq_block_simd_dp_two_stack_nthash_no_index": {
      "_": {"type": "integer", "default": 0, "description": "bioseq block aligner + SIMD-mm2 chaining + two-stack nthash minimizer; load(no index)+recompute align, all via SQL, timed end-to-end"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before load/recompute"},
      "recompute_async_persist": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "stage the recompute minimizer index for async persistence (off = pure from-scratch no-index measure)"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "DOC0294 scheduler concurrency mode for the bioseq SQL recompute path"}
    },
    "bioseq_block_simd_dp_two_stack_nthash_just_index": {
      "_": {"type": "integer", "default": 0, "description": "bioseq block aligner + SIMD-mm2 chaining + two-stack nthash minimizer; index prebuilt (untimed); assemble align via SQL, timed (cold read after a PostgreSQL restart)"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "DOC0294 scheduler concurrency mode for the bioseq SQL persisted-index read path"}
    },
    "bioseq_block_gpu_dp_gpu_seed_just_index": {
      "_": {"type": "integer", "default": 0, "description": "DOC0310 Phase C GPU frontend (Vulkan GPU seeding + tiled-DP chaining + block aligner); index prebuilt (untimed); GPU-driven alignment via SQL, timed (cold read after a PostgreSQL restart)"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "active read minimizer index selected before the timed query"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "DOC0294 scheduler concurrency mode for the bioseq SQL persisted-index read path"}
    },
    "bioseq_block_gpu_dp_gpu_seed_no_index": {
      "_": {"type": "integer", "default": 0, "description": "DOC0310 Phase C GPU frontend (Vulkan GPU seeding + tiled-DP chaining + block aligner); load(no index)+GPU recompute align, all via SQL, timed end-to-end"},
      "minimizer_index": {"type": "string", "default": "minimizers_per_fragment", "enum": ["minimizers_per_fragment", "minimizers_per_sequence"], "description": "write-policy minimizer index selected before load/recompute"},
      "recompute_async_persist": {"type": "string", "default": "off", "enum": ["off", "on"], "description": "stage the recompute minimizer index for async persistence (off = pure from-scratch no-index measure)"},
      "pipeline_mode": {"type": "string", "default": "single", "enum": ["single", "parallel", "task_parallel"], "description": "DOC0294 scheduler concurrency mode for the bioseq SQL recompute path"}
    },
    "minimap2_no_index": {
      "_": {"type": "integer", "default": 0, "description": "minimap2 rebuild-each (build+map) on split FASTA"},
      "threads": {"type": "integer", "default": 1, "description": "minimap2 -t value for rebuild+map"}
    },
    "minimap2_just_index": {
      "_": {"type": "integer", "default": 0, "description": "minimap2 prebuilt .mmi (map only)"},
      "threads": {"type": "integer", "default": 1, "description": "minimap2 -t value for map-only with prebuilt .mmi"}
    }
  },

