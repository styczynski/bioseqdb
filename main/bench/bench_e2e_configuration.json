  "bench_e2e": {
    "tags": ["e2e", "main"],
    "description": "Default 2/4 Gbp E2E comparison: bioseq block aligner + SIMD nthash/SIMD chaining, Vulkan GPU seeding+chaining + block aligner, and minimap2. bioseq runs through bioseq.load + SELECT mmsearch; minimap2 runs via CLI on the split FASTA. no_index = from-scratch build+map counted; just_index = index prebuilt untimed, then measured COLD after a PostgreSQL restart.",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_2GBP_DNA4": 3, "E2E_2GBP_DNA5": 3,
