{
  "params": {
    "bioseq_no_index": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "DOC0294 scheduler mode for the bioseq SQL recompute path"
      }
    },
    "bioseq_load_only": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "DOC0296 split: timed TRUNCATE + bioseq.load only"
      }
    },
    "bioseq_recompute_only": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "DOC0296 split: timed mmsearch recompute over an untimed loaded table"
      },
      "recompute_async_persist": {
        "type": "string",
        "default": "off",
        "enum": ["off", "on"],
        "description": "DOC0296: stage a no-index recompute fragment index for async persistence"
      }
    },
    "bioseq_just_index": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "DOC0294 scheduler mode for the bioseq SQL persisted-index read path"
      }
    },
    "minimap2_no_index": {
      "threads": {
        "type": "integer",
        "default": 1,
        "description": "minimap2 -t value for rebuild+map"
      }
    },
    "minimap2_just_index": {
      "threads": {
        "type": "integer",
        "default": 1,
        "description": "minimap2 -t value for map-only with prebuilt .mmi"
      }
    }
  },

  "test_cases": {
    "E2E_2GBP_DNA4": {
      "concurrency": 1,
      "data": {
        "alphabet": "dna4",
        "size_label": "2gbp_dna4",
        "reference_length": 2000000000,
        "fragment_count": 1,
        "fragment_length_mean": 5000000,
        "fragment_length_stddev": 100000,
        "substitution_rate": 0.001,
        "insertion_rate": 0.0005,
        "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0,
        "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5,
        "kmer_size": 15,
        "window_size": 10,
        "minimap2_split_bp": 2000000352,
        "seed": 3219876
      },
      "description": "DOC0294 selected dna4 2 Gbp reference, one 5 Mbp HiFi-error query"
    }
  },

  "bench_e2e": {
    "description": "DOC0294 selected e2e SQL timing matrix: dna4 2 Gbp only, bioseq scheduler modes plus parallel minimap2.",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_2GBP_DNA4": 1 },
      "over": {
        "bioseq_no_index": {
          "pipeline_mode": ["single", "parallel", "task_parallel"]
        },
        "bioseq_load_only": {
          "pipeline_mode": ["single", "parallel", "task_parallel"]
        },
        "bioseq_recompute_only": {
          "pipeline_mode": ["single", "parallel", "task_parallel"]
        },
        "bioseq_just_index": {
          "pipeline_mode": ["single", "parallel", "task_parallel"]
        },
        "minimap2_no_index": {
          "threads": [10]
        },
        "minimap2_just_index": {
          "threads": [10]
        }
      },
      "by_regions": true,
      "metrics": {
        "wall_clock_ns": { "rules": [] },
        "region_total_ns": { "type": "region", "rules": [] },
        "region_visits": { "type": "region", "rules": [] },
        "match_count": { "type": "evaluation" },
        "mean_position_offset_bp": { "type": "evaluation", "rules": [] },
        "found_fraction": { "type": "evaluation", "rules": [] },
        "measured_region_ns_manual": { "type": "evaluation", "rules": [] },
        "peak_postgres_rss_mb": { "type": "evaluation", "rules": [] },
        "peak_minimap2_rss_mb": { "type": "evaluation", "rules": [] },
        "peak_bench_rss_mb": { "type": "evaluation", "rules": [] },
        "min_tmp_available_gib": { "type": "evaluation", "rules": [] },
        "peak_swap_used_mb": { "type": "evaluation", "rules": [] }
      }
    }
  },

