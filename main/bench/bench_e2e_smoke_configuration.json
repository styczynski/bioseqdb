  "test_cases": {
    "E2E_SMOKE": { "concurrency": 1, "data": {
        "alphabet": "dna4", "size_label": "smoke_dna4", "reference_length": 20000000,
        "fragment_count": 1, "fragment_length_mean": 1000000, "fragment_length_stddev": 20000,
        "substitution_rate": 0.001, "insertion_rate": 0.0005, "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0, "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5, "kmer_size": 15, "window_size": 10,
        "minimap2_split_bp": 20000000, "seed": 3219876 },
      "description": "tiny 20 Mbp smoke to validate renames + GPU no_index branch + cold-restart logic" }
  },

  "bench_e2e": {
    "description": "Smoke validation of the e2e path set (all 6 configs, both minimizer indexes, task_parallel, cold-restart just_index).",
    "fast": false,
    "concurrency": { "bench_lock": true, "concurrency": false },
    "matrix": {
      "for": { "E2E_SMOKE": 1 },
      "over": {
        "bioseq_block_simd_dp_two_stack_nthash_no_index":   {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "bioseq_block_simd_dp_two_stack_nthash_just_index": {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "bioseq_block_gpu_dp_gpu_seed_just_index":          {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "bioseq_block_gpu_dp_gpu_seed_no_index":            {"minimizer_index": ["minimizers_per_fragment", "minimizers_per_sequence"], "pipeline_mode": ["task_parallel"]},
        "minimap2_no_index":   {"threads": [10]},
        "minimap2_just_index": {"threads": [10]}
      },
      "by_regions": true,
      "metrics": {
        "wall_clock_ns":   { "rules": [] },
        "region_total_ns": { "type": "region", "rules": [] },
        "region_visits":   { "type": "region", "rules": [] },
        "match_count":            { "type": "evaluation" },
        "mean_position_offset_bp":{ "type": "evaluation", "rules": [] },
        "found_fraction":         { "type": "evaluation", "rules": [] },
        "measured_region_ns_manual": { "type": "evaluation", "rules": [] }
      }
    }
  },

