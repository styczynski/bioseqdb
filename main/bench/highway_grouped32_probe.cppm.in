/**
 * @file highway_grouped32_probe.cppm.in
 * @brief Benchmark-only W1/W2/W4 adapters for the generated grouped32 core.
 *
 * This template is rendered exactly once for the generator-selected static
 * Highway target.  It is an ordinary implementation unit of that existing
 * primary module: it creates no provider, target slot, registry member, or
 * production stream-width axis.
 */
module @BIOSEQ_HIGHWAY_PROBE_PRIMARY_MODULE@;

import std;
import :indexing;
import bioseq.indexing.grouped32_contract;

namespace grouped32_probe_detail {

namespace target_detail = ::bioseq::indexing::
    @BIOSEQ_HIGHWAY_PROBE_TARGET_NAMESPACE@::grouped32_target_detail;

template <std::size_t StreamWidth>
[[nodiscard]] inline
::bioseq::indexing::MinimizerGrouped32NonScatterValidationResult
validate(
        std::span<const std::byte> encoded_bytes,
        const ::bioseq::indexing::MinimizerGrouped32Control& control,
        const ::bioseq::indexing::MinimizerPositionSegmentCore& core) noexcept {
    static_assert(
        StreamWidth == 1u || StreamWidth == 2u || StreamWidth == 4u,
        "grouped32 benchmark probe is deliberately bounded to W1/W2/W4");
    return target_detail::validate_non_scatter_local32_core<StreamWidth>(
        encoded_bytes, control, core);
}

}  // namespace grouped32_probe_detail

extern "C" {

[[nodiscard]]
::bioseq::indexing::MinimizerGrouped32NonScatterValidationResult
bioseq_bench_grouped32_validate_w1(
        std::span<const std::byte> encoded_bytes,
        const ::bioseq::indexing::MinimizerGrouped32Control& control,
        const ::bioseq::indexing::MinimizerPositionSegmentCore& core) noexcept {
    return grouped32_probe_detail::validate<1u>(
        encoded_bytes, control, core);
}

[[nodiscard]]
::bioseq::indexing::MinimizerGrouped32NonScatterValidationResult
bioseq_bench_grouped32_validate_w2(
        std::span<const std::byte> encoded_bytes,
        const ::bioseq::indexing::MinimizerGrouped32Control& control,
        const ::bioseq::indexing::MinimizerPositionSegmentCore& core) noexcept {
    return grouped32_probe_detail::validate<2u>(
        encoded_bytes, control, core);
}

[[nodiscard]]
::bioseq::indexing::MinimizerGrouped32NonScatterValidationResult
bioseq_bench_grouped32_validate_w4(
        std::span<const std::byte> encoded_bytes,
        const ::bioseq::indexing::MinimizerGrouped32Control& control,
        const ::bioseq::indexing::MinimizerPositionSegmentCore& core) noexcept {
    return grouped32_probe_detail::validate<4u>(
        encoded_bytes, control, core);
}

[[nodiscard]] std::size_t
bioseq_bench_grouped32_u32_lanes() noexcept {
    namespace hn = hwy::HWY_NAMESPACE;
    using D8 = hn::ScalableTag<std::uint8_t>;
    using D32 = hn::Repartition<std::uint32_t, D8>;
    return hn::Lanes(D32{});
}

}  // extern "C"
