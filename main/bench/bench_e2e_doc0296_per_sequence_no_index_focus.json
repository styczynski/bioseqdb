{
  "params": {
    "bioseq_block_vulkan_phase_c_frontend_just_index": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "scheduler mode; single suffices for just_index timing"
      },
      "minimizer_index": {
        "type": "string",
        "default": "minimizers_per_sequence",
        "enum": ["minimizers_per_fragment", "minimizers_per_sequence"],
        "description": "active read minimizer index selected before the timed Vulkan query"
      }
    },
    "bioseq_no_index": {
      "pipeline_mode": {
        "type": "string",
        "default": "single",
        "enum": ["single", "parallel", "task_parallel"],
        "description": "DOC0294 scheduler mode for the bioseq SQL recompute path"
      },
      "minimizer_index": {
        "type": "string",
        "default": "minimizers_per_sequence",
        "enum": ["minimizers_per_fragment", "minimizers_per_sequence"],
        "description": "selected minimizer index policy before load/recompute"
      },
      "recompute_async_persist": {
        "type": "string",
        "default": "on",
        "enum": ["off", "on"],
        "description": "stage the selected no-index recompute minimizer index for async persistence"
      },
      "mps_pair_sort_impl": {
        "type": "string",
        "default": "std_sort",
        "enum": [
          "std_sort",
          "simd_u128_vqsort",
          "simd_u128_vec_stream_1",
          "simd_u128_vec_stream_2",
          "simd_u128_vec_stream_4"
        ],
        "description": "per-sequence pair-run sort implementation selected via bioseq.mps_pair_sort_impl"
      }
    }
  },
  "test_cases": {
    "E2E_2GBP_DNA4": {
      "concurrency": 1,
      "data": {
        "alphabet": "dna4",
        "size_label": "2gbp_dna4",
        "reference_length": 2000000000,
        "fragment_count": 1,
        "fragment_length_mean": 5000000,
        "fragment_length_stddev": 100000,
        "substitution_rate": 0.001,
        "insertion_rate": 0.0005,
        "deletion_rate": 0.0005,
        "insertion_length_mean": 1.0,
        "deletion_length_mean": 1.0,
        "reverse_complement_rate": 0.5,
        "kmer_size": 15,
        "window_size": 10,
        "minimap2_split_bp": 2000000352,
        "seed": 3219876
      },
      "description": "DOC0296 per-sequence no-index focus: dna4 2 Gbp reference, one 5 Mbp HiFi-error query"
    }
  },
