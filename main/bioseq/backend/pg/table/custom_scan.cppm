export const CustomScanMethods *
bioseq_customscan_methods(void)
{
	return &BioseqColumnScanScanMethods;
}

export bool
bioseq_customscan_has_valid_semantic_payload(
		const CustomScan* scan) noexcept
{
	if (scan == nullptr || scan->methods != &BioseqColumnScanScanMethods) {
		return false;
	}
	FrozenBioseqScanSemantics semantics{};
	return decode_bioseq_semantic_payload(
		scan->custom_private, &semantics);
}

/*
 * Walker context for bioseq_node_has_projection_or_mmsearch.
 */
struct BioseqProjectionPresenceProbe {
	const BioseqStubOids* stub_oids;
	bool found;
};

struct projection_presence_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, BioseqProjectionPresenceProbe& data) const {
		if (data.found) return pg_walk_step::stop;
		if (FuncExpr* fe = node.try_as<FuncExpr>()) {
			if (is_bioseq_projection_funcid(fe->funcid, *data.stub_oids)
				|| is_mmsearch_funcid(fe->funcid, *data.stub_oids)
				|| fe->funcid == data.stub_oids->symbol_count_oid) {
				data.found = true;
				return pg_walk_step::stop;
			}
		}
		return pg_walk_step::descend;
	}
};

/*
 * True if any node in the expression tree references a bioseq.<...>
 * projection FuncExpr (cigar / score / target_*, or symbol_count) or
 * an mmsearch FuncExpr. The vectorised aggregator rewrite path uses
 * this to skip its rewrite when the agg input depends on any of
 * these — the projection FuncExprs are scan-time-rewritten into
 * placeholder Consts that the regular Postgres Aggregate node can
 * evaluate, but the vectorised aggregator expects vector-typed
 * scan output and crashes with a SIGSEGV when fed a regular slot
 * carrying our placeholder Consts.
 */
export bool
bioseq_expr_uses_bioseq_projection(Node* node)
{
	if (node == nullptr) {
		return false;
	}
	const BioseqStubOids* stub_oids = try_get_cached_stub_oids();
	if (stub_oids == nullptr) return false;
	BioseqProjectionPresenceProbe probe{ stub_oids, false };
	projection_presence_visitor visitor;
	pg_walk_expression_including_root(node, probe, visitor);
	return probe.found;
}

/* ========================================================================
 * DOC0377 BioseqSliceProject
 *
 * The executable expression remains PostgreSQL's targetlist expression.  The
 * codec below is deliberately symbolic: it records the lazy sequence algebra
 * for EXPLAIN and validation while core ExprState/ProjectionInfo preserves
 * CASE, NULL, STRICT, volatility and error semantics.  Every serialized value
 * is a PostgreSQL Node, so copy/equal/out/read and setrefs remain core-owned.
 * ====================================================================== */

enum class SliceProjectOpcode : std::uint8_t {
	source_expr = 1,
	literal_expr = 2,
	element = 3,
	slice = 4,
	concat = 5,
	reverse = 6,
	reverse_complement = 7,
	length = 8,
	cardinality = 9,
	bridge = 10,
	materialize = 11,
};

constexpr int kBioseqSliceProjectMagic = 0x42535031; /* BSP1 */
constexpr int kBioseqSliceProjectCodecVersion = 3;
constexpr int kBioseqSliceProjectHeaderFields = 10;
constexpr int kBioseqSliceProjectNodeFields = 11;
constexpr int kBioseqSliceProjectRecordFields = 9;

enum SliceProjectHeaderIndex : int {
	kSliceHeaderMagic = 0,
	kSliceHeaderVersion = 1,
	kSliceHeaderBoundaryCount = 2,
	kSliceHeaderExpressionCount = 3,
	kSliceHeaderPieceBoundaries = 4,
	kSliceHeaderSourcePieces = 5,
	kSliceHeaderPlannedSymbols = 6,
	kSliceHeaderPlannedBytes = 7,
	kSliceHeaderProducerCount = 8,
	kSliceHeaderFallbackReason = 9,
};

enum SliceProjectRecordIndex : int {
	kSliceRecordBoundaryId = 0,
	kSliceRecordProducerId = 1,
	kSliceRecordExpressionIndex = 2,
	kSliceRecordDependencies = 3,
	kSliceRecordMechanism = 4,
	kSliceRecordReason = 5,
	kSliceRecordEstimatedSymbols = 6,
	kSliceRecordEncoding = 7,
	kSliceRecordCacheScope = 8,
};

enum SliceProjectNodeIndex : int {
	kSliceNodeStableId = 0,
	kSliceNodeOpcode = 1,
	kSliceNodeDependencies = 2,
	kSliceNodeExpressionIndex = 3,
	kSliceNodeLowerExpressionIndex = 4,
	kSliceNodeUpperExpressionIndex = 5,
	kSliceNodeOptionsExpressionIndex = 6,
	kSliceNodeTransform = 7,
	kSliceNodeMechanism = 8,
	kSliceNodeReason = 9,
	kSliceNodeFlags = 10,
};

enum SliceProjectNodeFlags : int {
	kSliceNodeVolatile = 1 << 0,
	kSliceNodeOpaque = 1 << 1,
};

[[nodiscard]] static Const* slice_project_int8_const(std::uint64_t value) {
	const std::uint64_t clamped = std::min<std::uint64_t>(
		value, static_cast<std::uint64_t>(INT64_MAX));
	return makeConst(INT8OID, -1, InvalidOid, sizeof(std::int64_t),
		Int64GetDatum(static_cast<std::int64_t>(clamped)), false, true);
}

[[nodiscard]] static std::uint64_t slice_project_int8_value(Node* node) {
	Const* value = pg_node_try_as<Const>(node);
	if (value == nullptr || value->constisnull || value->consttype != INT8OID) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject uint64 codec value is invalid")));
	}
	const std::int64_t decoded = DatumGetInt64(value->constvalue);
	if (decoded < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject uint64 codec value is negative")));
	}
	return static_cast<std::uint64_t>(decoded);
}

[[nodiscard]] static const char* slice_project_mechanism_name(
		materialization_mechanism mechanism) noexcept {
	switch (mechanism) {
		case materialization_mechanism::backing_copy: return "backing copy";
		case materialization_mechanism::packed_full: return "packed full";
		case materialization_mechanism::packed_region: return "packed region";
		case materialization_mechanism::text: return "text";
		case materialization_mechanism::binary: return "binary";
		case materialization_mechanism::letter_array: return "letter array";
	}
	return "invalid";
}

[[nodiscard]] static const char* slice_project_reason_name(
		materialization_reason reason) noexcept {
	switch (reason) {
		case materialization_reason::executor_copy: return "executor copy";
		case materialization_reason::heap_tuple: return "heap tuple";
		case materialization_reason::index_tuple: return "index tuple";
		case materialization_reason::mmsearch_target: return "mmsearch target";
		case materialization_reason::mmsearch_query: return "mmsearch query";
		case materialization_reason::resident_algorithm:
			return "resident algorithm";
		case materialization_reason::sql_conversion: return "SQL conversion";
		case materialization_reason::client_output: return "client output";
	}
	return "invalid";
}

[[nodiscard]] static const char* slice_project_encoding_name(
		materialization_mechanism mechanism) noexcept {
	switch (mechanism) {
		case materialization_mechanism::packed_full:
		case materialization_mechanism::packed_region:
			return "alphabet packed";
		case materialization_mechanism::text:
			return "database encoding text";
		case materialization_mechanism::binary:
			return "bioseq binary";
		case materialization_mechanism::letter_array:
			return "bioseq.letter[]";
		case materialization_mechanism::backing_copy:
			return "source encoding";
	}
	return "unknown";
}

[[nodiscard]] static bool slice_project_concat_oid(
		Oid oid, const BioseqStubOids& oids) noexcept {
	return oid == oids.seq_concat_oid
		|| oid == oids.seq_array_cat_oid
		|| oid == oids.seq_concat_text_oid
		|| oid == oids.text_concat_seq_oid
		|| oid == oids.seq_concat_varchar_oid
		|| oid == oids.varchar_concat_seq_oid
		|| oid == oids.seq_concat_text_array_oid
		|| oid == oids.text_array_concat_seq_oid
		|| oid == oids.seq_concat_letter_array_oid
		|| oid == oids.letter_array_concat_seq_oid;
}

[[nodiscard]] static std::optional<SliceProjectOpcode>
slice_project_function_opcode(FuncExpr* function,
		const BioseqStubOids& oids) noexcept {
	if (function == nullptr) return std::nullopt;
	if (slice_project_concat_oid(function->funcid, oids)) {
		return SliceProjectOpcode::concat;
	}
	if (function->funcid == oids.seq_reverse_oid) {
		return SliceProjectOpcode::reverse;
	}
	if (function->funcid == oids.seq_reverse_complement_oid) {
		return SliceProjectOpcode::reverse_complement;
	}
	if (function->funcid == oids.seq_len_oid
		|| function->funcid == oids.seq_array_length_oid) {
		return SliceProjectOpcode::length;
	}
	if (function->funcid == oids.seq_cardinality_oid) {
		return SliceProjectOpcode::cardinality;
	}
	if (function->funcid == oids.seq_to_text_oid
		|| function->funcid == oids.seq_to_varchar_oid
		|| function->funcid == oids.seq_to_array_oid) {
		return SliceProjectOpcode::materialize;
	}
	if (function->funcid == oids.seq_from_letter_array_infer_oid
		|| function->funcid == oids.seq_from_letter_array_named_oid) {
		return SliceProjectOpcode::bridge;
	}
	return std::nullopt;
}

[[nodiscard]] static std::optional<SliceProjectOpcode>
slice_project_node_opcode(Node* node, const BioseqStubOids& oids) noexcept {
	if (node == nullptr) return std::nullopt;
	if (IsA(node, SubscriptingRef)) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(node);
		if (subscript->refcontainertype != oids.bioseq_seq_type_oid) {
			return std::nullopt;
		}
		/* A valid one-dimensional PG17 bound coordinate is NIL or exactly
		 * one cell (whose payload may be nullptr for an omitted bound).
		 * Leave wider/corrupt shapes opaque so the native subscript path
		 * raises its normative unsupported-shape error. */
		if ((subscript->reflowerindexpr != NIL
				&& list_length(subscript->reflowerindexpr) != 1)
			|| (subscript->refupperindexpr != NIL
				&& list_length(subscript->refupperindexpr) != 1)) {
			return std::nullopt;
		}
		return subscript->reflowerindexpr == NIL
			? SliceProjectOpcode::element : SliceProjectOpcode::slice;
	}
	if (FuncExpr* function = pg_node_try_as<FuncExpr>(node)) {
		return slice_project_function_opcode(function, oids);
	}
	if (OpExpr* operation = pg_node_try_as<OpExpr>(node)) {
		/* PostgreSQL represents SQL operator syntax as OpExpr, even when the
		 * implementation is one of the exact registered concat functions.  Do
		 * not recognize an arbitrary operator merely because opfuncid happens
		 * to be populated: prove the binary catalog operator/function identity
		 * and the sequence result shape first. */
		if (OidIsValid(operation->opno)
			&& OidIsValid(operation->opfuncid)
			&& get_opcode(operation->opno) == operation->opfuncid
			&& slice_project_concat_oid(operation->opfuncid, oids)
			&& operation->opresulttype == oids.bioseq_seq_type_oid
			&& !operation->opretset
			&& list_length(operation->args) == 2) {
			return SliceProjectOpcode::concat;
		}
	}
	return std::nullopt;
}

[[nodiscard]] static List* slice_project_call_arguments(Node* node) noexcept {
	if (FuncExpr* function = pg_node_try_as<FuncExpr>(node)) {
		return function->args;
	}
	if (OpExpr* operation = pg_node_try_as<OpExpr>(node)) {
		return operation->args;
	}
	return NIL;
}

/* PostgreSQL wraps INSERT projection values in the registered same-type
 * typmod cast.  The cast preserves logical length and the child lazy recipe;
 * the destination slot is still the one unavoidable heap boundary.  Admit
 * only the exact implicit, planner-constant cast shape.  Explicit calls and
 * unrelated sequence-returning functions remain opaque producer leaves. */
[[nodiscard]] static inline Node* slice_project_typmod_cast_source(
		Node* node, const BioseqStubOids& oids) noexcept {
	FuncExpr* function = pg_node_try_as<FuncExpr>(node);
	if (function == nullptr || function->funcid != oids.seq_cast_oid
		|| function->funcresulttype != oids.bioseq_seq_type_oid
		|| function->funcretset || OidIsValid(function->funcvariadic)
		|| function->funcformat != COERCE_IMPLICIT_CAST
		|| list_length(function->args) != 3) return nullptr;
	Node* source = reinterpret_cast<Node*>(linitial(function->args));
	Const* target_typmod = pg_node_try_as<Const>(
		reinterpret_cast<Node*>(lsecond(function->args)));
	Const* explicit_cast = pg_node_try_as<Const>(
		reinterpret_cast<Node*>(lthird(function->args)));
	if (source == nullptr || exprType(source) != oids.bioseq_seq_type_oid
		|| target_typmod == nullptr || target_typmod->constisnull
		|| target_typmod->consttype != INT4OID
		|| DatumGetInt32(target_typmod->constvalue) < 0
		|| explicit_cast == nullptr || explicit_cast->constisnull
		|| explicit_cast->consttype != BOOLOID
		|| DatumGetBool(explicit_cast->constvalue)) return nullptr;
	return source;
}

/* PG17 represents an omitted slice bound as either NIL or a one-cell List
 * whose cell contains nullptr.  Both forms are canonical omission; no nullptr
 * may enter custom_exprs and deparse as an empty string. */
[[nodiscard]] static inline Node* slice_project_subscript_bound(
		List* expressions) {
	if (expressions == NIL) return nullptr;
	if (list_length(expressions) != 1) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject slice bound list is invalid"),
			 errdetail("bound_count=%d expected_count=1",
				 list_length(expressions))));
	}
	return reinterpret_cast<Node*>(linitial(expressions));
}

[[nodiscard]] static std::uint64_t slice_project_estimated_symbols(
		Node* node, const BioseqStubOids& oids) {
	if (node == nullptr) return 0u;
	if (Node* source = slice_project_typmod_cast_source(node, oids)) {
		return slice_project_estimated_symbols(source, oids);
	}
	if (IsA(node, SubscriptingRef)) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(node);
		if (subscript->reflowerindexpr == NIL) return 1u;
		if (list_length(subscript->reflowerindexpr) != 1
			|| (subscript->refupperindexpr != NIL
				&& list_length(subscript->refupperindexpr) != 1)) {
			return 4096u;
		}
		Node* lower = slice_project_subscript_bound(
			subscript->reflowerindexpr);
		Node* upper = slice_project_subscript_bound(
			subscript->refupperindexpr);
		auto constant_bound = [](Node* expression)
				-> std::optional<std::int64_t> {
			Const* constant = pg_node_try_as<Const>(expression);
			if (constant == nullptr || constant->constisnull
				|| constant->consttype != INT8OID) return std::nullopt;
			return DatumGetInt64(constant->constvalue);
		};
		const auto lo = constant_bound(lower);
		const auto hi = constant_bound(upper);
		if (lower == nullptr && hi.has_value() && *hi >= 0) {
			return static_cast<std::uint64_t>(*hi);
		}
		if (upper == nullptr && lo.has_value() && *lo < 0) {
			return bioseq::storage::magnitude_of_negative(*lo);
		}
		if (lo.has_value() && hi.has_value() && *hi >= *lo) {
			if (*lo >= 0) {
				return static_cast<std::uint64_t>(*hi - *lo);
			}
			if (*hi < 0) {
				return bioseq::storage::magnitude_of_negative(*lo)
					- bioseq::storage::magnitude_of_negative(*hi);
			}
			/* A negative lower with a nonnegative upper depends on the
			 * unknown source length; do not mislabel an upper bound as an
			 * exact selected-range estimate. */
			return 4096u;
		}
		return 4096u;
	}
	if (FuncExpr* function = pg_node_try_as<FuncExpr>(node)) {
		const auto opcode = slice_project_function_opcode(function, oids);
		if (!opcode.has_value()) return 4096u;
		if (*opcode == SliceProjectOpcode::concat) {
			std::uint64_t total = 0u;
			for (Node* argument : PList<Node>(function->args)) {
				total = bioseq::parallelism::saturating_add(
					total, slice_project_estimated_symbols(argument, oids));
			}
			return total;
		}
		if (*opcode == SliceProjectOpcode::length
			|| *opcode == SliceProjectOpcode::cardinality) return 1u;
		if (function->args != NIL) {
			return slice_project_estimated_symbols(
				reinterpret_cast<Node*>(linitial(function->args)), oids);
		}
	}
	if (OpExpr* operation = pg_node_try_as<OpExpr>(node)) {
		const auto opcode = slice_project_node_opcode(node, oids);
		if (opcode.has_value() && *opcode == SliceProjectOpcode::concat) {
			std::uint64_t total = 0u;
			for (Node* argument : PList<Node>(operation->args)) {
				total = bioseq::parallelism::saturating_add(
					total, slice_project_estimated_symbols(argument, oids));
			}
			return total;
		}
	}
	return 4096u;
}

struct owned_mmsearch_cost {
	Cost startup = 0;
	Cost per_input_tuple = 0;
};

/* Cost only executable operands, in SQL argument order.  In particular the
 * rendezvous FuncExpr itself (whose support function deliberately costs
 * 100000) must never enter an owning path's cost tree. */
[[nodiscard]] static List* mmsearch_operand_cost_exprs(
		FuncExpr const* expression, BioseqStubOids const& oids) {
	if (expression == nullptr || !is_mmsearch_funcid(expression->funcid, oids)
		|| (expression->funcid == oids.mmsearch_oid
			&& list_length(expression->args) != 2)
		|| (expression->funcid == oids.mmsearch_with_opts_oid
			&& list_length(expression->args) != 3)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("owned mmsearch operand cost shape is invalid")));
	}
	List* operands = NIL;
	for (Node* argument : PList<Node>(expression->args)) {
		operands = lappend(operands, argument);
	}
	return operands;
}

[[nodiscard]] static std::uint64_t estimate_mmsearch_operand_symbols(
		Node* expression, BioseqStubOids const& oids) {
	if (expression == nullptr) return 4096u;
	if (Const* constant = pg_node_try_as<Const>(expression)) {
		if (constant->constisnull) return 0u;
		if (constant->consttype == oids.bioseq_seq_type_oid) {
			return classify_and_describe_sequence_header(
				constant->constvalue).bp_length;
		}
	}
	const auto opcode = slice_project_node_opcode(expression, oids);
	if (opcode.has_value()) {
		return slice_project_estimated_symbols(expression, oids);
	}
	return 4096u;
}

[[nodiscard]] static owned_mmsearch_cost estimate_owned_mmsearch_cost(
		std::uint64_t target_length_estimate,
		std::uint64_t query_length_estimate,
		double input_rows,
		bool index_read_requirement,
		std::uint32_t planned_batch_size,
		std::uint64_t planned_materialized_bytes) noexcept {
	constexpr Cost maximum = std::numeric_limits<Cost>::max() / 32.0;
	auto finite_cost = [](long double value) noexcept -> Cost {
		constexpr long double limit = static_cast<long double>(
			std::numeric_limits<Cost>::max() / 32.0);
		if (!(value >= 0.0L)) return 0;
		if (value >= limit) return static_cast<Cost>(limit);
		return static_cast<Cost>(value);
	};
	const std::uint32_t batch_size = std::max<std::uint32_t>(
		1u, planned_batch_size);
	const long double target_units = static_cast<long double>(
		target_length_estimate / 64u
		+ (target_length_estimate % 64u != 0u));
	const long double query_units = static_cast<long double>(
		query_length_estimate / 64u
		+ (query_length_estimate % 64u != 0u));
	const long double byte_pages = static_cast<long double>(
		planned_materialized_bytes / BLCKSZ)
		+ (planned_materialized_bytes % BLCKSZ != 0u);
	const long double rows = std::isfinite(input_rows) && input_rows > 0.0
		? static_cast<long double>(input_rows) : 0.0L;
	const long double batch_count = rows == 0.0L ? 1.0L
		: std::ceil(rows / static_cast<long double>(batch_size));
	const long double startup = static_cast<long double>(cpu_operator_cost)
		* (8.0L + query_units + batch_count)
		+ (index_read_requirement
			? static_cast<long double>(random_page_cost) : 0.0L);
	const long double per_input = static_cast<long double>(cpu_tuple_cost)
		+ static_cast<long double>(cpu_operator_cost)
			* (8.0L + target_units + query_units)
		+ static_cast<long double>(seq_page_cost) * byte_pages
			/ static_cast<long double>(batch_size);
	owned_mmsearch_cost result{
		finite_cost(startup), finite_cost(per_input)};
	if (!std::isfinite(result.startup) || result.startup < 0) {
		result.startup = maximum;
	}
	if (!std::isfinite(result.per_input_tuple)
		|| result.per_input_tuple < 0) {
		result.per_input_tuple = maximum;
	}
	return result;
}

struct SliceProjectIrBuilder {
	const BioseqStubOids* oids = nullptr;
	CmdType command_type = CMD_UNKNOWN;
	PlannerInfo* planner_root = nullptr;
	Index target_leaf_support_relid = 0;
	List* target_leaf_support_vars = NIL;
	List* expressions = NIL;
	List* nodes = NIL;
	List* records = NIL;
	List* output_bindings = NIL;
	std::vector<Node*> producer_expressions{};
	std::vector<std::vector<std::uint32_t>> producer_dependencies{};
	std::vector<std::pair<Node*, std::uint32_t>> source_bindings{};
	bool source_bindings_only = false;
	std::uint32_t next_boundary_id = 1u;
	std::uint64_t piece_boundaries = 0u;
	std::uint64_t source_pieces = 0u;
	std::uint64_t planned_symbols = 0u;
	std::uint64_t planned_bytes = 0u;
	bool found = false;
};

[[nodiscard]] static int slice_project_add_expression(
		SliceProjectIrBuilder& builder, Node* expression) {
	int index = 0;
	for (Node* candidate : PList<Node>(builder.expressions)) {
		if (equal(candidate, expression)) return index;
		++index;
	}
	index = list_length(builder.expressions);
	builder.expressions = lappend(builder.expressions, copyObject(expression));
	return index;
}

[[nodiscard]] static std::uint32_t slice_project_add_producer(
		SliceProjectIrBuilder& builder, Node* expression,
		bool distinct_consumer = false, bool force_value = false) {
	check_stack_depth();
	if (expression == nullptr) return 0u;
	if (Node* source = slice_project_typmod_cast_source(
			expression, *builder.oids)) {
		return slice_project_add_producer(
			builder, source, distinct_consumer, force_value);
	}
	const auto operation = slice_project_node_opcode(expression, *builder.oids);
	if (exprType(expression) != builder.oids->bioseq_seq_type_oid
		&& !operation.has_value() && !force_value) return 0u;
	/* CSE is descriptive only, but even descriptive CSE would hide distinct
	 * occurrences of a volatile expression from EXPLAIN. */
	if (!distinct_consumer && !contain_volatile_functions(expression)) {
		for (std::size_t index = 0u;
			 index < builder.producer_expressions.size(); ++index) {
			if (equal(builder.producer_expressions[index], expression)) {
				return static_cast<std::uint32_t>(index + 1u);
			}
		}
	}
	/* Assign children first so stable ids are deterministic and topological. */
	std::vector<std::uint32_t> dependencies;
	auto add_dependency = [&builder, &dependencies](
			Node* child, bool force_child) {
		const std::uint32_t dependency = slice_project_add_producer(
			builder, child, false, force_child);
		if (dependency == 0u
			|| std::find(dependencies.begin(), dependencies.end(), dependency)
				!= dependencies.end()) return;
		dependencies.push_back(dependency);
	};
	/* Opaque source expressions are PostgreSQL-evaluated leaves in this
	 * descriptive graph.  Only recognized lazy operations expose producer
	 * dependencies; otherwise a sequence-returning FuncExpr would be encoded
	 * as source_expr while still carrying children, contradicting the codec. */
	if (operation.has_value() && IsA(expression, SubscriptingRef)) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(expression);
		add_dependency(reinterpret_cast<Node*>(subscript->refexpr), false);
	} else if (operation.has_value()) {
		const bool all_arguments_are_values = *operation
			== SliceProjectOpcode::concat
			|| *operation == SliceProjectOpcode::bridge;
		for (Node* argument : PList<Node>(
				slice_project_call_arguments(expression))) {
			if (exprType(argument) == builder.oids->bioseq_seq_type_oid
				|| slice_project_node_opcode(
					argument, *builder.oids).has_value()
				|| all_arguments_are_values) {
				add_dependency(argument, all_arguments_are_values);
			}
		}
	}
	if (builder.producer_expressions.size()
		>= static_cast<std::size_t>(INT_MAX - 1)) {
		ereport(ERROR,
			(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
			 errmsg("BioseqSliceProject producer graph is too large")));
	}
	const std::uint32_t stable_id = static_cast<std::uint32_t>(
		builder.producer_expressions.size() + 1u);
	const int expression_index = slice_project_add_expression(
		builder, expression);
	const SliceProjectOpcode opcode = operation.has_value() ? *operation
		: (IsA(expression, Const) ? SliceProjectOpcode::literal_expr
			: SliceProjectOpcode::source_expr);
	int lower_expression_index = -1;
	int upper_expression_index = -1;
	if ((opcode == SliceProjectOpcode::slice
			|| opcode == SliceProjectOpcode::element)
		&& IsA(expression, SubscriptingRef)) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(expression);
		if (Node* lower = slice_project_subscript_bound(
				subscript->reflowerindexpr)) {
			lower_expression_index = slice_project_add_expression(builder,
				lower);
		}
		if (Node* upper = slice_project_subscript_bound(
				subscript->refupperindexpr)) {
			upper_expression_index = slice_project_add_expression(builder,
				upper);
		}
	}
	int transform = 0;
	if (opcode == SliceProjectOpcode::reverse) transform = 1;
	if (opcode == SliceProjectOpcode::reverse_complement) transform = 3;
	int mechanism = -1;
	int reason = -1;
	if (opcode == SliceProjectOpcode::materialize) {
		auto* function = reinterpret_cast<FuncExpr*>(expression);
		mechanism = static_cast<int>(function->funcid
			== builder.oids->seq_to_array_oid
			? materialization_mechanism::letter_array
			: materialization_mechanism::text);
		reason = static_cast<int>(materialization_reason::sql_conversion);
	}
	int flags = 0;
	if (contain_volatile_functions(expression)) flags |= kSliceNodeVolatile;
	if (!operation.has_value() && !IsA(expression, Var)
		&& !IsA(expression, Const)) flags |= kSliceNodeOpaque;
	List* dependency_codec = NIL;
	for (const std::uint32_t dependency : dependencies) {
		dependency_codec = lappend(dependency_codec,
			makeInteger(static_cast<int>(dependency)));
	}
	List* node = list_make5(
		makeInteger(static_cast<int>(stable_id)),
		makeInteger(static_cast<int>(opcode)), dependency_codec,
		makeInteger(expression_index), makeInteger(lower_expression_index));
	node = lappend(node, makeInteger(upper_expression_index));
	node = lappend(node, makeInteger(-1)); /* optional mmsearch options Expr */
	node = lappend(node, makeInteger(transform));
	node = lappend(node, makeInteger(mechanism));
	node = lappend(node, makeInteger(reason));
	node = lappend(node, makeInteger(flags));
	builder.nodes = lappend(builder.nodes, node);
	if (opcode == SliceProjectOpcode::source_expr
		|| opcode == SliceProjectOpcode::literal_expr) {
		builder.source_pieces = bioseq::parallelism::saturating_add(
			builder.source_pieces, 1u);
	}
	builder.producer_expressions.push_back(
		reinterpret_cast<Node*>(copyObject(expression)));
	builder.producer_dependencies.push_back(std::move(dependencies));
	return stable_id;
}

static void slice_project_note_source_binding(
		SliceProjectIrBuilder& builder, Node* sequence_expression,
		std::uint32_t producer_id) {
	if (sequence_expression == nullptr || producer_id == 0u) return;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* sources = pull_var_clause(sequence_expression, pull_flags);
	for (Node* source : PList<Node>(sources)) {
		Var* var = pg_node_try_as<Var>(source);
		if (var == nullptr || var->vartype != builder.oids->bioseq_seq_type_oid) {
			continue;
		}
		bool seen = false;
		for (auto& binding : builder.source_bindings) {
			if (!equal(binding.first, source)) continue;
			/* Zero is the deliberate ambiguity marker.  A source Datum cannot
			 * truthfully carry two simultaneous pre-projection producer ids. */
			if (binding.second != producer_id) binding.second = 0u;
			seen = true;
			break;
		}
		if (!seen) {
			builder.source_bindings.emplace_back(
				reinterpret_cast<Node*>(copyObject(source)), producer_id);
		}
	}
}

[[nodiscard]] static bool slice_project_producer_depends_on(
		SliceProjectIrBuilder const& builder, std::uint32_t producer_id,
		std::uint32_t possible_ancestor) {
	if (producer_id == 0u || possible_ancestor == 0u
		|| producer_id > builder.producer_dependencies.size()
		|| possible_ancestor >= producer_id) return false;
	std::vector<std::uint8_t> visited(
		builder.producer_dependencies.size() + 1u, 0u);
	std::vector<std::uint32_t> pending(
		builder.producer_dependencies[producer_id - 1u].begin(),
		builder.producer_dependencies[producer_id - 1u].end());
	while (!pending.empty()) {
		const std::uint32_t candidate = pending.back();
		pending.pop_back();
		if (candidate == possible_ancestor) return true;
		if (candidate == 0u
			|| candidate > builder.producer_dependencies.size()
			|| visited[candidate] != 0u) continue;
		visited[candidate] = 1u;
		auto const& dependencies = builder.producer_dependencies[candidate - 1u];
		pending.insert(pending.end(), dependencies.begin(), dependencies.end());
	}
	return false;
}

static void slice_project_add_boundary(
		SliceProjectIrBuilder& builder, Node* sequence_expression,
		std::uint32_t producer_id, materialization_mechanism mechanism,
		materialization_reason reason, bool preprojection) {
	if (sequence_expression == nullptr || producer_id == 0u) return;
	const int expression_index = slice_project_add_expression(
		builder, sequence_expression);
	for (Node* raw : PList<Node>(builder.records)) {
		List* record = reinterpret_cast<List*>(raw);
		if (intVal(list_nth(record, kSliceRecordProducerId))
				== static_cast<int>(producer_id)
			&& intVal(list_nth(record, kSliceRecordExpressionIndex))
				== expression_index
			&& intVal(list_nth(record, kSliceRecordMechanism))
				== static_cast<int>(mechanism)
			&& intVal(list_nth(record, kSliceRecordReason))
				== static_cast<int>(reason)) return;
	}
	if (builder.next_boundary_id == UINT32_MAX) {
		ereport(ERROR,
			(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
			 errmsg("BioseqSliceProject materialization DAG is too large")));
	}
	const std::uint64_t estimated_symbols = slice_project_estimated_symbols(
		sequence_expression, *builder.oids);
	List* dependencies = NIL;
	for (Node* raw : PList<Node>(builder.records)) {
		List* previous = reinterpret_cast<List*>(raw);
		const auto previous_producer = static_cast<std::uint32_t>(intVal(
			list_nth(previous, kSliceRecordProducerId)));
		if (!slice_project_producer_depends_on(
				builder, producer_id, previous_producer)) continue;
		dependencies = lappend(dependencies, makeInteger(intVal(
			list_nth(previous, kSliceRecordBoundaryId))));
	}
	List* record = list_make5(
		makeInteger(static_cast<int>(builder.next_boundary_id++)),
		makeInteger(static_cast<int>(producer_id)),
		makeInteger(expression_index), dependencies,
		makeInteger(static_cast<int>(mechanism)));
	record = lappend(record, makeInteger(static_cast<int>(reason)));
	record = lappend(record, slice_project_int8_const(estimated_symbols));
	record = lappend(record, makeString(pstrdup(
		slice_project_encoding_name(mechanism))));
	record = lappend(record, makeString(pstrdup(
		preprojection ? "projection row" : "result datum")));
	builder.records = lappend(builder.records, record);
	builder.planned_symbols = bioseq::parallelism::saturating_add(
		builder.planned_symbols, estimated_symbols);
	builder.planned_bytes = bioseq::parallelism::saturating_add(
		builder.planned_bytes, estimated_symbols);
	if (preprojection) {
		slice_project_note_source_binding(
			builder, sequence_expression, producer_id);
	}
}

[[nodiscard]] static std::uint32_t slice_project_build_ir_node(
		SliceProjectIrBuilder& builder, Node* expression) {
	check_stack_depth();
	if (expression == nullptr) return 0u;
	const auto operation = slice_project_node_opcode(expression, *builder.oids);
	if (!operation.has_value()) {
		return slice_project_add_producer(builder, expression);
	}
	builder.found = true;
	const SliceProjectOpcode opcode = *operation;
	if (opcode == SliceProjectOpcode::slice
		|| opcode == SliceProjectOpcode::concat
		|| opcode == SliceProjectOpcode::reverse
		|| opcode == SliceProjectOpcode::reverse_complement) {
		builder.piece_boundaries = bioseq::parallelism::saturating_add(
			builder.piece_boundaries, 1u);
	}
	if (List* arguments = slice_project_call_arguments(expression);
		arguments != NIL) {
		for (Node* argument : PList<Node>(arguments)) {
			if (slice_project_node_opcode(argument, *builder.oids).has_value()) {
				(void)slice_project_build_ir_node(builder, argument);
			} else if (exprType(argument) == builder.oids->bioseq_seq_type_oid) {
				(void)slice_project_add_producer(builder, argument);
			}
		}
		FuncExpr* function = pg_node_try_as<FuncExpr>(expression);
		if (opcode == SliceProjectOpcode::materialize
			&& function != nullptr) {
			Node* source = reinterpret_cast<Node*>(linitial(arguments));
			const std::uint32_t producer_id = slice_project_add_producer(
				builder, source);
			const bool as_array = function->funcid
				== builder.oids->seq_to_array_oid;
			slice_project_add_boundary(builder, source, producer_id,
				as_array ? materialization_mechanism::letter_array
					: materialization_mechanism::text,
				materialization_reason::sql_conversion, true);
		}
	} else if (IsA(expression, SubscriptingRef)) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(expression);
		Node* source = reinterpret_cast<Node*>(subscript->refexpr);
		if (slice_project_node_opcode(source, *builder.oids).has_value()) {
			(void)slice_project_build_ir_node(builder, source);
		} else {
			(void)slice_project_add_producer(builder, source);
		}
	}
	return slice_project_add_producer(builder, expression);
}

struct SliceProjectDiscovery {
	SliceProjectIrBuilder* builder = nullptr;
	bool found = false;
};

struct slice_project_discovery_visitor {
	[[nodiscard]] pg_walk_step operator()(
		pg_expression_walk_cursor, pg_node_view node,
		SliceProjectDiscovery& discovery) const {
		if (slice_project_node_opcode(
				node.raw(), *discovery.builder->oids).has_value()) {
			if (contain_volatile_functions(node.raw())) {
				return pg_walk_step::skip_subtree;
			}
			(void)slice_project_build_ir_node(
				*discovery.builder, node.raw());
			discovery.found = true;
			return pg_walk_step::skip_subtree;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool slice_project_discover_target(
		PathTarget* target, SliceProjectIrBuilder& builder) {
	if (target == nullptr) return false;
	slice_project_discovery_visitor visitor;
	int resno = 1;
	for (Node* expression : PList<Node>(target->exprs)) {
		SliceProjectDiscovery discovery{&builder};
		pg_walk_expression_including_root(expression, discovery, visitor);
		if (discovery.found
			&& exprType(expression) == builder.oids->bioseq_seq_type_oid) {
			const std::uint32_t producer_id = slice_project_add_producer(
				builder, expression);
			builder.output_bindings = lappend(builder.output_bindings,
				list_make2(makeInteger(resno),
					makeInteger(static_cast<int>(producer_id))));
			if (builder.command_type == CMD_INSERT) {
				slice_project_add_boundary(builder, expression, producer_id,
					materialization_mechanism::packed_full,
					materialization_reason::heap_tuple, false);
			} else if (builder.command_type == CMD_SELECT) {
				slice_project_add_boundary(builder, expression, producer_id,
					materialization_mechanism::text,
					materialization_reason::client_output, false);
				slice_project_add_boundary(builder, expression, producer_id,
					materialization_mechanism::binary,
					materialization_reason::client_output, false);
			}
		}
		++resno;
	}
	return builder.found;
}

export bool bioseq_expr_uses_lazy_sequence_projection(Node* node) {
	if (node == nullptr) return false;
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (oids == nullptr) return false;
	SliceProjectIrBuilder builder{.oids = oids};
	SliceProjectDiscovery discovery{&builder};
	slice_project_discovery_visitor visitor;
	pg_walk_expression_including_root(node, discovery, visitor);
	return discovery.found;
}

enum class slice_dsm_publish_state : std::uint8_t {
	never_launched = 0u,
	attached_running = 1u,
	published_complete = 2u,
	published_incomplete = 3u,
};

struct slice_dsm_header {
	std::uint32_t magic;
	std::uint16_t codec_version;
	std::uint16_t header_bytes;
	std::uint32_t recipe_count;
	std::uint32_t slot_count;
	std::uint64_t cycle;
	std::uint64_t slot_stride;
};

struct slice_dsm_worker_header {
	std::uint64_t cycle;
	slice_dsm_publish_state publish_state;
	std::uint8_t overflowed;
	std::array<std::byte, 6> reserved;
};

static_assert(sizeof(slice_dsm_header) == 32u);
static_assert(sizeof(slice_dsm_worker_header) == 16u);
static_assert(std::is_trivially_copyable_v<slice_dsm_header>);
static_assert(std::is_trivially_copyable_v<slice_dsm_worker_header>);
static_assert(std::is_standard_layout_v<slice_dsm_header>);
static_assert(std::is_standard_layout_v<slice_dsm_worker_header>);

constexpr std::uint32_t kBioseqSliceDsmMagic = 0x42534432u; /* BSD2 */
constexpr std::uint16_t kBioseqSliceDsmVersion = 1u;

struct slice_dsm_detach_state {
	std::uint32_t refcount;
	bool callback_armed;
	std::array<std::byte, 3> reserved;
	ParallelContext* pcxt;
	slice_dsm_header* mapped_header;
	slice_trace_attachment* attachment;
	std::uint64_t expected_cycle;
};
static_assert(std::is_standard_layout_v<slice_dsm_detach_state>);

struct SliceProjectOutputBinding {
	AttrNumber resno;
	std::uint32_t producer_value_id;
};

struct SliceProjectDsmMergeAudit;

struct SliceProjectRuntime {
	std::uint64_t rows_published = 0u;
	std::uint64_t rescans = 0u;
	std::uint64_t planned_symbols = 0u;
	std::uint64_t planned_bytes = 0u;
	std::uint32_t boundary_count = 0u;
	std::uint32_t output_binding_count = 0u;
	SliceProjectOutputBinding* output_bindings = nullptr;
	slice_materialization_boundary* boundaries = nullptr;
	slice_dsm_counter* counters = nullptr;
	slice_materialization_runtime trace_runtime{};
	slice_trace_attachment* attachment = nullptr;
	slice_async_owner_guard owner_guard{};
	slice_async_job_slot* async_jobs = nullptr;
	slice_dsm_counter* async_job_counters = nullptr;
	bioseq::storage::pg_sequence_source_route_set source_routes{};
	bool owner_initialized = false;
	bool source_routes_acquired = false;
	MemoryContextCallback source_routes_callback{};
	bool source_routes_callback_registered = false;
	slice_dsm_header* mapped_header = nullptr;
	slice_dsm_worker_header* mapped_worker = nullptr;
	std::uint64_t mapped_cycle = 0u;
	slice_dsm_detach_state* detach_state = nullptr;
	bool trace_initialization_attempted = false;
	bool collect_actual = false;
	bool timing = false;
#ifdef BIOSEQ_TEST_INDEXES
	bool dsm_test_fixture_applied = false;
	bool dsm_test_fixture_validated = false;
	bool dsm_test_async_validated = false;
	int dsm_test_fixture_mode = kSliceDsmTestNone;
	std::uint32_t dsm_test_checks = 0u;
	std::uint32_t dsm_test_slot_headers_read = 0u;
	std::uint32_t dsm_test_counter_records_read = 0u;
	std::uint32_t dsm_test_cleanup_callbacks = 0u;
	SliceProjectDsmMergeAudit* dsm_test_reinitialize_audit = nullptr;
#endif
};

/* slice_async_max_live_jobs is the one normative concurrency bound. Released
 * slots advance their generation and are reused across arbitrarily many
 * batches without multiplying every trace boundary by dispatch capacity. */

struct BioseqSliceProjectState {
	CustomScanState custom_scanstate;
	SliceProjectRuntime runtime;
};
static_assert(std::is_standard_layout_v<BioseqSliceProjectState>);
static_assert(offsetof(BioseqSliceProjectState, custom_scanstate) == 0);

[[nodiscard]] static bool slice_project_rearm_worker_for_rescan_noexcept(
	BioseqSliceProjectState* state) noexcept;

[[nodiscard]] static CustomExecMethods const&
bioseq_slice_project_exec_methods() noexcept;
[[nodiscard]] static CustomScanMethods const&
bioseq_slice_project_scan_methods() noexcept;
/* A nested SliceProject must initialize its child's trace before it can bind
 * the parent projector, while child initialization calls back through the
 * parent-aware binding path. This forward declaration closes that genuine
 * initialization cycle without moving either executor phase out of order. */
static void slice_project_ensure_trace_initialized(CustomScanState* custom);
static void SliceProjectReInitializeDSM(
	CustomScanState* custom, ParallelContext* pcxt, void* coordinate);

[[nodiscard]] static List* slice_project_header(
		const SliceProjectIrBuilder& builder) {
	List* header = list_make5(
		makeInteger(kBioseqSliceProjectMagic),
		makeInteger(kBioseqSliceProjectCodecVersion),
		makeInteger(list_length(builder.records)),
		makeInteger(list_length(builder.expressions)),
		slice_project_int8_const(builder.piece_boundaries));
	header = lappend(header, slice_project_int8_const(builder.source_pieces));
	header = lappend(header, slice_project_int8_const(builder.planned_symbols));
	header = lappend(header, slice_project_int8_const(builder.planned_bytes));
	header = lappend(header, makeInteger(list_length(builder.nodes)));
	header = lappend(header, makeString(pstrdup("none")));
	return header;
}

[[nodiscard]] static List* slice_project_plan_header(CustomScan* scan) {
	if (scan == nullptr || list_length(scan->custom_private) != 4) return NIL;
	Node* header = reinterpret_cast<Node*>(linitial(scan->custom_private));
	return header != nullptr && IsA(header, List)
		? reinterpret_cast<List*>(header) : NIL;
}

[[nodiscard]] static List* slice_project_plan_nodes(CustomScan* scan) {
	if (scan == nullptr || list_length(scan->custom_private) != 4) return NIL;
	Node* nodes = reinterpret_cast<Node*>(lsecond(scan->custom_private));
	return nodes != nullptr && IsA(nodes, List)
		? reinterpret_cast<List*>(nodes) : NIL;
}

[[nodiscard]] static List* slice_project_plan_records(CustomScan* scan) {
	if (scan == nullptr || list_length(scan->custom_private) != 4) return NIL;
	Node* records = reinterpret_cast<Node*>(lthird(scan->custom_private));
	return records != nullptr && IsA(records, List)
		? reinterpret_cast<List*>(records) : NIL;
}

[[nodiscard]] static List* slice_project_plan_output_bindings(
		CustomScan* scan) {
	if (scan == nullptr || list_length(scan->custom_private) != 4) return NIL;
	Node* bindings = reinterpret_cast<Node*>(lfourth(scan->custom_private));
	return bindings != nullptr && IsA(bindings, List)
		? reinterpret_cast<List*>(bindings) : NIL;
}

static void slice_project_validate_codec(CustomScan* scan) {
	List* header = slice_project_plan_header(scan);
	List* nodes = slice_project_plan_nodes(scan);
	List* records = slice_project_plan_records(scan);
	List* output_bindings = slice_project_plan_output_bindings(scan);
	if (header == NIL || list_length(header) != kBioseqSliceProjectHeaderFields
		|| !IsA(reinterpret_cast<Node*>(list_nth(header, kSliceHeaderMagic)), Integer)
		|| !IsA(reinterpret_cast<Node*>(list_nth(header, kSliceHeaderVersion)), Integer)
		|| !IsA(reinterpret_cast<Node*>(list_nth(
			header, kSliceHeaderBoundaryCount)), Integer)
		|| !IsA(reinterpret_cast<Node*>(list_nth(
			header, kSliceHeaderExpressionCount)), Integer)
		|| !IsA(reinterpret_cast<Node*>(list_nth(
			header, kSliceHeaderProducerCount)), Integer)
		|| !IsA(reinterpret_cast<Node*>(list_nth(
			header, kSliceHeaderFallbackReason)), String)
		|| intVal(list_nth(header, kSliceHeaderMagic))
			!= kBioseqSliceProjectMagic
		|| intVal(list_nth(header, kSliceHeaderVersion))
			!= kBioseqSliceProjectCodecVersion) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject plan codec header is invalid"),
			 errdetail("header_fields=%d expected_fields=%d",
				 list_length(header), kBioseqSliceProjectHeaderFields)));
	}
	const int boundary_count = intVal(
		list_nth(header, kSliceHeaderBoundaryCount));
	const int expression_count = intVal(
		list_nth(header, kSliceHeaderExpressionCount));
	const int producer_count = intVal(
		list_nth(header, kSliceHeaderProducerCount));
	if (boundary_count < 0 || boundary_count != list_length(records)
		|| expression_count < 0
		|| expression_count != list_length(scan->custom_exprs)
		|| producer_count < 1 || producer_count != list_length(nodes)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject plan codec cardinality is invalid"),
			 errdetail("boundary_count=%d record_count=%d "
				 "expression_count=%d custom_expression_count=%d "
				 "producer_count=%d node_count=%d",
				 boundary_count, list_length(records), expression_count,
				 list_length(scan->custom_exprs), producer_count,
				 list_length(nodes))));
	}
	(void)slice_project_int8_value(reinterpret_cast<Node*>(
		list_nth(header, kSliceHeaderPieceBoundaries)));
	(void)slice_project_int8_value(reinterpret_cast<Node*>(
		list_nth(header, kSliceHeaderSourcePieces)));
	(void)slice_project_int8_value(reinterpret_cast<Node*>(
		list_nth(header, kSliceHeaderPlannedSymbols)));
	(void)slice_project_int8_value(reinterpret_cast<Node*>(
		list_nth(header, kSliceHeaderPlannedBytes)));

	int expected_stable_id = 1;
	for (Node* raw_node : PList<Node>(nodes)) {
		List* node = raw_node != nullptr && IsA(raw_node, List)
			? reinterpret_cast<List*>(raw_node) : NIL;
		if (node == NIL || list_length(node) != kBioseqSliceProjectNodeFields) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject IR node is invalid"),
				 errdetail("stable_id=%d node_fields=%d expected_fields=%d",
					 expected_stable_id, list_length(node),
					 kBioseqSliceProjectNodeFields)));
		}
		constexpr std::array<int, 9> integer_fields{
			kSliceNodeStableId, kSliceNodeOpcode,
			kSliceNodeExpressionIndex, kSliceNodeLowerExpressionIndex,
			kSliceNodeUpperExpressionIndex, kSliceNodeOptionsExpressionIndex,
			kSliceNodeTransform, kSliceNodeMechanism, kSliceNodeReason};
		for (const int field : integer_fields) {
			Node* value = reinterpret_cast<Node*>(list_nth(node, field));
			if (value == nullptr || !IsA(value, Integer)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqSliceProject IR integer field is invalid"),
					 errdetail("stable_id=%d field=%d node_tag=%d",
						 expected_stable_id, field, value == nullptr ? 0
							 : static_cast<int>(nodeTag(value)))));
			}
		}
		Node* flags_node = reinterpret_cast<Node*>(
			list_nth(node, kSliceNodeFlags));
		Node* dependencies_node = reinterpret_cast<Node*>(
			list_nth(node, kSliceNodeDependencies));
		if (flags_node == nullptr || !IsA(flags_node, Integer)
			|| (dependencies_node != nullptr
				&& !IsA(dependencies_node, List))) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject IR topology field is invalid"),
				 errdetail("stable_id=%d flags_tag=%d dependencies_tag=%d",
					 expected_stable_id,
					 flags_node == nullptr ? 0
						 : static_cast<int>(nodeTag(flags_node)),
					 dependencies_node == nullptr ? 0
						 : static_cast<int>(nodeTag(dependencies_node)))));
		}
		List* dependencies = dependencies_node == nullptr ? NIL
			: reinterpret_cast<List*>(dependencies_node);
		const int stable_id = intVal(list_nth(node, kSliceNodeStableId));
		const int opcode = intVal(list_nth(node, kSliceNodeOpcode));
		const int expression_index = intVal(
			list_nth(node, kSliceNodeExpressionIndex));
		const int lower_expression_index = intVal(
			list_nth(node, kSliceNodeLowerExpressionIndex));
		const int upper_expression_index = intVal(
			list_nth(node, kSliceNodeUpperExpressionIndex));
		const int options_expression_index = intVal(
			list_nth(node, kSliceNodeOptionsExpressionIndex));
		const int transform = intVal(list_nth(node, kSliceNodeTransform));
		const int mechanism = intVal(list_nth(node, kSliceNodeMechanism));
		const int reason = intVal(list_nth(node, kSliceNodeReason));
		const int flags = intVal(flags_node);
		auto valid_optional_expression_index = [expression_count](int index) {
			return index == -1 || (index >= 0 && index < expression_count);
		};
		if (stable_id != expected_stable_id
			|| opcode < static_cast<int>(SliceProjectOpcode::source_expr)
			|| opcode > static_cast<int>(SliceProjectOpcode::materialize)
			|| expression_index < 0 || expression_index >= expression_count
			|| !valid_optional_expression_index(lower_expression_index)
			|| !valid_optional_expression_index(upper_expression_index)
			|| !valid_optional_expression_index(options_expression_index)
			|| transform < 0 || transform > 3
			|| flags < 0
			|| (flags & ~(kSliceNodeVolatile | kSliceNodeOpaque)) != 0) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject IR node metadata is invalid"),
				 errdetail("stable_id=%d expected_id=%d opcode=%d "
					 "expression=%d lower=%d upper=%d options=%d "
					 "transform=%d flags=%d",
					 stable_id, expected_stable_id, opcode, expression_index,
					 lower_expression_index, upper_expression_index,
					 options_expression_index, transform, flags)));
		}
		Bitmapset* seen_dependencies = nullptr;
		for (Node* dependency : PList<Node>(dependencies)) {
			if (dependency == nullptr || !IsA(dependency, Integer)
				|| intVal(dependency) <= 0 || intVal(dependency) >= stable_id
				|| bms_is_member(intVal(dependency), seen_dependencies)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqSliceProject IR dependency is not topological"),
					 errdetail("stable_id=%d dependency_id=%d dependency_tag=%d",
						 stable_id,
						 dependency != nullptr && IsA(dependency, Integer)
							 ? intVal(dependency) : 0,
						 dependency == nullptr ? 0
							 : static_cast<int>(nodeTag(dependency)))));
			}
			seen_dependencies = bms_add_member(
				seen_dependencies, intVal(dependency));
		}
		if (seen_dependencies != nullptr) bms_free(seen_dependencies);
		const auto typed_opcode = static_cast<SliceProjectOpcode>(opcode);
		const int dependency_count = list_length(dependencies);
		const bool leaf = typed_opcode == SliceProjectOpcode::source_expr
			|| typed_opcode == SliceProjectOpcode::literal_expr;
		const bool unary = typed_opcode == SliceProjectOpcode::element
			|| typed_opcode == SliceProjectOpcode::slice
			|| typed_opcode == SliceProjectOpcode::reverse
			|| typed_opcode == SliceProjectOpcode::reverse_complement
			|| typed_opcode == SliceProjectOpcode::length
			|| typed_opcode == SliceProjectOpcode::cardinality
			|| typed_opcode == SliceProjectOpcode::materialize;
		const bool materialize = typed_opcode
			== SliceProjectOpcode::materialize;
		const bool bounds_valid = (typed_opcode == SliceProjectOpcode::slice
			|| typed_opcode == SliceProjectOpcode::element)
			? (typed_opcode == SliceProjectOpcode::element
				? lower_expression_index == -1 && upper_expression_index >= 0
				: true)
			: lower_expression_index == -1 && upper_expression_index == -1;
		const int expected_transform = typed_opcode == SliceProjectOpcode::reverse
			? 1 : (typed_opcode == SliceProjectOpcode::reverse_complement ? 3 : 0);
		const bool boundary_metadata_valid = materialize
			? mechanism >= static_cast<int>(materialization_mechanism::backing_copy)
				&& mechanism <= static_cast<int>(materialization_mechanism::letter_array)
				&& reason == static_cast<int>(materialization_reason::sql_conversion)
			: mechanism == -1 && reason == -1;
		if ((leaf && dependency_count != 0)
			|| (unary && dependency_count != 1)
			|| (typed_opcode == SliceProjectOpcode::concat
				&& dependency_count < 1)
			|| (typed_opcode == SliceProjectOpcode::bridge
				&& dependency_count < 1)
			|| !bounds_valid || transform != expected_transform
			|| !boundary_metadata_valid || options_expression_index != -1) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject IR opcode contract is invalid"),
				 errdetail("stable_id=%d opcode=%d dependencies=%d "
					 "lower=%d upper=%d options=%d transform=%d "
					 "mechanism=%d reason=%d",
					 stable_id, opcode, dependency_count,
					 lower_expression_index, upper_expression_index,
					 options_expression_index, transform, mechanism, reason)));
		}
		++expected_stable_id;
	}

	std::uint32_t expected_boundary_id = 1u;
	int record_index = 0;
	for (Node* raw_record : PList<Node>(records)) {
		List* record = raw_record != nullptr && IsA(raw_record, List)
			? reinterpret_cast<List*>(raw_record) : NIL;
		if (record == NIL
			|| list_length(record) != kBioseqSliceProjectRecordFields) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject plan codec record is invalid"),
				 errdetail("record_index=%d record_node_tag=%d "
					 "record_fields=%d expected_fields=%d",
					 record_index,
					 raw_record == nullptr ? 0
						 : static_cast<int>(nodeTag(raw_record)),
					 list_length(record),
					 kBioseqSliceProjectRecordFields)));
		}
		Node* boundary_id_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordBoundaryId));
		Node* producer_id_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordProducerId));
		Node* expression_index_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordExpressionIndex));
		Node* mechanism_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordMechanism));
		Node* reason_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordReason));
		if (boundary_id_node == nullptr || !IsA(boundary_id_node, Integer)
			|| producer_id_node == nullptr || !IsA(producer_id_node, Integer)
			|| expression_index_node == nullptr
			|| !IsA(expression_index_node, Integer)
			|| mechanism_node == nullptr || !IsA(mechanism_node, Integer)
			|| reason_node == nullptr || !IsA(reason_node, Integer)) {
			auto node_tag_or_zero = [](Node* node) noexcept {
				return node == nullptr ? 0 : static_cast<int>(nodeTag(node));
			};
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject plan codec topology is invalid"),
				 errdetail("record_index=%d integer_field_tags: "
					 "boundary_id=%d producer_id=%d expression_index=%d "
					 "mechanism=%d reason=%d",
					 record_index, node_tag_or_zero(boundary_id_node),
					 node_tag_or_zero(producer_id_node),
					 node_tag_or_zero(expression_index_node),
					 node_tag_or_zero(mechanism_node),
					 node_tag_or_zero(reason_node))));
		}
		const int boundary_id = intVal(boundary_id_node);
		const int producer_id = intVal(producer_id_node);
		const int expression_index = intVal(
			expression_index_node);
		const int mechanism = intVal(mechanism_node);
		const int reason = intVal(reason_node);
		Node* dependency_node = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordDependencies));
		const bool dependency_shape_valid = dependency_node == nullptr
			|| IsA(dependency_node, List);
		List* dependencies = dependency_node == nullptr ? NIL
			: (dependency_shape_valid
				? reinterpret_cast<List*>(dependency_node) : NIL);
		if (boundary_id != static_cast<int>(expected_boundary_id)
			|| producer_id <= 0 || producer_id > producer_count
			|| expression_index < 0 || expression_index >= expression_count
			|| mechanism < static_cast<int>(
				materialization_mechanism::backing_copy)
			|| mechanism > static_cast<int>(
				materialization_mechanism::letter_array)
			|| reason < static_cast<int>(materialization_reason::executor_copy)
			|| reason > static_cast<int>(materialization_reason::client_output)
			|| !dependency_shape_valid) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject plan codec topology is invalid"),
				 errdetail("record_index=%d boundary_id=%d "
					 "expected_boundary_id=%u producer_id=%d "
					 "producer_count=%d mechanism=%d reason=%d "
					 "expression_index=%d expression_count=%d "
					 "dependency_node_tag=%d",
					 record_index, boundary_id, expected_boundary_id,
					 producer_id, producer_count, mechanism, reason,
					 expression_index, expression_count,
					 dependency_node == nullptr ? 0
						 : static_cast<int>(nodeTag(dependency_node)))));
		}
		int dependency_index = 0;
		for (Node* dependency : PList<Node>(dependencies)) {
			if (dependency == nullptr || !IsA(dependency, Integer)
				|| intVal(dependency) <= 0
				|| intVal(dependency) >= boundary_id) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqSliceProject dependency is not topological"),
					 errdetail("record_index=%d dependency_index=%d "
						 "boundary_id=%d dependency_id=%d dependency_node_tag=%d",
						 record_index, dependency_index, boundary_id,
						 dependency != nullptr && IsA(dependency, Integer)
							 ? intVal(dependency) : 0,
						 dependency == nullptr ? 0
							 : static_cast<int>(nodeTag(dependency)))));
			}
			++dependency_index;
		}
		(void)slice_project_int8_value(reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordEstimatedSymbols)));
		Node* encoding = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordEncoding));
		Node* cache_scope = reinterpret_cast<Node*>(
			list_nth(record, kSliceRecordCacheScope));
		if (encoding == nullptr || !IsA(encoding, String)
			|| cache_scope == nullptr || !IsA(cache_scope, String)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject boundary metadata is invalid"),
				 errdetail("record_index=%d encoding_node_tag=%d "
					 "cache_scope_node_tag=%d",
					 record_index,
					 encoding == nullptr ? 0
						 : static_cast<int>(nodeTag(encoding)),
					 cache_scope == nullptr ? 0
						 : static_cast<int>(nodeTag(cache_scope)))));
		}
		++expected_boundary_id;
		++record_index;
	}
	Bitmapset* seen_resnos = nullptr;
	int binding_index = 0;
	for (Node* raw_binding : PList<Node>(output_bindings)) {
		List* binding = raw_binding != nullptr && IsA(raw_binding, List)
			? reinterpret_cast<List*>(raw_binding) : NIL;
		if (list_length(binding) != 2
			|| !IsA(reinterpret_cast<Node*>(linitial(binding)), Integer)
			|| !IsA(reinterpret_cast<Node*>(lsecond(binding)), Integer)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject output binding is invalid"),
				 errdetail("binding_index=%d", binding_index)));
		}
		const int resno = intVal(linitial(binding));
		const int producer_id = intVal(lsecond(binding));
		if (resno <= 0 || resno > list_length(scan->scan.plan.targetlist)
			|| producer_id <= 0 || producer_id > producer_count
			|| bms_is_member(resno, seen_resnos)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject output binding is out of range"),
				 errdetail("binding_index=%d resno=%d producer_id=%d",
					 binding_index, resno, producer_id)));
		}
		seen_resnos = bms_add_member(seen_resnos, resno);
		++binding_index;
	}
	if (seen_resnos != nullptr) bms_free(seen_resnos);
}

[[nodiscard]] static Plan* BioseqSliceProject_PlanCustomPath(
		PlannerInfo*, RelOptInfo* rel, CustomPath* best_path,
		List* tlist, List* clauses, List* custom_plans) {
	if (rel == nullptr || best_path == nullptr
		|| list_length(custom_plans) != 1
		|| list_length(best_path->custom_private) != 5) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject path shape is invalid")));
	}
	List* header = reinterpret_cast<List*>(
		list_nth(best_path->custom_private, 0));
	List* expressions = reinterpret_cast<List*>(
		list_nth(best_path->custom_private, 1));
	List* nodes = reinterpret_cast<List*>(
		list_nth(best_path->custom_private, 2));
	List* records = reinterpret_cast<List*>(
		list_nth(best_path->custom_private, 3));
	List* output_bindings = reinterpret_cast<List*>(
		list_nth(best_path->custom_private, 4));
	if (header == nullptr || !IsA(header, List)
		|| (expressions != NIL && !IsA(expressions, List))
		|| (nodes != NIL && !IsA(nodes, List))
		|| (records != NIL && !IsA(records, List))
		|| (output_bindings != NIL && !IsA(output_bindings, List))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject path codec is invalid")));
	}
	auto* scan = makeNode(CustomScan);
	scan->methods = &bioseq_slice_project_scan_methods();
	scan->scan.scanrelid = 0;
	scan->scan.plan.targetlist = tlist;
	/* SliceProject is a projection owner, never a restriction owner.  This is
	 * essential when the lowest valid placement is directly above a base
	 * BioseqScan: create_plan has already given the child the base clauses, and
	 * copying them onto this scanrelid-zero wrapper would both execute them
	 * twice and ask setrefs to resolve base Vars against the projected output. */
	(void)clauses;
	scan->scan.plan.qual = NIL;
	scan->custom_plans = custom_plans;
	auto* child_plan = reinterpret_cast<Plan*>(linitial(custom_plans));
	scan->custom_scan_tlist = static_cast<List*>(
		copyObject(child_plan->targetlist));
	scan->custom_exprs = static_cast<List*>(copyObject(expressions));
	scan->custom_private = list_make4(
		copyObject(header), copyObject(nodes), copyObject(records),
		copyObject(output_bindings));
	scan->custom_relids = bms_copy(rel->relids);
	scan->flags = best_path->flags;
	return reinterpret_cast<Plan*>(scan);
}

[[nodiscard]] static List*
BioseqSliceProject_ReparameterizeCustomPathByChild(
		PlannerInfo*, List* custom_private, RelOptInfo*) {
	return static_cast<List*>(copyObject(custom_private));
}

[[nodiscard]] static Node* BioseqSliceProject_CreateCustomScanState(
		CustomScan*) {
	auto* state = static_cast<BioseqSliceProjectState*>(
		palloc0(sizeof(BioseqSliceProjectState)));
	NodeSetTag(&state->custom_scanstate, T_CustomScanState);
	state->custom_scanstate.methods = &bioseq_slice_project_exec_methods();
	return reinterpret_cast<Node*>(state);
}

[[nodiscard]] static CustomScanMethods const&
bioseq_slice_project_scan_methods() noexcept {
	static const CustomScanMethods methods{
		.CustomName = "BioseqSliceProject",
		.CreateCustomScanState = BioseqSliceProject_CreateCustomScanState,
	};
	return methods;
}

[[nodiscard]] static CustomPathMethods const&
bioseq_slice_project_path_methods() noexcept {
	static const CustomPathMethods methods{
		.CustomName = "BioseqSliceProject",
		.PlanCustomPath = BioseqSliceProject_PlanCustomPath,
		.ReparameterizeCustomPathByChild =
			BioseqSliceProject_ReparameterizeCustomPathByChild,
	};
	return methods;
}

struct SliceProjectDsmLayout {
	Size header_bytes;
	Size slot_stride;
	Size total_bytes;
};

struct SliceProjectDsmMergeAudit {
	std::uint32_t slot_headers_read = 0u;
	std::uint32_t counter_records_read = 0u;
	std::uint32_t merged_slots = 0u;
	std::uint32_t incomplete_slots = 0u;
	bool header_valid = false;
	bool mapping_valid = false;
	bool merged = false;
};

[[nodiscard]] static SliceProjectDsmLayout slice_project_dsm_layout(
		std::uint32_t recipe_count, std::uint32_t slot_count) {
	const Size header_bytes = MAXALIGN(sizeof(slice_dsm_header));
	const Size counter_bytes = mul_size(
		static_cast<Size>(recipe_count), sizeof(slice_dsm_counter));
	const Size slot_stride = MAXALIGN(add_size(
		sizeof(slice_dsm_worker_header), counter_bytes));
	return {
		.header_bytes = header_bytes,
		.slot_stride = slot_stride,
		.total_bytes = add_size(header_bytes,
			mul_size(static_cast<Size>(slot_count), slot_stride)),
	};
}

[[nodiscard]] static bool slice_project_checked_add_noexcept(
		Size left, Size right, Size* result) noexcept {
	if (result == nullptr || left > MaxAllocSize
		|| right > MaxAllocSize - left) return false;
	*result = left + right;
	return true;
}

[[nodiscard]] static bool slice_project_checked_mul_noexcept(
		Size left, Size right, Size* result) noexcept {
	if (result == nullptr || (left != 0u && right > MaxAllocSize / left)) {
		return false;
	}
	*result = left * right;
	return true;
}

[[nodiscard]] static bool slice_project_dsm_layout_noexcept(
		std::uint32_t recipe_count, std::uint32_t slot_count,
		SliceProjectDsmLayout* result) noexcept {
	if (result == nullptr) return false;
	Size counter_bytes = 0u;
	Size raw_stride = 0u;
	Size slots_bytes = 0u;
	const Size header_bytes = MAXALIGN(sizeof(slice_dsm_header));
	if (!slice_project_checked_mul_noexcept(
			static_cast<Size>(recipe_count), sizeof(slice_dsm_counter),
			&counter_bytes)
		|| !slice_project_checked_add_noexcept(
			sizeof(slice_dsm_worker_header), counter_bytes, &raw_stride)) {
		return false;
	}
	const Size slot_stride = MAXALIGN(raw_stride);
	if (slot_stride < raw_stride
		|| !slice_project_checked_mul_noexcept(
			static_cast<Size>(slot_count), slot_stride, &slots_bytes)
		|| !slice_project_checked_add_noexcept(
			header_bytes, slots_bytes, &result->total_bytes)) return false;
	result->header_bytes = header_bytes;
	result->slot_stride = slot_stride;
	return true;
}

[[nodiscard]] static slice_dsm_worker_header* slice_project_worker_slot(
		slice_dsm_header* header, std::uint32_t slot_index) noexcept {
	return reinterpret_cast<slice_dsm_worker_header*>(
		reinterpret_cast<char*>(header) + header->header_bytes
		+ static_cast<Size>(slot_index) * header->slot_stride);
}

[[nodiscard]] static slice_dsm_counter* slice_project_worker_counters(
		slice_dsm_worker_header* worker) noexcept {
	return reinterpret_cast<slice_dsm_counter*>(
		reinterpret_cast<char*>(worker) + sizeof(slice_dsm_worker_header));
}

static void slice_project_mark_trace_invalid_noexcept(
		slice_trace_attachment* attachment) noexcept {
	if (!slice_trace_attachment_live(attachment)) return;
	attachment->runtime->invalid = true;
	attachment->runtime->overflowed = true;
}

[[nodiscard]] static bool slice_project_validate_dsm_header_noexcept(
		slice_dsm_header const* header, std::uint32_t recipe_count,
		std::uint32_t slot_count, std::uint64_t cycle,
		SliceProjectDsmLayout* layout) noexcept {
	if (header == nullptr
		|| !slice_project_dsm_layout_noexcept(
			recipe_count, slot_count, layout)) return false;
	return header->magic == kBioseqSliceDsmMagic
		&& header->codec_version == kBioseqSliceDsmVersion
		&& header->header_bytes == layout->header_bytes
		&& header->recipe_count == recipe_count
		&& header->slot_count == slot_count
		&& header->cycle == cycle
		&& header->slot_stride == layout->slot_stride;
}

static void slice_project_merge_dsm_cycle_noexcept(
		slice_dsm_header* header, std::uintptr_t map_base, Size map_length,
		std::uint32_t slot_count, slice_trace_attachment* attachment,
		std::uint64_t expected_cycle,
		SliceProjectDsmMergeAudit* audit = nullptr) noexcept {
	if (audit != nullptr) *audit = {};
	if (!slice_trace_attachment_live(attachment) || header == nullptr) return;
	auto& trace = *attachment->runtime;
	if (trace.last_merged_cycle >= expected_cycle) return;
	const auto coordinate = reinterpret_cast<std::uintptr_t>(header);
	if (coordinate < map_base || coordinate - map_base > map_length
		|| sizeof(slice_dsm_header)
			> map_length - (coordinate - map_base)) {
		slice_project_mark_trace_invalid_noexcept(attachment);
		return;
	}
	SliceProjectDsmLayout layout{};
	if (!slice_project_validate_dsm_header_noexcept(
			header, trace.boundary_count, slot_count,
			expected_cycle, &layout)) {
		slice_project_mark_trace_invalid_noexcept(attachment);
		return;
	}
	if (audit != nullptr) audit->header_valid = true;
	if (layout.total_bytes > map_length - (coordinate - map_base)) {
		slice_project_mark_trace_invalid_noexcept(attachment);
		return;
	}
	if (audit != nullptr) audit->mapping_valid = true;
	/* First pass validates every published-complete slot before a single
	 * counter is merged.  Running and incomplete slots own tentative deltas:
	 * never dereference those payloads, because a valid-looking prefix is not a
	 * completed materialization. */
	for (std::uint32_t slot_index = 0u;
		 slot_index < slot_count; ++slot_index) {
		auto* worker = slice_project_worker_slot(header, slot_index);
		if (audit != nullptr) ++audit->slot_headers_read;
		const auto state = worker->publish_state;
		if (state > slice_dsm_publish_state::published_incomplete) {
			slice_project_mark_trace_invalid_noexcept(attachment);
			return;
		}
		if (state == slice_dsm_publish_state::never_launched) {
			if (worker->cycle != 0u) {
				slice_project_mark_trace_invalid_noexcept(attachment);
				return;
			}
			continue;
		}
		pg_read_barrier();
		if (worker->cycle != expected_cycle || worker->overflowed > 1u
			|| std::any_of(worker->reserved.begin(), worker->reserved.end(),
				[](std::byte byte) { return byte != std::byte{0}; })) {
			slice_project_mark_trace_invalid_noexcept(attachment);
			return;
		}
		/* Running slots still belong to one exact generation.  Their tentative
		 * counter payload remains unread, but accepting a stale slot header would
		 * count an earlier cycle as incomplete work in this one. */
		if (state == slice_dsm_publish_state::attached_running) continue;
		if (state == slice_dsm_publish_state::published_incomplete) continue;
		auto* counters = slice_project_worker_counters(worker);
		for (std::uint32_t counter_index = 0u;
			 counter_index < trace.boundary_count; ++counter_index) {
			if (audit != nullptr) ++audit->counter_records_read;
			if (counters[counter_index].overflowed > 1u
				|| !slice_dsm_counter_reserved_valid(
					counters[counter_index])) {
				slice_project_mark_trace_invalid_noexcept(attachment);
				return;
			}
		}
	}
	std::uint32_t incomplete = 0u;
	for (std::uint32_t slot_index = 0u;
		 slot_index < slot_count; ++slot_index) {
		auto* worker = slice_project_worker_slot(header, slot_index);
		const auto state = worker->publish_state;
		if (state == slice_dsm_publish_state::attached_running
			|| state == slice_dsm_publish_state::published_incomplete) {
			if (incomplete == UINT32_MAX) {
				trace.overflowed = true;
			} else {
				++incomplete;
			}
		}
		if (state != slice_dsm_publish_state::published_complete) continue;
		if (audit != nullptr) ++audit->merged_slots;
		auto* counters = slice_project_worker_counters(worker);
		for (std::uint32_t counter_index = 0u;
			 counter_index < trace.boundary_count; ++counter_index) {
			merge_slice_dsm_counter_noexcept(
				trace.cumulative_sink.entries[counter_index],
				counters[counter_index]);
			trace.overflowed = trace.overflowed
				|| counters[counter_index].overflowed != 0u
				|| trace.cumulative_sink.entries[counter_index].overflowed != 0u;
		}
		trace.overflowed = trace.overflowed || worker->overflowed != 0u;
	}
	if (incomplete > UINT32_MAX - trace.incomplete_workers) {
		trace.incomplete_workers = UINT32_MAX;
		trace.overflowed = true;
	} else {
		trace.incomplete_workers += incomplete;
	}
	trace.last_merged_cycle = expected_cycle;
	if (audit != nullptr) {
		audit->incomplete_slots = incomplete;
		audit->merged = true;
	}
}

static void slice_project_merge_dsm_cycle_noexcept(
		slice_dsm_header* header, ParallelContext* pcxt,
		slice_trace_attachment* attachment,
		std::uint64_t expected_cycle,
		SliceProjectDsmMergeAudit* audit = nullptr) noexcept {
	if (!slice_trace_attachment_live(attachment)
		|| header == nullptr || pcxt == nullptr || pcxt->seg == nullptr
		|| pcxt->nworkers < 0) return;
	slice_project_merge_dsm_cycle_noexcept(
		header,
		reinterpret_cast<std::uintptr_t>(dsm_segment_address(pcxt->seg)),
		dsm_segment_map_length(pcxt->seg),
		static_cast<std::uint32_t>(pcxt->nworkers), attachment,
		expected_cycle, audit);
}

#ifdef BIOSEQ_TEST_INDEXES
enum class SliceProjectDsmCorruption : std::uint8_t {
	version = 0u,
	recipe_count,
	header_offset,
	truncated_mapping,
	lifecycle,
	stale_cycle,
};

struct SliceProjectDsmTestCaseResult {
	bool validated = false;
	SliceProjectDsmMergeAudit audit{};
};

static void slice_project_initialize_test_dsm(
		slice_dsm_header* header, SliceProjectDsmLayout const& layout,
		std::uint32_t recipe_count, std::uint32_t slot_count,
		std::uint64_t cycle) noexcept {
	header->magic = kBioseqSliceDsmMagic;
	header->codec_version = kBioseqSliceDsmVersion;
	header->header_bytes = static_cast<std::uint16_t>(layout.header_bytes);
	header->recipe_count = recipe_count;
	header->slot_count = slot_count;
	header->cycle = cycle;
	header->slot_stride = layout.slot_stride;
}

[[nodiscard]] static bool slice_project_test_dsm_payload_is_reset(
		slice_dsm_header* header, SliceProjectDsmLayout const& layout,
		std::uint32_t recipe_count, std::uint32_t slot_count,
		std::uint64_t cycle) noexcept {
	if (header == nullptr || header->magic != kBioseqSliceDsmMagic
		|| header->codec_version != kBioseqSliceDsmVersion
		|| header->header_bytes != layout.header_bytes
		|| header->recipe_count != recipe_count
		|| header->slot_count != slot_count || header->cycle != cycle
		|| header->slot_stride != layout.slot_stride) return false;
	for (std::uint32_t slot_index = 0u; slot_index < slot_count; ++slot_index) {
		auto* worker = slice_project_worker_slot(header, slot_index);
		if (worker->cycle != 0u
			|| worker->publish_state != slice_dsm_publish_state::never_launched
			|| worker->overflowed != 0u
			|| std::any_of(worker->reserved.begin(), worker->reserved.end(),
				[](std::byte byte) { return byte != std::byte{0}; })) return false;
		auto* counters = slice_project_worker_counters(worker);
		for (std::uint32_t index = 0u; index < recipe_count; ++index) {
			if (counters[index].calls != 0u || counters[index].bytes != 0u
				|| counters[index].overflowed != 0u
				|| !slice_dsm_counter_reserved_valid(counters[index])) return false;
		}
	}
	return true;
}

[[nodiscard]] static SliceProjectDsmTestCaseResult
slice_project_run_corrupt_dsm_test(
		SliceProjectRuntime const& source,
		SliceProjectDsmCorruption corruption) {
	SliceProjectDsmTestCaseResult result{};
	if (source.boundary_count == 0u || source.boundaries == nullptr) return result;
	constexpr std::uint32_t slot_count = 2u;
	constexpr std::uint64_t cycle = 17u;
	const SliceProjectDsmLayout layout = slice_project_dsm_layout(
		source.boundary_count, slot_count);
	auto* bytes = static_cast<std::byte*>(palloc0(layout.total_bytes));
	auto* counters = static_cast<slice_dsm_counter*>(palloc0(
		mul_size(source.boundary_count, sizeof(slice_dsm_counter))));
	slice_materialization_runtime trace{
		.boundaries = source.boundaries,
		.boundary_count = source.boundary_count,
		.cumulative_sink = {counters, source.boundary_count},
		.last_merged_cycle = 0u,
		.incomplete_workers = 0u,
		.collection_enabled = true,
		.timing_enabled = false,
		.invalid = false,
		.overflowed = false,
	};
	slice_trace_attachment attachment{
		.refcount = 1u,
		.generation = 1u,
		.runtime = &trace,
		.async_owner = nullptr,
		.async_owner_generation = 0u,
		.valid = true,
	};
	auto* header = reinterpret_cast<slice_dsm_header*>(bytes);
	slice_project_initialize_test_dsm(
		header, layout, source.boundary_count, slot_count, cycle);
	auto* worker = slice_project_worker_slot(header, 0u);
	worker->cycle = cycle;
	worker->publish_state = slice_dsm_publish_state::published_complete;
	auto* worker_counters = slice_project_worker_counters(worker);
	worker_counters[0].calls = 99u;
	Size mapped_length = layout.total_bytes;
	switch (corruption) {
		case SliceProjectDsmCorruption::version:
			++header->codec_version;
			break;
		case SliceProjectDsmCorruption::recipe_count:
			++header->recipe_count;
			break;
		case SliceProjectDsmCorruption::header_offset:
			header->header_bytes = static_cast<std::uint16_t>(
				header->header_bytes + MAXIMUM_ALIGNOF);
			break;
		case SliceProjectDsmCorruption::truncated_mapping:
			--mapped_length;
			break;
		case SliceProjectDsmCorruption::lifecycle:
			worker->publish_state = static_cast<slice_dsm_publish_state>(255u);
			break;
		case SliceProjectDsmCorruption::stale_cycle:
			worker->cycle = cycle - 1u;
			break;
	}
	slice_project_merge_dsm_cycle_noexcept(
		header, reinterpret_cast<std::uintptr_t>(bytes), mapped_length,
		slot_count, &attachment, cycle, &result.audit);
	const bool zero_payload_reads = result.audit.counter_records_read == 0u;
	const bool no_guessed_workers = trace.incomplete_workers == 0u;
	const bool no_prefix_merge = trace.last_merged_cycle == 0u
		&& counters[0].calls == 0u;
	const bool rejected_before_slot =
		corruption == SliceProjectDsmCorruption::version
		|| corruption == SliceProjectDsmCorruption::recipe_count
		|| corruption == SliceProjectDsmCorruption::header_offset
		|| corruption == SliceProjectDsmCorruption::truncated_mapping;
	result.validated = trace.invalid && trace.overflowed
		&& zero_payload_reads && no_guessed_workers && no_prefix_merge
		&& (!rejected_before_slot || result.audit.slot_headers_read == 0u);
	pfree(counters);
	pfree(bytes);
	return result;
}

struct SliceProjectAsyncTestCallbacks {
	std::uint32_t cancelled = 0u;
	std::uint32_t joined = 0u;
	std::uint32_t backings_released = 0u;
	std::uint32_t complete_published = 0u;
	std::uint32_t incomplete_published = 0u;
};

static void slice_project_test_cancel(void* argument) noexcept {
	++static_cast<SliceProjectAsyncTestCallbacks*>(argument)->cancelled;
}

static void slice_project_test_join(void* argument) noexcept {
	++static_cast<SliceProjectAsyncTestCallbacks*>(argument)->joined;
}

static void slice_project_test_release_backing(void* argument) noexcept {
	++static_cast<SliceProjectAsyncTestCallbacks*>(argument)->backings_released;
}

static void slice_project_test_publish_complete(void* argument) noexcept {
	++static_cast<SliceProjectAsyncTestCallbacks*>(argument)->complete_published;
}

static void slice_project_test_publish_incomplete(void* argument) noexcept {
	++static_cast<SliceProjectAsyncTestCallbacks*>(argument)->incomplete_published;
}

[[nodiscard]] static bool slice_project_run_incomplete_async_test(
		SliceProjectRuntime const& source,
		std::uint32_t* cleanup_callbacks) {
	if (cleanup_callbacks != nullptr) *cleanup_callbacks = 0u;
	if (source.boundary_count == 0u || source.boundaries == nullptr) return false;
	slice_materialization_boundary boundary = source.boundaries[0];
	boundary.counter_index = 0u;
	slice_dsm_counter cumulative{};
	slice_materialization_runtime trace{};
	if (!initialize_slice_materialization_runtime_noexcept(
			&trace, &boundary, 1u, &cumulative, 1u, true, false)) return false;
	auto* attachment = make_slice_trace_attachment(&trace);
	slice_async_owner_guard guard{};
	slice_async_job_slot jobs[slice_async_max_live_jobs]{};
	slice_dsm_counter job_counters[slice_async_max_live_jobs]{};
	if (!initialize_slice_async_owner_noexcept(
			&guard, &trace, attachment, jobs, slice_async_max_live_jobs,
			job_counters, 1u)) {
		invalidate_slice_trace_attachment_noexcept(attachment);
		release_slice_trace_attachment(attachment);
		return false;
	}
	SliceProjectAsyncTestCallbacks callbacks{};
	const slice_async_job_resources resources{
		.cancel = {&callbacks, &slice_project_test_cancel},
		.join = {&callbacks, &slice_project_test_join},
		.backings = {&callbacks, &slice_project_test_release_backing},
	};
	guard.publish_complete = {
		&callbacks, &slice_project_test_publish_complete};
	guard.publish_incomplete = {
		&callbacks, &slice_project_test_publish_incomplete};
	slice_async_completion_handle handle{};
	const bool enrolled = enroll_slice_async_job_noexcept(
		&guard, resources, &handle);
	const bool scheduled = enrolled
		&& mark_slice_async_job_scheduled_noexcept(&guard, handle);
	if (scheduled) {
		update_slice_dsm_counter_noexcept(
			guard.jobs[handle.slot_index].counters[0],
			1u, 1u, 8u, false, 8u, 0u);
	}
	/* Exact executor teardown order: Shutdown drains an unpublished scheduled
	 * job, End makes the owner terminal, and a later context reset is a no-op. */
	quiesce_slice_async_owner_noexcept(
		&guard, slice_shutdown_disposition::complete);
	const bool stale_rejected = !mark_slice_async_job_finished_noexcept(
		&guard, handle);
	const bool lifecycle_valid = enrolled && scheduled && stale_rejected
		&& guard.phase == slice_async_owner_phase::quiesced
		&& guard.enrolled_jobs == 0u
		&& jobs[handle.slot_index].state == slice_async_job_state::unused
		&& jobs[handle.slot_index].generation == handle.generation + 1u
		&& cumulative.calls == 0u && cumulative.bytes == 0u
		&& callbacks.cancelled == 1u && callbacks.joined == 1u
		&& callbacks.backings_released == 1u
		&& callbacks.complete_published == 0u
		&& callbacks.incomplete_published == 1u
		&& attachment->refcount == 1u;
	if (cleanup_callbacks != nullptr) {
		*cleanup_callbacks = callbacks.cancelled + callbacks.joined
			+ callbacks.backings_released;
	}
	finish_slice_async_owner_noexcept(
		&guard, slice_shutdown_disposition::complete);
	const bool end_valid = lifecycle_valid
		&& guard.phase == slice_async_owner_phase::terminal
		&& trace.boundaries == nullptr && trace.cumulative_sink.entries == nullptr
		&& callbacks.complete_published == 0u
		&& callbacks.incomplete_published == 1u;
	slice_async_owner_reset(&guard);
	return end_valid && guard.phase == slice_async_owner_phase::terminal
		&& callbacks.complete_published == 0u
		&& callbacks.incomplete_published == 1u;
}

[[nodiscard]] static bool slice_project_reinitialize_rejects_test_cycle(
		BioseqSliceProjectState* state, ParallelContext* pcxt,
		slice_dsm_header* header) {
	MemoryContext saved_context = CurrentMemoryContext;
	bool volatile rejected = false;
	PG_TRY();
	{
		SliceProjectReInitializeDSM(
			&state->custom_scanstate, pcxt, header);
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		ErrorData* error = CopyErrorData();
		rejected = error != nullptr
			&& error->sqlerrcode == ERRCODE_DATA_CORRUPTED;
		FlushErrorState();
		if (error != nullptr) FreeErrorData(error);
	}
	PG_END_TRY();
	MemoryContextSwitchTo(saved_context);
	return rejected;
}

static void slice_project_apply_dsm_test_fixture(
		BioseqSliceProjectState* state) {
	if (state == nullptr) return;
	auto& runtime = state->runtime;
	if (runtime.dsm_test_fixture_applied) return;
	const int fixture_mode = runtime.dsm_test_fixture_mode;
	if (fixture_mode == kSliceDsmTestNone) return;
	runtime.dsm_test_fixture_applied = true;
	if (runtime.boundary_count == 0u || runtime.boundaries == nullptr) {
		runtime.dsm_test_fixture_validated = false;
		return;
	}
	runtime.dsm_test_async_validated = slice_project_run_incomplete_async_test(
		runtime, &runtime.dsm_test_cleanup_callbacks);
	if (fixture_mode == kSliceDsmTestMalformed) {
		constexpr std::array corruptions{
			SliceProjectDsmCorruption::version,
			SliceProjectDsmCorruption::recipe_count,
			SliceProjectDsmCorruption::header_offset,
			SliceProjectDsmCorruption::truncated_mapping,
			SliceProjectDsmCorruption::lifecycle,
			SliceProjectDsmCorruption::stale_cycle,
		};
		bool valid = true;
		for (const auto corruption : corruptions) {
			const auto result = slice_project_run_corrupt_dsm_test(
				runtime, corruption);
			valid = valid && result.validated;
			++runtime.dsm_test_checks;
			runtime.dsm_test_slot_headers_read +=
				result.audit.slot_headers_read;
			runtime.dsm_test_counter_records_read +=
				result.audit.counter_records_read;
		}
		runtime.dsm_test_fixture_validated = valid
			&& runtime.dsm_test_async_validated;
		runtime.trace_runtime.invalid = true;
		runtime.trace_runtime.overflowed = true;
		return;
	}

	/* Exercise the real leader ReInitializeDSM callback twice over a real DSM
	 * mapping.  The first cycle contains complete, attached-running,
	 * published-incomplete, and never-launched slots.  Only the complete delta
	 * may merge; both incomplete lifecycle states count exactly once. */
	constexpr std::uint32_t slot_count = 4u;
	constexpr std::uint64_t first_cycle = 23u;
	constexpr std::uint64_t second_cycle = first_cycle + 1u;
	constexpr std::uint64_t reset_cycle = second_cycle + 1u;
	const SliceProjectDsmLayout layout = slice_project_dsm_layout(
		runtime.boundary_count, slot_count);
	auto* local_counters = static_cast<slice_dsm_counter*>(palloc0(
		mul_size(runtime.boundary_count, sizeof(slice_dsm_counter))));
	dsm_segment* segment = dsm_create(
		layout.total_bytes, DSM_CREATE_NULL_IF_MAXSEGMENTS);
	if (segment == nullptr) {
		runtime.dsm_test_fixture_validated = false;
		pfree(local_counters);
		return;
	}
	auto* bytes = static_cast<std::byte*>(dsm_segment_address(segment));
	std::memset(bytes, 0, layout.total_bytes);
	slice_materialization_runtime trace{
		.boundaries = runtime.boundaries,
		.boundary_count = runtime.boundary_count,
		.cumulative_sink = {local_counters, runtime.boundary_count},
		.last_merged_cycle = 0u,
		.incomplete_workers = 0u,
		.collection_enabled = true,
		.timing_enabled = false,
		.invalid = false,
		.overflowed = false,
	};
	slice_trace_attachment attachment{
		.refcount = 1u, .generation = 1u, .runtime = &trace,
		.async_owner = nullptr, .async_owner_generation = 0u, .valid = true};
	BioseqSliceProjectState reinitialize_state{};
	auto& reinitialize_runtime = reinitialize_state.runtime;
	reinitialize_runtime.boundary_count = runtime.boundary_count;
	reinitialize_runtime.trace_initialization_attempted = true;
	reinitialize_runtime.collect_actual = true;
	reinitialize_runtime.attachment = &attachment;
	ParallelContext parallel_context{};
	parallel_context.seg = segment;
	parallel_context.nworkers = static_cast<int>(slot_count);
	auto* header = reinterpret_cast<slice_dsm_header*>(bytes);
	const auto reset_reinitialize_case = [
			bytes, layout, header, local_counters, &runtime, &trace,
			&attachment, &reinitialize_runtime](std::uint64_t cycle) {
		std::memset(bytes, 0, layout.total_bytes);
		slice_project_initialize_test_dsm(
			header, layout, runtime.boundary_count, slot_count, cycle);
		for (std::uint32_t index = 0u;
			 index < runtime.boundary_count; ++index) {
			reset_slice_dsm_counter_noexcept(local_counters[index]);
		}
		trace.last_merged_cycle = 0u;
		trace.incomplete_workers = 0u;
		trace.collection_enabled = true;
		trace.invalid = false;
		trace.overflowed = false;
		attachment.runtime = &trace;
		attachment.valid = true;
		reinitialize_runtime.mapped_header = header;
		reinitialize_runtime.mapped_cycle = cycle;
		reinitialize_runtime.dsm_test_reinitialize_audit = nullptr;
	};

	/* The shared header may not nominate its own generation.  Exercise both
	 * directions of header drift and a running slot from an earlier cycle
	 * through the production callback before the two successful rescans. */
	reset_reinitialize_case(first_cycle);
	header->cycle = first_cycle - 1u;
	const bool stale_header_rejected =
		slice_project_reinitialize_rejects_test_cycle(
			&reinitialize_state, &parallel_context, header);
	reset_reinitialize_case(first_cycle);
	header->cycle = first_cycle + 1u;
	const bool forward_header_rejected =
		slice_project_reinitialize_rejects_test_cycle(
			&reinitialize_state, &parallel_context, header);
	reset_reinitialize_case(first_cycle);
	auto* wrong_generation_worker = slice_project_worker_slot(header, 0u);
	wrong_generation_worker->cycle = first_cycle - 1u;
	wrong_generation_worker->publish_state =
		slice_dsm_publish_state::attached_running;
	SliceProjectDsmMergeAudit wrong_generation_audit{};
	reinitialize_runtime.dsm_test_reinitialize_audit =
		&wrong_generation_audit;
	const bool attached_generation_rejected =
		slice_project_reinitialize_rejects_test_cycle(
			&reinitialize_state, &parallel_context, header);
	const bool rejection_valid = stale_header_rejected
		&& forward_header_rejected && attached_generation_rejected
		&& wrong_generation_audit.header_valid
		&& wrong_generation_audit.mapping_valid
		&& !wrong_generation_audit.merged
		&& wrong_generation_audit.slot_headers_read == 1u
		&& wrong_generation_audit.counter_records_read == 0u
		&& local_counters[0].calls == 0u;

	reset_reinitialize_case(first_cycle);
	auto* first_complete = slice_project_worker_slot(header, 0u);
	first_complete->cycle = first_cycle;
	first_complete->publish_state =
		slice_dsm_publish_state::published_complete;
	auto* first_complete_counters =
		slice_project_worker_counters(first_complete);
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		first_complete_counters[index].calls = 3u;
		first_complete_counters[index].bytes = 30u;
	}
	auto* old_cycle_attached = slice_project_worker_slot(header, 1u);
	old_cycle_attached->cycle = first_cycle;
	old_cycle_attached->publish_state =
		slice_dsm_publish_state::attached_running;
	auto* old_cycle_tentative =
		slice_project_worker_counters(old_cycle_attached);
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		/* Poison a valid-looking tentative prefix.  Attached payloads must never
		 * be inspected or merged, even when their bytes are malformed. */
		old_cycle_tentative[index].calls = 99u;
		old_cycle_tentative[index].bytes = 990u;
		old_cycle_tentative[index].overflowed = 2u;
		old_cycle_tentative[index].reserved[0] = std::byte{1};
	}
	auto* first_incomplete = slice_project_worker_slot(header, 2u);
	first_incomplete->cycle = first_cycle;
	first_incomplete->publish_state =
		slice_dsm_publish_state::published_incomplete;
	first_incomplete->overflowed = 1u;
	auto* first_incomplete_counters =
		slice_project_worker_counters(first_incomplete);
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		/* Published-incomplete payloads are tentative too.  Poisoning their
		 * records distinguishes that branch from published-complete validation. */
		first_incomplete_counters[index].calls = 101u;
		first_incomplete_counters[index].bytes = 1010u;
		first_incomplete_counters[index].overflowed = 2u;
		first_incomplete_counters[index].reserved[0] = std::byte{1};
	}

	SliceProjectDsmMergeAudit first_audit{};
	reinitialize_runtime.dsm_test_reinitialize_audit = &first_audit;
	SliceProjectReInitializeDSM(
		&reinitialize_state.custom_scanstate, &parallel_context, header);
	bool valid = rejection_valid
		&& first_audit.header_valid && first_audit.mapping_valid
		&& first_audit.merged && first_audit.slot_headers_read == slot_count
		&& first_audit.counter_records_read == runtime.boundary_count
		&& first_audit.merged_slots == 1u
		&& first_audit.incomplete_slots == 2u
		&& trace.last_merged_cycle == first_cycle
		&& trace.incomplete_workers == 2u && !trace.invalid
		&& !trace.overflowed;
	for (std::uint32_t index = 0u; index < runtime.boundary_count; ++index) {
		valid = valid && local_counters[index].calls == 3u
			&& local_counters[index].bytes == 30u;
	}

	valid = valid && reinitialize_runtime.mapped_header == header
		&& reinitialize_runtime.mapped_cycle == second_cycle
		&& slice_project_test_dsm_payload_is_reset(
			header, layout, runtime.boundary_count, slot_count, second_cycle);

	constexpr std::array<std::uint64_t, 2u> second_calls{5u, 7u};
	constexpr std::array<std::uint64_t, 2u> second_bytes{50u, 70u};
	for (std::uint32_t slot_index = 0u; slot_index < 2u; ++slot_index) {
		auto* worker = slice_project_worker_slot(header, slot_index);
		worker->cycle = second_cycle;
		worker->publish_state =
			slice_dsm_publish_state::published_complete;
		auto* counters = slice_project_worker_counters(worker);
		for (std::uint32_t index = 0u;
			 index < runtime.boundary_count; ++index) {
			counters[index].calls = second_calls[slot_index];
			counters[index].bytes = second_bytes[slot_index];
		}
	}
	SliceProjectDsmMergeAudit second_audit{};
	reinitialize_runtime.dsm_test_reinitialize_audit = &second_audit;
	SliceProjectReInitializeDSM(
		&reinitialize_state.custom_scanstate, &parallel_context, header);
	valid = valid && second_audit.header_valid && second_audit.mapping_valid
		&& second_audit.merged && second_audit.slot_headers_read == slot_count
		&& second_audit.counter_records_read
			== runtime.boundary_count * 2u
		&& second_audit.merged_slots == 2u
		&& second_audit.incomplete_slots == 0u
		&& trace.last_merged_cycle == second_cycle
		&& trace.incomplete_workers == 2u && !trace.invalid
		&& !trace.overflowed;
	valid = valid && reinitialize_runtime.mapped_header == header
		&& reinitialize_runtime.mapped_cycle == reset_cycle
		&& slice_project_test_dsm_payload_is_reset(
			header, layout, runtime.boundary_count, slot_count, reset_cycle);

	/* Worker ExecReScan is a separate production transition from leader DSM
	 * reinitialization.  Complete cumulative records survive rearm, whereas an
	 * incomplete tentative record is cleared before its stable slot is reused. */
	auto* complete_rearm = slice_project_worker_slot(header, 0u);
	complete_rearm->cycle = reset_cycle;
	complete_rearm->publish_state = slice_dsm_publish_state::published_complete;
	auto* complete_rearm_counters =
		slice_project_worker_counters(complete_rearm);
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		complete_rearm_counters[index].calls = 3u;
		complete_rearm_counters[index].bytes = 30u;
	}
	reinitialize_runtime.mapped_worker = complete_rearm;
	const bool complete_rearmed =
		slice_project_rearm_worker_for_rescan_noexcept(&reinitialize_state);
	valid = valid && complete_rearmed
		&& complete_rearm->publish_state
			== slice_dsm_publish_state::attached_running;
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		valid = valid && complete_rearm_counters[index].calls == 3u
			&& complete_rearm_counters[index].bytes == 30u;
	}

	auto* incomplete_rearm = slice_project_worker_slot(header, 1u);
	incomplete_rearm->cycle = reset_cycle;
	incomplete_rearm->publish_state =
		slice_dsm_publish_state::published_incomplete;
	incomplete_rearm->overflowed = 1u;
	auto* incomplete_rearm_counters =
		slice_project_worker_counters(incomplete_rearm);
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		incomplete_rearm_counters[index].calls = 4u;
		incomplete_rearm_counters[index].bytes = 40u;
	}
	reinitialize_runtime.mapped_worker = incomplete_rearm;
	const bool incomplete_rearmed =
		slice_project_rearm_worker_for_rescan_noexcept(&reinitialize_state);
	valid = valid && incomplete_rearmed
		&& incomplete_rearm->publish_state
			== slice_dsm_publish_state::attached_running
		&& incomplete_rearm->overflowed == 0u;
	for (std::uint32_t index = 0u;
		 index < runtime.boundary_count; ++index) {
		valid = valid && incomplete_rearm_counters[index].calls == 0u
			&& incomplete_rearm_counters[index].bytes == 0u
			&& incomplete_rearm_counters[index].overflowed == 0u;
	}
	for (std::uint32_t index = 0u; index < runtime.boundary_count; ++index) {
		valid = valid && local_counters[index].calls == 15u
			&& local_counters[index].bytes == 150u;
		if (runtime.counters != nullptr) {
			merge_slice_dsm_counter_noexcept(
				runtime.counters[index], local_counters[index]);
		}
	}
	if (first_audit.incomplete_slots
		> UINT32_MAX - runtime.trace_runtime.incomplete_workers) {
		runtime.trace_runtime.incomplete_workers = UINT32_MAX;
		runtime.trace_runtime.overflowed = true;
	} else {
		runtime.trace_runtime.incomplete_workers +=
			first_audit.incomplete_slots;
	}
	runtime.dsm_test_checks = 5u;
	runtime.dsm_test_slot_headers_read =
		wrong_generation_audit.slot_headers_read
		+ first_audit.slot_headers_read + second_audit.slot_headers_read;
	runtime.dsm_test_counter_records_read =
		wrong_generation_audit.counter_records_read
		+ first_audit.counter_records_read
		+ second_audit.counter_records_read;
	runtime.dsm_test_fixture_validated = valid
		&& runtime.dsm_test_async_validated;
	dsm_detach(segment);
	pfree(local_counters);
}
#endif

static void slice_project_release_detach_state(
		slice_dsm_detach_state* state) noexcept {
	if (state != nullptr && state->refcount != 0u
		&& state->refcount != UINT32_MAX && --state->refcount == 0u) pfree(state);
}

static void slice_project_owner_reset(void* argument) noexcept {
	auto* state = static_cast<BioseqSliceProjectState*>(argument);
	if (state == nullptr) return;
	auto& runtime = state->runtime;
	if (runtime.owner_initialized) {
		finish_slice_async_owner_noexcept(
			&runtime.owner_guard, slice_shutdown_disposition::incomplete);
		runtime.attachment = nullptr;
	}
	/* End may be skipped by ERROR.  Drop exactly the query-owner token here;
	 * the independently retained DSM callback token remains until detach. */
	if (runtime.detach_state != nullptr) {
		slice_project_release_detach_state(runtime.detach_state);
		runtime.detach_state = nullptr;
	}
	runtime.mapped_header = nullptr;
	runtime.mapped_worker = nullptr;
}

/* Registered before child initialization.  PostgreSQL invokes reset callbacks
 * in reverse registration order, so child scan/provider callbacks run after
 * the async-owner callback but before this upper-lease callback. */
static void slice_project_source_routes_reset(void* argument) noexcept {
	auto* state = static_cast<BioseqSliceProjectState*>(argument);
	if (state == nullptr) return;
	auto& runtime = state->runtime;
	/* Attachment can ERROR after retaining an early route but before publishing
	 * source_routes_acquired.  The container count is the unwind authority; an
	 * empty or already-released set is intentionally a no-op. */
	bioseq::storage::release_pg_sequence_source_routes_noexcept(
		runtime.source_routes);
	runtime.source_routes_acquired = false;
}

static void slice_project_dsm_on_detach(
		dsm_segment*, Datum argument) noexcept {
	auto* state = reinterpret_cast<slice_dsm_detach_state*>(
		DatumGetPointer(argument));
	if (state == nullptr || !state->callback_armed) return;
	state->callback_armed = false;
	slice_project_merge_dsm_cycle_noexcept(
		state->mapped_header, state->pcxt, state->attachment,
		state->expected_cycle);
	auto* attachment = state->attachment;
	state->attachment = nullptr;
	state->pcxt = nullptr;
	state->mapped_header = nullptr;
	release_slice_trace_attachment(attachment);
	slice_project_release_detach_state(state);
}

static void slice_project_publish_worker_noexcept(
		BioseqSliceProjectState* state,
		slice_dsm_publish_state final_state) noexcept {
	if (state == nullptr) return;
	auto& runtime = state->runtime;
	auto* worker = runtime.mapped_worker;
	if (worker == nullptr || runtime.mapped_cycle == 0u) return;
	if (worker->publish_state != slice_dsm_publish_state::attached_running
		|| worker->cycle != runtime.mapped_cycle) {
		slice_project_mark_trace_invalid_noexcept(runtime.attachment);
		return;
	}
	auto* destination = slice_project_worker_counters(worker);
	bool overflowed = runtime.trace_runtime.invalid
		|| runtime.trace_runtime.overflowed || worker->overflowed != 0u;
	for (std::uint32_t index = 0u; index < runtime.boundary_count; ++index) {
		if (!slice_dsm_counter_reserved_valid(destination[index])
			|| !slice_dsm_counter_reserved_valid(runtime.counters[index])) {
			overflowed = true;
		} else {
			/* The shared slot is cumulative for one parallel cycle, whereas the
			 * backend-local sink is a delta since the preceding publish/rescan. */
			merge_slice_dsm_counter_noexcept(
				destination[index], runtime.counters[index]);
		}
		overflowed = overflowed || destination[index].overflowed != 0u
			|| !slice_dsm_counter_reserved_valid(destination[index]);
	}
	worker->overflowed = overflowed ? 1u : 0u;
	pg_write_barrier();
	worker->publish_state = overflowed
		? slice_dsm_publish_state::published_incomplete : final_state;
	/* A worker publishes one cycle delta.  Only after the shared slot is fully
	 * visible may its backend-local sink be cleared for a subsequent rescan;
	 * otherwise ReInitializeDSM would merge cumulative prefixes twice. */
	for (std::uint32_t index = 0u; index < runtime.boundary_count; ++index) {
		reset_slice_dsm_counter_noexcept(runtime.counters[index]);
	}
}

[[nodiscard]] static bool slice_project_rearm_worker_for_rescan_noexcept(
		BioseqSliceProjectState* state) noexcept {
	if (state == nullptr) return false;
	auto& runtime = state->runtime;
	auto* worker = runtime.mapped_worker;
	if (worker == nullptr) return true;
	if (runtime.mapped_cycle == 0u || worker->cycle != runtime.mapped_cycle
		|| (worker->publish_state
			!= slice_dsm_publish_state::published_complete
			&& worker->publish_state
				!= slice_dsm_publish_state::published_incomplete)) {
		slice_project_mark_trace_invalid_noexcept(runtime.attachment);
		return false;
	}
	/* Completed slots are cumulative across rescans.  An incomplete slot is a
	 * tentative delta and must be discarded before a later rescan can publish
	 * the same stable worker slot as complete. */
	if (worker->publish_state
		== slice_dsm_publish_state::published_incomplete) {
		auto* counters = slice_project_worker_counters(worker);
		for (std::uint32_t index = 0u; index < runtime.boundary_count; ++index) {
			reset_slice_dsm_counter_noexcept(counters[index]);
		}
		worker->overflowed = 0u;
	}
	pg_write_barrier();
	worker->publish_state = slice_dsm_publish_state::attached_running;
	return true;
}

static void slice_project_publish_complete_noexcept(void* argument) noexcept {
	slice_project_publish_worker_noexcept(
		static_cast<BioseqSliceProjectState*>(argument),
		slice_dsm_publish_state::published_complete);
}

static void slice_project_publish_incomplete_noexcept(void* argument) noexcept {
	slice_project_publish_worker_noexcept(
		static_cast<BioseqSliceProjectState*>(argument),
		slice_dsm_publish_state::published_incomplete);
}

static void slice_project_attach_sources_from_plan_state(
		PlanState* child, BioseqSliceProjectState* state,
		std::uint32_t& tagged_sources) {
	if (child == nullptr || state == nullptr) return;
	if (IsA(child, CustomScanState)) {
		auto* child_custom = reinterpret_cast<CustomScanState*>(child);
		if (child_custom->methods == &bioseq_slice_project_exec_methods()) {
			/* Nested projectors form an async-owner boundary.  Initialize the
			 * lower projector first, then retain its exact source routes instead
			 * of descending through it and rebinding the same leaf buffers to a
			 * second owner.  The lower projector owns work below the boundary;
			 * this projector owns only provenance it publishes above it. */
			slice_project_ensure_trace_initialized(child_custom);
			auto* child_state = reinterpret_cast<BioseqSliceProjectState*>(
				child_custom);
			if (!child_state->runtime.source_routes_acquired
					|| child_state->runtime.source_routes.count == 0u
					|| !bioseq::storage::merge_pg_sequence_source_routes(
						state->runtime.source_routes,
						child_state->runtime.source_routes)) {
				ereport(ERROR,
					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
					 errmsg("BioseqSliceProject nested source route is unavailable")));
			}
			state->runtime.source_routes_acquired = true;
			++tagged_sources;
			return;
		}
		if (child_custom->methods == &BioseqColumnScanExecuteMethods) {
			auto* bioseq_state =
				BioseqScanState::from_custom_scan_state(child_custom);
			BioseqScanRuntime& child_runtime = bioseq_runtime(bioseq_state);
			if (!child_runtime.lazy_source_projection) return;
			++tagged_sources;
			/* The upper set retains child lifetimes only.  Locator stubs are
			 * promoted inside each BioseqScan through that leaf's exact provider
			 * before its tuple reaches this projection, so self-join aliases never
			 * require an ambiguous physical-relation lookup here. */
			if (child_runtime.lazy_source_provider == nullptr
				|| !bioseq::storage::add_pg_sequence_source_route(
					state->runtime.source_routes,
					child_runtime.lazy_source_provider)) {
				ereport(ERROR,
					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
					 errmsg("BioseqSliceProject source route is unavailable")));
			}
			state->runtime.source_routes_acquired = true;
			if (child_runtime.lazy_trace_attachment != nullptr) {
				release_slice_trace_attachment(
					child_runtime.lazy_trace_attachment);
				child_runtime.lazy_trace_attachment = nullptr;
			}
			if (slice_trace_attachment_live(state->runtime.attachment)) {
				child_runtime.lazy_trace_attachment = state->runtime.attachment;
				retain_slice_trace_attachment(
					child_runtime.lazy_trace_attachment);
				child_runtime.buffer.bind_slice_async_owner(
					&state->runtime.owner_guard);
			}
			return;
		}
		for (PlanState* custom_child : PList<PlanState>(
				child_custom->custom_ps)) {
			slice_project_attach_sources_from_plan_state(
				custom_child, state, tagged_sources);
		}
		return;
	}
	if (IsA(child, AppendState)) {
		auto* append = reinterpret_cast<AppendState*>(child);
		for (int index = 0; index < append->as_nplans; ++index) {
			slice_project_attach_sources_from_plan_state(
				append->appendplans[index], state, tagged_sources);
		}
		return;
	}
	if (IsA(child, MergeAppendState)) {
		auto* append = reinterpret_cast<MergeAppendState*>(child);
		for (int index = 0; index < append->ms_nplans; ++index) {
			slice_project_attach_sources_from_plan_state(
				append->mergeplans[index], state, tagged_sources);
		}
		return;
	}
	PlanState* outer = outerPlanState(child);
	PlanState* inner = innerPlanState(child);
	if (outer != nullptr) {
		slice_project_attach_sources_from_plan_state(
			outer, state, tagged_sources);
	}
	if (inner != nullptr && inner != outer) {
		slice_project_attach_sources_from_plan_state(
			inner, state, tagged_sources);
	}
}

static void slice_project_attach_trace_to_child(
		CustomScanState* custom, BioseqSliceProjectState* state) {
	if (custom == nullptr || custom->custom_ps == NIL || state == nullptr) return;
	std::uint32_t tagged_sources = 0u;
	for (PlanState* child : PList<PlanState>(custom->custom_ps)) {
		slice_project_attach_sources_from_plan_state(
			child, state, tagged_sources);
	}
	if (tagged_sources == 0u) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject child did not accept source ownership")));
	}
}

static void slice_project_initialize_trace(
		BioseqSliceProjectState* state, CustomScan* scan, EState* estate) {
	auto& runtime = state->runtime;
	List* records = slice_project_plan_records(scan);
	List* output_bindings = slice_project_plan_output_bindings(scan);
	runtime.boundary_count = static_cast<std::uint32_t>(list_length(records));
	runtime.output_binding_count = static_cast<std::uint32_t>(
		list_length(output_bindings));
	runtime.collect_actual = runtime.boundary_count != 0u
		&& state->custom_scanstate.ss.ps.instrument != nullptr;
	runtime.timing = runtime.collect_actual
		&& state->custom_scanstate.ss.ps.instrument->need_timer;
	if (runtime.boundary_count != 0u) {
		runtime.boundaries = static_cast<slice_materialization_boundary*>(
			MemoryContextAllocZero(estate->es_query_cxt,
				mul_size(runtime.boundary_count,
					sizeof(slice_materialization_boundary))));
		runtime.counters = static_cast<slice_dsm_counter*>(
			MemoryContextAllocZero(estate->es_query_cxt,
				mul_size(runtime.boundary_count, sizeof(slice_dsm_counter))));
	}
	std::uint32_t index = 0u;
	for (Node* raw_record : PList<Node>(records)) {
		List* record = reinterpret_cast<List*>(raw_record);
		runtime.boundaries[index] = {
			.boundary_id = static_cast<std::uint32_t>(intVal(
				list_nth(record, kSliceRecordBoundaryId))),
			.producer_value_id = static_cast<std::uint32_t>(intVal(
				list_nth(record, kSliceRecordProducerId))),
			.counter_index = index,
			.mechanism = static_cast<materialization_mechanism>(intVal(
				list_nth(record, kSliceRecordMechanism))),
			.reason = static_cast<materialization_reason>(intVal(
				list_nth(record, kSliceRecordReason))),
			.reserved = {},
		};
		++index;
	}
	if (!initialize_slice_materialization_runtime_noexcept(
			&runtime.trace_runtime, runtime.boundaries,
			runtime.boundary_count, runtime.counters,
			runtime.boundary_count, runtime.collect_actual, runtime.timing)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject trace runtime is invalid")));
	}
	runtime.attachment = make_slice_trace_attachment(&runtime.trace_runtime);
	runtime.async_jobs = static_cast<slice_async_job_slot*>(
		MemoryContextAllocZero(estate->es_query_cxt,
			mul_size(slice_async_max_live_jobs,
				sizeof(slice_async_job_slot))));
	if (runtime.boundary_count != 0u) {
		const Size async_counter_count = mul_size(
			static_cast<Size>(slice_async_max_live_jobs),
			static_cast<Size>(runtime.boundary_count));
		runtime.async_job_counters = static_cast<slice_dsm_counter*>(
			MemoryContextAllocZero(estate->es_query_cxt,
				mul_size(async_counter_count,
					sizeof(slice_dsm_counter))));
	}
	if (!initialize_slice_async_owner_noexcept(
			&runtime.owner_guard, &runtime.trace_runtime,
			runtime.attachment, runtime.async_jobs,
			slice_async_max_live_jobs, runtime.async_job_counters,
			runtime.boundary_count)) {
		invalidate_slice_trace_attachment_noexcept(runtime.attachment);
		release_slice_trace_attachment(runtime.attachment);
		runtime.attachment = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqSliceProject owner initialization failed")));
	}
	runtime.owner_guard.publish_complete = {
		.argument = state, .invoke = slice_project_publish_complete_noexcept};
	runtime.owner_guard.publish_incomplete = {
		.argument = state, .invoke = slice_project_publish_incomplete_noexcept};
	runtime.owner_initialized = true;
	runtime.owner_guard.callback.func = slice_project_owner_reset;
	runtime.owner_guard.callback.arg = state;
	MemoryContextRegisterResetCallback(
		estate->es_query_cxt, &runtime.owner_guard.callback);
	if (runtime.output_binding_count != 0u) {
		runtime.output_bindings = static_cast<SliceProjectOutputBinding*>(
			MemoryContextAllocZero(estate->es_query_cxt,
				mul_size(runtime.output_binding_count,
					sizeof(SliceProjectOutputBinding))));
		index = 0u;
		for (Node* raw_binding : PList<Node>(output_bindings)) {
			List* binding = reinterpret_cast<List*>(raw_binding);
			runtime.output_bindings[index++] = {
				.resno = static_cast<AttrNumber>(intVal(linitial(binding))),
				.producer_value_id = static_cast<std::uint32_t>(
					intVal(lsecond(binding))),
			};
		}
	}
}

static void slice_project_ensure_trace_initialized(CustomScanState* custom) {
	if (custom == nullptr) return;
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	auto& runtime = state->runtime;
	if (runtime.trace_initialization_attempted) return;
	runtime.trace_initialization_attempted = true;
	EState* estate = custom->ss.ps.state;
	auto* scan = reinterpret_cast<CustomScan*>(custom->ss.ps.plan);
	if (estate == nullptr || scan == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject trace initialization state is invalid")));
	}
	slice_project_initialize_trace(state, scan, estate);
	slice_project_attach_trace_to_child(custom, state);
}

static Size SliceProjectEstimateDSM(
		CustomScanState* custom, ParallelContext* pcxt) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	slice_project_ensure_trace_initialized(custom);
	if (!state->runtime.collect_actual) return 0u;
	if (pcxt == nullptr || pcxt->nworkers < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject parallel context is invalid")));
	}
	return slice_project_dsm_layout(
		state->runtime.boundary_count,
		static_cast<std::uint32_t>(pcxt->nworkers)).total_bytes;
}

static void SliceProjectInitializeDSM(
		CustomScanState* custom, ParallelContext* pcxt, void* coordinate) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	slice_project_ensure_trace_initialized(custom);
	auto& runtime = state->runtime;
	if (!runtime.collect_actual) return;
	if (coordinate == nullptr || pcxt == nullptr || pcxt->seg == nullptr
		|| pcxt->nworkers < 0 || runtime.detach_state != nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject DSM initialization is invalid")));
	}
	const auto slot_count = static_cast<std::uint32_t>(pcxt->nworkers);
	const SliceProjectDsmLayout layout = slice_project_dsm_layout(
		runtime.boundary_count, slot_count);
	std::memset(coordinate, 0, layout.total_bytes);
	auto* header = static_cast<slice_dsm_header*>(coordinate);
	header->magic = kBioseqSliceDsmMagic;
	header->codec_version = kBioseqSliceDsmVersion;
	header->header_bytes = static_cast<std::uint16_t>(layout.header_bytes);
	header->recipe_count = runtime.boundary_count;
	header->slot_count = slot_count;
	header->cycle = 1u;
	header->slot_stride = layout.slot_stride;
	runtime.mapped_header = header;
	runtime.mapped_cycle = 1u;
	auto* detach = static_cast<slice_dsm_detach_state*>(
		MemoryContextAllocZero(TopMemoryContext,
			sizeof(slice_dsm_detach_state)));
	/* The query-owner token exists before registration so an ERROR from
	 * on_dsm_detach is reclaimed by the already-installed query callback.
	 * Acquire the independent callback token/attachment retain only after
	 * registration succeeds; otherwise neither can become a phantom leak. */
	detach->refcount = 1u;
	detach->callback_armed = false;
	detach->pcxt = pcxt;
	detach->mapped_header = header;
	detach->attachment = runtime.attachment;
	detach->expected_cycle = 1u;
	runtime.detach_state = detach;
	on_dsm_detach(pcxt->seg, slice_project_dsm_on_detach,
		PointerGetDatum(detach));
	retain_slice_trace_attachment(detach->attachment);
	detach->refcount = 2u;
	detach->callback_armed = true;
}

static void SliceProjectReInitializeDSM(
		CustomScanState* custom, ParallelContext* pcxt, void* coordinate) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	slice_project_ensure_trace_initialized(custom);
	auto& runtime = state->runtime;
	if (!runtime.collect_actual) return;
	if (coordinate == nullptr || pcxt == nullptr || pcxt->seg == nullptr
		|| pcxt->nworkers < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject DSM reinitialization is invalid")));
	}
	auto* header = static_cast<slice_dsm_header*>(coordinate);
	const std::uint64_t expected_cycle = runtime.mapped_cycle;
	if (runtime.mapped_header != header || expected_cycle == 0u
		|| header->cycle != expected_cycle
		|| (runtime.detach_state != nullptr
			&& (runtime.detach_state->mapped_header != header
				|| runtime.detach_state->expected_cycle != expected_cycle))) {
		slice_project_mark_trace_invalid_noexcept(runtime.attachment);
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject DSM cycle identity changed"),
			 errdetail("expected_cycle=%llu shared_cycle=%llu",
				static_cast<unsigned long long>(expected_cycle),
				static_cast<unsigned long long>(header->cycle))));
	}
	SliceProjectDsmMergeAudit* merge_audit = nullptr;
#ifdef BIOSEQ_TEST_INDEXES
	merge_audit = runtime.dsm_test_reinitialize_audit;
	runtime.dsm_test_reinitialize_audit = nullptr;
#endif
	auto* trace_runtime = runtime.attachment == nullptr
		? nullptr : runtime.attachment->runtime;
	slice_project_merge_dsm_cycle_noexcept(
		header, pcxt, runtime.attachment, expected_cycle, merge_audit);
	if (trace_runtime == nullptr || trace_runtime->invalid
		|| trace_runtime->last_merged_cycle != expected_cycle) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject DSM cycle merge was rejected"),
			 errdetail("expected_cycle=%llu merged_cycle=%llu",
				static_cast<unsigned long long>(expected_cycle),
				static_cast<unsigned long long>(trace_runtime == nullptr
					? 0u : trace_runtime->last_merged_cycle))));
	}
	if (expected_cycle == UINT64_MAX) {
		ereport(ERROR,
			(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
			 errmsg("BioseqSliceProject parallel cycle exhausted")));
	}
	const auto slot_count = static_cast<std::uint32_t>(pcxt->nworkers);
	const SliceProjectDsmLayout layout = slice_project_dsm_layout(
		runtime.boundary_count, slot_count);
	std::memset(reinterpret_cast<char*>(header) + layout.header_bytes, 0,
		layout.total_bytes - layout.header_bytes);
	header->magic = kBioseqSliceDsmMagic;
	header->codec_version = kBioseqSliceDsmVersion;
	header->header_bytes = static_cast<std::uint16_t>(layout.header_bytes);
	header->recipe_count = runtime.boundary_count;
	header->slot_count = slot_count;
	header->slot_stride = layout.slot_stride;
	pg_write_barrier();
	header->cycle = expected_cycle + 1u;
	runtime.mapped_header = header;
	runtime.mapped_cycle = header->cycle;
	if (runtime.detach_state != nullptr) {
		runtime.detach_state->mapped_header = header;
		pg_write_barrier();
		runtime.detach_state->expected_cycle = header->cycle;
	}
	if (runtime.owner_initialized
		&& runtime.owner_guard.phase == slice_async_owner_phase::quiesced) {
		(void)rearm_slice_async_owner_for_rescan_noexcept(
			&runtime.owner_guard);
	}
}

static void SliceProjectInitializeWorker(
		CustomScanState* custom, shm_toc*, void* coordinate) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	slice_project_ensure_trace_initialized(custom);
	auto& runtime = state->runtime;
	if (!runtime.collect_actual) return;
	if (coordinate == nullptr || ParallelWorkerNumber < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject worker coordinate is invalid")));
	}
	auto* header = static_cast<slice_dsm_header*>(coordinate);
	if (header->slot_count > static_cast<std::uint32_t>(INT_MAX)
		|| ParallelWorkerNumber >= static_cast<int>(header->slot_count)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject worker slot is out of range")));
	}
	SliceProjectDsmLayout layout{};
	if (!slice_project_validate_dsm_header_noexcept(
			header, runtime.boundary_count, header->slot_count,
			header->cycle, &layout)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject worker DSM header is invalid")));
	}
	auto* worker = slice_project_worker_slot(
		header, static_cast<std::uint32_t>(ParallelWorkerNumber));
	if (worker->publish_state != slice_dsm_publish_state::never_launched
		|| worker->cycle != 0u
		|| std::any_of(worker->reserved.begin(), worker->reserved.end(),
			[](std::byte byte) { return byte != std::byte{0}; })) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject worker DSM slot is invalid")));
	}
	runtime.mapped_header = header;
	runtime.mapped_worker = worker;
	runtime.mapped_cycle = header->cycle;
	worker->cycle = header->cycle;
	pg_write_barrier();
	worker->publish_state = slice_dsm_publish_state::attached_running;
}

[[nodiscard]] static TupleTableSlot* slice_project_publish_child(
		CustomScanState* custom, bool count_row) {
	if (custom->custom_ps == NIL || list_length(custom->custom_ps) != 1) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject executor child is missing")));
	}
	auto* child = reinterpret_cast<PlanState*>(linitial(custom->custom_ps));
	TupleTableSlot* child_slot = ExecProcNode(child);
	TupleTableSlot* scan_slot = custom->ss.ss_ScanTupleSlot;
	if (TupIsNull(child_slot)) return ExecClearTuple(scan_slot);
#ifdef BIOSEQ_TEST_INDEXES
	const auto publication_before =
		capture_slice_payload_allocation_test_snapshot_noexcept();
#endif
	slot_getallattrs(child_slot);
	const int natts = child_slot->tts_tupleDescriptor->natts;
	if (natts != scan_slot->tts_tupleDescriptor->natts) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("BioseqSliceProject child descriptor changed")));
	}
	ExecClearTuple(scan_slot);
	std::memcpy(scan_slot->tts_values, child_slot->tts_values,
		static_cast<std::size_t>(natts) * sizeof(Datum));
	std::memcpy(scan_slot->tts_isnull, child_slot->tts_isnull,
		static_cast<std::size_t>(natts) * sizeof(bool));
	scan_slot->tts_nvalid = natts;
	TupleDesc descriptor = scan_slot->tts_tupleDescriptor;
	for (int index = 0; index < natts; ++index) {
		if (!scan_slot->tts_isnull[index]) {
			scan_slot->tts_values[index] = MakeExpandedObjectReadOnly(
				scan_slot->tts_values[index], false,
				TupleDescAttr(descriptor, index)->attlen);
		}
	}
	ExecStoreVirtualTuple(scan_slot);
#ifdef BIOSEQ_TEST_INDEXES
	record_slice_project_publication_allocation_delta_noexcept(
		publication_before,
		capture_slice_payload_allocation_test_snapshot_noexcept());
#endif
	if (count_row) {
		auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
		state->runtime.rows_published = bioseq::parallelism::saturating_add(
			state->runtime.rows_published, 1u);
	}
	return scan_slot;
}

[[nodiscard]] static TupleTableSlot* SliceProjectAccess(ScanState* scan) {
	return slice_project_publish_child(
		reinterpret_cast<CustomScanState*>(scan), true);
}

[[nodiscard]] static bool SliceProjectRecheck(
		ScanState* scan, TupleTableSlot*) {
	CustomScanState* custom = reinterpret_cast<CustomScanState*>(scan);
	if (custom->ss.ps.state == nullptr
		|| custom->ss.ps.state->es_epq_active == nullptr) return true;
	return !TupIsNull(slice_project_publish_child(custom, false));
}

static void SliceProjectBegin(
		CustomScanState* custom, EState* estate, int eflags) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
#ifdef BIOSEQ_TEST_INDEXES
	/* Claim the backend-local one-shot before any plan validation or child
	 * initialization can ERROR.  The claimed mode stays on this executor node
	 * for post-execution EXPLAIN diagnostics; an aborted statement destroys it
	 * instead of leaking the injection to a later query. */
	state->runtime.dsm_test_fixture_mode = std::exchange(
		PendingSliceDsmTestFixture, kSliceDsmTestNone);
#endif
	auto* scan = reinterpret_cast<CustomScan*>(custom->ss.ps.plan);
	scan->methods = &bioseq_slice_project_scan_methods();
	slice_project_validate_codec(scan);
	if (list_length(scan->custom_plans) != 1) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject requires exactly one child plan")));
	}
	List* header = slice_project_plan_header(scan);
	state->runtime.planned_symbols = slice_project_int8_value(
		reinterpret_cast<Node*>(list_nth(header, kSliceHeaderPlannedSymbols)));
	state->runtime.planned_bytes = slice_project_int8_value(
		reinterpret_cast<Node*>(list_nth(header, kSliceHeaderPlannedBytes)));
	/* Register the upper-lease reset callback before ExecInitNode registers
	 * any child/provider callbacks.  Their reverse-order teardown then closes
	 * providers before this callback drops the independently retained routes. */
	state->runtime.source_routes_callback.func =
		slice_project_source_routes_reset;
	state->runtime.source_routes_callback.arg = state;
	bioseq::storage::initialize_pg_sequence_source_routes(
		state->runtime.source_routes, estate->es_query_cxt);
	MemoryContextRegisterResetCallback(
		estate->es_query_cxt,
		&state->runtime.source_routes_callback);
	state->runtime.source_routes_callback_registered = true;
	Plan* child_plan = reinterpret_cast<Plan*>(linitial(scan->custom_plans));
	custom->custom_ps = list_make1(ExecInitNode(child_plan, estate, eflags));
}

[[nodiscard]] static TupleTableSlot* SliceProjectExec(
		CustomScanState* custom) {
	slice_project_ensure_trace_initialized(custom);
	TupleTableSlot* result = ExecScan(
		&custom->ss, SliceProjectAccess, SliceProjectRecheck);
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	auto& runtime = state->runtime;
	if (TupIsNull(result) || !slice_trace_attachment_live(runtime.attachment)
		|| runtime.output_binding_count == 0u) return result;
	slot_getallattrs(result);
	const Oid seq_oid = get_cached_stub_oids().bioseq_seq_type_oid;
	for (std::uint32_t index = 0u;
		 index < runtime.output_binding_count; ++index) {
		auto const& binding = runtime.output_bindings[index];
		if (binding.resno <= 0
			|| binding.resno > result->tts_tupleDescriptor->natts
			|| TupleDescAttr(result->tts_tupleDescriptor,
				binding.resno - 1)->atttypid != seq_oid) {
			ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject result binding changed")));
		}
		if (result->tts_isnull[binding.resno - 1]) continue;
		/* CASE/COALESCE may select a flat or literal arm even though another
		 * arm caused this symbolic recipe to be planned.  Only an expanded
		 * result can carry provenance; a skipped lazy arm is not an error and
		 * must retain zero actual boundary calls. */
		if (!VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(
				result->tts_values[binding.resno - 1]))) continue;
		if (!attach_slice_trace_provenance(
				result->tts_values[binding.resno - 1], runtime.attachment,
				binding.producer_value_id)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject result lost expanded provenance")));
		}
	}
	return result;
}

static void SliceProjectEnd(CustomScanState* custom) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	/* No source-backed task may outlive the owning upper executor. */
	if (state->runtime.owner_initialized) {
		finish_slice_async_owner_noexcept(
			&state->runtime.owner_guard,
			slice_shutdown_disposition::complete);
		state->runtime.attachment = nullptr;
	}
	/* Core frees this node's ExprContext only after EndCustomScan returns.
	 * Drain the last projected EOH while both the child provider and our upper
	 * route are still live; otherwise provider_end and upper_lease_end can both
	 * sweep before that EOH drops its source-domain reference, leaving only the
	 * registry token after a cursor CLOSE with no later statement boundary. */
	if (custom->ss.ps.ps_ResultTupleSlot != nullptr) {
		ExecClearTuple(custom->ss.ps.ps_ResultTupleSlot);
	}
	if (custom->ss.ps.ps_ExprContext != nullptr) {
		ReScanExprContext(custom->ss.ps.ps_ExprContext);
	}
	if (custom->custom_ps != NIL) {
		ExecEndNode(reinterpret_cast<PlanState*>(linitial(custom->custom_ps)));
		custom->custom_ps = NIL;
	}
	ExecClearTuple(custom->ss.ss_ScanTupleSlot);
	/* Child End closes every provider first.  The independent upper leases
	 * keep registries alive until this final release/sweep. */
	if (state->runtime.source_routes_acquired) {
		bioseq::storage::release_pg_sequence_source_routes(
			state->runtime.source_routes, /*is_commit=*/true);
		state->runtime.source_routes_acquired = false;
	}
	if (state->runtime.detach_state != nullptr) {
		slice_project_release_detach_state(state->runtime.detach_state);
		state->runtime.detach_state = nullptr;
	}
	state->runtime.mapped_header = nullptr;
	state->runtime.mapped_worker = nullptr;
}

static void SliceProjectReScan(CustomScanState* custom) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	slice_project_ensure_trace_initialized(custom);
	if (state->runtime.owner_initialized) {
		quiesce_slice_async_owner_noexcept(
			&state->runtime.owner_guard,
			slice_shutdown_disposition::complete);
	}
	/* Reset the ScanState projection/result machinery before the parameterized
	 * child is rescanned.  Clearing only ss_ScanTupleSlot leaves ExecScan's
	 * prior projected datum live, so a NULL source on the next PARAM_EXEC pass
	 * can inherit the preceding non-NULL slice. */
	ExecScanReScan(&custom->ss);
	/* ExecScanReScan resets scan input and expression state but does not
	 * guarantee that a previously projected virtual result is invalidated.
	 * Nested-loop PARAM_EXEC rescans must not return that old expanded slice
	 * when the next child row projects NULL. */
	if (custom->ss.ps.ps_ResultTupleSlot != nullptr) {
		ExecClearTuple(custom->ss.ps.ps_ResultTupleSlot);
	}
	if (custom->custom_ps != NIL) {
		auto* child = reinterpret_cast<PlanState*>(
			linitial(custom->custom_ps));
		/* CustomScan children live in custom_ps rather than lefttree/righttree,
		 * so core ExecReScan cannot propagate the parent's changed PARAM_EXEC
		 * set for us.  Preserve that invalidation before rescanning the
		 * parameterized join/Append subtree. */
		if (custom->ss.ps.chgParam != nullptr) {
			UpdateChangedParamSet(child, custom->ss.ps.chgParam);
		}
		ExecReScan(child);
	}
	if (state->runtime.source_routes_acquired) {
		for (std::size_t index = 0u;
			 index < state->runtime.source_routes.count; ++index) {
			bioseq::storage::sweep_reclaimable_pg_sequence_source_domains(
				bioseq::storage::pg_sequence_source_route_lease(
					state->runtime.source_routes, index),
				bioseq::storage::pg_sequence_source_sweep_boundary::rescan,
				/*is_commit=*/true);
		}
	}
	state->runtime.rescans = bioseq::parallelism::saturating_add(
		state->runtime.rescans, 1u);
	const bool worker_rearmed =
		slice_project_rearm_worker_for_rescan_noexcept(state);
	if (state->runtime.owner_initialized
		&& state->runtime.owner_guard.phase
			== slice_async_owner_phase::quiesced
		&& worker_rearmed) {
		(void)rearm_slice_async_owner_for_rescan_noexcept(
			&state->runtime.owner_guard);
	}
}

static void SliceProjectMarkPos(CustomScanState* custom) {
	if (custom->custom_ps != NIL) {
		ExecMarkPos(reinterpret_cast<PlanState*>(linitial(custom->custom_ps)));
	}
}

static void SliceProjectRestrPos(CustomScanState* custom) {
	if (custom->custom_ps != NIL) {
		ExecRestrPos(reinterpret_cast<PlanState*>(linitial(custom->custom_ps)));
	}
}

[[nodiscard]] static char* slice_project_deparse_expression(
		CustomScan* scan, int expression_index, ExplainState* es) {
	if (expression_index < 0
		|| expression_index >= list_length(scan->custom_exprs)) {
		return pstrdup("<omitted>");
	}
	Node* expression = reinterpret_cast<Node*>(
		list_nth(scan->custom_exprs, expression_index));
	return deparse_expression(expression, es->deparse_cxt, true, false);
}

[[nodiscard]] static const char* slice_project_opcode_name(
		SliceProjectOpcode opcode) noexcept {
	switch (opcode) {
		case SliceProjectOpcode::source_expr: return "source";
		case SliceProjectOpcode::literal_expr: return "literal";
		case SliceProjectOpcode::element: return "element";
		case SliceProjectOpcode::slice: return "slice";
		case SliceProjectOpcode::concat: return "concat";
		case SliceProjectOpcode::reverse: return "reverse";
		case SliceProjectOpcode::reverse_complement:
			return "reverse complement";
		case SliceProjectOpcode::length: return "length";
		case SliceProjectOpcode::cardinality: return "cardinality";
		case SliceProjectOpcode::bridge: return "literal bridge";
		case SliceProjectOpcode::materialize: return "materialize";
	}
	return "invalid";
}

[[nodiscard]] static List* slice_project_node_dependency_names(List* node) {
	List* names = NIL;
	Node* dependency_node = reinterpret_cast<Node*>(
		list_nth(node, kSliceNodeDependencies));
	if (dependency_node == nullptr) return names;
	for (Node* dependency : PList<Node>(
			reinterpret_cast<List*>(dependency_node))) {
		const std::string value = fmt::format(
			"value_{}", intVal(dependency));
		names = lappend(names, pstrdup(value.c_str()));
	}
	return names;
}

[[nodiscard]] static List* slice_project_dependency_names(List* record) {
	List* names = NIL;
	Node* dependency_node = reinterpret_cast<Node*>(
		list_nth(record, kSliceRecordDependencies));
	if (dependency_node == nullptr) return names;
	for (Node* dependency : PList<Node>(
			reinterpret_cast<List*>(dependency_node))) {
		char variable[32]{};
		snprintf(variable, sizeof(variable), "var_%d", intVal(dependency));
		names = lappend(names, pstrdup(variable));
	}
	return names;
}

#ifdef BIOSEQ_TEST_INDEXES
[[nodiscard]] static const char* slice_project_dsm_test_fixture_name(
		int mode) noexcept {
	switch (mode) {
		case kSliceDsmTestIncomplete: return "incomplete";
		case kSliceDsmTestMalformed: return "malformed";
		default: return "none";
	}
}

static void slice_project_explain_dsm_test_fixture(
		BioseqSliceProjectState const* state, ExplainState* es) {
	if (state == nullptr || es == nullptr
		|| !state->runtime.dsm_test_fixture_applied) return;
	auto const& runtime = state->runtime;
	const char* mode = slice_project_dsm_test_fixture_name(
		runtime.dsm_test_fixture_mode);
	if (es->format == EXPLAIN_FORMAT_TEXT) {
		auto property = [es](const char* name, const char* value) {
			appendStringInfoSpaces(es->str, es->indent * 2);
			appendStringInfo(es->str, "%s: %s\n", name, value);
		};
		property("DSM Test Fixture", mode);
		property("DSM Fixture Validated",
			runtime.dsm_test_fixture_validated ? "true" : "false");
		property("DSM Async Lifecycle Validated",
			runtime.dsm_test_async_validated ? "true" : "false");
		const auto integer_property = [es](
				const char* name, std::uint32_t value) {
			appendStringInfoSpaces(es->str, es->indent * 2);
			appendStringInfo(es->str, "%s: %u\n", name, value);
		};
		integer_property("DSM Fixture Checks", runtime.dsm_test_checks);
		integer_property(
			"DSM Fixture Slot Headers Read",
			runtime.dsm_test_slot_headers_read);
		integer_property(
			"DSM Fixture Counter Records Read",
			runtime.dsm_test_counter_records_read);
		integer_property(
			"DSM Async Cleanup Callbacks",
			runtime.dsm_test_cleanup_callbacks);
		return;
	}
	ExplainPropertyText("DSM Test Fixture", mode, es);
	ExplainPropertyBool(
		"DSM Fixture Validated", runtime.dsm_test_fixture_validated, es);
	ExplainPropertyBool(
		"DSM Async Lifecycle Validated",
		runtime.dsm_test_async_validated, es);
	ExplainPropertyUInteger(
		"DSM Fixture Checks", nullptr, runtime.dsm_test_checks, es);
	ExplainPropertyUInteger(
		"DSM Fixture Slot Headers Read", nullptr,
		runtime.dsm_test_slot_headers_read, es);
	ExplainPropertyUInteger(
		"DSM Fixture Counter Records Read", nullptr,
		runtime.dsm_test_counter_records_read, es);
	ExplainPropertyUInteger(
		"DSM Async Cleanup Callbacks", nullptr,
		runtime.dsm_test_cleanup_callbacks, es);
}
#endif

[[nodiscard]] static slice_dsm_counter const& slice_project_explain_counter(
		BioseqSliceProjectState const* state, std::uint32_t index) noexcept {
	static const slice_dsm_counter zero{};
	if (state == nullptr || !state->runtime.collect_actual
		|| state->runtime.counters == nullptr
		|| index >= state->runtime.boundary_count) return zero;
	return state->runtime.counters[index];
}

static void slice_project_explain_text(
		BioseqSliceProjectState* state, CustomScan* scan,
		List* header, List* nodes, List* records, ExplainState* es) {
	appendStringInfoSpaces(es->str, es->indent * 2);
	appendStringInfoString(es->str, "Slice Recipe:\n");
	for (Node* raw_node : PList<Node>(nodes)) {
		List* node = reinterpret_cast<List*>(raw_node);
		const int stable_id = intVal(list_nth(node, kSliceNodeStableId));
		const auto opcode = static_cast<SliceProjectOpcode>(intVal(
			list_nth(node, kSliceNodeOpcode)));
		const int expression_index = intVal(
			list_nth(node, kSliceNodeExpressionIndex));
		appendStringInfoSpaces(es->str, (es->indent + 1) * 2);
		appendStringInfo(es->str, "value_%d [%s] = %s\n", stable_id,
			slice_project_opcode_name(opcode),
			slice_project_deparse_expression(scan, expression_index, es));
		List* dependencies = slice_project_node_dependency_names(node);
		appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
		appendStringInfoString(es->str, "Depends On: ");
		if (dependencies == NIL) {
			appendStringInfoString(es->str, "none");
		} else {
			bool first = true;
			for (char* name : PList<char>(dependencies)) {
				if (!first) appendStringInfoString(es->str, ", ");
				appendStringInfoString(es->str, name);
				first = false;
			}
		}
		appendStringInfoChar(es->str, '\n');
		if (opcode == SliceProjectOpcode::slice
			|| opcode == SliceProjectOpcode::element) {
			const int lower = intVal(
				list_nth(node, kSliceNodeLowerExpressionIndex));
			const int upper = intVal(
				list_nth(node, kSliceNodeUpperExpressionIndex));
			appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
			appendStringInfo(es->str, "Bounds: lower=%s upper=%s\n",
				lower < 0 ? "omitted"
					: slice_project_deparse_expression(scan, lower, es),
				upper < 0 ? "omitted"
					: slice_project_deparse_expression(scan, upper, es));
		}
	}
	appendStringInfoSpaces(es->str, es->indent * 2);
	appendStringInfoString(es->str, "Slice Materialization:\n");
	if (es->analyze && state != nullptr
		&& state->runtime.trace_runtime.incomplete_workers != 0u) {
		appendStringInfoSpaces(es->str, (es->indent + 1) * 2);
		appendStringInfo(es->str, "Incomplete Workers: %u\n",
			state->runtime.trace_runtime.incomplete_workers);
	}
	std::uint32_t counter_index = 0u;
	for (Node* raw_record : PList<Node>(records)) {
		List* record = reinterpret_cast<List*>(raw_record);
		const int boundary_id = intVal(
			list_nth(record, kSliceRecordBoundaryId));
		const int producer_id = intVal(
			list_nth(record, kSliceRecordProducerId));
		const int expression_index = intVal(
			list_nth(record, kSliceRecordExpressionIndex));
		const auto mechanism = static_cast<materialization_mechanism>(intVal(
			list_nth(record, kSliceRecordMechanism)));
		const auto reason = static_cast<materialization_reason>(intVal(
			list_nth(record, kSliceRecordReason)));
		char* expression = slice_project_deparse_expression(
			scan, expression_index, es);
		appendStringInfoSpaces(es->str, (es->indent + 1) * 2);
		appendStringInfo(es->str, "var_%d = %s\n", boundary_id, expression);
		auto property = [es](const char* name, const char* value) {
			appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
			appendStringInfo(es->str, "%s: %s\n", name, value);
		};
		property("Mechanism", slice_project_mechanism_name(mechanism));
		property("Reason", slice_project_reason_name(reason));
		List* dependencies = slice_project_dependency_names(record);
		StringInfoData dependency_text;
		initStringInfo(&dependency_text);
		if (dependencies == NIL) {
			appendStringInfoString(&dependency_text, "none");
		} else {
			bool first = true;
			for (char* name : PList<char>(dependencies)) {
				if (!first) appendStringInfoString(&dependency_text, ", ");
				appendStringInfoString(&dependency_text, name);
				first = false;
			}
		}
		property("Depends On", dependency_text.data);
		property("Encoding", strVal(list_nth(record, kSliceRecordEncoding)));
		property("Cache Scope", strVal(
			list_nth(record, kSliceRecordCacheScope)));
		if (es->verbose) {
			char producer[32]{};
			snprintf(producer, sizeof(producer), "%d", producer_id);
			property("Producer Value", producer);
			property("Source Provenance", expression);
		}
		if (es->costs) {
			const auto estimate = slice_project_int8_value(
				reinterpret_cast<Node*>(list_nth(
					record, kSliceRecordEstimatedSymbols)));
			appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
			appendStringInfo(es->str,
				"Estimated Symbols: " UINT64_FORMAT "\n", estimate);
			appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
			appendStringInfo(es->str,
				"Estimated Bytes: " UINT64_FORMAT " bytes\n", estimate);
		}
		if (es->analyze) {
			auto const& counter = slice_project_explain_counter(
				state, counter_index);
			auto actual = [es](const char* name, std::uint64_t value,
					const char* unit = nullptr) {
				appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
				appendStringInfo(es->str, "%s: " UINT64_FORMAT "%s%s\n",
					name, value, unit == nullptr ? "" : " ",
					unit == nullptr ? "" : unit);
			};
			actual("Actual Calls", counter.calls);
			actual("Actual Input Symbols", counter.input_symbols);
			actual("Actual Output Symbols", counter.output_symbols);
			actual("Actual Bytes", counter.bytes, "bytes");
			actual("Reused Calls", counter.reused_calls);
			actual("Peak Retained Bytes", counter.peak_retained_bytes, "bytes");
			const bool overflow = counter.overflowed != 0u
				|| (state != nullptr
					&& (state->runtime.trace_runtime.invalid
						|| state->runtime.trace_runtime.overflowed));
			property("Counter Overflow", overflow ? "true" : "false");
			if (es->timing && state != nullptr && state->runtime.timing) {
				appendStringInfoSpaces(es->str, (es->indent + 2) * 2);
				appendStringInfo(es->str, "Actual Time: %.3f ms\n",
					static_cast<double>(counter.elapsed_ns) / 1.0e6);
			}
		}
		++counter_index;
	}
	if (records == NIL) {
		appendStringInfoSpaces(es->str, (es->indent + 1) * 2);
		appendStringInfoString(es->str, "none\n");
	}
	if (es->costs) {
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"Planned Materialized Symbols: " UINT64_FORMAT "\n",
			slice_project_int8_value(reinterpret_cast<Node*>(
				list_nth(header, kSliceHeaderPlannedSymbols))));
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"Planned Materialized Bytes: " UINT64_FORMAT " bytes\n",
			slice_project_int8_value(reinterpret_cast<Node*>(
				list_nth(header, kSliceHeaderPlannedBytes))));
	}
}

static void slice_project_explain_structured(
		BioseqSliceProjectState* state, CustomScan* scan,
		List* nodes, List* records, ExplainState* es) {
	ExplainOpenGroup("Slice Recipe", "Slice Recipe", false, es);
	for (Node* raw_node : PList<Node>(nodes)) {
		List* node = reinterpret_cast<List*>(raw_node);
		const int stable_id = intVal(list_nth(node, kSliceNodeStableId));
		const auto opcode = static_cast<SliceProjectOpcode>(intVal(
			list_nth(node, kSliceNodeOpcode)));
		const int expression_index = intVal(
			list_nth(node, kSliceNodeExpressionIndex));
		ExplainOpenGroup("Recipe Node", nullptr, true, es);
		ExplainPropertyUInteger("Stable ID", nullptr,
			static_cast<std::uint64_t>(stable_id), es);
		ExplainPropertyText("Opcode", slice_project_opcode_name(opcode), es);
		ExplainPropertyText("Expression", slice_project_deparse_expression(
			scan, expression_index, es), es);
		ExplainPropertyList("Depends On",
			slice_project_node_dependency_names(node), es);
		const int lower = intVal(
			list_nth(node, kSliceNodeLowerExpressionIndex));
		const int upper = intVal(
			list_nth(node, kSliceNodeUpperExpressionIndex));
		if (lower >= 0) {
			ExplainPropertyText("Lower Bound", slice_project_deparse_expression(
				scan, lower, es), es);
		}
		if (upper >= 0) {
			ExplainPropertyText("Upper Bound", slice_project_deparse_expression(
				scan, upper, es), es);
		}
		ExplainCloseGroup("Recipe Node", nullptr, true, es);
	}
	ExplainCloseGroup("Slice Recipe", "Slice Recipe", false, es);
	ExplainOpenGroup(
		"Slice Materialization", "Slice Materialization", false, es);
	if (es->analyze && state != nullptr
		&& state->runtime.trace_runtime.incomplete_workers != 0u) {
		ExplainPropertyUInteger("Incomplete Workers", nullptr,
			state->runtime.trace_runtime.incomplete_workers, es);
	}
	std::uint32_t counter_index = 0u;
	for (Node* raw_record : PList<Node>(records)) {
		List* record = reinterpret_cast<List*>(raw_record);
		const int boundary_id = intVal(
			list_nth(record, kSliceRecordBoundaryId));
		const int producer_id = intVal(
			list_nth(record, kSliceRecordProducerId));
		const int expression_index = intVal(
			list_nth(record, kSliceRecordExpressionIndex));
		const auto mechanism = static_cast<materialization_mechanism>(intVal(
			list_nth(record, kSliceRecordMechanism)));
		const auto reason = static_cast<materialization_reason>(intVal(
			list_nth(record, kSliceRecordReason)));
		char variable[32]{};
		snprintf(variable, sizeof(variable), "var_%d", boundary_id);
		ExplainOpenGroup("Materialization", nullptr, true, es);
		ExplainPropertyText("Variable", variable, es);
		ExplainPropertyText("Expression", slice_project_deparse_expression(
			scan, expression_index, es), es);
		ExplainPropertyText("Mechanism",
			slice_project_mechanism_name(mechanism), es);
		ExplainPropertyText("Reason", slice_project_reason_name(reason), es);
		ExplainPropertyList("Depends On",
			slice_project_dependency_names(record), es);
		ExplainPropertyText("Encoding",
			strVal(list_nth(record, kSliceRecordEncoding)), es);
		ExplainPropertyText("Cache Scope",
			strVal(list_nth(record, kSliceRecordCacheScope)), es);
		if (es->verbose) {
			ExplainPropertyUInteger("Producer Value", nullptr,
				static_cast<std::uint64_t>(producer_id), es);
			ExplainPropertyText("Source Provenance",
				slice_project_deparse_expression(scan, expression_index, es), es);
		}
		if (es->costs) {
			const auto estimate = slice_project_int8_value(
				reinterpret_cast<Node*>(list_nth(
					record, kSliceRecordEstimatedSymbols)));
			ExplainPropertyUInteger(
				"Estimated Symbols", nullptr, estimate, es);
			ExplainPropertyUInteger(
				"Estimated Bytes", "bytes", estimate, es);
		}
		if (es->analyze) {
			auto const& counter = slice_project_explain_counter(
				state, counter_index);
			ExplainPropertyUInteger("Actual Calls", nullptr, counter.calls, es);
			ExplainPropertyUInteger(
				"Actual Input Symbols", nullptr, counter.input_symbols, es);
			ExplainPropertyUInteger(
				"Actual Output Symbols", nullptr, counter.output_symbols, es);
			ExplainPropertyUInteger(
				"Actual Bytes", "bytes", counter.bytes, es);
			ExplainPropertyUInteger(
				"Reused Calls", nullptr, counter.reused_calls, es);
			ExplainPropertyUInteger("Peak Retained Bytes", "bytes",
				counter.peak_retained_bytes, es);
			ExplainPropertyBool("Counter Overflow",
				counter.overflowed != 0u || (state != nullptr
					&& (state->runtime.trace_runtime.invalid
						|| state->runtime.trace_runtime.overflowed)), es);
			if (es->timing && state != nullptr && state->runtime.timing) {
				ExplainPropertyFloat("Actual Time", "ms",
					static_cast<double>(counter.elapsed_ns) / 1.0e6,
					3, es);
			}
		}
		ExplainCloseGroup("Materialization", nullptr, true, es);
		++counter_index;
	}
	ExplainCloseGroup(
		"Slice Materialization", "Slice Materialization", false, es);
}

static void SliceProjectExplain(
		CustomScanState* custom, List*, ExplainState* es) {
	if (es->analyze) slice_project_ensure_trace_initialized(custom);
#ifdef BIOSEQ_TEST_INDEXES
	if (es->analyze) {
		slice_project_apply_dsm_test_fixture(
			reinterpret_cast<BioseqSliceProjectState*>(custom));
	}
#endif
	auto* scan = reinterpret_cast<CustomScan*>(custom->ss.ps.plan);
	List* header = slice_project_plan_header(scan);
	List* nodes = slice_project_plan_nodes(scan);
	List* records = slice_project_plan_records(scan);
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
#ifdef BIOSEQ_TEST_INDEXES
	slice_project_explain_dsm_test_fixture(state, es);
#endif
	if (es->format == EXPLAIN_FORMAT_TEXT) {
		slice_project_explain_text(state, scan, header, nodes, records, es);
		return;
	}
	ExplainPropertyText("Projection Mode", "source-backed lazy", es);
	ExplainPropertyUInteger("Source Pieces", nullptr,
		slice_project_int8_value(reinterpret_cast<Node*>(
			list_nth(header, kSliceHeaderSourcePieces))), es);
	ExplainPropertyUInteger("Estimated Piece Boundaries", nullptr,
		slice_project_int8_value(reinterpret_cast<Node*>(
			list_nth(header, kSliceHeaderPieceBoundaries))), es);
	ExplainPropertyText("Fallback Reason",
		strVal(list_nth(header, kSliceHeaderFallbackReason)), es);
	slice_project_explain_structured(state, scan, nodes, records, es);
}

static void SliceProjectShutdown(CustomScanState* custom) {
	auto* state = reinterpret_cast<BioseqSliceProjectState*>(custom);
	if (state->runtime.owner_initialized) {
		quiesce_slice_async_owner_noexcept(
			&state->runtime.owner_guard,
			slice_shutdown_disposition::complete);
	}
}

[[nodiscard]] static CustomExecMethods const&
bioseq_slice_project_exec_methods() noexcept {
	static_assert(std::is_same_v<decltype(&SliceProjectEstimateDSM),
		Size (*)(CustomScanState*, ParallelContext*)>);
	static_assert(std::is_same_v<decltype(&SliceProjectInitializeDSM),
		void (*)(CustomScanState*, ParallelContext*, void*)>);
	static_assert(std::is_same_v<decltype(&SliceProjectReInitializeDSM),
		void (*)(CustomScanState*, ParallelContext*, void*)>);
	static_assert(std::is_same_v<decltype(&SliceProjectInitializeWorker),
		void (*)(CustomScanState*, shm_toc*, void*)>);
	static_assert(std::is_same_v<decltype(&SliceProjectShutdown),
		void (*)(CustomScanState*)>);
	static_assert(std::is_same_v<decltype(&SliceProjectExplain),
		void (*)(CustomScanState*, List*, ExplainState*)>);
	static const CustomExecMethods methods{
		.CustomName = "BioseqSliceProject",
		.BeginCustomScan = SliceProjectBegin,
		.ExecCustomScan = SliceProjectExec,
		.EndCustomScan = SliceProjectEnd,
		.ReScanCustomScan = SliceProjectReScan,
		.MarkPosCustomScan = SliceProjectMarkPos,
		.RestrPosCustomScan = SliceProjectRestrPos,
		.EstimateDSMCustomScan = SliceProjectEstimateDSM,
		.InitializeDSMCustomScan = SliceProjectInitializeDSM,
		.ReInitializeDSMCustomScan = SliceProjectReInitializeDSM,
		.InitializeWorkerCustomScan = SliceProjectInitializeWorker,
		.ShutdownCustomScan = SliceProjectShutdown,
		.ExplainCustomScan = SliceProjectExplain,
	};
	return methods;
}

[[nodiscard]] static bool slice_project_is_bioseq_scan_path(Path* path) {
	if (path == nullptr || !IsA(path, CustomPath)) return false;
	auto* custom = reinterpret_cast<CustomPath*>(path);
	return custom->methods != nullptr
		&& custom->methods->CustomName != nullptr
		&& strcmp(custom->methods->CustomName, "BioseqScan") == 0;
}

[[nodiscard]] static bool slice_project_is_owner_path(Path* path) {
	if (path == nullptr || !IsA(path, CustomPath)) return false;
	auto* custom = reinterpret_cast<CustomPath*>(path);
	return custom->methods == &bioseq_slice_project_path_methods();
}

[[nodiscard]] static bool slice_project_targets_match(
		PathTarget* actual, PathTarget* expected) {
	const int expression_count = actual == nullptr
		? 0 : list_length(actual->exprs);
	if (actual == nullptr || expected == nullptr
		|| expression_count != list_length(expected->exprs)
		|| !equal(actual->exprs, expected->exprs)) {
		return false;
	}
	for (int index = 0; index < expression_count; ++index) {
		if (get_pathtarget_sortgroupref(actual, index)
			!= get_pathtarget_sortgroupref(expected, index)) {
			return false;
		}
	}
	return true;
}

/* An ordered upper target may omit resjunk entries retained by its child's
 * full target.  Prove every requested top-level lazy expression, including
 * its sortgroupref and duplicate multiplicity, is already published by that
 * full target.  Non-lazy outputs remain core's ordinary projection concern. */
[[nodiscard]] static bool slice_project_requested_lazy_target_is_subset(
		PathTarget* full_target, PathTarget* requested_target) {
	if (full_target == nullptr || requested_target == nullptr) return false;
	const int full_count = list_length(full_target->exprs);
	const int requested_count = list_length(requested_target->exprs);
	bool saw_lazy_expression = false;
	for (int requested_index = 0;
		 requested_index < requested_count; ++requested_index) {
		auto* requested_expression = reinterpret_cast<Node*>(
			list_nth(requested_target->exprs, requested_index));
		if (!bioseq_expr_uses_lazy_sequence_projection(
				requested_expression)) continue;
		saw_lazy_expression = true;
		const Index requested_sortgroupref = get_pathtarget_sortgroupref(
			requested_target, requested_index);

		int required_occurrences = 1;
		for (int prior_index = 0;
			 prior_index < requested_index; ++prior_index) {
			auto* prior_expression = reinterpret_cast<Node*>(
				list_nth(requested_target->exprs, prior_index));
			if (bioseq_expr_uses_lazy_sequence_projection(prior_expression)
				&& get_pathtarget_sortgroupref(
					requested_target, prior_index) == requested_sortgroupref
				&& equal(prior_expression, requested_expression)) {
				++required_occurrences;
			}
		}

		int available_occurrences = 0;
		for (int full_index = 0; full_index < full_count; ++full_index) {
			auto* full_expression = reinterpret_cast<Node*>(
				list_nth(full_target->exprs, full_index));
			if (get_pathtarget_sortgroupref(full_target, full_index)
					== requested_sortgroupref
				&& equal(full_expression, requested_expression)) {
				++available_occurrences;
			}
		}
		if (available_occurrences < required_occurrences) return false;
	}
	return saw_lazy_expression;
}

/* Recognition only: after the subset proof, pin the child's complete target
 * and cross exactly the ordering/parallel containers which preserve every
 * expression and sortgroupref.  Never cross projection, materialization,
 * joins, or any other evaluation frontier. */
[[nodiscard]] static bool
slice_project_is_owner_below_target_preserving_ordering(
		Path* path, PathTarget* requested_target) {
	if (path == nullptr
		|| !slice_project_requested_lazy_target_is_subset(
			path->pathtarget, requested_target)) return false;
	PathTarget* const full_target = path->pathtarget;
	while (path != nullptr
		&& slice_project_targets_match(path->pathtarget, full_target)) {
		if (slice_project_is_owner_path(path)) return true;
		if (IsA(path, SortPath)) {
			path = reinterpret_cast<SortPath*>(path)->subpath;
			continue;
		}
		if (IsA(path, IncrementalSortPath)) {
			path = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
			continue;
		}
		if (IsA(path, GatherPath)) {
			path = reinterpret_cast<GatherPath*>(path)->subpath;
			continue;
		}
		if (IsA(path, GatherMergePath)) {
			path = reinterpret_cast<GatherMergePath*>(path)->subpath;
			continue;
		}
		return false;
	}
	return false;
}

/* Planner Path nodes are deliberately marked `no_copy_equal` by PostgreSQL.
 * `copyObject(path)` therefore reaches copyObjectImpl's "unrecognized node
 * type" branch for every Path-family tag.  Clone exactly the mutable path
 * spine that slice_project_tag_owned_path_tree() descends, while sharing
 * immutable leaf paths and expression metadata.  This keeps Path traversal
 * structural and reserves PostgreSQL expression walkers/copying for actual
 * Expr/List nodes. */
[[nodiscard]] static Path* slice_project_clone_mutable_path_spine(Path* path);

[[nodiscard]] static List* slice_project_clone_path_list(List* paths) {
	List* clones = NIL;
	for (Path* child : PList<Path>(paths)) {
		clones = lappend(
			clones, slice_project_clone_mutable_path_spine(child));
	}
	return clones;
}

[[nodiscard]] static Path* slice_project_clone_mutable_path_spine(Path* path) {
	if (path == nullptr) return nullptr;
	if (IsA(path, NestPath)) {
		auto* clone = makeNode(NestPath);
		*clone = *reinterpret_cast<NestPath*>(path);
		clone->jpath.outerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.outerjoinpath);
		clone->jpath.innerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.innerjoinpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MergePath)) {
		auto* clone = makeNode(MergePath);
		*clone = *reinterpret_cast<MergePath*>(path);
		clone->jpath.outerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.outerjoinpath);
		clone->jpath.innerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.innerjoinpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, HashPath)) {
		auto* clone = makeNode(HashPath);
		*clone = *reinterpret_cast<HashPath*>(path);
		clone->jpath.outerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.outerjoinpath);
		clone->jpath.innerjoinpath = slice_project_clone_mutable_path_spine(
			clone->jpath.innerjoinpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, CustomPath)) {
		auto* clone = makeNode(CustomPath);
		*clone = *reinterpret_cast<CustomPath*>(path);
		clone->custom_paths = slice_project_clone_path_list(clone->custom_paths);
		clone->custom_restrictinfo = list_copy(clone->custom_restrictinfo);
		clone->custom_private = list_copy(clone->custom_private);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, ProjectionPath)) {
		auto* clone = makeNode(ProjectionPath);
		*clone = *reinterpret_cast<ProjectionPath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, ProjectSetPath)) {
		auto* clone = makeNode(ProjectSetPath);
		*clone = *reinterpret_cast<ProjectSetPath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, IncrementalSortPath)) {
		auto* clone = makeNode(IncrementalSortPath);
		*clone = *reinterpret_cast<IncrementalSortPath*>(path);
		clone->spath.subpath = slice_project_clone_mutable_path_spine(
			clone->spath.subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, SortPath)) {
		auto* clone = makeNode(SortPath);
		*clone = *reinterpret_cast<SortPath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MaterialPath)) {
		auto* clone = makeNode(MaterialPath);
		*clone = *reinterpret_cast<MaterialPath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MemoizePath)) {
		auto* clone = makeNode(MemoizePath);
		*clone = *reinterpret_cast<MemoizePath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, UniquePath)) {
		auto* clone = makeNode(UniquePath);
		*clone = *reinterpret_cast<UniquePath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, GatherPath)) {
		auto* clone = makeNode(GatherPath);
		*clone = *reinterpret_cast<GatherPath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, GatherMergePath)) {
		auto* clone = makeNode(GatherMergePath);
		*clone = *reinterpret_cast<GatherMergePath*>(path);
		clone->subpath = slice_project_clone_mutable_path_spine(clone->subpath);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, AppendPath)) {
		auto* clone = makeNode(AppendPath);
		*clone = *reinterpret_cast<AppendPath*>(path);
		clone->subpaths = slice_project_clone_path_list(clone->subpaths);
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MergeAppendPath)) {
		auto* clone = makeNode(MergeAppendPath);
		*clone = *reinterpret_cast<MergeAppendPath*>(path);
		clone->subpaths = slice_project_clone_path_list(clone->subpaths);
		return reinterpret_cast<Path*>(clone);
	}
	/* The tagger never mutates an unrecognised leaf/container. */
	return path;
}

[[nodiscard]] static Path* slice_project_tag_source_child(
		Path* path, PathTarget* target,
		SliceProjectIrBuilder const& builder) {
	if (!slice_project_is_bioseq_scan_path(path)) return path;
	auto* original = reinterpret_cast<CustomPath*>(path);
	auto* copy = makeNode(CustomPath);
	*copy = *original;
	copy->custom_private = NIL;
	for (Node* node : PList<Node>(original->custom_private)) {
		if (node != nullptr && IsA(node, List)) {
			List* tag = reinterpret_cast<List*>(node);
			if (list_length(tag) >= 1
				&& IsA(reinterpret_cast<Node*>(linitial(tag)), Integer)
				&& intVal(linitial(tag)) == kBioseqSliceSourceMagic) {
				continue;
			}
		}
		copy->custom_private = lappend(
			copy->custom_private, copyObject(node));
	}
	List* bindings = NIL;
	Bitmapset* seen_column_attnos = nullptr;
	int resno = 1;
	/* BSS3 bindings are [child resno, producer id, physical varattno].  The
	 * child resno validates plan/setrefs identity; promotion indexes the raw
	 * relation scan slot by physical varattno. */
	for (Node* expression : PList<Node>(target->exprs)) {
		if (exprType(expression) == builder.oids->bioseq_seq_type_oid) {
			Var* var = pg_node_try_as<Var>(expression);
			if (var == nullptr || var->varattno <= 0
				|| bms_is_member(var->varattno, seen_column_attnos)) {
				++resno;
				continue;
			}
			std::uint32_t producer_id = 0u;
			bool binding_found = false;
			for (auto const& binding : builder.source_bindings) {
				if (equal(binding.first, expression)) {
					producer_id = binding.second;
					binding_found = true;
					break;
				}
			}
			if (builder.source_bindings_only && !binding_found) {
				++resno;
				continue;
			}
			bindings = lappend(bindings,
				list_make3(makeInteger(resno),
					makeInteger(static_cast<int>(producer_id)),
					makeInteger(static_cast<int>(var->varattno))));
			seen_column_attnos = bms_add_member(
				seen_column_attnos, var->varattno);
		}
		++resno;
	}
	if (seen_column_attnos != nullptr) bms_free(seen_column_attnos);
	copy->custom_private = lappend(copy->custom_private,
		list_make3(makeInteger(kBioseqSliceSourceMagic),
			makeInteger(kBioseqSliceSourceVersion), bindings));
	copy->path.pathtarget = target;
	return reinterpret_cast<Path*>(copy);
}

/* `path` is already a private copy.  Descend only core path shapes whose
 * child ownership is part of PostgreSQL's public Path ABI; unknown custom and
 * foreign providers remain unmodified unless they expose their own contract. */
[[nodiscard]] static Path* slice_project_tag_owned_path_tree(
		Path* path, SliceProjectIrBuilder const& builder,
		bool& tagged_source) {
	if (path == nullptr) return nullptr;
	if (slice_project_is_bioseq_scan_path(path)) {
		tagged_source = true;
		PathTarget* leaf_target = copy_pathtarget(path->pathtarget);
		if (builder.planner_root != nullptr
			&& path->parent != nullptr
			&& path->parent->relid == builder.target_leaf_support_relid) {
			List* exact_support = NIL;
			for (Var* support : PList<Var>(
					builder.target_leaf_support_vars)) {
				if (support != nullptr
					&& bioseq_is_concrete_rte_varno(support->varno)
					&& support->varno == builder.target_leaf_support_relid
					&& support->varattno > 0
					&& support->varlevelsup == 0
					&& bms_is_empty(support->varnullingrels)) {
					exact_support = lappend(exact_support, support);
				}
			}
			add_new_columns_to_pathtarget(leaf_target, exact_support);
			set_pathtarget_cost_width(builder.planner_root, leaf_target);
		}
		return slice_project_tag_source_child(
			path, leaf_target, builder);
	}
	if (IsA(path, NestPath)) {
		auto* join = &reinterpret_cast<NestPath*>(path)->jpath;
		join->outerjoinpath = slice_project_tag_owned_path_tree(
			join->outerjoinpath, builder, tagged_source);
		join->innerjoinpath = slice_project_tag_owned_path_tree(
			join->innerjoinpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, MergePath)) {
		auto* join = &reinterpret_cast<MergePath*>(path)->jpath;
		join->outerjoinpath = slice_project_tag_owned_path_tree(
			join->outerjoinpath, builder, tagged_source);
		join->innerjoinpath = slice_project_tag_owned_path_tree(
			join->innerjoinpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, HashPath)) {
		auto* join = &reinterpret_cast<HashPath*>(path)->jpath;
		join->outerjoinpath = slice_project_tag_owned_path_tree(
			join->outerjoinpath, builder, tagged_source);
		join->innerjoinpath = slice_project_tag_owned_path_tree(
			join->innerjoinpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, CustomPath)) {
		auto* custom = reinterpret_cast<CustomPath*>(path);
		for (ListCell* cell = list_head(custom->custom_paths);
			 cell != nullptr; cell = lnext(custom->custom_paths, cell)) {
			lfirst(cell) = slice_project_tag_owned_path_tree(
				reinterpret_cast<Path*>(lfirst(cell)), builder, tagged_source);
		}
		return path;
	}
	if (IsA(path, ProjectionPath)) {
		auto* projection = reinterpret_cast<ProjectionPath*>(path);
		projection->subpath = slice_project_tag_owned_path_tree(
			projection->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, ProjectSetPath)) {
		auto* projection = reinterpret_cast<ProjectSetPath*>(path);
		projection->subpath = slice_project_tag_owned_path_tree(
			projection->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, SortPath)) {
		auto* sort = reinterpret_cast<SortPath*>(path);
		sort->subpath = slice_project_tag_owned_path_tree(
			sort->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, IncrementalSortPath)) {
		auto* sort = reinterpret_cast<IncrementalSortPath*>(path);
		sort->spath.subpath = slice_project_tag_owned_path_tree(
			sort->spath.subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, MaterialPath)) {
		auto* material = reinterpret_cast<MaterialPath*>(path);
		material->subpath = slice_project_tag_owned_path_tree(
			material->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, MemoizePath)) {
		auto* memoize = reinterpret_cast<MemoizePath*>(path);
		memoize->subpath = slice_project_tag_owned_path_tree(
			memoize->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, UniquePath)) {
		auto* unique = reinterpret_cast<UniquePath*>(path);
		unique->subpath = slice_project_tag_owned_path_tree(
			unique->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, GatherPath)) {
		auto* gather = reinterpret_cast<GatherPath*>(path);
		gather->subpath = slice_project_tag_owned_path_tree(
			gather->subpath, builder, tagged_source);
		return path;
	}
	if (IsA(path, GatherMergePath)) {
		auto* gather = reinterpret_cast<GatherMergePath*>(path);
		gather->subpath = slice_project_tag_owned_path_tree(
			gather->subpath, builder, tagged_source);
		return path;
	}
	auto tag_path_list = [&builder, &tagged_source](List* subpaths) {
		for (ListCell* cell = list_head(subpaths);
			 cell != nullptr; cell = lnext(subpaths, cell)) {
			lfirst(cell) = slice_project_tag_owned_path_tree(
				reinterpret_cast<Path*>(lfirst(cell)), builder, tagged_source);
		}
	};
	if (IsA(path, AppendPath)) {
		tag_path_list(reinterpret_cast<AppendPath*>(path)->subpaths);
	} else if (IsA(path, MergeAppendPath)) {
		tag_path_list(reinterpret_cast<MergeAppendPath*>(path)->subpaths);
	}
	return path;
}

/* Match the exact public Path containers understood by the tagger above.
 * Transformed per-row owners may not choose an IndexPath merely because it is
 * the cheapest mmsearch-free replacement: at least the target side must keep
 * a BioseqScan provider from which BSS3 can borrow the lazy source. */
[[nodiscard]] static bool slice_project_path_tree_has_bioseq_scan(
		Path* path) noexcept {
	if (path == nullptr) return false;
	if (slice_project_is_bioseq_scan_path(path)) return true;
	if (IsA(path, NestPath)) {
		auto* join = &reinterpret_cast<NestPath*>(path)->jpath;
		return slice_project_path_tree_has_bioseq_scan(join->outerjoinpath)
			|| slice_project_path_tree_has_bioseq_scan(join->innerjoinpath);
	}
	if (IsA(path, MergePath)) {
		auto* join = &reinterpret_cast<MergePath*>(path)->jpath;
		return slice_project_path_tree_has_bioseq_scan(join->outerjoinpath)
			|| slice_project_path_tree_has_bioseq_scan(join->innerjoinpath);
	}
	if (IsA(path, HashPath)) {
		auto* join = &reinterpret_cast<HashPath*>(path)->jpath;
		return slice_project_path_tree_has_bioseq_scan(join->outerjoinpath)
			|| slice_project_path_tree_has_bioseq_scan(join->innerjoinpath);
	}
	if (IsA(path, CustomPath)) {
		for (Path* child : PList<Path>(
				reinterpret_cast<CustomPath*>(path)->custom_paths)) {
			if (slice_project_path_tree_has_bioseq_scan(child)) return true;
		}
		return false;
	}
	Path* unary = nullptr;
	if (IsA(path, ProjectionPath)) {
		unary = reinterpret_cast<ProjectionPath*>(path)->subpath;
	} else if (IsA(path, ProjectSetPath)) {
		unary = reinterpret_cast<ProjectSetPath*>(path)->subpath;
	} else if (IsA(path, SortPath)) {
		unary = reinterpret_cast<SortPath*>(path)->subpath;
	} else if (IsA(path, IncrementalSortPath)) {
		unary = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
	} else if (IsA(path, MaterialPath)) {
		unary = reinterpret_cast<MaterialPath*>(path)->subpath;
	} else if (IsA(path, MemoizePath)) {
		unary = reinterpret_cast<MemoizePath*>(path)->subpath;
	} else if (IsA(path, UniquePath)) {
		unary = reinterpret_cast<UniquePath*>(path)->subpath;
	} else if (IsA(path, GatherPath)) {
		unary = reinterpret_cast<GatherPath*>(path)->subpath;
	} else if (IsA(path, GatherMergePath)) {
		unary = reinterpret_cast<GatherMergePath*>(path)->subpath;
	}
	if (unary != nullptr) {
		return slice_project_path_tree_has_bioseq_scan(unary);
	}
	List* children = NIL;
	if (IsA(path, AppendPath)) {
		children = reinterpret_cast<AppendPath*>(path)->subpaths;
	} else if (IsA(path, MergeAppendPath)) {
		children = reinterpret_cast<MergeAppendPath*>(path)->subpaths;
	}
	for (Path* child : PList<Path>(children)) {
		if (slice_project_path_tree_has_bioseq_scan(child)) return true;
	}
	return false;
}

/* BatchSort is an upper owner rather than a SliceProject node, but it needs
 * the same exact base-scan source contract: copy the owned input tree, attach
 * BSS3 only to BioseqScan leaves, and leave unknown providers untouched. */
[[nodiscard]] static Path* batch_sort_tag_source_path(
		Path* path, Node* sort_expression, bool* tagged_out) {
	if (tagged_out == nullptr) return nullptr;
	*tagged_out = false;
	if (path == nullptr || sort_expression == nullptr) return path;
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (oids == nullptr
		|| exprType(sort_expression) != oids->bioseq_seq_type_oid) return path;
	SliceProjectIrBuilder builder{
		.oids = oids,
		.command_type = CMD_SELECT,
		.source_bindings_only = true,
	};
	/* BatchSort has no SliceProject producer graph.  Producer zero therefore
	 * truthfully means source ownership without boundary attribution. */
	builder.source_bindings.emplace_back(
		reinterpret_cast<Node*>(copyObject(sort_expression)), 0u);
	Path* private_path = slice_project_clone_mutable_path_spine(path);
	bool tagged = false;
	private_path = slice_project_tag_owned_path_tree(
		private_path, builder, tagged);
	*tagged_out = tagged;
	return tagged ? private_path : path;
}

static void batch_sort_collect_source_routes(
		PlanState* plan, bioseq::storage::pg_sequence_source_route_set& routes,
		std::uint32_t& provider_count) {
	if (plan == nullptr) return;
	if (IsA(plan, CustomScanState)) {
		auto* custom = reinterpret_cast<CustomScanState*>(plan);
		if (custom->methods == &BioseqColumnScanExecuteMethods) {
			auto* scan = BioseqScanState::from_custom_scan_state(custom);
			BioseqScanRuntime& runtime = bioseq_runtime(scan);
			if (!runtime.lazy_source_projection) return;
			if (runtime.lazy_source_provider == nullptr
				|| !bioseq::storage::add_pg_sequence_source_route(
					routes, runtime.lazy_source_provider)) {
				ereport(ERROR,
					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
					 errmsg("BioseqBatchSort source route is unavailable")));
			}
			provider_count = bioseq::parallelism::saturating_add(
				provider_count, 1u);
			return;
		}
		for (PlanState* child : PList<PlanState>(custom->custom_ps)) {
			batch_sort_collect_source_routes(child, routes, provider_count);
		}
		return;
	}
	if (IsA(plan, AppendState)) {
		auto* append = reinterpret_cast<AppendState*>(plan);
		for (int index = 0; index < append->as_nplans; ++index) {
			batch_sort_collect_source_routes(
				append->appendplans[index], routes, provider_count);
		}
		return;
	}
	if (IsA(plan, MergeAppendState)) {
		auto* append = reinterpret_cast<MergeAppendState*>(plan);
		for (int index = 0; index < append->ms_nplans; ++index) {
			batch_sort_collect_source_routes(
				append->mergeplans[index], routes, provider_count);
		}
		return;
	}
	PlanState* outer = outerPlanState(plan);
	PlanState* inner = innerPlanState(plan);
	batch_sort_collect_source_routes(outer, routes, provider_count);
	if (inner != outer) {
		batch_sort_collect_source_routes(inner, routes, provider_count);
	}
}

[[nodiscard]] static bool batch_sort_attach_source_routes(
		PlanState* child,
		bioseq::storage::pg_sequence_source_route_set& routes) {
	std::uint32_t provider_count = 0u;
	batch_sort_collect_source_routes(child, routes, provider_count);
	return provider_count != 0u;
}

struct SliceProjectBaseTargetProof {
	Index relid = 0;
	bool allow_row_identity = false;
	bool saw_base_var = false;
	bool invalid = false;
};

[[nodiscard]] static bool slice_project_is_target_row_identity_var(
		const Var* var, const Index relid) noexcept {
	if (var == nullptr || !bioseq_is_concrete_rte_varno(relid)
		|| var->varno != relid
		|| var->varlevelsup != 0
		|| !bms_is_empty(var->varnullingrels)) return false;
	return (var->varattno == SelfItemPointerAttributeNumber
			&& var->vartype == TIDOID && var->vartypmod == -1
			&& !OidIsValid(var->varcollid))
		|| (var->varattno == TableOidAttributeNumber
			&& var->vartype == OIDOID && var->vartypmod == -1
			&& !OidIsValid(var->varcollid));
}

struct slice_project_base_target_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			SliceProjectBaseTargetProof& proof) const noexcept {
		if (node.try_as<PlaceHolderVar>() != nullptr) {
			/* A PHV belongs to a planner-selected evaluation/nulling frontier.
			 * A base SliceProject must not move it below that frontier. */
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (Var* var = node.try_as<Var>()) {
			if (proof.allow_row_identity
				&& slice_project_is_target_row_identity_var(
					var, proof.relid)) {
				return pg_walk_step::skip_subtree;
			}
			if (var->varno != proof.relid || var->varattno <= 0
				|| var->varlevelsup != 0
				|| !bms_is_empty(var->varnullingrels)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			proof.saw_base_var = true;
			return pg_walk_step::skip_subtree;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool slice_project_target_has_semantic_owner(
		PlannerInfo* root, PathTarget* target) {
	if (root == nullptr || root->parse == nullptr || target == nullptr) {
		return true;
	}
	Node* expressions = reinterpret_cast<Node*>(target->exprs);
	return root->parse->hasAggs || root->parse->hasWindowFuncs
		|| root->parse->hasTargetSRFs
		|| root->parse->groupClause != NIL
		|| root->parse->groupingSets != NIL
		|| root->parse->havingQual != nullptr
		|| root->parse->setOperations != nullptr
		|| contain_agg_clause(expressions)
		|| contain_window_function(expressions)
		|| contain_volatile_functions(expressions)
		|| contain_subplans(expressions)
		|| expression_returns_set(expressions);
}

/* UPDATE's RETURNING target belongs to ModifyTable, not to its scan/join
 * subplan.  We may describe a nonvolatile lazy subtree below a volatile final
 * consumer, but we must never move or execute that consumer here.  This proof
 * therefore checks only the base-local Var/semantic frontier and deliberately
 * does not reject volatile ancestors; slice_project_discover_target() rejects
 * every recognized lazy subtree which itself contains volatility. */
[[nodiscard]] static bool slice_project_update_recipe_target_is_safe(
		PlannerInfo* root, RelOptInfo* rel, PathTarget* target) {
	if (root == nullptr || rel == nullptr || root->parse == nullptr
		|| target == nullptr || target->exprs == NIL
		|| contain_agg_clause(reinterpret_cast<Node*>(target->exprs))
		|| contain_window_function(reinterpret_cast<Node*>(target->exprs))
		|| contain_subplans(reinterpret_cast<Node*>(target->exprs))
		|| expression_returns_set(reinterpret_cast<Node*>(target->exprs))) {
		return false;
	}
	SliceProjectBaseTargetProof proof{.relid = rel->relid};
	slice_project_base_target_visitor visitor;
	pg_walk_expression_including_root(
		reinterpret_cast<Node*>(target->exprs), proof, visitor);
	return proof.saw_base_var && !proof.invalid;
}

/* Prove the final processed projection can be evaluated immediately above
 * this one base relation.  The single-baserel restriction is intentionally
 * strict: a wider query needs a join/upper owner which preserves its own
 * nulling and evaluation frontier. */
[[nodiscard]] static bool slice_project_base_target_is_safe(
		PlannerInfo* root, RelOptInfo* rel, PathTarget* target) {
	if (root == nullptr || rel == nullptr || root->parse == nullptr
		|| target == nullptr || target->exprs == NIL
		|| root->parse->hasRowSecurity
		|| !(root->parse->commandType == CMD_SELECT
			|| root->parse->commandType == CMD_INSERT
			|| root->parse->commandType == CMD_UPDATE)
		|| rel->relid == 0 || rel->reloptkind != RELOPT_BASEREL
		|| bms_num_members(root->all_baserels) != 1
		|| !bms_is_member(static_cast<int>(rel->relid), root->all_baserels)
		|| !bms_is_empty(rel->lateral_relids)
		|| slice_project_target_has_semantic_owner(root, target)) {
		return false;
	}
	SliceProjectBaseTargetProof proof{
		.relid = rel->relid,
		.allow_row_identity = root->parse->commandType == CMD_UPDATE,
	};
	slice_project_base_target_visitor visitor;
	pg_walk_expression_including_root(
		reinterpret_cast<Node*>(target->exprs), proof, visitor);
	return (proof.saw_base_var
		|| root->parse->commandType == CMD_UPDATE) && !proof.invalid;
}

[[nodiscard]] static bool slice_project_update_sources_are_stable(
		PlannerInfo* root, RelOptInfo* rel,
		SliceProjectIrBuilder const& builder) {
	if (root == nullptr || rel == nullptr || root->update_colnos == NIL) {
		return false;
	}
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	bool saw_sequence_source = false;
	for (Node* expression : PList<Node>(builder.expressions)) {
		List* vars = pull_var_clause(expression, pull_flags);
		for (Var* var : PList<Var>(vars)) {
			if (var->vartype != builder.oids->bioseq_seq_type_oid) continue;
			if (var->varno != rel->relid || var->varattno <= 0
				|| var->varlevelsup != 0
				|| !bms_is_empty(var->varnullingrels)
				|| list_member_int(root->update_colnos, var->varattno)) {
				return false;
			}
			saw_sequence_source = true;
		}
	}
	return saw_sequence_source;
}

/* Install the lowest valid owner for a base-local recipe.  Every surviving
 * alternative is a real SliceProject -> BioseqScan pair; incompatible index,
 * heap, and untagged paths are removed only after at least one complete owner
 * has been constructed.  Costs remain ordinary nonnegative PostgreSQL costs. */
static void slice_project_try_install_base_owner(
		PlannerInfo* root, RelOptInfo* rel, Relation relation) {
	if (!bioseq::settings::enable_custom_scan
		|| root == nullptr || rel == nullptr
		|| relation == nullptr || root->processed_tlist == NIL
		|| root->parse == nullptr) return;
	const bool update_returning = root->parse->commandType == CMD_UPDATE;
	if (update_returning
		&& (root->parse->resultRelation != rel->relid
			|| root->parse->returningList == NIL
			|| relation->trigdesc != nullptr)) return;
	PathTarget* projection_target = make_pathtarget_from_tlist(
		root->processed_tlist);
	set_pathtarget_cost_width(root, projection_target);
	if (!slice_project_base_target_is_safe(root, rel, projection_target)) return;
	if (!is_parallel_safe(
			root, reinterpret_cast<Node*>(projection_target->exprs))) return;
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (oids == nullptr) return;
	SliceProjectIrBuilder builder{
		.oids = oids, .command_type = root->parse->commandType};
	PathTarget* recipe_target = projection_target;
	if (update_returning) {
		recipe_target = make_pathtarget_from_tlist(root->parse->returningList);
		set_pathtarget_cost_width(root, recipe_target);
		if (!slice_project_update_recipe_target_is_safe(
				root, rel, recipe_target)) return;
	}
	if (!slice_project_discover_target(recipe_target, builder)) return;
	if (!is_parallel_safe(
			root, reinterpret_cast<Node*>(builder.expressions))) return;
	if (update_returning) {
		/* RETURNING is evaluated by ModifyTable against the actual updated
		 * tuple.  These bindings use RETURNING resnos and must never be applied
		 * to the distinct UPDATE subplan output descriptor. */
		builder.output_bindings = NIL;
		if (!slice_project_update_sources_are_stable(root, rel, builder)) return;
	}

	List* required = NIL;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	for (Node* expression : PList<Node>(projection_target->exprs)) {
		required = list_concat(required,
			pull_var_clause(expression, pull_flags));
	}
	if (update_returning) {
		for (Node* expression : PList<Node>(builder.expressions)) {
			required = list_concat(required,
				pull_var_clause(expression, pull_flags));
		}
	}
	QualCost expression_cost{};
	cost_qual_eval(&expression_cost, projection_target->exprs, root);
	const double metadata_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.piece_boundaries, UINT32_MAX));
	const double boundary_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.planned_symbols, UINT32_MAX));

	PList<Path> owners;
	PList<Path> partial_owners;
	auto build_owner = [root, rel, projection_target, required, &builder,
		&expression_cost, metadata_per_row,
		boundary_per_row](Path* source) -> Path* {
		PathTarget* child_target = copy_pathtarget(source->pathtarget);
		add_new_columns_to_pathtarget(child_target, required);
		set_pathtarget_cost_width(root, child_target);
		Path* child = slice_project_tag_source_child(
			source, child_target, builder);

		auto* owner = makeNode(CustomPath);
		owner->path.pathtype = T_CustomScan;
		owner->path.parent = rel;
		owner->path.pathtarget = copy_pathtarget(projection_target);
		owner->path.param_info = child->param_info;
		owner->path.parallel_aware = child->parallel_aware;
		owner->path.parallel_safe = child->parallel_safe;
		owner->path.parallel_workers = child->parallel_workers;
		owner->path.rows = child->rows;
		owner->path.startup_cost = child->startup_cost
			+ expression_cost.startup;
		const double rows = std::max(0.0, child->rows);
		owner->path.total_cost = child->total_cost + expression_cost.startup
			+ rows * (expression_cost.per_tuple
				+ metadata_per_row + boundary_per_row);
		owner->path.pathkeys = child->pathkeys;
		owner->flags = CUSTOMPATH_SUPPORT_PROJECTION;
		owner->custom_paths = list_make1(child);
		owner->custom_private = list_make5(
			slice_project_header(builder), copyObject(builder.expressions),
			copyObject(builder.nodes), copyObject(builder.records),
			copyObject(builder.output_bindings));
		owner->custom_restrictinfo = NIL;
		owner->methods = &bioseq_slice_project_path_methods();
		return reinterpret_cast<Path*>(owner);
	};
	for (Path* source : PList<Path>(rel->pathlist)) {
		if (!slice_project_is_bioseq_scan_path(source)) continue;
		owners.append(build_owner(source));
	}
	for (Path* source : PList<Path>(rel->partial_pathlist)) {
		if (!slice_project_is_bioseq_scan_path(source)) continue;
		partial_owners.append(build_owner(source));
	}
	if (owners.empty()) return;

	/* Gather paths are derived after this hook from reltarget.  Since every
	 * surviving ordinary and partial path publishes the processed projection,
	 * make that target canonical before core constructs Gather; otherwise it
	 * asks a final-expression SliceProject child to publish the old raw Var. */
	rel->reltarget = copy_pathtarget(projection_target);
	rel->pathlist = NIL;
	rel->partial_pathlist = NIL;
	rel->cheapest_startup_path = nullptr;
	rel->cheapest_total_path = nullptr;
	rel->cheapest_unique_path = nullptr;
	rel->cheapest_parameterized_paths = NIL;
	for (Path* owner : owners) add_path(rel, owner);
	for (Path* owner : partial_owners) add_partial_path(rel, owner);
}

struct SliceProjectAggregateRecipePresence {
	const BioseqStubOids* oids = nullptr;
	bool found = false;
};

struct slice_project_aggregate_recipe_presence_visitor {
	/* Stop at the first planner expression represented by DOC0377 IR. */
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			SliceProjectAggregateRecipePresence& proof) const noexcept {
		if (slice_project_node_opcode(node.raw(), *proof.oids).has_value()) {
			proof.found = true;
			return pg_walk_step::stop;
		}
		return pg_walk_step::descend;
	}
};

/* Report whether an expression tree contains a recognized DOC0377 recipe. */
[[nodiscard]] static inline bool slice_project_aggregate_expression_has_recipe(
		Node* expression, const BioseqStubOids* oids) {
	if (expression == nullptr || oids == nullptr) return false;
	SliceProjectAggregateRecipePresence proof{.oids = oids};
	slice_project_aggregate_recipe_presence_visitor visitor;
	pg_walk_expression_including_root(expression, proof, visitor);
	return proof.found;
}

struct SliceProjectAggregateArgumentProof {
	const BioseqStubOids* oids = nullptr;
	Relids available_relids = nullptr;
	bool saw_sequence_var = false;
	bool invalid = false;
};

struct slice_project_aggregate_argument_visitor {
	/* Prove that every Var belongs to the aggregate input relation. */
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			SliceProjectAggregateArgumentProof& proof) const noexcept {
		if (node.try_as<PlaceHolderVar>() != nullptr
			|| node.try_as<Param>() != nullptr) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (Var* var = node.try_as<Var>()) {
			if (!bioseq_is_concrete_rte_varno(var->varno)
				|| !bms_is_member(static_cast<int>(var->varno),
					proof.available_relids)
				|| var->varattno <= 0 || var->varlevelsup != 0
				|| !bms_is_empty(var->varnullingrels)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			if (var->vartype == proof.oids->bioseq_seq_type_oid) {
				proof.saw_sequence_var = true;
			}
			return pg_walk_step::skip_subtree;
		}
		return pg_walk_step::descend;
	}
};

/* Accept only parallel-safe aggregate inputs rooted in a sequence Var. */
[[nodiscard]] static inline bool slice_project_aggregate_argument_is_safe(
		PlannerInfo* root, Relids available_relids, Node* expression,
		const BioseqStubOids* oids, bool require_sequence_var = true) {
	if (root == nullptr || available_relids == nullptr
		|| expression == nullptr || oids == nullptr
		|| contain_agg_clause(expression)
		|| contain_window_function(expression)
		|| contain_subplans(expression)
		|| expression_returns_set(expression)
		|| contain_volatile_functions(expression)
		|| !is_parallel_safe(root, expression)) return false;
	SliceProjectAggregateArgumentProof proof{
		.oids = oids, .available_relids = available_relids};
	slice_project_aggregate_argument_visitor visitor;
	pg_walk_expression_including_root(expression, proof, visitor);
	return !proof.invalid
		&& (!require_sequence_var || proof.saw_sequence_var);
}

struct SliceProjectAggregateInputProof {
	PlannerInfo* root = nullptr;
	const BioseqStubOids* oids = nullptr;
	Relids available_relids = nullptr;
	List* candidates = NIL;
	List* input_expressions = NIL;
	List* visited_aggregates = NIL;
	bool saw_recipe = false;
	bool invalid = false;
};

/* Append one structurally distinct whole aggregate-argument expression. */
static inline void slice_project_add_unique_aggregate_candidate(
		SliceProjectAggregateInputProof& proof, Node* expression) {
	for (Node* candidate : PList<Node>(proof.candidates)) {
		if (equal(candidate, expression)) return;
	}
	proof.candidates = lappend(proof.candidates, expression);
}

/* Retain every ordinary argument expression so raw Vars needed by resjunk
 * ORDER BY carriers are published through the lower owner as well. */
static inline void slice_project_add_unique_aggregate_input(
		SliceProjectAggregateInputProof& proof, Node* expression) {
	for (Node* input : PList<Node>(proof.input_expressions)) {
		if (equal(input, expression)) return;
	}
	proof.input_expressions = lappend(
		proof.input_expressions, expression);
}

struct slice_project_aggregate_input_visitor {
	/* Collect movable whole arguments while enforcing aggregate barriers. */
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			SliceProjectAggregateInputProof& proof) const {
		if (node.tag() == T_GroupingFunc
			|| node.tag() == T_WindowFunc
			|| node.tag() == T_SubPlan) {
			return pg_walk_step::skip_subtree;
		}
		Aggref* aggregate = node.try_as<Aggref>();
		if (aggregate == nullptr) return pg_walk_step::descend;
		if (aggregate->agglevelsup != 0
			|| list_member_ptr(proof.visited_aggregates, aggregate)) {
			return pg_walk_step::skip_subtree;
		}
		proof.visited_aggregates = lappend(
			proof.visited_aggregates, aggregate);

		List* aggregate_candidates = NIL;
		bool malformed_arguments = false;
		bool other_argument_is_unsafe = false;
		for (Node* raw_argument : PList<Node>(aggregate->args)) {
			TargetEntry* argument = pg_node_try_as<TargetEntry>(raw_argument);
			if (argument == nullptr || argument->expr == nullptr) {
				malformed_arguments = true;
				continue;
			}
			Node* expression = reinterpret_cast<Node*>(argument->expr);
			other_argument_is_unsafe = other_argument_is_unsafe
				|| contain_agg_clause(expression)
				|| contain_window_function(expression)
				|| contain_subplans(expression)
				|| expression_returns_set(expression)
				|| contain_volatile_functions(expression);
			if (slice_project_aggregate_expression_has_recipe(
					expression, proof.oids)) {
				aggregate_candidates = lappend(
					aggregate_candidates, expression);
			}
		}
		bool barrier_has_recipe = false;
		for (Node* direct : PList<Node>(aggregate->aggdirectargs)) {
			barrier_has_recipe = barrier_has_recipe
				|| slice_project_aggregate_expression_has_recipe(
					direct, proof.oids);
		}
		if (aggregate->aggfilter != nullptr) {
			barrier_has_recipe = barrier_has_recipe
				|| slice_project_aggregate_expression_has_recipe(
					reinterpret_cast<Node*>(aggregate->aggfilter), proof.oids);
		}
		if (aggregate_candidates == NIL && !barrier_has_recipe) {
			return pg_walk_step::skip_subtree;
		}
		proof.saw_recipe = true;
		/* FILTER controls whether ordinary arguments are evaluated.  Direct
		 * arguments and ordered-set/hypothetical aggregates have group-level
		 * rather than per-input-row semantics.  None may cross this Agg node. */
		if (malformed_arguments || aggregate->aggkind != AGGKIND_NORMAL
			|| aggregate->aggdirectargs != NIL
			|| aggregate->aggfilter != nullptr || barrier_has_recipe
			|| other_argument_is_unsafe) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		/* Validate every ordinary input, including resjunk ORDER BY carriers,
		 * against the same sole source relation.  The owner copies the complete
		 * input PathTarget, so these expressions retain their original carrier
		 * positions and sort-group wiring. */
		for (Node* raw_argument : PList<Node>(aggregate->args)) {
			TargetEntry* argument = pg_node_try_as<TargetEntry>(raw_argument);
			Node* expression = reinterpret_cast<Node*>(argument->expr);
			if (!slice_project_aggregate_argument_is_safe(
					proof.root, proof.available_relids, expression,
					proof.oids, false)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			slice_project_add_unique_aggregate_input(proof, expression);
		}
		for (Node* expression : PList<Node>(aggregate_candidates)) {
			if (!slice_project_aggregate_argument_is_safe(
					proof.root, proof.available_relids, expression,
					proof.oids)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			/* Publish the exact argument expression, never its TargetEntry.  The
			 * Aggref therefore retains its resno/ressortgroupref and aggorder
			 * wiring while setrefs maps only the argument to the owner output. */
			slice_project_add_unique_aggregate_candidate(proof, expression);
		}
		return pg_walk_step::skip_subtree;
	}
};

/* Resolve relation identity from the sole source-owning scan rather than an
 * upper SortPath's parent RelOptInfo (upper relations intentionally have no
 * base relids).  Only target-preserving unary containers may be crossed: this
 * keeps every ordered-aggregate carrier and its PathTarget sortgroupref intact. */
[[nodiscard]] static inline Relids slice_project_aggregate_source_relids(
		Path* path) noexcept {
	while (path != nullptr) {
		if (slice_project_is_bioseq_scan_path(path)) {
			return path->parent != nullptr && path->parent->relids != nullptr
				&& bms_num_members(path->parent->relids) == 1
				? path->parent->relids : nullptr;
		}
		Path* child = nullptr;
		if (IsA(path, ProjectionPath)) {
			child = reinterpret_cast<ProjectionPath*>(path)->subpath;
		} else if (IsA(path, SortPath)) {
			child = reinterpret_cast<SortPath*>(path)->subpath;
		} else if (IsA(path, IncrementalSortPath)) {
			child = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
		} else if (IsA(path, MaterialPath)) {
			child = reinterpret_cast<MaterialPath*>(path)->subpath;
		} else {
			return nullptr;
		}
		if (child == nullptr
			|| !slice_project_targets_match(path->pathtarget,
				child->pathtarget)) return nullptr;
		path = child;
	}
	return nullptr;
}

/* Discover every supported DOC0377 argument consumed by one AggPath. */
[[nodiscard]] static inline SliceProjectAggregateInputProof
slice_project_collect_aggregate_inputs(
		PlannerInfo* root, AggPath* aggregate,
		const BioseqStubOids* oids) {
	SliceProjectAggregateInputProof proof{
		.root = root,
		.oids = oids,
		.available_relids = aggregate != nullptr
			? slice_project_aggregate_source_relids(aggregate->subpath)
			: nullptr,
	};
	if (aggregate == nullptr || aggregate->path.pathtarget == nullptr
		|| aggregate->path.pathtarget->exprs == NIL
		|| proof.available_relids == nullptr) {
		proof.invalid = true;
		return proof;
	}
	slice_project_aggregate_input_visitor visitor;
	pg_walk_expression_including_root(
		reinterpret_cast<Node*>(aggregate->path.pathtarget->exprs),
		proof, visitor);
	if (!proof.invalid && aggregate->qual != NIL) {
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(aggregate->qual), proof, visitor);
	}
	return proof;
}

/* Report whether a path spine crosses a Gather or GatherMerge boundary. */
[[nodiscard]] static inline bool slice_project_path_tree_has_exchange(
		Path* path) noexcept {
	if (path == nullptr) return false;
	if (IsA(path, GatherPath) || IsA(path, GatherMergePath)) return true;
	if (IsA(path, NestPath)) {
		auto* join = &reinterpret_cast<NestPath*>(path)->jpath;
		return slice_project_path_tree_has_exchange(join->outerjoinpath)
			|| slice_project_path_tree_has_exchange(join->innerjoinpath);
	}
	if (IsA(path, MergePath)) {
		auto* join = &reinterpret_cast<MergePath*>(path)->jpath;
		return slice_project_path_tree_has_exchange(join->outerjoinpath)
			|| slice_project_path_tree_has_exchange(join->innerjoinpath);
	}
	if (IsA(path, HashPath)) {
		auto* join = &reinterpret_cast<HashPath*>(path)->jpath;
		return slice_project_path_tree_has_exchange(join->outerjoinpath)
			|| slice_project_path_tree_has_exchange(join->innerjoinpath);
	}
	if (IsA(path, CustomPath)) {
		for (Path* child : PList<Path>(
				reinterpret_cast<CustomPath*>(path)->custom_paths)) {
			if (slice_project_path_tree_has_exchange(child)) return true;
		}
		return false;
	}
	Path* unary = nullptr;
	if (IsA(path, ProjectionPath)) {
		unary = reinterpret_cast<ProjectionPath*>(path)->subpath;
	} else if (IsA(path, ProjectSetPath)) {
		unary = reinterpret_cast<ProjectSetPath*>(path)->subpath;
	} else if (IsA(path, SortPath)) {
		unary = reinterpret_cast<SortPath*>(path)->subpath;
	} else if (IsA(path, IncrementalSortPath)) {
		unary = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
	} else if (IsA(path, MaterialPath)) {
		unary = reinterpret_cast<MaterialPath*>(path)->subpath;
	} else if (IsA(path, MemoizePath)) {
		unary = reinterpret_cast<MemoizePath*>(path)->subpath;
	} else if (IsA(path, UniquePath)) {
		unary = reinterpret_cast<UniquePath*>(path)->subpath;
	}
	if (unary != nullptr) return slice_project_path_tree_has_exchange(unary);
	List* children = NIL;
	if (IsA(path, AppendPath)) {
		children = reinterpret_cast<AppendPath*>(path)->subpaths;
	} else if (IsA(path, MergeAppendPath)) {
		children = reinterpret_cast<MergeAppendPath*>(path)->subpaths;
	}
	for (Path* child : PList<Path>(children)) {
		if (slice_project_path_tree_has_exchange(child)) return true;
	}
	return false;
}

/* Build the lower SliceProject that materializes aggregate arguments lazily. */
[[nodiscard]] static inline Path* slice_project_build_aggregate_input_owner(
		PlannerInfo* root, AggPath* aggregate,
		SliceProjectAggregateInputProof const& proof) {
	Path* source = aggregate == nullptr ? nullptr : aggregate->subpath;
	Relids source_relids = slice_project_aggregate_source_relids(source);
	if (root == nullptr || source == nullptr || source->parent == nullptr
		|| source->param_info != nullptr || proof.candidates == NIL
		|| proof.oids == nullptr
		|| source_relids == nullptr
		|| !bms_equal(source_relids, proof.available_relids)
		|| !slice_project_path_tree_has_bioseq_scan(source)) return nullptr;

	PathTarget* lower_target = copy_pathtarget(source->pathtarget);
	/* Aggref arguments remain owned by the parent aggregate PathTarget.  Keep
	 * only structural equality across the setrefs boundary: neither later
	 * child-target processing nor the SliceProject codec may share those exact
	 * mutable Node objects with the parent Aggref. */
	List* owned_candidates = static_cast<List*>(copyObject(proof.candidates));
	List* owned_inputs = static_cast<List*>(
		copyObject(proof.input_expressions));
	List* required = NIL;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	for (Node* input : PList<Node>(owned_inputs)) {
		required = list_concat(required,
			pull_var_clause(input, pull_flags));
	}
	/* The copied source target retains ordered carriers (notably the resjunk
	 * id Var) and all existing sortgrouprefs.  Append only any missing raw Vars
	 * on private copies before adding the exact lazy argument expressions. */
	add_new_columns_to_pathtarget(lower_target,
		static_cast<List*>(copyObject(required)));
	add_new_columns_to_pathtarget(lower_target, owned_candidates);
	set_pathtarget_cost_width(root, lower_target);
	SliceProjectIrBuilder builder{
		.oids = proof.oids,
		/* Aggregate inputs are internal executor values, not client output. */
		.command_type = CMD_UNKNOWN,
	};
	if (!slice_project_discover_target(lower_target, builder)
		|| !is_parallel_safe(
			root, reinterpret_cast<Node*>(lower_target->exprs))) return nullptr;

	PathTarget* support_target = copy_pathtarget(source->pathtarget);
	add_new_columns_to_pathtarget(support_target,
		static_cast<List*>(copyObject(required)));
	set_pathtarget_cost_width(root, support_target);

	Path* child = nullptr;
	if (slice_project_is_bioseq_scan_path(source)) {
		child = slice_project_tag_source_child(
			source, support_target, builder);
	} else {
		bool tagged_source = false;
		Path* private_child = slice_project_clone_mutable_path_spine(source);
		private_child = slice_project_tag_owned_path_tree(
			private_child, builder, tagged_source);
		if (!tagged_source) return nullptr;
		child = reinterpret_cast<Path*>(create_projection_path(
			root, private_child->parent, private_child, support_target));
	}
	if (child == nullptr || child->param_info != nullptr
		|| !pathkeys_contained_in(source->pathkeys, child->pathkeys)
		|| !pathkeys_contained_in(child->pathkeys, source->pathkeys)) {
		return nullptr;
	}

	const double rows = std::max(0.0, child->rows);
	const double metadata_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.piece_boundaries, UINT32_MAX));
	const double boundary_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.planned_symbols, UINT32_MAX));
	auto* owner = makeNode(CustomPath);
	owner->path.pathtype = T_CustomScan;
	owner->path.parent = source->parent;
	owner->path.pathtarget = lower_target;
	owner->path.param_info = child->param_info;
	owner->path.parallel_aware = child->parallel_aware;
	owner->path.parallel_safe = child->parallel_safe;
	owner->path.parallel_workers = child->parallel_workers;
	owner->path.rows = child->rows;
	/* AggPath already charges evaluation of its arguments.  This wrapper only
	 * adds source-owner metadata overhead; charging the argument twice would
	 * distort serial/partial aggregate selection. */
	owner->path.startup_cost = child->startup_cost;
	owner->path.total_cost = child->total_cost
		+ rows * (metadata_per_row + boundary_per_row);
	owner->path.pathkeys = child->pathkeys;
	owner->flags = CUSTOMPATH_SUPPORT_PROJECTION;
	owner->custom_paths = list_make1(child);
	owner->custom_private = list_make5(
		slice_project_header(builder), copyObject(builder.expressions),
		copyObject(builder.nodes), copyObject(builder.records),
		copyObject(builder.output_bindings));
	owner->custom_restrictinfo = NIL;
	owner->methods = &bioseq_slice_project_path_methods();

	return reinterpret_cast<Path*>(owner);
}

struct SliceProjectAggregatePathRewrite {
	Path* path = nullptr;
	bool changed = false;
	bool unsafe = false;
};

/* Detect an eager semantic alternative that this AggPath rewrite cannot own. */
[[nodiscard]] static inline bool
slice_project_non_aggregate_path_has_recipe(
		Path* path, const BioseqStubOids* oids) {
	if (path == nullptr || oids == nullptr) return false;
	if (path->pathtarget != nullptr && path->pathtarget->exprs != NIL
		&& slice_project_aggregate_expression_has_recipe(
			reinterpret_cast<Node*>(path->pathtarget->exprs), oids)) {
		return true;
	}
	List* quals = NIL;
	if (IsA(path, GroupPath)) {
		quals = reinterpret_cast<GroupPath*>(path)->qual;
	} else if (IsA(path, GroupingSetsPath)) {
		quals = reinterpret_cast<GroupingSetsPath*>(path)->qual;
	} else if (IsA(path, MinMaxAggPath)) {
		quals = reinterpret_cast<MinMaxAggPath*>(path)->quals;
	}
	return quals != NIL
		&& slice_project_aggregate_expression_has_recipe(
				reinterpret_cast<Node*>(quals), oids);
}

/* Clone one supported raw-input AggPath over its new SliceProject owner. */
[[nodiscard]] static inline SliceProjectAggregatePathRewrite
slice_project_rewrite_aggregate_path(
		PlannerInfo* root, UpperRelationKind stage, Path* path,
		const BioseqStubOids* oids) {
	if (path == nullptr) return {.path = path};
	if (!IsA(path, AggPath)) {
		return {
			.path = path,
			.unsafe = slice_project_non_aggregate_path_has_recipe(path, oids),
		};
	}
	auto* aggregate = reinterpret_cast<AggPath*>(path);
	if (aggregate->path.pathtarget == nullptr) {
		return {.path = path, .unsafe = true};
	}
	if (DO_AGGSPLIT_COMBINE(aggregate->aggsplit)) return {.path = path};
	const bool supported_split =
		(stage == UPPERREL_PARTIAL_GROUP_AGG
			&& aggregate->aggsplit == AGGSPLIT_INITIAL_SERIAL)
		|| (stage == UPPERREL_GROUP_AGG
			&& aggregate->aggsplit == AGGSPLIT_SIMPLE);
	SliceProjectAggregateInputProof proof =
		slice_project_collect_aggregate_inputs(root, aggregate, oids);
	if (!proof.saw_recipe) return {.path = path};
	if (!supported_split || proof.invalid || proof.candidates == NIL
		|| (stage == UPPERREL_GROUP_AGG
			&& slice_project_path_tree_has_exchange(aggregate->subpath))) {
		return {.path = path, .unsafe = true};
	}
	Path* owner = slice_project_build_aggregate_input_owner(
		root, aggregate, proof);
	if (owner == nullptr) return {.path = path, .unsafe = true};

	auto* clone = makeNode(AggPath);
	*clone = *aggregate;
	clone->subpath = owner;
	const Cost startup_delta = (aggregate->aggstrategy == AGG_SORTED
		|| aggregate->aggstrategy == AGG_MIXED)
		? owner->startup_cost - aggregate->subpath->startup_cost
		: owner->total_cost - aggregate->subpath->total_cost;
	clone->path.startup_cost += startup_delta;
	clone->path.total_cost += owner->total_cost
		- aggregate->subpath->total_cost;
	return {
		.path = reinterpret_cast<Path*>(clone),
		.changed = true,
	};
}

struct SliceProjectAggregatePathListRewrite {
	List* paths = NIL;
	bool changed = false;
	bool unsafe = false;
};

/* Copy-on-write rewrite one complete planner path list or reject it whole. */
[[nodiscard]] static inline SliceProjectAggregatePathListRewrite
slice_project_rewrite_aggregate_path_list(
		PlannerInfo* root, UpperRelationKind stage, List* paths,
		const BioseqStubOids* oids) {
	SliceProjectAggregatePathListRewrite result;
	for (Path* path : PList<Path>(paths)) {
		SliceProjectAggregatePathRewrite rewritten =
			slice_project_rewrite_aggregate_path(root, stage, path, oids);
		if (rewritten.unsafe) {
			result.unsafe = true;
			return result;
		}
		result.paths = lappend(result.paths, rewritten.path);
		result.changed = result.changed || rewritten.changed;
	}
	return result;
}

/* Atomically install safe aggregate-input owners and refresh cheapest paths. */
static inline void slice_project_try_install_aggregate_input_owners(
		PlannerInfo* root, UpperRelationKind stage, RelOptInfo* output_rel) {
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (oids == nullptr) return;
	SliceProjectAggregatePathListRewrite ordinary =
		slice_project_rewrite_aggregate_path_list(
			root, stage, output_rel->pathlist, oids);
	SliceProjectAggregatePathListRewrite partial;
	if (stage == UPPERREL_PARTIAL_GROUP_AGG) {
		partial = slice_project_rewrite_aggregate_path_list(
			root, stage, output_rel->partial_pathlist, oids);
	}
	if (ordinary.unsafe || partial.unsafe
		|| (!ordinary.changed && !partial.changed)) return;
	if (ordinary.changed) output_rel->pathlist = ordinary.paths;
	if (partial.changed) output_rel->partial_pathlist = partial.paths;
	if (ordinary.changed) {
		output_rel->cheapest_startup_path = nullptr;
		output_rel->cheapest_total_path = nullptr;
		output_rel->cheapest_unique_path = nullptr;
		output_rel->cheapest_parameterized_paths = NIL;
		set_cheapest(output_rel);
	}
}

/* Install SliceProject ownership at the relevant upper-planner stages. */
static inline void BioseqSliceProject_CreateUpperPaths(
		PlannerInfo* root, UpperRelationKind stage,
		RelOptInfo* input_rel, RelOptInfo* output_rel, void*) {
	if (!bioseq::settings::enable_custom_scan || root == nullptr
		|| input_rel == nullptr || output_rel == nullptr
		|| output_rel->reltarget == nullptr
		|| root->parse == nullptr || root->parse->hasRowSecurity
		|| root->parse->commandType != CMD_SELECT) return;
	if (stage == UPPERREL_PARTIAL_GROUP_AGG
		|| stage == UPPERREL_GROUP_AGG) {
		slice_project_try_install_aggregate_input_owners(
			root, stage, output_rel);
		return;
	}
	if (!(stage == UPPERREL_WINDOW
		|| stage == UPPERREL_DISTINCT || stage == UPPERREL_ORDERED
		|| stage == UPPERREL_FINAL)) return;
	/*
	 * PostgreSQL can defer the final SELECT projection until after the
	 * UPPERREL_FINAL hook has run.  In that shape output_rel->reltarget still
	 * describes the pass-through input (and a later core ProjectionPath becomes
	 * the visible Result), while grouping_planner has already published the
	 * stage's authoritative projection in root->upper_targets.  Discovering
	 * recipes only in output_rel->reltarget therefore misses the common
	 *
	 *     Result (slice expression)
	 *       -> BioseqScan (raw sequence Var)
	 *
	 * plan.  Build the owner against the same stage target core will apply
	 * after this hook.  Falling back to the relation target preserves stages
	 * for which core has no separate upper target.
	 */
	PathTarget* projection_target = root->upper_targets[stage];
	if (projection_target == nullptr) {
		projection_target = output_rel->reltarget;
	}
	if (projection_target == nullptr
		|| slice_project_target_has_semantic_owner(root, projection_target)) return;
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (oids == nullptr) return;
	if (!is_parallel_safe(
			root, reinterpret_cast<Node*>(projection_target->exprs))) return;
	SliceProjectIrBuilder builder{
		.oids = oids, .command_type = root->parse->commandType};
	if (!slice_project_discover_target(projection_target, builder)) return;
	for (Node* expression : PList<Node>(projection_target->exprs)) {
		if (bioseq_expr_uses_lazy_sequence_projection(expression)
			&& contain_volatile_functions(expression)) return;
	}
	Path* child = input_rel->cheapest_total_path;
	if (child == nullptr && input_rel->pathlist != NIL) {
		child = reinterpret_cast<Path*>(linitial(input_rel->pathlist));
	}
	if (child == nullptr) return;
	while (IsA(child, ProjectionPath)
		&& bioseq_expr_uses_lazy_sequence_projection(
			reinterpret_cast<Node*>(child->pathtarget->exprs))) {
		child = reinterpret_cast<ProjectionPath*>(child)->subpath;
	}
	if (slice_project_is_owner_below_target_preserving_ordering(
			child, projection_target)) return;

	List* required = NIL;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	/* Only the owned recipe graph needs raw child inputs.  Ordinary projection
	 * expressions are already represented by the chosen child's PathTarget and
	 * must remain atomic here.  In particular, a raw ABI-v3 BatchJoin publishes
	 * each MatchResult helper as one exact output identity; descending through
	 * bioseq.query_start(t.pk) would synthesize a new t.pk requirement above the
	 * owner even though that raw Var is intentionally absent from its public
	 * target.  Core setrefs would then fail while binding the intermediate
	 * ProjectionPath.  The IR expression list contains every lazy producer,
	 * source, concat operand, and bound expression, so pulling from it retains
	 * the complete SliceProject dependency closure without opening non-lazy
	 * helper identities. */
	for (Node* expression : PList<Node>(builder.expressions)) {
		required = list_concat(required,
			pull_var_clause(expression, pull_flags));
	}
	PathTarget* child_target = copy_pathtarget(child->pathtarget);
	add_new_columns_to_pathtarget(child_target, required);
	set_pathtarget_cost_width(root, child_target);
	if (slice_project_is_bioseq_scan_path(child)) {
		child = slice_project_tag_source_child(child, child_target, builder);
	} else {
		/* A join/upper child is immutable and may be shared by many candidates.
		 * Deep-copy supported core path shapes and tag every BioseqScan source
		 * below them before installing hidden leaf outputs through core's
		 * projection constructor.  The final target remains wrapper-only. */
		bool tagged_source = false;
		Path* private_child = slice_project_clone_mutable_path_spine(child);
		private_child = slice_project_tag_owned_path_tree(
			private_child, builder, tagged_source);
		if (!tagged_source) return;
		child = reinterpret_cast<Path*>(create_projection_path(
			root, private_child->parent, private_child, child_target));
	}

	QualCost expression_cost{};
	cost_qual_eval(&expression_cost, projection_target->exprs, root);
	const double rows = std::max(0.0, child->rows);
	const double metadata_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.piece_boundaries, UINT32_MAX));
	const double boundary_per_row = cpu_operator_cost * static_cast<double>(
		std::min<std::uint64_t>(builder.planned_symbols, UINT32_MAX));

	auto* path = makeNode(CustomPath);
	path->path.pathtype = T_CustomScan;
	path->path.parent = output_rel;
	path->path.pathtarget = copy_pathtarget(projection_target);
	path->path.param_info = child->param_info;
	path->path.parallel_aware = child->parallel_aware;
	path->path.parallel_safe = child->parallel_safe;
	path->path.parallel_workers = child->parallel_workers;
	path->path.rows = child->rows;
	path->path.startup_cost = child->startup_cost + expression_cost.startup;
	path->path.total_cost = child->total_cost + expression_cost.startup
		+ rows * (expression_cost.per_tuple
			+ metadata_per_row + boundary_per_row);
	path->path.pathkeys = child->pathkeys;
	path->flags = CUSTOMPATH_SUPPORT_PROJECTION;
	path->custom_paths = list_make1(child);
	path->custom_private = list_make5(
		slice_project_header(builder), builder.expressions, builder.nodes,
		builder.records, builder.output_bindings);
	path->custom_restrictinfo = NIL;
	path->methods = &bioseq_slice_project_path_methods();

	/* The core ProjectionPath remains fractionally cheaper because PostgreSQL's
	 * generic cost model cannot represent avoided full-sequence hydration.  Do
	 * not falsify either cost.  Once a complete source-tagged wrapper exists,
	 * remove the incompatible unowned alternatives so selection is structural.
	 * Every early/fallback return above leaves the original lists untouched. */
	output_rel->pathlist = NIL;
	output_rel->partial_pathlist = NIL;
	output_rel->cheapest_startup_path = nullptr;
	output_rel->cheapest_total_path = nullptr;
	output_rel->cheapest_unique_path = nullptr;
	output_rel->cheapest_parameterized_paths = NIL;
	add_path(output_rel, reinterpret_cast<Path*>(path));
	set_cheapest(output_rel);
}


/*
 * bioseq_customscan_init installs the hook required to intercept the postgres planner and
 * provide extra paths for columnar tables
 */
export void
bioseq_customscan_init()
{
	PreviousSetRelPathlistHook = set_rel_pathlist_hook;
	set_rel_pathlist_hook = BioseqColumnSetRelPathlistHook;
	PreviousSetJoinPathlistHook = set_join_pathlist_hook;
	set_join_pathlist_hook = BioseqBatchJoinSetJoinPathlistHook;

	PreviousGetRelationInfoHook = get_relation_info_hook;
	get_relation_info_hook = BioseqColumnGetRelationInfoHook;

	RegisterCustomScanMethods(&BioseqColumnScanScanMethods);
	RegisterCustomScanMethods(&BioseqBatchJoinScanMethods);
	RegisterCustomScanMethods(&bioseq_slice_project_scan_methods());
	bioseq_register_slice_project_upper_path_provider(
		BioseqSliceProject_CreateUpperPaths);
	bioseq_register_batch_sort_source_providers(
		batch_sort_tag_source_path, batch_sort_attach_source_routes);
}

static void
BioseqColumnSetRelPathlistHook(PlannerInfo *root, RelOptInfo *rel, Index rti,
						   RangeTblEntry *rte)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnSetRelPathlistHook() entered");
	/* call into previous hook if assigned */
	if (PreviousSetRelPathlistHook)
	{
		PreviousSetRelPathlistHook(root, rel, rti, rte);
	}

	if (!OidIsValid(rte->relid) || rte->rtekind != RTE_RELATION || rte->inh)
	{
		/* some calls to the pathlist hook don't have a valid relation set. Do nothing */
		return;
	}

	/*
	 * Here we want to inspect if this relation pathlist hook is accessing a columnar table.
	 * If that is the case we want to insert an extra path that pushes down the projection
	 * into the scan of the table to minimize the data read.
	 */
	Relation relation = RelationIdGetRelation(rte->relid);
	if (relation->rd_tableam == GetBioseqColumnTableAmRoutine())
	{
		if (rte->tablesample != NULL)
		{
			bioseq_report<ERR, PG>().code(ERRCODE_FEATURE_NOT_SUPPORTED)
							.msg("sample scans not supported on columnar tables");
		}

		/*
		 * There are cases where IndexPath is normally more preferrable over
		 * SeqPath for heapAM but not for columnarAM. In such cases, an
		 * IndexPath could wrongly dominate a SeqPath based on the costs
		 * estimated by postgres earlier. For this reason, here we manually
		 * create a SeqPath, estimate the cost based on columnarAM and append
		 * to pathlist.
		 *
		 * Before doing that, we first re-cost all the existing paths so that
		 * add_path makes correct cost comparisons when appending our SeqPath.
		 */
		CostBioseqColumnPaths(root, rel, rte->relid);

		Path *seqPath = CreateBioseqColumnSeqScanPath(root, rel, rte->relid);
		add_path(rel, seqPath);

		if (bioseq::settings::enable_custom_scan)
		{
			/*
			 * When columnar custom scan is enabled (bioseq.enable_custom_scan),
			 * we only consider BioseqColumnScanPath's & IndexPath's. For this reason,
			 * we remove other paths and re-estimate IndexPath costs to make accurate
			 * comparisons between them.
			 *
			 * Even more, we might calculate an equal cost for a
			 * BioseqColumnCustomScan and a SeqPath if we are reading all columns
			 * of given table since we don't consider chunk group filtering
			 * when costing BioseqColumnCustomScan.
			 * In that case, if we don't remove SeqPath's, we might wrongly choose
			 * SeqPath thinking that its cost would be equal to BioseqColumnCustomScan.
			 */
			RemovePathsByPredicate(rel, IsNotIndexPath);
			AddBioseqColumnScanPaths(root, rel, rte);
			slice_project_try_install_base_owner(root, rel, relation);
		}
	}
	else
	{
		/* DOC0372 — external logical relations use a distinct table AM. The
		 * always-owned slot returns false (this columnar hook simply falls
		 * through) unless the external provider stack is compiled in and has
		 * registered a path builder, in which case the builder replaces the
		 * physical scan with the external CustomScan. */
		(void) TryAddBioseqExternalScanPaths(root, rel, rte, relation);
	}
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnSetRelPathlistHook() relation_close");
	RelationClose(relation);
}


static void
BioseqColumnGetRelationInfoHook(PlannerInfo *root, Oid relationObjectId,
							bool inhparent, RelOptInfo *rel)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnGetRelationInfoHook() entered");
	if (PreviousGetRelationInfoHook)
	{
		PreviousGetRelationInfoHook(root, relationObjectId, inhparent, rel);
	}

	if (IsBioseqColumnTableAmTable(relationObjectId))
	{
		/* disable parallel query */
		rel->rel_parallel_workers = 0;

		/* disable index-only scan */
		for(auto indexOptInfo : PList<IndexOptInfo>(rel->indexlist)) {
			memset(indexOptInfo->canreturn, false, indexOptInfo->ncolumns * sizeof(bool));
		}
	}
}

struct BatchJoinTargetProjectionProbe {
	Index target_varno = 0;
	AttrNumber target_seq_attno = InvalidAttrNumber;
	const BioseqStubOids* oids = nullptr;
	bool allow_mmsearch_qualifier = false;
	bool forbidden = false;
};

struct batch_join_target_projection_visitor {
	[[nodiscard]] pg_walk_step operator()(
		pg_expression_walk_cursor,
		pg_node_view node,
		BatchJoinTargetProjectionProbe& probe) const noexcept {
		/* A validated mmsearch restriction consumes the locator inside the
		 * BatchJoin executor, while match-result helpers are evaluated by its
		 * parent from the current MatchResult. Neither argument is a request to
		 * let the locator-backed datum escape into ordinary SQL evaluation. A
		 * projected mmsearch call remains forbidden. */
		if (FuncExpr* function = node.try_as<FuncExpr>()) {
			if (probe.oids != nullptr
				&& (is_bioseq_projection_funcid(function->funcid, *probe.oids)
					|| (probe.allow_mmsearch_qualifier
						&& is_mmsearch_funcid(
							function->funcid, *probe.oids)))) {
				return pg_walk_step::skip_subtree;
			}
		}
		if (Var* var = node.try_as<Var>()) {
			if (var->varno == probe.target_varno
				&& (var->varattno == 0
					|| var->varattno == probe.target_seq_attno)) {
				probe.forbidden = true;
				return pg_walk_step::stop;
			}
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool batch_join_target_expression_is_forbidden(
		Node* expression,
		const Var* target_var,
		const bool allow_mmsearch_qualifier) {
	if (expression == nullptr || target_var == nullptr) {
		return false;
	}
	BatchJoinTargetProjectionProbe probe{
		target_var->varno, target_var->varattno,
		&get_cached_stub_oids(), allow_mmsearch_qualifier, false};
	batch_join_target_projection_visitor visitor;
	pg_walk_expression_including_root(
		expression, probe, visitor);
	return probe.forbidden;
}

[[nodiscard]] static bool batch_join_target_restrictions_are_forbidden(
		List* restrictions,
		const Var* target_var,
		const bool allow_mmsearch_qualifier) {
	for (Node* node : PList<Node>(restrictions)) {
		RestrictInfo* restriction = pg_node_try_as<RestrictInfo>(node);
		if (restriction == nullptr || restriction->clause == nullptr
			|| batch_join_target_expression_is_forbidden(
				reinterpret_cast<Node*>(restriction->clause),
				target_var,
				allow_mmsearch_qualifier)) {
			return true;
		}
	}
	return false;
}

[[nodiscard]] static bool batch_join_typmod_is_supported(
		const int32 typmod) noexcept {
	if (typmod < 0) {
		return false;
	}
	const auto decoded = compact_sequence_stdc_type_params::decode(typmod);
	const bool alphabet_supported =
		decoded.alphabet_code < pgseq_supported_alphabets::alphabet_count;
	const bool width_supported =
		pgseq_supported_storage_unit_byte_widths::contains_runtime(
			decoded.storage_unit_byte_width);
	return alphabet_supported && width_supported
		&& decoded.encode() == typmod;
}

[[noreturn]] static void raise_mmsearch_alphabet_mismatch(
		const compact_sequence_stdc_type_params target,
		const compact_sequence_stdc_type_params query,
		const char* phase) {
	const auto target_name =
		pgseq_supported_alphabets::name_of_alphabet_code(
			target.alphabet_code);
	const auto query_name =
		pgseq_supported_alphabets::name_of_alphabet_code(
			query.alphabet_code);
	ereport(ERROR,
		(errcode(ERRCODE_DATATYPE_MISMATCH),
		 errmsg("bioseq mmsearch requires operands with the same bound alphabet"),
		 errdetail(
			"phase=%s target=seq('%.*s', %u) query=seq('%.*s', %u)",
			phase,
			static_cast<int>(target_name.size()), target_name.data(),
			static_cast<unsigned>(target.storage_unit_byte_width) * 8u,
			static_cast<int>(query_name.size()), query_name.data(),
			static_cast<unsigned>(query.storage_unit_byte_width) * 8u),
		 errhint("Explicitly convert the data before binding it to one alphabet; mmsearch never performs cross-alphabet recoding.")));
	pg_unreachable();
}

[[nodiscard]] static bool mmsearch_typmods_share_alphabet(
		const int32 target_typmod,
		const int32 query_typmod) noexcept {
	return batch_join_typmod_is_supported(target_typmod)
		&& batch_join_typmod_is_supported(query_typmod)
		&& compact_sequence_stdc_type_params::decode(target_typmod).alphabet_code
			== compact_sequence_stdc_type_params::decode(query_typmod).alphabet_code;
}

struct PerRowSequenceTypmodProof {
	int32 typmod = -1;
	bool descriptor_erased = false;
};

[[nodiscard]] static bool per_row_function_signature_is_exact(
		FuncExpr* function) {
	if (function == nullptr || function->funcretset
		|| OidIsValid(function->funcvariadic)) return false;
	Oid* catalog_argument_types = nullptr;
	int catalog_argument_count = 0;
	const Oid catalog_result_type = get_func_signature(
		function->funcid, &catalog_argument_types, &catalog_argument_count);
	if (catalog_result_type != function->funcresulttype
		|| catalog_argument_count != list_length(function->args)) return false;
	int argument_index = 0;
	for (Node* argument : PList<Node>(function->args)) {
		if (argument == nullptr
			|| exprType(argument)
				!= catalog_argument_types[argument_index++]) return false;
	}
	return true;
}

[[nodiscard]] static bool per_row_operator_signature_is_exact(
		OpExpr* operation) {
	if (operation == nullptr || !OidIsValid(operation->opno)
		|| !OidIsValid(operation->opfuncid) || operation->opretset
		|| get_opcode(operation->opno) != operation->opfuncid) return false;
	Oid* catalog_argument_types = nullptr;
	int catalog_argument_count = 0;
	const Oid catalog_result_type = get_func_signature(
		operation->opfuncid,
		&catalog_argument_types,
		&catalog_argument_count);
	if (catalog_result_type != operation->opresulttype
		|| catalog_argument_count != list_length(operation->args)) return false;
	int argument_index = 0;
	for (Node* argument : PList<Node>(operation->args)) {
		if (argument == nullptr
			|| exprType(argument)
				!= catalog_argument_types[argument_index++]) return false;
	}
	return true;
}

/* PostgreSQL does not propagate typmods through ordinary FuncExpr results,
 * even when the exact catalog function is sequence-type preserving.  Admit an
 * erased descriptor only after recursively proving one identical concrete
 * typmod at every sequence-valued leaf.  Non-sequence literal/array operands
 * are neutral only for the exact registered concat overloads. */
[[nodiscard]] static std::optional<PerRowSequenceTypmodProof>
per_row_sequence_typmod_proof(
		Node* expression, BioseqStubOids const& oids) {
	check_stack_depth();
	if (expression == nullptr
		|| exprType(expression) != oids.bioseq_seq_type_oid) {
		return std::nullopt;
	}
	const int32 descriptor_typmod = exprTypmod(expression);
	auto finish = [descriptor_typmod](const int32 proven_typmod)
			-> std::optional<PerRowSequenceTypmodProof> {
		if (!batch_join_typmod_is_supported(proven_typmod)
			|| (descriptor_typmod != -1
				&& descriptor_typmod != proven_typmod)) {
			return std::nullopt;
		}
		return PerRowSequenceTypmodProof{
			.typmod = proven_typmod,
			.descriptor_erased = descriptor_typmod == -1};
	};
	if (IsA(expression, RelabelType)) {
		auto* relabel = reinterpret_cast<RelabelType*>(expression);
		if (relabel->resulttype != oids.bioseq_seq_type_oid
			|| relabel->arg == nullptr) return std::nullopt;
		auto child = per_row_sequence_typmod_proof(
			reinterpret_cast<Node*>(relabel->arg), oids);
		return child.has_value() ? finish(child->typmod) : std::nullopt;
	}
	const auto operation = slice_project_node_opcode(expression, oids);
	if (!operation.has_value()) {
		return batch_join_typmod_is_supported(descriptor_typmod)
			? finish(descriptor_typmod) : std::nullopt;
	}
	if (*operation == SliceProjectOpcode::slice) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(expression);
		if (subscript->refcontainertype != oids.bioseq_seq_type_oid
			|| subscript->refrestype != oids.bioseq_seq_type_oid
			|| subscript->reflowerindexpr == NIL
			|| subscript->refexpr == nullptr) return std::nullopt;
		auto source = per_row_sequence_typmod_proof(
			reinterpret_cast<Node*>(subscript->refexpr), oids);
		return source.has_value() ? finish(source->typmod) : std::nullopt;
	}
	if (*operation == SliceProjectOpcode::reverse
		|| *operation == SliceProjectOpcode::reverse_complement) {
		FuncExpr* function = pg_node_try_as<FuncExpr>(expression);
		if (function == nullptr
			|| function->funcresulttype != oids.bioseq_seq_type_oid
			|| !per_row_function_signature_is_exact(function)) {
			return std::nullopt;
		}
		if (list_length(function->args) != 1) return std::nullopt;
		auto source = per_row_sequence_typmod_proof(
			reinterpret_cast<Node*>(linitial(function->args)), oids);
		return source.has_value() ? finish(source->typmod) : std::nullopt;
	}
	if (*operation != SliceProjectOpcode::concat) return std::nullopt;
	List* arguments = NIL;
	if (FuncExpr* function = pg_node_try_as<FuncExpr>(expression)) {
		if (function->funcresulttype != oids.bioseq_seq_type_oid
			|| !slice_project_concat_oid(function->funcid, oids)
			|| !per_row_function_signature_is_exact(function)) {
			return std::nullopt;
		}
		arguments = function->args;
	} else if (OpExpr* operator_expression =
			pg_node_try_as<OpExpr>(expression)) {
		if (operator_expression->opresulttype != oids.bioseq_seq_type_oid
			|| !slice_project_concat_oid(
				operator_expression->opfuncid, oids)
			|| list_length(operator_expression->args) != 2
			|| !per_row_operator_signature_is_exact(operator_expression)) {
			return std::nullopt;
		}
		arguments = operator_expression->args;
	} else {
		return std::nullopt;
	}
	std::optional<int32> common_typmod;
	for (Node* argument : PList<Node>(arguments)) {
		if (exprType(argument) != oids.bioseq_seq_type_oid) continue;
		auto child = per_row_sequence_typmod_proof(argument, oids);
		if (!child.has_value()
			|| (common_typmod.has_value()
				&& *common_typmod != child->typmod)) return std::nullopt;
		common_typmod = child->typmod;
	}
	return common_typmod.has_value()
		? finish(*common_typmod) : std::nullopt;
}

/* Reject a Gather hidden below the common unary planner wrappers.  Looking
 * only at cheapest_total_path->pathtype misses Projection/Material wrappers
 * and lets a parallel child enter an executor that owns one backend-local
 * query materialization. */
[[nodiscard]] static bool batch_join_path_contains_parallel_execution(
		const Path* path) noexcept {
	if (path == nullptr) {
		return false;
	}
	if (path->pathtype == T_Gather || path->pathtype == T_GatherMerge
		|| path->parallel_aware || path->parallel_workers > 0) {
		return true;
	}
	switch (path->pathtype) {
		case T_Result:
			return batch_join_path_contains_parallel_execution(
				reinterpret_cast<const ProjectionPath*>(path)->subpath);
		case T_Material:
			return batch_join_path_contains_parallel_execution(
				reinterpret_cast<const MaterialPath*>(path)->subpath);
		case T_Memoize:
			return batch_join_path_contains_parallel_execution(
				reinterpret_cast<const MemoizePath*>(path)->subpath);
		case T_Sort:
			return batch_join_path_contains_parallel_execution(
				reinterpret_cast<const SortPath*>(path)->subpath);
	case T_IncrementalSort:
			return batch_join_path_contains_parallel_execution(
				reinterpret_cast<const IncrementalSortPath*>(path)->spath.subpath);
		case T_NestLoop:
		case T_MergeJoin:
		case T_HashJoin: {
			auto const* join = reinterpret_cast<JoinPath const*>(path);
			return batch_join_path_contains_parallel_execution(
					join->outerjoinpath)
				|| batch_join_path_contains_parallel_execution(
					join->innerjoinpath);
		}
		case T_CustomScan: {
			auto const* custom = reinterpret_cast<CustomPath const*>(path);
			for (Path* child : PList<Path>(custom->custom_paths)) {
				if (batch_join_path_contains_parallel_execution(child)) {
					return true;
				}
			}
			return false;
		}
		case T_Append: {
			auto const* append = reinterpret_cast<AppendPath const*>(path);
			for (Path* child : PList<Path>(append->subpaths)) {
				if (batch_join_path_contains_parallel_execution(child)) {
					return true;
				}
			}
			return false;
		}
		case T_MergeAppend: {
			auto const* append = reinterpret_cast<MergeAppendPath const*>(path);
			for (Path* child : PList<Path>(append->subpaths)) {
				if (batch_join_path_contains_parallel_execution(child)) {
					return true;
				}
			}
			return false;
		}
		default:
			return false;
	}
}

struct BatchJoinBioseqPathCandidate {
	CustomPath* scan = nullptr;
	Path* cost_owner = nullptr;
	const PathTarget* locator_target = nullptr;
};

[[nodiscard]] static bool batch_join_expression_has_match_helper(
	Node* expression, const BioseqStubOids& oids);

[[nodiscard]] static bool path_target_has_equal_expression(
		const PathTarget* target, const Node* expression) noexcept {
	if (target == nullptr || expression == nullptr) {
		return false;
	}
	for (Node* existing : PList<Node>(target->exprs)) {
		if (equal(existing, expression)) {
			return true;
		}
	}
	return false;
}

[[nodiscard]] static FuncExpr* batch_join_exact_target_helper(
		Node* expression,
		const Index target_relid) noexcept {
	FuncExpr* helper = pg_node_try_as<FuncExpr>(expression);
	if (!bioseq_is_concrete_rte_varno(target_relid)
		|| helper == nullptr
		|| !is_bioseq_projection_funcid(
			helper->funcid, get_cached_stub_oids())
		|| helper->funcretset
		|| OidIsValid(helper->funcvariadic)
		|| get_func_rettype(helper->funcid) != helper->funcresulttype
		|| list_length(helper->args) != 1) {
		return nullptr;
	}
	Var* argument = pg_node_try_as<Var>(
		reinterpret_cast<Node*>(linitial(helper->args)));
	return argument != nullptr
		&& argument->varno == target_relid
		&& argument->varattno > 0
		&& argument->varlevelsup == 0
		&& bms_is_empty(argument->varnullingrels)
		? helper : nullptr;
}

/* Decode only the catalog/arity/type contract of a match-result helper.  Its
 * argument binding is resolved separately against the selected owner recipe
 * after standard_planner has assigned final plan_node_id values. */
[[nodiscard]] static FuncExpr* batch_join_well_formed_match_helper(
		Node* expression,
		const BioseqStubOids& oids) noexcept {
	FuncExpr* helper = pg_node_try_as<FuncExpr>(expression);
	if (helper == nullptr
		|| !is_bioseq_projection_funcid(helper->funcid, oids)
		|| helper->funcretset || OidIsValid(helper->funcvariadic)
		|| get_func_rettype(helper->funcid) != helper->funcresulttype
		|| list_length(helper->args) != 1) {
		return nullptr;
	}
	return helper;
}

[[nodiscard]] static Node* batch_join_match_helper_argument(
		FuncExpr* helper) noexcept {
	return helper == nullptr || list_length(helper->args) != 1
		? nullptr : reinterpret_cast<Node*>(linitial(helper->args));
}

[[nodiscard]] static List* canonical_match_base_lineage(
	Node* target_recipe, const BioseqStubOids& oids);

[[nodiscard]] static List* make_match_owner_descriptor(
	Node* target_recipe, Index legacy_target_relid,
	const BioseqStubOids& oids);

[[nodiscard]] static bool batch_join_match_helper_names_recipe(
		FuncExpr* helper, Node* target_recipe) noexcept {
	Node* argument = batch_join_match_helper_argument(helper);
	return argument != nullptr && target_recipe != nullptr
		&& equal(argument, target_recipe);
}

[[nodiscard]] static bool batch_join_match_helper_names_base_lineage(
		FuncExpr* helper, Node* target_recipe,
		const BioseqStubOids& oids) {
	Var* argument = pg_node_try_as<Var>(
		batch_join_match_helper_argument(helper));
	if (argument == nullptr || target_recipe == nullptr
		|| !bioseq_is_concrete_rte_varno(argument->varno)
		|| argument->varattno <= 0 || argument->varlevelsup != 0
		|| !bms_is_empty(argument->varnullingrels)) return false;
	for (Var* base : PList<Var>(
			canonical_match_base_lineage(target_recipe, oids))) {
		if (base == nullptr) continue;
		if (argument->vartype == oids.bioseq_seq_type_oid) {
			if (equal(argument, base)) return true;
		} else if (argument->varno == base->varno
			&& argument->varlevelsup == base->varlevelsup) {
			return true;
		}
	}
	return false;
}

/* Generic PHV shape used by transformed exact-recipe helpers.  Unlike the
 * legacy helper decoder below, the PHV may cover more than one relation when
 * the target recipe is a concat.  The final owner resolver validates the
 * canonical argument and lineage before any executor sees the site. */
[[nodiscard]] static FuncExpr* batch_join_match_helper_phv_function(
		const PlaceHolderVar* placeholder,
		const BioseqStubOids& oids) noexcept {
	if (placeholder == nullptr || placeholder->phid == 0
		|| placeholder->phlevelsup != 0
		|| !bms_is_empty(placeholder->phnullingrels)
		|| bms_is_empty(placeholder->phrels)) {
		return nullptr;
	}
	return batch_join_well_formed_match_helper(
		reinterpret_cast<Node*>(placeholder->phexpr), oids);
}

/* Exact shape emitted by try_wrap_in_placeholder() for a direct helper call.
 * Do not accept a generic PHV merely because a helper occurs somewhere below
 * it: its evaluation level/nulling semantics may belong to unrelated SQL. */
[[nodiscard]] static FuncExpr* batch_join_exact_helper_phv_function(
		const PlaceHolderVar* placeholder,
		const Index target_relid) noexcept {
	if (placeholder == nullptr
		|| !bioseq_is_concrete_rte_varno(target_relid)
		|| placeholder->phid == 0
		|| placeholder->phlevelsup != 0
		|| !bms_is_empty(placeholder->phnullingrels)
		|| bms_num_members(placeholder->phrels) != 1
		|| !bms_is_member(static_cast<int>(target_relid), placeholder->phrels)) {
		return nullptr;
	}
	return batch_join_exact_target_helper(
		reinterpret_cast<Node*>(placeholder->phexpr), target_relid);
}

[[nodiscard]] static bool batch_join_is_exact_helper_phv(
		const PlaceHolderVar* placeholder,
		const Index target_relid) noexcept {
	return batch_join_exact_helper_phv_function(
		placeholder, target_relid) != nullptr;
}

struct BatchJoinProjectionDeltaProof {
	const PathTarget* child_target = nullptr;
	Index target_relid = 0;
	bool saw_exact_helper_phv = false;
	bool invalid = false;
};

struct batch_join_projection_delta_visitor {
	[[nodiscard]] pg_walk_step operator()(
		pg_expression_walk_cursor,
		pg_node_view node,
		BatchJoinProjectionDeltaProof& proof) const noexcept {
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			if (!batch_join_is_exact_helper_phv(
					placeholder, proof.target_relid)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			proof.saw_exact_helper_phv = true;
			return pg_walk_step::skip_subtree;
		}
		if (Var* var = node.try_as<Var>()) {
			if (!path_target_has_equal_expression(
					proof.child_target, reinterpret_cast<Node*>(var))) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
		}
		return pg_walk_step::descend;
	}
};

/* Prove that the complete wrapper-only expression can be evaluated by the
 * BatchJoin parent without changing semantics: it is nonvolatile, every Var
 * is already produced by the child, every PHV is the exact helper-support
 * shape, and at least one such helper PHV explains the wrapper delta. */
[[nodiscard]] static bool batch_join_projection_delta_is_parent_safe(
		Node* expression,
		const PathTarget* child_target,
		const Index target_relid) noexcept {
	if (expression == nullptr || child_target == nullptr
		|| contain_volatile_functions(expression)) {
		return false;
	}
	BatchJoinProjectionDeltaProof proof{
		child_target, target_relid, false, false};
	batch_join_projection_delta_visitor visitor;
	pg_walk_expression_including_root(expression, proof, visitor);
	return !proof.invalid && proof.saw_exact_helper_phv;
}

/* A wrapper may also expose an ordinary target attribute needed above the
 * join (for example t.pk).  Carrying that base Var through the locator child
 * is exact; carrying the sequence datum, a whole row, a system attribute, a
 * nulled outer-join Var, or an expression assembled at this level is not. */
[[nodiscard]] static bool batch_join_is_safe_plain_target_var(
		Node* expression,
		const Index target_relid,
		const AttrNumber target_seq_attno) noexcept {
	Var* var = pg_node_try_as<Var>(expression);
	return var != nullptr
		&& var->varno == target_relid
		&& var->varattno > 0
		&& var->varattno != target_seq_attno
		&& var->varlevelsup == 0
		&& bms_is_empty(var->varnullingrels);
}

/* A helper support function can add a ProjectionPath at the base relation.
 * BioseqBatchJoin may look through it only when every wrapper-only expression
 * is either an exact helper expression evaluated by the parent or one plain,
 * non-sequence target Var copied into the locator child. Any other expression
 * is a real evaluation boundary and disqualifies this candidate. */
[[nodiscard]] static bool batch_join_projection_is_parent_safe(
		const ProjectionPath* projection,
		const AttrNumber target_seq_attno) noexcept {
	if (projection == nullptr || projection->subpath == nullptr
		|| projection->path.pathtype != T_Result
		|| projection->path.parent != projection->subpath->parent
		|| projection->path.parent == nullptr
		|| projection->path.parent->reloptkind != RELOPT_BASEREL
		|| projection->path.parent->relid == 0
		|| projection->path.param_info != nullptr
		|| projection->subpath->param_info != nullptr
		|| !equal(projection->path.pathkeys, projection->subpath->pathkeys)
		|| projection->path.pathtarget == nullptr
		|| projection->subpath->pathtarget == nullptr) {
		return false;
	}
	bool saw_safe_delta = false;
	for (Node* expression : PList<Node>(projection->path.pathtarget->exprs)) {
		if (path_target_has_equal_expression(
				projection->subpath->pathtarget, expression)) {
			continue;
		}
		if (batch_join_is_safe_plain_target_var(
				expression,
				projection->path.parent->relid,
				target_seq_attno)) {
			saw_safe_delta = true;
			continue;
		}
		if (!batch_join_projection_delta_is_parent_safe(
				expression,
				projection->subpath->pathtarget,
				projection->path.parent->relid)) {
			return false;
		}
		saw_safe_delta = true;
	}
	return saw_safe_delta;
}

[[nodiscard]] static BatchJoinBioseqPathCandidate
find_unparameterized_bioseq_custom_path(
		RelOptInfo* rel,
		const AttrNumber target_seq_attno) noexcept {
	BatchJoinBioseqPathCandidate best{};
	for (Path* path : PList<Path>(rel->pathlist)) {
		if (path == nullptr || path->param_info != nullptr) {
			continue;
		}
		Path* cost_owner = path;
		const PathTarget* locator_target = path->pathtarget;
		/* Planner support can expose safe base attributes and wraps match-result helpers in
		 * PlaceHolderVars at their originating base relation.  PostgreSQL can
		 * consequently expose the otherwise eligible BioseqScan as the child
		 * of a projection path.  The projection must not run in the locator
		 * child: BioseqBatchJoin rewrites those helpers to parent-owned result
		 * placeholders after the MatchResult exists.  Look through exactly
		 * that narrowly proven parent-safe wrapper and retain the underlying scan. */
		if (IsA(path, ProjectionPath)) {
			auto* projection = reinterpret_cast<ProjectionPath*>(path);
			if (!batch_join_projection_is_parent_safe(
					projection, target_seq_attno)
				|| batch_join_path_contains_parallel_execution(&projection->path)) {
				continue;
			}
			locator_target = projection->path.pathtarget;
			path = projection->subpath;
		}
		if (path == nullptr || path->pathtype != T_CustomScan
			|| path->param_info != nullptr
			|| batch_join_path_contains_parallel_execution(path)) {
			continue;
		}
		auto* custom = reinterpret_cast<CustomPath*>(path);
		if (custom->methods != &BioseqColumnScanPathMethods) {
			continue;
		}
		if (best.scan == nullptr
			|| compare_path_costs(
				cost_owner, best.cost_owner, TOTAL_COST) < 0) {
			best = BatchJoinBioseqPathCandidate{
				custom, cost_owner, locator_target};
		}
	}
	return best;
}

/*
 * Integration-only proof seam for the exact production eligibility guard.
 * SQL cannot reliably force an unrelated expression into a base-relation
 * ProjectionPath: PostgreSQL will normally retain it in an upper projection.
 * Construct the dangerous planner shapes directly and pass them through
 * find_unparameterized_bioseq_custom_path(), which is the production entry
 * point used by BioseqBatchJoinSetJoinPathlistHook().
 */
struct BatchJoinProjectionGuardFixture {
	RelOptInfo* rel = nullptr;
	CustomPath* scan = nullptr;
	ProjectionPath* projection = nullptr;
};

[[nodiscard]] static PlaceHolderVar*
make_batch_join_projection_guard_phv(
		const Oid helper_oid,
		const Oid result_type,
		const Index relid,
		const Index phid) {
	auto* argument = makeVar(
		relid, 1, INT4OID, -1, InvalidOid, 0);
	auto* helper = makeFuncExpr(
		helper_oid,
		result_type,
		list_make1(argument),
		InvalidOid,
		InvalidOid,
		COERCE_EXPLICIT_CALL);
	auto* placeholder = makeNode(PlaceHolderVar);
	placeholder->phexpr = reinterpret_cast<Expr*>(helper);
	placeholder->phrels = bms_make_singleton(static_cast<int>(relid));
	placeholder->phnullingrels = nullptr;
	placeholder->phid = phid;
	placeholder->phlevelsup = 0;
	return placeholder;
}

[[nodiscard]] static BatchJoinProjectionGuardFixture
make_batch_join_projection_guard_fixture(
		const Index relid,
		List* wrapper_delta,
		const Cost wrapper_startup,
		const Cost wrapper_total,
		const Cardinality wrapper_rows) {
	auto* rel = makeNode(RelOptInfo);
	rel->reloptkind = RELOPT_BASEREL;
	rel->relid = relid;

	auto* child_target = create_empty_pathtarget();
	add_column_to_pathtarget(
		child_target,
		reinterpret_cast<Expr*>(
			makeVar(relid, 1, INT4OID, -1, InvalidOid, 0)),
		0);
	auto* wrapper_target = copy_pathtarget(child_target);
	for (Node* expression : PList<Node>(wrapper_delta)) {
		add_column_to_pathtarget(
			wrapper_target,
			reinterpret_cast<Expr*>(expression),
			0);
	}

	auto* scan = makeNode(CustomPath);
	scan->path.pathtype = T_CustomScan;
	scan->path.parent = rel;
	scan->path.pathtarget = child_target;
	scan->path.param_info = nullptr;
	scan->path.parallel_aware = false;
	scan->path.parallel_safe = false;
	scan->path.parallel_workers = 0;
	scan->path.rows = wrapper_rows;
	scan->path.startup_cost = 1.0;
	scan->path.total_cost = 2.0;
	scan->path.pathkeys = NIL;
	scan->methods = &BioseqColumnScanPathMethods;

	auto* projection = makeNode(ProjectionPath);
	projection->path.pathtype = T_Result;
	projection->path.parent = rel;
	projection->path.pathtarget = wrapper_target;
	projection->path.param_info = nullptr;
	projection->path.parallel_aware = false;
	projection->path.parallel_safe = false;
	projection->path.parallel_workers = 0;
	projection->path.rows = wrapper_rows;
	projection->path.startup_cost = wrapper_startup;
	projection->path.total_cost = wrapper_total;
	projection->path.pathkeys = NIL;
	projection->subpath = &scan->path;
	projection->dummypp = false;
	rel->pathlist = list_make1(projection);
	return BatchJoinProjectionGuardFixture{rel, scan, projection};
}

export namespace bioseq::table::sql_routines {

[[bioseq_sql::function({
	.schema = bioseq::sql::fixed_schema<"bioseq_internal">,
	.create = bioseq::sql::create_mode::or_replace,
	.volatility = bioseq::sql::volatility::volatile_,
	.parallel = bioseq::sql::parallel_safety::unsafe,
})]]
[[bioseq_sql::revoke({
	.privileges = bioseq::sql::privileges::all,
	.from = bioseq::sql::public_role,
})]]
/** @brief Reports BatchJoin base ProjectionPath eligibility and wrapper-cost ownership decisions. */
bioseq::pg_utils::named_out<
	bioseq::table::batch_join_projection_guard_probe_row>
batch_join_projection_guard_probe() {

	constexpr Index target_relid = 1;
	const BioseqStubOids& oids = get_cached_stub_oids();
	auto* exact_helper = make_batch_join_projection_guard_phv(
		oids.score_oid, INT4OID, target_relid, 1);
	const BatchJoinProjectionGuardFixture exact =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(exact_helper),
			13.0,
			37.0,
			5.0);
	const BatchJoinBioseqPathCandidate exact_candidate =
		find_unparameterized_bioseq_custom_path(exact.rel, 2);
	const bool accepts_exact_helper = exact_candidate.scan == exact.scan;
	const bool preserves_wrapper_cost_owner =
		exact_candidate.cost_owner == &exact.projection->path
		&& exact_candidate.cost_owner->startup_cost == 13.0
		&& exact_candidate.cost_owner->total_cost == 37.0
		&& exact_candidate.cost_owner->rows == 5.0;

	auto* unrelated_placeholder = makeNode(PlaceHolderVar);
	unrelated_placeholder->phexpr = reinterpret_cast<Expr*>(
		makeVar(target_relid, 1, INT4OID, -1, InvalidOid, 0));
	unrelated_placeholder->phrels = bms_make_singleton(
		static_cast<int>(target_relid));
	unrelated_placeholder->phnullingrels = nullptr;
	unrelated_placeholder->phid = 2;
	unrelated_placeholder->phlevelsup = 0;
	const BatchJoinProjectionGuardFixture unrelated =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make2(
				make_batch_join_projection_guard_phv(
					oids.score_oid, INT4OID, target_relid, 3),
				unrelated_placeholder),
			13.0,
			37.0,
			5.0);
	const bool rejects_unrelated_phv =
		find_unparameterized_bioseq_custom_path(unrelated.rel, 2).scan == nullptr;

	const Oid nextval_oid = DatumGetObjectId(DirectFunctionCall1(
		regprocedurein, CStringGetDatum("pg_catalog.nextval(regclass)")));
	auto* nextval = makeFuncExpr(
		nextval_oid,
		INT8OID,
		list_make1(makeConst(
			REGCLASSOID,
			-1,
			InvalidOid,
			static_cast<int16>(sizeof(Oid)),
			ObjectIdGetDatum(InvalidOid),
			false,
			true)),
		InvalidOid,
		InvalidOid,
		COERCE_EXPLICIT_CALL);
	auto* volatile_mixed = makeNode(CoalesceExpr);
	volatile_mixed->coalescetype = INT8OID;
	volatile_mixed->coalescecollid = InvalidOid;
	volatile_mixed->args = list_make2(
		make_batch_join_projection_guard_phv(
			oids.query_len_oid, INT8OID, target_relid, 4),
		nextval);
	volatile_mixed->location = -1;
	const BatchJoinProjectionGuardFixture volatile_fixture =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(volatile_mixed),
			13.0,
			37.0,
			5.0);
	const bool rejects_volatile_mixed_expression =
		find_unparameterized_bioseq_custom_path(volatile_fixture.rel, 2).scan
			== nullptr;

	const BatchJoinProjectionGuardFixture plain_target_var =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(makeVar(
				target_relid, 2, INT4OID, -1, InvalidOid, 0)),
			13.0,
			37.0,
			5.0);
	const BatchJoinBioseqPathCandidate plain_candidate =
		find_unparameterized_bioseq_custom_path(
			plain_target_var.rel, /*target_seq_attno=*/3);
	const bool accepts_plain_target_var =
		plain_candidate.scan == plain_target_var.scan
		&& plain_candidate.locator_target
			== plain_target_var.projection->path.pathtarget;

	const BatchJoinProjectionGuardFixture plain_target_sequence_var =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(makeVar(
				target_relid, 3, INT4OID, -1, InvalidOid, 0)),
			13.0,
			37.0,
			5.0);
	const bool rejects_plain_target_sequence_var =
		find_unparameterized_bioseq_custom_path(
			plain_target_sequence_var.rel, /*target_seq_attno=*/3).scan
			== nullptr;

	const BatchJoinProjectionGuardFixture whole_row_var =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(makeVar(
				target_relid, InvalidAttrNumber, RECORDOID,
				-1, InvalidOid, 0)),
			13.0,
			37.0,
			5.0);
	const bool rejects_whole_row_var =
		find_unparameterized_bioseq_custom_path(
			whole_row_var.rel, /*target_seq_attno=*/3).scan == nullptr;

	const BatchJoinProjectionGuardFixture system_var =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(makeVar(
				target_relid, SelfItemPointerAttributeNumber, TIDOID,
				-1, InvalidOid, 0)),
			13.0,
			37.0,
			5.0);
	const bool rejects_system_var =
		find_unparameterized_bioseq_custom_path(
			system_var.rel, /*target_seq_attno=*/3).scan == nullptr;

	Var* nulled_var = makeVar(
		target_relid, 2, INT4OID, -1, InvalidOid, 0);
	nulled_var->varnullingrels = bms_make_singleton(
		static_cast<int>(target_relid));
	const BatchJoinProjectionGuardFixture nulling_var =
		make_batch_join_projection_guard_fixture(
			target_relid,
			list_make1(nulled_var),
			13.0,
			37.0,
			5.0);
	const bool rejects_nulling_var =
		find_unparameterized_bioseq_custom_path(
			nulling_var.rel, /*target_seq_attno=*/3).scan == nullptr;

	return bioseq::pg_utils::named_out{
		bioseq::table::batch_join_projection_guard_probe_row{
			.accepts_exact_helper = accepts_exact_helper,
			.rejects_unrelated_phv = rejects_unrelated_phv,
			.rejects_volatile_mixed_expression =
				rejects_volatile_mixed_expression,
			.preserves_wrapper_cost_owner =
				preserves_wrapper_cost_owner,
			.accepts_plain_target_var = accepts_plain_target_var,
			.rejects_plain_target_sequence_var =
				rejects_plain_target_sequence_var,
			.rejects_whole_row_var = rejects_whole_row_var,
			.rejects_system_var = rejects_system_var,
			.rejects_nulling_var = rejects_nulling_var,
		}};
}

}  // namespace bioseq::table::sql_routines

[[nodiscard]] static bool path_target_contains_expression(
		const PathTarget* target, const Expr* expression) noexcept {
	if (target == nullptr || expression == nullptr) {
		return false;
	}
	for (Node* existing : PList<Node>(target->exprs)) {
		if (equal(existing, expression)) {
			return true;
		}
	}
	return false;
}

struct BatchJoinUnderlyingTargetVarCollector {
	PathTarget* destination = nullptr;
	Index target_relid = 0;
	AttrNumber target_seq_attno = InvalidAttrNumber;
	bool invalid = false;
};

struct batch_join_underlying_target_var_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor,
			pg_node_view node,
			BatchJoinUnderlyingTargetVarCollector& collector) const {
		Var* var = node.try_as<Var>();
		if (var == nullptr) {
			return pg_walk_step::descend;
		}
		if (var->varno != collector.target_relid) {
			return pg_walk_step::skip_subtree;
		}
		const bool exact_sequence_var =
			var->varattno == collector.target_seq_attno
			&& var->varattno > 0
			&& var->varlevelsup == 0
			&& bms_is_empty(var->varnullingrels);
		if (!exact_sequence_var
			&& !batch_join_is_safe_plain_target_var(
				reinterpret_cast<Node*>(var),
				collector.target_relid,
				collector.target_seq_attno)) {
			collector.invalid = true;
			return pg_walk_step::stop;
		}
		/* The sequence Var is installed explicitly below.  Preserve every other
		 * safe target Var, including a helper's load-bearing argument (normally
		 * t.pk) hidden below a PlaceHolderVar/compound wrapper.  Skipping the
		 * whole wrapper because it contains a bioseq helper must not erase that
		 * base-column dependency from the locator child and combined scan tlist. */
		if (!exact_sequence_var
			&& collector.destination != nullptr
			&& !path_target_contains_expression(
				collector.destination,
				reinterpret_cast<Expr*>(var))) {
			add_column_to_pathtarget(
				collector.destination,
				reinterpret_cast<Expr*>(copyObject(var)), 0);
		}
		return pg_walk_step::skip_subtree;
	}
};

[[nodiscard]] static bool batch_join_append_underlying_target_vars(
		PathTarget* destination,
		const PathTarget* source,
		const Index target_relid,
		const AttrNumber target_seq_attno) {
	if (destination == nullptr || source == nullptr
		|| !bioseq_is_concrete_rte_varno(target_relid)
		|| target_seq_attno <= 0) {
		return false;
	}
	BatchJoinUnderlyingTargetVarCollector collector{
		destination, target_relid, target_seq_attno, false};
	batch_join_underlying_target_var_visitor visitor;
	for (Node* expression : PList<Node>(source->exprs)) {
		if (expression == nullptr) {
			continue;
		}
		pg_walk_expression_including_root(expression, collector, visitor);
		if (collector.invalid) {
			return false;
		}
	}
	return true;
}

static int next_batch_join_plan_token = 1;

[[nodiscard]] static Const* make_batch_join_cost_const(const Cost value) {
	if (!std::isfinite(value)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin planner cost is not finite")));
	}
	return makeConst(
		FLOAT8OID,
		-1,
		InvalidOid,
		static_cast<int16>(sizeof(float8)),
		Float8GetDatum(value),
		false,
		FLOAT8PASSBYVAL);
}

[[nodiscard]] static Cost batch_join_cost_from_node(
		Node* node,
		const char* field) {
	Const* value = pg_node_try_as<Const>(node);
	if (value == nullptr || value->consttype != FLOAT8OID
		|| value->constisnull
		|| value->constlen != static_cast<int16>(sizeof(float8))
		|| value->constbyval != FLOAT8PASSBYVAL) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin cost ABI is invalid"),
			 errdetail("field=%s", field)));
	}
	const Cost decoded = DatumGetFloat8(value->constvalue);
	if (!std::isfinite(decoded)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin cost ABI is not finite"),
			 errdetail("field=%s", field)));
	}
	return decoded;
}

struct PerRowOperandSourceProof {
	RelOptInfo* joinrel = nullptr;
	List* sequence_vars = NIL;
	bool invalid = false;
};

struct per_row_operand_source_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			PerRowOperandSourceProof& proof) const {
		if (node.try_as<PlaceHolderVar>() != nullptr) {
			/* Moving an operand PHV to the post-join recipe can change its
			 * evaluation/nulling frontier.  No sequence helper requires that
			 * representation, so decline instead of approximating semantics. */
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		Var* var = node.try_as<Var>();
		if (var == nullptr) return pg_walk_step::descend;
		if (proof.joinrel == nullptr
			|| !bioseq_is_concrete_rte_varno(var->varno)
			|| var->varattno <= 0 || var->varlevelsup != 0
			|| !bms_is_empty(var->varnullingrels)
			|| !bms_is_member(static_cast<int>(var->varno),
				proof.joinrel->relids)) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (var->vartype == get_cached_stub_oids().bioseq_seq_type_oid) {
			bool seen = false;
			for (Node* existing : PList<Node>(proof.sequence_vars)) {
				if (equal(existing, var)) {
					seen = true;
					break;
				}
			}
			if (!seen) proof.sequence_vars = lappend(
				proof.sequence_vars, var);
		}
		return pg_walk_step::skip_subtree;
	}
};

struct PerRowOutputSemanticProof {
	Index target_relid = 0;
	Relids join_relids = nullptr;
	Node* target_recipe = nullptr;
	bool invalid = false;
};

[[nodiscard]] static bool per_row_is_exact_row_identity_var(
		const Var* var) noexcept {
	if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
		|| var->varlevelsup != 0
		|| !bms_is_empty(var->varnullingrels)) return false;
	return (var->varattno == SelfItemPointerAttributeNumber
			&& var->vartype == TIDOID && var->vartypmod == -1
			&& !OidIsValid(var->varcollid))
		|| (var->varattno == TableOidAttributeNumber
			&& var->vartype == OIDOID && var->vartypmod == -1
			&& !OidIsValid(var->varcollid));
}

struct per_row_output_semantic_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			PerRowOutputSemanticProof& proof) const {
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			/* The exact helper PHV is deliberately evaluated by the BatchJoin
			 * owner after MatchResult production.  At an intermediate joinrel the
			 * reltarget can also carry a whole helper PHV for a transformed owner
			 * that will be constructed at a higher join frontier.  Admit that exact
			 * sequence-valued identity here; the higher-owner COW normalization
			 * removes it from every descendant target before PlanCustomPath.  Every
			 * generic PHV retains a planner-selected frontier which this
			 * transformation cannot move. */
			FuncExpr* helper = batch_join_match_helper_phv_function(
				placeholder, get_cached_stub_oids());
			Node* argument = batch_join_match_helper_argument(helper);
			const bool possible_higher_owner = helper != nullptr
				&& argument != nullptr
				&& exprType(argument)
					== get_cached_stub_oids().bioseq_seq_type_oid;
			if (helper == nullptr
				|| (!batch_join_match_helper_names_recipe(
					helper, proof.target_recipe)
					&& !batch_join_match_helper_names_base_lineage(
						helper, proof.target_recipe,
						get_cached_stub_oids())
					&& !possible_higher_owner)) {
				proof.invalid = true;
			}
			return proof.invalid
				? pg_walk_step::stop : pg_walk_step::skip_subtree;
		}
		if (Var* var = node.try_as<Var>()) {
			/* UPDATE ... FROM EPQ carries exact ctid/tableoid row markers for
			 * non-target join inputs as well as the target.  They are ordinary
			 * inner-join passthrough values, not arbitrary system attributes. */
			if (per_row_is_exact_row_identity_var(var)
				&& bms_is_member(
					static_cast<int>(var->varno), proof.join_relids)) {
				return pg_walk_step::skip_subtree;
			}
			if (!bioseq_is_concrete_rte_varno(var->varno)
				|| var->varattno <= 0
				|| var->varlevelsup != 0
				|| !bms_is_empty(var->varnullingrels)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			return pg_walk_step::skip_subtree;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool per_row_output_semantics_are_supported(
		PathTarget* target, const Index target_relid,
		Relids join_relids, Node* target_recipe) {
	if (target == nullptr || !bioseq_is_concrete_rte_varno(target_relid)
		|| join_relids == nullptr || target_recipe == nullptr) {
		return false;
	}
	/* Volatile final-output expressions stay in the owner PathTarget and are
	 * evaluated once by core ProjectionInfo for each emitted match.  This proof
	 * governs only nodes that would otherwise lose a planner frontier. */
	PerRowOutputSemanticProof proof{
		target_relid, join_relids, target_recipe, false};
	per_row_output_semantic_visitor visitor;
	for (Node* expression : PList<Node>(target->exprs)) {
		pg_walk_expression_including_root(expression, proof, visitor);
		if (proof.invalid) return false;
	}
	return true;
}

struct PerRowOwnerSupportProof {
	Index target_relid = 0;
	Relids join_relids = nullptr;
	const BioseqStubOids* oids = nullptr;
	Node* target_recipe = nullptr;
	List* passthrough_vars = NIL;
	List* helper_identities = NIL;
	/* Sequence-valued helpers which do not name this owner may still be exact
	 * outputs of one versioned descendant BatchJoin.  They remain candidates
	 * until each incumbent path proves that ownership structurally. */
	List* foreign_exact_helper_identities = NIL;
	List* helper_argument_vars = NIL;
	bool invalid = false;
};

static void per_row_append_unique_expression(List*& expressions, Node* node) {
	if (node == nullptr) return;
	for (Node* existing : PList<Node>(expressions)) {
		if (equal(existing, node)) return;
	}
	expressions = lappend(expressions, copyObject(node));
}

[[nodiscard]] static bool per_row_expression_list_contains(
		List* expressions, Node* node) noexcept {
	if (node == nullptr) return false;
	for (Node* existing : PList<Node>(expressions)) {
		if (existing != nullptr && equal(existing, node)) return true;
	}
	return false;
}

[[nodiscard]] static bool per_row_authoritative_sortgrouprefs(
	PlannerInfo* root, List* expressions, std::vector<Index>& results);

/* Keep the public CustomPath target exactly at PostgreSQL's authoritative
 * joinrel frontier.  Planner-only helper and passthrough columns are appended
 * by PlanCustomPath after core has finished applying scan/join targets.  This
 * avoids exposing a widened expr list to apply_scanjoin_target_to_paths(),
 * which can otherwise install the join target's shorter sortgroupref array. */
[[nodiscard]] static PathTarget* per_row_build_owner_target(
		PlannerInfo* root, PathTarget* original) {
	if (root == nullptr || original == nullptr) return nullptr;
	std::vector<Index> sortgrouprefs;
	if (!per_row_authoritative_sortgrouprefs(
			root, original->exprs, sortgrouprefs)) return nullptr;
	if (sortgrouprefs.size()
		!= static_cast<std::size_t>(list_length(original->exprs))) return nullptr;
	PathTarget* rebuilt = create_empty_pathtarget();
	rebuilt->exprs = static_cast<List*>(copyObject(original->exprs));
	const bool has_sortgroupref = std::any_of(
		sortgrouprefs.begin(), sortgrouprefs.end(),
		[](Index value) noexcept { return value != 0; });
	if (has_sortgroupref) {
		rebuilt->sortgrouprefs = static_cast<Index*>(palloc0(
			sortgrouprefs.size() * sizeof(Index)));
		for (std::size_t index = 0u; index < sortgrouprefs.size(); ++index) {
			rebuilt->sortgrouprefs[index] = sortgrouprefs[index];
		}
	}
	Assert(list_length(rebuilt->exprs) == list_length(original->exprs));
	return rebuilt;
}

/* Core's upper setrefs pass can descend a plain match-helper FuncExpr before
 * finalized MatchResult binding.  It then needs the raw Vars below the exact
 * transformed target recipe, plus valid legacy-lineage helper arguments.
 * These are Plan-only resjunk carriers; they must not widen the visible owner
 * PathTarget. */
[[nodiscard]] static bool per_row_collect_setrefs_carrier_vars(
		Node* target_recipe, List* helper_argument_vars,
		Relids join_relids, List*& carrier_vars) {
	carrier_vars = NIL;
	if (target_recipe == nullptr || join_relids == nullptr) return false;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* recipe_vars = pull_var_clause(target_recipe, pull_flags);
	auto append_valid = [join_relids, &carrier_vars](Node* node) -> bool {
		Var* var = pg_node_try_as<Var>(node);
		const bool row_identity = per_row_is_exact_row_identity_var(var);
		if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
			|| (var->varattno <= 0 && !row_identity)
			|| var->varlevelsup != 0
			|| !bms_is_empty(var->varnullingrels)
			|| !bms_is_member(
				static_cast<int>(var->varno), join_relids)) return false;
		per_row_append_unique_expression(carrier_vars, node);
		return true;
	};
	for (Node* recipe_var : PList<Node>(recipe_vars)) {
		if (!append_valid(recipe_var)) return false;
	}
	for (Node* helper_argument : PList<Node>(helper_argument_vars)) {
		if (!append_valid(helper_argument)) return false;
	}
	return carrier_vars != NIL;
}

/* Core can defer the SELECT/RETURNING projection until above the join and,
 * for a projection-capable CustomPath, overwrite plan.targetlist only after
 * PlanCustomPath has returned.  Collect the narrow support surface up front:
 * level-zero join Vars are passed through, while exact target-owned match
 * helpers are carried as whole descriptor identities.  Their proven single
 * target Var is collected separately for reconstructed scan-leaf and Plan-only
 * resjunk setrefs edges; it is never substituted for the final whole-helper
 * output. */
struct per_row_owner_support_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor,
			pg_node_view node,
		PerRowOwnerSupportProof& proof) const {
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			FuncExpr* helper = proof.oids == nullptr ? nullptr
				: batch_join_match_helper_phv_function(
					placeholder, *proof.oids);
			if (helper != nullptr) {
				const bool names_recipe =
					batch_join_match_helper_names_recipe(
						helper, proof.target_recipe);
				const bool names_lineage =
					batch_join_match_helper_names_base_lineage(
						helper, proof.target_recipe, *proof.oids);
				Node* argument = batch_join_match_helper_argument(helper);
				const bool possible_foreign_exact = !names_recipe
					&& !names_lineage && argument != nullptr
					&& exprType(argument)
						== proof.oids->bioseq_seq_type_oid;
				if (!names_recipe && !names_lineage
					&& !possible_foreign_exact) {
					proof.invalid = true;
					return pg_walk_step::stop;
				}
				/* PostgreSQL can spell the same helper site as its whole PHV in
				 * the join reltarget and as the underlying FuncExpr in an upper
				 * Sort/Result target.  Preserve both exact identities so setrefs
				 * can bind either spelling to a descriptor-only MatchResult site;
				 * never descend into the helper argument Var. */
				per_row_append_unique_expression(
					proof.helper_identities,
					reinterpret_cast<Node*>(placeholder));
				per_row_append_unique_expression(
					proof.helper_identities,
					reinterpret_cast<Node*>(helper));
				if (possible_foreign_exact) {
					per_row_append_unique_expression(
						proof.foreign_exact_helper_identities,
						reinterpret_cast<Node*>(placeholder));
					per_row_append_unique_expression(
						proof.foreign_exact_helper_identities,
						reinterpret_cast<Node*>(helper));
				}
				/* Core may retain a Result directly above the target BioseqScan
				 * while carrying the whole PHV to the final owner.  Preserve the
				 * exact single target-owned argument at that scan edge so setrefs
				 * can bind Result's support Var without executing the helper. */
				if (names_lineage) {
					per_row_append_unique_expression(
						proof.helper_argument_vars,
						batch_join_match_helper_argument(helper));
				}
				return pg_walk_step::skip_subtree;
			}
			if (proof.oids != nullptr
				&& batch_join_expression_has_match_helper(
					reinterpret_cast<Node*>(placeholder->phexpr),
					*proof.oids)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			/* A generic PHV owns its planner-selected evaluation frontier. */
			return pg_walk_step::skip_subtree;
		}
		if (FuncExpr* function = node.try_as<FuncExpr>();
			proof.oids != nullptr && function != nullptr
			&& is_bioseq_projection_funcid(function->funcid, *proof.oids)) {
			const bool names_recipe = batch_join_match_helper_names_recipe(
				function, proof.target_recipe);
			const bool legacy_lineage =
				batch_join_match_helper_names_base_lineage(
					function, proof.target_recipe, *proof.oids);
			Node* argument = batch_join_match_helper_argument(function);
			const bool possible_foreign_exact = !names_recipe
				&& !legacy_lineage && argument != nullptr
				&& exprType(argument) == proof.oids->bioseq_seq_type_oid;
			if (!names_recipe && !legacy_lineage
				&& !possible_foreign_exact) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			per_row_append_unique_expression(
				proof.helper_identities,
				reinterpret_cast<Node*>(function));
			if (possible_foreign_exact) {
				per_row_append_unique_expression(
					proof.foreign_exact_helper_identities,
					reinterpret_cast<Node*>(function));
			}
			if (legacy_lineage) {
				per_row_append_unique_expression(
					proof.helper_argument_vars,
					batch_join_match_helper_argument(function));
			}
			return pg_walk_step::skip_subtree;
		}
		if (Var* var = node.try_as<Var>()) {
			if (var->varlevelsup != 0) {
				return pg_walk_step::skip_subtree;
			}
			if (!bioseq_is_concrete_rte_varno(var->varno)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			if (!bms_is_member(
					static_cast<int>(var->varno), proof.join_relids)) {
				return pg_walk_step::skip_subtree;
			}
			const bool row_identity =
				per_row_is_exact_row_identity_var(var);
			if ((var->varattno <= 0 && !row_identity)
				|| !bms_is_empty(var->varnullingrels)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
			per_row_append_unique_expression(
				proof.passthrough_vars, reinterpret_cast<Node*>(var));
			return pg_walk_step::skip_subtree;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool per_row_collect_owner_support(
		PlannerInfo* root, RelOptInfo* joinrel,
		const Index target_relid, Node* target_recipe,
		PerRowOwnerSupportProof& proof) {
	if (root == nullptr || joinrel == nullptr
		|| !bioseq_is_concrete_rte_varno(target_relid)
		|| joinrel->relids == nullptr || target_recipe == nullptr) {
		return false;
	}
	proof.target_relid = target_relid;
	proof.join_relids = joinrel->relids;
	proof.oids = &get_cached_stub_oids();
	proof.target_recipe = target_recipe;
	per_row_owner_support_visitor visitor;
	for (TargetEntry* output : PList<TargetEntry>(root->processed_tlist)) {
		if (output == nullptr || output->expr == nullptr) continue;
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(output->expr), proof, visitor);
		if (proof.invalid) return false;
	}
	return true;
}

[[nodiscard]] static bool per_row_collect_operand_sources(
		Node* expression, RelOptInfo* joinrel,
		PerRowOperandSourceProof& proof) {
	if (expression == nullptr || joinrel == nullptr
		|| contain_volatile_functions(expression)) return false;
	proof.joinrel = joinrel;
	per_row_operand_source_visitor visitor;
	pg_walk_expression_including_root(expression, proof, visitor);
	return !proof.invalid;
}

/* Exact baserel operand proof for BioseqScan-owned mmsearch.  Unlike the join
 * relocation proof above, this expression is not moved across a planner
 * frontier: its original post-setrefs ExprState remains authoritative at the
 * scan.  Volatile functions and opaque/erroring CASE/COALESCE arms are thus
 * legal and execute once in PostgreSQL order.  What must still be proven is
 * that no aggregate/window/subplan/PHV/SRF frontier is crossed and that every
 * Var belongs to this non-nullable scan relation. */
struct BaseLocalMmsearchOperandProof {
	Node* expression = nullptr;
	List* sequence_vars = NIL;
	Var* primary_sequence_var = nullptr;
	int32 typmod = -1;
	bool evaluated = false;
};

struct BaseLocalMmsearchOperandWalker {
	RelOptInfo* rel = nullptr;
	const BioseqStubOids* oids = nullptr;
	List* sequence_vars = NIL;
	bool invalid = false;
};

struct base_local_mmsearch_operand_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			BaseLocalMmsearchOperandWalker& proof) const {
		Node* raw = node.raw();
		if (raw == nullptr || proof.rel == nullptr || proof.oids == nullptr) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (IsA(raw, PlaceHolderVar) || IsA(raw, Aggref)
			|| IsA(raw, GroupingFunc) || IsA(raw, WindowFunc)
			|| IsA(raw, SubPlan) || IsA(raw, AlternativeSubPlan)
			|| IsA(raw, SubLink)) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (FuncExpr* function = node.try_as<FuncExpr>()) {
			if (function->funcretset
				|| is_mmsearch_funcid(function->funcid, *proof.oids)) {
				proof.invalid = true;
				return pg_walk_step::stop;
			}
		}
		if (OpExpr* operation = node.try_as<OpExpr>();
			operation != nullptr && operation->opretset) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		Var* variable = node.try_as<Var>();
		if (variable == nullptr) return pg_walk_step::descend;
		if (!bioseq_is_concrete_rte_varno(variable->varno)
			|| variable->varno != proof.rel->relid
			|| variable->varattno <= 0 || variable->varlevelsup != 0
			|| !bms_is_empty(variable->varnullingrels)) {
			proof.invalid = true;
			return pg_walk_step::stop;
		}
		if (variable->vartype == proof.oids->bioseq_seq_type_oid) {
			bool duplicate = false;
			for (Var* existing : PList<Var>(proof.sequence_vars)) {
				if (equal(existing, variable)) {
					duplicate = true;
					break;
				}
			}
			if (!duplicate) proof.sequence_vars = lappend(
				proof.sequence_vars, variable);
		}
		return pg_walk_step::skip_subtree;
	}
};

struct BaseLocalSequenceTypmodResolution {
	int32 typmod = -1;
	bool invalid = false;
};

[[nodiscard]] static BaseLocalSequenceTypmodResolution
base_local_sequence_typmod_resolution(
		Node* expression, const BioseqStubOids& oids) {
	check_stack_depth();
	if (expression == nullptr
		|| exprType(expression) != oids.bioseq_seq_type_oid) {
		return {.invalid = true};
	}
	auto supported_descriptor = [](const int32 typmod) noexcept {
		return typmod >= 0 && batch_join_typmod_is_supported(typmod);
	};
	auto finish = [expression, &supported_descriptor](
			BaseLocalSequenceTypmodResolution derived) {
		if (derived.invalid) return derived;
		const int32 descriptor = exprTypmod(expression);
		if (descriptor < -1
			|| (descriptor >= 0 && !supported_descriptor(descriptor))) {
			return BaseLocalSequenceTypmodResolution{.invalid = true};
		}
		if (descriptor >= 0) {
			if (derived.typmod >= 0) {
				const auto declared = compact_sequence_stdc_type_params::decode(
					descriptor);
				const auto child = compact_sequence_stdc_type_params::decode(
					derived.typmod);
				if (declared.alphabet_code != child.alphabet_code) {
					return BaseLocalSequenceTypmodResolution{.invalid = true};
				}
			}
			derived.typmod = descriptor;
		}
		return derived;
	};
	auto merge_exact = [](BaseLocalSequenceTypmodResolution& destination,
			const BaseLocalSequenceTypmodResolution source) {
		if (source.invalid) {
			destination.invalid = true;
			return;
		}
		/* An opaque, descriptor-erased arm is intentionally neutral.  If it is
		 * selected, capture_target/query_datum validates the actual bound type
		 * before dispatch; an unselected throwing arm is never inspected. */
		if (source.typmod < 0) return;
		if (destination.typmod < 0) {
			destination.typmod = source.typmod;
			return;
		}
		if (destination.typmod != source.typmod) destination.invalid = true;
	};

	if (Node* source = slice_project_typmod_cast_source(expression, oids)) {
		BaseLocalSequenceTypmodResolution child =
			base_local_sequence_typmod_resolution(source, oids);
		Const* target_typmod = pg_node_try_as<Const>(
			reinterpret_cast<Node*>(lsecond(
				reinterpret_cast<FuncExpr*>(expression)->args)));
		if (child.invalid || target_typmod == nullptr
			|| target_typmod->constisnull) return {.invalid = true};
		const int32 cast_typmod = DatumGetInt32(target_typmod->constvalue);
		if (!supported_descriptor(cast_typmod)) return {.invalid = true};
		if (child.typmod >= 0
			&& compact_sequence_stdc_type_params::decode(child.typmod).
				alphabet_code
				!= compact_sequence_stdc_type_params::decode(cast_typmod).
					alphabet_code) return {.invalid = true};
		return BaseLocalSequenceTypmodResolution{cast_typmod, false};
	}
	if (IsA(expression, RelabelType)) {
		auto* relabel = reinterpret_cast<RelabelType*>(expression);
		return finish(base_local_sequence_typmod_resolution(
			reinterpret_cast<Node*>(relabel->arg), oids));
	}
	if (nodeTag(expression) == T_CaseExpr) {
		CaseExpr* choice = castNode(CaseExpr, expression);
		BaseLocalSequenceTypmodResolution result{};
		for (CaseWhen* arm : PList<CaseWhen>(choice->args)) {
			if (arm == nullptr || arm->result == nullptr
				|| exprType(reinterpret_cast<Node*>(arm->result))
					!= oids.bioseq_seq_type_oid) {
				result.invalid = true;
				break;
			}
			merge_exact(result, base_local_sequence_typmod_resolution(
				reinterpret_cast<Node*>(arm->result), oids));
			if (result.invalid) break;
		}
		if (!result.invalid && choice->defresult != nullptr) {
			merge_exact(result, base_local_sequence_typmod_resolution(
				reinterpret_cast<Node*>(choice->defresult), oids));
		}
		return finish(result);
	}
	if (nodeTag(expression) == T_CoalesceExpr) {
		CoalesceExpr* choice = castNode(CoalesceExpr, expression);
		BaseLocalSequenceTypmodResolution result{};
		for (Node* arm : PList<Node>(choice->args)) {
			merge_exact(result,
				base_local_sequence_typmod_resolution(arm, oids));
			if (result.invalid) break;
		}
		return finish(result);
	}

	const auto opcode = slice_project_node_opcode(expression, oids);
	if (opcode.has_value() && *opcode == SliceProjectOpcode::slice) {
		auto* subscript = reinterpret_cast<SubscriptingRef*>(expression);
		if (subscript->refexpr == nullptr || subscript->refassgnexpr != nullptr
			|| subscript->refcontainertype != oids.bioseq_seq_type_oid
			|| subscript->refrestype != oids.bioseq_seq_type_oid) {
			return {.invalid = true};
		}
		return finish(base_local_sequence_typmod_resolution(
			reinterpret_cast<Node*>(subscript->refexpr), oids));
	}
	if (opcode.has_value()
		&& (*opcode == SliceProjectOpcode::reverse
			|| *opcode == SliceProjectOpcode::reverse_complement)) {
		FuncExpr* function = pg_node_try_as<FuncExpr>(expression);
		if (function == nullptr || list_length(function->args) != 1
			|| !per_row_function_signature_is_exact(function)) {
			return {.invalid = true};
		}
		return finish(base_local_sequence_typmod_resolution(
			reinterpret_cast<Node*>(linitial(function->args)), oids));
	}
	if (opcode.has_value() && *opcode == SliceProjectOpcode::concat) {
		List* arguments = NIL;
		if (FuncExpr* function = pg_node_try_as<FuncExpr>(expression)) {
			if (!slice_project_concat_oid(function->funcid, oids)
				|| !per_row_function_signature_is_exact(function)) {
				return {.invalid = true};
			}
			arguments = function->args;
		} else if (OpExpr* operation = pg_node_try_as<OpExpr>(expression)) {
			if (!slice_project_concat_oid(operation->opfuncid, oids)
				|| !per_row_operator_signature_is_exact(operation)) {
				return {.invalid = true};
			}
			arguments = operation->args;
		} else {
			return {.invalid = true};
		}
		BaseLocalSequenceTypmodResolution result{};
		for (Node* argument : PList<Node>(arguments)) {
			if (exprType(argument) != oids.bioseq_seq_type_oid) continue;
			const auto child = base_local_sequence_typmod_resolution(
				argument, oids);
			if (child.invalid) return child;
			if (child.typmod < 0) continue;
			if (result.typmod < 0) {
				/* Registered concat uses the first bound sequence operand's
				 * storage width; later bound operands need only share alphabet. */
				result.typmod = child.typmod;
				continue;
			}
			if (compact_sequence_stdc_type_params::decode(result.typmod).
					alphabet_code
				!= compact_sequence_stdc_type_params::decode(child.typmod).
					alphabet_code) return {.invalid = true};
		}
		return finish(result);
	}

	/* Raw Vars/Consts/Params and opaque sequence-producing arms are legal
	 * leaves.  A concrete descriptor proves their dispatch type.  An erased
	 * opaque leaf is neutral only when an enclosing CASE/COALESCE supplies a
	 * concrete sibling; it cannot be the root of an owned operand. */
	const int32 descriptor = exprTypmod(expression);
	return descriptor >= 0 && supported_descriptor(descriptor)
		? BaseLocalSequenceTypmodResolution{descriptor, false}
		: BaseLocalSequenceTypmodResolution{};
}

[[nodiscard]] static std::optional<BaseLocalMmsearchOperandProof>
prove_base_local_mmsearch_operand(
		Node* expression, RelOptInfo* rel, const BioseqStubOids& oids,
		const bool require_sequence_var) {
	if (expression == nullptr || rel == nullptr
		|| exprType(expression) != oids.bioseq_seq_type_oid
		|| expression_returns_set(expression)
		|| contain_subplans(expression)) return std::nullopt;
	BaseLocalMmsearchOperandWalker walker{rel, &oids, NIL, false};
	base_local_mmsearch_operand_visitor visitor;
	pg_walk_expression_including_root(expression, walker, visitor);
	if (walker.invalid
		|| (require_sequence_var && walker.sequence_vars == NIL)) {
		return std::nullopt;
	}
	const BaseLocalSequenceTypmodResolution type =
		base_local_sequence_typmod_resolution(expression, oids);
	if (type.invalid || type.typmod < 0
		|| !batch_join_typmod_is_supported(type.typmod)) return std::nullopt;
	Var* raw = pg_node_try_as<Var>(expression);
	return BaseLocalMmsearchOperandProof{
		.expression = expression,
		.sequence_vars = walker.sequence_vars,
		.primary_sequence_var = walker.sequence_vars == NIL
			? nullptr : reinterpret_cast<Var*>(linitial(walker.sequence_vars)),
		.typmod = type.typmod,
		.evaluated = raw == nullptr,
	};
}

struct BaseLocalMmsearchOwnershipProof {
	BaseLocalMmsearchOperandProof target{};
	std::optional<BaseLocalMmsearchOperandProof> local_query{};
	bool query_is_const = false;
	bool query_is_param = false;
	bool query_is_outer_var = false;
	bool any_evaluated_operand = false;
};

[[nodiscard]] static std::optional<BaseLocalMmsearchOwnershipProof>
prove_base_local_mmsearch_ownership(
		FuncExpr* function, RelOptInfo* rel, Relids param_relids,
		const BioseqStubOids& oids) {
	if (function == nullptr || rel == nullptr
		|| !is_mmsearch_funcid(function->funcid, oids)) return std::nullopt;
	pg_first_two_node_args arguments = pg_first_two_args_if_arity_between(
		*function, 2, 3);
	if (!arguments.present()) return std::nullopt;
	auto target = prove_base_local_mmsearch_operand(
		arguments.first, rel, oids, /*require_sequence_var=*/true);
	if (!target.has_value()) return std::nullopt;
	BaseLocalMmsearchOwnershipProof result{};
	result.target = *target;
	result.any_evaluated_operand = target->evaluated;
	Node* query = arguments.second;
	if (Const* constant = pg_node_try_as<Const>(query)) {
		if (constant->consttype != oids.bioseq_seq_type_oid
			|| constant->consttypmod < 0
			|| !batch_join_typmod_is_supported(constant->consttypmod)
			|| (!constant->constisnull
				&& !mmsearch_typmods_share_alphabet(
					target->typmod, constant->consttypmod))) {
			return std::nullopt;
		}
		result.query_is_const = true;
		return result;
	}
	if (Param* parameter = pg_node_try_as<Param>(query)) {
		const bool runtime_typed_external = parameter->paramkind == PARAM_EXTERN
			&& parameter->paramtypmod < 0;
		if (parameter->paramtype != oids.bioseq_seq_type_oid
			|| (parameter->paramkind != PARAM_EXEC
				&& parameter->paramkind != PARAM_EXTERN)
			|| (!runtime_typed_external
				&& (parameter->paramtypmod < 0
					|| !batch_join_typmod_is_supported(parameter->paramtypmod)
					|| !mmsearch_typmods_share_alphabet(
						target->typmod, parameter->paramtypmod)))) {
			return std::nullopt;
		}
		result.query_is_param = true;
		return result;
	}
	if (Var* variable = pg_node_try_as<Var>(query);
		variable != nullptr && variable->varno != rel->relid) {
		if (!bioseq_is_concrete_rte_varno(variable->varno)
			|| !bms_is_member(static_cast<int>(variable->varno), param_relids)
			|| variable->varattno <= 0 || variable->varlevelsup != 0
			|| !bms_is_empty(variable->varnullingrels)
			|| variable->vartype != oids.bioseq_seq_type_oid
			|| variable->vartypmod < 0
			|| !batch_join_typmod_is_supported(variable->vartypmod)
			|| !mmsearch_typmods_share_alphabet(
				target->typmod, variable->vartypmod)) return std::nullopt;
		result.query_is_outer_var = true;
		return result;
	}
	auto local_query = prove_base_local_mmsearch_operand(
		query, rel, oids, /*require_sequence_var=*/false);
	if (!local_query.has_value()
		|| !mmsearch_typmods_share_alphabet(
			target->typmod, local_query->typmod)) return std::nullopt;
	result.any_evaluated_operand = result.any_evaluated_operand
		|| local_query->evaluated;
	result.local_query = *local_query;
	return result;
}

[[nodiscard]] static List* per_row_without_restriction(
		List* restrictions, RestrictInfo* owned) {
	List* filtered = NIL;
	for (RestrictInfo* candidate : PList<RestrictInfo>(restrictions)) {
		if (candidate != owned) filtered = lappend(filtered, candidate);
	}
	return filtered;
}

/* A RestrictInfo can migrate below a NestLoop through PathParamInfo (or sit
 * in another custom/join child) while still appearing in the incumbent's
 * joinrestrictinfo.  Removing only the top copy would leave a second live
 * mmsearch rendezvous.  The post-join owner therefore accepts an incumbent
 * only when the exact pointer is absent from every retained descendant. */
[[nodiscard]] static bool per_row_descendant_owns_restriction(
		Path const* path, RestrictInfo const* owned) noexcept {
	if (path == nullptr || owned == nullptr) return false;
	if (path->param_info != nullptr
		&& list_member_ptr(path->param_info->ppi_clauses, owned)) return true;
	if (IsA(path, CustomPath)) {
		auto const* custom = reinterpret_cast<CustomPath const*>(path);
		if (list_member_ptr(custom->custom_restrictinfo, owned)) return true;
		for (Path* child : PList<Path>(custom->custom_paths)) {
			if (per_row_descendant_owns_restriction(child, owned)) return true;
		}
		return false;
	}
	if (IsA(path, NestPath) || IsA(path, MergePath) || IsA(path, HashPath)) {
		auto const* join = reinterpret_cast<JoinPath const*>(path);
		if (list_member_ptr(join->joinrestrictinfo, owned)) return true;
		return per_row_descendant_owns_restriction(
				join->outerjoinpath, owned)
			|| per_row_descendant_owns_restriction(
				join->innerjoinpath, owned);
	}
	switch (path->pathtype) {
		case T_Result:
			return per_row_descendant_owns_restriction(
				reinterpret_cast<ProjectionPath const*>(path)->subpath, owned);
		case T_Material:
			return per_row_descendant_owns_restriction(
				reinterpret_cast<MaterialPath const*>(path)->subpath, owned);
		case T_Memoize:
			return per_row_descendant_owns_restriction(
				reinterpret_cast<MemoizePath const*>(path)->subpath, owned);
		case T_Sort:
			return per_row_descendant_owns_restriction(
				reinterpret_cast<SortPath const*>(path)->subpath, owned);
		case T_IncrementalSort:
			return per_row_descendant_owns_restriction(
				reinterpret_cast<IncrementalSortPath const*>(path)->spath.subpath,
				owned);
		case T_Append: {
			auto const* append = reinterpret_cast<AppendPath const*>(path);
			for (Path* child : PList<Path>(append->subpaths)) {
				if (per_row_descendant_owns_restriction(child, owned)) return true;
			}
			return false;
		}
		case T_MergeAppend: {
			auto const* append = reinterpret_cast<MergeAppendPath const*>(path);
			for (Path* child : PList<Path>(append->subpaths)) {
				if (per_row_descendant_owns_restriction(child, owned)) return true;
			}
			return false;
		}
		default:
			return false;
	}
}

struct PerRowMmsearchPlanAudit {
	std::size_t executable_qual_copies = 0u;
	std::size_t vector_qual_copies = 0u;
	std::size_t storage_qual_copies = 0u;
	std::size_t descendant_owner_copies = 0u;

	[[nodiscard]] bool clean() const noexcept {
		return executable_qual_copies == 0u
			&& vector_qual_copies == 0u
			&& storage_qual_copies == 0u
			&& descendant_owner_copies == 0u;
	}
};

static void per_row_audit_mmsearch_expression(
		Node* expression, std::size_t& destination,
		BioseqStubOids const& oids) {
	if (expression == nullptr) return;
	const std::size_t additional = count_mmsearch_occurrences(
		expression, oids);
	destination = additional > std::numeric_limits<std::size_t>::max()
			- destination
		? std::numeric_limits<std::size_t>::max()
		: destination + additional;
}

struct ExactMmsearchOwnerAudit {
	FuncExpr* candidate = nullptr;
	BioseqStubOids const* oids = nullptr;
	std::size_t matches = 0u;
};

struct exact_mmsearch_owner_audit_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			ExactMmsearchOwnerAudit& audit) const {
		FuncExpr* function = node.try_as<FuncExpr>();
		if (function == nullptr || audit.oids == nullptr
			|| !is_mmsearch_funcid(function->funcid, *audit.oids)) {
			return pg_walk_step::descend;
		}
		if (audit.candidate != nullptr && equal(function, audit.candidate)) {
			audit.matches = audit.matches
				== std::numeric_limits<std::size_t>::max()
				? audit.matches : audit.matches + 1u;
		}
		return pg_walk_step::skip_subtree;
	}
};

static void per_row_audit_exact_mmsearch_owner(
		Node* expression, FuncExpr* candidate,
		std::size_t& destination, BioseqStubOids const& oids) {
	if (expression == nullptr || candidate == nullptr) return;
	ExactMmsearchOwnerAudit audit{candidate, &oids, 0u};
	exact_mmsearch_owner_audit_visitor visitor;
	pg_walk_expression_including_root(expression, audit, visitor);
	destination = audit.matches
		> std::numeric_limits<std::size_t>::max() - destination
		? std::numeric_limits<std::size_t>::max()
		: destination + audit.matches;
}

/* Audit the serialized child plan that will execute below the transformed
 * owner.  `Plan::qual` is only one of PostgreSQL's executable-qual stores:
 * join/index/recheck fields and the Bioseq reader's storage/vector lists must
 * be inspected independently.  The fourth BioseqScan expression list is an
 * executor-only mmsearch owner.  A foreign owner is valid nested SQL state;
 * only an owner equal to the candidate recipe is a duplicate of this owner. */
static void per_row_audit_mmsearch_plan(
		Plan* plan, PerRowMmsearchPlanAudit& audit,
		BioseqStubOids const& oids,
		FuncExpr* exact_owner_candidate = nullptr) {
	if (plan == nullptr) return;
	per_row_audit_mmsearch_expression(
		reinterpret_cast<Node*>(plan->qual),
		audit.executable_qual_copies, oids);

	if (IsA(plan, NestLoop)) {
		auto* join = &reinterpret_cast<NestLoop*>(plan)->join;
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(join->joinqual),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, MergeJoin)) {
		auto* merge = reinterpret_cast<MergeJoin*>(plan);
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(merge->join.joinqual),
			audit.executable_qual_copies, oids);
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(merge->mergeclauses),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, HashJoin)) {
		auto* hash = reinterpret_cast<HashJoin*>(plan);
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(hash->join.joinqual),
			audit.executable_qual_copies, oids);
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(hash->hashclauses),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, Result)) {
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Result*>(plan)->resconstantqual,
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, IndexScan)) {
		auto* scan = reinterpret_cast<IndexScan*>(plan);
		for (List* expressions : {scan->indexqual, scan->indexqualorig,
				scan->indexorderby, scan->indexorderbyorig}) {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(expressions),
				audit.executable_qual_copies, oids);
		}
	} else if (IsA(plan, IndexOnlyScan)) {
		auto* scan = reinterpret_cast<IndexOnlyScan*>(plan);
		for (List* expressions : {scan->indexqual, scan->recheckqual,
				scan->indexorderby}) {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(expressions),
				audit.executable_qual_copies, oids);
		}
	} else if (IsA(plan, BitmapIndexScan)) {
		auto* scan = reinterpret_cast<BitmapIndexScan*>(plan);
		for (List* expressions : {scan->indexqual, scan->indexqualorig}) {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(expressions),
				audit.executable_qual_copies, oids);
		}
	} else if (IsA(plan, BitmapHeapScan)) {
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(
				reinterpret_cast<BitmapHeapScan*>(plan)->bitmapqualorig),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, TidScan)) {
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(
				reinterpret_cast<TidScan*>(plan)->tidquals),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, TidRangeScan)) {
		per_row_audit_mmsearch_expression(
			reinterpret_cast<Node*>(
				reinterpret_cast<TidRangeScan*>(plan)->tidrangequals),
			audit.executable_qual_copies, oids);
	} else if (IsA(plan, ForeignScan)) {
		auto* scan = reinterpret_cast<ForeignScan*>(plan);
		for (List* expressions : {scan->fdw_exprs,
				scan->fdw_recheck_quals}) {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(expressions),
				audit.executable_qual_copies, oids);
		}
	}

	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		if (custom->methods == &BioseqColumnScanScanMethods
			&& list_length(custom->custom_exprs) >= 3) {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(list_nth(
					custom->custom_exprs, 0)),
				audit.storage_qual_copies, oids);
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(list_nth(
					custom->custom_exprs, 1)),
				audit.storage_qual_copies, oids);
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(list_nth(
					custom->custom_exprs, 2)),
				audit.vector_qual_copies, oids);
			for (int index = 3;
				 index < list_length(custom->custom_exprs); ++index) {
				Node* owner_expression = reinterpret_cast<Node*>(list_nth(
					custom->custom_exprs, index));
				if (exact_owner_candidate == nullptr) {
					per_row_audit_mmsearch_expression(
						owner_expression,
						audit.descendant_owner_copies, oids);
				} else {
					per_row_audit_exact_mmsearch_owner(
						owner_expression, exact_owner_candidate,
						audit.descendant_owner_copies, oids);
				}
			}
		} else {
			per_row_audit_mmsearch_expression(
				reinterpret_cast<Node*>(custom->custom_exprs),
				audit.executable_qual_copies, oids);
		}
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			per_row_audit_mmsearch_plan(
				child, audit, oids, exact_owner_candidate);
		}
		return;
	}
	if (IsA(plan, Append)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<Append*>(plan)->appendplans)) {
			per_row_audit_mmsearch_plan(
				child, audit, oids, exact_owner_candidate);
		}
		return;
	}
	if (IsA(plan, MergeAppend)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<MergeAppend*>(plan)->mergeplans)) {
			per_row_audit_mmsearch_plan(
				child, audit, oids, exact_owner_candidate);
		}
		return;
	}
	if (IsA(plan, BitmapAnd)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapAnd*>(plan)->bitmapplans)) {
			per_row_audit_mmsearch_plan(
				child, audit, oids, exact_owner_candidate);
		}
		return;
	}
	if (IsA(plan, BitmapOr)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapOr*>(plan)->bitmapplans)) {
			per_row_audit_mmsearch_plan(
				child, audit, oids, exact_owner_candidate);
		}
		return;
	}
	if (IsA(plan, SubqueryScan)) {
		per_row_audit_mmsearch_plan(
			reinterpret_cast<SubqueryScan*>(plan)->subplan, audit, oids,
			exact_owner_candidate);
		return;
	}
	per_row_audit_mmsearch_plan(
		outerPlan(plan), audit, oids, exact_owner_candidate);
	if (innerPlan(plan) != outerPlan(plan)) {
		per_row_audit_mmsearch_plan(
			innerPlan(plan), audit, oids, exact_owner_candidate);
	}
}

[[nodiscard]] static Path* per_row_path_without_owned_qual(
		RelOptInfo* rel, RestrictInfo* owned,
		const bool require_bioseq_source) noexcept {
	if (rel == nullptr || owned == nullptr) return nullptr;
	Path* best = nullptr;
	for (Path* candidate : PList<Path>(rel->pathlist)) {
		if (candidate == nullptr || candidate->parent != rel
			|| batch_join_path_contains_parallel_execution(candidate)
			|| per_row_descendant_owns_restriction(candidate, owned)
			|| (require_bioseq_source
				&& !slice_project_path_tree_has_bioseq_scan(candidate))
			|| !std::isfinite(candidate->total_cost)
			|| candidate->total_cost < 0) continue;
		if (best == nullptr || candidate->total_cost < best->total_cost) {
			best = candidate;
		}
	}
	return best;
}

/* A reconstructed join may expose raw sequence Vars that its incumbent child
 * PathTargets did not need after core pushed the original join predicate.
 * Add only positive, level-zero raw Vars owned by this child's relids.  The
 * projection is a new Path node; shared child paths and PHV/whole-row
 * semantics are never mutated or synthesized. */
[[nodiscard]] static Path* per_row_project_required_child_vars(
		PlannerInfo* root, Path* child, List* required_vars) {
	if (root == nullptr || child == nullptr || child->parent == nullptr
		|| child->pathtarget == nullptr || required_vars == nullptr) {
		return nullptr;
	}
	PathTarget* projected = copy_pathtarget(child->pathtarget);
	bool added = false;
	for (Node* expression : PList<Node>(required_vars)) {
		Var* var = pg_node_try_as<Var>(expression);
		const bool row_identity = per_row_is_exact_row_identity_var(var);
		if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
			|| (var->varattno <= 0 && !row_identity)
			|| var->varlevelsup != 0
			|| !bms_is_empty(var->varnullingrels)) return nullptr;
		if (!bms_is_member(
				static_cast<int>(var->varno), child->parent->relids)) continue;
		if (!path_target_contains_expression(
				projected, reinterpret_cast<Expr*>(var))) {
			add_column_to_pathtarget(
				projected, reinterpret_cast<Expr*>(copyObject(var)), 0);
			added = true;
		}
	}
	if (!added) return child;
	set_pathtarget_cost_width(root, projected);
	return reinterpret_cast<Path*>(create_projection_path(
		root, child->parent, child, projected));
}

struct PerRowDescendantOwnerProof {
	CustomPath* owner = nullptr;
	std::size_t matches = 0u;
	bool invalid_owner_abi = false;
	bool unsupported_wrapper = false;
};

[[nodiscard]] static Node* per_row_known_path_owner_recipe(
		CustomPath* custom, bool& invalid) {
	if (custom == nullptr) return nullptr;
	const bool raw_owner = custom->methods == &BioseqBatchJoinPathMethods;
	const bool transformed_owner =
		custom->methods == &BioseqPerRowJoinPathMethods;
	if (!raw_owner && !transformed_owner) return nullptr;
	const int expected_version = raw_owner
		? kBioseqBatchJoinPlanVersion : kBioseqPerRowJoinPlanVersion;
	const int expected_children = raw_owner ? 2 : 1;
	const int expected_fields = raw_owner
		? kBioseqBatchJoinPathPrivateFields
		: kBioseqPerRowJoinPathPrivateFields;
	Node* version = list_length(custom->custom_private) == expected_fields
		? reinterpret_cast<Node*>(linitial(custom->custom_private)) : nullptr;
	Node* recipe = list_length(custom->custom_private) == expected_fields
		? reinterpret_cast<Node*>(list_nth(custom->custom_private, 4)) : nullptr;
	if (version == nullptr || !IsA(version, Integer)
		|| intVal(version) != expected_version
		|| list_length(custom->custom_paths) != expected_children
		|| recipe == nullptr
		|| exprType(recipe) != get_cached_stub_oids().bioseq_seq_type_oid) {
		invalid = true;
		return nullptr;
	}
	return recipe;
}

static void per_row_prove_descendant_exact_owner(
		Path* path, Node* helper_argument,
		PerRowDescendantOwnerProof& proof) {
	if (path == nullptr || helper_argument == nullptr
		|| proof.invalid_owner_abi || proof.unsupported_wrapper) return;
	check_stack_depth();
	if (IsA(path, CustomPath)) {
		auto* custom = reinterpret_cast<CustomPath*>(path);
		const bool known_owner = custom->methods == &BioseqBatchJoinPathMethods
			|| custom->methods == &BioseqPerRowJoinPathMethods;
		if (known_owner) {
			Node* recipe = per_row_known_path_owner_recipe(
				custom, proof.invalid_owner_abi);
			if (proof.invalid_owner_abi) return;
			if (recipe != nullptr && equal(helper_argument, recipe)) {
				++proof.matches;
				proof.owner = custom;
			}
		} else if (custom->methods != &BioseqColumnScanPathMethods
			&& custom->methods != &bioseq_slice_project_path_methods()) {
			/* Unknown CustomPaths can hide an evaluation/projection frontier in
			 * provider-private state.  Never infer helper provenance through one. */
			proof.unsupported_wrapper = true;
			return;
		}
		for (Path* child : PList<Path>(custom->custom_paths)) {
			per_row_prove_descendant_exact_owner(
				child, helper_argument, proof);
		}
		return;
	}
	auto descend_join = [helper_argument, &proof](JoinPath* join) {
		if (join == nullptr) return;
		per_row_prove_descendant_exact_owner(
			join->outerjoinpath, helper_argument, proof);
		per_row_prove_descendant_exact_owner(
			join->innerjoinpath, helper_argument, proof);
	};
	if (IsA(path, NestPath)) {
		descend_join(&reinterpret_cast<NestPath*>(path)->jpath);
		return;
	}
	if (IsA(path, MergePath)) {
		descend_join(&reinterpret_cast<MergePath*>(path)->jpath);
		return;
	}
	if (IsA(path, HashPath)) {
		descend_join(&reinterpret_cast<HashPath*>(path)->jpath);
		return;
	}
	auto descend_one = [helper_argument, &proof](Path* child) {
		per_row_prove_descendant_exact_owner(
			child, helper_argument, proof);
	};
	if (IsA(path, ProjectionPath)) {
		descend_one(reinterpret_cast<ProjectionPath*>(path)->subpath);
		return;
	}
	if (IsA(path, ProjectSetPath)) {
		descend_one(reinterpret_cast<ProjectSetPath*>(path)->subpath);
		return;
	}
	if (IsA(path, SortPath)) {
		descend_one(reinterpret_cast<SortPath*>(path)->subpath);
		return;
	}
	if (IsA(path, IncrementalSortPath)) {
		descend_one(reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath);
		return;
	}
	if (IsA(path, MaterialPath)) {
		descend_one(reinterpret_cast<MaterialPath*>(path)->subpath);
		return;
	}
	if (IsA(path, MemoizePath)) {
		descend_one(reinterpret_cast<MemoizePath*>(path)->subpath);
		return;
	}
	if (IsA(path, UniquePath)) {
		descend_one(reinterpret_cast<UniquePath*>(path)->subpath);
		return;
	}
	if (IsA(path, GatherPath)) {
		descend_one(reinterpret_cast<GatherPath*>(path)->subpath);
		return;
	}
	if (IsA(path, GatherMergePath)) {
		descend_one(reinterpret_cast<GatherMergePath*>(path)->subpath);
		return;
	}
	auto descend_list = [helper_argument, &proof](List* paths) {
		for (Path* child : PList<Path>(paths)) {
			per_row_prove_descendant_exact_owner(
				child, helper_argument, proof);
		}
	};
	if (IsA(path, AppendPath)) {
		descend_list(reinterpret_cast<AppendPath*>(path)->subpaths);
		return;
	}
	if (IsA(path, MergeAppendPath)) {
		descend_list(reinterpret_cast<MergeAppendPath*>(path)->subpaths);
		return;
	}
	/* Ordinary base-relation scan paths have no child Path.  Anything else is
	 * an unmodelled join/subquery/foreign wrapper and must fail closed. */
	if (path->parent == nullptr
		|| (path->parent->reloptkind != RELOPT_BASEREL
			&& path->parent->reloptkind != RELOPT_OTHER_MEMBER_REL)) {
		proof.unsupported_wrapper = true;
	}
}

[[nodiscard]] static Path* per_row_clone_path_to_helper_owner(
	PlannerInfo* root, Path* path, CustomPath* owner, Node* identity,
	bool& applied, bool& invalid);

[[nodiscard]] static PathTarget* per_row_helper_passthrough_target(
		PlannerInfo* root, PathTarget* source, Node* identity,
		bool& invalid) {
	if (root == nullptr || source == nullptr || identity == nullptr) {
		invalid = true;
		return source;
	}
	std::vector<Index> sortgrouprefs;
	if (!per_row_authoritative_sortgrouprefs(
			root, source->exprs, sortgrouprefs)
		|| sortgrouprefs.size()
			!= static_cast<std::size_t>(list_length(source->exprs))) {
		invalid = true;
		return source;
	}
	List* expressions = static_cast<List*>(copyObject(source->exprs));
	if (!per_row_expression_list_contains(expressions, identity)) {
		expressions = lappend(expressions, copyObject(identity));
		sortgrouprefs.push_back(0);
	}
	PathTarget* target = create_empty_pathtarget();
	target->exprs = expressions;
	const bool has_sortgroupref = std::any_of(
		sortgrouprefs.begin(), sortgrouprefs.end(),
		[](Index value) noexcept { return value != 0; });
	if (has_sortgroupref) {
		target->sortgrouprefs = static_cast<Index*>(palloc0(
			sortgrouprefs.size() * sizeof(Index)));
		for (std::size_t index = 0u; index < sortgrouprefs.size(); ++index) {
			target->sortgrouprefs[index] = sortgrouprefs[index];
		}
	}
	set_pathtarget_cost_width(root, target);
	return target;
}

[[nodiscard]] static List* per_row_clone_path_list_to_helper_owner(
		PlannerInfo* root, List* paths, CustomPath* owner, Node* identity,
		bool& applied, bool& invalid) {
	List* result = NIL;
	bool changed = false;
	for (Path* child : PList<Path>(paths)) {
		Path* replacement = applied || invalid ? child
			: per_row_clone_path_to_helper_owner(
				root, child, owner, identity, applied, invalid);
		changed = changed || replacement != child;
		result = lappend(result, replacement);
	}
	return changed ? result : paths;
}

[[nodiscard]] static Path* per_row_clone_path_to_helper_owner(
		PlannerInfo* root, Path* path, CustomPath* owner, Node* identity,
		bool& applied, bool& invalid) {
	if (path == nullptr || owner == nullptr || identity == nullptr
		|| applied || invalid) {
		return path;
	}
	if (path == reinterpret_cast<Path*>(owner)) {
		auto* clone = makeNode(CustomPath);
		*clone = *owner;
		clone->path.pathtarget = per_row_helper_passthrough_target(
			root, path->pathtarget, identity, invalid);
		if (invalid) return path;
		applied = true;
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, CustomPath)) {
		auto* source = reinterpret_cast<CustomPath*>(path);
		List* children = per_row_clone_path_list_to_helper_owner(
			root, source->custom_paths, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		auto* clone = makeNode(CustomPath);
		*clone = *source;
		clone->custom_paths = children;
		clone->path.pathtarget = per_row_helper_passthrough_target(
			root, source->path.pathtarget, identity, invalid);
		if (invalid) return path;
		return reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, NestPath)) {
		auto* source = reinterpret_cast<NestPath*>(path);
		auto* clone = makeNode(NestPath);
		*clone = *source;
		clone->jpath.outerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.outerjoinpath, owner, identity, applied, invalid);
		clone->jpath.innerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.innerjoinpath, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		clone->jpath.path.pathtarget = per_row_helper_passthrough_target(
			root, source->jpath.path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MergePath)) {
		auto* source = reinterpret_cast<MergePath*>(path);
		auto* clone = makeNode(MergePath);
		*clone = *source;
		clone->jpath.outerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.outerjoinpath, owner, identity, applied, invalid);
		clone->jpath.innerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.innerjoinpath, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		clone->jpath.path.pathtarget = per_row_helper_passthrough_target(
			root, source->jpath.path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, HashPath)) {
		auto* source = reinterpret_cast<HashPath*>(path);
		auto* clone = makeNode(HashPath);
		*clone = *source;
		clone->jpath.outerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.outerjoinpath, owner, identity, applied, invalid);
		clone->jpath.innerjoinpath = per_row_clone_path_to_helper_owner(
			root, source->jpath.innerjoinpath, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		clone->jpath.path.pathtarget = per_row_helper_passthrough_target(
			root, source->jpath.path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
#define BIOSEQ_CLONE_HELPER_UNARY_PATH(PathType, ChildMember)                 \
	if (IsA(path, PathType)) {                                                  \
		auto* source = reinterpret_cast<PathType*>(path);                         \
		Path* child = per_row_clone_path_to_helper_owner(                         \
			root, source->ChildMember, owner, identity, applied, invalid);         \
		if (!applied || invalid) return path;                                     \
		auto* clone = makeNode(PathType);                                         \
		*clone = *source;                                                        \
		clone->ChildMember = child;                                               \
		reinterpret_cast<Path*>(clone)->pathtarget =                              \
			per_row_helper_passthrough_target(                                     \
				root, path->pathtarget, identity, invalid);                         \
		return invalid ? path : reinterpret_cast<Path*>(clone);                  \
	}
	BIOSEQ_CLONE_HELPER_UNARY_PATH(ProjectionPath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(ProjectSetPath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(SortPath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(MaterialPath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(MemoizePath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(UniquePath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(GatherPath, subpath)
	BIOSEQ_CLONE_HELPER_UNARY_PATH(GatherMergePath, subpath)
#undef BIOSEQ_CLONE_HELPER_UNARY_PATH
	if (IsA(path, IncrementalSortPath)) {
		auto* source = reinterpret_cast<IncrementalSortPath*>(path);
		Path* child = per_row_clone_path_to_helper_owner(
			root, source->spath.subpath, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		auto* clone = makeNode(IncrementalSortPath);
		*clone = *source;
		clone->spath.subpath = child;
		clone->spath.path.pathtarget = per_row_helper_passthrough_target(
			root, source->spath.path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, AppendPath)) {
		auto* source = reinterpret_cast<AppendPath*>(path);
		List* children = per_row_clone_path_list_to_helper_owner(
			root, source->subpaths, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		auto* clone = makeNode(AppendPath);
		*clone = *source;
		clone->subpaths = children;
		clone->path.pathtarget = per_row_helper_passthrough_target(
			root, source->path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
	if (IsA(path, MergeAppendPath)) {
		auto* source = reinterpret_cast<MergeAppendPath*>(path);
		List* children = per_row_clone_path_list_to_helper_owner(
			root, source->subpaths, owner, identity, applied, invalid);
		if (!applied || invalid) return path;
		auto* clone = makeNode(MergeAppendPath);
		*clone = *source;
		clone->subpaths = children;
		clone->path.pathtarget = per_row_helper_passthrough_target(
			root, source->path.pathtarget, identity, invalid);
		return invalid ? path : reinterpret_cast<Path*>(clone);
	}
	return path;
}

/* A reconstructed transformed owner is deliberately narrower than the
 * incumbent join relation: helpers owned by the new PerRow node must not leak
 * into a descendant BioseqScan or an older BatchJoin.  PostgreSQL Path nodes
 * are shared, so normalize only after slice_project_clone_mutable_path_spine()
 * has made every supported container private.  Availability is scoped to the
 * current subtree: a descendant-owned helper is retained at its owner and
 * above it, but is removed from every child below that owner. */
struct PerRowBaseHelperOwnerProof {
	CustomPath* owner = nullptr;
	std::size_t matches = 0u;
	bool invalid_owner_abi = false;
	bool unsupported_wrapper = false;
};

[[nodiscard]] static FuncExpr* per_row_helper_identity_function(
		Node* identity, BioseqStubOids const& oids) noexcept {
	if (PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity)) {
		return batch_join_match_helper_phv_function(placeholder, oids);
	}
	return batch_join_well_formed_match_helper(identity, oids);
}

[[nodiscard]] static Node* per_row_base_scan_owner_recipe(
		CustomPath* custom, bool& invalid) {
	if (custom == nullptr || custom->methods != &BioseqColumnScanPathMethods) {
		return nullptr;
	}
	Node* recipe = nullptr;
	for (Node* private_node : PList<Node>(custom->custom_private)) {
		if (private_node == nullptr || !IsA(private_node, List)) continue;
		List* tag = reinterpret_cast<List*>(private_node);
		Node* magic = list_length(tag) >= 1
			? reinterpret_cast<Node*>(linitial(tag)) : nullptr;
		if (magic == nullptr || !IsA(magic, Integer)
			|| intVal(magic) != kBioseqMmsearchOwnerMagic) continue;
		Node* version = list_length(tag) == 3
			? reinterpret_cast<Node*>(list_nth(tag, 1)) : nullptr;
		Node* expressions_node = list_length(tag) == 3
			? reinterpret_cast<Node*>(list_nth(tag, 2)) : nullptr;
		List* expressions = expressions_node != nullptr
			&& IsA(expressions_node, List)
			? reinterpret_cast<List*>(expressions_node) : NIL;
		FuncExpr* mmsearch = expressions == NIL ? nullptr
			: pg_node_try_as<FuncExpr>(
				reinterpret_cast<Node*>(linitial(expressions)));
		if (recipe != nullptr || version == nullptr || !IsA(version, Integer)
			|| intVal(version) != kBioseqMmsearchOwnerVersion
			|| mmsearch == nullptr
			|| list_length(expressions) > 2
			|| !is_mmsearch_funcid(mmsearch->funcid, get_cached_stub_oids())
			|| (list_length(mmsearch->args) != 2
				&& list_length(mmsearch->args) != 3)
			|| list_length(custom->custom_restrictinfo)
				!= list_length(expressions)) {
			invalid = true;
			return nullptr;
		}
		for (Node* expression : PList<Node>(expressions)) {
			FuncExpr* owned = pg_node_try_as<FuncExpr>(expression);
			if (owned == nullptr
				|| !is_mmsearch_funcid(
					owned->funcid, get_cached_stub_oids())
				|| (list_length(owned->args) != 2
					&& list_length(owned->args) != 3)) {
				invalid = true;
				return nullptr;
			}
		}
		recipe = reinterpret_cast<Node*>(linitial(mmsearch->args));
		if (recipe == nullptr
			|| exprType(recipe)
				!= get_cached_stub_oids().bioseq_seq_type_oid) {
			invalid = true;
			return nullptr;
		}
	}
	return recipe;
}

struct ExactParameterizedBmoOwnerProof {
	std::size_t matches = 0u;
	bool invalid = false;
	std::uint32_t rejection_mask = 0u;
	std::size_t wrapper_owns_expected = 0u;
	std::uint32_t wrapper_method_mask = 0u;
	std::size_t wrapper_restriction_count = 0u;
	std::size_t wrapper_child_count = 0u;
	std::size_t wrapper_version = 0u;
	std::size_t wrapper_pointer_matches = 0u;
	std::size_t wrapper_serial_matches = 0u;
	std::size_t wrapper_clause_matches = 0u;
	std::size_t expected_rinfo_serial = 0u;
	std::size_t wrapper_rinfo_serial = 0u;
	std::size_t expected_target_varno = 0u;
	std::size_t expected_query_varno = 0u;
	std::size_t wrapper_private_target_varno = 0u;
	std::size_t wrapper_private_query_varno = 0u;
	std::size_t wrapper_private_target_equal = 0u;
	std::size_t wrapper_private_query_equal = 0u;
	std::size_t wrapper_owner0_target_varno = 0u;
	std::size_t wrapper_owner0_query_varno = 0u;
	std::size_t wrapper_owner1_target_varno = 0u;
	std::size_t wrapper_owner1_query_varno = 0u;
	std::uint64_t wrapper_parent_relids_low = 0u;
	std::uint64_t wrapper_child0_relids_low = 0u;
	std::uint64_t wrapper_child1_relids_low = 0u;
};

[[nodiscard]] static std::uint64_t exact_bmo_audit_relids_low(
		Relids relids) noexcept {
	std::uint64_t mask = 0u;
	int relid = -1;
	while ((relid = bms_next_member(relids, relid)) >= 0) {
		if (relid < 64) mask |= std::uint64_t{1} << relid;
	}
	return mask;
}

/* PostgreSQL copies RestrictInfo nodes between baserel parameterization and
 * join-path construction while preserving rinfo_serial specifically so the
 * copies retain one planner identity.  Pointer equality alone therefore
 * misses the BMO path that owns the same qual.  Admit only that documented
 * clone relation plus an exact executable/security shape; equal SQL text with
 * a different serial remains a distinct restriction. */
[[nodiscard]] static bool same_planner_restriction_identity(
		RestrictInfo* candidate, RestrictInfo* expected) noexcept {
	if (candidate == expected) {
		return candidate != nullptr && candidate->rinfo_serial > 0;
	}
	return candidate != nullptr && expected != nullptr
		&& candidate->rinfo_serial > 0
		&& expected->rinfo_serial > 0
		&& candidate->rinfo_serial == expected->rinfo_serial
		&& candidate->pseudoconstant == expected->pseudoconstant
		&& candidate->security_level == expected->security_level
		&& candidate->is_pushed_down == expected->is_pushed_down
		&& candidate->can_join == expected->can_join
		&& candidate->has_clone == expected->has_clone
		&& candidate->is_clone == expected->is_clone
		&& candidate->leakproof == expected->leakproof
		&& candidate->has_volatile == expected->has_volatile
		&& candidate->num_base_rels == expected->num_base_rels
		&& bms_equal(candidate->clause_relids, expected->clause_relids)
		&& bms_equal(candidate->required_relids, expected->required_relids)
		&& bms_equal(
			candidate->incompatible_relids, expected->incompatible_relids)
		&& bms_equal(candidate->outer_relids, expected->outer_relids)
		&& bms_equal(candidate->left_relids, expected->left_relids)
		&& bms_equal(candidate->right_relids, expected->right_relids)
		&& equal(candidate->orclause, expected->orclause)
		&& equal(candidate->clause, expected->clause);
}

enum ExactParameterizedBmoOwnerRejection : std::uint32_t {
	kExactBmoUnknownCustomPath = 1u << 0,
	kExactBmoBaseScanHasChildren = 1u << 1,
	kExactBmoOwnerAbi = 1u << 2,
	kExactBmoRestrictionMultiplicity = 1u << 3,
	kExactBmoMissingParamInfo = 1u << 4,
	kExactBmoMissingPpiClause = 1u << 5,
	kExactBmoNestedJoinClause = 1u << 6,
	kExactBmoUnknownCorePath = 1u << 7,
	kExactBmoKnownWrapperAbi = 1u << 8,
	kExactBmoKnownWrapperOwnsClause = 1u << 9,
};

static inline void reject_exact_parameterized_bmo_owner(
		ExactParameterizedBmoOwnerProof& proof,
		const ExactParameterizedBmoOwnerRejection reason) noexcept {
	proof.invalid = true;
	proof.rejection_mask |= static_cast<std::uint32_t>(reason);
}

[[nodiscard]] static bool foreign_known_join_owner_is_valid(
		PlannerInfo* root, CustomPath* custom) {
	if (root == nullptr || custom == nullptr) return false;
	const bool raw_owner = custom->methods == &BioseqBatchJoinPathMethods;
	const bool transformed_owner =
		custom->methods == &BioseqPerRowJoinPathMethods;
	if (!raw_owner && !transformed_owner) return false;
	bool invalid_owner_abi = false;
	if (per_row_known_path_owner_recipe(custom, invalid_owner_abi) == nullptr
		|| invalid_owner_abi || custom->path.parent == nullptr) return false;

	FuncExpr* owned_expression = nullptr;
	std::size_t semantic_calls = 0u;
	for (RestrictInfo* owned : PList<RestrictInfo>(
			custom->custom_restrictinfo)) {
		const std::size_t calls = owned == nullptr ? 0u
			: count_mmsearch_occurrences(
				reinterpret_cast<Node*>(owned->clause),
				get_cached_stub_oids());
		semantic_calls += calls;
		if (calls != 0u) {
			if (calls != 1u || owned_expression != nullptr) return false;
			owned_expression = pg_node_try_as<FuncExpr>(
				reinterpret_cast<Node*>(owned->clause));
			if (owned_expression == nullptr) return false;
		}
	}
	if (semantic_calls != 1u || owned_expression == nullptr) return false;
	const int executable_index = raw_owner ? 8 : 6;
	Node* private_target = reinterpret_cast<Node*>(
		list_nth(custom->custom_private, 4));
	Node* private_query = reinterpret_cast<Node*>(
		list_nth(custom->custom_private, 5));
	FuncExpr* executable_expression = list_length(custom->custom_private)
		> executable_index
		? pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
			list_nth(custom->custom_private, executable_index)))
		: nullptr;
	if (executable_expression == nullptr
		|| !is_mmsearch_funcid(executable_expression->funcid,
			get_cached_stub_oids())
		|| count_mmsearch_occurrences(
			private_target, get_cached_stub_oids()) != 0u
		|| count_mmsearch_occurrences(
			private_query, get_cached_stub_oids()) != 0u
		|| count_mmsearch_occurrences(
			reinterpret_cast<Node*>(executable_expression),
			get_cached_stub_oids()) != 1u) return false;
	FuncExpr* normalized_owned = copyObject(owned_expression);
	if (list_length(normalized_owned->args) == 3) {
		Node* option = reinterpret_cast<Node*>(
			list_nth(normalized_owned->args, 2));
		Node* folded = eval_const_expressions(
			root, reinterpret_cast<Node*>(copyObject(option)));
		Const* folded_const = pg_node_try_as<Const>(folded);
		if (folded_const == nullptr || folded_const->consttype
				!= get_cached_stub_oids().bioseq_aligner_options_type_oid) {
			return false;
		}
		lfirst(list_nth_cell(normalized_owned->args, 2)) = folded;
	}
	if (!equal(normalized_owned, executable_expression)) return false;

	List* variables = pull_var_clause(
		reinterpret_cast<Node*>(owned_expression),
		PVC_RECURSE_AGGREGATES | PVC_RECURSE_WINDOWFUNCS
			| PVC_RECURSE_PLACEHOLDERS);
	for (Node* variable : PList<Node>(variables)) {
		Var* var = pg_node_try_as<Var>(variable);
		if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
			|| var->varlevelsup != 0 || var->varattno <= 0
			|| !bms_is_empty(var->varnullingrels)
			|| !bms_is_member(static_cast<int>(var->varno),
				custom->path.parent->relids)) return false;
	}

	bool children_cover_parent = raw_owner
		? list_length(custom->custom_paths) == 2
		: list_length(custom->custom_paths) == 1;
	if (children_cover_parent && raw_owner) {
		Path* first = reinterpret_cast<Path*>(linitial(custom->custom_paths));
		Path* second = reinterpret_cast<Path*>(lsecond(custom->custom_paths));
		children_cover_parent = first != nullptr && second != nullptr
			&& first->parent != nullptr && second->parent != nullptr
			&& !bms_overlap(first->parent->relids, second->parent->relids);
		Relids child_union = children_cover_parent
			? bms_union(first->parent->relids, second->parent->relids) : nullptr;
		children_cover_parent = children_cover_parent
			&& bms_equal(child_union, custom->path.parent->relids);
		bms_free(child_union);
	} else if (children_cover_parent) {
		Path* child = reinterpret_cast<Path*>(linitial(custom->custom_paths));
		children_cover_parent = child != nullptr && child->parent != nullptr
			&& bms_equal(child->parent->relids, custom->path.parent->relids);
	}
	return children_cover_parent
		&& !custom->path.parallel_aware && !custom->path.parallel_safe
		&& custom->path.parallel_workers == 0
		&& std::isfinite(custom->path.rows) && custom->path.rows >= 0
		&& std::isfinite(custom->path.startup_cost)
		&& custom->path.startup_cost >= 0
		&& std::isfinite(custom->path.total_cost)
		&& custom->path.total_cost >= custom->path.startup_cost;
}

static void count_exact_parameterized_bmo_owners(
		PlannerInfo* root, Path* path, RestrictInfo* restriction,
		ExactParameterizedBmoOwnerProof& proof,
		const bool admit_known_wrapper_owner = false) {
	if (root == nullptr || path == nullptr || restriction == nullptr
		|| proof.invalid) return;
	check_stack_depth();
	if (admit_known_wrapper_owner) {
		for (Node* expression : PList<Node>(
				path->pathtarget == nullptr ? NIL : path->pathtarget->exprs)) {
			if (count_mmsearch_occurrences(
					expression, get_cached_stub_oids()) != 0u) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoNestedJoinClause);
				return;
			}
		}
		for (RestrictInfo* parameter_clause : PList<RestrictInfo>(
				path->param_info == nullptr
					? NIL : path->param_info->ppi_clauses)) {
			if (parameter_clause == nullptr || count_mmsearch_occurrences(
					reinterpret_cast<Node*>(parameter_clause->clause),
					get_cached_stub_oids()) == 0u) continue;
			bool owned_here = false;
			if (IsA(path, CustomPath)) {
				for (RestrictInfo* owned : PList<RestrictInfo>(
						reinterpret_cast<CustomPath*>(path)
							->custom_restrictinfo)) {
					owned_here = owned_here
						|| same_planner_restriction_identity(
							owned, parameter_clause);
				}
			}
			if (!owned_here) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoNestedJoinClause);
				return;
			}
		}
	}
	if (IsA(path, CustomPath)) {
		auto* custom = reinterpret_cast<CustomPath*>(path);
		if (custom->methods == &BioseqColumnScanPathMethods
			&& custom->custom_paths != NIL) {
			/* A BioseqColumnScan is a leaf.  Children would make the owner count
			 * incomplete and therefore invalidate this internal path ABI. */
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoBaseScanHasChildren);
			return;
		}
		bool owns_expected_restriction = false;
		for (RestrictInfo* owned : PList<RestrictInfo>(
				custom->custom_restrictinfo)) {
			owns_expected_restriction = owns_expected_restriction
				|| same_planner_restriction_identity(owned, restriction);
		}
		if (admit_known_wrapper_owner
			&& custom->methods == &BioseqColumnScanPathMethods) {
			bool invalid_owner_abi = false;
			Node* recipe = per_row_base_scan_owner_recipe(
				custom, invalid_owner_abi);
			if (custom->custom_restrictinfo == NIL) {
				if (recipe != nullptr || invalid_owner_abi) {
					reject_exact_parameterized_bmo_owner(
						proof, kExactBmoOwnerAbi);
					return;
				}
			} else {
				if (recipe == nullptr || invalid_owner_abi) {
					reject_exact_parameterized_bmo_owner(
						proof, kExactBmoOwnerAbi);
					return;
				}
				for (RestrictInfo* owned : PList<RestrictInfo>(
						custom->custom_restrictinfo)) {
					if (owned == nullptr || count_mmsearch_occurrences(
							reinterpret_cast<Node*>(owned->clause),
							get_cached_stub_oids()) != 1u
						|| pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
							owned->clause)) == nullptr) {
						reject_exact_parameterized_bmo_owner(
								proof, kExactBmoOwnerAbi);
						return;
					}
				}
				if (custom->path.parallel_aware || custom->path.parallel_safe
					|| custom->path.parallel_workers != 0
					|| !std::isfinite(custom->path.rows)
					|| custom->path.rows < 0
					|| !std::isfinite(custom->path.startup_cost)
					|| custom->path.startup_cost < 0
					|| !std::isfinite(custom->path.total_cost)
					|| custom->path.total_cost < custom->path.startup_cost) {
					reject_exact_parameterized_bmo_owner(
						proof, kExactBmoOwnerAbi);
					return;
				}
			}
			if (list_length(custom->custom_private) < 2) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoOwnerAbi);
				return;
			}
			for (int index = 0; index < 2; ++index) {
				Node* residual_node = reinterpret_cast<Node*>(
					list_nth(custom->custom_private, index));
				if (residual_node != nullptr && !IsA(residual_node, List)) {
					reject_exact_parameterized_bmo_owner(
						proof, kExactBmoOwnerAbi);
					return;
				}
				for (RestrictInfo* residual : PList<RestrictInfo>(
						residual_node == nullptr ? NIL
							: reinterpret_cast<List*>(residual_node))) {
					if (residual != nullptr && count_mmsearch_occurrences(
							reinterpret_cast<Node*>(residual->clause),
							get_cached_stub_oids()) != 0u) {
						reject_exact_parameterized_bmo_owner(
								proof, kExactBmoNestedJoinClause);
						return;
					}
				}
			}
		}
		if (custom->methods == &BioseqColumnScanPathMethods
			&& owns_expected_restriction) {
			std::size_t exact_restriction_count = 0u;
			for (RestrictInfo* owned : PList<RestrictInfo>(
					custom->custom_restrictinfo)) {
				if (same_planner_restriction_identity(
						owned, restriction)) ++exact_restriction_count;
			}
			bool invalid_owner_abi = false;
			Node* recipe = per_row_base_scan_owner_recipe(
				custom, invalid_owner_abi);
			if (invalid_owner_abi || recipe == nullptr) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoOwnerAbi);
				return;
			}
			if (exact_restriction_count != 1u) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoRestrictionMultiplicity);
				return;
			}
			if (custom->path.param_info == nullptr) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoMissingParamInfo);
				return;
			}
			std::size_t ppi_exact_count = 0u;
			for (RestrictInfo* parameter_clause : PList<RestrictInfo>(
					custom->path.param_info->ppi_clauses)) {
				if (same_planner_restriction_identity(
						parameter_clause, restriction)) ++ppi_exact_count;
			}
			if (ppi_exact_count != 1u) {
				reject_exact_parameterized_bmo_owner(
					proof, ppi_exact_count == 0u
						? kExactBmoMissingPpiClause
						: kExactBmoRestrictionMultiplicity);
				return;
			}
			++proof.matches;
			return;
		}
		if (custom->methods == &BioseqColumnScanPathMethods) return;

		const bool known_join_owner =
			custom->methods == &BioseqBatchJoinPathMethods
			|| custom->methods == &BioseqPerRowJoinPathMethods;
		const bool known_slice_wrapper =
			custom->methods == &bioseq_slice_project_path_methods();
		if (!known_join_owner && !known_slice_wrapper) {
			/* Unknown CustomPaths can hide restrictions or private children. */
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoUnknownCustomPath);
			return;
		}
		if (admit_known_wrapper_owner && known_join_owner
			&& !foreign_known_join_owner_is_valid(root, custom)) {
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoKnownWrapperAbi);
			return;
		}
		if (owns_expected_restriction) {
			++proof.wrapper_owns_expected;
			proof.wrapper_method_mask |= custom->methods
				== &BioseqBatchJoinPathMethods ? 1u
				: (custom->methods == &BioseqPerRowJoinPathMethods
					? 2u : (known_slice_wrapper ? 4u : 0u));
			proof.wrapper_restriction_count += static_cast<std::size_t>(
				list_length(custom->custom_restrictinfo));
			proof.wrapper_child_count += static_cast<std::size_t>(
				list_length(custom->custom_paths));
			Node* private_version = custom->custom_private == NIL ? nullptr
				: reinterpret_cast<Node*>(linitial(custom->custom_private));
			proof.wrapper_version = private_version != nullptr
				&& IsA(private_version, Integer)
				? static_cast<std::size_t>(intVal(private_version)) : 0u;
			proof.expected_rinfo_serial = static_cast<std::size_t>(
				restriction->rinfo_serial);
			proof.wrapper_parent_relids_low = exact_bmo_audit_relids_low(
				custom->path.parent == nullptr
					? nullptr : custom->path.parent->relids);
			if (list_length(custom->custom_paths) >= 1) {
				Path* child = reinterpret_cast<Path*>(
					linitial(custom->custom_paths));
				proof.wrapper_child0_relids_low = exact_bmo_audit_relids_low(
					child == nullptr || child->parent == nullptr
						? nullptr : child->parent->relids);
			}
			if (list_length(custom->custom_paths) >= 2) {
				Path* child = reinterpret_cast<Path*>(
					lsecond(custom->custom_paths));
				proof.wrapper_child1_relids_low = exact_bmo_audit_relids_low(
					child == nullptr || child->parent == nullptr
						? nullptr : child->parent->relids);
			}
			FuncExpr* expected_mmsearch = pg_node_try_as<FuncExpr>(
				reinterpret_cast<Node*>(restriction->clause));
			Node* expected_target = expected_mmsearch != nullptr
				&& list_length(expected_mmsearch->args) >= 2
				? reinterpret_cast<Node*>(linitial(expected_mmsearch->args))
				: nullptr;
			Node* expected_query = expected_mmsearch != nullptr
				&& list_length(expected_mmsearch->args) >= 2
				? reinterpret_cast<Node*>(lsecond(expected_mmsearch->args))
				: nullptr;
			Var* expected_target_var = pg_node_try_as<Var>(expected_target);
			Var* expected_query_var = pg_node_try_as<Var>(expected_query);
			proof.expected_target_varno = expected_target_var == nullptr
				? 0u : static_cast<std::size_t>(expected_target_var->varno);
			proof.expected_query_varno = expected_query_var == nullptr
				? 0u : static_cast<std::size_t>(expected_query_var->varno);
			Node* private_target = nullptr;
			Node* private_query = nullptr;
			if (known_join_owner && list_length(custom->custom_private) >= 6) {
				private_target = reinterpret_cast<Node*>(
					list_nth(custom->custom_private, 4));
				private_query = reinterpret_cast<Node*>(
					list_nth(custom->custom_private, 5));
			}
			Var* private_target_var = pg_node_try_as<Var>(private_target);
			Var* private_query_var = pg_node_try_as<Var>(private_query);
			proof.wrapper_private_target_varno = private_target_var == nullptr
				? 0u : static_cast<std::size_t>(private_target_var->varno);
			proof.wrapper_private_query_varno = private_query_var == nullptr
				? 0u : static_cast<std::size_t>(private_query_var->varno);
			proof.wrapper_private_target_equal =
				private_target != nullptr && equal(private_target, expected_target)
					? 1u : 0u;
			proof.wrapper_private_query_equal =
				private_query != nullptr && equal(private_query, expected_query)
					? 1u : 0u;
			std::size_t owner_index = 0u;
			for (RestrictInfo* owned : PList<RestrictInfo>(
					custom->custom_restrictinfo)) {
				if (owned == restriction) ++proof.wrapper_pointer_matches;
				if (owned != nullptr && owned->rinfo_serial > 0
					&& owned->rinfo_serial == restriction->rinfo_serial) {
					++proof.wrapper_serial_matches;
				}
				if (owned != nullptr
					&& equal(owned->clause, restriction->clause)) {
					++proof.wrapper_clause_matches;
				}
				if (same_planner_restriction_identity(owned, restriction)) {
					proof.wrapper_rinfo_serial = static_cast<std::size_t>(
						owned->rinfo_serial);
				}
				FuncExpr* owned_mmsearch = owned == nullptr ? nullptr
					: pg_node_try_as<FuncExpr>(
						reinterpret_cast<Node*>(owned->clause));
				Var* owned_target = owned_mmsearch != nullptr
					&& list_length(owned_mmsearch->args) >= 2
					? pg_node_try_as<Var>(reinterpret_cast<Node*>(
						linitial(owned_mmsearch->args))) : nullptr;
				Var* owned_query = owned_mmsearch != nullptr
					&& list_length(owned_mmsearch->args) >= 2
					? pg_node_try_as<Var>(reinterpret_cast<Node*>(
						lsecond(owned_mmsearch->args))) : nullptr;
				if (owner_index == 0u) {
					proof.wrapper_owner0_target_varno = owned_target == nullptr
						? 0u : static_cast<std::size_t>(owned_target->varno);
					proof.wrapper_owner0_query_varno = owned_query == nullptr
						? 0u : static_cast<std::size_t>(owned_query->varno);
				} else if (owner_index == 1u) {
					proof.wrapper_owner1_target_varno = owned_target == nullptr
						? 0u : static_cast<std::size_t>(owned_target->varno);
					proof.wrapper_owner1_query_varno = owned_query == nullptr
						? 0u : static_cast<std::size_t>(owned_query->varno);
				}
				++owner_index;
			}
			if (!admit_known_wrapper_owner || !known_join_owner) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoKnownWrapperOwnsClause);
				return;
			}
			bool invalid_wrapper_abi = false;
			Node* owner_recipe = per_row_known_path_owner_recipe(
				custom, invalid_wrapper_abi);
			std::size_t exact_owner_count = 0u;
			std::size_t wrapper_mmsearch_count = 0u;
			FuncExpr* owned_mmsearch = nullptr;
			for (RestrictInfo* owned : PList<RestrictInfo>(
					custom->custom_restrictinfo)) {
				const std::size_t calls = owned == nullptr ? 0u
					: count_mmsearch_occurrences(
						reinterpret_cast<Node*>(owned->clause),
						get_cached_stub_oids());
				if (same_planner_restriction_identity(owned, restriction)) {
					++exact_owner_count;
					owned_mmsearch = calls == 1u
						? pg_node_try_as<FuncExpr>(
							reinterpret_cast<Node*>(owned->clause)) : nullptr;
				}
				wrapper_mmsearch_count += calls;
			}
			const int executable_index = custom->methods
				== &BioseqBatchJoinPathMethods ? 8 : 6;
			FuncExpr* executable_mmsearch = list_length(custom->custom_private)
				> executable_index
				? pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
					list_nth(custom->custom_private, executable_index)))
				: nullptr;
			PList<Node> expected_operands(expected_mmsearch == nullptr
				? NIL : expected_mmsearch->args);
			PList<Node> executable_operands(executable_mmsearch == nullptr
				? NIL : executable_mmsearch->args);
			const bool executable_shape = executable_mmsearch != nullptr
				&& is_mmsearch_funcid(executable_mmsearch->funcid,
					get_cached_stub_oids())
				&& (list_length(executable_mmsearch->args) == 2
					|| list_length(executable_mmsearch->args) == 3)
				&& expected_operands.length() >= 2
				&& executable_operands.length() >= 2
				&& equal(executable_operands.first(), expected_operands.first())
				&& equal(executable_operands.second(), expected_operands.second());
			Var* owner_target_var = expected_operands.length() >= 2
				? pg_node_try_as<Var>(expected_operands.first()) : nullptr;
			Var* owner_query_var = expected_operands.length() >= 2
				? pg_node_try_as<Var>(expected_operands.second()) : nullptr;
			const bool owner_parent_contains_operands = custom->path.parent != nullptr
				&& owner_target_var != nullptr && owner_query_var != nullptr
				&& bms_is_member(static_cast<int>(owner_target_var->varno),
					custom->path.parent->relids)
				&& bms_is_member(static_cast<int>(owner_query_var->varno),
					custom->path.parent->relids);
			bool owner_children_cover_parent = custom->path.parent != nullptr
				&& ((custom->methods == &BioseqBatchJoinPathMethods
						&& list_length(custom->custom_paths) == 2)
					|| (custom->methods == &BioseqPerRowJoinPathMethods
						&& list_length(custom->custom_paths) == 1));
			if (owner_children_cover_parent
				&& custom->methods == &BioseqBatchJoinPathMethods) {
				Path* first_child = reinterpret_cast<Path*>(
					linitial(custom->custom_paths));
				Path* second_child = reinterpret_cast<Path*>(
					lsecond(custom->custom_paths));
				owner_children_cover_parent = first_child != nullptr
					&& second_child != nullptr
					&& first_child->parent != nullptr
					&& second_child->parent != nullptr
					&& !bms_overlap(first_child->parent->relids,
						second_child->parent->relids);
				Relids child_union = owner_children_cover_parent
					? bms_union(first_child->parent->relids,
						second_child->parent->relids) : nullptr;
				owner_children_cover_parent = owner_children_cover_parent
					&& bms_equal(child_union, custom->path.parent->relids);
				bms_free(child_union);
			} else if (owner_children_cover_parent) {
				Path* child = reinterpret_cast<Path*>(
					linitial(custom->custom_paths));
				owner_children_cover_parent = child != nullptr
					&& child->parent != nullptr
					&& bms_equal(child->parent->relids,
						custom->path.parent->relids);
			}
			if (invalid_wrapper_abi || owner_recipe == nullptr
				|| exact_owner_count != 1u || wrapper_mmsearch_count != 1u
				|| owned_mmsearch == nullptr || !executable_shape
				|| !owner_parent_contains_operands || !owner_children_cover_parent
				|| custom->path.parallel_aware
				|| custom->path.parallel_safe
				|| custom->path.parallel_workers != 0
				|| !std::isfinite(custom->path.rows)
				|| custom->path.rows < 0
				|| !std::isfinite(custom->path.startup_cost)
				|| custom->path.startup_cost < 0
				|| !std::isfinite(custom->path.total_cost)
				|| custom->path.total_cost < custom->path.startup_cost) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoKnownWrapperAbi);
				return;
			}
			++proof.matches;
			for (Path* child : PList<Path>(custom->custom_paths)) {
				count_exact_parameterized_bmo_owners(
					root, child, restriction, proof,
					admit_known_wrapper_owner);
			}
			return;
		}
		bool invalid_wrapper_abi = false;
		if (known_join_owner
			&& per_row_known_path_owner_recipe(
				custom, invalid_wrapper_abi) == nullptr) {
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoKnownWrapperAbi);
			return;
		}
		if (known_slice_wrapper && list_length(custom->custom_paths) != 1) {
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoKnownWrapperAbi);
			return;
		}
		for (Path* child : PList<Path>(custom->custom_paths)) {
			count_exact_parameterized_bmo_owners(
				root, child, restriction, proof,
				admit_known_wrapper_owner);
		}
		return;
	}
	if (IsA(path, NestPath) || IsA(path, MergePath) || IsA(path, HashPath)) {
		auto* join = reinterpret_cast<JoinPath*>(path);
		bool nested_owns_expected = false;
		for (RestrictInfo* nested : PList<RestrictInfo>(
				join->joinrestrictinfo)) {
			if (admit_known_wrapper_owner && nested != nullptr
				&& count_mmsearch_occurrences(
					reinterpret_cast<Node*>(nested->clause),
					get_cached_stub_oids()) != 0u) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoNestedJoinClause);
				return;
			}
			nested_owns_expected = nested_owns_expected
				|| same_planner_restriction_identity(nested, restriction);
		}
		List* algorithm_clauses = IsA(path, MergePath)
			? reinterpret_cast<MergePath*>(path)->path_mergeclauses
			: (IsA(path, HashPath)
				? reinterpret_cast<HashPath*>(path)->path_hashclauses : NIL);
		if (admit_known_wrapper_owner) {
			for (RestrictInfo* algorithm_clause : PList<RestrictInfo>(
					algorithm_clauses)) {
				if (algorithm_clause != nullptr && count_mmsearch_occurrences(
						reinterpret_cast<Node*>(algorithm_clause->clause),
						get_cached_stub_oids()) != 0u) {
					reject_exact_parameterized_bmo_owner(
						proof, kExactBmoNestedJoinClause);
					return;
				}
			}
		}
		if (nested_owns_expected) {
			reject_exact_parameterized_bmo_owner(
				proof, kExactBmoNestedJoinClause);
			return;
		}
		count_exact_parameterized_bmo_owners(
			root, join->outerjoinpath, restriction, proof,
			admit_known_wrapper_owner);
		count_exact_parameterized_bmo_owners(
			root, join->innerjoinpath, restriction, proof,
			admit_known_wrapper_owner);
		return;
	}
	Path* unary = nullptr;
	if (IsA(path, ProjectionPath)) {
		unary = reinterpret_cast<ProjectionPath*>(path)->subpath;
	} else if (IsA(path, ProjectSetPath)) {
		unary = reinterpret_cast<ProjectSetPath*>(path)->subpath;
	} else if (IsA(path, SortPath)) {
		unary = reinterpret_cast<SortPath*>(path)->subpath;
	} else if (IsA(path, IncrementalSortPath)) {
		unary = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
	} else if (IsA(path, MaterialPath)) {
		unary = reinterpret_cast<MaterialPath*>(path)->subpath;
	} else if (IsA(path, MemoizePath)) {
		unary = reinterpret_cast<MemoizePath*>(path)->subpath;
	} else if (IsA(path, UniquePath)) {
		unary = reinterpret_cast<UniquePath*>(path)->subpath;
	} else if (IsA(path, GatherPath)) {
		unary = reinterpret_cast<GatherPath*>(path)->subpath;
	} else if (IsA(path, GatherMergePath)) {
		unary = reinterpret_cast<GatherMergePath*>(path)->subpath;
	}
	if (unary != nullptr) {
		count_exact_parameterized_bmo_owners(
			root, unary, restriction, proof, admit_known_wrapper_owner);
		return;
	}
	if (IsA(path, AppendPath)) {
		for (Path* child : PList<Path>(
				reinterpret_cast<AppendPath*>(path)->subpaths)) {
			count_exact_parameterized_bmo_owners(
				root, child, restriction, proof,
				admit_known_wrapper_owner);
		}
		return;
	}
	if (IsA(path, MergeAppendPath)) {
		for (Path* child : PList<Path>(
				reinterpret_cast<MergeAppendPath*>(path)->subpaths)) {
			count_exact_parameterized_bmo_owners(
				root, child, restriction, proof,
				admit_known_wrapper_owner);
		}
		return;
	}
	if (IsA(path, GroupResultPath)) {
		/* GroupResultPath is childless, but its bare HAVING quals are executable
		 * and are not represented by pathtarget or ParamPathInfo.  It can never
		 * own a BMO restriction, so any surviving mmsearch here invalidates the
		 * closed-world owner count instead of disappearing behind a leaf tag. */
		for (Node* qual : PList<Node>(
				reinterpret_cast<GroupResultPath*>(path)->quals)) {
			if (count_mmsearch_occurrences(
					qual, get_cached_stub_oids()) != 0u) {
				reject_exact_parameterized_bmo_owner(
					proof, kExactBmoNestedJoinClause);
				return;
			}
		}
		return;
	}
	/* Closed-world proof: these are the only childless core Path variants
	 * admitted as leaves.  Any other tag may hide a child/owner layout this
	 * narrow fallback does not understand. */
	if (IsA(path, Path) || IsA(path, IndexPath)
		|| IsA(path, TidPath) || IsA(path, TidRangePath)) return;
	reject_exact_parameterized_bmo_owner(
		proof, kExactBmoUnknownCorePath);
}

enum ExactParameterizedBmoReconstructionRejection : std::uint32_t {
	kExactBmoReconstructInvalidInput = 1u << 0,
	kExactBmoReconstructOperandShape = 1u << 1,
	kExactBmoReconstructTargetRel = 1u << 2,
	kExactBmoReconstructTargetRte = 1u << 3,
	kExactBmoReconstructRequiredOuter = 1u << 4,
	kExactBmoReconstructBaseMmsearch = 1u << 5,
	kExactBmoReconstructPathShape = 1u << 6,
	kExactBmoReconstructOwnerProof = 1u << 7,
	kExactBmoReconstructOwnerMultiplicity = 1u << 8,
	kExactBmoReconstructPpi = 1u << 9,
	kExactBmoReconstructOwnerAbi = 1u << 10,
	kExactBmoReconstructResidualMmsearch = 1u << 11,
	kExactBmoReconstructParallel = 1u << 12,
	kExactBmoReconstructCost = 1u << 13,
};

enum ExactParameterizedBmoReconstructionAbiMismatch : std::uint32_t {
	kExactBmoReconstructAbiInvalidTag = 1u << 0,
	kExactBmoReconstructAbiMissingRecipe = 1u << 1,
	kExactBmoReconstructAbiRecipeTarget = 1u << 2,
	kExactBmoReconstructAbiTagMultiplicity = 1u << 3,
	kExactBmoReconstructAbiExpressionMultiplicity = 1u << 4,
	kExactBmoReconstructAbiExpressionShape = 1u << 5,
	kExactBmoReconstructAbiExpressionTarget = 1u << 6,
	kExactBmoReconstructAbiDynamicQuery = 1u << 7,
	kExactBmoReconstructAbiDynamicMultiplicity = 1u << 8,
	kExactBmoReconstructAbiConstantShape = 1u << 9,
	kExactBmoReconstructAbiConstantMultiplicity = 1u << 10,
	kExactBmoReconstructAbiMissingDynamic = 1u << 11,
	kExactBmoReconstructAbiMissingConstant = 1u << 12,
	kExactBmoReconstructAbiUnexpectedConstant = 1u << 13,
	kExactBmoReconstructAbiIncompatibleOptions = 1u << 14,
};

struct ExactParameterizedBmoReconstructionAudit {
	std::uint32_t rejection_mask = 0u;
	std::uint32_t owner_abi_mismatch_mask = 0u;
	std::size_t expected_owner_count = 0u;
	std::size_t owner_tag_count = 0u;
	std::size_t owner_expression_count = 0u;
};

/* Core may discard a parameterized CustomPath before the higher join frontier
 * is formed.  Rebuild only the exact baserel recipe needed by that frontier;
 * AddBioseqColumnScanPath performs the normal selectivity/alignment costing
 * and does not add the result to RelOptInfo::pathlist.  The returned path is
 * private to the constructed NestPath below. */
[[nodiscard]] static Path* reconstruct_exact_parameterized_bmo_inner(
		PlannerInfo* root, RelOptInfo* target_input,
		RelOptInfo* provider_input, RestrictInfo* restriction,
		FuncExpr* mmsearch, ExactParameterizedBmoReconstructionAudit& audit) {
	audit = {};
	auto reject = [&audit](
			const ExactParameterizedBmoReconstructionRejection reason)
				noexcept -> Path* {
		audit.rejection_mask |= static_cast<std::uint32_t>(reason);
		return nullptr;
	};
	if (root == nullptr || root->parse == nullptr || target_input == nullptr
		|| provider_input == nullptr || restriction == nullptr
		|| mmsearch == nullptr || list_length(mmsearch->args) < 2) {
		return reject(kExactBmoReconstructInvalidInput);
	}
	PList<Node> operands(mmsearch->args);
	Var* target_var = pg_node_try_as<Var>(operands.first());
	Var* query_var = pg_node_try_as<Var>(operands.second());
	const BioseqStubOids& oids = get_cached_stub_oids();
	if (target_var == nullptr || query_var == nullptr
		|| !bioseq_is_concrete_rte_varno(target_var->varno)
		|| !bioseq_is_concrete_rte_varno(query_var->varno)
		|| target_var->varlevelsup != 0 || query_var->varlevelsup != 0
		|| target_var->varattno <= 0 || query_var->varattno <= 0
		|| !bms_is_empty(target_var->varnullingrels)
		|| !bms_is_empty(query_var->varnullingrels)
		|| target_var->vartype != oids.bioseq_seq_type_oid
		|| query_var->vartype != oids.bioseq_seq_type_oid
		|| !mmsearch_typmods_share_alphabet(
			target_var->vartypmod, query_var->vartypmod)
		|| target_var->varcollid != query_var->varcollid) {
		return reject(kExactBmoReconstructOperandShape);
	}
	if (target_input->reloptkind != RELOPT_BASEREL
		|| target_input->relid != target_var->varno
		|| bms_num_members(target_input->relids) != 1
		|| !bms_is_member(
			static_cast<int>(target_var->varno), target_input->relids)
		|| !bms_is_member(
			static_cast<int>(query_var->varno), provider_input->relids)
		|| bms_overlap(target_input->relids, provider_input->relids)) {
		return reject(kExactBmoReconstructTargetRel);
	}
	if (target_input->relid <= 0
		|| target_input->relid >= root->simple_rel_array_size
		|| root->simple_rel_array[target_input->relid] != target_input
		|| target_input->relid > static_cast<Index>(
			list_length(root->parse->rtable))) {
		return reject(kExactBmoReconstructTargetRel);
	}
	RangeTblEntry* target_rte = rt_fetch(
		target_input->relid, root->parse->rtable);
	if (target_rte == nullptr || target_rte->rtekind != RTE_RELATION
		|| target_rte->securityQuals != NIL || !OidIsValid(target_rte->relid)
		|| !IsBioseqColumnTableAmTable(target_rte->relid)) {
		return reject(kExactBmoReconstructTargetRte);
	}

	PList<RestrictInfo> base_mmsearch_restrictions;
	FuncExpr* base_mmsearch = nullptr;
	for (RestrictInfo* base : PList<RestrictInfo>(
			target_input->baserestrictinfo)) {
		const std::size_t calls = base == nullptr ? 0u
			: count_mmsearch_occurrences(
				reinterpret_cast<Node*>(base->clause), oids);
		if (calls == 0u) continue;
		FuncExpr* expression = calls == 1u
			? pg_node_try_as<FuncExpr>(
				reinterpret_cast<Node*>(base->clause)) : nullptr;
		if (expression == nullptr || !is_mmsearch_funcid(
				expression->funcid, oids)
			|| (expression->funcid == oids.mmsearch_oid
				&& list_length(expression->args) != 2)
			|| (expression->funcid == oids.mmsearch_with_opts_oid
				&& list_length(expression->args) != 3)
			|| base_mmsearch != nullptr) {
			return reject(kExactBmoReconstructBaseMmsearch);
		}
		PList<Node> base_operands(expression->args);
		Const* constant_query = pg_node_try_as<Const>(base_operands.second());
		if (!equal(base_operands.first(), target_var)
			|| constant_query == nullptr || constant_query->constisnull
			|| constant_query->consttype != oids.bioseq_seq_type_oid
			|| !mmsearch_typmods_share_alphabet(
				target_var->vartypmod, constant_query->consttypmod)) {
			return reject(kExactBmoReconstructBaseMmsearch);
		}
		base_mmsearch = expression;
		base_mmsearch_restrictions.append(base);
	}
	if (base_mmsearch != nullptr) {
		if (query_var->varno > static_cast<Index>(
				list_length(root->parse->rtable))) {
			return reject(kExactBmoReconstructBaseMmsearch);
		}
		RangeTblEntry* query_rte = rt_fetch(
			query_var->varno, root->parse->rtable);
		FuncExpr* normalized_primary = copyObject(mmsearch);
		if (list_length(normalized_primary->args) == 3) {
			Node* option_expression = reinterpret_cast<Node*>(
				list_nth(normalized_primary->args, 2));
			Node* folded = eval_const_expressions(root,
				reinterpret_cast<Node*>(copyObject(option_expression)));
			lfirst(list_nth_cell(normalized_primary->args, 2)) = folded;
		}
		if (query_rte == nullptr || query_rte->rtekind != RTE_RELATION
			|| query_rte->securityQuals != NIL || !OidIsValid(query_rte->relid)
			|| IsBioseqColumnTableAmTable(query_rte->relid)
			|| !bounded_batch_fallback_options_are_supported(
				normalized_primary, base_mmsearch, oids)) {
			return reject(kExactBmoReconstructBaseMmsearch);
		}
	}

	Relids required_outer = bms_add_member(
		bms_copy(target_input->lateral_relids),
		static_cast<int>(query_var->varno));
	if (required_outer == nullptr
		|| bms_overlap(required_outer, target_input->relids)
		|| !bms_is_subset(required_outer, provider_input->relids)) {
		bms_free(required_outer);
		return reject(kExactBmoReconstructRequiredOuter);
	}
	Path* candidate = AddBioseqColumnScanPath(
		root, target_input, target_rte, required_outer);
	/* get_baserel_parampathinfo may retain required_outer in the planner's PPI;
	 * it therefore remains planner-owned after the constructor call. */
	auto* custom = candidate != nullptr && IsA(candidate, CustomPath)
		? reinterpret_cast<CustomPath*>(candidate) : nullptr;
	if (custom == nullptr || custom->methods != &BioseqColumnScanPathMethods
		|| candidate->parent != target_input
		|| candidate->pathtype != T_CustomScan
		|| list_length(custom->custom_private) != 3) {
		return reject(kExactBmoReconstructPathShape);
	}
	ExactParameterizedBmoOwnerProof owner_proof{};
	count_exact_parameterized_bmo_owners(
		root, candidate, restriction, owner_proof);
	if (owner_proof.invalid) {
		audit.rejection_mask |= owner_proof.rejection_mask << 16;
		return reject(kExactBmoReconstructOwnerProof);
	}
	if (owner_proof.matches != 1u) {
		return reject(kExactBmoReconstructOwnerMultiplicity);
	}
	const std::size_t expected_owner_count = 1u
		+ static_cast<std::size_t>(base_mmsearch_restrictions.length());
	audit.expected_owner_count = expected_owner_count;
	if (expected_owner_count > 2u
		|| list_length(custom->custom_restrictinfo)
			!= static_cast<int>(expected_owner_count)) {
		return reject(kExactBmoReconstructOwnerMultiplicity);
	}
	std::size_t dynamic_owner_count = 0u;
	std::size_t base_owner_count = 0u;
	for (RestrictInfo* owned : PList<RestrictInfo>(
			custom->custom_restrictinfo)) {
		if (same_planner_restriction_identity(owned, restriction)) {
			++dynamic_owner_count;
		} else if (list_member_ptr(
				base_mmsearch_restrictions.ptr(), owned)) {
			++base_owner_count;
		} else {
			return reject(kExactBmoReconstructOwnerMultiplicity);
		}
	}
	if (dynamic_owner_count != 1u
		|| base_owner_count
			!= static_cast<std::size_t>(base_mmsearch_restrictions.length())) {
		return reject(kExactBmoReconstructOwnerMultiplicity);
	}
	if (candidate->param_info == nullptr
		|| !bms_equal(PATH_REQ_OUTER(candidate), required_outer)
		|| !bms_is_member(
			static_cast<int>(query_var->varno), PATH_REQ_OUTER(candidate))
		|| !bms_is_subset(
			PATH_REQ_OUTER(candidate), provider_input->relids)) {
		return reject(kExactBmoReconstructPpi);
	}
	std::size_t ppi_dynamic_count = 0u;
	for (RestrictInfo* ppi_clause : PList<RestrictInfo>(
			candidate->param_info->ppi_clauses)) {
		const std::size_t calls = ppi_clause == nullptr ? 0u
			: count_mmsearch_occurrences(
				reinterpret_cast<Node*>(ppi_clause->clause), oids);
		if (same_planner_restriction_identity(ppi_clause, restriction)) {
			++ppi_dynamic_count;
			if (calls != 1u) return reject(kExactBmoReconstructPpi);
		} else if (calls != 0u) {
			return reject(kExactBmoReconstructPpi);
		}
	}
	if (ppi_dynamic_count != 1u) {
		return reject(kExactBmoReconstructPpi);
	}

	bool invalid_owner_abi = false;
	Node* owner_recipe = per_row_base_scan_owner_recipe(
		custom, invalid_owner_abi);
	List* owner_expressions = NIL;
	std::size_t owner_tag_count = 0u;
	for (Node* private_node : PList<Node>(custom->custom_private)) {
		if (private_node == nullptr || !IsA(private_node, List)) continue;
		List* tag = reinterpret_cast<List*>(private_node);
		Node* magic = list_length(tag) >= 1
			? reinterpret_cast<Node*>(linitial(tag)) : nullptr;
		if (magic == nullptr || !IsA(magic, Integer)
			|| intVal(magic) != kBioseqMmsearchOwnerMagic) continue;
		++owner_tag_count;
		Node* expressions = list_length(tag) == 3
			? reinterpret_cast<Node*>(list_nth(tag, 2)) : nullptr;
		if (list_length(tag) != 3
			|| !IsA(reinterpret_cast<Node*>(list_nth(tag, 1)), Integer)
			|| intVal(list_nth(tag, 1)) != kBioseqMmsearchOwnerVersion
			|| expressions == nullptr || !IsA(expressions, List)) {
			invalid_owner_abi = true;
		} else {
			owner_expressions = reinterpret_cast<List*>(expressions);
		}
	}
	audit.owner_tag_count = owner_tag_count;
	audit.owner_expression_count = static_cast<std::size_t>(
		list_length(owner_expressions));
	if (invalid_owner_abi) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiInvalidTag;
	}
	if (owner_recipe == nullptr) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiMissingRecipe;
	} else if (!equal(owner_recipe, target_var)) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiRecipeTarget;
	}
	if (owner_tag_count != 1u) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiTagMultiplicity;
	}
	if (list_length(owner_expressions)
			!= static_cast<int>(expected_owner_count)) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiExpressionMultiplicity;
	}
	if (audit.owner_abi_mismatch_mask != 0u) {
		return reject(kExactBmoReconstructOwnerAbi);
	}
	FuncExpr* dynamic_expression = nullptr;
	FuncExpr* constant_expression = nullptr;
	for (int index = 0; index < static_cast<int>(expected_owner_count);
			++index) {
		RestrictInfo* owned = reinterpret_cast<RestrictInfo*>(
			list_nth(custom->custom_restrictinfo, index));
		FuncExpr* expression = pg_node_try_as<FuncExpr>(
			reinterpret_cast<Node*>(list_nth(owner_expressions, index)));
		if (expression == nullptr || list_length(expression->args) < 2) {
			audit.owner_abi_mismatch_mask |=
				kExactBmoReconstructAbiExpressionShape;
			return reject(kExactBmoReconstructOwnerAbi);
		}
		if (!equal(linitial(expression->args), target_var)) {
			audit.owner_abi_mismatch_mask |=
				kExactBmoReconstructAbiExpressionTarget;
			return reject(kExactBmoReconstructOwnerAbi);
		}
		if (same_planner_restriction_identity(owned, restriction)) {
			if (!equal(lsecond(expression->args), query_var)) {
				audit.owner_abi_mismatch_mask |=
					kExactBmoReconstructAbiDynamicQuery;
				return reject(kExactBmoReconstructOwnerAbi);
			}
			if (dynamic_expression != nullptr) {
				audit.owner_abi_mismatch_mask |=
					kExactBmoReconstructAbiDynamicMultiplicity;
				return reject(kExactBmoReconstructOwnerAbi);
			}
			dynamic_expression = expression;
		} else {
			Const* constant = pg_node_try_as<Const>(
				reinterpret_cast<Node*>(lsecond(expression->args)));
			if (constant == nullptr || constant->constisnull) {
				audit.owner_abi_mismatch_mask |=
					kExactBmoReconstructAbiConstantShape;
				return reject(kExactBmoReconstructOwnerAbi);
			}
			if (constant_expression != nullptr) {
				audit.owner_abi_mismatch_mask |=
					kExactBmoReconstructAbiConstantMultiplicity;
				return reject(kExactBmoReconstructOwnerAbi);
			}
			constant_expression = expression;
		}
	}
	if (dynamic_expression == nullptr) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiMissingDynamic;
	}
	if (base_mmsearch != nullptr && constant_expression == nullptr) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiMissingConstant;
	}
	if (base_mmsearch == nullptr && constant_expression != nullptr) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiUnexpectedConstant;
	}
	if (base_mmsearch != nullptr && dynamic_expression != nullptr
		&& constant_expression != nullptr
		&& !bounded_batch_fallback_options_are_supported(
			dynamic_expression, constant_expression, oids)) {
		audit.owner_abi_mismatch_mask |=
			kExactBmoReconstructAbiIncompatibleOptions;
	}
	if (audit.owner_abi_mismatch_mask != 0u) {
		return reject(kExactBmoReconstructOwnerAbi);
	}
	for (int index = 0; index < 2; ++index) {
		Node* residual_node = reinterpret_cast<Node*>(
			list_nth(custom->custom_private, index));
		if (residual_node != nullptr && !IsA(residual_node, List)) {
			return reject(kExactBmoReconstructOwnerAbi);
		}
		for (RestrictInfo* residual : PList<RestrictInfo>(
				residual_node == nullptr ? NIL
					: reinterpret_cast<List*>(residual_node))) {
			if (residual != nullptr && count_mmsearch_occurrences(
					reinterpret_cast<Node*>(residual->clause), oids) != 0u) {
				return reject(kExactBmoReconstructResidualMmsearch);
			}
		}
	}
	if (candidate->parallel_aware || candidate->parallel_safe
		|| candidate->parallel_workers != 0) {
		return reject(kExactBmoReconstructParallel);
	}
	if (!std::isfinite(candidate->rows) || candidate->rows < 0
		|| !std::isfinite(candidate->startup_cost)
		|| candidate->startup_cost < 0
		|| !std::isfinite(candidate->total_cost)
		|| candidate->total_cost < candidate->startup_cost) {
		return reject(kExactBmoReconstructCost);
	}
	return candidate;
}

struct ExactParameterizedBmoRetainerAudit {
	std::size_t candidates = 0u;
	std::size_t nest_paths = 0u;
	std::size_t inner_nest_paths = 0u;
	std::size_t root_owned_clause_paths = 0u;
	std::size_t root_foreign_mmsearch_paths = 0u;
	std::size_t outer_matches = 0u;
	std::size_t inner_matches = 0u;
	std::size_t retained_paths = 0u;
	std::size_t available_bmo_paths = 0u;
	std::size_t compatible_bmo_paths = 0u;
	std::size_t available_outer_paths = 0u;
	std::size_t constructed_paths = 0u;
	std::size_t reconstructed_bmo_attempts = 0u;
	std::size_t reconstructed_bmo_paths = 0u;
	std::size_t target_var_resolved = 0u;
	std::size_t query_var_resolved = 0u;
	std::uint32_t target_relid_side_mask = 0u;
	std::uint32_t target_base_side_mask = 0u;
	std::uint32_t query_relid_side_mask = 0u;
	std::size_t provider_has_query = 0u;
	std::size_t target_paths = 0u;
	std::size_t target_custom_paths = 0u;
	std::size_t target_bioseq_paths = 0u;
	std::size_t target_bmo_tags = 0u;
	std::size_t target_custom_restrictions = 0u;
	std::size_t target_custom_pointer_matches = 0u;
	std::size_t target_custom_serial_matches = 0u;
	std::size_t target_custom_clause_matches = 0u;
	std::size_t target_custom_exact_matches = 0u;
	std::size_t target_ppi_paths = 0u;
	std::size_t target_ppi_clauses = 0u;
	std::size_t target_ppi_serial_matches = 0u;
	std::size_t target_ppi_clause_matches = 0u;
	std::size_t target_ppi_exact_matches = 0u;
	std::uint32_t outer_rejection_mask = 0u;
	std::uint32_t inner_rejection_mask = 0u;
	std::uint32_t target_owner_rejection_mask = 0u;
	std::uint32_t target_abi_mismatch_mask = 0u;
	std::uint32_t target_ppi_mismatch_mask = 0u;
	std::uint32_t target_compatibility_mismatch_mask = 0u;
	std::uint32_t reconstructed_bmo_rejection_mask = 0u;
	std::uint32_t reconstructed_owner_abi_mismatch_mask = 0u;
	std::size_t reconstructed_expected_owner_count = 0u;
	std::size_t reconstructed_owner_tag_count = 0u;
	std::size_t reconstructed_owner_expression_count = 0u;
	std::uint64_t joinrel_relids_low = 0u;
	std::uint64_t left_relids_low = 0u;
	std::uint64_t right_relids_low = 0u;
	std::size_t left_relid_count = 0u;
	std::size_t right_relid_count = 0u;
	std::uint32_t wrapper_side_mask = 0u;
	std::size_t wrapper_owns_expected = 0u;
	std::uint32_t wrapper_method_mask = 0u;
	std::size_t wrapper_version = 0u;
	std::size_t wrapper_restriction_count = 0u;
	std::size_t wrapper_child_count = 0u;
	std::size_t wrapper_pointer_matches = 0u;
	std::size_t wrapper_serial_matches = 0u;
	std::size_t wrapper_clause_matches = 0u;
	std::size_t wrapper_expected_serial = 0u;
	std::size_t wrapper_owned_serial = 0u;
	std::size_t wrapper_expected_target_varno = 0u;
	std::size_t wrapper_expected_query_varno = 0u;
	std::size_t wrapper_private_target_varno = 0u;
	std::size_t wrapper_private_query_varno = 0u;
	std::size_t wrapper_private_target_equal = 0u;
	std::size_t wrapper_private_query_equal = 0u;
	std::size_t wrapper_owner0_target_varno = 0u;
	std::size_t wrapper_owner0_query_varno = 0u;
	std::size_t wrapper_owner1_target_varno = 0u;
	std::size_t wrapper_owner1_query_varno = 0u;
	std::uint64_t wrapper_parent_relids_low = 0u;
	std::uint64_t wrapper_child0_relids_low = 0u;
	std::uint64_t wrapper_child1_relids_low = 0u;
	std::size_t current_pair_paths = 0u;
	std::size_t foreign_decomposition_paths = 0u;
	std::size_t safe_foreign_paths = 0u;
	std::size_t foreign_owner_matches = 0u;
	std::uint32_t foreign_rejection_mask = 0u;
	std::uint32_t foreign_owner_rejection_mask = 0u;
};

enum ExactParameterizedBmoRetainerAbiMismatch : std::uint32_t {
	kExactBmoRetainerInvalidOwnerTag = 1u << 0,
	kExactBmoRetainerMissingCustomRestriction = 1u << 1,
	kExactBmoRetainerMissingCustomSerial = 1u << 2,
	kExactBmoRetainerMissingCustomClause = 1u << 3,
	kExactBmoRetainerMissingCustomIdentity = 1u << 4,
	kExactBmoRetainerMultipleCustomIdentities = 1u << 5,
};

enum ExactParameterizedBmoRetainerPpiMismatch : std::uint32_t {
	kExactBmoRetainerMissingParamInfo = 1u << 0,
	kExactBmoRetainerEmptyPpiClauses = 1u << 1,
	kExactBmoRetainerMissingPpiSerial = 1u << 2,
	kExactBmoRetainerMissingPpiClause = 1u << 3,
	kExactBmoRetainerMissingPpiIdentity = 1u << 4,
	kExactBmoRetainerMultiplePpiIdentities = 1u << 5,
};

enum ExactParameterizedBmoRetainerCompatibilityMismatch : std::uint32_t {
	kExactBmoRetainerCandidateParent = 1u << 0,
	kExactBmoRetainerCandidateOwnerProof = 1u << 1,
	kExactBmoRetainerCandidateOwnerMultiplicity = 1u << 2,
	kExactBmoRetainerCandidateUnparameterized = 1u << 3,
	kExactBmoRetainerCandidateMissingQueryRelid = 1u << 4,
	kExactBmoRetainerCandidateForeignRequiredOuter = 1u << 5,
	kExactBmoRetainerCandidateParallel = 1u << 6,
	kExactBmoRetainerCandidateNonfiniteCost = 1u << 7,
	kExactBmoRetainerCandidateNegativeCost = 1u << 8,
};

[[nodiscard]] static bool retain_join_paths_with_custom_restriction_owner(
		PlannerInfo* root, RelOptInfo* joinrel,
		RelOptInfo* left_input, RelOptInfo* right_input,
		JoinPathExtraData* extra, RestrictInfo* restriction,
		FuncExpr* mmsearch,
		ExactParameterizedBmoRetainerAudit* audit = nullptr) {
	if (root == nullptr || joinrel == nullptr || left_input == nullptr
		|| right_input == nullptr || extra == nullptr || restriction == nullptr
		|| mmsearch == nullptr || list_length(mmsearch->args) < 2) return false;
	ExactParameterizedBmoRetainerAudit local_audit{};
	local_audit.joinrel_relids_low = exact_bmo_audit_relids_low(
		joinrel->relids);
	local_audit.left_relids_low = exact_bmo_audit_relids_low(
		left_input->relids);
	local_audit.right_relids_low = exact_bmo_audit_relids_low(
		right_input->relids);
	local_audit.left_relid_count = static_cast<std::size_t>(
		bms_num_members(left_input->relids));
	local_audit.right_relid_count = static_cast<std::size_t>(
		bms_num_members(right_input->relids));
	PList<Path> retained;
	for (Path* path : PList<Path>(joinrel->pathlist)) {
		++local_audit.candidates;
		if (path == nullptr || !IsA(path, NestPath)) continue;
		++local_audit.nest_paths;
		auto* nest = reinterpret_cast<NestPath*>(path);
		if (nest->jpath.jointype != JOIN_INNER) continue;
		++local_audit.inner_nest_paths;
		RelOptInfo* outer_parent = nest->jpath.outerjoinpath == nullptr
			? nullptr : nest->jpath.outerjoinpath->parent;
		RelOptInfo* inner_parent = nest->jpath.innerjoinpath == nullptr
			? nullptr : nest->jpath.innerjoinpath->parent;
		const bool current_direct = outer_parent != nullptr
			&& inner_parent != nullptr
			&& bms_equal(outer_parent->relids, left_input->relids)
			&& bms_equal(inner_parent->relids, right_input->relids);
		const bool current_swapped = outer_parent != nullptr
			&& inner_parent != nullptr
			&& bms_equal(outer_parent->relids, right_input->relids)
			&& bms_equal(inner_parent->relids, left_input->relids);
		const bool current_pair = current_direct || current_swapped;
		if (current_pair) {
			++local_audit.current_pair_paths;
		} else {
			++local_audit.foreign_decomposition_paths;
		}

		std::size_t exact_root_copies = 0u;
		bool foreign_root_mmsearch = false;
		for (RestrictInfo* root_clause : PList<RestrictInfo>(
				nest->jpath.joinrestrictinfo)) {
			const std::size_t calls = root_clause == nullptr ? 0u
				: count_mmsearch_occurrences(
					reinterpret_cast<Node*>(root_clause->clause),
					get_cached_stub_oids());
			if (same_planner_restriction_identity(
					root_clause, restriction)) {
				++exact_root_copies;
				if (calls != 1u) foreign_root_mmsearch = true;
			} else if (calls != 0u) {
				/* A copied/equivalent rendezvous clause cannot be removed by the
				 * exact pointer proof, and would remain an executable SQL stub. */
				foreign_root_mmsearch = true;
			}
		}
		if (exact_root_copies > 1u || foreign_root_mmsearch) {
			++local_audit.root_foreign_mmsearch_paths;
			continue;
		}
		if (exact_root_copies == 1u) {
			++local_audit.root_owned_clause_paths;
		}
		if (!current_pair) {
			bool exact_foreign_partition = path->parent == joinrel
				&& outer_parent != nullptr && inner_parent != nullptr
				&& !bms_overlap(outer_parent->relids, inner_parent->relids);
			Relids foreign_union = exact_foreign_partition
				? bms_union(outer_parent->relids, inner_parent->relids) : nullptr;
			exact_foreign_partition = exact_foreign_partition
				&& bms_equal(foreign_union, joinrel->relids);
			bms_free(foreign_union);
			if (!exact_foreign_partition) {
				local_audit.foreign_rejection_mask |= 1u << 0;
				continue;
			}
			if (exact_root_copies != 0u || foreign_root_mmsearch) {
				local_audit.foreign_rejection_mask |= 1u << 1;
				continue;
			}
			if (batch_join_path_contains_parallel_execution(path)
				|| !std::isfinite(path->startup_cost)
				|| !std::isfinite(path->total_cost)
				|| path->startup_cost < 0 || path->total_cost < path->startup_cost) {
				local_audit.foreign_rejection_mask |= 1u << 2;
				continue;
			}
			ExactParameterizedBmoOwnerProof foreign_owner{};
			count_exact_parameterized_bmo_owners(
				root, path, restriction, foreign_owner,
				/*admit_known_wrapper_owner=*/true);
			local_audit.foreign_owner_matches += foreign_owner.matches;
			local_audit.foreign_owner_rejection_mask |=
				foreign_owner.rejection_mask;
			if (foreign_owner.invalid) {
				local_audit.foreign_rejection_mask |= 1u << 3;
				continue;
			}
			if (foreign_owner.matches != 1u) {
				local_audit.foreign_rejection_mask |= 1u << 4;
				continue;
			}
			retained.append(path);
			++local_audit.safe_foreign_paths;
			continue;
		}

		ExactParameterizedBmoOwnerProof outer{};
		ExactParameterizedBmoOwnerProof inner{};
		count_exact_parameterized_bmo_owners(
			root, nest->jpath.outerjoinpath, restriction, outer);
		count_exact_parameterized_bmo_owners(
			root, nest->jpath.innerjoinpath, restriction, inner);
		local_audit.outer_matches += outer.matches;
		local_audit.inner_matches += inner.matches;
		local_audit.outer_rejection_mask |= outer.rejection_mask;
		local_audit.inner_rejection_mask |= inner.rejection_mask;
		auto capture_wrapper_audit = [&local_audit](
				ExactParameterizedBmoOwnerProof const& proof,
				const std::uint32_t side) {
			if (proof.wrapper_owns_expected == 0u) return;
			local_audit.wrapper_side_mask |= side;
			local_audit.wrapper_owns_expected += proof.wrapper_owns_expected;
			local_audit.wrapper_method_mask |= proof.wrapper_method_mask;
			if (local_audit.wrapper_expected_serial == 0u) {
				local_audit.wrapper_version = proof.wrapper_version;
				local_audit.wrapper_restriction_count =
					proof.wrapper_restriction_count;
				local_audit.wrapper_child_count = proof.wrapper_child_count;
				local_audit.wrapper_pointer_matches =
					proof.wrapper_pointer_matches;
				local_audit.wrapper_serial_matches =
					proof.wrapper_serial_matches;
				local_audit.wrapper_clause_matches =
					proof.wrapper_clause_matches;
				local_audit.wrapper_expected_serial =
					proof.expected_rinfo_serial;
				local_audit.wrapper_owned_serial = proof.wrapper_rinfo_serial;
				local_audit.wrapper_expected_target_varno =
					proof.expected_target_varno;
				local_audit.wrapper_expected_query_varno =
					proof.expected_query_varno;
				local_audit.wrapper_private_target_varno =
					proof.wrapper_private_target_varno;
				local_audit.wrapper_private_query_varno =
					proof.wrapper_private_query_varno;
				local_audit.wrapper_private_target_equal =
					proof.wrapper_private_target_equal;
				local_audit.wrapper_private_query_equal =
					proof.wrapper_private_query_equal;
				local_audit.wrapper_owner0_target_varno =
					proof.wrapper_owner0_target_varno;
				local_audit.wrapper_owner0_query_varno =
					proof.wrapper_owner0_query_varno;
				local_audit.wrapper_owner1_target_varno =
					proof.wrapper_owner1_target_varno;
				local_audit.wrapper_owner1_query_varno =
					proof.wrapper_owner1_query_varno;
				local_audit.wrapper_parent_relids_low =
					proof.wrapper_parent_relids_low;
				local_audit.wrapper_child0_relids_low =
					proof.wrapper_child0_relids_low;
				local_audit.wrapper_child1_relids_low =
					proof.wrapper_child1_relids_low;
			}
		};
		capture_wrapper_audit(outer, 1u);
		capture_wrapper_audit(inner, 2u);
		if (outer.invalid || inner.invalid
			|| outer.matches != 0u || inner.matches != 1u) continue;

		if (exact_root_copies == 0u) {
			retained.append(path);
		} else {
			/* Core retains the parameter clause in JoinPath::joinrestrictinfo even
			 * when the parameterized BMO inner path owns it.  Clone only the root
			 * NestPath and remove that exact pointer so create_nestloop_plan cannot
			 * emit the rendezvous SQL function as a Join Filter.  Costs stay
			 * conservative because the original qual charge is retained. */
			auto* clone = makeNode(NestPath);
			*clone = *nest;
			PList<RestrictInfo> residual;
			for (RestrictInfo* root_clause : PList<RestrictInfo>(
					nest->jpath.joinrestrictinfo)) {
				if (!same_planner_restriction_identity(
						root_clause, restriction)) residual.append(root_clause);
			}
			clone->jpath.joinrestrictinfo = residual.release();
			retained.append(reinterpret_cast<Path*>(clone));
		}
	}
	/* Core does not necessarily form a NestPath from a custom parameterized
	 * baserel path.  If no incumbent proves ownership, construct that exact
	 * normal-cost shape from the target input's BMO path and the other input's
	 * cheapest compatible path. */
	if (retained.empty()) {
		PList<Node> operands(mmsearch->args);
		Var* target_var = pg_node_try_as<Var>(operands.first());
		Var* query_var = pg_node_try_as<Var>(operands.second());
		local_audit.target_var_resolved = target_var == nullptr ? 0u : 1u;
		local_audit.query_var_resolved = query_var == nullptr ? 0u : 1u;
		auto relid_side_mask = [left_input, right_input](Var* var) noexcept {
			std::uint32_t mask = 0u;
			if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)) {
				return mask;
			}
			if (bms_is_member(static_cast<int>(var->varno), left_input->relids)) {
				mask |= 1u;
			}
			if (bms_is_member(static_cast<int>(var->varno), right_input->relids)) {
				mask |= 2u;
			}
			return mask;
		};
		local_audit.target_relid_side_mask = relid_side_mask(target_var);
		local_audit.query_relid_side_mask = relid_side_mask(query_var);
		RelOptInfo* target_input = nullptr;
		RelOptInfo* provider_input = nullptr;
		auto input_is_target_base = [target_var](RelOptInfo* input) noexcept {
			return input != nullptr && target_var != nullptr
				&& (input->reloptkind == RELOPT_BASEREL
					|| input->reloptkind == RELOPT_OTHER_MEMBER_REL)
				&& input->relid == target_var->varno;
		};
		if (input_is_target_base(left_input)) {
			local_audit.target_base_side_mask |= 1u;
			target_input = left_input;
			provider_input = right_input;
		} else if (input_is_target_base(right_input)) {
			local_audit.target_base_side_mask |= 2u;
			target_input = right_input;
			provider_input = left_input;
		}
		const bool provider_has_query = provider_input != nullptr
			&& query_var != nullptr
			&& bioseq_is_concrete_rte_varno(query_var->varno)
			&& bms_is_member(
				static_cast<int>(query_var->varno), provider_input->relids);
		local_audit.provider_has_query = provider_has_query ? 1u : 0u;
		Path* best_bmo = nullptr;
		if (target_input != nullptr) {
			for (Path* candidate : PList<Path>(target_input->pathlist)) {
				++local_audit.target_paths;
				auto* custom = candidate != nullptr && IsA(candidate, CustomPath)
					? reinterpret_cast<CustomPath*>(candidate) : nullptr;
				if (custom != nullptr) ++local_audit.target_custom_paths;
				const bool bioseq_path = custom != nullptr
					&& custom->methods == &BioseqColumnScanPathMethods;
				if (bioseq_path) ++local_audit.target_bioseq_paths;
				std::size_t candidate_bmo_tags = 0u;
				if (bioseq_path) {
					for (Node* private_node : PList<Node>(custom->custom_private)) {
						if (private_node == nullptr || !IsA(private_node, List)) {
							continue;
						}
						List* tag = reinterpret_cast<List*>(private_node);
						Node* magic = list_length(tag) >= 1
							? reinterpret_cast<Node*>(linitial(tag)) : nullptr;
						if (magic != nullptr && IsA(magic, Integer)
							&& intVal(magic) == kBioseqMmsearchOwnerMagic) {
							++candidate_bmo_tags;
							++local_audit.target_bmo_tags;
						}
					}
				}
				if (candidate_bmo_tags != 0u) {
					bool invalid_owner_abi = false;
					Node* recipe = per_row_base_scan_owner_recipe(
						custom, invalid_owner_abi);
					if (candidate_bmo_tags != 1u || invalid_owner_abi
						|| recipe == nullptr) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerInvalidOwnerTag;
					}
					std::size_t candidate_pointer_matches = 0u;
					std::size_t candidate_serial_matches = 0u;
					std::size_t candidate_clause_matches = 0u;
					std::size_t candidate_exact_matches = 0u;
					for (RestrictInfo* owned : PList<RestrictInfo>(
							custom->custom_restrictinfo)) {
						++local_audit.target_custom_restrictions;
						if (owned == restriction) {
							++candidate_pointer_matches;
							++local_audit.target_custom_pointer_matches;
						}
						if (owned != nullptr && restriction != nullptr
							&& owned->rinfo_serial > 0
							&& owned->rinfo_serial == restriction->rinfo_serial) {
							++candidate_serial_matches;
							++local_audit.target_custom_serial_matches;
						}
						if (owned != nullptr && restriction != nullptr
							&& equal(owned->clause, restriction->clause)) {
							++candidate_clause_matches;
							++local_audit.target_custom_clause_matches;
						}
						if (same_planner_restriction_identity(
								owned, restriction)) {
							++candidate_exact_matches;
							++local_audit.target_custom_exact_matches;
						}
					}
					if (custom->custom_restrictinfo == NIL) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerMissingCustomRestriction;
					}
					if (candidate_serial_matches == 0u) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerMissingCustomSerial;
					}
					if (candidate_clause_matches == 0u) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerMissingCustomClause;
					}
					if (candidate_exact_matches == 0u) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerMissingCustomIdentity;
					} else if (candidate_exact_matches > 1u) {
						local_audit.target_abi_mismatch_mask |=
							kExactBmoRetainerMultipleCustomIdentities;
					}
					if (candidate->param_info == nullptr) {
						local_audit.target_ppi_mismatch_mask |=
							kExactBmoRetainerMissingParamInfo;
					} else {
						++local_audit.target_ppi_paths;
						std::size_t candidate_ppi_serial_matches = 0u;
						std::size_t candidate_ppi_clause_matches = 0u;
						std::size_t candidate_ppi_exact_matches = 0u;
						for (RestrictInfo* parameter_clause :
								PList<RestrictInfo>(
									candidate->param_info->ppi_clauses)) {
							++local_audit.target_ppi_clauses;
							if (parameter_clause != nullptr && restriction != nullptr
								&& parameter_clause->rinfo_serial > 0
								&& parameter_clause->rinfo_serial
									== restriction->rinfo_serial) {
								++candidate_ppi_serial_matches;
								++local_audit.target_ppi_serial_matches;
							}
							if (parameter_clause != nullptr && restriction != nullptr
								&& equal(parameter_clause->clause,
									restriction->clause)) {
								++candidate_ppi_clause_matches;
								++local_audit.target_ppi_clause_matches;
							}
							if (same_planner_restriction_identity(
									parameter_clause, restriction)) {
								++candidate_ppi_exact_matches;
								++local_audit.target_ppi_exact_matches;
							}
						}
						if (candidate->param_info->ppi_clauses == NIL) {
							local_audit.target_ppi_mismatch_mask |=
								kExactBmoRetainerEmptyPpiClauses;
						}
						if (candidate_ppi_serial_matches == 0u) {
							local_audit.target_ppi_mismatch_mask |=
								kExactBmoRetainerMissingPpiSerial;
						}
						if (candidate_ppi_clause_matches == 0u) {
							local_audit.target_ppi_mismatch_mask |=
								kExactBmoRetainerMissingPpiClause;
						}
						if (candidate_ppi_exact_matches == 0u) {
							local_audit.target_ppi_mismatch_mask |=
								kExactBmoRetainerMissingPpiIdentity;
						} else if (candidate_ppi_exact_matches > 1u) {
							local_audit.target_ppi_mismatch_mask |=
								kExactBmoRetainerMultiplePpiIdentities;
						}
					}
					(void)candidate_pointer_matches;
				}
				ExactParameterizedBmoOwnerProof candidate_proof{};
				count_exact_parameterized_bmo_owners(
					root, candidate, restriction, candidate_proof);
				local_audit.target_owner_rejection_mask |=
					candidate_proof.rejection_mask;
				if (provider_has_query && candidate_proof.matches != 0u) {
					++local_audit.available_bmo_paths;
				}
				Relids required = candidate == nullptr
					? nullptr : PATH_REQ_OUTER(candidate);
				if (candidate_bmo_tags != 0u
					|| candidate_proof.matches != 0u) {
					if (candidate == nullptr || candidate->parent != target_input) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateParent;
					}
					if (candidate_proof.invalid) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateOwnerProof;
					}
					if (candidate_proof.matches != 1u) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateOwnerMultiplicity;
					}
					if (required == nullptr) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateUnparameterized;
					} else if (provider_has_query) {
						if (!bms_is_member(
								static_cast<int>(query_var->varno), required)) {
							local_audit.target_compatibility_mismatch_mask |=
								kExactBmoRetainerCandidateMissingQueryRelid;
						}
						if (!bms_is_subset(required, provider_input->relids)) {
							local_audit.target_compatibility_mismatch_mask |=
								kExactBmoRetainerCandidateForeignRequiredOuter;
						}
					}
					if (candidate != nullptr && (candidate->parallel_aware
						|| candidate->parallel_workers != 0)) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateParallel;
					}
					if (candidate != nullptr
						&& !std::isfinite(candidate->total_cost)) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateNonfiniteCost;
					}
					if (candidate != nullptr && candidate->total_cost < 0) {
						local_audit.target_compatibility_mismatch_mask |=
							kExactBmoRetainerCandidateNegativeCost;
					}
				}
				if (!provider_has_query
					|| candidate == nullptr || candidate->parent != target_input
					|| candidate_proof.invalid
					|| candidate_proof.matches != 1u
					|| required == nullptr
					|| !bms_is_member(
						static_cast<int>(query_var->varno), required)
					|| !bms_is_subset(required, provider_input->relids)
					|| candidate->parallel_aware || candidate->parallel_workers != 0
					|| !std::isfinite(candidate->total_cost)
					|| candidate->total_cost < 0) continue;
				++local_audit.compatible_bmo_paths;
				if (best_bmo == nullptr
					|| candidate->total_cost < best_bmo->total_cost) {
					best_bmo = candidate;
				}
			}
			if (best_bmo == nullptr && provider_has_query) {
				++local_audit.reconstructed_bmo_attempts;
				ExactParameterizedBmoReconstructionAudit
					reconstruction_audit{};
				best_bmo = reconstruct_exact_parameterized_bmo_inner(
					root, target_input, provider_input, restriction,
					mmsearch, reconstruction_audit);
				local_audit.reconstructed_bmo_rejection_mask |=
					reconstruction_audit.rejection_mask;
				local_audit.reconstructed_owner_abi_mismatch_mask |=
					reconstruction_audit.owner_abi_mismatch_mask;
				local_audit.reconstructed_expected_owner_count =
					reconstruction_audit.expected_owner_count;
				local_audit.reconstructed_owner_tag_count =
					reconstruction_audit.owner_tag_count;
				local_audit.reconstructed_owner_expression_count =
					reconstruction_audit.owner_expression_count;
				if (best_bmo != nullptr) {
					++local_audit.reconstructed_bmo_paths;
					++local_audit.available_bmo_paths;
					++local_audit.compatible_bmo_paths;
				}
			}
		}

		Path* best_outer = nullptr;
		if (provider_input != nullptr && best_bmo != nullptr) {
			for (Path* candidate : PList<Path>(provider_input->pathlist)) {
				if (candidate == nullptr || candidate->parent != provider_input
					|| candidate->parallel_aware
					|| candidate->parallel_workers != 0
					|| bms_overlap(PATH_REQ_OUTER(candidate), target_input->relids)
					|| !std::isfinite(candidate->total_cost)
					|| candidate->total_cost < 0) continue;
				++local_audit.available_outer_paths;
				if (best_outer == nullptr
					|| candidate->total_cost < best_outer->total_cost) {
					best_outer = candidate;
				}
			}
		}
		if (best_outer != nullptr && best_bmo != nullptr) {
			Relids available_to_inner = bms_union(
				provider_input->relids, PATH_REQ_OUTER(best_outer));
			const bool inner_requirements_available = bms_is_subset(
				PATH_REQ_OUTER(best_bmo), available_to_inner);
			bms_free(available_to_inner);
			PList<RestrictInfo> residual_join_clauses;
			bool residual_mmsearch = false;
			for (RestrictInfo* clause : PList<RestrictInfo>(
					extra->restrictlist)) {
				if (same_planner_restriction_identity(
						clause, restriction)) continue;
				if (clause != nullptr && count_mmsearch_occurrences(
						reinterpret_cast<Node*>(clause->clause),
						get_cached_stub_oids()) != 0u) {
					residual_mmsearch = true;
					break;
				}
				residual_join_clauses.append(clause);
			}
			if (inner_requirements_available && !residual_mmsearch) {
				Relids required_outer = calc_nestloop_required_outer(
					provider_input->relids, PATH_REQ_OUTER(best_outer),
					target_input->relids, PATH_REQ_OUTER(best_bmo));
				if (bms_overlap(required_outer, joinrel->relids)) {
					bms_free(required_outer);
				} else {
					JoinCostWorkspace workspace{};
					initial_cost_nestloop(
						root, &workspace, JOIN_INNER,
						best_outer, best_bmo, extra);
					NestPath* constructed = create_nestloop_path(
						root, joinrel, JOIN_INNER, &workspace, extra,
						best_outer, best_bmo,
						residual_join_clauses.ptr(),
						build_join_pathkeys(
							root, joinrel, JOIN_INNER,
							best_outer->pathkeys),
						required_outer);
					bool constructed_has_mmsearch = false;
					for (RestrictInfo* clause : PList<RestrictInfo>(
							constructed == nullptr ? NIL
								: constructed->jpath.joinrestrictinfo)) {
						if (clause != nullptr && count_mmsearch_occurrences(
								reinterpret_cast<Node*>(clause->clause),
								get_cached_stub_oids()) != 0u) {
							constructed_has_mmsearch = true;
							break;
						}
					}
					if (constructed != nullptr && !constructed_has_mmsearch) {
						retained.append(reinterpret_cast<Path*>(constructed));
						++local_audit.constructed_paths;
					} else if (constructed == nullptr) {
						bms_free(required_outer);
					}
				}
			}
		}
	}
	local_audit.retained_paths = static_cast<std::size_t>(retained.length());
	if (audit != nullptr) *audit = local_audit;
	if (retained.empty()) return false;
	joinrel->pathlist = retained.release();
	joinrel->partial_pathlist = NIL;
	return true;
}

static void per_row_prove_descendant_base_helper_owner(
		Path* path, FuncExpr* helper,
		PerRowBaseHelperOwnerProof& proof) {
	if (path == nullptr || helper == nullptr || proof.invalid_owner_abi
		|| proof.unsupported_wrapper) return;
	check_stack_depth();
	if (IsA(path, CustomPath)) {
		auto* custom = reinterpret_cast<CustomPath*>(path);
		if (custom->methods == &BioseqColumnScanPathMethods) {
			Node* recipe = per_row_base_scan_owner_recipe(
				custom, proof.invalid_owner_abi);
			if (proof.invalid_owner_abi) return;
			if (recipe != nullptr
				&& (batch_join_match_helper_names_recipe(helper, recipe)
					|| batch_join_match_helper_names_base_lineage(
						helper, recipe, get_cached_stub_oids()))) {
				++proof.matches;
				proof.owner = custom;
			}
		} else if (custom->methods != &BioseqBatchJoinPathMethods
			&& custom->methods != &BioseqPerRowJoinPathMethods
			&& custom->methods != &bioseq_slice_project_path_methods()) {
			proof.unsupported_wrapper = true;
			return;
		}
		for (Path* child : PList<Path>(custom->custom_paths)) {
			per_row_prove_descendant_base_helper_owner(child, helper, proof);
		}
		return;
	}
	auto descend_join = [helper, &proof](JoinPath* join) {
		if (join == nullptr) return;
		per_row_prove_descendant_base_helper_owner(
			join->outerjoinpath, helper, proof);
		per_row_prove_descendant_base_helper_owner(
			join->innerjoinpath, helper, proof);
	};
	if (IsA(path, NestPath)) {
		descend_join(&reinterpret_cast<NestPath*>(path)->jpath);
		return;
	}
	if (IsA(path, MergePath)) {
		descend_join(&reinterpret_cast<MergePath*>(path)->jpath);
		return;
	}
	if (IsA(path, HashPath)) {
		descend_join(&reinterpret_cast<HashPath*>(path)->jpath);
		return;
	}
	Path* unary = nullptr;
	if (IsA(path, ProjectionPath)) {
		unary = reinterpret_cast<ProjectionPath*>(path)->subpath;
	} else if (IsA(path, ProjectSetPath)) {
		unary = reinterpret_cast<ProjectSetPath*>(path)->subpath;
	} else if (IsA(path, SortPath)) {
		unary = reinterpret_cast<SortPath*>(path)->subpath;
	} else if (IsA(path, IncrementalSortPath)) {
		unary = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
	} else if (IsA(path, MaterialPath)) {
		unary = reinterpret_cast<MaterialPath*>(path)->subpath;
	} else if (IsA(path, MemoizePath)) {
		unary = reinterpret_cast<MemoizePath*>(path)->subpath;
	} else if (IsA(path, UniquePath)) {
		unary = reinterpret_cast<UniquePath*>(path)->subpath;
	} else if (IsA(path, GatherPath)) {
		unary = reinterpret_cast<GatherPath*>(path)->subpath;
	} else if (IsA(path, GatherMergePath)) {
		unary = reinterpret_cast<GatherMergePath*>(path)->subpath;
	}
	if (unary != nullptr) {
		per_row_prove_descendant_base_helper_owner(unary, helper, proof);
		return;
	}
	List* children = NIL;
	if (IsA(path, AppendPath)) {
		children = reinterpret_cast<AppendPath*>(path)->subpaths;
	} else if (IsA(path, MergeAppendPath)) {
		children = reinterpret_cast<MergeAppendPath*>(path)->subpaths;
	}
	if (children != NIL) {
		for (Path* child : PList<Path>(children)) {
			per_row_prove_descendant_base_helper_owner(child, helper, proof);
		}
		return;
	}
	if (path->parent == nullptr
		|| (path->parent->reloptkind != RELOPT_BASEREL
			&& path->parent->reloptkind != RELOPT_OTHER_MEMBER_REL)) {
		proof.unsupported_wrapper = true;
	}
}

[[nodiscard]] static bool per_row_collect_available_path_helpers(
		Path* path, List* candidate_helpers, List* proven_inherited_helpers,
		List*& available) {
	available = NIL;
	if (path == nullptr) return false;
	BioseqStubOids const& oids = get_cached_stub_oids();
	for (Node* identity : PList<Node>(candidate_helpers)) {
		FuncExpr* helper = per_row_helper_identity_function(identity, oids);
		Node* argument = batch_join_match_helper_argument(helper);
		if (helper == nullptr || argument == nullptr) return false;
		bool supplied = false;
		std::size_t inherited_owner_matches = 0u;
		if (per_row_expression_list_contains(
				proven_inherited_helpers, identity)) {
			PerRowDescendantOwnerProof proof{};
			per_row_prove_descendant_exact_owner(path, argument, proof);
			if (proof.invalid_owner_abi || proof.unsupported_wrapper
				|| proof.matches > 1u) return false;
			if (proof.matches == 1u) {
				if (proof.owner == nullptr
					|| proof.owner->path.pathtarget == nullptr
					|| !path_target_contains_expression(
						proof.owner->path.pathtarget,
						reinterpret_cast<Expr*>(identity))) return false;
				supplied = true;
			}
			inherited_owner_matches = proof.matches;
		}
		PerRowBaseHelperOwnerProof base_proof{};
		per_row_prove_descendant_base_helper_owner(path, helper, base_proof);
		if (base_proof.invalid_owner_abi || base_proof.unsupported_wrapper
			|| base_proof.matches > 1u
			|| inherited_owner_matches + base_proof.matches > 1u) {
			return false;
		}
		if (base_proof.matches == 1u) {
			if (base_proof.owner == nullptr
				|| base_proof.owner->path.pathtarget == nullptr
				|| !path_target_contains_expression(
					base_proof.owner->path.pathtarget,
					reinterpret_cast<Expr*>(identity))) return false;
			supplied = true;
		}
		if (supplied) available = lappend(available, identity);
	}
	return true;
}

struct PerRowPathHelperAudit {
	BioseqStubOids const* oids = nullptr;
	List* available = NIL;
	bool saw_helper = false;
	bool unavailable = false;
};

struct per_row_path_helper_audit_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			PerRowPathHelperAudit& audit) const {
		if (audit.oids == nullptr) {
			audit.unavailable = true;
			return pg_walk_step::stop;
		}
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			if (!batch_join_expression_has_match_helper(
					reinterpret_cast<Node*>(placeholder->phexpr),
					*audit.oids)) return pg_walk_step::descend;
			audit.saw_helper = true;
			if (!per_row_expression_list_contains(
					audit.available,
					reinterpret_cast<Node*>(placeholder))) {
				audit.unavailable = true;
				return pg_walk_step::stop;
			}
			return pg_walk_step::skip_subtree;
		}
		FuncExpr* function = node.try_as<FuncExpr>();
		if (function == nullptr
			|| !is_bioseq_projection_funcid(
				function->funcid, *audit.oids)) {
			return pg_walk_step::descend;
		}
		audit.saw_helper = true;
		if (!per_row_expression_list_contains(
				audit.available, reinterpret_cast<Node*>(function))) {
			audit.unavailable = true;
			return pg_walk_step::stop;
		}
		return pg_walk_step::skip_subtree;
	}
};

[[nodiscard]] static bool per_row_expression_uses_available_helpers(
		Node* expression, List* available, bool& saw_helper) {
	PerRowPathHelperAudit audit{
		&get_cached_stub_oids(), available, false, false};
	per_row_path_helper_audit_visitor visitor;
	pg_walk_expression_including_root(expression, audit, visitor);
	saw_helper = audit.saw_helper;
	return !audit.unavailable;
}

[[nodiscard]] static bool per_row_pathkeys_use_available_helpers(
		Path* scope, List* pathkeys, List* available) {
	if (pathkeys == NIL) return true;
	if (scope == nullptr || scope->parent == nullptr) return false;
	for (PathKey* pathkey : PList<PathKey>(pathkeys)) {
		if (pathkey == nullptr || pathkey->pk_eclass == nullptr) return false;
		for (EquivalenceMember* member : PList<EquivalenceMember>(
				pathkey->pk_eclass->ec_members)) {
			if (member == nullptr || member->em_expr == nullptr) return false;
			if (!bms_is_empty(member->em_relids)
				&& !bms_is_subset(
					member->em_relids, scope->parent->relids)) continue;
			bool saw_helper = false;
			if (!per_row_expression_uses_available_helpers(
					reinterpret_cast<Node*>(member->em_expr),
					available, saw_helper)) return false;
		}
	}
	return true;
}

[[nodiscard]] static bool per_row_path_metadata_has_no_helper(Node* metadata);

[[nodiscard]] static bool per_row_path_metadata_node_is_walkable(
		const NodeTag tag) noexcept {
	switch (tag) {
		case T_Var:
		case T_Const:
		case T_Param:
		case T_CaseTestExpr:
		case T_SQLValueFunction:
		case T_CoerceToDomainValue:
		case T_SetToDefault:
		case T_CurrentOfExpr:
		case T_NextValueExpr:
		case T_RangeTblRef:
		case T_SortGroupClause:
		case T_CTESearchClause:
		case T_MergeSupportFunc:
		case T_WithCheckOption:
		case T_Aggref:
		case T_GroupingFunc:
		case T_WindowFunc:
		case T_WindowFuncRunCondition:
		case T_SubscriptingRef:
		case T_FuncExpr:
		case T_NamedArgExpr:
		case T_OpExpr:
		case T_DistinctExpr:
		case T_NullIfExpr:
		case T_ScalarArrayOpExpr:
		case T_BoolExpr:
		case T_SubLink:
		case T_SubPlan:
		case T_AlternativeSubPlan:
		case T_FieldSelect:
		case T_FieldStore:
		case T_RelabelType:
		case T_CoerceViaIO:
		case T_ArrayCoerceExpr:
		case T_ConvertRowtypeExpr:
		case T_CollateExpr:
		case T_CaseExpr:
		case T_ArrayExpr:
		case T_RowExpr:
		case T_RowCompareExpr:
		case T_CoalesceExpr:
		case T_MinMaxExpr:
		case T_XmlExpr:
		case T_JsonValueExpr:
		case T_JsonConstructorExpr:
		case T_JsonIsPredicate:
		case T_JsonExpr:
		case T_JsonBehavior:
		case T_NullTest:
		case T_BooleanTest:
		case T_CoerceToDomain:
		case T_TargetEntry:
		case T_Query:
		case T_WindowClause:
		case T_CTECycleClause:
		case T_CommonTableExpr:
		case T_JsonKeyValue:
		case T_JsonObjectConstructor:
		case T_JsonArrayConstructor:
		case T_JsonArrayQueryConstructor:
		case T_JsonAggConstructor:
		case T_JsonObjectAgg:
		case T_JsonArrayAgg:
		case T_PartitionBoundSpec:
		case T_PartitionRangeDatum:
		case T_FromExpr:
		case T_OnConflictExpr:
		case T_MergeAction:
		case T_PartitionPruneStepOp:
		case T_PartitionPruneStepCombine:
		case T_JoinExpr:
		case T_SetOperationStmt:
		case T_IndexClause:
		case T_PlaceHolderVar:
		case T_InferenceElem:
		case T_AppendRelInfo:
		case T_PlaceHolderInfo:
		case T_RangeTblFunction:
		case T_TableSampleClause:
		case T_TableFunc:
			return true;
		default:
			return false;
	}
}

[[nodiscard]] static bool per_row_path_metadata_node_is_scalar(
		const NodeTag tag) noexcept {
	return tag == T_Integer || tag == T_Float || tag == T_Boolean
		|| tag == T_String || tag == T_BitString || tag == T_IntList
		|| tag == T_OidList || tag == T_XidList;
}

struct PerRowPathMetadataAudit {
	const BioseqStubOids* oids = nullptr;
	bool invalid = false;
};

struct per_row_path_metadata_audit_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			PerRowPathMetadataAudit& audit) const {
		if (node.tag() == T_List) {
			if (!per_row_path_metadata_has_no_helper(node.raw())) {
				audit.invalid = true;
				return pg_walk_step::stop;
			}
			return pg_walk_step::skip_subtree;
		}
		if (RestrictInfo* restriction = node.try_as<RestrictInfo>()) {
			if (restriction->clause == nullptr
				|| !per_row_path_metadata_has_no_helper(
					reinterpret_cast<Node*>(restriction->clause))
				|| !per_row_path_metadata_has_no_helper(
					reinterpret_cast<Node*>(restriction->orclause))) {
				audit.invalid = true;
				return pg_walk_step::stop;
			}
			return pg_walk_step::skip_subtree;
		}
		if (per_row_path_metadata_node_is_scalar(node.tag())) {
			return pg_walk_step::skip_subtree;
		}
		if (!per_row_path_metadata_node_is_walkable(node.tag())) {
			audit.invalid = true;
			return pg_walk_step::stop;
		}
		if (FuncExpr* function = node.try_as<FuncExpr>();
			function != nullptr
			&& is_bioseq_projection_funcid(function->funcid, *audit.oids)) {
			audit.invalid = true;
			return pg_walk_step::stop;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool per_row_path_metadata_has_no_helper(
		Node* metadata) {
	if (metadata == nullptr) return true;
	check_stack_depth();
	if (nodeTag(metadata) == T_List) {
		for (Node* item : PList<Node>(reinterpret_cast<List*>(metadata))) {
			if (!per_row_path_metadata_has_no_helper(item)) return false;
		}
		return true;
	}
	if (RestrictInfo* restriction = pg_node_try_as<RestrictInfo>(metadata)) {
		return restriction->clause != nullptr
			&& per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(restriction->clause))
			&& per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(restriction->orclause));
	}
	if (per_row_path_metadata_node_is_scalar(nodeTag(metadata))) return true;
	if (!per_row_path_metadata_node_is_walkable(nodeTag(metadata))) return false;
	PerRowPathMetadataAudit audit{&get_cached_stub_oids(), false};
	per_row_path_metadata_audit_visitor visitor;
	pg_walk_expression_including_root(metadata, audit, visitor);
	return !audit.invalid;
}

[[nodiscard]] static bool per_row_restrictinfo_list_has_no_helper(
		List* restrictions) {
	for (Node* item : PList<Node>(restrictions)) {
		RestrictInfo* restriction = pg_node_try_as<RestrictInfo>(item);
		if (restriction == nullptr || restriction->clause == nullptr
			|| !per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(restriction->clause))
			|| !per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(restriction->orclause))) return false;
	}
	return true;
}

/* PathTarget does not record the allocated length of sortgrouprefs.  The
 * processed targetlist is the authoritative representation whose TLEs carry
 * their refs inline, so never index a possibly extended/shared PathTarget
 * array while rebuilding descendant targets.  Support-only expressions that
 * are absent from the processed targetlist correctly receive ref zero. */
[[nodiscard]] static bool per_row_authoritative_sortgrouprefs(
		PlannerInfo* root, List* expressions,
		std::vector<Index>& results) {
	results.clear();
	if (root == nullptr) return false;
	results.reserve(static_cast<std::size_t>(list_length(expressions)));
	List* consumed = NIL;
	for (Node* expression : PList<Node>(expressions)) {
		if (expression == nullptr) return false;
		TargetEntry* selected = nullptr;
		for (TargetEntry* entry : PList<TargetEntry>(root->processed_tlist)) {
			if (entry == nullptr || entry->expr == nullptr
				|| list_member_ptr(consumed, entry)
				|| !equal(entry->expr, expression)) continue;
			selected = entry;
			break;
		}
		results.push_back(selected == nullptr
			? 0 : selected->ressortgroupref);
		if (selected != nullptr) consumed = lappend(consumed, selected);
	}
	/* If this PathTarget names an expression group, it must contain enough
	 * stable occurrences to carry every authoritative nonzero ref in that
	 * group.  Otherwise choosing which duplicate owns the ref is ambiguous. */
	for (TargetEntry* entry : PList<TargetEntry>(root->processed_tlist)) {
		if (entry == nullptr || entry->expr == nullptr
			|| entry->ressortgroupref == 0
			|| list_member_ptr(consumed, entry)) continue;
		if (per_row_expression_list_contains(
				expressions, reinterpret_cast<Node*>(entry->expr))) return false;
	}
	return results.size()
		== static_cast<std::size_t>(list_length(expressions));
}

[[nodiscard]] static PathTarget* per_row_normalized_path_target(
		PlannerInfo* root, Path* path, List* available,
		List* candidate_helpers, List* required_vars,
		bool& changed, bool& invalid) {
	changed = false;
	if (root == nullptr || path == nullptr || path->parent == nullptr
		|| path->parent->relids == nullptr || path->pathtarget == nullptr) {
		invalid = true;
		return nullptr;
	}
	List* expressions = NIL;
	std::vector<Index> sortgrouprefs;
	sortgrouprefs.reserve(static_cast<std::size_t>(
		list_length(path->pathtarget->exprs) + list_length(required_vars)));
	std::vector<Index> source_sortgrouprefs;
	if (!per_row_authoritative_sortgrouprefs(
			root, path->pathtarget->exprs, source_sortgrouprefs)) {
		invalid = true;
		return nullptr;
	}
	std::size_t source_index = 0u;
	for (Node* expression : PList<Node>(path->pathtarget->exprs)) {
		bool saw_helper = false;
		const bool supported = per_row_expression_uses_available_helpers(
			expression, available, saw_helper);
		const Index sortgroupref = source_sortgrouprefs[source_index++];
		if (!supported) {
			/* Pathkeys were audited against the actually available helpers
			 * before target normalization.  A current-owner helper may therefore
			 * be removed from this private child even when its public TLE carries
			 * a sortgroupref; the exact outer owner target retains that ref. */
			bool saw_candidate_helper = false;
			const bool covered_by_current_owner =
				per_row_expression_uses_available_helpers(
					expression, candidate_helpers, saw_candidate_helper);
			if (!saw_helper || !saw_candidate_helper
				|| !covered_by_current_owner) {
				invalid = true;
				return nullptr;
			}
			changed = true;
			continue;
		}
		expressions = lappend(expressions, copyObject(expression));
		sortgrouprefs.push_back(sortgroupref);
	}
	for (Node* expression : PList<Node>(required_vars)) {
		Var* var = pg_node_try_as<Var>(expression);
		const bool row_identity = per_row_is_exact_row_identity_var(var);
		if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
			|| (var->varattno <= 0 && !row_identity)
			|| var->varlevelsup != 0
			|| !bms_is_empty(var->varnullingrels)) {
			invalid = true;
			return nullptr;
		}
		if (!bms_is_member(
				static_cast<int>(var->varno), path->parent->relids)
			|| per_row_expression_list_contains(expressions, expression)) {
			continue;
		}
		expressions = lappend(expressions, copyObject(expression));
		sortgrouprefs.push_back(0);
		changed = true;
	}
	if (sortgrouprefs.size()
		!= static_cast<std::size_t>(list_length(expressions))) {
		invalid = true;
		return nullptr;
	}
	PathTarget* target = create_empty_pathtarget();
	target->exprs = expressions;
	const bool has_sortgroupref = std::any_of(
		sortgrouprefs.begin(), sortgrouprefs.end(),
		[](Index value) noexcept { return value != 0; });
	if (has_sortgroupref) {
		target->sortgrouprefs = static_cast<Index*>(palloc0(
			sortgrouprefs.size() * sizeof(Index)));
		for (std::size_t index = 0u; index < sortgrouprefs.size(); ++index) {
			target->sortgrouprefs[index] = sortgrouprefs[index];
		}
	}
	set_pathtarget_cost_width(root, target);
	for (Node* expression : PList<Node>(target->exprs)) {
		bool saw_helper = false;
		if (!per_row_expression_uses_available_helpers(
				expression, available, saw_helper)) {
			invalid = true;
			return nullptr;
		}
	}
	return target;
}

[[nodiscard]] static bool per_row_append_targets_are_ordinally_compatible(
		PathTarget* parent, List* children) {
	if (parent == nullptr || children == NIL) return false;
	const int columns = list_length(parent->exprs);
	for (Path* child : PList<Path>(children)) {
		if (child == nullptr || child->pathtarget == nullptr
			|| list_length(child->pathtarget->exprs) != columns) return false;
		for (int index = 0; index < columns; ++index) {
			Node* parent_expression = reinterpret_cast<Node*>(list_nth(
				parent->exprs, index));
			Node* child_expression = reinterpret_cast<Node*>(list_nth(
				child->pathtarget->exprs, index));
			if (parent_expression == nullptr || child_expression == nullptr
				|| exprType(parent_expression) != exprType(child_expression)
				|| exprTypmod(parent_expression) != exprTypmod(child_expression)
				|| exprCollation(parent_expression)
					!= exprCollation(child_expression)) return false;
		}
	}
	return true;
}

[[nodiscard]] static bool per_row_authoritative_targets_match(
		PlannerInfo* root, PathTarget* left, PathTarget* right) {
	if (root == nullptr || left == nullptr || right == nullptr
		|| list_length(left->exprs) != list_length(right->exprs)
		|| !equal(left->exprs, right->exprs)) return false;
	std::vector<Index> left_sortgrouprefs;
	std::vector<Index> right_sortgrouprefs;
	return per_row_authoritative_sortgrouprefs(
			root, left->exprs, left_sortgrouprefs)
		&& per_row_authoritative_sortgrouprefs(
			root, right->exprs, right_sortgrouprefs)
		&& left_sortgrouprefs == right_sortgrouprefs;
}

[[nodiscard]] static bool per_row_normalize_private_path_spine(
		PlannerInfo* root, Path* path, List* candidate_helpers,
		List* proven_inherited_helpers, List* required_vars) {
	if (root == nullptr || path == nullptr) return false;
	check_stack_depth();
	List* available = NIL;
	if (!per_row_collect_available_path_helpers(
			path, candidate_helpers, proven_inherited_helpers, available)
		|| !per_row_pathkeys_use_available_helpers(
			path, path->pathkeys, available)
		|| (path->param_info != nullptr
			&& !per_row_restrictinfo_list_has_no_helper(
				path->param_info->ppi_clauses))) {
		return false;
	}
	bool target_changed = false;
	bool target_invalid = false;
	PathTarget* normalized_target = per_row_normalized_path_target(
		root, path, available, candidate_helpers, required_vars,
		target_changed, target_invalid);
	if (target_invalid || normalized_target == nullptr) return false;

	if (IsA(path, CustomPath)) {
		auto* custom = reinterpret_cast<CustomPath*>(path);
		if (custom->methods != &BioseqColumnScanPathMethods
			&& custom->methods != &BioseqBatchJoinPathMethods
			&& custom->methods != &BioseqPerRowJoinPathMethods
			&& custom->methods != &bioseq_slice_project_path_methods()) {
			return false;
		}
		if (!per_row_restrictinfo_list_has_no_helper(
				custom->custom_restrictinfo)
			|| !per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(custom->custom_private))) return false;
		path->pathtarget = normalized_target;
		for (Path* child : PList<Path>(custom->custom_paths)) {
			if (!per_row_normalize_private_path_spine(
					root, child, candidate_helpers,
					proven_inherited_helpers, required_vars)) return false;
		}
		return true;
	}

	JoinPath* join = nullptr;
	if (IsA(path, NestPath)) {
		join = &reinterpret_cast<NestPath*>(path)->jpath;
	} else if (IsA(path, MergePath)) {
		join = &reinterpret_cast<MergePath*>(path)->jpath;
	} else if (IsA(path, HashPath)) {
		join = &reinterpret_cast<HashPath*>(path)->jpath;
	}
	if (join != nullptr) {
		if (!per_row_restrictinfo_list_has_no_helper(
				join->joinrestrictinfo)) return false;
		if (IsA(path, MergePath)) {
			auto* merge = reinterpret_cast<MergePath*>(path);
			List* outer_available = NIL;
			List* inner_available = NIL;
			if (!per_row_restrictinfo_list_has_no_helper(
					merge->path_mergeclauses)
				|| !per_row_collect_available_path_helpers(
					join->outerjoinpath, candidate_helpers,
					proven_inherited_helpers, outer_available)
				|| !per_row_collect_available_path_helpers(
					join->innerjoinpath, candidate_helpers,
					proven_inherited_helpers, inner_available)
				|| !per_row_pathkeys_use_available_helpers(
					join->outerjoinpath, merge->outersortkeys,
					outer_available)
				|| !per_row_pathkeys_use_available_helpers(
					join->innerjoinpath, merge->innersortkeys,
					inner_available)) return false;
		} else if (IsA(path, HashPath)
			&& !per_row_restrictinfo_list_has_no_helper(
				reinterpret_cast<HashPath*>(path)->path_hashclauses)) {
			return false;
		}
		path->pathtarget = normalized_target;
		return per_row_normalize_private_path_spine(
				root, join->outerjoinpath, candidate_helpers,
				proven_inherited_helpers, required_vars)
			&& per_row_normalize_private_path_spine(
				root, join->innerjoinpath, candidate_helpers,
				proven_inherited_helpers, required_vars);
	}

	Path* unary = nullptr;
	bool target_preserving = false;
	if (IsA(path, ProjectionPath)) {
		auto* projection = reinterpret_cast<ProjectionPath*>(path);
		unary = projection->subpath;
		if (target_changed) projection->dummypp = false;
	} else if (IsA(path, ProjectSetPath)) {
		unary = reinterpret_cast<ProjectSetPath*>(path)->subpath;
	} else if (IsA(path, SortPath)) {
		unary = reinterpret_cast<SortPath*>(path)->subpath;
		target_preserving = true;
	} else if (IsA(path, IncrementalSortPath)) {
		unary = reinterpret_cast<IncrementalSortPath*>(path)->spath.subpath;
		target_preserving = true;
	} else if (IsA(path, MaterialPath)) {
		unary = reinterpret_cast<MaterialPath*>(path)->subpath;
		target_preserving = true;
	} else if (IsA(path, MemoizePath)) {
		auto* memoize = reinterpret_cast<MemoizePath*>(path);
		if (!per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(memoize->param_exprs))) return false;
		unary = memoize->subpath;
		target_preserving = true;
	} else if (IsA(path, UniquePath)) {
		auto* unique = reinterpret_cast<UniquePath*>(path);
		if (!per_row_path_metadata_has_no_helper(
				reinterpret_cast<Node*>(unique->uniq_exprs))) return false;
		unary = unique->subpath;
		target_preserving = true;
	} else if (IsA(path, GatherPath)) {
		unary = reinterpret_cast<GatherPath*>(path)->subpath;
		target_preserving = true;
	} else if (IsA(path, GatherMergePath)) {
		unary = reinterpret_cast<GatherMergePath*>(path)->subpath;
		target_preserving = true;
	}
	if (unary != nullptr) {
		path->pathtarget = normalized_target;
		if (!per_row_normalize_private_path_spine(
				root, unary, candidate_helpers,
				proven_inherited_helpers, required_vars)) return false;
		return !target_preserving
			|| per_row_authoritative_targets_match(
				root, path->pathtarget, unary->pathtarget);
	}

	List* children = NIL;
	if (IsA(path, AppendPath)) {
		children = reinterpret_cast<AppendPath*>(path)->subpaths;
	} else if (IsA(path, MergeAppendPath)) {
		children = reinterpret_cast<MergeAppendPath*>(path)->subpaths;
	}
	if (children != NIL) {
		path->pathtarget = normalized_target;
		for (Path* child : PList<Path>(children)) {
			if (!per_row_normalize_private_path_spine(
					root, child, candidate_helpers,
					proven_inherited_helpers, required_vars)) return false;
		}
		return per_row_append_targets_are_ordinally_compatible(
			path->pathtarget, children);
	}

	/* Ordinary base scan paths are immutable leaves in the existing COW
	 * cloner.  They may be shared only when normalization is a no-op; direct
	 * BioseqScan leaves were handled above and are private CustomPaths. */
	if (path->parent != nullptr
		&& (path->parent->reloptkind == RELOPT_BASEREL
			|| path->parent->reloptkind == RELOPT_OTHER_MEMBER_REL)) {
		return !target_changed;
	}
	return false;
}

/* SQL cannot deterministically retain each of these core wrapper Path types:
 * PostgreSQL commonly folds ProjectionPath, chooses Material/Memoize by cost,
 * and represents SELECT DISTINCT with an upper path rather than UniquePath.
 * This revoked integration seam constructs their real node types and invokes
 * the same exact-owner proof and copy-on-write propagation used by transformed
 * mmsearch planning.  A genuine nested sliced-mmsearch execution in the
 * acceptance suite separately proves final setrefs/executor helper binding. */
[[nodiscard]] static CustomPathMethods const&
match_helper_wrapper_probe_unknown_path_methods() noexcept {
	static const CustomPathMethods methods{
		.CustomName = "BioseqMatchHelperWrapperProbeUnknown",
		.PlanCustomPath = nullptr,
		.ReparameterizeCustomPathByChild = nullptr,
	};
	return methods;
}

static void match_helper_wrapper_probe_init_path(
		Path* path, NodeTag plan_tag, RelOptInfo* parent,
		PathTarget* target) noexcept {
	Assert(path != nullptr);
	path->pathtype = plan_tag;
	path->parent = parent;
	path->pathtarget = target;
	path->param_info = nullptr;
	path->parallel_aware = false;
	path->parallel_safe = false;
	path->parallel_workers = 0;
	path->rows = 1.0;
	path->startup_cost = 1.0;
	path->total_cost = 2.0;
	path->pathkeys = NIL;
}

[[nodiscard]] static RelOptInfo* match_helper_wrapper_probe_rel(
		RelOptKind kind, Index relid, Relids relids) {
	auto* rel = makeNode(RelOptInfo);
	rel->reloptkind = kind;
	rel->relid = relid;
	rel->relids = relids;
	rel->rows = 1.0;
	rel->reltarget = create_empty_pathtarget();
	return rel;
}

export namespace bioseq::table::sql_routines {

[[bioseq_sql::function({
	.schema = bioseq::sql::fixed_schema<"bioseq_internal">,
	.create = bioseq::sql::create_mode::or_replace,
	.volatility = bioseq::sql::volatility::volatile_,
	.parallel = bioseq::sql::parallel_safety::unsafe,
})]]
[[bioseq_sql::revoke({
	.privileges = bioseq::sql::privileges::all,
	.from = bioseq::sql::public_role,
})]]
/** @brief Reports match-helper ownership and copy-on-write propagation through Projection, Material, Memoize, Unique, and Append paths. */
bioseq::pg_utils::named_out<
	bioseq::table::match_helper_wrapper_propagation_probe_row>
match_helper_wrapper_propagation_probe() {

	const BioseqStubOids& oids = get_cached_stub_oids();
	auto* planner_root = makeNode(PlannerInfo);
	planner_root->parse = makeNode(Query);
	planner_root->glob = makeNode(PlannerGlobal);
	planner_root->query_level = 1;

	auto* left_rel = match_helper_wrapper_probe_rel(
		RELOPT_BASEREL, 1, bms_make_singleton(1));
	auto* right_rel = match_helper_wrapper_probe_rel(
		RELOPT_BASEREL, 2, bms_make_singleton(2));
	auto* sibling_rel = match_helper_wrapper_probe_rel(
		RELOPT_BASEREL, 3, bms_make_singleton(3));
	auto* join_rel = match_helper_wrapper_probe_rel(
		RELOPT_JOINREL, 0,
		bms_union(bms_make_singleton(1), bms_make_singleton(2)));

	/* Use an actual registered match-result helper as the propagated identity.
	 * The NULL sequence recipe keeps the standalone cost probe independent of
	 * a synthetic range table while retaining the exact bioseq.seq type/equality
	 * contract checked by per_row_known_path_owner_recipe(). */
	Node* recipe = reinterpret_cast<Node*>(makeNullConst(
		oids.bioseq_seq_type_oid, -1, InvalidOid));
	auto* helper = makeFuncExpr(
		oids.query_len_oid,
		get_func_rettype(oids.query_len_oid),
		list_make1(copyObject(recipe)),
		InvalidOid,
		InvalidOid,
		COERCE_EXPLICIT_CALL);
	Node* helper_identity = reinterpret_cast<Node*>(helper);

	auto* left = makeNode(Path);
	match_helper_wrapper_probe_init_path(
		left, T_SeqScan, left_rel, create_empty_pathtarget());
	auto* right = makeNode(Path);
	match_helper_wrapper_probe_init_path(
		right, T_SeqScan, right_rel, create_empty_pathtarget());

	auto* owner = makeNode(CustomPath);
	match_helper_wrapper_probe_init_path(
		&owner->path, T_CustomScan, join_rel, create_empty_pathtarget());
	owner->custom_paths = list_make2(left, right);
	owner->custom_restrictinfo = NIL;
	owner->custom_private = list_make5(
		makeInteger(kBioseqBatchJoinPlanVersion),
		makeInteger(1),
		makeInteger(InvalidOid),
		makeInteger(1),
		copyObject(recipe));
	while (list_length(owner->custom_private)
			< kBioseqBatchJoinPathPrivateFields) {
		owner->custom_private = lappend(
			owner->custom_private, makeInteger(0));
	}
	owner->methods = &BioseqBatchJoinPathMethods;

	auto* projection = makeNode(ProjectionPath);
	match_helper_wrapper_probe_init_path(
		&projection->path, T_Result, join_rel, create_empty_pathtarget());
	projection->subpath = &owner->path;
	projection->dummypp = false;

	auto* material = makeNode(MaterialPath);
	match_helper_wrapper_probe_init_path(
		&material->path, T_Material, join_rel, create_empty_pathtarget());
	material->subpath = &projection->path;

	auto* memoize = makeNode(MemoizePath);
	match_helper_wrapper_probe_init_path(
		&memoize->path, T_Memoize, join_rel, create_empty_pathtarget());
	memoize->subpath = &material->path;
	memoize->hash_operators = NIL;
	memoize->param_exprs = NIL;
	memoize->singlerow = false;
	memoize->binary_mode = false;
	memoize->calls = 2.0;
	memoize->est_entries = 1;

	auto* unique = makeNode(UniquePath);
	match_helper_wrapper_probe_init_path(
		&unique->path, T_Unique, join_rel, create_empty_pathtarget());
	unique->subpath = &memoize->path;
	unique->umethod = UNIQUE_PATH_SORT;
	unique->in_operators = NIL;
	unique->uniq_exprs = NIL;

	auto* sibling = makeNode(Path);
	match_helper_wrapper_probe_init_path(
		sibling, T_SeqScan, sibling_rel, create_empty_pathtarget());
	PathTarget* const sibling_target = sibling->pathtarget;

	auto* append = makeNode(AppendPath);
	match_helper_wrapper_probe_init_path(
		&append->path, T_Append, join_rel, create_empty_pathtarget());
	append->subpaths = list_make2(unique, sibling);
	append->first_partial_path = 2;
	append->limit_tuples = -1.0;

	PerRowDescendantOwnerProof proof{};
	per_row_prove_descendant_exact_owner(
		&append->path, recipe, proof);
	const bool exact_owner_found = proof.matches == 1u
		&& proof.owner == owner && !proof.invalid_owner_abi
		&& !proof.unsupported_wrapper;

	bool applied = false;
	bool invalid = false;
	Path* cloned_path = per_row_clone_path_to_helper_owner(
		planner_root, &append->path, owner, helper_identity, applied, invalid);
	auto* cloned_append = IsA(cloned_path, AppendPath)
		? reinterpret_cast<AppendPath*>(cloned_path) : nullptr;
	Path* cloned_unique_path = cloned_append != nullptr
		&& list_length(cloned_append->subpaths) == 2
		? reinterpret_cast<Path*>(linitial(cloned_append->subpaths)) : nullptr;
	auto* cloned_unique = cloned_unique_path != nullptr
		&& IsA(cloned_unique_path, UniquePath)
		? reinterpret_cast<UniquePath*>(cloned_unique_path) : nullptr;
	auto* cloned_memoize = cloned_unique != nullptr
		&& IsA(cloned_unique->subpath, MemoizePath)
		? reinterpret_cast<MemoizePath*>(cloned_unique->subpath) : nullptr;
	auto* cloned_material = cloned_memoize != nullptr
		&& IsA(cloned_memoize->subpath, MaterialPath)
		? reinterpret_cast<MaterialPath*>(cloned_memoize->subpath) : nullptr;
	auto* cloned_projection = cloned_material != nullptr
		&& IsA(cloned_material->subpath, ProjectionPath)
		? reinterpret_cast<ProjectionPath*>(cloned_material->subpath) : nullptr;
	auto* cloned_owner = cloned_projection != nullptr
		&& IsA(cloned_projection->subpath, CustomPath)
		? reinterpret_cast<CustomPath*>(cloned_projection->subpath) : nullptr;

	auto helper_available = [helper_identity](const Path* path) {
		return path != nullptr && path_target_contains_expression(
			path->pathtarget, reinterpret_cast<Expr*>(helper_identity));
	};
	auto cow_clone = [](const Path* clone, const Path* source) {
		return clone != nullptr && source != nullptr && clone != source
			&& clone->pathtarget != source->pathtarget;
	};
	const bool clone_applied = applied && !invalid
		&& cloned_append != nullptr;
	const bool owner_cloned = cow_clone(
		cloned_owner == nullptr ? nullptr : &cloned_owner->path,
		&owner->path);
	const bool projection_cloned = cow_clone(
		cloned_projection == nullptr ? nullptr : &cloned_projection->path,
		&projection->path);
	const bool material_cloned = cow_clone(
		cloned_material == nullptr ? nullptr : &cloned_material->path,
		&material->path);
	const bool memoize_cloned = cow_clone(
		cloned_memoize == nullptr ? nullptr : &cloned_memoize->path,
		&memoize->path);
	const bool unique_cloned = cow_clone(
		cloned_unique == nullptr ? nullptr : &cloned_unique->path,
		&unique->path);
	const bool append_cloned = cow_clone(
		cloned_append == nullptr ? nullptr : &cloned_append->path,
		&append->path);
	const bool helper_on_owner = helper_available(
		cloned_owner == nullptr ? nullptr : &cloned_owner->path);
	const bool helper_on_projection = helper_available(
		cloned_projection == nullptr ? nullptr : &cloned_projection->path);
	const bool helper_on_material = helper_available(
		cloned_material == nullptr ? nullptr : &cloned_material->path);
	const bool helper_on_memoize = helper_available(
		cloned_memoize == nullptr ? nullptr : &cloned_memoize->path);
	const bool helper_on_unique = helper_available(
		cloned_unique == nullptr ? nullptr : &cloned_unique->path);
	const bool helper_on_append = helper_available(
		cloned_append == nullptr ? nullptr : &cloned_append->path);
	const bool originals_unchanged = !helper_available(&owner->path)
		&& !helper_available(&projection->path)
		&& !helper_available(&material->path)
		&& !helper_available(&memoize->path)
		&& !helper_available(&unique->path)
		&& !helper_available(&append->path);
	Path* cloned_sibling = cloned_append != nullptr
		&& list_length(cloned_append->subpaths) == 2
		? reinterpret_cast<Path*>(lsecond(cloned_append->subpaths)) : nullptr;
	const bool sibling_unchanged = cloned_sibling == sibling
		&& cloned_sibling->pathtarget == sibling_target
		&& !helper_available(cloned_sibling);

	/* Equal recipes owned by two distinct nodes are ambiguous; an unknown
	 * CustomPath is an opaque evaluation frontier.  Both must fail closed. */
	auto* second_owner = makeNode(CustomPath);
	*second_owner = *owner;
	second_owner->path.pathtarget = create_empty_pathtarget();
	second_owner->custom_private = static_cast<List*>(
		copyObject(owner->custom_private));
	auto* duplicate_append = makeNode(AppendPath);
	match_helper_wrapper_probe_init_path(
		&duplicate_append->path, T_Append, join_rel,
		create_empty_pathtarget());
	duplicate_append->subpaths = list_make2(owner, second_owner);
	duplicate_append->first_partial_path = 2;
	duplicate_append->limit_tuples = -1.0;
	PerRowDescendantOwnerProof duplicate_proof{};
	per_row_prove_descendant_exact_owner(
		&duplicate_append->path, recipe, duplicate_proof);
	const bool duplicate_owner_rejected = duplicate_proof.matches == 2u
		&& !duplicate_proof.invalid_owner_abi
		&& !duplicate_proof.unsupported_wrapper;

	auto* unknown = makeNode(CustomPath);
	match_helper_wrapper_probe_init_path(
		&unknown->path, T_CustomScan, join_rel, create_empty_pathtarget());
	unknown->custom_paths = list_make1(owner);
	unknown->methods = &match_helper_wrapper_probe_unknown_path_methods();
	PerRowDescendantOwnerProof unknown_proof{};
	per_row_prove_descendant_exact_owner(
		&unknown->path, recipe, unknown_proof);
	const bool unknown_wrapper_rejected = unknown_proof.matches == 0u
		&& unknown_proof.unsupported_wrapper
		&& !unknown_proof.invalid_owner_abi;

	/* GroupResultPath has no child, but it owns executable bare quals outside
	 * PathTarget and ParamPathInfo.  Put one hidden mmsearch beside an otherwise
	 * exact parameterized BioseqScan owner and invoke the production closed-world
	 * proof: the GroupResult qual must invalidate the unique-owner result. */
	auto* bmo_target = makeVar(
		/*varno=*/1, /*varattno=*/1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	auto* bmo_query = makeVar(
		/*varno=*/2, /*varattno=*/1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	auto* bmo_mmsearch = makeFuncExpr(
		oids.mmsearch_oid, BOOLOID,
		list_make2(bmo_target, bmo_query),
		InvalidOid, InvalidOid, COERCE_EXPLICIT_CALL);
	auto* bmo_restriction = makeNode(RestrictInfo);
	bmo_restriction->clause = reinterpret_cast<Expr*>(bmo_mmsearch);
	bmo_restriction->rinfo_serial = 71;
	auto* bmo_param = makeNode(ParamPathInfo);
	bmo_param->ppi_clauses = list_make1(bmo_restriction);
	auto* bmo_owner = makeNode(CustomPath);
	match_helper_wrapper_probe_init_path(
		&bmo_owner->path, T_CustomScan, left_rel, create_empty_pathtarget());
	bmo_owner->path.param_info = bmo_param;
	bmo_owner->custom_paths = NIL;
	bmo_owner->custom_restrictinfo = list_make1(bmo_restriction);
	bmo_owner->custom_private = list_make2(NIL, NIL);
	bmo_owner->custom_private = lappend(
		bmo_owner->custom_private,
		list_make3(
			makeInteger(kBioseqMmsearchOwnerMagic),
			makeInteger(kBioseqMmsearchOwnerVersion),
			list_make1(copyObject(bmo_mmsearch))));
	bmo_owner->methods = &BioseqColumnScanPathMethods;

	auto* hidden_group = makeNode(GroupResultPath);
	match_helper_wrapper_probe_init_path(
		&hidden_group->path, T_Result, sibling_rel,
		create_empty_pathtarget());
	hidden_group->quals = list_make1(copyObject(bmo_mmsearch));
	auto* bmo_append = makeNode(AppendPath);
	match_helper_wrapper_probe_init_path(
		&bmo_append->path, T_Append, join_rel, create_empty_pathtarget());
	bmo_append->subpaths = list_make2(bmo_owner, hidden_group);
	bmo_append->first_partial_path = 2;
	bmo_append->limit_tuples = -1.0;
	ExactParameterizedBmoOwnerProof group_result_proof{};
	count_exact_parameterized_bmo_owners(
		planner_root, &bmo_append->path, bmo_restriction,
		group_result_proof, /*admit_known_wrapper_owner=*/true);
	const bool group_result_qual_rejected = group_result_proof.matches == 1u
		&& group_result_proof.invalid
		&& (group_result_proof.rejection_mask
			& static_cast<std::uint32_t>(kExactBmoNestedJoinClause)) != 0u;

	return bioseq::pg_utils::named_out{
		bioseq::table::match_helper_wrapper_propagation_probe_row{
			.exact_owner_found = exact_owner_found,
			.clone_applied = clone_applied,
			.owner_cloned = owner_cloned,
			.projection_cloned = projection_cloned,
			.material_cloned = material_cloned,
			.memoize_cloned = memoize_cloned,
			.unique_cloned = unique_cloned,
			.append_cloned = append_cloned,
			.helper_on_owner = helper_on_owner,
			.helper_on_projection = helper_on_projection,
			.helper_on_material = helper_on_material,
			.helper_on_memoize = helper_on_memoize,
			.helper_on_unique = helper_on_unique,
			.helper_on_append = helper_on_append,
			.originals_unchanged = originals_unchanged,
			.sibling_unchanged = sibling_unchanged,
			.duplicate_owner_rejected =
				duplicate_owner_rejected,
			.unknown_wrapper_rejected =
				unknown_wrapper_rejected,
			.group_result_qual_rejected =
				group_result_qual_rejected,
		}};
}

}  // namespace bioseq::table::sql_routines

struct PerRowReconstructionRejects {
	std::size_t incumbents = 0u;
	std::size_t unsupported_path = 0u;
	std::size_t invalid_join = 0u;
	std::size_t missing_owned_identity = 0u;
	std::size_t replacement_missing = 0u;
	std::size_t projection_or_leak = 0u;
	std::size_t new_external_parameter = 0u;
	std::size_t unusable_algorithm_clause = 0u;
	std::size_t reconstructed = 0u;
	std::size_t cloned = 0u;
	std::size_t tag_missing = 0u;
	std::size_t source_projection_missing = 0u;
	std::size_t nonfinite_cost = 0u;
	std::size_t owners_created = 0u;
	int last_incumbent_tag = -1;
	int last_outer_tag = -1;
	int last_inner_tag = -1;
	const char* last_incumbent_custom_name = "none";
	const char* last_outer_custom_name = "none";
	const char* last_inner_custom_name = "none";
};

static void per_row_record_path_identity(
		Path* path, int& tag, const char*& custom_name) noexcept {
	tag = path == nullptr ? -1 : static_cast<int>(nodeTag(path));
	custom_name = "none";
	if (path == nullptr || !IsA(path, CustomPath)) return;
	auto* custom = reinterpret_cast<CustomPath*>(path);
	if (custom->methods != nullptr && custom->methods->CustomName != nullptr) {
		custom_name = custom->methods->CustomName;
	}
}

[[nodiscard]] static Path* per_row_reconstruct_inner_join_path(
		PlannerInfo* root, RelOptInfo* joinrel, Path* incumbent,
		RestrictInfo* owned, JoinPathExtraData const& original_extra,
		PathTarget* required_target, List* required_vars,
		const Index target_relid, PerRowReconstructionRejects& rejects) {
	++rejects.incumbents;
	if (root == nullptr || joinrel == nullptr || incumbent == nullptr
		|| owned == nullptr || required_target == nullptr
		|| required_vars == nullptr
		|| !bioseq_is_concrete_rte_varno(target_relid)) {
		++rejects.invalid_join;
		return nullptr;
	}
	per_row_record_path_identity(incumbent,
		rejects.last_incumbent_tag, rejects.last_incumbent_custom_name);
	JoinPath* join = nullptr;
	if (IsA(incumbent, NestPath)) {
		join = &reinterpret_cast<NestPath*>(incumbent)->jpath;
	} else if (IsA(incumbent, MergePath)) {
		join = &reinterpret_cast<MergePath*>(incumbent)->jpath;
	} else if (IsA(incumbent, HashPath)) {
		join = &reinterpret_cast<HashPath*>(incumbent)->jpath;
	} else {
		++rejects.unsupported_path;
		return nullptr;
	}
	if (join->jointype != JOIN_INNER
		|| join->outerjoinpath == nullptr || join->innerjoinpath == nullptr
		|| batch_join_path_contains_parallel_execution(incumbent)) {
		++rejects.invalid_join;
		return nullptr;
	}
	per_row_record_path_identity(join->outerjoinpath,
		rejects.last_outer_tag, rejects.last_outer_custom_name);
	per_row_record_path_identity(join->innerjoinpath,
		rejects.last_inner_tag, rejects.last_inner_custom_name);
	Path* outer_path = join->outerjoinpath;
	Path* inner_path = join->innerjoinpath;
	const bool join_owns = list_member_ptr(join->joinrestrictinfo, owned);
	const bool outer_owns = per_row_descendant_owns_restriction(
		outer_path, owned);
	const bool inner_owns = per_row_descendant_owns_restriction(
		inner_path, owned);
	if (IsA(incumbent, NestPath)) {
		if (!join_owns && !outer_owns && !inner_owns) {
			++rejects.missing_owned_identity;
			return nullptr;
		}
	} else if (!join_owns) {
		/* Merge/Hash cannot legally push the join predicate into one child. */
		++rejects.missing_owned_identity;
		return nullptr;
	}
	const bool outer_is_target = outer_path->parent != nullptr
		&& bms_is_member(
			static_cast<int>(target_relid), outer_path->parent->relids);
	const bool inner_is_target = inner_path->parent != nullptr
		&& bms_is_member(
			static_cast<int>(target_relid), inner_path->parent->relids);
	const bool outer_needs_source = outer_is_target
		&& !slice_project_path_tree_has_bioseq_scan(outer_path);
	const bool inner_needs_source = inner_is_target
		&& !slice_project_path_tree_has_bioseq_scan(inner_path);
	/* Only a nested loop can push the exact join RestrictInfo into a
	 * parameterized child.  Provider-only replacement is also valid for
	 * Merge/Hash: their reconstruction below retains the required sort/hash
	 * clauses while swapping an IndexPath for a source-owning BioseqScan. */
	if ((outer_owns || inner_owns) && !IsA(incumbent, NestPath)) {
		++rejects.invalid_join;
		return nullptr;
	}
	if (outer_owns || inner_owns || outer_needs_source || inner_needs_source) {
		/* Rebuild each affected side from a legal path whose complete descendant
		 * tree does not own the predicate; unrelated LATERAL parameters remain
		 * valid and are checked against the incumbent frontier below. */
		if (outer_owns || outer_needs_source) outer_path =
			per_row_path_without_owned_qual(
				join->outerjoinpath->parent, owned, outer_is_target);
		if (inner_owns || inner_needs_source) inner_path =
			per_row_path_without_owned_qual(
				join->innerjoinpath->parent, owned, inner_is_target);
		if (outer_path == nullptr || inner_path == nullptr) {
			++rejects.replacement_missing;
			return nullptr;
		}
	}
	outer_path = per_row_project_required_child_vars(
		root, outer_path, required_vars);
	inner_path = per_row_project_required_child_vars(
		root, inner_path, required_vars);
	if (outer_path == nullptr || inner_path == nullptr
		|| per_row_descendant_owns_restriction(outer_path, owned)
		|| per_row_descendant_owns_restriction(inner_path, owned)) {
		++rejects.projection_or_leak;
		return nullptr;
	}
	List* filtered_restrictions = per_row_without_restriction(
		join->joinrestrictinfo, owned);
	JoinPathExtraData filtered_extra = original_extra;
	filtered_extra.inner_unique = join->inner_unique;
	filtered_extra.restrictlist = per_row_without_restriction(
		original_extra.restrictlist, owned);
	filtered_extra.mergeclause_list = per_row_without_restriction(
		original_extra.mergeclause_list, owned);
	JoinCostWorkspace workspace{};
	if (IsA(incumbent, NestPath)) {
		Relids calculated_required_outer = calc_nestloop_required_outer(
			outer_path->parent->relids, PATH_REQ_OUTER(outer_path),
			inner_path->parent->relids, PATH_REQ_OUTER(inner_path));
		Relids required_outer = bms_copy(PATH_REQ_OUTER(&join->path));
		/* Removing the owned predicate can remove an internal nestloop
		 * dependency, but it must never introduce a new dependency outside
		 * the join.  Preserve the incumbent's exact external parameter ABI so
		 * LATERAL/partition rescans remain attached to the same frontier. */
		if (!bms_is_subset(calculated_required_outer, required_outer)) {
			++rejects.new_external_parameter;
			bms_free(calculated_required_outer);
			bms_free(required_outer);
			return nullptr;
		}
		bms_free(calculated_required_outer);
		List* reconstructed_pathkeys = pathkeys_contained_in(
			join->path.pathkeys, outer_path->pathkeys)
			? join->path.pathkeys : outer_path->pathkeys;
		initial_cost_nestloop(root, &workspace, JOIN_INNER,
			outer_path, inner_path, &filtered_extra);
		Path* result = reinterpret_cast<Path*>(create_nestloop_path(
			root, joinrel, JOIN_INNER, &workspace, &filtered_extra,
			outer_path, inner_path,
			filtered_restrictions, reconstructed_pathkeys, required_outer));
		if (result != nullptr) ++rejects.reconstructed;
		return result;
	}
	Relids required_outer = calc_non_nestloop_required_outer(
		outer_path, inner_path);
	if (!bms_equal(required_outer, PATH_REQ_OUTER(&join->path))) {
		++rejects.new_external_parameter;
		return nullptr;
	}
	if (IsA(incumbent, MergePath)) {
		auto* merge = reinterpret_cast<MergePath*>(incumbent);
		List* mergeclauses = per_row_without_restriction(
			merge->path_mergeclauses, owned);
		if (mergeclauses == NIL) {
			++rejects.unusable_algorithm_clause;
			return nullptr;
		}
		/* A provider-only replacement can swap a presorted IndexPath for an
		 * unordered BioseqScan.  NIL in the incumbent's sort-key fields means its
		 * original child already supplies the effective order; it does not mean
		 * an arbitrary replacement is ordered.  Capture that proven contract,
		 * validate it still covers every retained merge clause, and request an
		 * explicit sort exactly where a replacement no longer satisfies it. */
		List* effective_outer_pathkeys = merge->outersortkeys != NIL
			? merge->outersortkeys : join->outerjoinpath->pathkeys;
		List* effective_inner_pathkeys = merge->innersortkeys != NIL
			? merge->innersortkeys : join->innerjoinpath->pathkeys;
		if (effective_outer_pathkeys == NIL || effective_inner_pathkeys == NIL) {
			++rejects.unusable_algorithm_clause;
			return nullptr;
		}
		List* ordered_mergeclauses = find_mergeclauses_for_outer_pathkeys(
			root, effective_outer_pathkeys, mergeclauses);
		List* required_inner_pathkeys = ordered_mergeclauses == NIL
			? NIL : make_inner_pathkeys_for_merge(
				root, ordered_mergeclauses, effective_outer_pathkeys);
		if (ordered_mergeclauses == NIL
			|| list_length(ordered_mergeclauses)
				!= list_length(mergeclauses)
			|| required_inner_pathkeys == NIL
			|| !pathkeys_contained_in(
				required_inner_pathkeys, effective_inner_pathkeys)) {
			++rejects.unusable_algorithm_clause;
			return nullptr;
		}
		List* outer_sortkeys = pathkeys_contained_in(
			effective_outer_pathkeys, outer_path->pathkeys)
			? NIL : effective_outer_pathkeys;
		List* inner_sortkeys = pathkeys_contained_in(
			effective_inner_pathkeys, inner_path->pathkeys)
			? NIL : effective_inner_pathkeys;
		filtered_extra.mergeclause_list = ordered_mergeclauses;
		initial_cost_mergejoin(root, &workspace, JOIN_INNER,
			ordered_mergeclauses, outer_path, inner_path,
			outer_sortkeys, inner_sortkeys, &filtered_extra);
		Path* result = reinterpret_cast<Path*>(create_mergejoin_path(
			root, joinrel, JOIN_INNER, &workspace, &filtered_extra,
			outer_path, inner_path,
			filtered_restrictions, join->path.pathkeys, required_outer,
			ordered_mergeclauses, outer_sortkeys, inner_sortkeys));
		if (result != nullptr) ++rejects.reconstructed;
		return result;
	}
	auto* hash = reinterpret_cast<HashPath*>(incumbent);
	List* hashclauses = per_row_without_restriction(
		hash->path_hashclauses, owned);
	if (hashclauses == NIL) {
		++rejects.unusable_algorithm_clause;
		return nullptr;
	}
	const bool parallel_hash = inner_path->parallel_aware;
	initial_cost_hashjoin(root, &workspace, JOIN_INNER,
		hashclauses, outer_path, inner_path,
		&filtered_extra, parallel_hash);
	Path* result = reinterpret_cast<Path*>(create_hashjoin_path(
		root, joinrel, JOIN_INNER, &workspace, &filtered_extra,
		outer_path, inner_path, parallel_hash,
		filtered_restrictions, required_outer, hashclauses));
	if (result != nullptr) ++rejects.reconstructed;
	return result;
}

[[nodiscard]] static bool per_row_decline_transformed_path(
		const char* stage) {
	(void)stage;
	return false;
}

[[nodiscard]] static bool per_row_add_transformed_mmsearch_paths(
		PlannerInfo* root, RelOptInfo* joinrel, JoinPathExtraData* extra,
		RestrictInfo* restriction, FuncExpr* mmsearch,
		FuncExpr* executable_mmsearch,
		bioseq::indexing::IndexReadRequirement requirement,
		BioseqStubOids const& oids) {
	if (root == nullptr || joinrel == nullptr || extra == nullptr
		|| restriction == nullptr || mmsearch == nullptr
		|| executable_mmsearch == nullptr) return false;
	PList<Node> operands(mmsearch->args);
	Node* target_expression = operands.first();
	Node* query_expression = operands.second();
	const auto target_typmod_proof = per_row_sequence_typmod_proof(
		target_expression, oids);
	const auto query_typmod_proof = per_row_sequence_typmod_proof(
		query_expression, oids);
	if (target_typmod_proof.has_value()
		&& query_typmod_proof.has_value()
		&& batch_join_typmod_is_supported(target_typmod_proof->typmod)
		&& batch_join_typmod_is_supported(query_typmod_proof->typmod)
		&& !mmsearch_typmods_share_alphabet(
			target_typmod_proof->typmod, query_typmod_proof->typmod)) {
		raise_mmsearch_alphabet_mismatch(
			compact_sequence_stdc_type_params::decode(
				target_typmod_proof->typmod),
			compact_sequence_stdc_type_params::decode(
				query_typmod_proof->typmod),
			"join planning");
	}
	if (exprType(target_expression) != oids.bioseq_seq_type_oid
		|| exprType(query_expression) != oids.bioseq_seq_type_oid
		|| !target_typmod_proof.has_value()
		|| !query_typmod_proof.has_value()
		|| !batch_join_typmod_is_supported(target_typmod_proof->typmod)
		|| !batch_join_typmod_is_supported(query_typmod_proof->typmod)
		|| !mmsearch_typmods_share_alphabet(
			target_typmod_proof->typmod, query_typmod_proof->typmod)
		|| exprCollation(target_expression) != exprCollation(query_expression)
		|| requirement
			== bioseq::indexing::IndexReadRequirement::require_compatible_persisted) {
		return per_row_decline_transformed_path("typmod_or_requirement");
	}
	PerRowOperandSourceProof target_sources{};
	PerRowOperandSourceProof query_sources{};
	if (!per_row_collect_operand_sources(
			target_expression, joinrel, target_sources)
		|| !per_row_collect_operand_sources(
			query_expression, joinrel, query_sources)) {
		return per_row_decline_transformed_path("operand_sources");
	}
	Var* target_source = nullptr;
	RangeTblEntry* target_rte = nullptr;
	for (Var* candidate : PList<Var>(target_sources.sequence_vars)) {
		if (!bioseq_is_concrete_rte_varno(candidate->varno)
			|| candidate->varno > static_cast<Index>(
				list_length(root->parse->rtable))) continue;
		RangeTblEntry* rte = rt_fetch(candidate->varno, root->parse->rtable);
		if (rte != nullptr && rte->rtekind == RTE_RELATION
			&& rte->securityQuals == NIL && OidIsValid(rte->relid)
			&& IsBioseqColumnTableAmTable(rte->relid)) {
			target_source = candidate;
			target_rte = rte;
			break;
		}
	}
	if (target_source == nullptr || target_rte == nullptr) {
		return per_row_decline_transformed_path("target_source");
	}
	if (!per_row_output_semantics_are_supported(
			joinrel->reltarget, target_source->varno,
			joinrel->relids, target_expression)) {
		return per_row_decline_transformed_path("output_semantics");
	}
	for (Var* source : PList<Var>(query_sources.sequence_vars)) {
		if (!bioseq_is_concrete_rte_varno(source->varno)
			|| source->varno > static_cast<Index>(
				list_length(root->parse->rtable))) {
			return per_row_decline_transformed_path("query_source_rti");
		}
		RangeTblEntry* rte = rt_fetch(source->varno, root->parse->rtable);
		if (rte == nullptr || rte->rtekind != RTE_RELATION
			|| rte->securityQuals != NIL) {
			return per_row_decline_transformed_path("query_source_security");
		}
	}
	PerRowOwnerSupportProof owner_support{};
	if (!per_row_collect_owner_support(
			root, joinrel, target_source->varno,
			target_expression, owner_support)) {
		return per_row_decline_transformed_path("owner_support");
	}
	PathTarget* required_target = create_empty_pathtarget();
	List* required_vars = NIL;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* owner_setrefs_carrier_vars = NIL;
	if (!per_row_collect_setrefs_carrier_vars(
			target_expression, owner_support.helper_argument_vars,
			joinrel->relids, owner_setrefs_carrier_vars)) {
		return per_row_decline_transformed_path("setrefs_carrier_vars");
	}
	for (Node* expression : PList<Node>(joinrel->reltarget->exprs)) {
		required_vars = list_concat(required_vars,
			pull_var_clause(expression, pull_flags));
	}
	for (RestrictInfo* residual : PList<RestrictInfo>(extra->restrictlist)) {
		if (residual == nullptr || residual == restriction) continue;
		required_vars = list_concat(required_vars,
			pull_var_clause(
				reinterpret_cast<Node*>(residual->clause), pull_flags));
	}
	required_vars = list_concat(
		required_vars, list_copy(owner_setrefs_carrier_vars));
	required_vars = list_concat(required_vars,
		pull_var_clause(query_expression, pull_flags));
	required_vars = list_concat(
		required_vars, list_copy(owner_support.passthrough_vars));
	for (Node* required : PList<Node>(required_vars)) {
		Var* var = pg_node_try_as<Var>(required);
		const bool row_identity = per_row_is_exact_row_identity_var(var);
		if (var == nullptr || !bioseq_is_concrete_rte_varno(var->varno)
			|| (var->varattno <= 0 && !row_identity)
			|| var->varlevelsup != 0
			|| !bms_is_empty(var->varnullingrels)
			|| !bms_is_member(
				static_cast<int>(var->varno), joinrel->relids)) {
			return per_row_decline_transformed_path("required_var");
		}
	}
	add_new_columns_to_pathtarget(required_target, required_vars);
	set_pathtarget_cost_width(root, required_target);
	PathTarget* owner_target = per_row_build_owner_target(
		root, joinrel->reltarget);
	if (owner_target == nullptr) {
		return per_row_decline_transformed_path("owner_target_authority");
	}
	if (!equal(owner_target->exprs, joinrel->reltarget->exprs)
		|| list_length(owner_target->exprs)
			!= list_length(joinrel->reltarget->exprs)) {
		return per_row_decline_transformed_path("owner_target_widened");
	}
	set_pathtarget_cost_width(root, owner_target);

	PathTarget* recipe_target = copy_pathtarget(required_target);
	if (!path_target_contains_expression(
			recipe_target, reinterpret_cast<Expr*>(target_expression))) {
		add_column_to_pathtarget(recipe_target,
			reinterpret_cast<Expr*>(copyObject(target_expression)), 0);
	}
	if (!path_target_contains_expression(
			recipe_target, reinterpret_cast<Expr*>(query_expression))) {
		add_column_to_pathtarget(recipe_target,
			reinterpret_cast<Expr*>(copyObject(query_expression)), 0);
	}
	set_pathtarget_cost_width(root, recipe_target);
	SliceProjectIrBuilder builder{
		.oids = &oids,
		.command_type = CMD_UNKNOWN,
		.planner_root = root,
		.target_leaf_support_relid = target_source->varno,
		.target_leaf_support_vars = owner_support.helper_argument_vars,
	};
	if (!slice_project_discover_target(recipe_target, builder)) {
		return per_row_decline_transformed_path("recipe_discovery");
	}
	const std::uint32_t target_producer = slice_project_add_producer(
		builder, target_expression);
	const std::uint32_t query_producer = slice_project_add_producer(
		builder, query_expression);
	bioseq::simd::Minimap2Params planned_params =
		build_params_from_gucs();
	bioseq::indexing::IndexReadRequirement planned_requirement =
		bioseq::indexing::IndexReadRequirement::allow;
	(void)apply_aligner_options_override(
		executable_mmsearch, planned_params, planned_requirement, oids);
	if (mmsearch_plans_admitted_packed_regions(planned_params)) {
		slice_project_add_boundary(builder, target_expression, target_producer,
			materialization_mechanism::packed_region,
			materialization_reason::mmsearch_target, true);
		slice_project_add_boundary(builder, query_expression, query_producer,
			materialization_mechanism::packed_region,
			materialization_reason::mmsearch_query, true);
	}

	PList<Path> owners;
	PerRowReconstructionRejects reconstruction_rejects{};
	List* incumbent_paths = list_copy(joinrel->pathlist);
	Cost incumbent_floor = std::numeric_limits<Cost>::max();
	for (Path* incumbent : PList<Path>(incumbent_paths)) {
		if (incumbent != nullptr && std::isfinite(incumbent->total_cost)
			&& incumbent->total_cost >= 0) {
			incumbent_floor = std::min(
				incumbent_floor, incumbent->total_cost);
		}
	}
	for (Path* incumbent : PList<Path>(incumbent_paths)) {
		Path* helper_ready_incumbent = incumbent;
		PathTarget* incumbent_required_target = copy_pathtarget(required_target);
		List* proven_inherited_helpers = NIL;
		bool helper_provenance_invalid = false;
		for (Node* identity : PList<Node>(owner_support.helper_identities)) {
			FuncExpr* helper = nullptr;
			if (PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(
					identity)) {
				helper = batch_join_match_helper_phv_function(
					placeholder, oids);
			} else {
				helper = batch_join_well_formed_match_helper(identity, oids);
			}
			Node* argument = batch_join_match_helper_argument(helper);
			if (helper == nullptr || argument == nullptr) {
				helper_provenance_invalid = true;
				break;
			}
			PerRowDescendantOwnerProof proof{};
			per_row_prove_descendant_exact_owner(
				helper_ready_incumbent, argument, proof);
			PerRowBaseHelperOwnerProof base_proof{};
			per_row_prove_descendant_base_helper_owner(
				helper_ready_incumbent, helper, base_proof);
			if (proof.invalid_owner_abi || proof.unsupported_wrapper
				|| base_proof.invalid_owner_abi
				|| base_proof.unsupported_wrapper
				|| proof.matches > 1u || base_proof.matches > 1u
				|| proof.matches + base_proof.matches > 1u) {
				helper_provenance_invalid = true;
				break;
			}
			/* root->processed_tlist is query-global.  No descendant match means
			 * either that this exact helper belongs to the owner being constructed,
			 * or that its owner will be constructed at a higher join frontier.  In
			 * both cases it is not inherited here.  A helper with one exact
			 * descendant remains inherited, while multiplicity still fails above. */
			if (proof.matches + base_proof.matches == 0u) continue;
			CustomPath* inherited_owner = proof.matches == 1u
				? proof.owner : base_proof.owner;
			bool applied = false;
			bool propagation_invalid = false;
			helper_ready_incumbent = per_row_clone_path_to_helper_owner(
				root, helper_ready_incumbent, inherited_owner, identity,
				applied, propagation_invalid);
			if (!applied || propagation_invalid) {
				helper_provenance_invalid = true;
				break;
			}
			if (!path_target_contains_expression(
					incumbent_required_target,
					reinterpret_cast<Expr*>(identity))) {
				add_column_to_pathtarget(
					incumbent_required_target,
					reinterpret_cast<Expr*>(copyObject(identity)), 0);
			}
			per_row_append_unique_expression(
				proven_inherited_helpers, identity);
		}
		if (helper_provenance_invalid) {
			++reconstruction_rejects.projection_or_leak;
			continue;
		}
		set_pathtarget_cost_width(root, incumbent_required_target);
		Path* reconstructed = per_row_reconstruct_inner_join_path(
			root, joinrel, helper_ready_incumbent, restriction, *extra,
			incumbent_required_target, required_vars, target_source->varno,
			reconstruction_rejects);
		if (reconstructed == nullptr) continue;
		/* Re-run the exact pointer audit on the finished reconstructed path,
		 * before copyObject can turn a leaked RestrictInfo into a merely-equal
		 * private copy and before any Plan node exists. */
		if (per_row_descendant_owns_restriction(
				reconstructed, restriction)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqPerRowMmsearch reconstructed path retained its owned RestrictInfo")));
		}
		for (Node* identity : PList<Node>(proven_inherited_helpers)) {
			FuncExpr* helper = pg_node_try_as<PlaceHolderVar>(identity) != nullptr
				? batch_join_match_helper_phv_function(
					pg_node_try_as<PlaceHolderVar>(identity), oids)
				: batch_join_well_formed_match_helper(identity, oids);
			PerRowDescendantOwnerProof proof{};
			per_row_prove_descendant_exact_owner(
				reconstructed, batch_join_match_helper_argument(helper), proof);
			PerRowBaseHelperOwnerProof base_proof{};
			per_row_prove_descendant_base_helper_owner(
				reconstructed, helper, base_proof);
			const std::size_t owner_matches =
				proof.matches + base_proof.matches;
			CustomPath* inherited_owner = proof.matches == 1u
				? proof.owner : base_proof.owner;
			if (proof.invalid_owner_abi || proof.unsupported_wrapper
				|| base_proof.invalid_owner_abi
				|| base_proof.unsupported_wrapper
				|| owner_matches != 1u || inherited_owner == nullptr
				|| inherited_owner->path.pathtarget == nullptr
				|| !path_target_contains_expression(
					inherited_owner->path.pathtarget,
					reinterpret_cast<Expr*>(identity))) {
				helper_provenance_invalid = true;
				break;
			}
		}
		if (helper_provenance_invalid) {
			++reconstruction_rejects.projection_or_leak;
			continue;
		}
		Path* private_join = slice_project_clone_mutable_path_spine(reconstructed);
		++reconstruction_rejects.cloned;
		if (!per_row_normalize_private_path_spine(
				root, private_join, owner_support.helper_identities,
				proven_inherited_helpers, required_vars)) {
			++reconstruction_rejects.projection_or_leak;
			continue;
		}
		private_join->pathtarget = copy_pathtarget(incumbent_required_target);
		bool tagged_source = false;
		private_join = slice_project_tag_owned_path_tree(
			private_join, builder, tagged_source);
		if (!tagged_source) {
			++reconstruction_rejects.tag_missing;
			continue;
		}
		Path* source_path = reinterpret_cast<Path*>(create_projection_path(
			root, joinrel, private_join, incumbent_required_target));
		if (source_path == nullptr) {
			++reconstruction_rejects.source_projection_missing;
			continue;
		}

		PathTarget* incumbent_recipe_target = copy_pathtarget(recipe_target);
		for (Node* identity : PList<Node>(proven_inherited_helpers)) {
			if (!path_target_contains_expression(
					incumbent_recipe_target,
					reinterpret_cast<Expr*>(identity))) {
				add_column_to_pathtarget(
					incumbent_recipe_target,
					reinterpret_cast<Expr*>(copyObject(identity)), 0);
			}
		}
		set_pathtarget_cost_width(root, incumbent_recipe_target);
		auto* recipe_path = makeNode(CustomPath);
		recipe_path->path.pathtype = T_CustomScan;
		recipe_path->path.parent = joinrel;
		recipe_path->path.pathtarget = incumbent_recipe_target;
		recipe_path->path.param_info = source_path->param_info;
		recipe_path->path.parallel_aware = false;
		recipe_path->path.parallel_safe = false;
		recipe_path->path.parallel_workers = 0;
		recipe_path->path.rows = source_path->rows;
		QualCost recipe_cost{};
		cost_qual_eval(&recipe_cost, incumbent_recipe_target->exprs, root);
		recipe_path->path.startup_cost = source_path->startup_cost
			+ recipe_cost.startup;
		recipe_path->path.total_cost = source_path->total_cost
			+ recipe_cost.startup + std::max(0.0, source_path->rows)
				* recipe_cost.per_tuple;
		recipe_path->path.pathkeys = source_path->pathkeys;
		recipe_path->flags = CUSTOMPATH_SUPPORT_PROJECTION;
		recipe_path->custom_paths = list_make1(source_path);
		recipe_path->custom_private = list_make5(
			slice_project_header(builder), copyObject(builder.expressions),
			copyObject(builder.nodes), copyObject(builder.records),
			copyObject(builder.output_bindings));
		recipe_path->custom_restrictinfo = NIL;
		recipe_path->methods = &bioseq_slice_project_path_methods();

		QualCost operand_cost{};
		cost_qual_eval(&operand_cost,
			mmsearch_operand_cost_exprs(executable_mmsearch, oids), root);
		const std::uint64_t target_symbols =
			estimate_mmsearch_operand_symbols(target_expression, oids);
		const std::uint64_t query_symbols =
			estimate_mmsearch_operand_symbols(query_expression, oids);
		const owned_mmsearch_cost alignment_cost = estimate_owned_mmsearch_cost(
			target_symbols, query_symbols, recipe_path->path.rows,
			/*index_read_requirement=*/false,
			static_cast<std::uint32_t>(kBioseqRuntimeBufferReserve),
			bioseq::parallelism::saturating_add(
				target_symbols, query_symbols));
		const Cost startup = std::max<Cost>(0,
			recipe_path->path.startup_cost + operand_cost.startup
				+ alignment_cost.startup);
		const Cost total = std::max(startup,
			recipe_path->path.total_cost + operand_cost.startup
				+ alignment_cost.startup
				+ std::max(0.0, recipe_path->path.rows)
					* (operand_cost.per_tuple
						+ alignment_cost.per_input_tuple + cpu_tuple_cost));
		if (!std::isfinite(startup) || !std::isfinite(total)) {
			++reconstruction_rejects.nonfinite_cost;
			continue;
		}

		auto* owner = makeNode(CustomPath);
		owner->path.pathtype = T_CustomScan;
		owner->path.parent = joinrel;
		owner->path.pathtarget = copy_pathtarget(owner_target);
		owner->path.param_info = recipe_path->path.param_info;
		owner->path.parallel_aware = false;
		owner->path.parallel_safe = false;
		owner->path.parallel_workers = 0;
		owner->path.rows = recipe_path->path.rows;
		owner->path.startup_cost = startup;
		owner->path.total_cost = total;
		owner->path.pathkeys = recipe_path->path.pathkeys;
		/* Keep core from folding a later SELECT/RETURNING projection into this
		 * CustomScan after PlanCustomPath has registered descriptor identities.
		 * A normal Result above the owner can bind whole helpers through the
		 * owner-support target without ever executing their SQL stubs. */
		owner->flags = 0;
		owner->custom_paths = list_make1(recipe_path);
		owner->custom_restrictinfo = list_make1(restriction);
		const auto typmod = compact_sequence_stdc_type_params::decode(
			target_typmod_proof->typmod);
		owner->custom_private = list_make5(
			makeInteger(kBioseqPerRowJoinPlanVersion),
			makeInteger(static_cast<int>(target_rte->relid)),
			makeInteger(static_cast<int>(target_source->varno)),
			makeInteger(static_cast<int>(target_source->varattno)),
			copyObject(target_expression));
		owner->custom_private = lappend(
			owner->custom_private, copyObject(query_expression));
		owner->custom_private = lappend(
			owner->custom_private, copyObject(executable_mmsearch));
		owner->custom_private = lappend(owner->custom_private,
			makeInteger(typmod.alphabet_code));
		owner->custom_private = lappend(owner->custom_private,
			makeInteger(typmod.storage_unit_byte_width));
		owner->custom_private = lappend(owner->custom_private,
			makeInteger(static_cast<int>(
				bioseq::indexing::IndexReadRequirement::require_absent)));
		owner->custom_private = lappend(owner->custom_private,
			make_batch_join_cost_const(startup));
		owner->custom_private = lappend(owner->custom_private,
			make_batch_join_cost_const(total));
		owner->custom_private = lappend(owner->custom_private,
			make_batch_join_cost_const(std::isfinite(incumbent_floor)
				? incumbent_floor : total));
		Assert(list_length(owner->custom_private)
			== kBioseqPerRowJoinPathPrivateFields);
		owner->methods = &BioseqPerRowJoinPathMethods;
		owners.append(reinterpret_cast<Path*>(owner));
		++reconstruction_rejects.owners_created;
	}
	if (owners.empty()) {
		return false;
	}
	PList<Path> retained;
	for (Path* incumbent : PList<Path>(joinrel->pathlist)) {
		if (incumbent != nullptr && IsA(incumbent, CustomPath)
			&& list_member_ptr(
				reinterpret_cast<CustomPath*>(incumbent)->custom_restrictinfo,
				restriction)) retained.append(incumbent);
	}
	joinrel->pathlist = retained.release();
	joinrel->partial_pathlist = NIL;
	for (Path* owner : owners) add_path(joinrel, owner);
	return true;
}

static void
BioseqBatchJoinSetJoinPathlistHook(
		PlannerInfo* root,
		RelOptInfo* joinrel,
		RelOptInfo* outerrel,
		RelOptInfo* innerrel,
		JoinType jointype,
		JoinPathExtraData* extra) {
	if (PreviousSetJoinPathlistHook != nullptr) {
		PreviousSetJoinPathlistHook(
			root, joinrel, outerrel, innerrel, jointype, extra);
	}
	if (root == nullptr || joinrel == nullptr || outerrel == nullptr
		|| innerrel == nullptr || extra == nullptr || jointype != JOIN_INNER) {
		return;
	}
	// shared_preload_libraries installs this hook cluster-wide. Databases that
	// have not installed Bioseq must retain ordinary PostgreSQL join planning.
	if (!OidIsValid(get_extension_oid("bioseq", /*missing_ok=*/true))) {
		return;
	}

	const BioseqStubOids* stub_oids = try_get_cached_stub_oids();
	if (stub_oids == nullptr) {
		return;
	}
	const BioseqStubOids& oids = *stub_oids;
	std::size_t semantic_calls = 0;
	RestrictInfo* restriction = nullptr;
	for (RestrictInfo* candidate : PList<RestrictInfo>(extra->restrictlist)) {
		const std::size_t calls = count_mmsearch_occurrences(
			reinterpret_cast<Node*>(candidate->clause), oids);
		semantic_calls += calls;
		if (calls != 0) restriction = candidate;
	}
	if (semantic_calls > 1) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("stacked mmsearch join qualifiers are unsupported"),
			 errhint("Split the alignment predicates into separate query levels.")));
	}
	if (semantic_calls != 1 || restriction == nullptr) {
		return;
	}
	FuncExpr* mmsearch = restriction == nullptr
		? nullptr
		: pg_node_try_as<FuncExpr>(
			reinterpret_cast<Node*>(restriction->clause));
	if (mmsearch == nullptr || !is_mmsearch_funcid(mmsearch->funcid, oids)
		|| (mmsearch->funcid == oids.mmsearch_oid
			&& list_length(mmsearch->args) != 2)
		|| (mmsearch->funcid == oids.mmsearch_with_opts_oid
			&& list_length(mmsearch->args) != 3)) {
		return;
	}
	if (root->parse == nullptr || root->parse->hasRowSecurity
		|| restriction->pseudoconstant || restriction->security_level != 0
		|| !restriction_is_securely_promotable(restriction, joinrel)) {
		return;
	}
	for (RestrictInfo* sibling : PList<RestrictInfo>(extra->restrictlist)) {
		if (sibling != restriction && contain_volatile_functions(
				reinterpret_cast<Node*>(sibling->clause))) {
			/* The first release does not claim an evaluation-order-preserving
			 * split around an effectful sibling. */
			return;
		}
	}
	List* residual_join_restrictions = NIL;
	for (RestrictInfo* candidate : PList<RestrictInfo>(extra->restrictlist)) {
		if (candidate != restriction) {
			residual_join_restrictions = lappend(
				residual_join_restrictions, candidate);
		}
	}
	PList<Node> arguments(mmsearch->args);
	Var* target_var = pg_node_try_as<Var>(arguments.first());
	Var* query_var = pg_node_try_as<Var>(arguments.second());
	/* Eligibility is non-throwing: fold only the option expression on a
	 * private copy. A typed NULL Const means default options. */
	auto* batch_mmsearch = static_cast<FuncExpr*>(copyObject(mmsearch));
	if (list_length(mmsearch->args) == 3) {
		Node* folded_options = eval_const_expressions(
			root, reinterpret_cast<Node*>(copyObject(arguments.third())));
		Const* options = pg_node_try_as<Const>(folded_options);
		if (options == nullptr
			|| options->consttype != oids.bioseq_aligner_options_type_oid) {
			return;
		}
		lfirst(list_nth_cell(batch_mmsearch->args, 2)) = folded_options;
	}
	/* Decode options before choosing the raw two-child or transformed
	 * one-child ownership shape. */
	bioseq::simd::Minimap2Params planned_params =
		build_params_from_gucs();
	bioseq::indexing::IndexReadRequirement planned_requirement =
		bioseq::indexing::IndexReadRequirement::allow;
	(void)apply_aligner_options_override(
		batch_mmsearch, planned_params, planned_requirement, oids);
	finalize_simd_chaining_policy(planned_params);
	const bool transformed_operands =
		bioseq_expr_uses_lazy_sequence_projection(arguments.first())
		|| bioseq_expr_uses_lazy_sequence_projection(arguments.second());
	auto is_base_input = [](RelOptInfo const* input) noexcept {
		return input != nullptr
			&& (input->reloptkind == RELOPT_BASEREL
				|| input->reloptkind == RELOPT_OTHER_MEMBER_REL);
	};
	auto is_join_input = [](RelOptInfo const* input) noexcept {
		return input != nullptr && input->reloptkind == RELOPT_JOINREL;
	};
	const bool two_base_inputs =
		is_base_input(outerrel) && is_base_input(innerrel);
	const bool one_join_one_base =
		(is_join_input(outerrel) && is_base_input(innerrel))
		|| (is_base_input(outerrel) && is_join_input(innerrel));
	/* Raw nested joins retain the established parameterized BioseqScan owner.
	 * Core also offers join paths that leave the same rendezvous RestrictInfo as
	 * an executable Join Filter; costs cannot choose between semantic ownership
	 * and the forbidden SQL stub, so discard those paths structurally. */
	if (one_join_one_base && !transformed_operands) {
		ExactParameterizedBmoRetainerAudit owner_audit{};
		if (retain_join_paths_with_custom_restriction_owner(
				root, joinrel, outerrel, innerrel, extra,
				restriction, mmsearch, &owner_audit)) return;
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("mmsearch join qualifier is not owned by a parameterized BioseqScan"),
			 errdetail("The raw nested join cannot retain exactly one inner BMO owner: candidates=%zu nest=%zu inner_nest=%zu root_owned_clause=%zu root_foreign_mmsearch=%zu outer_matches=%zu inner_matches=%zu available_bmo=%zu compatible_bmo=%zu available_outer=%zu constructed=%zu reconstruct_attempts=%zu reconstructed_bmo=%zu reconstruct_reject_mask=0x%x reconstruct_abi_mask=0x%x reconstruct_expected=%zu reconstruct_tags=%zu reconstruct_exprs=%zu outer_reject_mask=0x%x inner_reject_mask=0x%x target_var=%zu query_var=%zu target_relid_sides=0x%x target_base_side=0x%x query_relid_sides=0x%x provider_has_query=%zu target_paths=%zu target_custom=%zu target_bioseq=%zu target_bmo_tags=%zu custom_restrictions=%zu custom_pointer=%zu custom_serial=%zu custom_clause=%zu custom_exact=%zu ppi_paths=%zu ppi_clauses=%zu ppi_serial=%zu ppi_clause=%zu ppi_exact=%zu target_owner_reject_mask=0x%x target_abi_mismatch_mask=0x%x target_ppi_mismatch_mask=0x%x target_compat_mismatch_mask=0x%x join_relids=0x%llx left_relids=0x%llx/%zu right_relids=0x%llx/%zu wrapper_side=0x%x wrapper_method=0x%x wrapper_version=%zu wrapper_owns=%zu wrapper_restrictions=%zu wrapper_children=%zu wrapper_pointer=%zu wrapper_serial=%zu wrapper_clause=%zu current_serial=%zu owned_serial=%zu current_vars=%zu/%zu private_vars=%zu/%zu private_equal=%zu/%zu owner0_vars=%zu/%zu owner1_vars=%zu/%zu wrapper_parent=0x%llx wrapper_child0=0x%llx wrapper_child1=0x%llx current_pair=%zu foreign=%zu safe_foreign=%zu foreign_matches=%zu foreign_reject=0x%x foreign_owner_reject=0x%x.",
				owner_audit.candidates, owner_audit.nest_paths,
				owner_audit.inner_nest_paths,
				owner_audit.root_owned_clause_paths,
				owner_audit.root_foreign_mmsearch_paths,
				owner_audit.outer_matches, owner_audit.inner_matches,
				owner_audit.available_bmo_paths,
				owner_audit.compatible_bmo_paths,
				owner_audit.available_outer_paths,
				owner_audit.constructed_paths,
				owner_audit.reconstructed_bmo_attempts,
				owner_audit.reconstructed_bmo_paths,
				owner_audit.reconstructed_bmo_rejection_mask,
				owner_audit.reconstructed_owner_abi_mismatch_mask,
				owner_audit.reconstructed_expected_owner_count,
				owner_audit.reconstructed_owner_tag_count,
				owner_audit.reconstructed_owner_expression_count,
				owner_audit.outer_rejection_mask,
				owner_audit.inner_rejection_mask,
				owner_audit.target_var_resolved,
				owner_audit.query_var_resolved,
				owner_audit.target_relid_side_mask,
				owner_audit.target_base_side_mask,
				owner_audit.query_relid_side_mask,
				owner_audit.provider_has_query,
				owner_audit.target_paths,
				owner_audit.target_custom_paths,
				owner_audit.target_bioseq_paths,
				owner_audit.target_bmo_tags,
				owner_audit.target_custom_restrictions,
				owner_audit.target_custom_pointer_matches,
				owner_audit.target_custom_serial_matches,
				owner_audit.target_custom_clause_matches,
				owner_audit.target_custom_exact_matches,
				owner_audit.target_ppi_paths,
				owner_audit.target_ppi_clauses,
				owner_audit.target_ppi_serial_matches,
				owner_audit.target_ppi_clause_matches,
				owner_audit.target_ppi_exact_matches,
				owner_audit.target_owner_rejection_mask,
				owner_audit.target_abi_mismatch_mask,
				owner_audit.target_ppi_mismatch_mask,
				owner_audit.target_compatibility_mismatch_mask,
				static_cast<unsigned long long>(
					owner_audit.joinrel_relids_low),
				static_cast<unsigned long long>(
					owner_audit.left_relids_low),
				owner_audit.left_relid_count,
				static_cast<unsigned long long>(
					owner_audit.right_relids_low),
				owner_audit.right_relid_count,
				owner_audit.wrapper_side_mask,
				owner_audit.wrapper_method_mask,
				owner_audit.wrapper_version,
				owner_audit.wrapper_owns_expected,
				owner_audit.wrapper_restriction_count,
				owner_audit.wrapper_child_count,
				owner_audit.wrapper_pointer_matches,
				owner_audit.wrapper_serial_matches,
				owner_audit.wrapper_clause_matches,
				owner_audit.wrapper_expected_serial,
				owner_audit.wrapper_owned_serial,
				owner_audit.wrapper_expected_target_varno,
				owner_audit.wrapper_expected_query_varno,
				owner_audit.wrapper_private_target_varno,
				owner_audit.wrapper_private_query_varno,
				owner_audit.wrapper_private_target_equal,
				owner_audit.wrapper_private_query_equal,
				owner_audit.wrapper_owner0_target_varno,
				owner_audit.wrapper_owner0_query_varno,
				owner_audit.wrapper_owner1_target_varno,
				owner_audit.wrapper_owner1_query_varno,
				static_cast<unsigned long long>(
					owner_audit.wrapper_parent_relids_low),
				static_cast<unsigned long long>(
					owner_audit.wrapper_child0_relids_low),
				static_cast<unsigned long long>(
					owner_audit.wrapper_child1_relids_low),
				owner_audit.current_pair_paths,
				owner_audit.foreign_decomposition_paths,
				owner_audit.safe_foreign_paths,
				owner_audit.foreign_owner_matches,
				owner_audit.foreign_rejection_mask,
				owner_audit.foreign_owner_rejection_mask)));
	}
	if (transformed_operands) {
		/* A transformed owner may sit above one already-owned join frontier.
		 * This is the bounded same-PlannerInfo form used when two matches share
		 * one SQL-visible base.  Raw BatchJoin remains strictly two-baserel
		 * below.  Reject wider/partition-derived join kinds and prove that this
		 * hook invocation describes exactly the output relids before reconstructing
		 * an incumbent path. */
		if (!two_base_inputs && !one_join_one_base) return;
		Relids input_relids = bms_union(
			outerrel->relids, innerrel->relids);
		const bool exact_frontier =
			bms_equal(input_relids, joinrel->relids);
		bms_free(input_relids);
		if (!exact_frontier) return;
		(void)per_row_add_transformed_mmsearch_paths(
			root, joinrel, extra, restriction, mmsearch,
			batch_mmsearch, planned_requirement, oids);
		return;
	}
	if (!two_base_inputs) return;
	if (target_var == nullptr || query_var == nullptr
		|| !bioseq_is_concrete_rte_varno(target_var->varno)
		|| !bioseq_is_concrete_rte_varno(query_var->varno)
		|| target_var->varattno <= 0 || query_var->varattno <= 0
		|| target_var->varlevelsup != 0 || query_var->varlevelsup != 0
		|| !bms_is_empty(target_var->varnullingrels)
		|| !bms_is_empty(query_var->varnullingrels)
		|| target_var->vartype != oids.bioseq_seq_type_oid
		|| query_var->vartype != oids.bioseq_seq_type_oid
		|| !batch_join_typmod_is_supported(target_var->vartypmod)
		|| !batch_join_typmod_is_supported(query_var->vartypmod)
		|| target_var->varcollid != query_var->varcollid) {
		return;
	}
	const auto target_type_params =
		compact_sequence_stdc_type_params::decode(target_var->vartypmod);
	const auto query_type_params =
		compact_sequence_stdc_type_params::decode(query_var->vartypmod);
	if (target_type_params.alphabet_code != query_type_params.alphabet_code) {
		raise_mmsearch_alphabet_mismatch(
			target_type_params, query_type_params, "join planning");
	}
	RelOptInfo* target_rel = nullptr;
	RelOptInfo* query_rel = nullptr;
	if (target_var->varno == outerrel->relid
		&& query_var->varno == innerrel->relid) {
		target_rel = outerrel;
		query_rel = innerrel;
	} else if (target_var->varno == innerrel->relid
			&& query_var->varno == outerrel->relid) {
		target_rel = innerrel;
		query_rel = outerrel;
	} else {
		return;
	}
	List* target_residual_vars = NIL;
	List* query_residual_vars = NIL;
	bool unsupported_residual_var = false;
	constexpr int residual_pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	for (RestrictInfo* residual : PList<RestrictInfo>(
			residual_join_restrictions)) {
		List* variables = pull_var_clause(
			reinterpret_cast<Node*>(residual->clause), residual_pull_flags);
		for (Node* variable : PList<Node>(variables)) {
			Var* var = pg_node_try_as<Var>(variable);
			if (var == nullptr
				|| !bioseq_is_concrete_rte_varno(var->varno)
				|| var->varlevelsup != 0
				|| var->varattno <= 0 || !bms_is_empty(var->varnullingrels)) {
				unsupported_residual_var = true;
				break;
			}
			List** destination = var->varno == target_rel->relid
				? &target_residual_vars
				: (var->varno == query_rel->relid
					? &query_residual_vars : nullptr);
			if (destination == nullptr) {
				unsupported_residual_var = true;
				break;
			}
			bool seen = false;
			for (Node* existing : PList<Node>(*destination)) {
				if (equal(existing, variable)) {
					seen = true;
					break;
				}
			}
			if (!seen) *destination = lappend(
				*destination, copyObject(variable));
		}
		if (unsupported_residual_var) break;
	}
	if (unsupported_residual_var) return;
	RangeTblEntry* target_rte = rt_fetch(target_var->varno, root->parse->rtable);
	RangeTblEntry* query_rte = rt_fetch(query_var->varno, root->parse->rtable);
	const bool plain_query_relation = query_rte != nullptr
		&& query_rte->rtekind == RTE_RELATION;
	const bool plain_query_subquery = query_rte != nullptr
		&& query_rte->rtekind == RTE_SUBQUERY
		&& query_rte->subquery != nullptr
		&& !query_rte->security_barrier
		&& !query_rte->subquery->hasRowSecurity;
	if (target_rte == nullptr || target_rte->rtekind != RTE_RELATION
		|| query_rte == nullptr
		|| (!plain_query_relation && !plain_query_subquery)
		|| target_rte->securityQuals != NIL || query_rte->securityQuals != NIL
		|| !OidIsValid(target_rte->relid)
		|| !IsBioseqColumnTableAmTable(target_rte->relid)
		|| batch_join_target_expression_is_forbidden(
			reinterpret_cast<Node*>(root->processed_tlist), target_var,
			/*allow_mmsearch_qualifier=*/false)
		|| batch_join_target_restrictions_are_forbidden(
			target_rel->baserestrictinfo, target_var,
			/*allow_mmsearch_qualifier=*/true)) {
		return;
	}
	const auto target_qual_features = detect_restrictinfo_feature_flags(
		target_rel->baserestrictinfo, oids);
	const auto query_qual_features = detect_restrictinfo_feature_flags(
		query_rel->baserestrictinfo, oids);
	/* The BatchJoin locator child deliberately does not execute its target
	 * BioseqScan's alignment runtime.  A target-side base mmsearch therefore
	 * has no safe owner after locator conversion; leave this shape to the
	 * ordinary parameterized scan, which can consume both the join Param and
	 * its base qual.  Query-side base mmsearch remains child-owned. */
	if (!target_qual_features.has_value()
		|| !query_qual_features.has_value()
		|| target_qual_features->any_match_projection
		|| query_qual_features->any_match_projection) {
		return;
	}
	if (target_qual_features->has_mmsearch) {
		/* The locator path is ineligible, but a narrowly admitted ordinary
		 * relation/require-absent fallback has a parameterized BioseqScan that
		 * owns both calls.  Retain only join paths reaching that real owner;
		 * leaving an ordinary Join Filter would execute the SQL rendezvous stub. */
		ExactParameterizedBmoRetainerAudit owner_audit{};
		if (retain_join_paths_with_custom_restriction_owner(
				root, joinrel, outerrel, innerrel, extra,
				restriction, mmsearch, &owner_audit)) return;
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("stacked mmsearch qualifiers are unsupported"),
			 errdetail("No parameterized BioseqScan owns the bounded BatchJoin fallback: candidates=%zu nest=%zu inner_nest=%zu root_owned_clause=%zu root_foreign_mmsearch=%zu outer_matches=%zu inner_matches=%zu available_bmo=%zu compatible_bmo=%zu available_outer=%zu constructed=%zu reconstruct_attempts=%zu reconstructed_bmo=%zu reconstruct_reject_mask=0x%x reconstruct_abi_mask=0x%x reconstruct_expected=%zu reconstruct_tags=%zu reconstruct_exprs=%zu outer_reject_mask=0x%x inner_reject_mask=0x%x target_var=%zu query_var=%zu target_relid_sides=0x%x target_base_side=0x%x query_relid_sides=0x%x provider_has_query=%zu target_paths=%zu target_custom=%zu target_bioseq=%zu target_bmo_tags=%zu custom_restrictions=%zu custom_pointer=%zu custom_serial=%zu custom_clause=%zu custom_exact=%zu ppi_paths=%zu ppi_clauses=%zu ppi_serial=%zu ppi_clause=%zu ppi_exact=%zu target_owner_reject_mask=0x%x target_abi_mismatch_mask=0x%x target_ppi_mismatch_mask=0x%x target_compat_mismatch_mask=0x%x join_relids=0x%llx left_relids=0x%llx/%zu right_relids=0x%llx/%zu wrapper_side=0x%x wrapper_method=0x%x wrapper_version=%zu wrapper_owns=%zu wrapper_restrictions=%zu wrapper_children=%zu wrapper_pointer=%zu wrapper_serial=%zu wrapper_clause=%zu current_serial=%zu owned_serial=%zu current_vars=%zu/%zu private_vars=%zu/%zu private_equal=%zu/%zu owner0_vars=%zu/%zu owner1_vars=%zu/%zu wrapper_parent=0x%llx wrapper_child0=0x%llx wrapper_child1=0x%llx current_pair=%zu foreign=%zu safe_foreign=%zu foreign_matches=%zu foreign_reject=0x%x foreign_owner_reject=0x%x.",
				owner_audit.candidates, owner_audit.nest_paths,
				owner_audit.inner_nest_paths,
				owner_audit.root_owned_clause_paths,
				owner_audit.root_foreign_mmsearch_paths,
				owner_audit.outer_matches, owner_audit.inner_matches,
				owner_audit.available_bmo_paths,
				owner_audit.compatible_bmo_paths,
				owner_audit.available_outer_paths,
				owner_audit.constructed_paths,
				owner_audit.reconstructed_bmo_attempts,
				owner_audit.reconstructed_bmo_paths,
				owner_audit.reconstructed_bmo_rejection_mask,
				owner_audit.reconstructed_owner_abi_mismatch_mask,
				owner_audit.reconstructed_expected_owner_count,
				owner_audit.reconstructed_owner_tag_count,
				owner_audit.reconstructed_owner_expression_count,
				owner_audit.outer_rejection_mask,
				owner_audit.inner_rejection_mask,
				owner_audit.target_var_resolved,
				owner_audit.query_var_resolved,
				owner_audit.target_relid_side_mask,
				owner_audit.target_base_side_mask,
				owner_audit.query_relid_side_mask,
				owner_audit.provider_has_query,
				owner_audit.target_paths,
				owner_audit.target_custom_paths,
				owner_audit.target_bioseq_paths,
				owner_audit.target_bmo_tags,
				owner_audit.target_custom_restrictions,
				owner_audit.target_custom_pointer_matches,
				owner_audit.target_custom_serial_matches,
				owner_audit.target_custom_clause_matches,
				owner_audit.target_custom_exact_matches,
				owner_audit.target_ppi_paths,
				owner_audit.target_ppi_clauses,
				owner_audit.target_ppi_serial_matches,
				owner_audit.target_ppi_clause_matches,
				owner_audit.target_ppi_exact_matches,
				owner_audit.target_owner_rejection_mask,
				owner_audit.target_abi_mismatch_mask,
				owner_audit.target_ppi_mismatch_mask,
				owner_audit.target_compatibility_mismatch_mask,
				static_cast<unsigned long long>(
					owner_audit.joinrel_relids_low),
				static_cast<unsigned long long>(
					owner_audit.left_relids_low),
				owner_audit.left_relid_count,
				static_cast<unsigned long long>(
					owner_audit.right_relids_low),
				owner_audit.right_relid_count,
				owner_audit.wrapper_side_mask,
				owner_audit.wrapper_method_mask,
				owner_audit.wrapper_version,
				owner_audit.wrapper_owns_expected,
				owner_audit.wrapper_restriction_count,
				owner_audit.wrapper_child_count,
				owner_audit.wrapper_pointer_matches,
				owner_audit.wrapper_serial_matches,
				owner_audit.wrapper_clause_matches,
				owner_audit.wrapper_expected_serial,
				owner_audit.wrapper_owned_serial,
				owner_audit.wrapper_expected_target_varno,
				owner_audit.wrapper_expected_query_varno,
				owner_audit.wrapper_private_target_varno,
				owner_audit.wrapper_private_query_varno,
				owner_audit.wrapper_private_target_equal,
				owner_audit.wrapper_private_query_equal,
				owner_audit.wrapper_owner0_target_varno,
				owner_audit.wrapper_owner0_query_varno,
				owner_audit.wrapper_owner1_target_varno,
				owner_audit.wrapper_owner1_query_varno,
				static_cast<unsigned long long>(
					owner_audit.wrapper_parent_relids_low),
				static_cast<unsigned long long>(
					owner_audit.wrapper_child0_relids_low),
				static_cast<unsigned long long>(
					owner_audit.wrapper_child1_relids_low),
				owner_audit.current_pair_paths,
				owner_audit.foreign_decomposition_paths,
				owner_audit.safe_foreign_paths,
				owner_audit.foreign_owner_matches,
				owner_audit.foreign_rejection_mask,
				owner_audit.foreign_owner_rejection_mask)));
	}
	const BatchJoinBioseqPathCandidate target_candidate =
		find_unparameterized_bioseq_custom_path(
			target_rel, target_var->varattno);
	CustomPath* target_path = target_candidate.scan;
	Path* query_path = query_rel->cheapest_total_path;
	if (target_path == nullptr || target_candidate.locator_target == nullptr
		|| query_path == nullptr
		|| query_path->param_info != nullptr
		|| batch_join_path_contains_parallel_execution(query_path)) {
		return;
	}
	if (query_residual_vars != NIL) {
		PathTarget* query_target = copy_pathtarget(query_path->pathtarget);
		add_new_columns_to_pathtarget(query_target, query_residual_vars);
		set_pathtarget_cost_width(root, query_target);
		query_path = reinterpret_cast<Path*>(create_projection_path(
			root, query_path->parent, query_path, query_target));
	}

	auto* locator_path = makeNode(CustomPath);
	*locator_path = *target_path;
	/* Preserve the wrapper's conservative projection cost when a helper-only
	 * ProjectionPath was unwrapped. The locator child does not execute those
	 * helpers, but underpricing the custom join is worse than retaining their
	 * planner estimate. */
	locator_path->path.startup_cost = target_candidate.cost_owner->startup_cost;
	locator_path->path.total_cost = target_candidate.cost_owner->total_cost;
	locator_path->path.rows = target_candidate.cost_owner->rows;
	locator_path->path.pathtarget = create_empty_pathtarget();
	auto append_locator_target = [locator_path](const PathTarget* source) {
		if (source == nullptr) return;
		for (Node* expression : PList<Node>(source->exprs)) {
			if (bioseq_expr_uses_bioseq_projection(expression)
				|| path_target_contains_expression(
					locator_path->path.pathtarget,
					reinterpret_cast<Expr*>(expression))) {
				continue;
			}
			add_column_to_pathtarget(
				locator_path->path.pathtarget,
				reinterpret_cast<Expr*>(copyObject(expression)), 0);
		}
	};
	/* Preserve the scan's ordinary expressions and safe plain expressions
	 * introduced by the wrapper projection. Helper-bearing expressions are
	 * parent-owned and handled by the recursive Var pass below. */
	append_locator_target(target_path->path.pathtarget);
	append_locator_target(target_candidate.locator_target);
	add_new_columns_to_pathtarget(
		locator_path->path.pathtarget, target_residual_vars);
	/* A helper-bearing expression is intentionally not evaluated by the
	 * locator child, but PostgreSQL setrefs still requires its underlying base
	 * Vars to exist in the child/combined tlist.  The wrapper PathTarget is the
	 * usual owner; joinrel->reltarget is the authoritative fallback for an
	 * upper compound projection. */
	if (!batch_join_append_underlying_target_vars(
			locator_path->path.pathtarget,
			target_candidate.locator_target,
			target_rel->relid,
			target_var->varattno)
		|| !batch_join_append_underlying_target_vars(
			locator_path->path.pathtarget,
			joinrel->reltarget,
			target_rel->relid,
			target_var->varattno)) {
		return;
	}
	locator_path->custom_private = static_cast<List*>(
		copyObject(target_path->custom_private));
	locator_path->custom_paths = slice_project_clone_path_list(
		target_path->custom_paths);
	locator_path->custom_restrictinfo = NIL;
	if (!path_target_contains_expression(
			locator_path->path.pathtarget,
			reinterpret_cast<Expr*>(target_var))) {
		add_column_to_pathtarget(
			locator_path->path.pathtarget,
			reinterpret_cast<Expr*>(copyObject(target_var)), 0);
	}
	Const* hidden_rowno = makeConst(
		INT8OID, -1, InvalidOid, 8, Int64GetDatum(0), false, true);
	add_column_to_pathtarget(
		locator_path->path.pathtarget,
		reinterpret_cast<Expr*>(hidden_rowno), 0);
	set_pathtarget_cost_width(root, locator_path->path.pathtarget);
	/* A lower BatchJoin may publish an otherwise-unused target sequence as the
	 * PARAM_EXEC query of an upper BatchJoin.  The locator child must therefore
	 * carry BSS3's exact projected-resno -> physical-varattno route for every
	 * sequence it can publish.  Do not infer a physical column for an expression
	 * recipe (or silently keep an older, differently-shaped source tag). */
	for (Node* private_node : PList<Node>(locator_path->custom_private)) {
		if (private_node == nullptr || !IsA(private_node, List)) continue;
		List* tag = reinterpret_cast<List*>(private_node);
		if (tag != NIL
			&& IsA(reinterpret_cast<Node*>(linitial(tag)), Integer)
			&& intVal(linitial(tag)) == kBioseqSliceSourceMagic) {
			return;
		}
	}
	List* locator_source_bindings = NIL;
	Bitmapset* locator_source_attnos = nullptr;
	bool locator_target_source_bound = false;
	bool locator_source_bindings_valid = true;
	int locator_resno = 1;
	for (Node* expression : PList<Node>(
			locator_path->path.pathtarget->exprs)) {
		if (exprType(expression) == oids.bioseq_seq_type_oid) {
			Var* source = pg_node_try_as<Var>(expression);
			if (source == nullptr || source->varno != target_var->varno
				|| source->varattno <= 0 || source->varlevelsup != 0
				|| !bms_is_empty(source->varnullingrels)
				|| bms_is_member(
					static_cast<int>(source->varattno),
					locator_source_attnos)) {
				locator_source_bindings_valid = false;
				break;
			}
			locator_source_bindings = lappend(
				locator_source_bindings,
				list_make3(
					makeInteger(locator_resno),
					makeInteger(0),
					makeInteger(static_cast<int>(source->varattno))));
			locator_source_attnos = bms_add_member(
				locator_source_attnos,
				static_cast<int>(source->varattno));
			locator_target_source_bound =
				locator_target_source_bound || equal(source, target_var);
		}
		++locator_resno;
	}
	if (locator_source_attnos != nullptr) bms_free(locator_source_attnos);
	if (!locator_source_bindings_valid || !locator_target_source_bound) return;
	locator_path->custom_private = lappend(
		locator_path->custom_private,
		list_make3(
			makeInteger(kBioseqSliceSourceMagic),
			makeInteger(kBioseqSliceSourceVersion),
			locator_source_bindings));
	if (next_batch_join_plan_token <= 0
		|| next_batch_join_plan_token == (std::numeric_limits<int>::max)()) {
		next_batch_join_plan_token = 1;
	}
	const int token = next_batch_join_plan_token++;
	List* locator_tag = list_make4(
		makeInteger(kBioseqLocatorPassthroughMagic),
		makeInteger(kBioseqBatchJoinPlanVersion),
		makeInteger(token),
		makeInteger(0));
	locator_path->custom_private = lappend(
		locator_path->custom_private, locator_tag);
	locator_path->path.parallel_safe = false;
	locator_path->path.parallel_aware = false;
	locator_path->path.parallel_workers = 0;

	const auto typmod = compact_sequence_stdc_type_params::decode(
		target_var->vartypmod);
	auto* join_path = makeNode(CustomPath);
	join_path->path.pathtype = T_CustomScan;
	join_path->path.parent = joinrel;
	join_path->path.pathtarget = copy_pathtarget(joinrel->reltarget);
	join_path->path.param_info = nullptr;
	join_path->path.parallel_aware = false;
	join_path->path.parallel_safe = false;
	join_path->path.parallel_workers = 0;
	join_path->path.pathkeys = NIL;
	join_path->path.rows = std::max(1.0, joinrel->rows);
	/* The query child is fully materialized before the first output, so its
	 * complete cost is startup.  The target child is read exactly once; never
	 * underprice this as startup-only and force an unadmittable custom join. */
	const double planned_query_rows = std::max(1.0, query_path->rows);
	const double planned_query_width = std::max(
		1, query_path->pathtarget == nullptr
			? 1 : query_path->pathtarget->width);
	const Cost query_materialization_cost = planned_query_rows
		* (cpu_tuple_cost
			+ cpu_operator_cost * (1.0 + planned_query_width / 64.0));
	const Cost output_cost = join_path->path.rows * cpu_tuple_cost;
	QualCost residual_join_cost{};
	if (residual_join_restrictions != NIL) {
		List* residual_expressions = NIL;
		for (RestrictInfo* residual : PList<RestrictInfo>(
				residual_join_restrictions)) {
			residual_expressions = lappend(
				residual_expressions, residual->clause);
		}
		cost_qual_eval(&residual_join_cost, residual_expressions, root);
	}
	QualCost operand_cost{};
	cost_qual_eval(&operand_cost,
		mmsearch_operand_cost_exprs(batch_mmsearch, oids), root);
	PList<Node> owned_operands(batch_mmsearch->args);
	const std::uint64_t target_symbols = estimate_mmsearch_operand_symbols(
		owned_operands.first(), oids);
	const std::uint64_t query_symbols = estimate_mmsearch_operand_symbols(
		owned_operands.second(), oids);
	const std::uint64_t admitted_bytes =
		bioseq::parallelism::saturating_add(target_symbols, query_symbols);
	const owned_mmsearch_cost alignment_cost = estimate_owned_mmsearch_cost(
		target_symbols, query_symbols, locator_path->path.rows,
		planned_requirement
			!= bioseq::indexing::IndexReadRequirement::require_absent,
		static_cast<std::uint32_t>(std::min<std::size_t>(
			kBioseqRuntimeBufferReserve,
			(std::numeric_limits<std::uint32_t>::max)())),
		admitted_bytes);
	const Cost honest_startup_cost = std::max<Cost>(0,
		query_path->total_cost
			+ locator_path->path.startup_cost
			+ query_materialization_cost + operand_cost.startup
			+ alignment_cost.startup + residual_join_cost.startup);
	const Cost honest_total_cost = std::max(
		honest_startup_cost,
		std::max<Cost>(0, query_path->total_cost
			+ locator_path->path.total_cost
			+ query_materialization_cost
			+ operand_cost.startup + alignment_cost.startup
			+ residual_join_cost.startup
			+ output_cost + std::max(0.0, locator_path->path.rows)
				* (operand_cost.per_tuple
					+ alignment_cost.per_input_tuple)
			+ std::max(0.0, join_path->path.rows)
				* residual_join_cost.per_tuple));
	if (!std::isfinite(honest_startup_cost)
		|| !std::isfinite(honest_total_cost)) {
		return;
	}

	/* Retain the best incumbent as EXPLAIN evidence only.  Path selection is
	 * structural once ownership is established, never a negative sentinel. */
	Cost incumbent_cost_floor = honest_total_cost;
	for (Path* incumbent : PList<Path>(joinrel->pathlist)) {
		if (incumbent == nullptr) continue;
		if (std::isfinite(incumbent->total_cost)
			&& incumbent->total_cost >= 0) {
			incumbent_cost_floor = std::min(
				incumbent_cost_floor, incumbent->total_cost);
		}
	}
	join_path->path.startup_cost = std::max<Cost>(0, honest_startup_cost);
	join_path->path.total_cost = std::max(
		join_path->path.startup_cost, std::max<Cost>(0, honest_total_cost));
	join_path->flags = 0;
	join_path->custom_restrictinfo = list_copy(extra->restrictlist);
	join_path->custom_paths = list_make2(locator_path, query_path);
	join_path->custom_private = list_make5(
		makeInteger(kBioseqBatchJoinPlanVersion),
		makeInteger(token),
		makeInteger(static_cast<int>(target_rte->relid)),
		makeInteger(target_var->varattno),
		copyObject(target_var));
	join_path->custom_private = lappend(
		join_path->custom_private, copyObject(query_var));
	join_path->custom_private = lappend(
		join_path->custom_private, makeInteger(typmod.alphabet_code));
	join_path->custom_private = lappend(
		join_path->custom_private,
		makeInteger(typmod.storage_unit_byte_width));
	join_path->custom_private = lappend(
		join_path->custom_private, batch_mmsearch);
	join_path->custom_private = lappend(
		join_path->custom_private,
		makeInteger(static_cast<int>(planned_requirement)));
	join_path->custom_private = lappend(
		join_path->custom_private,
		make_batch_join_cost_const(honest_startup_cost));
	join_path->custom_private = lappend(
		join_path->custom_private,
		make_batch_join_cost_const(honest_total_cost));
	join_path->custom_private = lappend(
		join_path->custom_private,
		make_batch_join_cost_const(incumbent_cost_floor));
	Assert(list_length(join_path->custom_private)
		== kBioseqBatchJoinPathPrivateFields);
	join_path->methods = &BioseqBatchJoinPathMethods;
	auto retain_existing_owner = [restriction](List* paths) {
		PList<Path> survivors;
		for (Path* incumbent : PList<Path>(paths)) {
			if (incumbent != nullptr && IsA(incumbent, CustomPath)
				&& list_member_ptr(
					reinterpret_cast<CustomPath*>(incumbent)->custom_restrictinfo,
					restriction)) {
				survivors.append(incumbent);
			}
		}
		return survivors.release();
	};
	joinrel->pathlist = retain_existing_owner(joinrel->pathlist);
	joinrel->partial_pathlist = retain_existing_owner(joinrel->partial_pathlist);
	add_path(joinrel, &join_path->path);
}


/*
 * RemovePathsByPredicate removes the paths that removePathPredicate
 * evaluates to true from pathlist of given rel.
 */
static void
RemovePathsByPredicate(RelOptInfo *rel, PathPredicate removePathPredicate)
{
	bioseq_log<DBG>("[bioseq] pg: RemovePathsByPredicate() entered");
	PList<Path> filteredPathList;
	PList<Path> filteredPartialPathList;

	for(auto path : PList<Path>(rel->pathlist))
	{
		if (!removePathPredicate(path))
		{
			filteredPathList.append(path);
		}
	}

	rel->pathlist = filteredPathList.release();

	for(auto path : PList<Path>(rel->partial_pathlist))
	{
		if (!removePathPredicate(path))
		{
			filteredPartialPathList.append(path);
		}
	}

	rel->partial_pathlist = filteredPartialPathList.release();
}


/*
 * IsNotIndexPath returns true if given path is not an IndexPath.
 */
static bool
IsNotIndexPath(Path *path)
{
	return !pg_node_view{pg_as_node(path)}.is<IndexPath>();
}


/*
 * CreateBioseqColumnSeqScanPath returns Path for sequential scan on columnar
 * table with relationId.
 */
static Path *
CreateBioseqColumnSeqScanPath(PlannerInfo *root, RelOptInfo *rel, Oid relationId)
{
	bioseq_log<DBG>("[bioseq] pg: CreateBioseqColumnSeqScanPath() entered");
	/* columnar doesn't support parallel scan */
	int parallelWorkers = 0;

	Relids requiredOuter = rel->lateral_relids;
	Path *path = create_seqscan_path(root, rel, requiredOuter, parallelWorkers);
	CostBioseqColumnSeqPath(rel, relationId, path);
	return path;
}


/*
 * CostBioseqColumnPaths re-costs paths of given RelOptInfo for
 * columnar table with relationId.
 */
static void
CostBioseqColumnPaths(PlannerInfo *root, RelOptInfo *rel, Oid relationId)
{
	bioseq_log<DBG>("[bioseq] pg: CostBioseqColumnPaths() entered");
	for(auto path : PList<Path>(rel->pathlist))
	{
		if (pg_node_view{pg_as_node(path)}.is<IndexPath>())
		{
			/*
			 * Since we don't provide implementations for scan_bitmap_next_block
			 * & scan_bitmap_next_tuple, postgres doesn't generate bitmap index
			 * scan paths for columnar tables already (see related comments in
			 * TableAmRoutine). For this reason, we only consider IndexPath's
			 * here.
			 */
			CostBioseqColumnIndexPath(root, rel, relationId, reinterpret_cast<IndexPath *>(path));
		}
		else if (path->pathtype == T_SeqScan)
		{
			CostBioseqColumnSeqPath(rel, relationId, path);
		}
	}
}


/*
 * CostBioseqColumnIndexPath re-costs given index path for columnar table with
 * relationId.
 */
static void
CostBioseqColumnIndexPath(PlannerInfo *root, RelOptInfo *rel, Oid relationId,
					  IndexPath *indexPath)
{
	if (!enable_indexscan)
	{
		bioseq_log<DBG>("[bioseq] pg: CostBioseqColumnIndexPath() skipped (enable_indexscan=false)");
		/* costs are already set to disable_cost, don't adjust them */
		return;
	}

	bioseq_log_pg(DEBUG4, "columnar table index scan costs estimated by "
				   "indexAM: startup cost = {:.10f}, total cost = "
				   "{:.10f}", indexPath->path.startup_cost,
				   indexPath->path.total_cost);

	/*
	 * We estimate the cost for columnar table read during index scan. Also,
	 * instead of overwriting total cost, we "add" ours to the cost estimated
	 * by indexAM since we should consider index traversal related costs too.
	 */

	if (!bioseq::settings::enable_bioseq_index_scan)
	{
		bioseq_log<DBG>("[bioseq] pg: CostBioseqColumnIndexPath() bioseq::settings::enable_bioseq_index_scan disabled, adding columnar cost");
		Cost bioseqColumnIndexScanCost = BioseqColumnIndexScanAdditionalCost(root, rel, relationId,
																	indexPath);
		indexPath->path.total_cost += bioseqColumnIndexScanCost;
	}

	bioseq_log<DBG>("[bioseq] pg: CostBioseqColumnIndexPath() cost computation complete");

	bioseq_log_pg(DEBUG4, "columnar table index scan costs re-estimated "
				   "by columnarAM (including indexAM costs): "
				   "startup cost = {:.10f}, total cost = {:.10f}",
				   indexPath->path.startup_cost,
				   indexPath->path.total_cost);
}


/*
 * BioseqColumnIndexScanAdditionalCost returns additional cost estimated for
 * index scan described by IndexPath for columnar table with relationId.
 */
static Cost
BioseqColumnIndexScanAdditionalCost(PlannerInfo *root, RelOptInfo *rel,
								Oid relationId, IndexPath *indexPath)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnIndexScanAdditionalCost() entered");
	int numberOfColumnsRead = RelationIdGetNumberOfAttributes(relationId);
	Cost perStripeCost = BioseqColumnPerStripeScanCost(rel, relationId, numberOfColumnsRead);

	/*
	 * We don't need to pass correct loop count to amcostestimate since we
	 * will only use index correlation & index selectivity, and loop count
	 * doesn't have any effect on those two.
	 */
	double fakeLoopCount = 1;
	Cost fakeIndexStartupCost;
	Cost fakeIndexTotalCost;
	double fakeIndexPages;
	Selectivity indexSelectivity;
	double indexCorrelation;
	amcostestimate_function amcostestimate = indexPath->indexinfo->amcostestimate;
	amcostestimate(root, indexPath, fakeLoopCount, &fakeIndexStartupCost,
				   &fakeIndexTotalCost, &indexSelectivity,
				   &indexCorrelation, &fakeIndexPages);

	Relation relation = RelationIdGetRelation(relationId);
	uint64_t rowCount = BioseqColumnTableRowCount(relation);
	RelationClose(relation);
	double estimatedRows = rowCount * indexSelectivity;

	/*
	 * In the worst case (i.e no correlation between the column & the index),
	 * we need to read a different stripe for each row.
	 */
	double maxStripeReadCount = estimatedRows;

	/*
	 * In the best case (i.e the column is fully correlated with the index),
	 * we wouldn't read the same stripe again and again thanks
	 * to locality.
	 */
	double avgStripeRowCount =
		rowCount / static_cast<double>(BioseqColumnTableStripeCount(relationId));
	double minStripeReadCount = estimatedRows / avgStripeRowCount;

	/*
	 * While being close to 0 means low correlation, being close to -1 or +1
	 * means high correlation. For index scans on columnar tables, it doesn't
	 * matter if the column and the index are "correlated" (+1) or
	 * "anti-correlated" (-1) since both help us avoiding from reading the
	 * same stripe again and again.
	 */
	double absIndexCorrelation = std::abs(indexCorrelation);

	/*
	 * To estimate the number of stripes that we need to read, we do linear
	 * interpolation between minStripeReadCount & maxStripeReadCount. To do
	 * that, we use complement to 1 of absolute correlation, where being
	 * close to 0 means high correlation and being close to 1 means low
	 * correlation.
	 * In practice, we only want to do an index scan when absIndexCorrelation
	 * is 1 (or extremely close to it), or when the absolute number of tuples
	 * returned is very small. Other cases will have a prohibitive cost.
	 */
	double complementIndexCorrelation = 1 - absIndexCorrelation;
	double estimatedStripeReadCount =
		minStripeReadCount + complementIndexCorrelation * (maxStripeReadCount -
														   minStripeReadCount);

	/* even in the best case, we will read a single stripe */
	estimatedStripeReadCount = std::max(estimatedStripeReadCount, 1.0);

	Cost scanCost = perStripeCost * estimatedStripeReadCount;

	bioseq_log_pg(DEBUG4, "re-costing index scan for columnar table: "
				   "selectivity = {:.10f}, complement abs "
				   "correlation = {:.10f}, per stripe cost = {:.10f}, "
				   "estimated stripe read count = {:.10f}, "
				   "total additional cost = {:.10f}",
				   indexSelectivity, complementIndexCorrelation,
				   perStripeCost, estimatedStripeReadCount,
				   scanCost);

	return scanCost;
}


/*
 * CostBioseqColumnSeqPath sets costs given seq path for columnar table with
 * relationId.
 */
static void
CostBioseqColumnSeqPath(RelOptInfo *rel, Oid relationId, Path *path)
{
	if (!enable_seqscan)
	{
		/* costs are already set to disable_cost, don't adjust them */
		return;
	}

	/*
	 * Seq scan doesn't support projection or qual pushdown, so we will read
	 * all the stripes and all the columns.
	 */
	double stripesToRead = BioseqColumnTableStripeCount(relationId);
	int numberOfColumnsRead = RelationIdGetNumberOfAttributes(relationId);

	path->rows = rel->tuples;
	path->startup_cost = 0;
	path->total_cost = stripesToRead *
					   BioseqColumnPerStripeScanCost(rel, relationId, numberOfColumnsRead);
}


/*
 * RelationIdGetNumberOfAttributes returns number of attributes that relation
 * with relationId has.
 */
static int
RelationIdGetNumberOfAttributes(Oid relationId)
{
	Relation relation = RelationIdGetRelation(relationId);
	int nattrs = relation->rd_att->natts;
	RelationClose(relation);
	return nattrs;
}


/*
 * CheckVarStats() checks whether a qual involving this Var is likely to be
 * useful based on the correlation stats. If so, or if stats are unavailable,
 * return true; otherwise return false and sets absVarCorrelation in case
 * caller wants to use for logging purposes.
 */
static bool
CheckVarStats(PlannerInfo *root, Var *var, Oid sortop, float *absVarCorrelation)
{
	bioseq_log<DBG>("[bioseq] pg: CheckVarStats() entered");
	/*
	 * Collect isunique, ndistinct, and varCorrelation.
	 */
	VariableStatData varStatData;
	examine_variable(root, reinterpret_cast<Node *>(var), var->varno, &varStatData);
	if (varStatData.rel == NULL ||
		!HeapTupleIsValid(varStatData.statsTuple))
	{
		return true;
	}

	AttStatsSlot sslot;
	if (!get_attstatsslot(&sslot, varStatData.statsTuple,
						  STATISTIC_KIND_CORRELATION, sortop,
						  ATTSTATSSLOT_NUMBERS))
	{
		ReleaseVariableStats(varStatData);
		return true;
	}

	Assert(sslot.nnumbers == 1);

	float varCorrelation = sslot.numbers[0];

	ReleaseVariableStats(varStatData);

	/*
	 * If the Var is not highly correlated, then the chunk's min/max bounds
	 * will be nearly useless.
	 */
	if (std::abs(varCorrelation)
		< bioseq::settings::qual_pushdown_correlation_threshold)
	{
		if (absVarCorrelation)
		{
			/*
			 * Report absVarCorrelation if caller wants to know why given
			 * var is rejected.
			 */
			*absVarCorrelation = std::abs(varCorrelation);
		}
		return false;
	}

	return true;
}


/*
 * ExprReferencesRelid returns true if any of the Expr's Vars refer to the
 * given relid; false otherwise.
 */
static bool
ExprReferencesRelid(Expr *expr, Index relid)
{
	List *exprVars = pull_var_clause(
		reinterpret_cast<Node *>(expr), PVC_RECURSE_AGGREGATES |
		PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS);
	for (auto var : PList<Var>(exprVars))
	{
		if (var->varno == relid)
		{
			return true;
		}
	}
	return false;
}

/*
 * DOC0322 §7.4 — BioseqColumnTableRowCount moved to storage_metadata:core (reached
 * here via `import storage_metadata;`, already imported).
 */


/*
 * ExtractPushdownClause extracts an Expr node from given clause for pushing down
 * into the given rel (including join clauses). This test may not be exact in
 * all cases; it's used to reduce the search space for parameterization.
 *
 * Note that we don't try to handle cases like "Var + ExtParam = 3". That
 * would require going through eval_const_expression after parameter binding,
 * and that doesn't seem worth the effort. Here we just look for "Var op Expr"
 * or "Expr op Var", where Var references rel and Expr references other rels
 * (or no rels at all).
 *
 * Moreover, this function also looks into BoolExpr's to recursively extract
 * pushdownable OpExpr's of them:
 * i)   AND_EXPR:
 *      Take pushdownable args of AND expressions by ignoring the other args.
 * ii)  OR_EXPR:
 *      Ignore the whole OR expression if we cannot extract a pushdownable Expr
 *      from one of its args.
 * iii) NOT_EXPR:
 *      Simply ignore NOT expressions since we don't expect to see them before
 *      an expression that we can pushdown, see the comment in function.
 *
 * The reasoning for those three rules could also be summarized as such;
 * for any expression that we cannot push-down, we must assume that it
 * evaluates to true.
 *
 * For example, given following WHERE clause:
 * (
 *     (a > random() OR a < 30)
 *     AND
 *     a < 200
 * ) OR
 * (
 *     a = 300
 *     OR
 *     a > 400
 * );
 * Even if we can pushdown (a < 30), we cannot pushdown (a > random() OR a < 30)
 * due to (a > random()). However, we can pushdown (a < 200), so we extract
 * (a < 200) from the lhs of the top level OR expression.
 *
 * For the rhs of the top level OR expression, since we can pushdown both (a = 300)
 * and (a > 400), we take this part as is.
 *
 * Finally, since both sides of the top level OR expression yielded pushdownable
 * expressions, we will pushdown the following:
 *  (a < 200) OR ((a = 300) OR (a > 400))
 */
/*
 * mmsearch() FuncExprs are recognised here as pushdownable scan
 * quals even though they have no btree opclass and no scan-key
 * shape: the actual filtering happens at execution time inside
 * BatchProcessor::process_sequences. The reason we still register
 * them as "pushdownable" is to make the planner consider
 * parameterised paths for cross-table mmsearches like
 *   WHERE mmsearch(t1.seq, t2.seq2)
 * Without this recognition `FilterPushdownClauses` drops the
 * FuncExpr from `joinClauses`, `FindCandidateRelids` returns no
 * outer rels for it, and `AddBioseqColumnScanPathsRec` never asks
 * `get_baserel_parampathinfo` to bring the qual into the inner
 * scan's `ppi_clauses`. The result: mmsearch ends up as a Nested
 * Loop join filter (the C stub), which always returns TRUE, and
 * the inner scan never runs the aligner — every cross-product row
 * comes back with NULL bioseq.* projections.
 *
 * Returning the unchanged FuncExpr from this helper tells
 * FilterPushdownClauses "this clause references this rel and is
 * safe to attach to its quals." Postgres (via
 * `replace_nestloop_params`) will rewrite the cross-rel Var (e.g.
 * t2.seq2) into a PARAM_EXEC Param at plan-finalization time, and
 * BeginCustomScan / ReScanCustomScan already handle Params for the
 * mmsearch second argument.
 */
[[nodiscard]] static bool
IsMmsearchPushdownable(RelOptInfo* rel, FuncExpr* fe,
					   const BioseqStubOids& stub_oids)
{
	if (!is_mmsearch_funcid(fe->funcid, stub_oids)) {
		return false;
	}
	pg_first_two_node_args two_args = pg_first_two_args_if_arity_between(*fe, 2, 3);
	if (!two_args.present()) {
		return false;
	}
	Node* arg1 = two_args.second;
	auto target_proof = prove_base_local_mmsearch_operand(
		two_args.first, rel, stub_oids,
		/*require_sequence_var=*/true);
	if (!target_proof.has_value()
		|| target_proof->primary_sequence_var == nullptr) {
		return false;
	}
	Var* col_var = target_proof->primary_sequence_var;
	/*
	 * The first argument is the column to align — it MUST belong to
	 * `rel`. Cross-table mmsearch with the column on the OTHER side
	 * (e.g. mmsearch(t1.seq, t2.seq) when we are processing t2)
	 * doesn't push to this rel; the mirror call from t1's side
	 * (mmsearch(t1.seq, t2.seq) processing t1) does.
	 */
	if (col_var->varno != rel->relid) {
		return false;
	}
	if (col_var->varattno <= 0) {
		return false;
	}
	/*
	 * Constrain the second argument to shapes BioseqColumnScan_BeginCustomScan
	 * actually handles at execution time (Const literal, Param-driven NL
	 * inner-side rewrite, or another base-relation Var with a varno that
	 * Postgres can later turn into a PARAM_EXEC on the parameterised path).
	 * Without this filter the planner would generate a parameterised path
	 * carrying a complex-expression mmsearch which BeginCustomScan then
	 * silently rejects, leaving the buffer inactive and the bioseq.*
	 * projections back to NULL — the very bug §8 of
	 * REPORT_POSTGRES_QUERY_BUGFIXING_1.md is meant to fix.
	 */
	const bool local_query_recipe = !pg_node_view{arg1}.is<Const>()
		&& !pg_node_view{arg1}.is<Var>() && !pg_node_view{arg1}.is<Param>()
		&& prove_base_local_mmsearch_operand(
			arg1, rel, stub_oids,
			/*require_sequence_var=*/false).has_value();
	if (!pg_node_view{arg1}.is<Const>() && !pg_node_view{arg1}.is<Var>()
		&& !pg_node_view{arg1}.is<Param>() && !local_query_recipe) return false;
	/* A volatile function inside a proven base-local query recipe stays at
	 * this scan frontier and is evaluated by one retained ExprState exactly
	 * once per admitted row.  Only an unproven volatile shape is ineligible. */
	if (contain_volatile_functions(arg1) && !local_query_recipe) {
		return false;
	}
	/*
	 * Typmod compatibility check. We accept a supported bioseq.seq arg1
	 * here and let BeginCustomScan enforce the binding contract:
	 *   - same (alphabet, width)     → direct dispatch
	 *   - same alphabet, diff width → rewidth arg1 to the column width
	 *   - different bound alphabet  → SQLSTATE 42804 before dispatch
	 *
	 * The previous version of this helper rejected any mismatch up
	 * here, which resulted in the parameterised path never being
	 * generated for typmod-divergent queries — and BeginCustomScan
	 * would silently leave bioseq.* projections NULL. Letting the
	 * planner generate the path and handling coalesce in
	 * BeginCustomScan is what gives the user useful results.
	 */
	if (col_var->vartype != stub_oids.bioseq_seq_type_oid
		|| target_proof->typmod < 0) {
		return false;
	}
	int32 arg1_typmod = -1;
	Oid   arg1_typoid = InvalidOid;
	if (Const* c = pg_node_try_as<Const>(arg1)) {
		arg1_typmod = c->consttypmod;
		arg1_typoid = c->consttype;
	} else if (Var* v = pg_node_try_as<Var>(arg1)) {
		arg1_typmod = v->vartypmod;
		arg1_typoid = v->vartype;
	} else if (Param* p = pg_node_try_as<Param>(arg1)) {
		arg1_typmod = p->paramtypmod;
		arg1_typoid = p->paramtype;
	} else if (local_query_recipe) {
		auto query_proof = prove_base_local_mmsearch_operand(
			arg1, rel, stub_oids,
			/*require_sequence_var=*/false);
		arg1_typmod = query_proof.has_value() ? query_proof->typmod : -1;
		arg1_typoid = stub_oids.bioseq_seq_type_oid;
	}
	if (arg1_typoid != stub_oids.bioseq_seq_type_oid
		|| arg1_typmod < 0) {
		return false;
	}
	/*
	 * Width must always be in the supported set (8 / 16 / 32 / 64).
	 * Alphabet must be one we know how to dispatch on (dna4 / dna5).
	 * The pack/unpack helper will raise on truly invalid typmods, so
	 * we keep this gate loose: anything BeginCustomScan can decode
	 * is allowed through. Cross-typmod is a runtime concern, not a
	 * planner-time rejection.
	 */
	return true;
}

static Expr *
ExtractPushdownClause(PlannerInfo *root, RelOptInfo *rel, Node *node)
{
	CHECK_FOR_INTERRUPTS();
	check_stack_depth();

	if (node == NULL)
	{
		return NULL;
	}

	/*
	 * mmsearch FuncExpr accepted by IsMmsearchPushdownable above.
	 * When the qual is a parameter-driven cross-table join
	 * mmsearch(t1.seq, t2.seq2), letting it through here is what
	 * makes Postgres generate the parameterised inner-side path
	 * that drives MmsearchParamRebind.
	 */
	if (FuncExpr* fe = pg_node_try_as<FuncExpr>(node)) {
		const BioseqStubOids& stub_oids = get_cached_stub_oids();
		if (IsMmsearchPushdownable(rel, fe, stub_oids)) {
			bioseq_log<DBG>("[bioseq] pg: ExtractPushdownClause() accepting mmsearch funcexpr funcid={} for rel relid={}",
					fe->funcid, static_cast<int>(rel->relid));
			return reinterpret_cast<Expr*>(node);
		}
	}

	if (BoolExpr *boolExpr = pg_node_try_as<BoolExpr>(node))
	{
		if (boolExpr->boolop == NOT_EXPR)
		{
			/*
			 * Standard planner should have already applied de-morgan rule to
			 * simple NOT expressions. If we encounter with such an expression
			 * here, then it can't be a pushdownable one, such as:
			 *   WHERE id NOT IN (SELECT id FROM something).
			 */
			bioseq_log_pg(planner_debug_level(),
				   "columnar planner: cannot push down clause: "
				   "must not contain a subplan");
			return NULL;
		}

		PList<Expr> pushdownableArgs;

		for(auto boolExprArg : PList<Node>(boolExpr->args))
		{
			Expr *pushdownableArg = ExtractPushdownClause(root, rel,
														  reinterpret_cast<Node *>(boolExprArg));
			if (pushdownableArg)
			{
				pushdownableArgs.append(pushdownableArg);
			}
			else if (boolExpr->boolop == OR_EXPR)
			{
				bioseq_log_pg(planner_debug_level(),
					   "columnar planner: cannot push down clause: "
					   "all arguments of an OR expression must be "
					   "pushdownable but one of them was not, due "
					   "to the reason given above");
				return NULL;
			}

			/* simply skip AND args that we cannot pushdown */
		}

		int npushdownableArgs = pushdownableArgs.length();
		if (npushdownableArgs == 0)
		{
			bioseq_log_pg(planner_debug_level(),
				   "columnar planner: cannot push down clause: "
				   "none of the arguments were pushdownable, "
				   "due to the reason(s) given above");
			return NULL;
		}
		else if (npushdownableArgs == 1)
		{
			return pushdownableArgs.first();
		}

		if (boolExpr->boolop == AND_EXPR)
		{
			return make_andclause(pushdownableArgs);
		}
		else if (boolExpr->boolop == OR_EXPR)
		{
			return make_orclause(pushdownableArgs);
		}
		else
		{
			/* already discarded NOT expr, so should not be reachable */
			return NULL;
		}
	}

	OpExpr *opExpr = pg_node_try_as<OpExpr>(node);
	pg_binary_node_args op_args = opExpr != nullptr ? pg_binary_args(*opExpr) : pg_binary_node_args{};
	if (!op_args.present())
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "must be binary operator expression");
		return NULL;
	}

	Expr *lhs = reinterpret_cast<Expr *>(op_args.first);
	Expr *rhs = reinterpret_cast<Expr *>(op_args.second);

	Var *varSide;
	Expr *exprSide;

	Var *lhs_var = pg_node_try_as<Var>(pg_as_node(lhs));
	Var *rhs_var = pg_node_try_as<Var>(pg_as_node(rhs));

	if (lhs_var != nullptr && lhs_var->varno == rel->relid &&
		!ExprReferencesRelid(rhs, rel->relid))
	{
		varSide = lhs_var;
		exprSide = rhs;
	}
	else if (rhs_var != nullptr && rhs_var->varno == rel->relid &&
			 !ExprReferencesRelid(lhs, rel->relid))
	{
		varSide = rhs_var;
		exprSide = lhs;
	}
	else
	{
		bioseq_report_pg(planner_debug_level())
				.msg("columnar planner: cannot push down clause: "
					 "must match 'Var <op> Expr' or 'Expr <op> Var'")
				.hint("Var must only reference this rel, "
					  "and Expr must not reference this rel");
		return NULL;
	}

	if (varSide->varattno <= 0)
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "var is whole-row reference or system column");
		return NULL;
	}

	if (contain_volatile_functions(reinterpret_cast<Node *>(exprSide)))
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "expr contains volatile functions");
		return NULL;
	}

	/* only the default opclass is used for qual pushdown. */
	Oid varOpClass = GetDefaultOpClass(varSide->vartype, BTREE_AM_OID);
	Oid varOpFamily;
	Oid varOpcInType;

	if (!OidIsValid(varOpClass) ||
		!get_opclass_opfamily_and_input_type(varOpClass, &varOpFamily,
											 &varOpcInType))
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "cannot find default btree opclass and opfamily for type: {}",
			   format_type_be(varSide->vartype));
		return NULL;
	}

	if (!op_in_opfamily(opExpr->opno, varOpFamily))
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "operator {} not a member of opfamily {}",
			   opExpr->opno, varOpFamily);
		return NULL;
	}

	Oid sortop = get_opfamily_member(varOpFamily, varOpcInType,
									 varOpcInType, BTLessStrategyNumber);
	Assert(OidIsValid(sortop));

	/*
	 * Check that statistics on the Var support the utility of this
	 * clause.
	 */
	float absVarCorrelation = 0;
	if (!CheckVarStats(root, varSide, sortop, &absVarCorrelation))
	{
		bioseq_log_pg(planner_debug_level(),
			   "columnar planner: cannot push down clause: "
			   "absolute correlation ({:.3f}) of var attribute {} is "
			   "smaller than the value configured in "
			   "\"bioseq.qual_pushdown_correlation_threshold\" "
			   "({:.3f})", absVarCorrelation, varSide->varattno,
			   bioseq::settings::qual_pushdown_correlation_threshold);
		return NULL;
	}

	return reinterpret_cast<Expr *>(node);
}


/*
 * FilterPushdownClauses filters for clauses that are candidates for pushing
 * down into rel.
 */
static List *
FilterPushdownClauses(PlannerInfo *root, RelOptInfo *rel, List *inputClauses)
{
	PList<RestrictInfo> filteredClauses;
	for (auto rinfo : PList<RestrictInfo>(inputClauses))
	{
		/*
		 * Ignore clauses that don't refer to this rel, and pseudoconstants.
		 *
		 * XXX: A pseudoconstant may be of use, but it doesn't make sense to
		 * push it down because it doesn't contain any Vars. Look into if
		 * there's something we should do with pseudoconstants here.
		 */
		if (rinfo->pseudoconstant ||
			!bms_is_member(rel->relid, rinfo->required_relids))
		{
			continue;
		}

		Expr *pushdownableExpr = ExtractPushdownClause(root, rel, reinterpret_cast<Node *>(rinfo->clause));
		if (!pushdownableExpr)
		{
			continue;
		}

		rinfo = copyObject(rinfo);
		rinfo->clause = pushdownableExpr;
		filteredClauses.append(rinfo);
	}

	return filteredClauses.release();
}


/*
 * PushdownJoinClauseMatches is a callback that returns true, indicating that
 * we want all of the clauses from generate_implied_equalities_for_column().
 */
static bool
PushdownJoinClauseMatches(PlannerInfo *root, RelOptInfo *rel,
						  EquivalenceClass *ec, EquivalenceMember *em,
						  void *arg)
{
	return true;
}


/*
 * FindPushdownJoinClauses finds join clauses, including those implied by ECs,
 * that may be pushed down.
 */
static List *
FindPushdownJoinClauses(PlannerInfo *root, RelOptInfo *rel)
{
	PList<RestrictInfo> joinClauses = copyObject(rel->joininfo);

	/*
	 * Here we are generating the clauses just so we can later extract the
	 * interesting relids. This is somewhat wasteful, but it allows us to
	 * filter out joinclauses, reducing the number of relids we need to
	 * consider.
	 *
	 * XXX: also find additional clauses for joininfo that are implied by ECs?
	 */
	List *ecClauses = generate_implied_equalities_for_column(
		root, rel, PushdownJoinClauseMatches, NULL,
		rel->lateral_referencers);
	joinClauses.concat(ecClauses);

	return FilterPushdownClauses(root, rel, joinClauses.release());
}


/*
 * FindCandidateRelids identifies candidate rels for parameterization from the
 * list of join clauses.
 *
 * Some rels cannot be considered for parameterization, such as a partitioned
 * parent of the given rel. Other rels are just not useful because they don't
 * appear in a join clause that could be pushed down.
 */
static Relids
FindCandidateRelids(PlannerInfo *root, RelOptInfo *rel, List *joinClauses)
{
	Relids candidateRelids = NULL;
	for (auto rinfo : PList<RestrictInfo>(joinClauses))
	{
		candidateRelids = bms_add_members(candidateRelids,
										  rinfo->required_relids);
	}

	candidateRelids = bms_del_members(candidateRelids, rel->relids);
	candidateRelids = bms_del_members(candidateRelids, rel->lateral_relids);
	candidateRelids = bms_del_members(candidateRelids, root->outer_join_rels);
	return candidateRelids;
}


/*
 * Combinations() calculates the number of combinations of n things taken k at
 * a time. When the correct result is large, the calculation may produce a
 * non-integer result, or overflow to inf, which caller should handle
 * appropriately.
 *
 * Use the following two formulae from Knuth TAoCP, 1.2.6:
 *    (2) Combinations(n, k) = (n*(n-1)..(n-k+1)) / (k*(k-1)..1)
 *    (5) Combinations(n, k) = Combinations(n, n-k)
 */
static double
Combinations(int n, int k)
{
	double v = 1;

	/*
	 * If k is close to n, then both the numerator and the denominator are
	 * close to n!, and we may overflow even if the input is reasonable
	 * (e.g. Combinations(500, 500)). Use formula (5) to choose the smaller,
	 * but equivalent, k.
	 */
	k = std::min(k, n - k);

	/* calculate numerator of formula (2) first */
	for (int i = n; i >= n - k + 1; i--)
	{
		v *= i;
	}

	/*
	 * Divide by each factor in the denominator of formula (2), skipping
	 * division by 1.
	 */
	for (int i = k; i >= 2; i--)
	{
		v /= i;
	}

	return v;
}


/*
 * ChooseDepthLimit() calculates the depth limit for the parameterization
 * search, given the number of candidate relations.
 *
 * The maximum number of paths generated for a given depthLimit is:
 *
 *    Combinations(nCandidates, 0) + Combinations(nCandidates, 1) + ... +
 *    Combinations(nCandidates, depthLimit)
 *
 * There's no closed formula for a partial sum of combinations, so just keep
 * increasing the depth until the number of combinations exceeds the limit.
 */
static int
ChooseDepthLimit(int nCandidates)
{
	if (!bioseq::settings::enable_qual_pushdown)
	{
		return 0;
	}

	int depth = 0;
	double numPaths = 1;

	while (depth < nCandidates)
	{
		numPaths += Combinations(nCandidates, depth + 1);

		if (numPaths
			> static_cast<double>(
				bioseq::settings::max_custom_scan_paths))
		{
			break;
		}

		depth++;
	}

	return depth;
}


/*
 * AddBioseqColumnScanPaths is the entry point for recursively generating
 * parameterized paths. See AddBioseqColumnScanPathsRec() for discussion.
 */
static void
AddBioseqColumnScanPaths(PlannerInfo *root, RelOptInfo *rel, RangeTblEntry *rte)
{
	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPaths() entered");
	List *joinClauses = FindPushdownJoinClauses(root, rel);
	Relids candidateRelids = FindCandidateRelids(root, rel, joinClauses);

	int depthLimit = ChooseDepthLimit(bms_num_members(candidateRelids));

	/* must always parameterize by lateral refs */
	Relids paramRelids = bms_copy(rel->lateral_relids);

	AddBioseqColumnScanPathsRec(root, rel, rte, paramRelids, candidateRelids,
							depthLimit);

	/* Once a CustomPath claims a restriction, remove only alternatives that
	 * would execute that same RestrictInfo through the SQL function.  This is
	 * structural selection; costs remain honest and nonnegative. */
	PList<RestrictInfo> owners;
	for (Path* candidate : PList<Path>(rel->pathlist)) {
		if (!IsA(candidate, CustomPath)) continue;
		CustomPath* custom = reinterpret_cast<CustomPath*>(candidate);
		bool is_mmsearch_owner = false;
		for (Node* private_node : PList<Node>(custom->custom_private)) {
			if (private_node == nullptr || !IsA(private_node, List)) continue;
			List* tag = reinterpret_cast<List*>(private_node);
			if (list_length(tag) == 3
				&& IsA(reinterpret_cast<Node*>(linitial(tag)), Integer)
				&& intVal(linitial(tag)) == kBioseqMmsearchOwnerMagic) {
				is_mmsearch_owner = true;
				break;
			}
		}
		if (!is_mmsearch_owner) continue;
		for (RestrictInfo* owner : PList<RestrictInfo>(custom->custom_restrictinfo)) {
			if (!list_member_ptr(owners.ptr(), owner)) owners.append(owner);
		}
	}
	auto prune_owned = [rel, &owners](List* paths) {
		PList<Path> survivors;
		for (Path* candidate : PList<Path>(paths)) {
			bool remove = false;
			for (RestrictInfo* owner : owners) {
				const bool executes_owner =
					list_member_ptr(rel->baserestrictinfo, owner)
					|| (candidate->param_info != nullptr
						&& list_member_ptr(candidate->param_info->ppi_clauses, owner));
				const bool owns_restriction = IsA(candidate, CustomPath)
					&& list_member_ptr(
						reinterpret_cast<CustomPath*>(candidate)->custom_restrictinfo,
						owner);
				if (executes_owner && !owns_restriction) {
					remove = true;
					break;
				}
			}
			if (!remove) survivors.append(candidate);
		}
		return survivors.release();
	};
	if (!owners.empty()) {
		rel->pathlist = prune_owned(rel->pathlist);
		rel->partial_pathlist = prune_owned(rel->partial_pathlist);
	}

	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPaths() returning");
}


/*
 * AddBioseqColumnScanPathsRec is a recursive function to search the
 * parameterization space and add CustomPaths for columnar scans.
 *
 * The set paramRelids is the parameterization at the current level, and
 * candidateRelids is the set from which we draw to generate paths with
 * greater parameterization.
 *
 * BioseqColumn tables resemble indexes because of the ability to push down
 * quals. Ordinary quals, such as x = 7, can be pushed down easily. But join
 * quals of the form "x = y" (where "y" comes from another rel) require the
 * proper parameterization.
 *
 * Paths that require more outer rels can push down more join clauses that
 * depend on those outer rels. But requiring more outer rels gives the planner
 * fewer options for the shape of the plan. That means there is a trade-off,
 * and we should generate plans of various parameterizations, then let the
 * planner choose. We always need to generate one minimally-parameterized path
 * (parameterized only by lateral refs, if present) to make sure that at least
 * one path can be chosen. Then, we generate as many parameterized paths as we
 * reasonably can.
 *
 * The set of all possible parameterizations is the power set of
 * candidateRelids. The power set has cardinality 2^N, where N is the
 * cardinality of candidateRelids. To avoid creating a huge number of paths,
 * limit the depth of the search; the depthLimit is equivalent to the maximum
 * number of required outer rels (beyond the minimal parameterization) for the
 * path. A depthLimit of zero means that only the minimally-parameterized path
 * will be generated.
 */
static void
AddBioseqColumnScanPathsRec(PlannerInfo *root, RelOptInfo *rel, RangeTblEntry *rte,
						Relids paramRelids, Relids candidateRelids,
						int depthLimit)
{
	CHECK_FOR_INTERRUPTS();
	check_stack_depth();

	Assert(!bms_overlap(paramRelids, candidateRelids));

	Path *bioseqColumnScanPath = AddBioseqColumnScanPath(root, rel, rte, paramRelids);
	CustomPath* owner_path = IsA(bioseqColumnScanPath, CustomPath)
		? reinterpret_cast<CustomPath*>(bioseqColumnScanPath) : nullptr;
	if (owner_path != nullptr) for (RestrictInfo* owner :
			PList<RestrictInfo>(owner_path->custom_restrictinfo)) {
		auto prune_competing_owner_execution = [rel, owner](List* paths) {
			PList<Path> survivors;
			for (Path* candidate : PList<Path>(paths)) {
				const bool executes_owner =
					list_member_ptr(rel->baserestrictinfo, owner)
					|| (candidate->param_info != nullptr
						&& list_member_ptr(candidate->param_info->ppi_clauses, owner));
				const bool owns_restriction = IsA(candidate, CustomPath)
					&& list_member_ptr(
						reinterpret_cast<CustomPath*>(candidate)->custom_restrictinfo,
						owner);
				if (!executes_owner || owns_restriction) survivors.append(candidate);
			}
			return survivors.release();
		};
		rel->pathlist = prune_competing_owner_execution(rel->pathlist);
		rel->partial_pathlist =
			prune_competing_owner_execution(rel->partial_pathlist);
	}
	if (bioseq::settings::enable_parallel_execution)
		bioseqColumnScanPath->total_cost += bioseqColumnScanPath->rows * 0.1;
	add_path(rel, bioseqColumnScanPath);

	/* For columnar custom scan we should also do planning for parallel exeuction
	 * if it is enabled with GUC.
	 */
	if (bioseq::settings::enable_parallel_execution)
	{
		int bioseq_min_parallel_process_running = bioseq::settings::min_parallel_processes;

		if (bioseq::settings::min_parallel_processes > max_parallel_workers)
		{
			bioseq_log_pg(DEBUG1, "bioseq.min_parallel_proceses is set higher than max_parallel_workers.");
			bioseq_log_pg(DEBUG1, "Using max_parallel_workers instead for parallel columnar scan.");
			bioseq_min_parallel_process_running =
				std::min(max_parallel_workers, bioseq::settings::min_parallel_processes);
		}

		if (parallel_leader_participation)
			bioseq_min_parallel_process_running--;

		/*
		 * We know how many workers are we going to run. Since workers are using single stripe
		 * probably it doesn't have much sense to spawn more workers than stripes in table.
		 */
		bioseq_min_parallel_process_running = std::min<int64_t>(bioseq_min_parallel_process_running,
													parallel_leader_participation ?
													BioseqColumnTableStripeCount(rte->relid) - 1 :
													BioseqColumnTableStripeCount(rte->relid));

		// FIXME: Fix this!!!
		const bool force_parallel = true;
		if (force_parallel) {
			bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPathsRec() force_parallel override active");
			bioseq_min_parallel_process_running = bioseq::settings::min_parallel_processes;
		}

		if (force_parallel || (rel->consider_parallel && rel->lateral_relids == NULL &&
			bioseq_min_parallel_process_running > 0))
		{
			bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPathsRec() add_partial_path for parallel scan");
			/*
			 * Passing NULL for JOIN quals in parallel execution.
			 */
			Path *parallelBioseqColumnScanPath =
				AddBioseqColumnScanPath(root, rel, rte, NULL);

			if (parallelBioseqColumnScanPath->parallel_safe) {
				parallelBioseqColumnScanPath->parallel_workers =
					bioseq_min_parallel_process_running;
				parallelBioseqColumnScanPath->parallel_aware = true;
				AdjustBioseqColumnParallelScanCost(
					parallelBioseqColumnScanPath);
				add_partial_path(rel, parallelBioseqColumnScanPath);
			} else {
				bioseq_log<DBG>("[bioseq] pg: suppressing parallel partial path for alignment-owning custom scan");
			}
		}
	}

	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPathsRec() recursing into candidate relids");

	/* recurse for all candidateRelids, unless we hit the depth limit */
	Assert(depthLimit >= 0);
	if (depthLimit-- == 0)
	{
		return;
	}

	/*
	 * Iterate through parameter combinations depth-first. Deeper levels
	 * generate paths of greater parameterization (and hopefully lower
	 * cost).
	 */
	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPathsRec() iterating parameter combinations depth-first");
	Relids tmpCandidateRelids = bms_copy(candidateRelids);
	int relid = -1;
	while ((relid = bms_next_member(candidateRelids, relid)) >= 0)
	{
		Relids tmpParamRelids = bms_add_member(
			bms_copy(paramRelids), relid);

		/*
		 * Because we are generating combinations (not permutations), remove
		 * the relid from the set of candidates at this level as we descend to
		 * the next.
		 */
		tmpCandidateRelids = bms_del_member(tmpCandidateRelids, relid);

		AddBioseqColumnScanPathsRec(root, rel, rte, tmpParamRelids,
								tmpCandidateRelids, depthLimit);
	}

	bms_free(tmpCandidateRelids);
}


/*
 * ParameterizationAsString returns the string representation of the set of
 * rels given in paramRelids.
 *
 * Takes a StringInfo so that it doesn't return palloc'd memory. This makes it
 * easy to call this function as an argument to ereport(), such that it won't
 * be evaluated unless the message is going to be output somewhere.
 */
static char *
ParameterizationAsString(PlannerInfo *root, Relids paramRelids, StringInfo buf)
{
	PBitmapset paramRelidsView{ paramRelids };

	if (paramRelidsView.empty())
	{
		return "unparameterized";
	}

	bool firstTime = true;
	appendStringInfoString(buf, "parameterized by rels {");
	for (int relid : paramRelidsView)
	{
		RangeTblEntry *rte = root->simple_rte_array[relid];
		const char *relname = quote_identifier(rte->eref->aliasname);

		appendStringInfo(buf, "%s%s", firstTime ? "" : ", ", relname);

		if (relname != rte->eref->aliasname)
		{
			pfree(const_cast<char *>(relname));
		}

		firstTime = false;
	}
	appendStringInfoString(buf, "}");
	return buf->data;
}


/*
 * ContainsExecParams tests whether the node contains any exec params. The
 * signature accepts an extra argument for use with expression_tree_walker.
 */
struct exec_params_probe_state {};

struct exec_params_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, exec_params_probe_state&) const {
		if (Param *param = node.try_as<Param>())
		{
			if (param->paramkind == PARAM_EXEC)
			{
				return pg_walk_step::stop;
			}
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool
ContainsExecParams(Node *node)
{
	exec_params_probe_state state;
	exec_params_visitor visitor;
	return pg_walk_expression_including_root(node, state, visitor);
}

/*
 * fixup_inherited_columns
 *
 * Exact function Copied from PG16 as it's static.
 *
 * When user is querying on a table with children, it implicitly accesses
 * child tables also. So, we also need to check security label of child
 * tables and columns, but there is no guarantee attribute numbers are
 * same between the parent and children.
 * It returns a bitmapset which contains attribute number of the child
 * table based on the given bitmapset of the parent.
 */
static Bitmapset *
fixup_inherited_columns(Oid parentId, Oid childId, Bitmapset *columns)
{
	PBitmapset result;

	/*
	 * obviously, no need to do anything here
	 */
	if (parentId == childId)
	{
		return columns;
	}

	for (int index : PBitmapset(columns))
	{
		/* bit numbers are offset by FirstLowInvalidHeapAttributeNumber */
		AttrNumber attno = index + FirstLowInvalidHeapAttributeNumber;

		/*
		 * whole-row-reference shall be fixed-up later
		 */
		if (attno == InvalidAttrNumber)
		{
			result.add(index);
			continue;
		}

		char *attname = get_attname(parentId, attno, false);
		attno = get_attnum(childId, attname);
		if (attno == InvalidAttrNumber)
		{
			bioseq_log<ERR, PG>( "cache lookup failed for attribute {} of relation {}",
				   attname, childId);
		}

		result.add(attno - FirstLowInvalidHeapAttributeNumber);

		pfree(attname);
	}

	return result.release();
}

struct cost_test_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, Query& parse) const {
		bioseq_log<DBG>("[bioseq] pg: cost_test_visitor() entered");
		if (Var* var_node = node.try_as<Var>()) {
			const auto var_no = var_node->varno;
			List* range_table = parse.rtable;
			if (range_table == nullptr) {
				bioseq_log<DBG>("[bioseq] pg: cost_test_visitor() var rtable is null");
			} else if (!bioseq_is_concrete_rte_varno(var_no)
				|| var_no > static_cast<Index>(list_length(range_table))) {
				bioseq_log<DBG>("[bioseq] pg: cost_test_visitor() var varno out of bounds varno={} rtable_len={}", var_no, list_length(range_table));
			} else {
				RangeTblEntry* rte = rt_fetch(var_no, range_table);
				bioseq_log<DBG>("[bioseq] pg: cost_test_visitor() rte_kind={} relid={}", static_cast<int>(rte->rtekind), static_cast<int>(rte->relid));
			}
		}

		return pg_walk_step::descend;
	}
};

/*
 * Create and add a path with the given parameterization paramRelids.
 *
 * XXX: Consider refactoring to be more like postgresGetForeignPaths(). The
 * only differences are param_info and custom_private.
 */
static Path *
AddBioseqColumnScanPath(PlannerInfo *root, RelOptInfo *rel, RangeTblEntry *rte,
					Relids paramRelids)
{
	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() entered");
	/*
	 * Must return a CustomPath, not a larger structure containing a
	 * CustomPath as the first field. Otherwise, nodeToString() will fail to
	 * output the additional fields.
	 */
	CustomPath *cpath = makeNode(CustomPath);

	cpath->methods = &BioseqColumnScanPathMethods;

	/*
	 * populate generic path information
	 */
	Path *path = &cpath->path;
	path->pathtype = T_CustomScan;
	path->parent = rel;
	path->pathtarget = copy_pathtarget(rel->reltarget);

	const BioseqStubOids& stub_oids = get_cached_stub_oids();

	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() mmsearch_oid={} score_oid={} cigar_oid={} query_start_oid={} symbol_count_oid={}",
		stub_oids.mmsearch_oid, stub_oids.score_oid, stub_oids.cigar_oid, stub_oids.query_start_oid,
		stub_oids.symbol_count_oid);

	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() walking pathtarget expressions");
	cost_test_visitor cost_visitor;
	for (auto expr : PList<Node>(path->pathtarget->exprs)) {
		bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() pathtarget expression");
		pg_walk_expression_including_root(expr, *root->parse, cost_visitor);
	}
	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() pathtarget walk complete");

	/* columnar scans are not parallel-aware, but they are parallel-safe */
	path->parallel_safe = rel->consider_parallel;

	path->param_info = get_baserel_parampathinfo(root, rel, paramRelids);

	/*
	 * Usable clauses for this parameterization exist in baserestrictinfo and
	 * ppi_clauses.
	 */
	PList<RestrictInfo> clauseReferences;
	for (RestrictInfo* rinfo : PList<RestrictInfo>(rel->baserestrictinfo)) {
		if (!list_member_ptr(clauseReferences.ptr(), rinfo)) {
			clauseReferences.append(rinfo);
		}
	}
	if (path->param_info != NULL) {
		for (RestrictInfo* rinfo : PList<RestrictInfo>(path->param_info->ppi_clauses)) {
			if (!list_member_ptr(clauseReferences.ptr(), rinfo)) {
				clauseReferences.append(rinfo);
			}
		}
	}
	OwnedMmsearchRestriction owned_mmsearch =
		choose_owned_mmsearch_restriction(
			root, rel, rte, clauseReferences.ptr(),
			path->param_info == nullptr
				? NIL : path->param_info->ppi_clauses,
			paramRelids, stub_oids);
	std::optional<BaseLocalMmsearchOwnershipProof> owned_mmsearch_proof;
	if (owned_mmsearch.normalized_expr != nullptr) {
		List* candidate_expressions = list_concat(
			list_make1(owned_mmsearch.normalized_expr),
			list_copy(owned_mmsearch.extra_normalized_exprs));
		bool exact = true;
		Node* canonical_target = nullptr;
		for (FuncExpr* candidate : PList<FuncExpr>(candidate_expressions)) {
			auto proof = prove_base_local_mmsearch_ownership(
				candidate, rel, paramRelids, stub_oids);
			Node* target = candidate == nullptr
				|| list_length(candidate->args) < 1 ? nullptr
				: reinterpret_cast<Node*>(linitial(candidate->args));
			if (!proof.has_value()
				|| (canonical_target != nullptr
					&& !equal(canonical_target, target))) {
				exact = false;
				break;
			}
			bioseq::simd::Minimap2Params option_probe =
				build_params_from_gucs();
			bioseq::indexing::IndexReadRequirement requirement_probe =
				bioseq::indexing::IndexReadRequirement::allow;
			(void)apply_aligner_options_override(
				candidate, option_probe, requirement_probe, stub_oids);
			if (proof->any_evaluated_operand
				&& requirement_probe
					== bioseq::indexing::IndexReadRequirement::
						require_compatible_persisted) {
				exact = false;
				break;
			}
			if (canonical_target == nullptr) {
				canonical_target = target;
				owned_mmsearch_proof = *proof;
			}
		}
		/* The legacy two-call fallback has one target capture and one query
		 * configuration.  Effectful/evaluated operands would either be shared
		 * across SQL occurrences or duplicated, so keep that contract raw-only. */
		if (exact && list_length(candidate_expressions) > 1
			&& owned_mmsearch_proof.has_value()
			&& owned_mmsearch_proof->any_evaluated_operand) {
			exact = false;
		}
		list_free(candidate_expressions);
		if (!exact) {
			owned_mmsearch = {};
			owned_mmsearch_proof.reset();
		}
	}

	bioseq_log<DBG>("[bioseq] pg: AddBioseqColumnScanPath() iterating allClauses (no-op pass for tracing)");
	for (auto restrict_info : clauseReferences)
	{
		(void) restrict_info;
	}

	PList<RestrictInfo> allClauses(FilterPushdownClauses(
		root, rel, list_copy(clauseReferences.ptr())));
	List* owned_mmsearch_restrictions = owned_mmsearch.restriction == nullptr
		? NIL : list_concat(
			list_make1(owned_mmsearch.restriction),
			list_copy(owned_mmsearch.extra_restrictions));
	List* owned_mmsearch_exprs = owned_mmsearch.normalized_expr == nullptr
		? NIL : list_concat(
			list_make1(owned_mmsearch.normalized_expr),
			list_copy(owned_mmsearch.extra_normalized_exprs));
	if (owned_mmsearch.restriction != nullptr) {
		allClauses = restrictions_without_owned_mmsearch(
			allClauses.release(), owned_mmsearch_restrictions,
			/*restrictions_are_private_copies=*/true);
		/*
		 * DOC0371 \u00a75.2: the POC publishes backend-local proof and has no
		 * DSM aggregation.  A worker-local snapshot must never masquerade as
		 * leader proof, so every alignment-owning path is parallel unsafe.
		 */
		path->parallel_safe = false;
	}

	SliceProjectIrBuilder base_operand_sources{
		.oids = &stub_oids,
		.command_type = CMD_SELECT,
		.planner_root = root,
		.target_leaf_support_relid = rel->relid,
		.source_bindings_only = true,
	};
	const bool needs_evaluated_operands = owned_mmsearch_proof.has_value()
		&& owned_mmsearch_proof->any_evaluated_operand;
	auto append_support_var = [&base_operand_sources](Var* variable) {
		if (variable == nullptr) return;
		for (Var* existing : PList<Var>(
				base_operand_sources.target_leaf_support_vars)) {
			if (equal(existing, variable)) return;
		}
		base_operand_sources.target_leaf_support_vars = lappend(
			base_operand_sources.target_leaf_support_vars, variable);
	};
	if (needs_evaluated_operands) {
		auto register_operand = [&base_operand_sources, &append_support_var](
				const BaseLocalMmsearchOperandProof& proof) {
			const std::uint32_t producer = slice_project_build_ir_node(
				base_operand_sources, proof.expression);
			slice_project_note_source_binding(
				base_operand_sources, proof.expression, producer);
			for (Var* source : PList<Var>(proof.sequence_vars)) {
				append_support_var(source);
			}
		};
		register_operand(owned_mmsearch_proof->target);
		if (owned_mmsearch_proof->local_query.has_value()) {
			register_operand(*owned_mmsearch_proof->local_query);
		}
		/* Residual quals execute before operand ExprStates.  Discover them from
		 * the full baserestrictinfo + parameterized-clause set, not allClauses:
		 * FilterPushdownClauses deliberately omits executor-only quals, while
		 * PlanCustomPath installs those full residuals in scan.plan.qual. */
		List* executable_residual_restrictions =
			restrictions_without_owned_mmsearch(
				clauseReferences.ptr(), owned_mmsearch_restrictions,
				/*restrictions_are_private_copies=*/false);
		constexpr int pull_flags = PVC_RECURSE_AGGREGATES
			| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
		for (RestrictInfo* residual : PList<RestrictInfo>(
				executable_residual_restrictions)) {
			if (residual == nullptr || residual->clause == nullptr) continue;
			List* variables = pull_var_clause(
				reinterpret_cast<Node*>(residual->clause), pull_flags);
			for (Var* variable : PList<Var>(variables)) {
				if (variable == nullptr || variable->varno != rel->relid
					|| variable->varattno <= 0 || variable->varlevelsup != 0
					|| !bms_is_empty(variable->varnullingrels)
					|| variable->vartype != stub_oids.bioseq_seq_type_oid) continue;
				append_support_var(variable);
				bool already_bound = false;
				for (auto const& binding : base_operand_sources.source_bindings) {
					if (equal(binding.first, variable)) {
						already_bound = true;
						break;
					}
				}
				if (!already_bound) {
					base_operand_sources.source_bindings.emplace_back(
						reinterpret_cast<Node*>(copyObject(variable)), 0u);
				}
			}
			list_free(variables);
		}
		list_free(executable_residual_restrictions);
	}

	/*
	 * Plain clauses may contain extern params, but not exec params, and can
	 * be evaluated at init time or rescan time. Track them in another list
	 * that is a subset of allClauses.
	 *
	 * Note: although typically baserestrictinfo contains plain clauses,
	 * that's not always true. It can also contain a qual referencing a Var at
	 * a higher query level, which can be turned into an exec param, and
	 * therefore it won't be a plain clause.
	 */
	PList<RestrictInfo> plainClauses;
	for (auto rinfo : allClauses)
	{
		if (bms_is_subset(rinfo->required_relids, rel->relids) &&
			!ContainsExecParams(reinterpret_cast<Node *>(rinfo->clause)))
		{
			plainClauses.append(rinfo);
		}
	}

	/*
	 * We can't make our own CustomPath structure, so we need to put
	 * everything in the custom_private list. To keep the two lists separate,
	 * we make them sublists in a 2-element list.
	 */
	if (bioseq::settings::enable_qual_pushdown)
	{
		cpath->custom_private = list_make2(copyObject(plainClauses.ptr()),
										   copyObject(allClauses.ptr()));
	}
	else
	{
		cpath->custom_private = list_make2(NIL, NIL);
	}
	if (owned_mmsearch.restriction != nullptr) {
		cpath->custom_restrictinfo = list_copy(owned_mmsearch_restrictions);
		cpath->custom_private = lappend(cpath->custom_private,
			list_make3(makeInteger(kBioseqMmsearchOwnerMagic),
				makeInteger(kBioseqMmsearchOwnerVersion),
				copyObject(owned_mmsearch_exprs)));
	} else {
		cpath->custom_restrictinfo = NIL;
	}

	int numberOfColumnsRead = 0;
	if (rte->perminfoindex > 0)
	{
		/*
		 * If perminfoindex > 0, that means that this relation's permission info
		 * is directly found in the list of rteperminfos of the Query(root->parse)
		 * So, all we have to do here is retrieve that info.
		 */
		RTEPermissionInfo *perminfo = getRTEPermissionInfo(root->parse->rteperminfos,
														   rte);
		numberOfColumnsRead = bms_num_members(perminfo->selectedCols);
	}
	else
	{
		/*
		 * If perminfoindex = 0, that means we are skipping the check for permission info
		 * for this relation, which means that it's either a partition or an inheritance child.
		 * In these cases, we need to access the permission info of the top parent of this relation.
		 * After thorough checking, we found that the index of the top parent pointing to the correct
		 * range table entry in Query's range tables (root->parse->rtable) is found under
		 * RelOptInfo rel->top_parent->relid.
		 * For reference, check expand_partitioned_rtentry and expand_inherited_rtentry PG functions
		 */
		Assert(rel->top_parent);
		RangeTblEntry *parent_rte = rt_fetch(rel->top_parent->relid, root->parse->rtable);
		RTEPermissionInfo *perminfo = getRTEPermissionInfo(root->parse->rteperminfos,
														   parent_rte);
		numberOfColumnsRead = bms_num_members(fixup_inherited_columns(perminfo->relid,
																	  rte->relid,
																	  perminfo->
																	  selectedCols));
	}
	int numberOfClausesPushed = allClauses.length();

	/* Queries that contain only aggregate with STAR doesn't have any
	 * selectedCols so we should consider at least one column that needs
	 * read (for better cost calculation).
	 */
	if (numberOfColumnsRead == 0)
		numberOfColumnsRead = 1;

	CostBioseqColumnScan(root, rel, rte->relid, cpath, numberOfColumnsRead,
					 numberOfClausesPushed);

	for (FuncExpr* owned_expr : PList<FuncExpr>(owned_mmsearch_exprs)) {
		QualCost operand_cost{};
		List* operand_expressions = mmsearch_operand_cost_exprs(
			owned_expr, stub_oids);
		cost_qual_eval(&operand_cost, operand_expressions, root);
		PList<Node> operands(owned_expr->args);
		const std::uint64_t target_symbols =
			estimate_mmsearch_operand_symbols(operands.first(), stub_oids);
		const std::uint64_t query_symbols =
			estimate_mmsearch_operand_symbols(operands.second(), stub_oids);
		const std::uint64_t admitted_bytes =
			bioseq::parallelism::saturating_add(
				target_symbols, query_symbols);
		bioseq::simd::Minimap2Params planned_params =
			build_params_from_gucs();
		bioseq::indexing::IndexReadRequirement planned_requirement =
			bioseq::indexing::IndexReadRequirement::allow;
		(void)apply_aligner_options_override(
			owned_expr, planned_params,
			planned_requirement, stub_oids);
		if (owned_mmsearch_proof.has_value()
			&& owned_mmsearch_proof->any_evaluated_operand) {
			planned_requirement =
				bioseq::indexing::IndexReadRequirement::require_absent;
		}
		const owned_mmsearch_cost alignment = estimate_owned_mmsearch_cost(
			target_symbols, query_symbols, path->rows,
			planned_requirement
				!= bioseq::indexing::IndexReadRequirement::require_absent,
			static_cast<std::uint32_t>(std::min<std::size_t>(
				kBioseqRuntimeBufferReserve,
				(std::numeric_limits<std::uint32_t>::max)())),
			admitted_bytes);
		const Cost owner_startup = std::max<Cost>(0,
			operand_cost.startup + alignment.startup);
		const Cost owner_per_row = std::max<Cost>(0,
			operand_cost.per_tuple + alignment.per_input_tuple);
		path->startup_cost += owner_startup;
		path->total_cost += owner_startup
			+ owner_per_row * std::max(0.0, path->rows);
	}
	if (!std::isfinite(path->startup_cost) || path->startup_cost < 0) {
		path->startup_cost = 0;
	}
	if (!std::isfinite(path->total_cost)) {
		path->total_cost = std::numeric_limits<Cost>::max() / 4.0;
	}
	path->total_cost = std::max(path->startup_cost, path->total_cost);


	bioseq_report_pg_lazy(
		planner_debug_level(),
		[rte, root, paramRelids, numberOfClausesPushed] {
		StringInfoData buf;
		initStringInfo(&buf);
		bioseq_report_pg(planner_debug_level())
				.msg("columnar planner: adding CustomScan path for {}",
					 rte->eref->aliasname)
				.detail("{}; {} clauses pushed down",
						ParameterizationAsString(root, paramRelids, &buf),
						numberOfClausesPushed);
	});

	if (needs_evaluated_operands) {
		Path* private_path = slice_project_clone_mutable_path_spine(path);
		bool tagged_source = false;
		private_path = slice_project_tag_owned_path_tree(
			private_path, base_operand_sources, tagged_source);
		if (!tagged_source) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan evaluated mmsearch operand has no source provider")));
		}
		return private_path;
	}
	return path;
}


/*
 * AdjustBioseqColumnParallelScanCost calculates path cost based on
 * number of parallel workers (based on postgres code).
 */
static void
AdjustBioseqColumnParallelScanCost(Path *path)
{
	/* Adjust costing for parallelism, if used. */
	if (path->parallel_workers > 0)
	{
		double parallel_divisor = path->parallel_workers;

		if (parallel_leader_participation)
		{
			double leader_contribution;

			leader_contribution = 1.0 - (0.3 * path->parallel_workers);
			if (leader_contribution > 0)
				parallel_divisor += leader_contribution;
		}

		/* The CPU cost is divided among all the workers. */
		path->total_cost /= parallel_divisor;

		path->rows = clamp_row_est(path->rows / parallel_divisor);
	}
}


/*
 * CostBioseqColumnScan calculates the cost of scanning the columnar table. The
 * cost is estimated by using all stripe metadata to estimate based on the
 * columns to read how many pages need to be read.
 */
static void
CostBioseqColumnScan(PlannerInfo *root, RelOptInfo *rel, Oid relationId,
				 CustomPath *cpath, int numberOfColumnsRead, int nClauses)
{
	Path *path = &cpath->path;

	List *allClauses = PList<List>(cpath->custom_private).second();
	Selectivity clauseSel = clauselist_selectivity(
		root, allClauses, rel->relid, JOIN_INNER, NULL);

	/*
	 * We already filtered out clauses where the overall selectivity would be
	 * misleading, such as inequalities involving an uncorrelated column. So
	 * we can apply the selectivity directly to the number of stripes.
	 */
	double stripesToRead = clauseSel * BioseqColumnTableStripeCount(relationId);
	stripesToRead = std::max(stripesToRead, 1.0);

	path->rows = rel->tuples;
	path->startup_cost = enable_seqscan ? 0 : disable_cost;
	path->total_cost = path->startup_cost + stripesToRead *
					   BioseqColumnPerStripeScanCost(rel, relationId, numberOfColumnsRead);
}


/*
 * BioseqColumnPerStripeScanCost calculates the cost to scan a single stripe
 * of given columnar table based on number of columns that needs to be
 * read during scan operation.
 */
static Cost
BioseqColumnPerStripeScanCost(RelOptInfo *rel, Oid relationId, int numberOfColumnsRead)
{
	Relation relation = RelationIdGetRelation(relationId);
	List *stripeList = StripesForRelfilenode(RelationPhysicalIdentifier_compat(relation), ForwardScanDirection);
	RelationClose(relation);

	uint32_t maxColumnCount = 0;
	uint64_t totalStripeSize = 0;
	for(auto stripeMetadata : PList<StripeMetadata>(stripeList))
	{
		totalStripeSize += stripeMetadata->dataLength;
		maxColumnCount = std::max(maxColumnCount, stripeMetadata->columnCount);
	}

	/*
	 * When no stripes are in the table we don't have a count in maxColumnCount. To
	 * prevent a division by zero turning into a NaN we keep the ratio on zero.
	 * This will result in a cost of 0 for scanning the table which is a reasonable
	 * cost on an empty table.
	 */
	if (maxColumnCount == 0)
	{
		return 0;
	}

	double columnSelectionRatio = numberOfColumnsRead / static_cast<double>(maxColumnCount);
	Cost tableScanCost = static_cast<double>(totalStripeSize) / BLCKSZ * columnSelectionRatio;
	Cost perStripeScanCost = tableScanCost / list_length(stripeList);

	/*
	 * Finally, multiply the cost of reading a single stripe by seq page read
	 * cost to make our estimation scale compatible with postgres.
	 * Since we are calculating the cost for a single stripe here, we use seq
	 * page cost instead of random page cost. This is because, random page
	 * access only happens when switching between columns, which is pretty
	 * much neglactable.
	 */
	double relSpaceSeqPageCost;
	get_tablespace_page_costs(rel->reltablespace,
							  NULL, &relSpaceSeqPageCost);
	perStripeScanCost = perStripeScanCost * relSpaceSeqPageCost;

	return perStripeScanCost;
}


/*
 * BioseqColumnTableStripeCount returns the number of stripes that columnar
 * table with relationId has by using stripe metadata.
 */
static uint64_t
BioseqColumnTableStripeCount(Oid relationId)
{
	Relation relation = RelationIdGetRelation(relationId);
	List *stripeList = StripesForRelfilenode(RelationPhysicalIdentifier_compat(relation), ForwardScanDirection);
	int stripeCount = list_length(stripeList);
	RelationClose(relation);

	return stripeCount;
}

struct BaseMatchHelperRegistration {
	const BioseqStubOids* oids = nullptr;
	Node* target_recipe = nullptr;
	Index target_relid = 0;
	AttrNumber primary_target_attno = InvalidAttrNumber;
	AttrNumber current_resno = InvalidAttrNumber;
	List* sites = NIL;
	bool invalid = false;
};

[[nodiscard]] static bool base_match_helper_site_already_registered(
		List* sites, FuncExpr* helper,
		const AttrNumber resno) noexcept {
	if (helper == nullptr) return false;
	Node* argument = batch_join_match_helper_argument(helper);
	for (List* encoded : PList<List>(sites)) {
		if (encoded == nullptr || !IsA(encoded, List)
			|| list_length(encoded) != kBioseqMatchHelperSiteFields) continue;
		Node* funcid_node = reinterpret_cast<Node*>(list_nth(
			encoded, kMatchSiteFuncid));
		Node* resno_node = reinterpret_cast<Node*>(list_nth(
			encoded, kMatchSiteResno));
		Node* encoded_argument = reinterpret_cast<Node*>(list_nth(
			encoded, kMatchSiteCanonicalArgument));
		if (funcid_node != nullptr && IsA(funcid_node, Integer)
			&& resno_node != nullptr && IsA(resno_node, Integer)
			&& intVal(resno_node) == resno
			&& static_cast<Oid>(intVal(funcid_node)) == helper->funcid
			&& encoded_argument != nullptr && argument != nullptr
			&& equal(encoded_argument, argument)) return true;
	}
	return false;
}

struct base_match_helper_registration_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			BaseMatchHelperRegistration& registration) const {
		FuncExpr* function = node.try_as<FuncExpr>();
		if (function == nullptr || registration.oids == nullptr
			|| !is_bioseq_projection_funcid(
				function->funcid, *registration.oids)) {
			return pg_walk_step::descend;
		}
		FuncExpr* helper = batch_join_well_formed_match_helper(
			reinterpret_cast<Node*>(function), *registration.oids);
		if (helper == nullptr || registration.target_recipe == nullptr) {
			registration.invalid = true;
			return pg_walk_step::stop;
		}
		const bool names_recipe = batch_join_match_helper_names_recipe(
			helper, registration.target_recipe);
		const bool names_lineage = batch_join_match_helper_names_base_lineage(
			helper, registration.target_recipe,
			*registration.oids);
		/* Exact transformed recipes and their unique canonical base lineage are
		 * both valid spellings for one base owner.  Resolution across multiple
		 * owners remains query-scope fail-closed in the common finalizer. */
		if (!names_recipe && !names_lineage) {
			return pg_walk_step::skip_subtree;
		}
		if (!edit_sequence_argument_matches_recipe(
				helper, registration.target_recipe,
				registration.target_relid,
				registration.primary_target_attno,
				*registration.oids)) {
			registration.invalid = true;
			return pg_walk_step::stop;
		}
		if (base_match_helper_site_already_registered(
				registration.sites, helper,
				registration.current_resno)) {
			return pg_walk_step::skip_subtree;
		}
		const Oid result_type = exprType(reinterpret_cast<Node*>(helper));
		if (!OidIsValid(result_type)
			|| result_type != helper->funcresulttype
			|| result_type != get_func_rettype(helper->funcid)
			|| registration.current_resno <= 0) {
			registration.invalid = true;
			return pg_walk_step::stop;
		}
		List* encoded = list_make5(
			makeInteger(registration.current_resno),
			makeInteger(static_cast<int>(helper->funcid)),
			makeInteger(exprTypmod(reinterpret_cast<Node*>(helper))),
			makeInteger(static_cast<int>(
				exprCollation(reinterpret_cast<Node*>(helper)))),
			makeInteger(static_cast<int>(
				BioseqMatchHelperBindingKind::unresolved)));
		encoded = lappend(encoded, copyObject(
			batch_join_match_helper_argument(helper)));
		encoded = lappend(encoded, makeInteger(0));
		encoded = lappend(encoded, makeInteger(0));
		registration.sites = lappend(registration.sites, encoded);
		return pg_walk_step::skip_subtree;
	}
};

[[nodiscard]] static List* collect_base_match_helper_sites(
		List* targetlist, Node* target_recipe, const Index target_relid,
		const AttrNumber primary_target_attno,
		const BioseqStubOids& oids) {
	BaseMatchHelperRegistration registration{
		&oids, target_recipe, target_relid, primary_target_attno,
		InvalidAttrNumber, NIL, false};
	base_match_helper_registration_visitor visitor;
	for (TargetEntry* entry : PList<TargetEntry>(targetlist)) {
		if (entry == nullptr || entry->expr == nullptr) continue;
		registration.current_resno = entry->resno;
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(entry->expr), registration, visitor);
		if (registration.invalid) {
				ereport(ERROR,
				(errcode(ERRCODE_INVALID_COLUMN_REFERENCE),
				 errmsg("BioseqScan match helper identity is invalid"),
				 errhint("Use the exact mmsearch target recipe or its unique base source lineage.")));
		}
	}
	return registration.sites;
}


static Plan *
BioseqColumnScanPath_PlanCustomPath(PlannerInfo *root,
								RelOptInfo *rel,
								CustomPath *best_path,
								List *tlist,
								List *clauses,
								List *custom_plans)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanPath_PlanCustomPath() entered");
	// PAPIESZ: ADD HERE
	/*
	 * Must return a CustomScan, not a larger structure containing a
	 * CustomScan as the first field. Otherwise, copyObject() will fail to
	 * copy the additional fields.
	 */
	CustomScan *cscan = makeNode(CustomScan);

	cscan->methods = &BioseqColumnScanScanMethods;
	cscan->custom_private = NIL;
	bool locator_passthrough_requested = false;
	bool lazy_source_projection_requested = false;
	List* owned_mmsearch_exprs = NIL;
	for (Node* possible_tag : PList<Node>(best_path->custom_private)) {
		if (possible_tag == nullptr || !IsA(possible_tag, List)) continue;
		List* tag = reinterpret_cast<List*>(possible_tag);
		if (tag == NIL
			|| !IsA(reinterpret_cast<Node*>(linitial(tag)), Integer)) continue;
		if (list_length(tag) == 4
			&& intVal(list_nth(tag, 0)) == kBioseqLocatorPassthroughMagic) {
			locator_passthrough_requested = true;
		}
		if (list_length(tag) == 3
			&& intVal(list_nth(tag, 0)) == kBioseqSliceSourceMagic) {
			lazy_source_projection_requested = true;
		}
		if (list_length(tag) == 3
			&& intVal(list_nth(tag, 0)) == kBioseqMmsearchOwnerMagic) {
			Node* expressions_node = reinterpret_cast<Node*>(
				list_nth(tag, 2));
			if (intVal(list_nth(tag, 1)) != kBioseqMmsearchOwnerVersion
				|| owned_mmsearch_exprs != NIL
				|| expressions_node == nullptr
				|| !IsA(expressions_node, List)
				|| (owned_mmsearch_exprs = reinterpret_cast<List*>(
					expressions_node)) == NIL) {
					ereport(ERROR,
						(errcode(ERRCODE_DATA_CORRUPTED),
						 errmsg("Bioseq mmsearch owner path tag is invalid")));
			}
			if (list_length(owned_mmsearch_exprs) > 2) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("Bioseq mmsearch owner path has too many expressions")));
			}
			for (Node* expression : PList<Node>(owned_mmsearch_exprs)) {
				FuncExpr* mmsearch = pg_node_try_as<FuncExpr>(expression);
				if (mmsearch == nullptr
					|| !is_mmsearch_funcid(
						mmsearch->funcid, get_cached_stub_oids())) {
					ereport(ERROR,
						(errcode(ERRCODE_DATA_CORRUPTED),
						 errmsg("Bioseq mmsearch owner path expression is invalid")));
				}
			}
		}
	}
	List* owned_mmsearch_restrictions = best_path->custom_restrictinfo;
	if ((owned_mmsearch_exprs == NIL)
		!= (owned_mmsearch_restrictions == NIL)
		|| list_length(owned_mmsearch_exprs)
			!= list_length(owned_mmsearch_restrictions)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("Bioseq mmsearch ownership metadata is inconsistent")));
	}
	Node* planner_owned_target_recipe = owned_mmsearch_exprs == NIL
		? nullptr : reinterpret_cast<Node*>(linitial(
			reinterpret_cast<FuncExpr*>(linitial(
				owned_mmsearch_exprs))->args));
	const bool planner_owned_target_evaluated =
		planner_owned_target_recipe != nullptr
		&& pg_node_try_as<Var>(planner_owned_target_recipe) == nullptr;

	/* XXX: also need to store projected column list for EXPLAIN */

	if (bioseq::settings::enable_qual_pushdown)
	{
		/*
		 * Lists of pushed-down clauses. The Vars in custom_exprs referencing
		 * other relations will be changed into exec Params by
		 * create_customscan_plan().
		 *
		 * Like CustomPath->custom_private, keep a list of plain clauses
		 * separate from the list of all clauses by making them sublists of a
		 * 2-element list.
		 *
		 * XXX: custom_exprs are the quals that will be pushed into the
		 * columnar reader code; some of these may not be usable. We should
		 * fix this by processing the quals more completely and using
		 * ScanKeys.
		 */
		PList<List> private_lists(best_path->custom_private);
		List *plainClauses = extract_actual_clauses(
			private_lists.first(), false /* no pseudoconstants */);
		List *allClauses = extract_actual_clauses(
			private_lists.second(), false /* no pseudoconstants */);
		cscan->custom_exprs = copyObject(list_make2(plainClauses, allClauses));
	}
	else
	{
		cscan->custom_exprs = list_make2(NIL, NIL);
	}

	List* executable_clauses = restrictions_without_owned_mmsearch(
		clauses, owned_mmsearch_restrictions,
		/*restrictions_are_private_copies=*/false);
	cscan->scan.plan.qual = extract_actual_clauses(
		executable_clauses, false /* no pseudoconstants */);
	if (owned_mmsearch_exprs != NIL) {
		for (Node* qual : PList<Node>(cscan->scan.plan.qual)) {
			if (contains_mmsearch_qualifier(qual, get_cached_stub_oids())) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("owned mmsearch remained in executable scan quals")));
			}
		}
	}

	/* Split the exact edit predicate out before ExecInitQual sees it.  Its
	 * placeholder has no value until MatchResults are drained, whereas every
	 * remaining scan qual is valid in the ordinary pre-alignment phase. */
	std::optional<StrictEditPredicate> strict_edit_predicate;
	{
		const BioseqStubOids& edit_oids = get_cached_stub_oids();
		PList<Node> pre_alignment_quals;
		for (Node* qual : PList<Node>(cscan->scan.plan.qual)) {
			if (!contains_bioseq_edit(qual, edit_oids)) {
				pre_alignment_quals.append(qual);
				continue;
			}
			if (planner_owned_target_evaluated) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("bioseq.edit scan predicates do not support a transformed mmsearch target"),
					 errhint("Project bioseq.edit with the exact transformed recipe, or apply the edit predicate in a separate query level.")));
			}
			const auto decoded = decode_strict_edit_upper_bound(
				qual, best_path->path.parent->relid, edit_oids);
			if (!decoded.has_value() || strict_edit_predicate.has_value()) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("unsupported bioseq.edit predicate"),
					 errdetail("Use exactly one top-level bioseq.edit(sequence_column) < integer constant predicate.")));
			}
			strict_edit_predicate = *decoded;
		}
		cscan->scan.plan.qual = pre_alignment_quals.release();

		if (strict_edit_predicate.has_value()) {
			PList<List> edit_expr_lists(cscan->custom_exprs);
			cscan->custom_exprs = list_make2(
				quals_without_bioseq_edit(edit_expr_lists.first(), edit_oids),
				quals_without_bioseq_edit(edit_expr_lists.second(), edit_oids));
			Const* threshold = makeConst(
				INT8OID, -1, InvalidOid, 8,
				Int64GetDatum(strict_edit_predicate->exclusive_upper_bound),
				false, true);
			List* tag = list_make4(
				makeInteger(kBioseqEditPredicateMagic),
				makeInteger(kBioseqEditPredicateVersion),
				threshold,
				makeInteger(strict_edit_predicate->sequence_attno));
			cscan->custom_private = lappend(cscan->custom_private, tag);
		}
	}

			const BioseqStubOids& plan_stub_oids = get_cached_stub_oids();
			const Index scan_relid = best_path->path.parent->relid;
			if (!locator_passthrough_requested) for(auto n : PList<TargetEntry>(root->processed_tlist)) {
			if (FuncExpr* fe = pg_node_try_as<FuncExpr>(pg_as_node(n->expr))) {
				bool belongs_to_scan = false;
				if (is_bioseq_projection_funcid(fe->funcid, plan_stub_oids)) {
					FuncExpr* helper = batch_join_well_formed_match_helper(
						reinterpret_cast<Node*>(fe), plan_stub_oids);
					Var* argument = helper == nullptr ? nullptr
						: pg_node_try_as<Var>(
							batch_join_match_helper_argument(helper));
					const bool direct_scan_argument = argument != nullptr
						&& argument->varno == scan_relid
						&& argument->varattno > 0
						&& argument->varlevelsup == 0
						&& bms_is_empty(argument->varnullingrels);
					/* Keep a direct scan-local mismatch inside this owner so its
					 * finalized injector emits the established target-column
					 * diagnostic.  Wrapped mismatches remain unclaimed and reach
					 * the scalar fail-closed boundary. */
					if (helper != nullptr
						&& planner_owned_target_recipe != nullptr) {
						belongs_to_scan = batch_join_match_helper_names_recipe(
							helper, planner_owned_target_recipe)
							|| batch_join_match_helper_names_base_lineage(
								helper, planner_owned_target_recipe,
								plan_stub_oids)
							|| direct_scan_argument;
					} else {
						belongs_to_scan = direct_scan_argument;
					}
				} else if (fe->funcid == plan_stub_oids.symbol_count_oid) {
					constexpr int pull_flags = PVC_RECURSE_AGGREGATES
						| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
					List* variables = pull_var_clause(
						reinterpret_cast<Node*>(fe), pull_flags);
					belongs_to_scan = variables != NIL;
					for (Var* variable : PList<Var>(variables)) {
						if (variable == nullptr || variable->varno != scan_relid
							|| variable->varlevelsup != 0) {
							belongs_to_scan = false;
							break;
						}
					}
				}
				if (belongs_to_scan) {
					/* Descendant-owner propagation may already have widened this
					 * private BioseqScan PathTarget with the exact whole helper.
					 * Retain one authoritative carrier/site instead of appending a
					 * duplicate from processed_tlist. */
					bool already_projected = false;
					for (TargetEntry* existing : PList<TargetEntry>(tlist)) {
						if (existing != nullptr
							&& equal(existing->expr, n->expr)) {
							already_projected = true;
							break;
						}
					}
					if (!already_projected) {
						TargetEntry* projected = copyObject(n);
						projected->resno = static_cast<AttrNumber>(
							list_length(tlist) + 1);
						tlist = lappend(tlist, projected);
					}
				}
			}
		}
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanPath_PlanCustomPath() tlist_is_null={}", tlist == nullptr);

	cscan->scan.plan.targetlist = list_copy(tlist);
	cscan->scan.scanrelid = best_path->path.parent->relid;
	if (owned_mmsearch_exprs != NIL) {
		FuncExpr* owned_mmsearch_expr = reinterpret_cast<FuncExpr*>(
			linitial(owned_mmsearch_exprs));
		Node* target_node = list_length(owned_mmsearch_expr->args) >= 1
			? reinterpret_cast<Node*>(linitial(owned_mmsearch_expr->args))
			: nullptr;
		Node* target_recipe = target_node;
		RangeTblEntry* owner_rte = root != nullptr && root->parse != nullptr
			&& bioseq_is_concrete_rte_varno(cscan->scan.scanrelid)
			&& cscan->scan.scanrelid <= static_cast<Index>(
				list_length(root->parse->rtable))
			? rt_fetch(cscan->scan.scanrelid, root->parse->rtable)
			: nullptr;
		const BioseqStubOids& owner_oids = get_cached_stub_oids();
		List* target_lineage = canonical_match_base_lineage(
			target_recipe, owner_oids);
		Var* primary_source = target_lineage == NIL ? nullptr
			: reinterpret_cast<Var*>(linitial(target_lineage));
		bool valid_lineage = primary_source != nullptr;
		for (Var* source : PList<Var>(target_lineage)) {
			if (source == nullptr || source->varno != cscan->scan.scanrelid
				|| source->varattno <= 0 || source->varlevelsup != 0
				|| !bms_is_empty(source->varnullingrels)
				|| source->vartype != owner_oids.bioseq_seq_type_oid) {
				valid_lineage = false;
				break;
			}
		}
		if (target_recipe == nullptr
			|| exprType(target_recipe) != owner_oids.bioseq_seq_type_oid
			|| !valid_lineage
			|| owner_rte == nullptr || owner_rte->rtekind != RTE_RELATION
			|| !OidIsValid(owner_rte->relid)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan match owner target identity is invalid")));
		}
		List* descriptor = make_match_owner_descriptor(
			target_recipe, cscan->scan.scanrelid, owner_oids);
		List* sites = collect_base_match_helper_sites(
			cscan->scan.plan.targetlist, target_recipe,
			cscan->scan.scanrelid, primary_source->varattno, owner_oids);
		List* owner_tag = list_make5(
			makeInteger(kBioseqBaseMatchOwnerPlanMagic),
			makeInteger(kBioseqBaseMatchOwnerPlanVersion),
			descriptor,
			sites,
			makeInteger(static_cast<int>(owner_rte->relid)));
		/* The planner-scope descriptor/sites above deliberately retain their
		 * query-local pre-setrefs Vars for ambiguity resolution.  The finalizer
		 * fills these two executor-only fields from post-setrefs custom_exprs and
		 * scan targetlist identities once Plan.plan_node_id is stable. */
		owner_tag = lappend(owner_tag, NIL);
		owner_tag = lappend(owner_tag, NIL);
		Assert(list_length(owner_tag) == kBioseqBaseMatchOwnerPlanFields);
		cscan->custom_private = lappend(cscan->custom_private, owner_tag);
	}
	for (Node* tag_node : PList<Node>(best_path->custom_private)) {
		if (tag_node != nullptr && IsA(tag_node, List)) {
			List* source_tag = reinterpret_cast<List*>(tag_node);
			if (source_tag == NIL
				|| !IsA(reinterpret_cast<Node*>(linitial(source_tag)), Integer)) {
				continue;
			}
			List* tag = reinterpret_cast<List*>(copyObject(source_tag));
			if (list_length(tag) == 4
				&& intVal(list_nth(tag, 0)) == kBioseqLocatorPassthroughMagic
				&& intVal(list_nth(tag, 1)) == kBioseqBatchJoinPlanVersion) {
				TargetEntry* rowno_entry = reinterpret_cast<TargetEntry*>(
					llast(cscan->scan.plan.targetlist));
				if (rowno_entry == nullptr
					|| exprType(reinterpret_cast<Node*>(rowno_entry->expr))
						!= INT8OID) {
					ereport(ERROR,
						(errcode(ERRCODE_INTERNAL_ERROR),
						 errmsg("Bioseq locator passthrough row-number column is missing")));
				}
				rowno_entry->resjunk = true;
				lfirst(list_nth_cell(tag, 3)) =
					makeInteger(rowno_entry->resno);
				cscan->custom_private = lappend(cscan->custom_private, tag);
				} else if (list_length(tag) == 3
					&& IsA(reinterpret_cast<Node*>(list_nth(tag, 1)), Integer)
					&& intVal(list_nth(tag, 0)) == kBioseqSliceSourceMagic
					&& intVal(list_nth(tag, 1)) == kBioseqSliceSourceVersion
				&& (list_nth(tag, 2) == nullptr
					|| IsA(reinterpret_cast<Node*>(list_nth(tag, 2)), List))) {
				cscan->custom_private = lappend(cscan->custom_private, tag);
			}
		}
	}

	/*
	 * Vectorized QUAL execution. Split QUAL list into vectorized list
	 * stored in third position of custom_exprs list and rest of
	 * qual list (which can't be vectorized) in scan.plan.qual.
	 */
	/* Locator/source scans deliberately run the scalar executor so every row
	 * can be promoted through its exact provider.  Do not remove vectorizable
	 * quals from scan.plan.qual when BeginCustomScan will disable the vector
	 * executor; doing so turns alias-local restrictions into a cross product. */
	if (bioseq::settings::enable_vectorization
		&& !locator_passthrough_requested
		&& !lazy_source_projection_requested)
	{
		List *candidateQualList = CreateVectorizedExprList(cscan->scan.plan.qual);
		List *listDifference = list_difference(candidateQualList, cscan->scan.plan.qual);

		bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanPath_PlanCustomPath() splitting qual list for vectorization");

		cscan->custom_exprs = lappend(cscan->custom_exprs, listDifference);

		if (listDifference != NULL)
			cscan->scan.plan.qual = list_intersection(cscan->scan.plan.qual,
													  candidateQualList);
	}
	else
	{
		bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanPath_PlanCustomPath() vectorization disabled, qual not split");
		/* We still need to create third entry in custom_exprs */
		cscan->custom_exprs = lappend(cscan->custom_exprs, NIL);
	}
	/* The fourth expression list is executor-only ownership state.  Keeping it
	 * in custom_exprs lets PostgreSQL replace outer Vars with PARAM_EXEC while
	 * ensuring ExecInitQual never sees the rendezvous function. */
	cscan->custom_exprs = lappend(cscan->custom_exprs,
		owned_mmsearch_exprs != NIL
			? copyObject(owned_mmsearch_exprs) : NIL);

	/*
	 * Freeze every result-affecting BioseqScan setting only after applying
	 * the primary mmsearch aligner_options override and the evaluated-target
	 * index rule.  Executor, EXPLAIN, and cache-provider consumers decode this
	 * payload; none of them reconstruct these values from live semantic GUCs.
	 */
	FrozenBioseqScanSemantics frozen_semantics{};
	frozen_semantics.params = build_params_from_gucs();
	bioseq::indexing::IndexReadRequirement planned_requirement =
		bioseq::indexing::IndexReadRequirement::allow;
	FuncExpr* primary_mmsearch = owned_mmsearch_exprs == NIL
		? nullptr
		: pg_node_try_as<FuncExpr>(
			reinterpret_cast<Node*>(linitial(owned_mmsearch_exprs)));
	(void)apply_aligner_options_override(
		primary_mmsearch,
		frozen_semantics.params,
		planned_requirement,
		get_cached_stub_oids());
	finalize_simd_chaining_policy(frozen_semantics.params);
	if (planner_owned_target_evaluated
		&& planned_requirement
			== bioseq::indexing::IndexReadRequirement::
				require_compatible_persisted) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("a transformed mmsearch operand cannot require a persisted target index"),
			 errhint("Use index_read_requirement=allow or require_absent; evaluated base-local operands run against their exact logical views.")));
	}
	frozen_semantics.index_read_requirement =
		planner_owned_target_evaluated
			? bioseq::indexing::IndexReadRequirement::require_absent
			: planned_requirement;
	frozen_semantics.read_sequence_index =
		bioseq::settings::read_sequence_index;
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_bioseq_semantic_payload(frozen_semantics));

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanPath_PlanCustomPath() returning");
	return reinterpret_cast<Plan *>(cscan);
}

[[nodiscard]] static int canonical_match_lineage_var_compare(
		const ListCell* left_cell, const ListCell* right_cell) noexcept {
	const Var* left = reinterpret_cast<const Var*>(lfirst(left_cell));
	const Var* right = reinterpret_cast<const Var*>(lfirst(right_cell));
	if (left->varno != right->varno) return left->varno < right->varno ? -1 : 1;
	if (left->varattno != right->varattno) {
		return left->varattno < right->varattno ? -1 : 1;
	}
	if (left->varlevelsup != right->varlevelsup) {
		return left->varlevelsup < right->varlevelsup ? -1 : 1;
	}
	if (left->vartypmod != right->vartypmod) {
		return left->vartypmod < right->vartypmod ? -1 : 1;
	}
	if (left->varcollid != right->varcollid) {
		return left->varcollid < right->varcollid ? -1 : 1;
	}
	return 0;
}

[[nodiscard]] static List* canonical_match_base_lineage(
		Node* target_recipe, const BioseqStubOids& oids) {
	if (target_recipe == nullptr) return NIL;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* variables = pull_var_clause(target_recipe, pull_flags);
	List* lineage = NIL;
	for (Var* variable : PList<Var>(variables)) {
		if (variable == nullptr
			|| variable->vartype != oids.bioseq_seq_type_oid
			|| !bioseq_is_concrete_rte_varno(variable->varno)
			|| variable->varattno <= 0 || variable->varlevelsup != 0
			|| !bms_is_empty(variable->varnullingrels)) continue;
		bool duplicate = false;
		for (Var* existing : PList<Var>(lineage)) {
			if (equal(existing, variable)) {
				duplicate = true;
				break;
			}
		}
		if (!duplicate) lineage = lappend(lineage, variable);
	}
	if (list_length(lineage) > 1) {
		list_sort(lineage, canonical_match_lineage_var_compare);
	}
	List* result = NIL;
	for (Var* entry : PList<Var>(lineage)) {
		result = lappend(result, copyObject(entry));
	}
	list_free(lineage);
	list_free(variables);
	return result;
}

[[nodiscard]] static List* make_match_owner_descriptor(
		Node* target_recipe, const Index legacy_target_relid,
		const BioseqStubOids& oids) {
	if (target_recipe == nullptr
		|| !bioseq_is_concrete_rte_varno(legacy_target_relid)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match owner descriptor input is invalid")));
	}
	List* descriptor = list_make5(
		makeInteger(kBioseqMatchOwnerDescriptorMagic),
		makeInteger(kBioseqMatchOwnerDescriptorVersion),
		makeInteger(0),
		copyObject(target_recipe),
		canonical_match_base_lineage(target_recipe, oids));
	return lappend(
		descriptor, makeInteger(static_cast<int>(legacy_target_relid)));
}

struct BatchJoinPlaceholderRegistration {
	const BioseqStubOids* oids = nullptr;
	Index target_relid = 0;
	AttrNumber target_sequence_attno = InvalidAttrNumber;
	Node* target_recipe = nullptr;
	List** combined_tlist = nullptr;
	List** encoded_sites = nullptr;
	bool invalid = false;
	bool edit_sequence_mismatch = false;
	/* Helper identities already supplied as MatchResult columns by a proven
	 * descendant BioseqBatchJoin.  An outer owner may pass these through, but
	 * must neither execute their SQL stubs nor relabel them as its own sites. */
	List* inherited_helper_identities = NIL;
};

[[nodiscard]] static bool batch_join_expression_has_match_helper(
		Node* expression,
		const BioseqStubOids& oids) {
	if (expression == nullptr) {
		return false;
	}
	BioseqFeatureDetector detector{&oids, BioseqScanFeatureFlags{}};
	feature_flag_visitor visitor;
	pg_walk_expression_including_root(expression, detector, visitor);
	return detector.flags.any_match_projection;
}

/* Multiple output expressions can contain the same current-owner helper, and
 * PlanCustomPath may append the same whole identity as a resjunk carrier.
 * One exact identity/phid pair is one MatchResult slot.  Reuse that slot while
 * keeping PHV and bare FuncExpr identities distinct. */
[[nodiscard]] static AttrNumber batch_join_find_same_owner_placeholder_site(
		Node* identity, FuncExpr* function, const Index phid,
		BatchJoinPlaceholderRegistration& registration) {
	if (identity == nullptr || function == nullptr
		|| registration.combined_tlist == nullptr
		|| registration.encoded_sites == nullptr) {
		registration.invalid = true;
		return InvalidAttrNumber;
	}
	AttrNumber result = InvalidAttrNumber;
	for (Node* encoded_node : PList<Node>(*registration.encoded_sites)) {
		if (encoded_node == nullptr || !IsA(encoded_node, List)) {
			registration.invalid = true;
			return InvalidAttrNumber;
		}
		List* encoded = reinterpret_cast<List*>(encoded_node);
		if (list_length(encoded) != kBioseqMatchHelperSiteFields) {
			registration.invalid = true;
			return InvalidAttrNumber;
		}
		auto integer_field = [encoded](const int index) -> Integer* {
			Node* node = reinterpret_cast<Node*>(list_nth(encoded, index));
			return node != nullptr && IsA(node, Integer)
				? reinterpret_cast<Integer*>(node) : nullptr;
		};
		Integer* resno_node = integer_field(kMatchSiteResno);
		Integer* funcid_node = integer_field(kMatchSiteFuncid);
		Integer* typmod_node = integer_field(kMatchSiteTypmod);
		Integer* collation_node = integer_field(kMatchSiteCollation);
		Integer* binding_node = integer_field(kMatchSiteBindingKind);
		Integer* phid_node = integer_field(kMatchSitePhid);
		Integer* stable_id_node = integer_field(kMatchSiteStableId);
		Node* argument = reinterpret_cast<Node*>(list_nth(
			encoded, kMatchSiteCanonicalArgument));
		if (resno_node == nullptr || funcid_node == nullptr
			|| typmod_node == nullptr || collation_node == nullptr
			|| binding_node == nullptr || phid_node == nullptr
			|| stable_id_node == nullptr || argument == nullptr) {
			registration.invalid = true;
			return InvalidAttrNumber;
		}
		const int encoded_resno = intVal(resno_node);
		TargetEntry* supplied = encoded_resno <= 0
			|| encoded_resno > list_length(*registration.combined_tlist)
			? nullptr : reinterpret_cast<TargetEntry*>(list_nth(
				*registration.combined_tlist, encoded_resno - 1));
		if (supplied == nullptr || supplied->resno != encoded_resno) {
			registration.invalid = true;
			return InvalidAttrNumber;
		}
		if (!equal(supplied->expr, identity)
			|| static_cast<Index>(intVal(phid_node)) != phid) continue;
		if (result != InvalidAttrNumber
			|| static_cast<Oid>(intVal(funcid_node)) != function->funcid
			|| intVal(typmod_node) != exprTypmod(identity)
			|| static_cast<Oid>(intVal(collation_node))
				!= exprCollation(identity)
			|| intVal(binding_node) != static_cast<int>(
				BioseqMatchHelperBindingKind::unresolved)
			|| !equal(argument, batch_join_match_helper_argument(function))
			|| intVal(stable_id_node) != 0) {
			registration.invalid = true;
			return InvalidAttrNumber;
		}
		result = static_cast<AttrNumber>(encoded_resno);
	}
	return result;
}

static void batch_join_register_placeholder_site(
		Node* identity,
		FuncExpr* function,
		const Index phid,
		BatchJoinPlaceholderRegistration& registration) {
	if (identity == nullptr || function == nullptr
		|| registration.combined_tlist == nullptr
		|| registration.encoded_sites == nullptr) {
		registration.invalid = true;
		return;
	}
	const Oid type_oid = exprType(identity);
	const int32 typmod = exprTypmod(identity);
	const Oid collation = exprCollation(identity);
	if (!OidIsValid(type_oid)
		|| type_oid != function->funcresulttype
		|| type_oid != get_func_rettype(function->funcid)) {
		registration.invalid = true;
		return;
	}
	const AttrNumber existing = batch_join_find_same_owner_placeholder_site(
		identity, function, phid, registration);
	if (registration.invalid || existing != InvalidAttrNumber) return;
	const AttrNumber resno = static_cast<AttrNumber>(
		list_length(*registration.combined_tlist) + 1);
	/* PostgreSQL fixes a parent Result/Projection before recursing into this
	 * child.  Therefore plan.targetlist must retain the original helper/PHV
	 * tree long enough for the parent to match the child's output identity.
	 * The same exact helper owner is a descriptor-only custom_scan_tlist
	 * column: this CustomScan's later setrefs pass maps it to INDEX_VAR, and
	 * BioseqBatchJoin fills the slot from MatchResult.  No executor evaluates
	 * the function stub.  Distinct PHV ids or FuncExpr identities receive
	 * distinct resnos even when their SQL result types are the same. */
	TargetEntry* scan_entry = makeTargetEntry(
		reinterpret_cast<Expr*>(copyObject(identity)),
		resno,
		nullptr,
		false);
	*registration.combined_tlist = lappend(
		*registration.combined_tlist, scan_entry);
	List* encoded = list_make5(
		makeInteger(resno),
		makeInteger(static_cast<int>(function->funcid)),
		makeInteger(typmod),
		makeInteger(static_cast<int>(collation)),
		makeInteger(static_cast<int>(
			BioseqMatchHelperBindingKind::unresolved)));
	encoded = lappend(encoded, copyObject(
		batch_join_match_helper_argument(function)));
	encoded = lappend(encoded, makeInteger(static_cast<int>(phid)));
	encoded = lappend(encoded, makeInteger(0));
	*registration.encoded_sites = lappend(
		*registration.encoded_sites, encoded);
}

/* A raw BatchJoin's locator child can already expose a whole helper as a
 * plan-only dummy target even when the callback tlist defers that helper to an
 * upper Result.  Make the existing target-child ordinal the MatchResult site;
 * adding a second scan column would leave the dummy leaf carrier unowned and
 * would give setrefs two spellings for one semantic result. */
static void batch_join_register_existing_placeholder_site(
		Node* identity,
		FuncExpr* function,
		const Index phid,
		const AttrNumber existing_resno,
		BatchJoinPlaceholderRegistration& registration) {
	if (identity == nullptr || function == nullptr || existing_resno <= 0
		|| registration.combined_tlist == nullptr
		|| registration.encoded_sites == nullptr
		|| existing_resno > list_length(*registration.combined_tlist)) {
		registration.invalid = true;
		return;
	}
	TargetEntry* supplied = reinterpret_cast<TargetEntry*>(list_nth(
		*registration.combined_tlist, existing_resno - 1));
	const Oid type_oid = exprType(identity);
	const int32 typmod = exprTypmod(identity);
	const Oid collation = exprCollation(identity);
	if (supplied == nullptr || supplied->resno != existing_resno
		|| !equal(supplied->expr, identity) || !OidIsValid(type_oid)
		|| type_oid != function->funcresulttype
		|| type_oid != get_func_rettype(function->funcid)) {
		registration.invalid = true;
		return;
	}
	const AttrNumber same_identity =
		batch_join_find_same_owner_placeholder_site(
			identity, function, phid, registration);
	if (registration.invalid || same_identity != InvalidAttrNumber) return;
	for (List* encoded : PList<List>(*registration.encoded_sites)) {
		Node* resno_node = encoded == nullptr
			|| !IsA(encoded, List)
			|| list_length(encoded) != kBioseqMatchHelperSiteFields
			? nullptr : reinterpret_cast<Node*>(list_nth(
				encoded, kMatchSiteResno));
		if (resno_node == nullptr || !IsA(resno_node, Integer)) {
			registration.invalid = true;
			return;
		}
		if (intVal(resno_node) == existing_resno) {
			registration.invalid = true;
			return;
		}
	}
	List* encoded = list_make5(
		makeInteger(existing_resno),
		makeInteger(static_cast<int>(function->funcid)),
		makeInteger(typmod),
		makeInteger(static_cast<int>(collation)),
		makeInteger(static_cast<int>(
			BioseqMatchHelperBindingKind::unresolved)));
	encoded = lappend(encoded, copyObject(
		batch_join_match_helper_argument(function)));
	encoded = lappend(encoded, makeInteger(static_cast<int>(phid)));
	encoded = lappend(encoded, makeInteger(0));
	*registration.encoded_sites = lappend(
		*registration.encoded_sites, encoded);
}

[[nodiscard]] static bool batch_join_identity_list_contains(
		List* identities, Node* identity) noexcept {
	if (identity == nullptr) return false;
	for (Node* inherited : PList<Node>(identities)) {
		if (inherited != nullptr && equal(inherited, identity)) return true;
	}
	return false;
}

[[nodiscard]] static bool batch_join_identity_is_inherited(
		BatchJoinPlaceholderRegistration const& registration,
		Node* identity) noexcept {
	return batch_join_identity_list_contains(
		registration.inherited_helper_identities, identity);
}

[[nodiscard]] static List* find_base_match_owner_plan_tag(
	CustomScan* scan);

/* Decode only finalized-plan-independent placeholder ownership.  The stable
 * id is deliberately still zero here: this proof runs in PlanCustomPath,
 * before the top-level planner hook assigns final plan_node_id bindings. */
[[nodiscard]] static bool batch_join_scan_owns_helper_identity(
		CustomScan* scan, Node* identity) noexcept {
	if (scan == nullptr || identity == nullptr || scan->methods == nullptr) {
		return false;
	}
	Node* sites_node = nullptr;
	List* supplied_tlist = NIL;
	if (scan->methods->CustomName != nullptr
		&& strcmp(scan->methods->CustomName, "BioseqBatchJoin") == 0
		&& scan->custom_private != NIL) {
		Node* version_node = reinterpret_cast<Node*>(
			linitial(scan->custom_private));
		if (version_node == nullptr || !IsA(version_node, Integer)) return false;
		const int version = intVal(version_node);
		const int sites_index = version == kBioseqBatchJoinPlanVersion
			? kBatchJoinPlaceholderSites
			: (version == kBioseqPerRowJoinPlanVersion
				? kPerRowPlaceholderSites : -1);
		if (sites_index < 0
			|| sites_index >= list_length(scan->custom_private)) return false;
		sites_node = reinterpret_cast<Node*>(list_nth(
			scan->custom_private, sites_index));
		supplied_tlist = scan->custom_scan_tlist;
	} else if (scan->methods == &BioseqColumnScanScanMethods) {
		List* owner_tag = find_base_match_owner_plan_tag(scan);
		if (owner_tag == NIL) return false;
		sites_node = reinterpret_cast<Node*>(list_nth(
			owner_tag, kBaseMatchPlanSites));
		supplied_tlist = scan->scan.plan.targetlist;
	} else {
		return false;
	}
	if (sites_node == nullptr) return false;
	if (!IsA(sites_node, List)) return false;
	for (List* encoded : PList<List>(reinterpret_cast<List*>(sites_node))) {
		if (encoded == nullptr || !IsA(encoded, List)
			|| list_length(encoded) != kBioseqMatchHelperSiteFields) continue;
		Node* resno_node = reinterpret_cast<Node*>(list_nth(
			encoded, kMatchSiteResno));
		if (resno_node == nullptr || !IsA(resno_node, Integer)) continue;
		const int resno = intVal(resno_node);
		TargetEntry* supplied = resno <= 0
			|| resno > list_length(supplied_tlist)
			? nullptr : reinterpret_cast<TargetEntry*>(list_nth(
				supplied_tlist, resno - 1));
		if (supplied != nullptr && supplied->resno == resno
			&& equal(supplied->expr, identity)) return true;
	}
	return false;
}

[[nodiscard]] static bool batch_join_descendant_owns_helper_identity(
		Plan* plan, Node* identity) {
	if (plan == nullptr || identity == nullptr) return false;
	check_stack_depth();
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		if (batch_join_scan_owns_helper_identity(custom, identity)) return true;
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			if (batch_join_descendant_owns_helper_identity(child, identity)) {
				return true;
			}
		}
		return false;
	}
	auto search_plan_list = [identity](List* plans) {
		for (Plan* child : PList<Plan>(plans)) {
			if (batch_join_descendant_owns_helper_identity(child, identity)) {
				return true;
			}
		}
		return false;
	};
	if (IsA(plan, Append)) {
		return search_plan_list(
			reinterpret_cast<Append*>(plan)->appendplans);
	}
	if (IsA(plan, MergeAppend)) {
		return search_plan_list(
			reinterpret_cast<MergeAppend*>(plan)->mergeplans);
	}
	if (IsA(plan, BitmapAnd)) {
		return search_plan_list(
			reinterpret_cast<BitmapAnd*>(plan)->bitmapplans);
	}
	if (IsA(plan, BitmapOr)) {
		return search_plan_list(
			reinterpret_cast<BitmapOr*>(plan)->bitmapplans);
	}
	if (IsA(plan, SubqueryScan)) {
		/* A SubqueryScan starts a distinct helper-binding scope.  Equal local
		 * expression spelling below it is not provenance for this owner. */
		return false;
	}
	return batch_join_descendant_owns_helper_identity(
			outerPlan(plan), identity)
		|| (innerPlan(plan) != outerPlan(plan)
			&& batch_join_descendant_owns_helper_identity(
				innerPlan(plan), identity));
}

[[nodiscard]] static List* batch_join_proven_inherited_helper_identities(
		Plan* child_plan, const BioseqStubOids& oids) {
	List* result = NIL;
	if (child_plan == nullptr) return result;
	for (TargetEntry* entry : PList<TargetEntry>(child_plan->targetlist)) {
		Node* identity = entry == nullptr
			? nullptr : reinterpret_cast<Node*>(entry->expr);
		if (identity == nullptr
			|| !batch_join_expression_has_match_helper(identity, oids)
			|| !batch_join_descendant_owns_helper_identity(
				child_plan, identity)) continue;
		bool duplicate = false;
		for (Node* existing : PList<Node>(result)) {
			if (equal(existing, identity)) {
				duplicate = true;
				break;
			}
		}
		if (!duplicate) result = lappend(result, copyObject(identity));
	}
	return result;
}

struct batch_join_placeholder_registration_visitor {
	[[nodiscard]] pg_walk_step operator()(
		pg_expression_walk_cursor,
		pg_node_view node,
		BatchJoinPlaceholderRegistration& registration) const {
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			FuncExpr* helper = registration.oids == nullptr ? nullptr
				: batch_join_match_helper_phv_function(
					placeholder, *registration.oids);
			if (helper != nullptr) {
				if (batch_join_identity_is_inherited(
						registration,
						reinterpret_cast<Node*>(placeholder))) {
					return pg_walk_step::skip_subtree;
				}
				if (!edit_sequence_argument_matches_recipe(
						helper,
						registration.target_recipe,
						registration.target_relid,
						registration.target_sequence_attno,
						*registration.oids)) {
					registration.invalid = true;
					registration.edit_sequence_mismatch = true;
					return pg_walk_step::stop;
				}
				const bool names_recipe =
					batch_join_match_helper_names_recipe(
						helper, registration.target_recipe);
				const bool legacy_lineage =
					batch_join_match_helper_names_base_lineage(
						helper, registration.target_recipe,
						*registration.oids);
				if (!names_recipe && !legacy_lineage) {
					registration.invalid = true;
					return pg_walk_step::stop;
				}
				batch_join_register_placeholder_site(
					reinterpret_cast<Node*>(placeholder), helper,
					placeholder->phid, registration);
				return registration.invalid
					? pg_walk_step::stop : pg_walk_step::skip_subtree;
			}
			/* A generic PHV containing a helper has evaluation/nulling semantics
			 * that this join cannot reproduce.  Do not descend and accidentally
			 * register only the inner FuncExpr. */
			if (registration.oids != nullptr
				&& batch_join_expression_has_match_helper(
					reinterpret_cast<Node*>(placeholder->phexpr),
					*registration.oids)) {
				registration.invalid = true;
				return pg_walk_step::stop;
			}
			return pg_walk_step::descend;
		}
		if (FuncExpr* function = node.try_as<FuncExpr>()) {
			if (registration.oids != nullptr
				&& is_bioseq_projection_funcid(
					function->funcid, *registration.oids)) {
				if (batch_join_identity_is_inherited(
						registration,
						reinterpret_cast<Node*>(function))) {
					return pg_walk_step::skip_subtree;
				}
				if (!edit_sequence_argument_matches_recipe(
						function,
						registration.target_recipe,
						registration.target_relid,
						registration.target_sequence_attno,
						*registration.oids)) {
					registration.invalid = true;
					registration.edit_sequence_mismatch = true;
					return pg_walk_step::stop;
				}
				const bool names_recipe =
					batch_join_match_helper_names_recipe(
						function, registration.target_recipe);
				const bool legacy_lineage =
					batch_join_match_helper_names_base_lineage(
						function, registration.target_recipe,
						*registration.oids);
				if (!names_recipe && !legacy_lineage) {
					registration.invalid = true;
					return pg_walk_step::stop;
				}
				batch_join_register_placeholder_site(
					reinterpret_cast<Node*>(function), function,
					0, registration);
				return registration.invalid
					? pg_walk_step::stop : pg_walk_step::skip_subtree;
			}
		}
		return pg_walk_step::descend;
	}
};

struct BatchJoinOutputSetrefsRewrite {
	List* scan_tlist = NIL;
	const BioseqStubOids* oids = nullptr;
	AttrNumber current_site_first_resno = 1;
	List* inherited_helper_identities = NIL;
	bool invalid = false;
};

[[nodiscard]] static TargetEntry* batch_join_find_exact_scan_entry(
		List* scan_tlist, const Node* expression,
		const AttrNumber minimum_resno = 1,
		const AttrNumber maximum_resno = MaxAttrNumber) noexcept {
	if (expression == nullptr) return nullptr;
	/* New sites are appended after inherited child columns.  Search backwards
	 * within the caller's proven range so an outer owner binds the site it just
	 * registered, never the first equal identity inherited from a descendant. */
	for (int index = list_length(scan_tlist) - 1; index >= 0; --index) {
		TargetEntry* entry = reinterpret_cast<TargetEntry*>(
			list_nth(scan_tlist, index));
		if (entry != nullptr && entry->resno >= minimum_resno
			&& entry->resno <= maximum_resno
			&& equal(entry->expr, expression)) return entry;
	}
	return nullptr;
}

[[nodiscard]] static TargetEntry*
batch_join_find_unique_semantic_helper_entry(
		List* scan_tlist, Node* identity, const BioseqStubOids& oids,
		const AttrNumber minimum_resno, const AttrNumber maximum_resno,
		bool& ambiguous) noexcept {
	ambiguous = false;
	FuncExpr* expected = per_row_helper_identity_function(identity, oids);
	if (expected == nullptr) return nullptr;
	TargetEntry* result = nullptr;
	for (TargetEntry* entry : PList<TargetEntry>(scan_tlist)) {
		if (entry == nullptr || entry->expr == nullptr
			|| entry->resno < minimum_resno || entry->resno > maximum_resno) {
			continue;
		}
		Node* supplied_identity = reinterpret_cast<Node*>(entry->expr);
		FuncExpr* supplied = per_row_helper_identity_function(
			supplied_identity, oids);
		if (supplied == nullptr || !equal(supplied, expected)
			|| exprType(supplied_identity) != exprType(identity)
			|| exprTypmod(supplied_identity) != exprTypmod(identity)
			|| exprCollation(supplied_identity) != exprCollation(identity)) {
			continue;
		}
		if (result != nullptr) {
			ambiguous = true;
			return nullptr;
		}
		result = entry;
	}
	return result;
}

[[nodiscard]] static TargetEntry* batch_join_find_compatible_var_entry(
		List* scan_tlist, const Var* var) noexcept {
	if (var == nullptr) return nullptr;
	for (TargetEntry* entry : PList<TargetEntry>(scan_tlist)) {
		Var* supplied = entry == nullptr
			? nullptr
			: pg_node_try_as<Var>(reinterpret_cast<Node*>(entry->expr));
		if (supplied != nullptr
			&& supplied->varno == var->varno
			&& supplied->varattno == var->varattno
			&& supplied->varlevelsup == var->varlevelsup
			&& supplied->vartype == var->vartype
			&& supplied->vartypmod == var->vartypmod
			&& supplied->varcollid == var->varcollid
			&& bms_equal(supplied->varnullingrels, var->varnullingrels)) {
			return entry;
		}
	}
	return nullptr;
}

/* CustomScan setrefs resolves output Vars against the unfixed scan tlist.
 * Normalize harmless base-Var spelling deltas, but preserve the exact raw
 * helper/PHV identity in both lists.  Upper setrefs fixes a parent before it
 * recurses into this child, so hiding that identity here makes Sort/Result
 * fail to bind the whole helper expression.  PostgreSQL's normal CustomScan
 * setrefs pass then maps those identities to INDEX_VAR against
 * custom_scan_tlist before executor initialization. */
struct batch_join_output_setrefs_rewrite_mutator {
	[[nodiscard]] pg_node_mutation operator()(
			pg_expression_mutation_cursor,
			pg_node_view node,
			BatchJoinOutputSetrefsRewrite& rewrite) const {
		if (Var* var = node.try_as<Var>()) {
			if (var->varno == INDEX_VAR || var->varno == OUTER_VAR
				|| var->varno == INNER_VAR) {
				return pg_node_mutation::with(
					reinterpret_cast<Node*>(copyObject(var)));
			}
			TargetEntry* entry = batch_join_find_exact_scan_entry(
				rewrite.scan_tlist, reinterpret_cast<Node*>(var));
			if (entry == nullptr) entry = batch_join_find_compatible_var_entry(
				rewrite.scan_tlist, var);
			if (entry == nullptr) {
				rewrite.invalid = true;
				return pg_node_mutation::with(
					reinterpret_cast<Node*>(copyObject(var)));
			}
			return pg_node_mutation::with(
				reinterpret_cast<Node*>(copyObject(entry->expr)));
		}

		bool helper_identity = false;
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			helper_identity = rewrite.oids != nullptr
				&& batch_join_expression_has_match_helper(
					reinterpret_cast<Node*>(placeholder->phexpr),
					*rewrite.oids);
		} else if (FuncExpr* function = node.try_as<FuncExpr>()) {
			helper_identity = rewrite.oids != nullptr
				&& is_bioseq_projection_funcid(
					function->funcid, *rewrite.oids);
		}
		if (!helper_identity) return pg_node_mutation::descend();

		const bool inherited = batch_join_identity_list_contains(
			rewrite.inherited_helper_identities, node.raw());
		TargetEntry* entry = inherited
			? batch_join_find_exact_scan_entry(
				rewrite.scan_tlist, node.raw(), 1,
				static_cast<AttrNumber>(
					rewrite.current_site_first_resno - 1))
			: batch_join_find_exact_scan_entry(
				rewrite.scan_tlist, node.raw(),
				rewrite.current_site_first_resno);
		if (entry == nullptr && inherited && rewrite.oids != nullptr) {
			bool ambiguous = false;
			entry = batch_join_find_unique_semantic_helper_entry(
				rewrite.scan_tlist, node.raw(), *rewrite.oids, 1,
				static_cast<AttrNumber>(
					rewrite.current_site_first_resno - 1), ambiguous);
			if (ambiguous) rewrite.invalid = true;
		}
		if (entry == nullptr || entry->resno <= 0) {
			rewrite.invalid = true;
			return pg_node_mutation::with(
				reinterpret_cast<Node*>(copyObject(node.raw())));
		}
		return pg_node_mutation::with(
			reinterpret_cast<Node*>(copyObject(entry->expr)));
	}
};

[[nodiscard]] static Expr* batch_join_rewrite_output_for_setrefs(
		Expr* expression, List* scan_tlist,
		const BioseqStubOids& oids,
		const AttrNumber current_site_first_resno,
		List* inherited_helper_identities) {
	BatchJoinOutputSetrefsRewrite rewrite{
		scan_tlist, &oids, current_site_first_resno,
		inherited_helper_identities, false};
	batch_join_output_setrefs_rewrite_mutator mutator;
	Expr* result = reinterpret_cast<Expr*>(pg_mutate_expression(
		reinterpret_cast<Node*>(expression), rewrite, mutator));
	if (rewrite.invalid) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin output cannot be bound to its scan tuple")));
	}
	return result;
}

[[nodiscard]] static AttrNumber find_plan_tlist_expression_resno(
		List* targetlist, const void* expression) noexcept {
	for (TargetEntry* entry : PList<TargetEntry>(targetlist)) {
		if (entry != nullptr && equal(entry->expr, expression)) {
			return entry->resno;
		}
	}
	return InvalidAttrNumber;
}

struct BatchJoinSetrefsCoverage {
	List* scan_tlist = NIL;
	const BioseqStubOids* oids = nullptr;
	Var* missing_var = nullptr;
	Node* missing_helper_identity = nullptr;
};

/* Mirror the relevant fix_upper_expr() lookup order before PostgreSQL's final
 * setrefs pass.  A CustomScan with scanrelid == 0 must make every output Var
 * discoverable in custom_scan_tlist; diagnosing that invariant here preserves
 * the exact offending varno/attno instead of reducing it to PostgreSQL's
 * generic "variable not found in subplan target list" error. */
struct batch_join_setrefs_coverage_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor,
			pg_node_view node,
			BatchJoinSetrefsCoverage& coverage) const {
		if (Var* var = node.try_as<Var>()) {
			for (TargetEntry* entry : PList<TargetEntry>(coverage.scan_tlist)) {
				Var* supplied = entry == nullptr
					? nullptr
					: pg_node_try_as<Var>(
						reinterpret_cast<Node*>(entry->expr));
				if (supplied != nullptr
					&& supplied->varno == var->varno
					&& supplied->varattno == var->varattno
					&& bms_equal(
						supplied->varnullingrels, var->varnullingrels)) {
					return pg_walk_step::skip_subtree;
				}
			}
			coverage.missing_var = var;
			return pg_walk_step::stop;
		}
		if (PlaceHolderVar* placeholder = node.try_as<PlaceHolderVar>()) {
			for (TargetEntry* entry : PList<TargetEntry>(coverage.scan_tlist)) {
				if (entry != nullptr && IsA(entry->expr, PlaceHolderVar)
					&& equal(entry->expr, placeholder)) {
					return pg_walk_step::skip_subtree;
				}
			}
			if (coverage.oids != nullptr
				&& batch_join_expression_has_match_helper(
					reinterpret_cast<Node*>(placeholder->phexpr),
					*coverage.oids)) {
				coverage.missing_helper_identity =
					reinterpret_cast<Node*>(placeholder);
				return pg_walk_step::stop;
			}
			return pg_walk_step::descend;
		}
		for (TargetEntry* entry : PList<TargetEntry>(coverage.scan_tlist)) {
			if (entry != nullptr && entry->expr != nullptr
				&& !IsA(entry->expr, Var)
				&& !IsA(entry->expr, PlaceHolderVar)
				&& equal(entry->expr, node.raw())) {
				return pg_walk_step::skip_subtree;
			}
		}
		if (FuncExpr* function = node.try_as<FuncExpr>();
			coverage.oids != nullptr && function != nullptr
			&& is_bioseq_projection_funcid(
				function->funcid, *coverage.oids)) {
			coverage.missing_helper_identity =
				reinterpret_cast<Node*>(function);
			return pg_walk_step::stop;
		}
		return pg_walk_step::descend;
	}
};

static void validate_batch_join_setrefs_coverage(
		List* output_tlist, List* scan_tlist) {
	const BioseqStubOids& oids = get_cached_stub_oids();
	BatchJoinSetrefsCoverage coverage{
		scan_tlist, &oids, nullptr, nullptr};
	batch_join_setrefs_coverage_visitor visitor;
	for (TargetEntry* output : PList<TargetEntry>(output_tlist)) {
		if (output == nullptr || output->expr == nullptr) {
			continue;
		}
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(output->expr), coverage, visitor);
		if (coverage.missing_helper_identity != nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin helper identity is absent from scan tuple"),
				 errdetail(
					"node_type=%d scan_columns=%d; executing the SQL helper stub is forbidden",
					static_cast<int>(nodeTag(
						coverage.missing_helper_identity)),
					list_length(scan_tlist))));
		}
		if (coverage.missing_var != nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin output variable is absent from scan tuple"),
				 errdetail(
					"varno=%u attno=%d type=%u typmod=%d scan_columns=%d",
					coverage.missing_var->varno,
					coverage.missing_var->varattno,
					coverage.missing_var->vartype,
					coverage.missing_var->vartypmod,
					list_length(scan_tlist))));
		}
	}
}

/* The same helper is commonly represented by a positive-id PHV in the
 * processed target and by its stripped FuncExpr in a non-projecting locator
 * child.  Preserve the authoritative PHV id in the site codec when present;
 * finalized binding then accepts only that exact PHV-to-bare transition. */
[[nodiscard]] static bool batch_join_plan_only_helper_phid(
		List* authoritative_identities, Node* carrier_identity,
		FuncExpr* carrier_helper, const BioseqStubOids& oids,
		Index& phid) noexcept {
	if (carrier_identity == nullptr || carrier_helper == nullptr) return false;
	bool matched = false;
	Index positive_phid = 0;
	for (Node* identity : PList<Node>(authoritative_identities)) {
		FuncExpr* helper = per_row_helper_identity_function(identity, oids);
		if (helper == nullptr || !equal(helper, carrier_helper)) continue;
		matched = true;
		PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
		if (placeholder == nullptr) continue;
		if (placeholder->phid == 0
			|| (positive_phid != 0 && positive_phid != placeholder->phid)) {
			return false;
		}
		positive_phid = placeholder->phid;
	}
	PlaceHolderVar* carrier = pg_node_try_as<PlaceHolderVar>(carrier_identity);
	if (positive_phid != 0) {
		phid = positive_phid;
		return true;
	}
	if (carrier != nullptr) {
		if (carrier->phid == 0) return false;
		phid = carrier->phid;
		return true;
	}
	phid = 0;
	return matched || equal(carrier_identity, carrier_helper);
}

static Plan*
BioseqBatchJoin_PlanCustomPath(
		PlannerInfo* root,
		RelOptInfo* rel,
		CustomPath* best_path,
		List* tlist,
		List* clauses,
		List* custom_plans) {
	if (root == nullptr || rel == nullptr || best_path == nullptr
		|| list_length(custom_plans) != 2
		|| list_length(best_path->custom_private)
			!= kBioseqBatchJoinPathPrivateFields) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin planner state is incomplete")));
	}
	const int version = intVal(list_nth(best_path->custom_private, 0));
	const int token = intVal(list_nth(best_path->custom_private, 1));
	const Oid target_relation_oid = static_cast<Oid>(
		intVal(list_nth(best_path->custom_private, 2)));
	const AttrNumber target_storage_seq_attno = static_cast<AttrNumber>(
		intVal(list_nth(best_path->custom_private, 3)));
	Var* target_var = pg_node_try_as<Var>(reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 4)));
	Var* query_var = pg_node_try_as<Var>(reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 5)));
	const int alphabet_code = intVal(list_nth(best_path->custom_private, 6));
	const int storage_unit_byte_width =
		intVal(list_nth(best_path->custom_private, 7));
	Node* mmsearch_node = reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 8));
	FuncExpr* mmsearch = pg_node_try_as<FuncExpr>(mmsearch_node);
	const BioseqStubOids& oids = get_cached_stub_oids();
	const int mmsearch_arity = mmsearch == nullptr
		? 0 : list_length(mmsearch->args);
	Node* private_target_operand = mmsearch_arity >= 1
		? reinterpret_cast<Node*>(linitial(mmsearch->args)) : nullptr;
	Node* private_query_operand = mmsearch_arity >= 2
		? reinterpret_cast<Node*>(lsecond(mmsearch->args)) : nullptr;
	Const* private_options = mmsearch_arity == 3
		? pg_node_try_as<Const>(reinterpret_cast<Node*>(
			list_nth(mmsearch->args, 2)))
		: nullptr;
	const bool private_mmsearch_recipe_valid =
		version == kBioseqBatchJoinPlanVersion
		&& mmsearch != nullptr
		&& count_mmsearch_occurrences(mmsearch_node, oids) == 1u
		&& ((mmsearch->funcid == oids.mmsearch_oid
				&& mmsearch_arity == 2)
			|| (mmsearch->funcid == oids.mmsearch_with_opts_oid
				&& mmsearch_arity == 3 && private_options != nullptr
				&& private_options->consttype
					== oids.bioseq_aligner_options_type_oid))
		&& private_target_operand != nullptr
		&& private_query_operand != nullptr
		&& equal(private_target_operand, target_var)
		&& equal(private_query_operand, query_var);
	const int index_read_requirement = intVal(
		list_nth(best_path->custom_private, 9));
	const Cost honest_startup_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(
			list_nth(best_path->custom_private, 10)),
		"honest_startup_cost");
	const Cost honest_total_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(
			list_nth(best_path->custom_private, 11)),
		"honest_total_cost");
	const Cost incumbent_cost_floor = batch_join_cost_from_node(
		reinterpret_cast<Node*>(
			list_nth(best_path->custom_private, 12)),
		"incumbent_cost_floor");
	if (version != kBioseqBatchJoinPlanVersion || token <= 0
		|| target_var == nullptr || query_var == nullptr
		|| !private_mmsearch_recipe_valid
		|| !bioseq::indexing::index_read_requirement_ordinal_valid(
			index_read_requirement)
		|| !batch_join_typmod_is_supported(target_var->vartypmod)
		|| !batch_join_typmod_is_supported(query_var->vartypmod)
		|| !mmsearch_typmods_share_alphabet(
			target_var->vartypmod, query_var->vartypmod)
		|| target_var->varcollid != query_var->varcollid) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin private plan ABI is invalid")));
	}
	Plan* target_plan = reinterpret_cast<Plan*>(linitial(custom_plans));
	Plan* query_plan = reinterpret_cast<Plan*>(lsecond(custom_plans));
	if (target_plan == nullptr || query_plan == nullptr
		|| !IsA(target_plan, CustomScan)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin target child is not a custom scan")));
	}
	auto* target_custom = reinterpret_cast<CustomScan*>(target_plan);
	if (target_custom->methods != &BioseqColumnScanScanMethods
		|| target_custom->scan.scanrelid != target_var->varno) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin target child lacks locator ownership")));
	}
	List* locator_tag = nullptr;
	for (Node* raw_tag : PList<Node>(target_custom->custom_private)) {
		if (raw_tag == nullptr || !IsA(raw_tag, List)) continue;
		List* candidate = reinterpret_cast<List*>(raw_tag);
		if (list_length(candidate) != 4
			|| !IsA(reinterpret_cast<Node*>(linitial(candidate)), Integer)
			|| intVal(linitial(candidate))
				!= kBioseqLocatorPassthroughMagic) continue;
		if (locator_tag != nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin target has duplicate locator ownership")));
		}
		locator_tag = candidate;
	}
	if (locator_tag == nullptr || !IsA(locator_tag, List)
		|| list_length(locator_tag) != 4
		|| intVal(list_nth(locator_tag, 0))
			!= kBioseqLocatorPassthroughMagic
		|| intVal(list_nth(locator_tag, 1))
			!= kBioseqBatchJoinPlanVersion
		|| intVal(list_nth(locator_tag, 2)) != token) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin locator tag/token validation failed")));
	}

	const AttrNumber target_slot_seq_resno =
		find_plan_tlist_expression_resno(target_plan->targetlist, target_var);
	const AttrNumber query_slot_seq_resno =
		find_plan_tlist_expression_resno(query_plan->targetlist, query_var);
	const AttrNumber target_slot_rowno_resno = static_cast<AttrNumber>(
		intVal(list_nth(locator_tag, 3)));
	if (target_slot_seq_resno <= 0 || query_slot_seq_resno <= 0
		|| target_slot_rowno_resno <= 0
		|| target_slot_rowno_resno > list_length(target_plan->targetlist)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin child projection resnos are invalid")));
	}
	TargetEntry* target_seq_entry = reinterpret_cast<TargetEntry*>(
		list_nth(target_plan->targetlist, target_slot_seq_resno - 1));
	TargetEntry* query_seq_entry = reinterpret_cast<TargetEntry*>(
		list_nth(query_plan->targetlist, query_slot_seq_resno - 1));
	TargetEntry* rowno_entry = reinterpret_cast<TargetEntry*>(
		list_nth(target_plan->targetlist, target_slot_rowno_resno - 1));
	if (target_seq_entry == nullptr || query_seq_entry == nullptr
		|| rowno_entry == nullptr || !rowno_entry->resjunk
		|| target_seq_entry->resno != target_slot_seq_resno
		|| query_seq_entry->resno != query_slot_seq_resno
		|| rowno_entry->resno != target_slot_rowno_resno
		|| exprType(reinterpret_cast<Node*>(rowno_entry->expr)) != INT8OID
		|| exprTypmod(reinterpret_cast<Node*>(rowno_entry->expr)) != -1
		|| OidIsValid(exprCollation(reinterpret_cast<Node*>(rowno_entry->expr)))
		|| exprType(reinterpret_cast<Node*>(target_seq_entry->expr))
			!= get_cached_stub_oids().bioseq_seq_type_oid
		|| exprType(reinterpret_cast<Node*>(query_seq_entry->expr))
			!= get_cached_stub_oids().bioseq_seq_type_oid
		|| exprTypmod(reinterpret_cast<Node*>(target_seq_entry->expr))
			!= target_var->vartypmod
		|| exprTypmod(reinterpret_cast<Node*>(query_seq_entry->expr))
			!= query_var->vartypmod
		|| exprCollation(reinterpret_cast<Node*>(target_seq_entry->expr))
			!= target_var->varcollid
		|| exprCollation(reinterpret_cast<Node*>(query_seq_entry->expr))
			!= query_var->varcollid) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("BioseqBatchJoin child sequence/row-number ABI is invalid")));
	}

	List* combined_tlist = NIL;
	for (TargetEntry* source : PList<TargetEntry>(target_plan->targetlist)) {
		TargetEntry* copied = static_cast<TargetEntry*>(copyObject(source));
		copied->resno = static_cast<AttrNumber>(list_length(combined_tlist) + 1);
		combined_tlist = lappend(combined_tlist, copied);
	}
	const int target_column_count = list_length(combined_tlist);
	for (TargetEntry* source : PList<TargetEntry>(query_plan->targetlist)) {
		TargetEntry* copied = static_cast<TargetEntry*>(copyObject(source));
		copied->resno = static_cast<AttrNumber>(list_length(combined_tlist) + 1);
		combined_tlist = lappend(combined_tlist, copied);
	}
	const int query_column_count =
		list_length(combined_tlist) - target_column_count;
	const AttrNumber current_site_first_resno = static_cast<AttrNumber>(
		list_length(combined_tlist) + 1);

	List* placeholder_sites = NIL;
	List* existing_helper_identities = NIL;
	List* existing_helper_functions = NIL;
	PerRowOwnerSupportProof plan_only_owner_support{};
	if (!per_row_collect_owner_support(
			root, rel, target_var->varno,
			reinterpret_cast<Node*>(target_var),
			plan_only_owner_support)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqBatchJoin plan-only helper support is invalid")));
	}
	for (int index = 0; index < target_column_count; ++index) {
		TargetEntry* carrier_entry = reinterpret_cast<TargetEntry*>(list_nth(
			combined_tlist, index));
		Node* carrier_identity = carrier_entry == nullptr ? nullptr
			: reinterpret_cast<Node*>(carrier_entry->expr);
		PlaceHolderVar* carrier_placeholder =
			pg_node_try_as<PlaceHolderVar>(carrier_identity);
		FuncExpr* carrier_helper = carrier_placeholder == nullptr
			? batch_join_well_formed_match_helper(carrier_identity, oids)
			: batch_join_match_helper_phv_function(
				carrier_placeholder, oids);
		if (carrier_helper == nullptr) {
			if (batch_join_expression_has_match_helper(carrier_identity, oids)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqBatchJoin locator helper carrier is not a whole identity"),
					 errdetail("target_resno=%d", index + 1)));
			}
			continue;
		}
		const bool names_recipe = batch_join_match_helper_names_recipe(
			carrier_helper, reinterpret_cast<Node*>(target_var));
		const bool names_lineage =
			batch_join_match_helper_names_base_lineage(
				carrier_helper, reinterpret_cast<Node*>(target_var), oids);
		if (!names_recipe && !names_lineage) continue;
		if (carrier_entry->resno == target_slot_seq_resno
			|| carrier_entry->resno == target_slot_rowno_resno) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin helper reuses an operand carrier"),
				 errdetail("target_resno=%d", carrier_entry->resno)));
		}
		for (FuncExpr* existing_helper : PList<FuncExpr>(
				existing_helper_functions)) {
			if (existing_helper != nullptr
				&& equal(existing_helper, carrier_helper)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqBatchJoin locator has duplicate helper carriers"),
					 errdetail("target_resno=%d", carrier_entry->resno)));
			}
		}
		existing_helper_functions = lappend(
			existing_helper_functions, copyObject(carrier_helper));
		if (!edit_sequence_argument_matches_recipe(
				carrier_helper, reinterpret_cast<Node*>(target_var),
				target_var->varno, target_storage_seq_attno, oids)) {
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("bioseq.edit projection must reference the mmsearch target column")));
		}
		if (find_base_match_owner_plan_tag(target_custom) != NIL
			|| batch_join_scan_owns_helper_identity(
				target_custom, carrier_identity)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin locator retained leaf helper ownership"),
				 errdetail("target_resno=%d", carrier_entry->resno)));
		}
		Index phid = 0;
		if (!batch_join_plan_only_helper_phid(
				plan_only_owner_support.helper_identities,
				carrier_identity, carrier_helper, oids, phid)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin plan-only helper identity is ambiguous"),
				 errdetail("target_resno=%d", carrier_entry->resno)));
		}
		per_row_append_unique_expression(
			existing_helper_identities, carrier_identity);
		for (Node* authoritative : PList<Node>(
				plan_only_owner_support.helper_identities)) {
			FuncExpr* authoritative_helper =
				per_row_helper_identity_function(authoritative, oids);
			if (authoritative_helper != nullptr
				&& equal(authoritative_helper, carrier_helper)) {
				per_row_append_unique_expression(
					existing_helper_identities, authoritative);
			}
		}
		BatchJoinPlaceholderRegistration registration{
			&oids, target_var->varno, target_storage_seq_attno,
			reinterpret_cast<Node*>(target_var), &combined_tlist,
			&placeholder_sites, false, false, NIL};
		const int site_count_before = list_length(placeholder_sites);
		batch_join_register_existing_placeholder_site(
			carrier_identity, carrier_helper, phid,
			carrier_entry->resno, registration);
		const AttrNumber registered =
			batch_join_find_same_owner_placeholder_site(
				carrier_identity, carrier_helper, phid, registration);
		if (registration.invalid || registered != carrier_entry->resno
			|| list_length(placeholder_sites) != site_count_before + 1) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin existing helper site registration failed"),
				 errdetail("target_resno=%d registered_resno=%d",
					carrier_entry->resno, registered)));
		}
	}
	List* requested_tlist = list_copy(tlist);
	for (Node* identity : PList<Node>(
			plan_only_owner_support.helper_identities)) {
		FuncExpr* helper = per_row_helper_identity_function(identity, oids);
		if (helper == nullptr) continue;
		const bool names_recipe = batch_join_match_helper_names_recipe(
			helper, reinterpret_cast<Node*>(target_var));
		const bool names_lineage = batch_join_match_helper_names_base_lineage(
			helper, reinterpret_cast<Node*>(target_var), oids);
		if (!names_recipe && !names_lineage) continue;
		if (!edit_sequence_argument_matches_recipe(
				helper, reinterpret_cast<Node*>(target_var),
				target_var->varno, target_storage_seq_attno, oids)) {
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("bioseq.edit projection must reference the mmsearch target column")));
		}
		if (find_plan_tlist_expression_resno(requested_tlist, identity) > 0) {
			continue;
		}
		/* The callback tlist already carries whole helper dependencies for an
		 * upper compound Result, while processed_tlist may retain the same helper
		 * inside its authoritative PHV.  Wrapper inequality alone must not append
		 * a second executor site: unwrap both identities and reuse only one unique,
		 * exact function/argument/type match whose authoritative PHV group has one
		 * non-conflicting provenance id.  No match, an ambiguous match, or conflicting
		 * positive phids keeps the authoritative identity as its own resjunk carrier. */
		bool semantic_match_ambiguous = false;
		TargetEntry* semantic_match =
			batch_join_find_unique_semantic_helper_entry(
				requested_tlist, identity, oids,
				/*minimum_resno=*/1,
				/*maximum_resno=*/MaxAttrNumber,
				semantic_match_ambiguous);
		FuncExpr* semantic_match_helper = semantic_match == nullptr
			? nullptr : per_row_helper_identity_function(
				reinterpret_cast<Node*>(semantic_match->expr), oids);
		Index authoritative_phid = 0;
		const bool authoritative_group_unambiguous =
			semantic_match_helper != nullptr
			&& batch_join_plan_only_helper_phid(
				plan_only_owner_support.helper_identities,
				reinterpret_cast<Node*>(semantic_match->expr),
				semantic_match_helper, oids, authoritative_phid);
		PlaceHolderVar* semantic_match_phv = semantic_match == nullptr
			? nullptr : pg_node_try_as<PlaceHolderVar>(
				reinterpret_cast<Node*>(semantic_match->expr));
		const bool carrier_phid_agrees = semantic_match_phv == nullptr
			|| semantic_match_phv->phid == authoritative_phid;
		if (semantic_match != nullptr && !semantic_match_ambiguous
			&& authoritative_group_unambiguous && carrier_phid_agrees) {
			continue;
		}
		requested_tlist = lappend(requested_tlist, makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(identity)),
			static_cast<AttrNumber>(list_length(requested_tlist) + 1),
			nullptr, /*resjunk=*/true));
	}
	List* output_tlist = NIL;
	for (TargetEntry* output : PList<TargetEntry>(requested_tlist)) {
		if (output == nullptr) {
			continue;
		}
		TargetEntry* copied = static_cast<TargetEntry*>(copyObject(output));
		BatchJoinPlaceholderRegistration registration{
			&oids,
			target_var->varno,
			target_storage_seq_attno,
			reinterpret_cast<Node*>(target_var),
			&combined_tlist,
			&placeholder_sites,
			false,
			false,
			existing_helper_identities};
		batch_join_placeholder_registration_visitor visitor;
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(copied->expr), registration, visitor);
		if (registration.edit_sequence_mismatch) {
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("bioseq.edit projection must reference the mmsearch target column")));
		}
		if (registration.invalid) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin match helper identity is invalid"),
				 errdetail(
					"only exact target-owned FuncExpr or PlaceHolderVar helper sites are supported")));
		}
		copied->expr = batch_join_rewrite_output_for_setrefs(
			copied->expr, combined_tlist, oids,
			current_site_first_resno, existing_helper_identities);
		output_tlist = lappend(output_tlist, copied);
	}
	validate_batch_join_setrefs_coverage(
		output_tlist, combined_tlist);

	auto* cscan = makeNode(CustomScan);
	cscan->methods = &BioseqBatchJoinScanMethods;
	cscan->flags = best_path->flags;
	cscan->scan.scanrelid = 0;
	/* Keep the pre-setrefs output expression identities intact.  PostgreSQL
	 * fixes any upper Result/Projection against this child targetlist before
	 * it recurses and maps this CustomScan against custom_scan_tlist. */
	cscan->scan.plan.targetlist = output_tlist;
	PList<RestrictInfo> executable_join_restrictions;
	std::size_t removed_mmsearch_occurrences = 0u;
	for (RestrictInfo* candidate : PList<RestrictInfo>(clauses)) {
		const std::size_t occurrences = candidate == nullptr
			? 0u : count_mmsearch_occurrences(
				reinterpret_cast<Node*>(candidate->clause), oids);
		if (occurrences != 0u) {
			removed_mmsearch_occurrences = occurrences
				> std::numeric_limits<std::size_t>::max()
					- removed_mmsearch_occurrences
				? std::numeric_limits<std::size_t>::max()
				: removed_mmsearch_occurrences + occurrences;
			continue;
		}
		executable_join_restrictions.append(candidate);
	}
	cscan->scan.plan.qual = extract_actual_clauses(
		executable_join_restrictions.ptr(), false);
	for (Node* executable : PList<Node>(cscan->scan.plan.qual)) {
		if (contains_mmsearch_qualifier(executable, oids)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("owned mmsearch remained in BioseqBatchJoin quals")));
		}
	}
	PerRowMmsearchPlanAudit ownership_audit{};
	per_row_audit_mmsearch_expression(
		reinterpret_cast<Node*>(cscan->scan.plan.qual),
		ownership_audit.executable_qual_copies, oids);
	for (Plan* child : PList<Plan>(custom_plans)) {
		per_row_audit_mmsearch_plan(child, ownership_audit, oids);
	}
	/* PostgreSQL may pass NIL clauses when a fenced upper UPDATE has already
	 * consumed the join RestrictInfo while constructing this exact CustomPath.
	 * In that one case the versioned private recipe is the ownership proof.
	 * Never accept a nonempty clause list without the owned predicate, stacked
	 * copies, or a copy retained anywhere in either executable child tree. */
	const bool callback_ownership_valid =
		removed_mmsearch_occurrences == 1u
		|| (removed_mmsearch_occurrences == 0u && clauses == NIL
			&& private_mmsearch_recipe_valid);
	if (!callback_ownership_valid || removed_mmsearch_occurrences > 1u
		|| !ownership_audit.clean()) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqBatchJoin owned restriction identity is invalid"),
			 errdetail(
				"private_recipe_valid=%s clauses_nil=%s removed_mmsearch_occurrences=%zu executable_qual_copies=%zu vector_qual_copies=%zu storage_qual_copies=%zu descendant_owner_copies=%zu",
				private_mmsearch_recipe_valid ? "true" : "false",
				clauses == NIL ? "true" : "false",
				removed_mmsearch_occurrences,
				ownership_audit.executable_qual_copies,
				ownership_audit.vector_qual_copies,
				ownership_audit.storage_qual_copies,
				ownership_audit.descendant_owner_copies)));
	}
	cscan->custom_exprs = NIL;
	cscan->custom_plans = custom_plans;
	cscan->custom_scan_tlist = combined_tlist;
	cscan->custom_relids = bms_copy(rel->relids);
	cscan->custom_private = list_make5(
		makeInteger(kBioseqBatchJoinPlanVersion),
		makeInteger(token),
		makeInteger(static_cast<int>(target_relation_oid)),
		makeInteger(target_storage_seq_attno),
		makeInteger(target_slot_seq_resno));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(target_slot_rowno_resno));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(query_slot_seq_resno));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(target_column_count));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(query_column_count));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(alphabet_code));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(storage_unit_byte_width));
	cscan->custom_private = lappend(cscan->custom_private, placeholder_sites);
	cscan->custom_private = lappend(
		cscan->custom_private, copyObject(mmsearch));
	cscan->custom_private = lappend(
		cscan->custom_private, makeInteger(index_read_requirement));
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_batch_join_cost_const(honest_startup_cost));
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_batch_join_cost_const(honest_total_cost));
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_batch_join_cost_const(incumbent_cost_floor));
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_match_owner_descriptor(
			reinterpret_cast<Node*>(target_var), target_var->varno, oids));
	Assert(list_length(cscan->custom_private) == kBioseqBatchJoinPrivateFields);
	return reinterpret_cast<Plan*>(cscan);
}

static Plan* BioseqPerRowJoin_PlanCustomPath(
		PlannerInfo* root, RelOptInfo* rel, CustomPath* best_path,
		List* tlist, List* clauses, List* custom_plans) {
	if (root == nullptr || rel == nullptr || best_path == nullptr
		|| list_length(custom_plans) != 1
		|| list_length(best_path->custom_private)
			!= kBioseqPerRowJoinPathPrivateFields) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch planner state is incomplete")));
	}
	auto private_integer = [best_path](const int index) -> int {
		Node* node = reinterpret_cast<Node*>(
			list_nth(best_path->custom_private, index));
		if (node == nullptr || !IsA(node, Integer)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch private integer is invalid"),
				 errdetail("field=%d", index)));
		}
		return intVal(node);
	};
	const int version = private_integer(0);
	const Oid target_relation_oid = static_cast<Oid>(private_integer(1));
	const Index target_varno = static_cast<Index>(private_integer(2));
	const AttrNumber target_storage_attno = static_cast<AttrNumber>(
		private_integer(3));
	Node* target_expression = reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 4));
	Node* query_expression = reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 5));
	FuncExpr* mmsearch = pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
		list_nth(best_path->custom_private, 6)));
	const int alphabet_code = private_integer(7);
	const int storage_unit_byte_width = private_integer(8);
	const int index_read_requirement = private_integer(9);
	const Cost honest_startup_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(best_path->custom_private, 10)),
		"honest_startup_cost");
	const Cost honest_total_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(best_path->custom_private, 11)),
		"honest_total_cost");
	const Cost incumbent_cost_floor = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(best_path->custom_private, 12)),
		"incumbent_cost_floor");
	const BioseqStubOids& oids = get_cached_stub_oids();
	const auto target_typmod_proof = per_row_sequence_typmod_proof(
		target_expression, oids);
	const auto query_typmod_proof = per_row_sequence_typmod_proof(
		query_expression, oids);
	const int32 expected_typmod = compact_sequence_stdc_type_params{
		static_cast<std::uint8_t>(alphabet_code),
		static_cast<std::uint8_t>(storage_unit_byte_width)}.encode();
	if (version != kBioseqPerRowJoinPlanVersion
		|| !OidIsValid(target_relation_oid)
		|| !bioseq_is_concrete_rte_varno(target_varno)
		|| target_storage_attno <= 0 || target_expression == nullptr
		|| query_expression == nullptr || mmsearch == nullptr
		|| !is_mmsearch_funcid(mmsearch->funcid, oids)
		|| count_mmsearch_occurrences(
			reinterpret_cast<Node*>(mmsearch), oids) != 1u
		|| exprType(target_expression) != oids.bioseq_seq_type_oid
		|| exprType(query_expression) != oids.bioseq_seq_type_oid
		|| !target_typmod_proof.has_value()
		|| !query_typmod_proof.has_value()
		|| target_typmod_proof->typmod != expected_typmod
		|| !batch_join_typmod_is_supported(query_typmod_proof->typmod)
		|| !mmsearch_typmods_share_alphabet(
			target_typmod_proof->typmod, query_typmod_proof->typmod)
		|| alphabet_code < 0 || alphabet_code > UINT8_MAX
		|| (storage_unit_byte_width != 1 && storage_unit_byte_width != 2
			&& storage_unit_byte_width != 4
			&& storage_unit_byte_width != 8)
		|| index_read_requirement != static_cast<int>(
			bioseq::indexing::IndexReadRequirement::require_absent)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch private path ABI is invalid")));
	}
	Plan* child_plan = reinterpret_cast<Plan*>(linitial(custom_plans));
	if (child_plan == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch child plan is missing")));
	}
	PerRowMmsearchPlanAudit child_audit{};
	per_row_audit_mmsearch_plan(
		child_plan, child_audit, get_cached_stub_oids(), mmsearch);
	if (!child_audit.clean()) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqPerRowMmsearch reconstructed child retained owned mmsearch state"),
			 errdetail(
				"executable=%zu vector=%zu storage=%zu descendant_owner=%zu",
				child_audit.executable_qual_copies,
				child_audit.vector_qual_copies,
				child_audit.storage_qual_copies,
				child_audit.descendant_owner_copies)));
	}
	PerRowOwnerSupportProof plan_owner_support{};
	if (!per_row_collect_owner_support(
			root, rel, target_varno, target_expression,
			plan_owner_support)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch plan owner support is invalid")));
	}
	List* setrefs_carrier_vars = NIL;
	if (!per_row_collect_setrefs_carrier_vars(
			target_expression, plan_owner_support.helper_argument_vars,
			rel->relids, setrefs_carrier_vars)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch setrefs carriers are invalid")));
	}
	const AttrNumber target_resno = find_plan_tlist_expression_resno(
		child_plan->targetlist, target_expression);
	const AttrNumber query_resno = find_plan_tlist_expression_resno(
		child_plan->targetlist, query_expression);
	if (target_resno <= 0 || query_resno <= 0) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch operand projection is missing"),
			 errdetail("target_resno=%d query_resno=%d",
				static_cast<int>(target_resno),
				static_cast<int>(query_resno))));
	}
	/* required_target promised each raw carrier below SliceProject.  Validate
	 * that contract before taking the child scan-tuple snapshot, then add only
	 * missing owner outputs as resjunk.  The public owner target remains at its
	 * construction-time join shape: helper identities and deferred passthrough
	 * Vars are plan-only support, added after core can no longer replace the
	 * path's sortgroupref storage. */
	/* build_path_tlist replaces lateral Vars with PARAM_EXEC nodes.  The exact
	 * no-widening proof belongs to path construction; here validate only the
	 * callback target's ordinal and SQL type shape. */
	bool callback_target_consistent = best_path->path.pathtarget != nullptr
		&& list_length(tlist)
			== list_length(best_path->path.pathtarget->exprs);
	int callback_target_index = 0;
	for (TargetEntry* entry : PList<TargetEntry>(tlist)) {
		Node* actual = entry == nullptr
			? nullptr : reinterpret_cast<Node*>(entry->expr);
		Node* expected = !callback_target_consistent
			? nullptr : reinterpret_cast<Node*>(list_nth(
				best_path->path.pathtarget->exprs, callback_target_index));
		if (actual == nullptr || expected == nullptr
			|| entry->resno != callback_target_index + 1
			|| exprType(actual) != exprType(expected)
			|| exprTypmod(actual) != exprTypmod(expected)
			|| exprCollation(actual) != exprCollation(expected)) {
			callback_target_consistent = false;
			break;
		}
		++callback_target_index;
	}
	if (!callback_target_consistent) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqPerRowMmsearch callback target is inconsistent")));
	}
	List* requested_tlist = list_copy(tlist);
	List* plan_only_passthrough_support = NIL;
	List* plan_only_helper_support = NIL;
	struct PerRowPlanOnlyHelperBinding {
		AttrNumber output_resno = InvalidAttrNumber;
		AttrNumber site_resno = InvalidAttrNumber;
		Node* identity = nullptr;
	};
	std::vector<PerRowPlanOnlyHelperBinding> plan_only_helper_bindings;
	List* inherited_helper_identities =
		batch_join_proven_inherited_helper_identities(child_plan, oids);
	List* current_owner_helper_identities = NIL;
	for (Node* identity : PList<Node>(plan_owner_support.helper_identities)) {
		FuncExpr* helper = per_row_helper_identity_function(identity, oids);
		if (helper != nullptr
			&& (batch_join_match_helper_names_recipe(
				helper, target_expression)
				|| batch_join_match_helper_names_base_lineage(
					helper, target_expression, oids))) {
			per_row_append_unique_expression(
				current_owner_helper_identities, identity);
		}
	}
	for (Node* identity : PList<Node>(plan_owner_support.helper_identities)) {
		if (!batch_join_descendant_owns_helper_identity(
				child_plan, identity)) continue;
		const bool exposed_by_child = find_plan_tlist_expression_resno(
			child_plan->targetlist, identity) > 0;
		const bool classified_inherited = batch_join_identity_list_contains(
			inherited_helper_identities, identity);
		FuncExpr* helper = per_row_helper_identity_function(identity, oids);
		const bool names_recipe = helper != nullptr
			&& batch_join_match_helper_names_recipe(
				helper, target_expression);
		const bool legacy_lineage = helper != nullptr
			&& batch_join_match_helper_names_base_lineage(
				helper, target_expression, oids);
		/* A helper that names only the shared base lineage deliberately belongs
		 * to both this transformed owner and the proven descendant base owner.
		 * Register the current site and let finalized semantic binding reject the
		 * two candidates with 42702.  Exact-recipe carrier loss is corruption. */
		const bool deliberate_lineage_ambiguity = legacy_lineage
			&& !names_recipe;
		if ((!exposed_by_child || !classified_inherited)
			&& !deliberate_lineage_ambiguity) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqPerRowMmsearch descendant helper carrier was dropped"),
				 errdetail("node_type=%d exposed=%s inherited=%s exact_recipe=%s legacy_lineage=%s",
					static_cast<int>(nodeTag(identity)),
					exposed_by_child ? "true" : "false",
					classified_inherited ? "true" : "false",
					names_recipe ? "true" : "false",
					legacy_lineage ? "true" : "false")));
		}
	}
	for (Node* support : PList<Node>(plan_owner_support.passthrough_vars)) {
		if (find_plan_tlist_expression_resno(
				requested_tlist, support) > 0) continue;
		requested_tlist = lappend(requested_tlist, makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(support)),
			static_cast<AttrNumber>(list_length(requested_tlist) + 1),
			nullptr, /*resjunk=*/true));
		per_row_append_unique_expression(
			plan_only_passthrough_support, support);
	}
	for (Node* support : PList<Node>(current_owner_helper_identities)) {
		if (batch_join_identity_list_contains(
				inherited_helper_identities, support)) continue;
		if (find_plan_tlist_expression_resno(
				requested_tlist, support) > 0) continue;
		requested_tlist = lappend(requested_tlist, makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(support)),
			static_cast<AttrNumber>(list_length(requested_tlist) + 1),
			nullptr, /*resjunk=*/true));
		per_row_append_unique_expression(plan_only_helper_support, support);
	}
	for (Node* identity : PList<Node>(current_owner_helper_identities)) {
		if (batch_join_identity_list_contains(
				inherited_helper_identities, identity)) continue;
		if (find_plan_tlist_expression_resno(
				requested_tlist, identity) <= 0) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqPerRowMmsearch plan-only helper was lost")));
		}
	}
	List* hidden_setrefs_carriers = NIL;
	for (Node* carrier : PList<Node>(setrefs_carrier_vars)) {
		if (find_plan_tlist_expression_resno(
				child_plan->targetlist, carrier) <= 0) {
			Var* var = pg_node_try_as<Var>(carrier);
			if (var == nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqPerRowMmsearch setrefs carrier is not a Var")));
			}
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch child setrefs carrier is missing"),
				 errdetail("varno=%u attno=%d", var->varno, var->varattno)));
		}
		if (find_plan_tlist_expression_resno(requested_tlist, carrier) > 0) {
			continue;
		}
		requested_tlist = lappend(requested_tlist, makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(carrier)),
			static_cast<AttrNumber>(list_length(requested_tlist) + 1),
			nullptr, /*resjunk=*/true));
		per_row_append_unique_expression(
			hidden_setrefs_carriers, carrier);
	}
	List* combined_tlist = NIL;
	for (TargetEntry* source : PList<TargetEntry>(child_plan->targetlist)) {
		TargetEntry* copied = static_cast<TargetEntry*>(copyObject(source));
		copied->resno = static_cast<AttrNumber>(list_length(combined_tlist) + 1);
		combined_tlist = lappend(combined_tlist, copied);
	}
	const int child_column_count = list_length(combined_tlist);
	const AttrNumber current_site_first_resno = static_cast<AttrNumber>(
		child_column_count + 1);
	List* placeholder_sites = NIL;
	List* output_tlist = NIL;
	for (TargetEntry* output : PList<TargetEntry>(requested_tlist)) {
		if (output == nullptr) continue;
		TargetEntry* copied = static_cast<TargetEntry*>(copyObject(output));
		Node* plan_only_helper_identity = nullptr;
		for (Node* identity : PList<Node>(plan_only_helper_support)) {
			if (equal(copied->expr, identity)) {
				plan_only_helper_identity = identity;
				break;
			}
		}
		const int site_count_before = list_length(placeholder_sites);
		BatchJoinPlaceholderRegistration registration{
			&oids, target_varno, target_storage_attno, target_expression,
			&combined_tlist, &placeholder_sites, false, false,
			inherited_helper_identities};
		batch_join_placeholder_registration_visitor visitor;
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(copied->expr), registration, visitor);
		if (registration.edit_sequence_mismatch) {
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("bioseq.edit projection must reference the mmsearch target source")));
		}
		if (registration.invalid) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch match helper identity is invalid")));
		}
		if (plan_only_helper_identity != nullptr) {
			FuncExpr* helper = per_row_helper_identity_function(
				plan_only_helper_identity, oids);
			PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(
				plan_only_helper_identity);
			const Index phid = placeholder == nullptr ? 0 : placeholder->phid;
			const int site_count_after = list_length(placeholder_sites);
			const AttrNumber site_resno = helper == nullptr
				? InvalidAttrNumber
				: batch_join_find_same_owner_placeholder_site(
					plan_only_helper_identity, helper, phid, registration);
			TargetEntry* site_entry = site_resno < current_site_first_resno
				|| site_resno > list_length(combined_tlist)
				? nullptr : reinterpret_cast<TargetEntry*>(list_nth(
					combined_tlist, site_resno - 1));
			if (registration.invalid || site_count_after < site_count_before
				|| site_count_after > site_count_before + 1
				|| site_resno == InvalidAttrNumber
				|| site_entry == nullptr || site_entry->resno != site_resno
				|| !equal(site_entry->expr, plan_only_helper_identity)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqPerRowMmsearch plan-only helper site identity is invalid"),
					 errdetail("sites_before=%d sites_after=%d",
						site_count_before, site_count_after)));
			}
			plan_only_helper_bindings.push_back({
				copied->resno, site_resno, plan_only_helper_identity});
		}
		copied->expr = batch_join_rewrite_output_for_setrefs(
			copied->expr, combined_tlist, oids,
			current_site_first_resno,
			inherited_helper_identities);
		output_tlist = lappend(output_tlist, copied);
	}
	for (Node* carrier : PList<Node>(hidden_setrefs_carriers)) {
		bool found_resjunk = false;
		for (TargetEntry* output : PList<TargetEntry>(output_tlist)) {
			if (output != nullptr && output->resjunk
				&& equal(output->expr, carrier)) {
				found_resjunk = true;
				break;
			}
		}
		if (!found_resjunk) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch hidden setrefs carrier was lost")));
		}
	}
	for (Node* support : PList<Node>(plan_only_passthrough_support)) {
		bool found_resjunk = false;
		for (TargetEntry* output : PList<TargetEntry>(output_tlist)) {
			if (output != nullptr && output->resjunk
				&& equal(output->expr, support)) {
				found_resjunk = true;
				break;
			}
		}
		if (!found_resjunk) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqPerRowMmsearch plan-only passthrough was lost")));
		}
	}
	for (const PerRowPlanOnlyHelperBinding& binding
			: plan_only_helper_bindings) {
		TargetEntry* output_entry = nullptr;
		for (TargetEntry* candidate : PList<TargetEntry>(output_tlist)) {
			if (candidate != nullptr
				&& candidate->resno == binding.output_resno) {
				output_entry = candidate;
				break;
			}
		}
		TargetEntry* site_entry = binding.site_resno <= 0
			|| binding.site_resno > list_length(combined_tlist)
			? nullptr : reinterpret_cast<TargetEntry*>(list_nth(
				combined_tlist, binding.site_resno - 1));
		Var* output_slot = output_entry == nullptr
			? nullptr : pg_node_try_as<Var>(
				reinterpret_cast<Node*>(output_entry->expr));
		const bool output_binds_site = output_entry != nullptr
			&& (equal(output_entry->expr, binding.identity)
				|| (output_slot != nullptr
					&& output_slot->varno == INDEX_VAR
					&& output_slot->varattno == binding.site_resno));
		if (output_entry == nullptr || !output_entry->resjunk
			|| site_entry == nullptr
			|| site_entry->resno != binding.site_resno
			|| !equal(site_entry->expr, binding.identity)
			|| !output_binds_site) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqPerRowMmsearch plan-only helper binding was lost")));
		}
	}
	if (plan_only_helper_bindings.size()
		!= static_cast<std::size_t>(list_length(plan_only_helper_support))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqPerRowMmsearch plan-only helper binding count is invalid")));
	}
	validate_batch_join_setrefs_coverage(output_tlist, combined_tlist);
	/* custom_restrictinfo is planner-lifetime join metadata, primarily used by
	 * core for pseudoconstant gating; PostgreSQL may legitimately pass NIL in
	 * `clauses` here.  Executable ownership is instead proved by the validated
	 * versioned mmsearch recipe above plus the recursive child-plan audit, which
	 * rejects every surviving duplicate below this sole owner. */
	(void)clauses;
	auto* cscan = makeNode(CustomScan);
	/* Post-join-recipe mode is a versioned BioseqBatchJoin shape.  Reuse the
	 * registered scan/executor method set so copied, cached, and deserialized
	 * plans retain the same public owner identity as the raw-Var mode. */
	cscan->methods = &BioseqBatchJoinScanMethods;
	cscan->flags = best_path->flags;
	cscan->scan.scanrelid = 0;
	cscan->scan.plan.targetlist = output_tlist;
	cscan->scan.plan.qual = NIL;
	cscan->custom_exprs = NIL;
	cscan->custom_plans = custom_plans;
	cscan->custom_scan_tlist = combined_tlist;
	cscan->custom_relids = bms_copy(rel->relids);
	cscan->custom_private = list_make5(
		makeInteger(kBioseqPerRowJoinPlanVersion),
		makeInteger(static_cast<int>(target_relation_oid)),
		makeInteger(static_cast<int>(target_storage_attno)),
		makeInteger(static_cast<int>(target_resno)),
		makeInteger(static_cast<int>(query_resno)));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(child_column_count));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(alphabet_code));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(storage_unit_byte_width));
	const auto query_type_params = compact_sequence_stdc_type_params::decode(
		query_typmod_proof->typmod);
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(query_type_params.alphabet_code));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(query_type_params.storage_unit_byte_width));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(target_typmod_proof->descriptor_erased ? 1 : 0));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(query_typmod_proof->descriptor_erased ? 1 : 0));
	cscan->custom_private = lappend(cscan->custom_private, placeholder_sites);
	cscan->custom_private = lappend(
		cscan->custom_private, copyObject(mmsearch));
	cscan->custom_private = lappend(cscan->custom_private,
		makeInteger(index_read_requirement));
	cscan->custom_private = lappend(cscan->custom_private,
		make_batch_join_cost_const(honest_startup_cost));
	cscan->custom_private = lappend(cscan->custom_private,
		make_batch_join_cost_const(honest_total_cost));
	cscan->custom_private = lappend(cscan->custom_private,
		make_batch_join_cost_const(incumbent_cost_floor));
	cscan->custom_private = lappend(
		cscan->custom_private,
		make_match_owner_descriptor(
			target_expression, target_varno, oids));
	Assert(list_length(cscan->custom_private)
		== kBioseqPerRowJoinPrivateFields);
	return reinterpret_cast<Plan*>(cscan);
}

struct MatchOwnerFinalization {
	CustomScan* scan = nullptr;
	List* descriptor = NIL;
	List* sites = NIL;
	Node* target_recipe = nullptr;
	List* base_lineage = NIL;
	Index legacy_target_relid = 0;
	Oid target_relation_oid = InvalidOid;
	int stable_match_id = 0;
	/* custom_private is deliberately opaque to core setrefs, so Vars stored in
	 * recipes retain query-local varnos.  This finalization-only scope identity
	 * prevents equal local spellings in unrelated subqueries/initplans from
	 * becoming lineage candidates for one another.  It is never serialized: the
	 * final executor ABI remains the stable Plan.plan_node_id. */
	std::uint64_t query_scope_id = 0u;
	/* Non-NIL only for a base BioseqScan owner.  Its pre-setrefs descriptor and
	 * sites remain above for query-scope resolution; these tag cells receive a
	 * distinct post-setrefs executor image after resolution succeeds. */
	List* base_owner_tag = NIL;
};
static_assert(std::is_trivially_destructible_v<MatchOwnerFinalization>);
static_assert(std::is_trivially_destructible_v<
	std::array<MatchOwnerFinalization, 4>>);
static_assert(std::is_trivially_destructible_v<
	std::span<MatchOwnerFinalization>>);

#ifdef BIOSEQ_TEST_INDEXES
/* Backend-local proof that a PostgreSQL ERROR cannot jump across the heap-
 * backed owner vector.  The revoked diagnostic seam reads the balance after
 * a user-triggered ambiguous-owner error in the same backend. */
static std::uint64_t MatchOwnerFinalizationScopesEntered = 0u;
static std::uint64_t MatchOwnerFinalizationScopesExited = 0u;

struct MatchOwnerFinalizationScopeGuard {
	MatchOwnerFinalizationScopeGuard() noexcept {
		++MatchOwnerFinalizationScopesEntered;
	}
	MatchOwnerFinalizationScopeGuard(
		const MatchOwnerFinalizationScopeGuard&) = delete;
	MatchOwnerFinalizationScopeGuard& operator=(
		const MatchOwnerFinalizationScopeGuard&) = delete;
	~MatchOwnerFinalizationScopeGuard() noexcept {
		++MatchOwnerFinalizationScopesExited;
	}
};
#endif

enum class MatchSiteResolutionStatus : std::uint8_t {
	bound,
	ambiguous,
	invalid,
};

struct MatchSiteResolution {
	MatchSiteResolutionStatus status = MatchSiteResolutionStatus::invalid;
	BioseqMatchHelperBindingKind kind =
		BioseqMatchHelperBindingKind::unresolved;
	MatchOwnerFinalization* owner = nullptr;
	std::size_t candidate_count = 0u;
};

[[nodiscard]] static Integer* match_binding_integer(
		List* values, const int index, const char* field) {
	Node* node = values == nullptr || index < 0
		|| index >= list_length(values)
		? nullptr : reinterpret_cast<Node*>(list_nth(values, index));
	if (node == nullptr || !IsA(node, Integer)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match binding integer ABI is invalid"),
			 errdetail("field=%s index=%d", field, index)));
	}
	return reinterpret_cast<Integer*>(node);
}

[[nodiscard]] static bool match_owner_lineage_contains(
		const MatchOwnerFinalization& site_owner,
		const MatchOwnerFinalization& owner, Node* argument,
		const BioseqStubOids& oids) noexcept {
	if (site_owner.query_scope_id == 0u
		|| owner.query_scope_id != site_owner.query_scope_id) return false;
	Var* variable = pg_node_try_as<Var>(argument);
	if (variable == nullptr
		|| !bioseq_is_concrete_rte_varno(variable->varno)
		|| variable->varattno <= 0 || variable->varlevelsup != 0
		|| !bms_is_empty(variable->varnullingrels)) return false;
	if (variable->vartype == oids.bioseq_seq_type_oid) {
		for (Var* base : PList<Var>(owner.base_lineage)) {
			if (base != nullptr && equal(base, variable)) return true;
		}
		return false;
	}
	/* Query-local Var identity is the alias boundary.  Relation OIDs are not:
	 * inheritance, partitions, and composite recipes may legitimately expose
	 * distinct physical relations while retaining one SQL-visible lineage,
	 * whereas two aliases of one relation must never be conflated. */
	if (variable->varno == owner.legacy_target_relid) return true;
	for (Var* base : PList<Var>(owner.base_lineage)) {
		if (base != nullptr && base->varno == variable->varno
			&& base->varlevelsup == variable->varlevelsup) return true;
	}
	return false;
}

[[nodiscard]] static MatchSiteResolution resolve_match_helper_site(
		MatchOwnerFinalization& site_owner, Node* canonical_argument,
		std::span<MatchOwnerFinalization> owners,
		const BioseqStubOids& oids) noexcept {
	MatchSiteResolution result{};
	/* Resolve exact recipes across the complete query-local owner set before
	 * honoring the registering site.  Two equal recipes owned by distinct plan
	 * nodes are not distinguishable from SQL and must fail closed instead of
	 * letting traversal/registration order choose one. */
	for (MatchOwnerFinalization& candidate : owners) {
		if (candidate.query_scope_id != site_owner.query_scope_id) continue;
		if (canonical_argument != nullptr
			&& candidate.target_recipe != nullptr
			&& equal(canonical_argument, candidate.target_recipe)) {
			++result.candidate_count;
			result.owner = &candidate;
		}
	}
	if (result.candidate_count != 0u) {
		if (result.candidate_count > 1u) {
			result.status = MatchSiteResolutionStatus::ambiguous;
			return result;
		}
		if (result.owner != &site_owner) {
			result.status = MatchSiteResolutionStatus::invalid;
			return result;
		}
		result.status = MatchSiteResolutionStatus::bound;
		result.kind = BioseqMatchHelperBindingKind::exact_recipe;
		return result;
	}

	result.owner = nullptr;
	result.candidate_count = 0u;
	for (MatchOwnerFinalization& candidate : owners) {
		if (!match_owner_lineage_contains(
				site_owner, candidate, canonical_argument, oids)) continue;
		++result.candidate_count;
		result.owner = &candidate;
	}
	if (result.candidate_count > 1u) {
		result.status = MatchSiteResolutionStatus::ambiguous;
		return result;
	}
	if (result.candidate_count != 1u || result.owner != &site_owner) {
		result.status = MatchSiteResolutionStatus::invalid;
		return result;
	}
	result.status = MatchSiteResolutionStatus::bound;
	result.kind = BioseqMatchHelperBindingKind::unique_lineage;
	return result;
}

/* BIOSEQ_TEST_INDEXES has no SQL-visible helper for this invariant on purpose:
 * exposing one would create another executable match-helper surface.  The
 * first real owner finalization in a test backend runs this resolver seam.  It
 * proves both halves of the scope contract with the exact pre-setrefs collision
 * that nested PlannerInfos can produce: an equal local Var in another scope is
 * ignored, while two owners in one scope remain ambiguous for a legacy key
 * Var even when their physical relation OIDs differ.  A second alias of the
 * same physical relation remains distinct by Var identity.  Duplicate exact
 * recipes fail closed rather than selecting by traversal order. */
#ifdef BIOSEQ_TEST_INDEXES
static void verify_match_owner_scope_resolution(
		const BioseqStubOids& oids) {
	static bool verified = false;
	if (verified) return;

	Var* source = makeVar(
		/*varno=*/1, /*varattno=*/1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	Var* legacy_key = makeVar(
		/*varno=*/1, /*varattno=*/2, INT4OID,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	constexpr Oid fixture_relation_oid = 4242;

	std::array<MatchOwnerFinalization, 4> fixture{};
	MatchOwnerFinalization first{};
	first.target_recipe = reinterpret_cast<Node*>(copyObject(source));
	first.base_lineage = list_make1(copyObject(source));
	first.legacy_target_relid = 1;
	first.target_relation_oid = fixture_relation_oid;
	first.stable_match_id = 101;
	first.query_scope_id = 11u;
	fixture[0] = first;

	MatchOwnerFinalization unrelated_scope{};
	unrelated_scope.target_recipe = reinterpret_cast<Node*>(copyObject(source));
	unrelated_scope.base_lineage = list_make1(copyObject(source));
	unrelated_scope.legacy_target_relid = 1;
	unrelated_scope.target_relation_oid = fixture_relation_oid;
	unrelated_scope.stable_match_id = 102;
	unrelated_scope.query_scope_id = 12u;
	fixture[1] = unrelated_scope;

	const MatchSiteResolution scoped = resolve_match_helper_site(
		fixture[0], reinterpret_cast<Node*>(legacy_key),
		std::span<MatchOwnerFinalization>{fixture.data(), 2u}, oids);
	if (scoped.status != MatchSiteResolutionStatus::bound
		|| scoped.kind != BioseqMatchHelperBindingKind::unique_lineage
		|| scoped.owner != &fixture[0] || scoped.candidate_count != 1u) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match binding query-scope self-test failed"),
			 errdetail("unrelated subplan scope was not isolated")));
	}

	MatchOwnerFinalization same_scope{};
	same_scope.target_recipe = reinterpret_cast<Node*>(copyObject(source));
	same_scope.base_lineage = list_make1(copyObject(source));
	same_scope.legacy_target_relid = 1;
	same_scope.target_relation_oid = fixture_relation_oid + 1;
	same_scope.stable_match_id = 103;
	same_scope.query_scope_id = 11u;
	fixture[2] = same_scope;

	Var* alias_source = makeVar(
		/*varno=*/2, /*varattno=*/1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	MatchOwnerFinalization same_relation_alias{};
	same_relation_alias.target_recipe =
		reinterpret_cast<Node*>(copyObject(alias_source));
	same_relation_alias.base_lineage = list_make1(copyObject(alias_source));
	same_relation_alias.legacy_target_relid = 2;
	same_relation_alias.target_relation_oid = fixture_relation_oid;
	same_relation_alias.stable_match_id = 104;
	same_relation_alias.query_scope_id = 11u;
	fixture[3] = same_relation_alias;

	const MatchSiteResolution ambiguous = resolve_match_helper_site(
		fixture[0], reinterpret_cast<Node*>(legacy_key),
		std::span<MatchOwnerFinalization>{fixture}, oids);
	const MatchSiteResolution duplicate_exact = resolve_match_helper_site(
		fixture[0], fixture[0].target_recipe,
		std::span<MatchOwnerFinalization>{fixture}, oids);
	if (ambiguous.status != MatchSiteResolutionStatus::ambiguous
		|| ambiguous.candidate_count != 2u
		|| duplicate_exact.status != MatchSiteResolutionStatus::ambiguous
		|| duplicate_exact.candidate_count != 2u) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match binding query-scope self-test failed"),
			 errdetail("same-scope lineage, alias, or duplicate-exact binding changed")));
	}

	Var* secondary_key = makeVar(
		/*varno=*/2, /*varattno=*/2, INT4OID,
		/*vartypmod=*/-1, /*varcollid=*/InvalidOid, /*varlevelsup=*/0);
	std::array<MatchOwnerFinalization, 2> composite_fixture{};
	MatchOwnerFinalization composite{};
	composite.target_recipe = reinterpret_cast<Node*>(copyObject(source));
	composite.base_lineage = list_make2(
		copyObject(source), copyObject(alias_source));
	composite.legacy_target_relid = 1;
	composite.stable_match_id = 201;
	composite.query_scope_id = 21u;
	composite_fixture[0] = composite;
	MatchOwnerFinalization secondary{};
	secondary.target_recipe = reinterpret_cast<Node*>(copyObject(alias_source));
	secondary.base_lineage = list_make1(copyObject(alias_source));
	secondary.legacy_target_relid = 2;
	secondary.stable_match_id = 202;
	secondary.query_scope_id = 21u;
	composite_fixture[1] = secondary;
	const MatchSiteResolution secondary_ambiguous = resolve_match_helper_site(
		composite_fixture[0], reinterpret_cast<Node*>(secondary_key),
		std::span<MatchOwnerFinalization>{composite_fixture}, oids);
	if (secondary_ambiguous.status
			!= MatchSiteResolutionStatus::ambiguous
		|| secondary_ambiguous.candidate_count != 2u) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match binding composite-lineage self-test failed"),
			 errdetail("secondary base lineage did not remain ambiguous")));
	}
	verified = true;
}
#endif

[[nodiscard]] static std::uint64_t allocate_match_owner_scope(
		std::uint64_t& next_scope_id) {
	if (next_scope_id == 0u
		|| next_scope_id == (std::numeric_limits<std::uint64_t>::max)()) {
		ereport(ERROR,
			(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
			 errmsg("Bioseq match owner query-scope limit exceeded")));
	}
	return next_scope_id++;
}

[[nodiscard]] static List* find_base_match_owner_plan_tag(
		CustomScan* scan) {
	if (scan == nullptr || scan->methods != &BioseqColumnScanScanMethods) {
		return NIL;
	}
	List* result = NIL;
	for (Node* private_node : PList<Node>(scan->custom_private)) {
		if (private_node == nullptr || !IsA(private_node, List)) continue;
		List* tag = reinterpret_cast<List*>(private_node);
		Node* magic_node = tag == NIL ? nullptr
			: reinterpret_cast<Node*>(linitial(tag));
		if (magic_node == nullptr || !IsA(magic_node, Integer)
			|| intVal(magic_node) != kBioseqBaseMatchOwnerPlanMagic) continue;
		Node* version_node = list_length(tag) > kBaseMatchPlanVersion
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanVersion)) : nullptr;
		Node* descriptor_node = list_length(tag) > kBaseMatchPlanDescriptor
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanDescriptor)) : nullptr;
		Node* sites_node = list_length(tag) > kBaseMatchPlanSites
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanSites)) : nullptr;
		Node* relation_node = list_length(tag) > kBaseMatchPlanRelationOid
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanRelationOid)) : nullptr;
		Node* executor_descriptor_node =
			list_length(tag) > kBaseMatchPlanExecutorDescriptor
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanExecutorDescriptor)) : nullptr;
		Node* executor_sites_node =
			list_length(tag) > kBaseMatchPlanExecutorSites
			? reinterpret_cast<Node*>(list_nth(
				tag, kBaseMatchPlanExecutorSites)) : nullptr;
		if (result != NIL
			|| list_length(tag) != kBioseqBaseMatchOwnerPlanFields
			|| version_node == nullptr || !IsA(version_node, Integer)
			|| intVal(version_node) != kBioseqBaseMatchOwnerPlanVersion
			|| descriptor_node == nullptr || !IsA(descriptor_node, List)
			|| (sites_node != nullptr && !IsA(sites_node, List))
			|| relation_node == nullptr || !IsA(relation_node, Integer)
			|| !OidIsValid(static_cast<Oid>(intVal(relation_node)))
			|| (executor_descriptor_node != nullptr
				&& !IsA(executor_descriptor_node, List))
			|| (executor_sites_node != nullptr
				&& !IsA(executor_sites_node, List))) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan match owner plan tag is invalid")));
		}
		result = tag;
	}
	return result;
}

static void collect_match_owner_plan(
		Plan* plan, std::vector<MatchOwnerFinalization>& owners,
		const std::uint64_t query_scope_id,
		std::uint64_t& next_scope_id) {
	if (plan == nullptr) return;
	if (query_scope_id == 0u) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq match owner query scope is invalid")));
	}
	check_stack_depth();
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		const char* name = custom->methods == nullptr
			? nullptr : custom->methods->CustomName;
		if (name != nullptr && strcmp(name, "BioseqBatchJoin") == 0
			&& custom->custom_private != NIL) {
			Node* version_node = reinterpret_cast<Node*>(
				linitial(custom->custom_private));
			if (version_node != nullptr && IsA(version_node, Integer)) {
				const int version = intVal(version_node);
				const int descriptor_index = version
					== kBioseqBatchJoinPlanVersion
					? kBatchJoinMatchOwnerDescriptor
					: (version == kBioseqPerRowJoinPlanVersion
						? kPerRowMatchOwnerDescriptor : -1);
				const int sites_index = version
					== kBioseqBatchJoinPlanVersion
					? kBatchJoinPlaceholderSites
					: (version == kBioseqPerRowJoinPlanVersion
						? kPerRowPlaceholderSites : -1);
				const int relation_oid_index = version
					== kBioseqBatchJoinPlanVersion
					? kBatchJoinTargetRelationOid
					: (version == kBioseqPerRowJoinPlanVersion
						? kPerRowTargetRelationOid : -1);
				if (descriptor_index >= 0
					&& descriptor_index < list_length(custom->custom_private)
					&& sites_index >= 0
					&& relation_oid_index >= 0
					&& sites_index < list_length(custom->custom_private)) {
					Node* descriptor_node = reinterpret_cast<Node*>(list_nth(
						custom->custom_private, descriptor_index));
					Node* sites_node = reinterpret_cast<Node*>(list_nth(
						custom->custom_private, sites_index));
					if (descriptor_node == nullptr || !IsA(descriptor_node, List)
						|| (sites_node != nullptr && !IsA(sites_node, List))) {
						ereport(ERROR,
							(errcode(ERRCODE_INTERNAL_ERROR),
							 errmsg("Bioseq match owner finalization ABI is invalid")));
					}
					List* descriptor = reinterpret_cast<List*>(descriptor_node);
					if (list_length(descriptor)
							!= kBioseqMatchOwnerDescriptorFields
						|| intVal(match_binding_integer(descriptor,
							kMatchOwnerMagic, "owner.magic"))
							!= kBioseqMatchOwnerDescriptorMagic
						|| intVal(match_binding_integer(descriptor,
							kMatchOwnerVersion, "owner.version"))
							!= kBioseqMatchOwnerDescriptorVersion) {
						ereport(ERROR,
							(errcode(ERRCODE_INTERNAL_ERROR),
							 errmsg("Bioseq match owner descriptor is invalid")));
					}
					Node* lineage_node = reinterpret_cast<Node*>(list_nth(
						descriptor, kMatchOwnerBaseLineage));
					if (lineage_node != nullptr && !IsA(lineage_node, List)) {
						ereport(ERROR,
							(errcode(ERRCODE_INTERNAL_ERROR),
							 errmsg("Bioseq match owner lineage is invalid")));
					}
					owners.push_back(MatchOwnerFinalization{
						custom,
						descriptor,
						sites_node == nullptr ? NIL
							: reinterpret_cast<List*>(sites_node),
						reinterpret_cast<Node*>(list_nth(
							descriptor, kMatchOwnerTargetRecipe)),
						lineage_node == nullptr ? NIL
							: reinterpret_cast<List*>(lineage_node),
						static_cast<Index>(intVal(match_binding_integer(
							descriptor, kMatchOwnerLegacyTargetRelid,
							"owner.legacy_target_relid"))),
						static_cast<Oid>(intVal(match_binding_integer(
							custom->custom_private, relation_oid_index,
							"owner.target_relation_oid"))),
						plan->plan_node_id,
						query_scope_id,
						NIL});
				}
			}
		}
		List* base_owner_tag = find_base_match_owner_plan_tag(custom);
		if (base_owner_tag != NIL) {
			Node* descriptor_node = reinterpret_cast<Node*>(list_nth(
				base_owner_tag, kBaseMatchPlanDescriptor));
			Node* sites_node = reinterpret_cast<Node*>(list_nth(
				base_owner_tag, kBaseMatchPlanSites));
			List* descriptor = reinterpret_cast<List*>(descriptor_node);
			if (list_length(descriptor)
					!= kBioseqMatchOwnerDescriptorFields
				|| intVal(match_binding_integer(descriptor,
					kMatchOwnerMagic, "owner.magic"))
					!= kBioseqMatchOwnerDescriptorMagic
				|| intVal(match_binding_integer(descriptor,
					kMatchOwnerVersion, "owner.version"))
					!= kBioseqMatchOwnerDescriptorVersion) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqScan match owner descriptor is invalid")));
			}
			Node* lineage_node = reinterpret_cast<Node*>(list_nth(
				descriptor, kMatchOwnerBaseLineage));
			if (lineage_node != nullptr && !IsA(lineage_node, List)) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqScan match owner lineage is invalid")));
			}
			owners.push_back(MatchOwnerFinalization{
				custom,
				descriptor,
				sites_node == nullptr ? NIL
					: reinterpret_cast<List*>(sites_node),
				reinterpret_cast<Node*>(list_nth(
					descriptor, kMatchOwnerTargetRecipe)),
				lineage_node == nullptr ? NIL
					: reinterpret_cast<List*>(lineage_node),
				static_cast<Index>(intVal(match_binding_integer(
					descriptor, kMatchOwnerLegacyTargetRelid,
					"owner.legacy_target_relid"))),
				static_cast<Oid>(intVal(match_binding_integer(
					base_owner_tag, kBaseMatchPlanRelationOid,
					"owner.target_relation_oid"))),
				plan->plan_node_id,
				query_scope_id,
				base_owner_tag});
		}
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			collect_match_owner_plan(
				child, owners, query_scope_id, next_scope_id);
		}
		return;
	}
	if (IsA(plan, Append)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<Append*>(plan)->appendplans)) {
			collect_match_owner_plan(
				child, owners, query_scope_id, next_scope_id);
		}
		return;
	}
	if (IsA(plan, MergeAppend)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<MergeAppend*>(plan)->mergeplans)) {
			collect_match_owner_plan(
				child, owners, query_scope_id, next_scope_id);
		}
		return;
	}
	if (IsA(plan, BitmapAnd)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapAnd*>(plan)->bitmapplans)) {
			collect_match_owner_plan(
				child, owners, query_scope_id, next_scope_id);
		}
		return;
	}
	if (IsA(plan, BitmapOr)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapOr*>(plan)->bitmapplans)) {
			collect_match_owner_plan(
				child, owners, query_scope_id, next_scope_id);
		}
		return;
	}
	if (IsA(plan, SubqueryScan)) {
		const std::uint64_t subquery_scope =
			allocate_match_owner_scope(next_scope_id);
		collect_match_owner_plan(
			reinterpret_cast<SubqueryScan*>(plan)->subplan, owners,
			subquery_scope, next_scope_id);
		return;
	}
	collect_match_owner_plan(
		outerPlan(plan), owners, query_scope_id, next_scope_id);
	if (innerPlan(plan) != outerPlan(plan)) {
		collect_match_owner_plan(
			innerPlan(plan), owners, query_scope_id, next_scope_id);
	}
}

[[nodiscard]] static bool base_match_target_var_translation_agrees(
		const Var* planner_target, const Var* executor_target,
		const Index executor_scanrelid,
		const BioseqStubOids& oids) noexcept {
	return planner_target != nullptr && executor_target != nullptr
		&& bioseq_is_concrete_rte_varno(planner_target->varno)
		&& planner_target->varattno > 0
		&& planner_target->varlevelsup == 0
		&& bms_is_empty(planner_target->varnullingrels)
		&& planner_target->vartype == oids.bioseq_seq_type_oid
		&& bioseq_is_concrete_rte_varno(executor_scanrelid)
		&& executor_target->varno == executor_scanrelid
		&& executor_target->varattno > 0
		&& executor_target->varlevelsup == 0
		&& bms_is_empty(executor_target->varnullingrels)
		&& executor_target->vartype == oids.bioseq_seq_type_oid
		&& planner_target->varattno == executor_target->varattno
		&& planner_target->vartype == executor_target->vartype
		&& planner_target->vartypmod == executor_target->vartypmod
		&& planner_target->varcollid == executor_target->varcollid;
}

[[nodiscard]] static bool base_match_site_var_translation_agrees(
		const Var* planner_argument, const Var* executor_argument,
		const Var* planner_target, const Var* executor_target,
		const BioseqMatchHelperBindingKind binding_kind,
		const BioseqStubOids& oids) noexcept {
	if (planner_argument == nullptr || executor_argument == nullptr
		|| planner_target == nullptr || executor_target == nullptr
		|| planner_argument->varlevelsup != 0
		|| executor_argument->varlevelsup != 0
		|| !bms_is_empty(planner_argument->varnullingrels)
		|| !bms_is_empty(executor_argument->varnullingrels)) return false;
	if (binding_kind == BioseqMatchHelperBindingKind::exact_recipe) {
		return planner_argument->vartype == oids.bioseq_seq_type_oid
			&& executor_argument->vartype == oids.bioseq_seq_type_oid
			&& equal(planner_argument, planner_target)
			&& equal(executor_argument, executor_target);
	}
	if (binding_kind != BioseqMatchHelperBindingKind::unique_lineage
		|| planner_argument->vartype == oids.bioseq_seq_type_oid
		|| executor_argument->vartype == oids.bioseq_seq_type_oid
		|| planner_argument->varno != planner_target->varno
		|| executor_argument->varno != executor_target->varno) return false;
	/* setrefs may offset the query-local RTE index, but it cannot change which
	 * physical attribute, type, typmod, or collation the row marker names. */
	return planner_argument->varattno == executor_argument->varattno
		&& planner_argument->vartype == executor_argument->vartype
		&& planner_argument->vartypmod == executor_argument->vartypmod
		&& planner_argument->varcollid == executor_argument->varcollid;
}

[[nodiscard]] static bool base_match_expression_translation_agrees(
		Node* planner_expression, Node* executor_expression,
		const Index planner_relid, const Index executor_relid) {
	if (planner_expression == nullptr || executor_expression == nullptr
		|| !bioseq_is_concrete_rte_varno(planner_relid)
		|| !bioseq_is_concrete_rte_varno(executor_relid)
		|| exprType(planner_expression) != exprType(executor_expression)
		|| exprTypmod(planner_expression) != exprTypmod(executor_expression)
		|| exprCollation(planner_expression)
			!= exprCollation(executor_expression)) return false;
	Node* translated = reinterpret_cast<Node*>(copyObject(planner_expression));
	ChangeVarNodes(translated, static_cast<int>(planner_relid),
		static_cast<int>(executor_relid), /*sublevels_up=*/0);
	return equal(translated, executor_expression);
}

[[nodiscard]] static bool base_match_target_expression_translation_agrees(
		Node* planner_target, Node* executor_target,
		const Index planner_relid, const Index executor_scanrelid,
		const BioseqStubOids& oids) {
	if (planner_target == nullptr || executor_target == nullptr
		|| exprType(planner_target) != oids.bioseq_seq_type_oid
		|| exprType(executor_target) != oids.bioseq_seq_type_oid
		|| !base_match_expression_translation_agrees(
			planner_target, executor_target,
			planner_relid, executor_scanrelid)) return false;
	List* planner_lineage = canonical_match_base_lineage(
		planner_target, oids);
	List* executor_lineage = canonical_match_base_lineage(
		executor_target, oids);
	if (planner_lineage == NIL
		|| list_length(planner_lineage) != list_length(executor_lineage)) {
		return false;
	}
	for (int index = 0; index < list_length(planner_lineage); ++index) {
		Var* planner_source = reinterpret_cast<Var*>(list_nth(
			planner_lineage, index));
		Var* executor_source = reinterpret_cast<Var*>(list_nth(
			executor_lineage, index));
		if (!base_match_target_var_translation_agrees(
				planner_source, executor_source, executor_scanrelid, oids)) {
			return false;
		}
	}
	return true;
}

[[nodiscard]] static bool base_match_site_expression_translation_agrees(
		Node* planner_argument, Node* executor_argument,
		Node* planner_target, Node* executor_target,
		const Index planner_relid, const Index executor_relid,
		const BioseqMatchHelperBindingKind binding_kind,
		const BioseqStubOids& oids) {
	if (planner_argument == nullptr || executor_argument == nullptr
		|| planner_target == nullptr || executor_target == nullptr) return false;
	if (binding_kind == BioseqMatchHelperBindingKind::exact_recipe) {
		return equal(planner_argument, planner_target)
			&& equal(executor_argument, executor_target)
			&& base_match_expression_translation_agrees(
				planner_argument, executor_argument,
				planner_relid, executor_relid);
	}
	if (binding_kind != BioseqMatchHelperBindingKind::unique_lineage) {
		return false;
	}
	Var* planner_var = pg_node_try_as<Var>(planner_argument);
	Var* executor_var = pg_node_try_as<Var>(executor_argument);
	if (planner_var == nullptr || executor_var == nullptr
		|| planner_var->varno != planner_relid
		|| executor_var->varno != executor_relid
		|| planner_var->varattno <= 0 || executor_var->varattno <= 0
		|| planner_var->varlevelsup != 0 || executor_var->varlevelsup != 0
		|| !bms_is_empty(planner_var->varnullingrels)
		|| !bms_is_empty(executor_var->varnullingrels)
		|| planner_var->varattno != executor_var->varattno
		|| planner_var->vartype != executor_var->vartype
		|| planner_var->vartypmod != executor_var->vartypmod
		|| planner_var->varcollid != executor_var->varcollid) return false;
	if (planner_var->vartype != oids.bioseq_seq_type_oid) return true;
	bool planner_member = false;
	for (Var* source : PList<Var>(
			canonical_match_base_lineage(planner_target, oids))) {
		if (equal(source, planner_var)) {
			planner_member = true;
			break;
		}
	}
	bool executor_member = false;
	for (Var* source : PList<Var>(
			canonical_match_base_lineage(executor_target, oids))) {
		if (equal(source, executor_var)) {
			executor_member = true;
			break;
		}
	}
	return planner_member && executor_member;
}

[[nodiscard]] static bool finalized_match_helper_argument_translation_agrees(
	CustomScan* scan, Node* translated, Node* canonical) noexcept;

export namespace bioseq::table::sql_routines {

[[bioseq_sql::function({
	.schema = bioseq::sql::fixed_schema<"bioseq_internal">,
	.create = bioseq::sql::create_mode::or_replace,
	.volatility = bioseq::sql::volatility::volatile_,
	.parallel = bioseq::sql::parallel_safety::unsafe,
})]]
[[bioseq_sql::revoke({
	.privileges = bioseq::sql::privileges::all,
	.from = bioseq::sql::public_role,
})]]
/** @brief Reports whether carrier translation accepts exact setrefs offsets and slots and rejects attribute, alias, slot, or range mismatches. */
bioseq::pg_utils::named_out<
	bioseq::table::base_match_executor_translation_probe_row>
base_match_executor_translation_probe() {
	const BioseqStubOids& oids = get_cached_stub_oids();
	constexpr Index planner_varno = 1;
	constexpr Index executor_varno = 9;
	Var* planner_target = makeVar(
		planner_varno, 1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/17, InvalidOid, 0);
	Var* executor_target = makeVar(
		executor_varno, 1, oids.bioseq_seq_type_oid,
		/*vartypmod=*/17, InvalidOid, 0);
	Var* wrong_target_attno = makeVar(
		executor_varno, 2, oids.bioseq_seq_type_oid,
		/*vartypmod=*/17, InvalidOid, 0);
	Var* planner_marker = makeVar(
		planner_varno, 2, INT4OID, -1, InvalidOid, 0);
	Var* executor_marker = makeVar(
		executor_varno, 2, INT4OID, -1, InvalidOid, 0);
	Var* wrong_alias_marker = makeVar(
		executor_varno + 1, 2, INT4OID, -1, InvalidOid, 0);
	Var* wrong_attno_marker = makeVar(
		executor_varno, 3, INT4OID, -1, InvalidOid, 0);
	const bool target_offset_accepted =
		base_match_target_var_translation_agrees(
			planner_target, executor_target, executor_varno, oids);
	const bool target_attno_disagreement_rejected =
		!base_match_target_var_translation_agrees(
			planner_target, wrong_target_attno, executor_varno, oids);
	const bool exact_site_offset_accepted =
		base_match_site_var_translation_agrees(
			planner_target, executor_target,
			planner_target, executor_target,
			BioseqMatchHelperBindingKind::exact_recipe, oids);
	const bool lineage_alias_disagreement_rejected =
		base_match_site_var_translation_agrees(
			planner_marker, executor_marker,
			planner_target, executor_target,
			BioseqMatchHelperBindingKind::unique_lineage, oids)
		&& !base_match_site_var_translation_agrees(
			planner_marker, wrong_alias_marker,
			planner_target, executor_target,
			BioseqMatchHelperBindingKind::unique_lineage, oids);

	auto* outer_source = makeNode(Result);
	outer_source->plan.targetlist = list_make2(
		makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(executor_marker)),
			/*resno=*/1, nullptr, false),
		makeTargetEntry(
			reinterpret_cast<Expr*>(copyObject(wrong_attno_marker)),
			/*resno=*/2, nullptr, false));
	auto* inner_source = makeNode(Result);
	inner_source->plan.targetlist = static_cast<List*>(copyObject(
		outer_source->plan.targetlist));
	auto* carrier_scan = makeNode(CustomScan);
	carrier_scan->custom_plans = list_make2(
		&outer_source->plan, &inner_source->plan);
	carrier_scan->custom_scan_tlist = static_cast<List*>(copyObject(
		outer_source->plan.targetlist));
	auto special_var = [](const Index varno, const AttrNumber attno) {
		return reinterpret_cast<Node*>(makeVar(
			varno, attno, INT4OID, -1, InvalidOid, 0));
	};
	const bool outer_slot_accepted =
		finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(OUTER_VAR, 1),
			reinterpret_cast<Node*>(planner_marker));
	const bool outer_wrong_slot_rejected =
		!finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(OUTER_VAR, 2),
			reinterpret_cast<Node*>(planner_marker));
	const bool inner_slot_accepted =
		finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(INNER_VAR, 1),
			reinterpret_cast<Node*>(planner_marker));
	const bool inner_wrong_slot_rejected =
		!finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(INNER_VAR, 2),
			reinterpret_cast<Node*>(planner_marker));
	const bool index_slot_accepted =
		finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(INDEX_VAR, 1),
			reinterpret_cast<Node*>(planner_marker));
	const bool index_wrong_slot_rejected =
		!finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(INDEX_VAR, 2),
			reinterpret_cast<Node*>(planner_marker));
	const bool special_out_of_range_rejected =
		!finalized_match_helper_argument_translation_agrees(
			carrier_scan, special_var(OUTER_VAR, 3),
			reinterpret_cast<Node*>(planner_marker));
	return bioseq::pg_utils::named_out{
		bioseq::table::base_match_executor_translation_probe_row{
			.target_offset_accepted = target_offset_accepted,
			.target_attno_disagreement_rejected =
				target_attno_disagreement_rejected,
			.exact_site_offset_accepted =
				exact_site_offset_accepted,
			.lineage_alias_disagreement_rejected =
				lineage_alias_disagreement_rejected,
			.outer_slot_accepted = outer_slot_accepted,
			.outer_wrong_slot_rejected =
				outer_wrong_slot_rejected,
			.inner_slot_accepted = inner_slot_accepted,
			.inner_wrong_slot_rejected =
				inner_wrong_slot_rejected,
			.index_slot_accepted = index_slot_accepted,
			.index_wrong_slot_rejected =
				index_wrong_slot_rejected,
			.special_out_of_range_rejected =
				special_out_of_range_rejected,
		}};
}

}  // namespace bioseq::table::sql_routines

static void finalize_base_match_owner_executor_image(
		MatchOwnerFinalization& owner, const BioseqStubOids& oids) {
	if (owner.base_owner_tag == NIL) return;
	CustomScan* scan = owner.scan;
	Node* existing_descriptor = reinterpret_cast<Node*>(list_nth(
		owner.base_owner_tag, kBaseMatchPlanExecutorDescriptor));
	Node* existing_sites = reinterpret_cast<Node*>(list_nth(
		owner.base_owner_tag, kBaseMatchPlanExecutorSites));
	Node* owned_quals_node = scan == nullptr
		|| list_length(scan->custom_exprs) <= 3
		? nullptr : reinterpret_cast<Node*>(list_nth(scan->custom_exprs, 3));
	List* owned_quals = owned_quals_node != nullptr
		&& IsA(owned_quals_node, List)
		? reinterpret_cast<List*>(owned_quals_node) : NIL;
	FuncExpr* mmsearch = list_length(owned_quals) >= 1
		? pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(linitial(owned_quals)))
		: nullptr;
	Node* executor_target = mmsearch != nullptr
		&& is_mmsearch_funcid(mmsearch->funcid, oids)
		&& list_length(mmsearch->args) >= 1
		? reinterpret_cast<Node*>(linitial(mmsearch->args))
		: nullptr;
	Node* planner_target = owner.target_recipe;
	if (scan == nullptr || existing_descriptor != nullptr
		|| existing_sites != nullptr || planner_target == nullptr
		|| executor_target == nullptr
		|| !base_match_target_expression_translation_agrees(
			planner_target, executor_target, owner.legacy_target_relid,
			scan->scan.scanrelid, oids)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqScan post-setrefs match owner identity disagrees with its planner descriptor")));
	}

	List* executor_descriptor = make_match_owner_descriptor(
		executor_target, scan->scan.scanrelid, oids);
	match_binding_integer(executor_descriptor,
		kMatchOwnerStableId, "executor_owner.stable_id")->ival =
		owner.stable_match_id;
	List* executor_lineage = canonical_match_base_lineage(
		executor_target, oids);
	Var* executor_primary_source = executor_lineage == NIL ? nullptr
		: reinterpret_cast<Var*>(linitial(executor_lineage));
	if (executor_primary_source == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqScan post-setrefs match owner lineage is empty")));
	}
	List* executor_sites = collect_base_match_helper_sites(
		scan->scan.plan.targetlist, executor_target,
		scan->scan.scanrelid, executor_primary_source->varattno, oids);
	if (list_length(executor_sites) != list_length(owner.sites)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqScan post-setrefs match helper sites disagree with planner sites"),
			 errdetail("planner_sites=%d executor_sites=%d",
				list_length(owner.sites), list_length(executor_sites))));
	}
	for (int index = 0; index < list_length(owner.sites); ++index) {
		List* planner_site = reinterpret_cast<List*>(list_nth(
			owner.sites, index));
		List* executor_site = reinterpret_cast<List*>(list_nth(
			executor_sites, index));
		if (planner_site == nullptr || executor_site == nullptr
			|| !IsA(planner_site, List) || !IsA(executor_site, List)
			|| list_length(planner_site) != kBioseqMatchHelperSiteFields
			|| list_length(executor_site) != kBioseqMatchHelperSiteFields) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan post-setrefs match helper site codec is invalid")));
		}
		for (const int integer_index : {
				kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
				kMatchSiteCollation, kMatchSiteBindingKind,
				kMatchSitePhid, kMatchSiteStableId}) {
			(void)match_binding_integer(
				planner_site, integer_index, "planner_helper.site_integer");
			(void)match_binding_integer(
				executor_site, integer_index, "executor_helper.site_integer");
		}
		const auto binding_kind = static_cast<BioseqMatchHelperBindingKind>(
			intVal(list_nth(planner_site, kMatchSiteBindingKind)));
		Node* planner_argument = reinterpret_cast<Node*>(
			list_nth(planner_site, kMatchSiteCanonicalArgument));
		Node* executor_argument = reinterpret_cast<Node*>(
			list_nth(executor_site, kMatchSiteCanonicalArgument));
		const bool integer_identity_agrees =
			intVal(list_nth(planner_site, kMatchSiteResno))
				== intVal(list_nth(executor_site, kMatchSiteResno))
			&& intVal(list_nth(planner_site, kMatchSiteFuncid))
				== intVal(list_nth(executor_site, kMatchSiteFuncid))
			&& intVal(list_nth(planner_site, kMatchSiteTypmod))
				== intVal(list_nth(executor_site, kMatchSiteTypmod))
			&& intVal(list_nth(planner_site, kMatchSiteCollation))
				== intVal(list_nth(executor_site, kMatchSiteCollation))
			&& intVal(list_nth(planner_site, kMatchSitePhid))
				== intVal(list_nth(executor_site, kMatchSitePhid));
		if (!integer_identity_agrees
			|| intVal(list_nth(planner_site, kMatchSiteStableId))
				!= owner.stable_match_id
			|| !base_match_site_expression_translation_agrees(
				planner_argument, executor_argument,
				planner_target, executor_target,
				owner.legacy_target_relid, scan->scan.scanrelid,
				binding_kind, oids)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan post-setrefs match helper identity disagrees with its planner site"),
				 errdetail("site_index=%d", index)));
		}
		match_binding_integer(executor_site,
			kMatchSiteBindingKind, "executor_helper.binding_kind")->ival =
			static_cast<int>(binding_kind);
		match_binding_integer(executor_site,
			kMatchSiteStableId, "executor_helper.stable_id")->ival =
			owner.stable_match_id;
	}

	lfirst(list_nth_cell(owner.base_owner_tag,
		kBaseMatchPlanExecutorDescriptor)) = executor_descriptor;
	lfirst(list_nth_cell(owner.base_owner_tag,
		kBaseMatchPlanExecutorSites)) = executor_sites;
}

static void finalize_match_owner_bindings(
		std::span<MatchOwnerFinalization> owners) {
	const BioseqStubOids& oids = get_cached_stub_oids();
#ifdef BIOSEQ_TEST_INDEXES
	verify_match_owner_scope_resolution(oids);
#endif
	Bitmapset* stable_ids = nullptr;
	std::size_t owner_index = 0u;
	for (MatchOwnerFinalization& owner : owners) {
		/* set_plan_references() may assign zero to the root Plan.  The stable
		 * owner ABI is the exact plan_node_id, so only negative ids are invalid
		 * and zero must participate in duplicate detection like every other id. */
		const bool duplicate_stable_id = owner.stable_match_id >= 0
			&& bms_is_member(owner.stable_match_id, stable_ids);
		if (owner.scan == nullptr || owner.descriptor == NIL
			|| owner.target_recipe == nullptr
			|| !bioseq_is_concrete_rte_varno(owner.legacy_target_relid)
			|| owner.stable_match_id < 0
			|| owner.query_scope_id == 0u
			|| duplicate_stable_id) {
			const char* custom_name = owner.scan == nullptr
				|| owner.scan->methods == nullptr
				? "<none>" : owner.scan->methods->CustomName;
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("Bioseq final match owner identity is invalid"),
				 errdetail("owner_index=%zu custom_name=%s scan_present=%s descriptor_present=%s target_recipe_present=%s legacy_target_relid=%u stable_match_id=%d query_scope_id=" UINT64_FORMAT " duplicate_stable_id=%s",
					owner_index,
					custom_name == nullptr ? "<none>" : custom_name,
					owner.scan == nullptr ? "false" : "true",
					owner.descriptor == NIL ? "false" : "true",
					owner.target_recipe == nullptr ? "false" : "true",
					static_cast<unsigned int>(owner.legacy_target_relid),
					owner.stable_match_id,
					static_cast<uint64>(owner.query_scope_id),
					duplicate_stable_id ? "true" : "false")));
		}
		stable_ids = bms_add_member(stable_ids, owner.stable_match_id);
		match_binding_integer(owner.descriptor,
			kMatchOwnerStableId, "owner.stable_id")->ival =
			owner.stable_match_id;
		++owner_index;
	}
	if (stable_ids != nullptr) bms_free(stable_ids);

	for (MatchOwnerFinalization& site_owner : owners) {
		for (List* site : PList<List>(site_owner.sites)) {
			if (site == nullptr || !IsA(site, List)
				|| list_length(site) != kBioseqMatchHelperSiteFields) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("Bioseq match helper site codec is invalid")));
			}
			for (const int integer_index : {
					kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
					kMatchSiteCollation, kMatchSiteBindingKind,
					kMatchSitePhid, kMatchSiteStableId}) {
				(void)match_binding_integer(
					site, integer_index, "helper.site_integer");
			}
			Node* argument = reinterpret_cast<Node*>(list_nth(
				site, kMatchSiteCanonicalArgument));
			const MatchSiteResolution resolution =
				resolve_match_helper_site(
					site_owner, argument, owners, oids);
			if (resolution.status == MatchSiteResolutionStatus::ambiguous) {
				const Oid funcid = static_cast<Oid>(intVal(
					match_binding_integer(
						site, kMatchSiteFuncid, "helper.funcid")));
				const char* function_name = get_func_name(funcid);
				ereport(ERROR,
					(errcode(ERRCODE_AMBIGUOUS_COLUMN),
					 errmsg("bioseq match-result helper binding is ambiguous"),
					 errdetail("helper=%s candidate_match_owners=%zu",
						function_name == nullptr ? "<unknown>" : function_name,
						resolution.candidate_count),
					 errhint("Pass the exact transformed target recipe to each helper when more than one mmsearch owner shares a base lineage.")));
			}
			if (resolution.status != MatchSiteResolutionStatus::bound
				|| resolution.owner != &site_owner) {
				ereport(ERROR,
					(errcode(ERRCODE_INVALID_COLUMN_REFERENCE),
					 errmsg("bioseq match-result helper does not identify its mmsearch owner"),
					 errhint("Use the exact mmsearch target recipe or its unique base source lineage.")));
			}
			match_binding_integer(site,
				kMatchSiteBindingKind, "helper.binding_kind")->ival =
				static_cast<int>(resolution.kind);
			match_binding_integer(site,
				kMatchSiteStableId, "helper.stable_id")->ival =
				site_owner.stable_match_id;
		}
	}
	for (MatchOwnerFinalization& owner : owners) {
		finalize_base_match_owner_executor_image(owner, oids);
	}
}

static void neutralize_ancestor_owned_dummy_match_helpers(
	PlannedStmt* statement,
	std::span<MatchOwnerFinalization> owners);

export void bioseq_finalize_match_helper_bindings(PlannedStmt* statement) {
	if (statement == nullptr || statement->planTree == nullptr
		|| !OidIsValid(get_extension_oid("bioseq", /*missing_ok=*/true))) {
		return;
	}
	ErrorData* exact_error = nullptr;
	{
#ifdef BIOSEQ_TEST_INDEXES
		[[maybe_unused]] MatchOwnerFinalizationScopeGuard scope_guard;
#endif
		std::vector<MatchOwnerFinalization> owners;
		try {
			/* This callback is below PostgreSQL's sigsetjmp boundary.  Every local
			 * it reaches is either PostgreSQL-owned (List/Bitmapset) or statically
			 * trivially destructible (span/fixed fixture/scalars).  The sole heap-
			 * owning C++ container is this outer vector, which remains above the
			 * boundary and therefore unwinds after a translated PG error. */
			bioseq::pg_utils::invoke_pg_as_cpp([&] {
				std::uint64_t next_scope_id = 1u;
				const std::uint64_t statement_scope =
					allocate_match_owner_scope(next_scope_id);
				collect_match_owner_plan(
					statement->planTree, owners, statement_scope, next_scope_id);
				for (Plan* subplan : PList<Plan>(statement->subplans)) {
					const std::uint64_t subplan_scope =
						allocate_match_owner_scope(next_scope_id);
					collect_match_owner_plan(
						subplan, owners, subplan_scope, next_scope_id);
				}
				if (!owners.empty()) {
					finalize_match_owner_bindings(
						std::span<MatchOwnerFinalization>{owners});
					neutralize_ancestor_owned_dummy_match_helpers(
						statement,
						std::span<MatchOwnerFinalization>{owners});
				}
			});
		} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
			exact_error = error.release_error_data();
		}
	}
	/* Re-enter PostgreSQL's error ABI only after the vector and every other C++
	 * owner in the finalization scope have been destroyed. */
	if (exact_error != nullptr) ReThrowError(exact_error);
}

export namespace bioseq::table::sql_routines {

[[bioseq_sql::function({
	.schema = bioseq::sql::fixed_schema<"bioseq_internal">,
	.create = bioseq::sql::create_mode::or_replace,
	.volatility = bioseq::sql::volatility::volatile_,
	.parallel = bioseq::sql::parallel_safety::unsafe,
})]]
[[bioseq_sql::revoke({
	.privileges = bioseq::sql::privileges::all,
	.from = bioseq::sql::public_role,
})]]
/** @brief Returns and optionally resets counters for match-owner finalization scopes across PostgreSQL errors. */
bioseq::pg_utils::named_out<
	bioseq::table::match_owner_finalization_scope_diagnostics_row>
match_owner_finalization_scope_diagnostics(bool reset) {
#ifdef BIOSEQ_TEST_INDEXES
	if (reset) {
		MatchOwnerFinalizationScopesEntered = 0u;
		MatchOwnerFinalizationScopesExited = 0u;
	}
	const std::uint64_t active = MatchOwnerFinalizationScopesEntered
		>= MatchOwnerFinalizationScopesExited
		? MatchOwnerFinalizationScopesEntered
			- MatchOwnerFinalizationScopesExited
		: std::numeric_limits<std::uint64_t>::max();
	return bioseq::pg_utils::named_out{
		bioseq::table::
			match_owner_finalization_scope_diagnostics_row{
				.scopes_entered = static_cast<std::int64_t>(
					MatchOwnerFinalizationScopesEntered),
				.scopes_exited = static_cast<std::int64_t>(
					MatchOwnerFinalizationScopesExited),
				.scopes_active =
					static_cast<std::int64_t>(active),
			}};
#else
	static_cast<void>(reset);
	bioseq::pg_utils::raise_sql_error(
		ERRCODE_FEATURE_NOT_SUPPORTED,
		{
			.message =
				"match-owner finalization diagnostics require a test build",
			.detail =
				"The extension was built without BIOSEQ_TEST_INDEXES.",
		});
#endif
}

}  // namespace bioseq::table::sql_routines

[[nodiscard]] static int validate_finalized_match_owner_descriptor_value(
		CustomScan* scan, List* descriptor) {
	if (scan == nullptr || descriptor == NIL) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq finalized match owner descriptor is missing")));
	}
	const int stable_id = intVal(match_binding_integer(
		descriptor, kMatchOwnerStableId, "owner.stable_id"));
	Node* recipe = list_length(descriptor) == kBioseqMatchOwnerDescriptorFields
		? reinterpret_cast<Node*>(list_nth(
			descriptor, kMatchOwnerTargetRecipe)) : nullptr;
	Node* lineage = list_length(descriptor) == kBioseqMatchOwnerDescriptorFields
		? reinterpret_cast<Node*>(list_nth(
			descriptor, kMatchOwnerBaseLineage)) : nullptr;
	if (list_length(descriptor) != kBioseqMatchOwnerDescriptorFields
		|| intVal(match_binding_integer(
			descriptor, kMatchOwnerMagic, "owner.magic"))
			!= kBioseqMatchOwnerDescriptorMagic
		|| intVal(match_binding_integer(
			descriptor, kMatchOwnerVersion, "owner.version"))
			!= kBioseqMatchOwnerDescriptorVersion
		|| stable_id < 0 || stable_id != scan->scan.plan.plan_node_id
		|| recipe == nullptr || (lineage != nullptr && !IsA(lineage, List))
		|| !bioseq_is_concrete_rte_varno(static_cast<Index>(intVal(
			match_binding_integer(descriptor,
				kMatchOwnerLegacyTargetRelid,
				"owner.legacy_target_relid"))))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("Bioseq finalized match owner descriptor is invalid")));
	}
	return stable_id;
}

[[nodiscard]] static int validate_finalized_match_owner_descriptor(
		CustomScan* scan, const int descriptor_index) {
	Node* descriptor_node = scan == nullptr || descriptor_index < 0
		|| descriptor_index >= list_length(scan->custom_private)
		? nullptr : reinterpret_cast<Node*>(list_nth(
			scan->custom_private, descriptor_index));
	if (descriptor_node == nullptr || !IsA(descriptor_node, List)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Bioseq finalized match owner descriptor is missing")));
	}
	return validate_finalized_match_owner_descriptor_value(
		scan, reinterpret_cast<List*>(descriptor_node));
}

[[nodiscard]] static Node* initialize_base_match_owner_runtime(
		CustomScan* scan, Relation relation, BioseqScanRuntime& runtime) {
	List* owner_tag = find_base_match_owner_plan_tag(scan);
	if (owner_tag == NIL) return nullptr;
	if (relation == nullptr
		|| RelationGetRelid(relation) != static_cast<Oid>(intVal(
			match_binding_integer(owner_tag, kBaseMatchPlanRelationOid,
				"owner.target_relation_oid")))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan match owner relation identity is invalid")));
	}
	Node* descriptor_node = reinterpret_cast<Node*>(list_nth(
		owner_tag, kBaseMatchPlanExecutorDescriptor));
	Node* sites_node = reinterpret_cast<Node*>(list_nth(
		owner_tag, kBaseMatchPlanExecutorSites));
	if (descriptor_node == nullptr || !IsA(descriptor_node, List)
		|| (sites_node != nullptr && !IsA(sites_node, List))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan finalized executor match owner image is missing")));
	}
	List* descriptor = reinterpret_cast<List*>(descriptor_node);
	runtime.stable_match_id =
		validate_finalized_match_owner_descriptor_value(scan, descriptor);
	Node* target_recipe = reinterpret_cast<Node*>(
		list_nth(descriptor, kMatchOwnerTargetRecipe));
	TupleDesc relation_descriptor = RelationGetDescr(relation);
	const BioseqStubOids& oids = get_cached_stub_oids();
	List* target_lineage = canonical_match_base_lineage(target_recipe, oids);
	Var* primary_source = target_lineage == NIL ? nullptr
		: reinterpret_cast<Var*>(linitial(target_lineage));
	bool lineage_valid = primary_source != nullptr;
	for (Var* source : PList<Var>(target_lineage)) {
		Form_pg_attribute attribute = source != nullptr
			&& source->varattno > 0
			&& source->varattno <= relation_descriptor->natts
			? TupleDescAttr(relation_descriptor, source->varattno - 1)
			: nullptr;
		if (source == nullptr || source->varno != scan->scan.scanrelid
			|| source->varattno <= 0 || source->varlevelsup != 0
			|| !bms_is_empty(source->varnullingrels)
			|| source->vartype != oids.bioseq_seq_type_oid
			|| attribute == nullptr || attribute->attisdropped
			|| attribute->atttypid != source->vartype
			|| attribute->atttypmod != source->vartypmod
			|| attribute->attcollation != source->varcollid) {
			lineage_valid = false;
			break;
		}
	}
	const BaseLocalSequenceTypmodResolution target_type =
		base_local_sequence_typmod_resolution(target_recipe, oids);
	if (target_recipe == nullptr
		|| exprType(target_recipe) != oids.bioseq_seq_type_oid
		|| !lineage_valid || target_type.invalid || target_type.typmod < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan match owner target recipe is invalid")));
	}
	runtime.match_target_recipe = target_recipe;
	runtime.match_target_lineage = target_lineage;
	runtime.match_target_typmod = target_type.typmod;
	runtime.match_target_evaluated = pg_node_try_as<Var>(target_recipe) == nullptr;
	runtime.match_sequence_varno = primary_source->varno;
	runtime.match_sequence_attno = primary_source->varattno;
	runtime.match_helper_sites = sites_node == nullptr
		? NIL : reinterpret_cast<List*>(sites_node);
	for (List* site : PList<List>(runtime.match_helper_sites)) {
		if (site == nullptr || !IsA(site, List)
			|| list_length(site) != kBioseqMatchHelperSiteFields) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan match helper site ABI is invalid")));
		}
		for (const int integer_index : {
				kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
				kMatchSiteCollation, kMatchSiteBindingKind,
				kMatchSitePhid, kMatchSiteStableId}) {
			(void)match_binding_integer(
				site, integer_index, "helper.site_integer");
		}
		const int resno = intVal(list_nth(site, kMatchSiteResno));
		const Oid funcid = static_cast<Oid>(intVal(list_nth(
			site, kMatchSiteFuncid)));
		const auto binding_kind = static_cast<BioseqMatchHelperBindingKind>(
			intVal(list_nth(site, kMatchSiteBindingKind)));
		Node* argument_node = reinterpret_cast<Node*>(
			list_nth(site, kMatchSiteCanonicalArgument));
		Var* argument = pg_node_try_as<Var>(argument_node);
		const bool exact_sequence_argument = argument_node != nullptr
			&& exprType(argument_node) == oids.bioseq_seq_type_oid
			&& equal(argument_node, target_recipe)
			&& binding_kind == BioseqMatchHelperBindingKind::exact_recipe;
		bool legacy_lineage_argument = argument != nullptr
			&& argument->varno == scan->scan.scanrelid
			&& argument->varattno > 0 && argument->varlevelsup == 0
			&& bms_is_empty(argument->varnullingrels)
			&& binding_kind == BioseqMatchHelperBindingKind::unique_lineage;
		if (legacy_lineage_argument
			&& argument->vartype == oids.bioseq_seq_type_oid) {
			legacy_lineage_argument = false;
			for (Var* source : PList<Var>(target_lineage)) {
				if (equal(source, argument)) {
					legacy_lineage_argument = true;
					break;
				}
			}
		}
		if (resno <= 0 || resno > list_length(scan->scan.plan.targetlist)
			|| !is_bioseq_projection_funcid(funcid, oids)
			|| get_func_rettype(funcid) == InvalidOid
			|| (!exact_sequence_argument && !legacy_lineage_argument)
			|| intVal(list_nth(site, kMatchSitePhid)) != 0
			|| intVal(list_nth(site, kMatchSiteStableId))
				!= runtime.stable_match_id) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan finalized match helper site is invalid")));
		}
	}
	return target_recipe;
}

[[nodiscard]] static TargetEntry* finalized_match_helper_resno_entry(
		List* targetlist, const AttrNumber resno) noexcept {
	if (resno <= 0) return nullptr;
	for (TargetEntry* entry : PList<TargetEntry>(targetlist)) {
		if (entry != nullptr && entry->resno == resno) return entry;
	}
	return nullptr;
}

[[nodiscard]] static bool
finalized_match_helper_argument_translation_agrees_impl(
		Plan* context, Node* translated, Node* canonical,
		const unsigned int depth) noexcept {
	if (depth > 16u) return false;
	if (translated == nullptr || canonical == nullptr) return false;
	Var* translated_var = pg_node_try_as<Var>(translated);
	Var* canonical_var = pg_node_try_as<Var>(canonical);
	if (equal(translated, canonical)) {
		return canonical_var == nullptr
			|| bioseq_is_concrete_rte_varno(canonical_var->varno);
	}
	if (translated_var == nullptr || canonical_var == nullptr
		|| translated_var->varattno <= 0 || canonical_var->varattno <= 0
		|| translated_var->varlevelsup != canonical_var->varlevelsup
		|| !bms_is_empty(translated_var->varnullingrels)
		|| !bms_is_empty(canonical_var->varnullingrels)
		|| translated_var->vartype != canonical_var->vartype
		|| translated_var->vartypmod != canonical_var->vartypmod
		|| translated_var->varcollid != canonical_var->varcollid) return false;
	if (!bioseq_is_concrete_rte_varno(canonical_var->varno)) return false;
	/* A concrete Var can only differ by the statement rtable offset and must
	 * retain its physical attribute identity. */
	if (bioseq_is_concrete_rte_varno(translated_var->varno)) {
		return translated_var->varattno == canonical_var->varattno;
	}
	if (context == nullptr) return false;

	List* source_tlist = NIL;
	Plan* source_context = context;
	if (translated_var->varno == INDEX_VAR) {
		if (!IsA(context, CustomScan)) return false;
		source_tlist = reinterpret_cast<CustomScan*>(context)
			->custom_scan_tlist;
	} else {
		Plan* child = nullptr;
		if (IsA(context, CustomScan)) {
			List* children = reinterpret_cast<CustomScan*>(context)->custom_plans;
			const int child_index = translated_var->varno == OUTER_VAR ? 0
				: (translated_var->varno == INNER_VAR ? 1 : -1);
			child = child_index >= 0 && child_index < list_length(children)
				? reinterpret_cast<Plan*>(list_nth(children, child_index))
				: nullptr;
		} else if (translated_var->varno == OUTER_VAR) {
			child = outerPlan(context);
		} else if (translated_var->varno == INNER_VAR) {
			child = innerPlan(context);
		} else {
			return false;
		}
		if (child == nullptr) return false;
		source_context = child;
		source_tlist = child->targetlist;
	}
	TargetEntry* source = finalized_match_helper_resno_entry(
		source_tlist, translated_var->varattno);
	Node* source_expression = source == nullptr
		? nullptr : reinterpret_cast<Node*>(source->expr);
	if (source_expression == nullptr
		|| exprType(source_expression) != translated_var->vartype
		|| exprTypmod(source_expression) != translated_var->vartypmod
		|| exprCollation(source_expression) != translated_var->varcollid
		|| equal(source_expression, translated)) return false;
	/* Resolve the exact setrefs slot rather than accepting its type metadata as
	 * provenance.  A nested special Var is followed only through the concrete
	 * child/scan tlist which owns that slot; cycles and unsupported INDEX_VAR
	 * namespaces fail closed. */
	return finalized_match_helper_argument_translation_agrees_impl(
		source_context, source_expression, canonical, depth + 1u);
}

[[nodiscard]] static bool finalized_match_helper_argument_translation_agrees(
		CustomScan* scan, Node* translated, Node* canonical) noexcept {
	return finalized_match_helper_argument_translation_agrees_impl(
		scan == nullptr ? nullptr : &scan->scan.plan,
		translated, canonical, 0u);
}

[[nodiscard]] constexpr bool finalized_match_helper_carrier_shape_supported(
		const int site_phid, const bool supplied_is_phv,
		const int supplied_phid, const bool supplied_is_nulling_phv,
		const bool carrier_is_phv, const bool identities_equal) noexcept {
	if (site_phid < 0 || carrier_is_phv) return false;
	if (site_phid == 0) return !supplied_is_phv && identities_equal;
	if (!supplied_is_phv) return true; /* setrefs stripped the encoded PHV */
	return !supplied_is_nulling_phv && supplied_phid == site_phid;
}

static_assert(finalized_match_helper_carrier_shape_supported(
	0, false, 0, false, false, true));
static_assert(!finalized_match_helper_carrier_shape_supported(
	0, false, 0, false, false, false));
static_assert(finalized_match_helper_carrier_shape_supported(
	7, true, 7, false, false, false));
static_assert(!finalized_match_helper_carrier_shape_supported(
	7, true, 8, false, false, false));
static_assert(!finalized_match_helper_carrier_shape_supported(
	7, true, 7, true, false, false));
static_assert(finalized_match_helper_carrier_shape_supported(
	7, false, 0, false, false, false));
static_assert(!finalized_match_helper_carrier_shape_supported(
	7, false, 0, false, true, true));

/* custom_scan_tlist, custom_private, and a descendant dummy targetlist cross
 * different setrefs coordinate domains.  A phid-zero site accepts only the
 * exact bare identity.  A positive phid accepts either its live non-nulling
 * owner PHV or the bare descriptor produced when setrefs strips that PHV;
 * both require the leaf carrier's exact canonical argument and full function
 * ABI.  A carrier-side PHV is never a dummy leaf carrier. */
[[nodiscard]] static bool finalized_match_helper_carrier_equivalent(
		CustomScan* scan, Node* supplied_identity, Node* carrier_identity,
		Node* canonical_argument, const int site_phid,
		const BioseqStubOids& oids) noexcept {
	if (scan == nullptr || supplied_identity == nullptr
		|| carrier_identity == nullptr
		|| canonical_argument == nullptr) return false;
	PlaceHolderVar* supplied_phv = pg_node_try_as<PlaceHolderVar>(
		supplied_identity);
	PlaceHolderVar* carrier_phv = pg_node_try_as<PlaceHolderVar>(
		carrier_identity);
	const bool identities_equal = equal(supplied_identity, carrier_identity);
	if (!finalized_match_helper_carrier_shape_supported(
			site_phid, supplied_phv != nullptr,
			supplied_phv == nullptr ? 0 : static_cast<int>(supplied_phv->phid),
			supplied_phv != nullptr
				&& !bms_is_empty(supplied_phv->phnullingrels),
			carrier_phv != nullptr, identities_equal)) return false;
	FuncExpr* supplied = supplied_phv == nullptr
		? batch_join_well_formed_match_helper(supplied_identity, oids)
		: batch_join_match_helper_phv_function(supplied_phv, oids);
	FuncExpr* carrier = carrier_phv == nullptr
		? batch_join_well_formed_match_helper(carrier_identity, oids)
		: batch_join_match_helper_phv_function(carrier_phv, oids);
	if (supplied == nullptr || carrier == nullptr) return false;
	Node* supplied_argument = batch_join_match_helper_argument(supplied);
	Node* carrier_argument = batch_join_match_helper_argument(carrier);
	if (supplied_argument == nullptr || carrier_argument == nullptr) return false;
	const bool metadata_agrees = supplied->funcid == carrier->funcid
		&& supplied->funcresulttype == carrier->funcresulttype
		&& supplied->funcretset == carrier->funcretset
		&& supplied->funcvariadic == carrier->funcvariadic
		&& supplied->funcformat == carrier->funcformat
		&& supplied->funccollid == carrier->funccollid
		&& supplied->inputcollid == carrier->inputcollid
		&& exprTypmod(supplied_identity) == exprTypmod(carrier_identity)
		&& exprCollation(supplied_identity)
			== exprCollation(carrier_identity);
	if (!metadata_agrees) return false;
	if (site_phid == 0) return identities_equal;
	return equal(carrier_argument, canonical_argument)
		&& finalized_match_helper_argument_translation_agrees(
			scan, supplied_argument, canonical_argument);
}

struct FinalizedMatchHelperCarrierAudit {
	bool inspected = false;
	int early_reject = 0;
	int version = -1;
	int private_fields = -1;
	int expected_fields = -1;
	int descriptor_tag = -1;
	int sites_tag = -1;
	int site_count = -1;
	int supplied_tag = -1;
	int carrier_tag = -1;
	int supplied_argument_tag = -1;
	int carrier_argument_tag = -1;
	int canonical_argument_tag = -1;
	int site_resno = -1;
	int site_phid = -1;
	int supplied_phid = 0;
	int carrier_phid = 0;
	bool identity_equal = false;
	bool supplied_argument_canonical = false;
	bool carrier_argument_canonical = false;
	bool equivalent = false;
};

[[nodiscard]] static std::size_t
finalized_batch_owner_matching_site_count(
		CustomScan* scan, Node* identity,
		const BioseqStubOids& oids,
		FinalizedMatchHelperCarrierAudit* audit = nullptr) {
	if (audit != nullptr) {
		audit->private_fields = scan == nullptr
			? -1 : list_length(scan->custom_private);
		audit->carrier_tag = identity == nullptr
			? -1 : static_cast<int>(nodeTag(identity));
	}
	if (scan == nullptr || identity == nullptr
		|| scan->methods == nullptr || scan->methods->CustomName == nullptr
		|| strcmp(scan->methods->CustomName, "BioseqBatchJoin") != 0
		|| scan->custom_private == NIL) {
		if (audit != nullptr) audit->early_reject = 1;
		return 0u;
	}
	Node* version_node = reinterpret_cast<Node*>(
		linitial(scan->custom_private));
	if (version_node == nullptr || !IsA(version_node, Integer)) {
		if (audit != nullptr) audit->early_reject = 2;
		return 0u;
	}
	const int version = intVal(version_node);
	const int expected_fields = version == kBioseqBatchJoinPlanVersion
		? kBioseqBatchJoinPrivateFields
		: (version == kBioseqPerRowJoinPlanVersion
			? kBioseqPerRowJoinPrivateFields : -1);
	const int descriptor_index = version == kBioseqBatchJoinPlanVersion
		? kBatchJoinMatchOwnerDescriptor
		: (version == kBioseqPerRowJoinPlanVersion
			? kPerRowMatchOwnerDescriptor : -1);
	const int sites_index = version == kBioseqBatchJoinPlanVersion
		? kBatchJoinPlaceholderSites
		: (version == kBioseqPerRowJoinPlanVersion
			? kPerRowPlaceholderSites : -1);
	if (audit != nullptr) {
		audit->version = version;
		audit->expected_fields = expected_fields;
	}
	if (expected_fields < 0
		|| list_length(scan->custom_private) != expected_fields
		|| descriptor_index < 0 || sites_index < 0) {
		if (audit != nullptr) audit->early_reject = 3;
		return 0u;
	}
	Node* descriptor_node = reinterpret_cast<Node*>(list_nth(
		scan->custom_private, descriptor_index));
	Node* sites_node = reinterpret_cast<Node*>(list_nth(
		scan->custom_private, sites_index));
	if (audit != nullptr) {
		audit->descriptor_tag = descriptor_node == nullptr
			? -1 : static_cast<int>(nodeTag(descriptor_node));
		audit->sites_tag = sites_node == nullptr
			? -1 : static_cast<int>(nodeTag(sites_node));
	}
	if (descriptor_node == nullptr || !IsA(descriptor_node, List)) {
		if (audit != nullptr) audit->early_reject = 4;
		return 0u;
	}
	if (sites_node == nullptr || !IsA(sites_node, List)) {
		if (audit != nullptr) audit->early_reject = 5;
		return 0u;
	}
	if (audit != nullptr) {
		audit->site_count = list_length(reinterpret_cast<List*>(sites_node));
	}
	const int stable_match_id = validate_finalized_match_owner_descriptor_value(
		scan, reinterpret_cast<List*>(descriptor_node));
	PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
	FuncExpr* helper = placeholder == nullptr
		? batch_join_well_formed_match_helper(identity, oids)
		: batch_join_match_helper_phv_function(placeholder, oids);
	if (helper == nullptr
		|| exprType(identity) != helper->funcresulttype
		|| helper->funcresulttype != get_func_rettype(helper->funcid)) {
		if (audit != nullptr) audit->early_reject = 6;
		return 0u;
	}
	Node* helper_argument = batch_join_match_helper_argument(helper);
	std::size_t matches = 0u;
	for (Node* raw_site : PList<Node>(reinterpret_cast<List*>(sites_node))) {
		List* site = raw_site != nullptr && IsA(raw_site, List)
			? reinterpret_cast<List*>(raw_site) : NIL;
		if (list_length(site) != kBioseqMatchHelperSiteFields) return 2u;
		bool integers_valid = true;
		for (const int index : {
				kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
				kMatchSiteCollation, kMatchSiteBindingKind,
				kMatchSitePhid, kMatchSiteStableId}) {
			Node* value = reinterpret_cast<Node*>(list_nth(site, index));
			integers_valid = integers_valid
				&& value != nullptr && IsA(value, Integer);
		}
		Node* canonical_argument = reinterpret_cast<Node*>(list_nth(
			site, kMatchSiteCanonicalArgument));
		if (!integers_valid || canonical_argument == nullptr
			|| helper_argument == nullptr) return 2u;
		const int resno = intVal(list_nth(site, kMatchSiteResno));
		Node* raw_supplied = resno <= 0
			|| resno > list_length(scan->custom_scan_tlist)
			? nullptr : reinterpret_cast<Node*>(list_nth(
				scan->custom_scan_tlist, resno - 1));
		TargetEntry* supplied = raw_supplied != nullptr
			&& IsA(raw_supplied, TargetEntry)
			? reinterpret_cast<TargetEntry*>(raw_supplied) : nullptr;
		PlaceHolderVar* supplied_placeholder = supplied == nullptr
			? nullptr : pg_node_try_as<PlaceHolderVar>(
				reinterpret_cast<Node*>(supplied->expr));
		PlaceHolderVar* carrier_placeholder =
			pg_node_try_as<PlaceHolderVar>(identity);
		const int supplied_phid = supplied_placeholder == nullptr
			? 0 : static_cast<int>(supplied_placeholder->phid);
		const int carrier_phid = carrier_placeholder == nullptr
			? 0 : static_cast<int>(carrier_placeholder->phid);
		const int site_phid = intVal(list_nth(site, kMatchSitePhid));
		const auto binding_kind = static_cast<BioseqMatchHelperBindingKind>(
			intVal(list_nth(site, kMatchSiteBindingKind)));
		FuncExpr* supplied_helper = supplied == nullptr ? nullptr
			: (supplied_placeholder == nullptr
				? batch_join_well_formed_match_helper(
					reinterpret_cast<Node*>(supplied->expr), oids)
				: batch_join_match_helper_phv_function(
					supplied_placeholder, oids));
		Node* supplied_argument =
			batch_join_match_helper_argument(supplied_helper);
		const bool equivalent = supplied != nullptr
			&& finalized_match_helper_carrier_equivalent(
				scan, reinterpret_cast<Node*>(supplied->expr), identity,
				canonical_argument, site_phid, oids);
		if (audit != nullptr && !audit->inspected) {
			audit->inspected = true;
			audit->supplied_tag = supplied == nullptr || supplied->expr == nullptr
				? -1 : static_cast<int>(nodeTag(supplied->expr));
			audit->carrier_tag = static_cast<int>(nodeTag(identity));
			audit->supplied_argument_tag = supplied_argument == nullptr
				? -1 : static_cast<int>(nodeTag(supplied_argument));
			audit->carrier_argument_tag = helper_argument == nullptr
				? -1 : static_cast<int>(nodeTag(helper_argument));
			audit->canonical_argument_tag =
				static_cast<int>(nodeTag(canonical_argument));
			audit->site_resno = resno;
			audit->site_phid = site_phid;
			audit->supplied_phid = supplied_phid;
			audit->carrier_phid = carrier_phid;
			audit->identity_equal = supplied != nullptr
				&& equal(supplied->expr, identity);
			audit->supplied_argument_canonical = supplied_argument != nullptr
				&& equal(supplied_argument, canonical_argument);
			audit->carrier_argument_canonical =
				equal(helper_argument, canonical_argument);
			audit->equivalent = equivalent;
		}
		/* custom_private retains planner coordinates while custom_scan_tlist and
		 * the carrier identity are post-setrefs.  Stable site ownership plus the
		 * exact supplied expression is the cross-domain proof; comparing their
		 * argument Vars directly would reject valid rtable-offset plans. */
		if (supplied != nullptr && supplied->resno == resno
			&& equivalent
			&& static_cast<Oid>(intVal(list_nth(
				site, kMatchSiteFuncid))) == helper->funcid
			&& intVal(list_nth(site, kMatchSiteTypmod)) == exprTypmod(identity)
			&& static_cast<Oid>(intVal(list_nth(
				site, kMatchSiteCollation))) == exprCollation(identity)
			&& (binding_kind == BioseqMatchHelperBindingKind::exact_recipe
				|| binding_kind
					== BioseqMatchHelperBindingKind::unique_lineage)
			&& site_phid >= 0
			&& intVal(list_nth(site, kMatchSiteStableId))
				== stable_match_id) {
			matches = std::min<std::size_t>(2u, matches + 1u);
		}
	}
	return matches;
}

struct FinalizedBaseOwnerSiteContext {
	List* sites = NIL;
	Node* target_recipe = nullptr;
	List* target_lineage = NIL;
	Index target_relid = 0;
	int stable_match_id = 0;
};

[[nodiscard]] static bool
finalized_base_owner_site_context(
		CustomScan* scan, const BioseqStubOids& oids,
		FinalizedBaseOwnerSiteContext& context) {
	context = {};
	if (scan == nullptr || scan->methods != &BioseqColumnScanScanMethods) {
		return false;
	}
	List* owner_tag = find_base_match_owner_plan_tag(scan);
	Node* descriptor_node = owner_tag == NIL ? nullptr
		: reinterpret_cast<Node*>(list_nth(
			owner_tag, kBaseMatchPlanExecutorDescriptor));
	Node* sites_node = owner_tag == NIL ? nullptr
		: reinterpret_cast<Node*>(list_nth(
			owner_tag, kBaseMatchPlanExecutorSites));
	if (descriptor_node == nullptr || !IsA(descriptor_node, List)
		|| sites_node == nullptr || !IsA(sites_node, List)) {
		return false;
	}
	List* descriptor = reinterpret_cast<List*>(descriptor_node);
	const int stable_match_id =
		validate_finalized_match_owner_descriptor_value(scan, descriptor);
	Node* target_recipe = reinterpret_cast<Node*>(
		list_nth(descriptor, kMatchOwnerTargetRecipe));
	List* target_lineage = canonical_match_base_lineage(target_recipe, oids);
	bool valid_lineage = target_lineage != NIL;
	for (Var* source : PList<Var>(target_lineage)) {
		if (source == nullptr || source->varno != scan->scan.scanrelid
			|| source->varattno <= 0 || source->varlevelsup != 0
			|| !bms_is_empty(source->varnullingrels)
			|| source->vartype != oids.bioseq_seq_type_oid) {
			valid_lineage = false;
			break;
		}
	}
	if (target_recipe == nullptr
		|| exprType(target_recipe) != oids.bioseq_seq_type_oid
		|| !valid_lineage) {
		return false;
	}
	context = FinalizedBaseOwnerSiteContext{
		reinterpret_cast<List*>(sites_node), target_recipe, target_lineage,
		scan->scan.scanrelid, stable_match_id};
	return true;
}

[[nodiscard]] static bool finalized_base_owner_site_matches(
		List* site, FuncExpr* helper, AttrNumber resno,
		const FinalizedBaseOwnerSiteContext& context,
		const BioseqStubOids& oids, bool& malformed) noexcept {
	if (site == nullptr || helper == nullptr
		|| list_length(site) != kBioseqMatchHelperSiteFields) {
		malformed = true;
		return false;
	}
	for (const int index : {
			kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
			kMatchSiteCollation, kMatchSiteBindingKind,
			kMatchSitePhid, kMatchSiteStableId}) {
		Node* value = reinterpret_cast<Node*>(list_nth(site, index));
		if (value == nullptr || !IsA(value, Integer)) {
			malformed = true;
			return false;
		}
	}
	Node* canonical_argument = reinterpret_cast<Node*>(list_nth(
		site, kMatchSiteCanonicalArgument));
	Node* helper_argument = batch_join_match_helper_argument(helper);
	Var* argument = pg_node_try_as<Var>(canonical_argument);
	const auto binding_kind = static_cast<BioseqMatchHelperBindingKind>(
		intVal(list_nth(site, kMatchSiteBindingKind)));
	const bool exact_sequence_argument = canonical_argument != nullptr
		&& exprType(canonical_argument) == oids.bioseq_seq_type_oid
		&& equal(canonical_argument, context.target_recipe)
		&& binding_kind == BioseqMatchHelperBindingKind::exact_recipe;
	bool legacy_lineage_argument = argument != nullptr
		&& argument->varno == context.target_relid
		&& argument->varattno > 0 && argument->varlevelsup == 0
		&& bms_is_empty(argument->varnullingrels)
		&& binding_kind == BioseqMatchHelperBindingKind::unique_lineage;
	if (legacy_lineage_argument
		&& argument->vartype == oids.bioseq_seq_type_oid) {
		legacy_lineage_argument = false;
		for (Var* source : PList<Var>(context.target_lineage)) {
			if (equal(source, argument)) {
				legacy_lineage_argument = true;
				break;
			}
		}
	}
	return helper_argument != nullptr && canonical_argument != nullptr
		&& equal(canonical_argument, helper_argument)
		&& intVal(list_nth(site, kMatchSiteResno)) == resno
		&& static_cast<Oid>(intVal(list_nth(
			site, kMatchSiteFuncid))) == helper->funcid
		&& intVal(list_nth(site, kMatchSiteTypmod))
			== exprTypmod(reinterpret_cast<Node*>(helper))
		&& static_cast<Oid>(intVal(list_nth(
			site, kMatchSiteCollation)))
			== exprCollation(reinterpret_cast<Node*>(helper))
		&& intVal(list_nth(site, kMatchSitePhid)) == 0
		&& intVal(list_nth(site, kMatchSiteStableId))
			== context.stable_match_id
		&& (exact_sequence_argument || legacy_lineage_argument);
}

struct FinalizedBaseTargetlistAudit {
	FinalizedBaseOwnerSiteContext context{};
	const BioseqStubOids* oids = nullptr;
	AttrNumber resno = InvalidAttrNumber;
	Bitmapset** matched_sites = nullptr;
	bool invalid = false;
};

struct finalized_base_targetlist_audit_visitor {
	[[nodiscard]] pg_walk_step operator()(
			pg_expression_walk_cursor, pg_node_view node,
			FinalizedBaseTargetlistAudit& audit) const {
		FuncExpr* function = node.try_as<FuncExpr>();
		if (function == nullptr || audit.oids == nullptr
			|| !is_bioseq_projection_funcid(
				function->funcid, *audit.oids)) {
			return pg_walk_step::descend;
		}
		FuncExpr* helper = batch_join_well_formed_match_helper(
			reinterpret_cast<Node*>(function), *audit.oids);
		if (helper == nullptr || audit.matched_sites == nullptr) {
			audit.invalid = true;
			return pg_walk_step::stop;
		}
		std::size_t matches = 0u;
		std::size_t matched_index = 0u;
		for (int index = 0; index < list_length(audit.context.sites); ++index) {
			Node* raw_site = reinterpret_cast<Node*>(list_nth(
				audit.context.sites, index));
			List* site = raw_site != nullptr && IsA(raw_site, List)
				? reinterpret_cast<List*>(raw_site) : NIL;
			bool malformed = false;
			if (finalized_base_owner_site_matches(
					site, helper, audit.resno, audit.context,
					*audit.oids, malformed)) {
				++matches;
				matched_index = static_cast<std::size_t>(index);
			}
			if (malformed) {
				audit.invalid = true;
				return pg_walk_step::stop;
			}
		}
		if (matches != 1u) {
			audit.invalid = true;
			return pg_walk_step::stop;
		}
		*audit.matched_sites = bms_add_member(
			*audit.matched_sites, static_cast<int>(matched_index));
		return pg_walk_step::skip_subtree;
	}
};

[[nodiscard]] static bool
base_scan_targetlist_has_only_finalized_match_helpers(
		CustomScan* scan, const BioseqStubOids& oids) {
	FinalizedBaseOwnerSiteContext context{};
	if (!finalized_base_owner_site_context(scan, oids, context)
		|| context.sites == NIL) return false;
	Bitmapset* matched_sites = nullptr;
	FinalizedBaseTargetlistAudit audit{
		context, &oids, InvalidAttrNumber, &matched_sites, false};
	finalized_base_targetlist_audit_visitor visitor;
	for (TargetEntry* entry : PList<TargetEntry>(scan->scan.plan.targetlist)) {
		if (entry == nullptr || entry->expr == nullptr) continue;
		audit.resno = entry->resno;
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(entry->expr), audit, visitor);
		if (audit.invalid) {
			bms_free(matched_sites);
			return false;
		}
	}
	const bool all_sites_matched = bms_num_members(matched_sites)
		== list_length(context.sites);
	bms_free(matched_sites);
	return all_sites_matched;
}

[[nodiscard]] static std::size_t finalized_base_owner_matching_site_count(
		CustomScan* scan, Node* identity, const BioseqStubOids& oids) {
	FinalizedBaseOwnerSiteContext context{};
	if (!finalized_base_owner_site_context(scan, oids, context)
		|| identity == nullptr) return 0u;
	PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
	FuncExpr* helper = placeholder == nullptr
		? batch_join_well_formed_match_helper(identity, oids)
		: batch_join_match_helper_phv_function(placeholder, oids);
	if (helper == nullptr) return 0u;
	std::size_t matches = 0u;
	for (Node* raw_site : PList<Node>(context.sites)) {
		List* site = raw_site != nullptr && IsA(raw_site, List)
			? reinterpret_cast<List*>(raw_site) : NIL;
		if (list_length(site) != kBioseqMatchHelperSiteFields) return 2u;
		const int resno = site != NIL
			&& IsA(reinterpret_cast<Node*>(list_nth(
				site, kMatchSiteResno)), Integer)
			? intVal(list_nth(site, kMatchSiteResno)) : -1;
		Node* raw_supplied = resno <= 0
			|| resno > list_length(scan->scan.plan.targetlist)
			? nullptr : reinterpret_cast<Node*>(list_nth(
				scan->scan.plan.targetlist, resno - 1));
		TargetEntry* supplied = raw_supplied != nullptr
			&& IsA(raw_supplied, TargetEntry)
			? reinterpret_cast<TargetEntry*>(raw_supplied) : nullptr;
		bool malformed = false;
		if (supplied != nullptr && supplied->resno == resno
			&& equal(supplied->expr, identity)
			&& finalized_base_owner_site_matches(
				site, helper, static_cast<AttrNumber>(resno),
				context, oids, malformed)) {
			/* Planner PHV and bare-Func carriers can legitimately collapse to
			 * equal post-setrefs expressions at distinct resnos.  They are two
			 * authoritative carrier sites for one base MatchResult owner, not two
			 * competing owners.  This routine feeds owner-counting audits, so
			 * classify the owner once while the resno-specific targetlist audit
			 * above continues to prove every individual site. */
			matches = 1u;
		}
		if (malformed) return 2u;
	}
	return matches;
}

[[nodiscard]] static std::size_t
finalized_descendant_match_owner_site_count(
		Plan* plan, Node* identity, const BioseqStubOids& oids) {
	if (plan == nullptr || identity == nullptr) return 0u;
	check_stack_depth();
	auto add = [](std::size_t left, std::size_t right) noexcept {
		return left > 1u || right > 1u || left + right > 1u
			? std::size_t{2u} : left + right;
	};
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		std::size_t count = finalized_batch_owner_matching_site_count(
			custom, identity, oids);
		count = add(count, finalized_base_owner_matching_site_count(
			custom, identity, oids));
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			count = add(count, finalized_descendant_match_owner_site_count(
				child, identity, oids));
		}
		return count;
	}
	auto search_plan_list = [identity, &oids, &add](List* plans) {
		std::size_t count = 0u;
		for (Plan* child : PList<Plan>(plans)) {
			count = add(count, finalized_descendant_match_owner_site_count(
				child, identity, oids));
		}
		return count;
	};
	if (IsA(plan, Append)) {
		return search_plan_list(reinterpret_cast<Append*>(plan)->appendplans);
	}
	if (IsA(plan, MergeAppend)) {
		return search_plan_list(
			reinterpret_cast<MergeAppend*>(plan)->mergeplans);
	}
	if (IsA(plan, BitmapAnd)) {
		return search_plan_list(
			reinterpret_cast<BitmapAnd*>(plan)->bitmapplans);
	}
	if (IsA(plan, BitmapOr)) {
		return search_plan_list(
			reinterpret_cast<BitmapOr*>(plan)->bitmapplans);
	}
	if (IsA(plan, SubqueryScan)) {
		/* A SubqueryScan starts a distinct finalized helper-binding scope. */
		return 0u;
	}
	std::size_t count = finalized_descendant_match_owner_site_count(
		outerPlan(plan), identity, oids);
	if (innerPlan(plan) != outerPlan(plan)) {
		count = add(count, finalized_descendant_match_owner_site_count(
			innerPlan(plan), identity, oids));
	}
	return count;
}

/* Diagnostic-only counterpart to finalized_descendant_match_owner_site_count.
 * Keep Batch and Base ownership separate so a rejected finalized carrier can
 * explain which owner class, if either, still proves the raw helper identity.
 * Counts saturate at two because the audit only distinguishes zero, unique,
 * and ambiguous ownership. */
[[nodiscard]] static std::size_t
finalized_descendant_match_owner_site_count_by_kind(
		Plan* plan, Node* identity, const BioseqStubOids& oids,
		bool batch_owner) {
	if (plan == nullptr || identity == nullptr) return 0u;
	check_stack_depth();
	auto add = [](std::size_t left, std::size_t right) noexcept {
		return left > 1u || right > 1u || left + right > 1u
			? std::size_t{2u} : left + right;
	};
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		std::size_t count = batch_owner
			? finalized_batch_owner_matching_site_count(
				custom, identity, oids)
			: finalized_base_owner_matching_site_count(
				custom, identity, oids);
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			count = add(count,
				finalized_descendant_match_owner_site_count_by_kind(
					child, identity, oids, batch_owner));
		}
		return count;
	}
	auto search_plan_list = [identity, &oids, batch_owner, &add](List* plans) {
		std::size_t count = 0u;
		for (Plan* child : PList<Plan>(plans)) {
			count = add(count,
				finalized_descendant_match_owner_site_count_by_kind(
					child, identity, oids, batch_owner));
		}
		return count;
	};
	if (IsA(plan, Append)) {
		return search_plan_list(reinterpret_cast<Append*>(plan)->appendplans);
	}
	if (IsA(plan, MergeAppend)) {
		return search_plan_list(
			reinterpret_cast<MergeAppend*>(plan)->mergeplans);
	}
	if (IsA(plan, BitmapAnd)) {
		return search_plan_list(
			reinterpret_cast<BitmapAnd*>(plan)->bitmapplans);
	}
	if (IsA(plan, BitmapOr)) {
		return search_plan_list(
			reinterpret_cast<BitmapOr*>(plan)->bitmapplans);
	}
	if (IsA(plan, SubqueryScan)) {
		/* Match the finalized helper-binding scope fence used by the verdict. */
		return 0u;
	}
	std::size_t count =
		finalized_descendant_match_owner_site_count_by_kind(
			outerPlan(plan), identity, oids, batch_owner);
	if (innerPlan(plan) != outerPlan(plan)) {
		count = add(count,
			finalized_descendant_match_owner_site_count_by_kind(
				innerPlan(plan), identity, oids, batch_owner));
	}
	return count;
}

struct FinalizedMatchOwnerSiteCounts {
	std::size_t batch = 0u;
	std::size_t base = 0u;
};

[[nodiscard]] static FinalizedMatchOwnerSiteCounts
finalized_child_match_owner_site_counts(
		Plan* plan, Node* identity, const BioseqStubOids& oids) {
	FinalizedMatchOwnerSiteCounts counts{};
	if (plan == nullptr || identity == nullptr) return counts;
	auto add = [](std::size_t left, std::size_t right) noexcept {
		return left > 1u || right > 1u || left + right > 1u
			? std::size_t{2u} : left + right;
	};
	auto count_child = [&](Plan* child) {
		counts.batch = add(counts.batch,
			finalized_descendant_match_owner_site_count_by_kind(
				child, identity, oids, true));
		counts.base = add(counts.base,
			finalized_descendant_match_owner_site_count_by_kind(
				child, identity, oids, false));
	};
	if (IsA(plan, Append)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<Append*>(plan)->appendplans)) {
			count_child(child);
		}
	} else if (IsA(plan, MergeAppend)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<MergeAppend*>(plan)->mergeplans)) {
			count_child(child);
		}
	} else if (IsA(plan, CustomScan)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<CustomScan*>(plan)->custom_plans)) {
			count_child(child);
		}
	} else if (IsA(plan, BitmapAnd)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapAnd*>(plan)->bitmapplans)) {
			count_child(child);
		}
	} else if (IsA(plan, BitmapOr)) {
		for (Plan* child : PList<Plan>(
				reinterpret_cast<BitmapOr*>(plan)->bitmapplans)) {
			count_child(child);
		}
	} else if (!IsA(plan, SubqueryScan)) {
		count_child(outerPlan(plan));
		if (innerPlan(plan) != outerPlan(plan)) count_child(innerPlan(plan));
	}
	return counts;
}

[[nodiscard]] constexpr std::size_t saturated_match_owner_site_count_add(
		std::size_t left, std::size_t right) noexcept {
	return left > 1u || right > 1u || left + right > 1u
		? std::size_t{2u} : left + right;
}

[[nodiscard]] constexpr bool dummy_match_helper_has_unique_finalized_owner(
		std::size_t descendant_matches,
		std::size_t current_parent_matches) noexcept {
	return saturated_match_owner_site_count_add(
		descendant_matches, current_parent_matches) == 1u;
}

static_assert(dummy_match_helper_has_unique_finalized_owner(0u, 1u));
static_assert(!dummy_match_helper_has_unique_finalized_owner(1u, 1u));
static_assert(!dummy_match_helper_has_unique_finalized_owner(0u, 0u));
static_assert(!dummy_match_helper_has_unique_finalized_owner(2u, 0u));

[[nodiscard]] constexpr bool
dummy_match_helper_is_unique_ancestor_carrier(
		std::size_t local_base_matches,
		std::size_t ancestor_matches) noexcept {
	return local_base_matches == 0u && ancestor_matches == 1u;
}

static_assert(dummy_match_helper_is_unique_ancestor_carrier(0u, 1u));
static_assert(!dummy_match_helper_is_unique_ancestor_carrier(1u, 0u));
static_assert(!dummy_match_helper_is_unique_ancestor_carrier(0u, 2u));

[[nodiscard]] static MatchOwnerFinalization*
finalized_batch_owner_for_ancestor_stack(
		CustomScan* scan,
		std::span<MatchOwnerFinalization> owners) {
	MatchOwnerFinalization* result = nullptr;
	for (MatchOwnerFinalization& owner : owners) {
		if (owner.scan != scan || owner.base_owner_tag != NIL) continue;
		if (result != nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("Bioseq finalized ancestor match owner is duplicated"),
				 errdetail("plan_node_id=%d", scan->scan.plan.plan_node_id)));
		}
		result = &owner;
	}
	if (result == nullptr) return nullptr;

	Node* version_node = scan->custom_private == NIL ? nullptr
		: reinterpret_cast<Node*>(linitial(scan->custom_private));
	const int version = version_node != nullptr && IsA(version_node, Integer)
		? intVal(version_node) : -1;
	const int expected_fields = version == kBioseqBatchJoinPlanVersion
		? kBioseqBatchJoinPrivateFields
		: (version == kBioseqPerRowJoinPlanVersion
			? kBioseqPerRowJoinPrivateFields : -1);
	const int descriptor_index = version == kBioseqBatchJoinPlanVersion
		? kBatchJoinMatchOwnerDescriptor
		: (version == kBioseqPerRowJoinPlanVersion
			? kPerRowMatchOwnerDescriptor : -1);
	const int sites_index = version == kBioseqBatchJoinPlanVersion
		? kBatchJoinPlaceholderSites
		: (version == kBioseqPerRowJoinPlanVersion
			? kPerRowPlaceholderSites : -1);
	Node* descriptor_node = descriptor_index >= 0
		&& descriptor_index < list_length(scan->custom_private)
		? reinterpret_cast<Node*>(list_nth(
			scan->custom_private, descriptor_index)) : nullptr;
	Node* sites_node = sites_index >= 0
		&& sites_index < list_length(scan->custom_private)
		? reinterpret_cast<Node*>(list_nth(
			scan->custom_private, sites_index)) : nullptr;
	const bool sites_agree = result->sites == NIL
		? sites_node == nullptr
		: sites_node == reinterpret_cast<Node*>(result->sites);
	if (scan->methods != &BioseqBatchJoinScanMethods
		|| expected_fields < 0
		|| list_length(scan->custom_private) != expected_fields
		|| descriptor_node == nullptr || !IsA(descriptor_node, List)
		|| descriptor_node != reinterpret_cast<Node*>(result->descriptor)
		|| !sites_agree || result->stable_match_id < 0
		|| result->stable_match_id != scan->scan.plan.plan_node_id
		|| result->query_scope_id == 0u) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("Bioseq finalized ancestor match owner is invalid"),
			 errdetail("plan_node_id=%d version=%d query_scope_id=" UINT64_FORMAT,
				scan->scan.plan.plan_node_id, version,
				static_cast<uint64>(result->query_scope_id))));
	}
	const int descriptor_stable_id =
		validate_finalized_match_owner_descriptor_value(
			scan, reinterpret_cast<List*>(descriptor_node));
	if (descriptor_stable_id != result->stable_match_id) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("Bioseq finalized ancestor match identity disagrees with its descriptor"),
			 errdetail("plan_node_id=%d descriptor_stable_id=%d owner_stable_id=%d",
				scan->scan.plan.plan_node_id, descriptor_stable_id,
				result->stable_match_id)));
	}
	return result;
}

static void neutralize_bioseq_scan_ancestor_helper_carriers(
		CustomScan* scan,
		List* ancestor_stack,
		const BioseqStubOids& oids) {
	if (scan == nullptr || scan->methods != &BioseqColumnScanScanMethods
		|| ancestor_stack == NIL) return;
	if (batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(scan->scan.plan.qual), oids)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqScan inherited match helper remains executable after setrefs"),
			 errdetail("store=Plan.qual plan_node_id=%d",
				scan->scan.plan.plan_node_id)));
	}
	if (batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(scan->custom_exprs), oids)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqScan inherited match helper remains executable after setrefs"),
			 errdetail("store=CustomScan.custom_exprs plan_node_id=%d",
				scan->scan.plan.plan_node_id)));
	}

	for (TargetEntry* entry : PList<TargetEntry>(
			scan->scan.plan.targetlist)) {
		Node* identity = entry == nullptr ? nullptr
			: reinterpret_cast<Node*>(entry->expr);
		if (!batch_join_expression_has_match_helper(identity, oids)) continue;
		PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
		FuncExpr* helper = placeholder == nullptr
			? batch_join_well_formed_match_helper(identity, oids)
			: batch_join_match_helper_phv_function(placeholder, oids);
		if (entry == nullptr || helper == nullptr
			|| is_projection_capable_plan(
				reinterpret_cast<Plan*>(scan))) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan inherited match helper carrier is not a whole dummy target"),
				 errdetail("plan_node_id=%d resno=%d",
					scan->scan.plan.plan_node_id,
					entry == nullptr ? 0 : entry->resno)));
		}

		const std::size_t local_base_matches =
			finalized_base_owner_matching_site_count(scan, identity, oids);
		std::size_t ancestor_matches = 0u;
		FinalizedMatchHelperCarrierAudit carrier_audit{};
		for (MatchOwnerFinalization* ancestor
				: PList<MatchOwnerFinalization>(ancestor_stack)) {
			if (ancestor == nullptr || ancestor->scan == nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("Bioseq finalized ancestor stack is invalid")));
			}
			ancestor_matches = saturated_match_owner_site_count_add(
				ancestor_matches,
				finalized_batch_owner_matching_site_count(
					ancestor->scan, identity, oids, &carrier_audit));
		}
		if (local_base_matches > 1u || ancestor_matches > 1u
			|| (local_base_matches == 1u && ancestor_matches != 0u)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan match helper carrier ownership is ambiguous"),
				 errdetail("plan_node_id=%d resno=%d local_base_matches=%zu ancestor_matches=%zu",
					scan->scan.plan.plan_node_id, entry->resno,
					local_base_matches, ancestor_matches)));
		}
		/* A finalized base owner executes this helper at the leaf.  Only raw
		 * carriers owned exclusively by an enclosing Batch/PerRow node are
		 * non-executable dummy target columns. */
		if (local_base_matches == 1u) continue;
		if (!dummy_match_helper_is_unique_ancestor_carrier(
				local_base_matches, ancestor_matches)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan inherited match helper carrier has no unique finalized ancestor"),
				 errdetail("plan_node_id=%d resno=%d local_base_matches=%zu ancestor_matches=%zu inspected=%s early_reject=%d version=%d private_fields=%d expected_fields=%d descriptor_tag=%d sites_tag=%d site_count=%d supplied_tag=%d carrier_tag=%d supplied_arg_tag=%d carrier_arg_tag=%d canonical_arg_tag=%d site_resno=%d site_phid=%d supplied_phid=%d carrier_phid=%d identity_equal=%s supplied_arg_canonical=%s carrier_arg_canonical=%s equivalent=%s",
					scan->scan.plan.plan_node_id, entry->resno,
					local_base_matches, ancestor_matches,
					carrier_audit.inspected ? "true" : "false",
					carrier_audit.early_reject, carrier_audit.version,
					carrier_audit.private_fields,
					carrier_audit.expected_fields,
					carrier_audit.descriptor_tag,
					carrier_audit.sites_tag,
					carrier_audit.site_count,
					carrier_audit.supplied_tag, carrier_audit.carrier_tag,
					carrier_audit.supplied_argument_tag,
					carrier_audit.carrier_argument_tag,
					carrier_audit.canonical_argument_tag,
					carrier_audit.site_resno, carrier_audit.site_phid,
					carrier_audit.supplied_phid, carrier_audit.carrier_phid,
					carrier_audit.identity_equal ? "true" : "false",
					carrier_audit.supplied_argument_canonical ? "true" : "false",
					carrier_audit.carrier_argument_canonical ? "true" : "false",
					carrier_audit.equivalent ? "true" : "false")));
		}

		const Oid type_oid = exprType(identity);
		const int32 typmod = exprTypmod(identity);
		const Oid collation = exprCollation(identity);
		if (!OidIsValid(type_oid) || type_oid != helper->funcresulttype
			|| type_oid != get_func_rettype(helper->funcid)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan inherited match helper carrier type is invalid"),
				 errdetail("plan_node_id=%d resno=%d type_oid=%u helper_type_oid=%u",
					scan->scan.plan.plan_node_id, entry->resno,
					type_oid, helper->funcresulttype)));
		}

		const AttrNumber original_resno = entry->resno;
		char* const original_resname = entry->resname;
		const Index original_sortgroupref = entry->ressortgroupref;
		const Oid original_table_oid = entry->resorigtbl;
		const AttrNumber original_column = entry->resorigcol;
		const bool original_resjunk = entry->resjunk;
		Const* replacement = makeNullConst(type_oid, typmod, collation);
		entry->expr = reinterpret_cast<Expr*>(replacement);
		if (replacement == nullptr || !replacement->constisnull
			|| exprType(reinterpret_cast<Node*>(entry->expr)) != type_oid
			|| exprTypmod(reinterpret_cast<Node*>(entry->expr)) != typmod
			|| exprCollation(reinterpret_cast<Node*>(entry->expr)) != collation
			|| entry->resno != original_resno
			|| entry->resname != original_resname
			|| entry->ressortgroupref != original_sortgroupref
			|| entry->resorigtbl != original_table_oid
			|| entry->resorigcol != original_column
			|| entry->resjunk != original_resjunk) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqScan inherited match helper carrier neutralization changed its slot contract"),
				 errdetail("plan_node_id=%d resno=%d",
					scan->scan.plan.plan_node_id, original_resno)));
		}
	}
}

static void neutralize_ancestor_owned_dummy_match_helpers_plan(
		Plan* plan, std::span<MatchOwnerFinalization> owners,
		List* ancestor_stack,
		const BioseqStubOids& oids) {
	if (plan == nullptr) return;
	check_stack_depth();
	if (IsA(plan, SubqueryScan)) {
		/* A SubqueryScan is a hard query-scope boundary.  An owner above it can
		 * never justify neutralizing an equal local helper spelling below it. */
		neutralize_ancestor_owned_dummy_match_helpers_plan(
			reinterpret_cast<SubqueryScan*>(plan)->subplan, owners,
			NIL, oids);
		return;
	}
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		if (custom->methods == &BioseqColumnScanScanMethods) {
			neutralize_bioseq_scan_ancestor_helper_carriers(
				custom, ancestor_stack, oids);
		}
		MatchOwnerFinalization* owner =
			finalized_batch_owner_for_ancestor_stack(custom, owners);
		MatchOwnerFinalization* parent_owner = ancestor_stack == NIL
			? nullptr : reinterpret_cast<MatchOwnerFinalization*>(
				llast(ancestor_stack));
		if (owner != nullptr && parent_owner != nullptr
			&& parent_owner->query_scope_id
				!= owner->query_scope_id) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("Bioseq finalized ancestor stack crosses query scopes"),
				 errdetail("parent_scope_id=" UINT64_FORMAT " child_scope_id=" UINT64_FORMAT,
					static_cast<uint64>(parent_owner->query_scope_id),
					static_cast<uint64>(owner->query_scope_id))));
		}
		List* child_ancestors = owner == nullptr
			? ancestor_stack : lappend(list_copy(ancestor_stack), owner);
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			neutralize_ancestor_owned_dummy_match_helpers_plan(
				child, owners, child_ancestors, oids);
		}
		if (owner != nullptr) list_free(child_ancestors);
		return;
	}
	auto visit_plan_list = [owners, ancestor_stack, &oids](List* plans) {
		for (Plan* child : PList<Plan>(plans)) {
			neutralize_ancestor_owned_dummy_match_helpers_plan(
				child, owners, ancestor_stack, oids);
		}
	};
	if (IsA(plan, Append)) {
		visit_plan_list(reinterpret_cast<Append*>(plan)->appendplans);
		return;
	}
	if (IsA(plan, MergeAppend)) {
		visit_plan_list(reinterpret_cast<MergeAppend*>(plan)->mergeplans);
		return;
	}
	if (IsA(plan, BitmapAnd)) {
		visit_plan_list(reinterpret_cast<BitmapAnd*>(plan)->bitmapplans);
		return;
	}
	if (IsA(plan, BitmapOr)) {
		visit_plan_list(reinterpret_cast<BitmapOr*>(plan)->bitmapplans);
		return;
	}
	neutralize_ancestor_owned_dummy_match_helpers_plan(
		outerPlan(plan), owners, ancestor_stack, oids);
	if (innerPlan(plan) != outerPlan(plan)) {
		neutralize_ancestor_owned_dummy_match_helpers_plan(
			innerPlan(plan), owners, ancestor_stack, oids);
	}
}

static void neutralize_ancestor_owned_dummy_match_helpers(
		PlannedStmt* statement,
		std::span<MatchOwnerFinalization> owners) {
	if (statement == nullptr || statement->planTree == nullptr) return;
	const BioseqStubOids& oids = get_cached_stub_oids();
	neutralize_ancestor_owned_dummy_match_helpers_plan(
		statement->planTree, owners, NIL, oids);
	for (Plan* subplan : PList<Plan>(statement->subplans)) {
		neutralize_ancestor_owned_dummy_match_helpers_plan(
			subplan, owners, NIL, oids);
	}
}

[[nodiscard]] static bool
dummy_targetlist_has_only_unique_finalized_owner_helpers(
		Plan* plan, const BioseqStubOids& oids,
		CustomScan* current_parent) {
	if (plan == nullptr || is_projection_capable_plan(plan)) return false;
	for (TargetEntry* entry : PList<TargetEntry>(plan->targetlist)) {
		Node* identity = entry == nullptr
			? nullptr : reinterpret_cast<Node*>(entry->expr);
		if (!batch_join_expression_has_match_helper(identity, oids)) continue;
		PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
		FuncExpr* helper = placeholder == nullptr
			? batch_join_well_formed_match_helper(identity, oids)
			: batch_join_match_helper_phv_function(placeholder, oids);
		if (helper == nullptr) return false;
		const std::size_t current_parent_matches = current_parent == nullptr
			|| IsA(plan, SubqueryScan)
			? 0u : finalized_batch_owner_matching_site_count(
				current_parent, identity, oids);
		std::size_t descendant_matches = 0u;
		auto count_child = [&](Plan* child) {
			const std::size_t additional =
				finalized_descendant_match_owner_site_count(
					child, identity, oids);
			descendant_matches = saturated_match_owner_site_count_add(
				descendant_matches, additional);
		};
		if (IsA(plan, Append)) {
			for (Plan* child : PList<Plan>(
					reinterpret_cast<Append*>(plan)->appendplans)) {
				count_child(child);
			}
		} else if (IsA(plan, MergeAppend)) {
			for (Plan* child : PList<Plan>(
					reinterpret_cast<MergeAppend*>(plan)->mergeplans)) {
				count_child(child);
			}
		} else if (IsA(plan, CustomScan)) {
			for (Plan* child : PList<Plan>(
					reinterpret_cast<CustomScan*>(plan)->custom_plans)) {
				count_child(child);
			}
		} else if (IsA(plan, BitmapAnd)) {
			for (Plan* child : PList<Plan>(
					reinterpret_cast<BitmapAnd*>(plan)->bitmapplans)) {
				count_child(child);
			}
		} else if (IsA(plan, BitmapOr)) {
			for (Plan* child : PList<Plan>(
					reinterpret_cast<BitmapOr*>(plan)->bitmapplans)) {
				count_child(child);
			}
		} else if (IsA(plan, SubqueryScan)) {
			/* Do not prove a parent helper from a separate query scope. */
		} else {
			count_child(outerPlan(plan));
			if (innerPlan(plan) != outerPlan(plan)) count_child(innerPlan(plan));
		}
		if (!dummy_match_helper_has_unique_finalized_owner(
				descendant_matches, current_parent_matches)) return false;
	}
	return true;
}

struct BatchJoinPlanHelperAuditFirstFailure {
	const char* reason = "none";
	const char* store = "none";
	const char* custom_name = "none";
	const char* boundary_encountered = "none";
	int plan_node_tag = -1;
	bool projection_capable = false;
	int first_helper_resno = 0;
	bool whole_helper_valid = false;
	std::size_t finalized_batch_descendant_matches = 0u;
	std::size_t finalized_base_descendant_matches = 0u;
	std::size_t current_parent_matches = 0u;
	bool recorded = false;
};

static void record_batch_join_plan_helper_audit_failure(
		BatchJoinPlanHelperAuditFirstFailure& failure, Plan* plan,
		CustomScan* current_parent, const BioseqStubOids& oids,
		const char* reason, const char* store,
		const char* boundary_encountered, bool inspect_targetlist) {
	if (failure.recorded) return;
	failure.recorded = true;
	failure.reason = reason;
	failure.store = store;
	failure.boundary_encountered = boundary_encountered;
	failure.plan_node_tag = plan == nullptr
		? -1 : static_cast<int>(nodeTag(plan));
	failure.projection_capable = plan != nullptr
		&& is_projection_capable_plan(plan);
	if (plan != nullptr && IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		if (custom->methods != nullptr
			&& custom->methods->CustomName != nullptr) {
			failure.custom_name = custom->methods->CustomName;
		}
	}
	if (!inspect_targetlist || plan == nullptr) return;

	TargetEntry* first_helper_entry = nullptr;
	bool first_helper_whole = false;
	FinalizedMatchOwnerSiteCounts first_helper_counts{};
	std::size_t first_helper_parent_matches = 0u;
	for (TargetEntry* entry : PList<TargetEntry>(plan->targetlist)) {
		Node* identity = entry == nullptr
			? nullptr : reinterpret_cast<Node*>(entry->expr);
		if (!batch_join_expression_has_match_helper(identity, oids)) continue;
		PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(identity);
		FuncExpr* helper = placeholder == nullptr
			? batch_join_well_formed_match_helper(identity, oids)
			: batch_join_match_helper_phv_function(placeholder, oids);
		const bool whole_helper = helper != nullptr;
		const FinalizedMatchOwnerSiteCounts counts =
			finalized_child_match_owner_site_counts(plan, identity, oids);
		const std::size_t parent_matches = current_parent == nullptr
			? 0u : finalized_batch_owner_matching_site_count(
				current_parent, identity, oids);
		if (first_helper_entry == nullptr) {
			first_helper_entry = entry;
			first_helper_whole = whole_helper;
			first_helper_counts = counts;
			first_helper_parent_matches = parent_matches;
		}
		const std::size_t descendant_matches =
			saturated_match_owner_site_count_add(counts.batch, counts.base);
		if (failure.projection_capable || !whole_helper
			|| !dummy_match_helper_has_unique_finalized_owner(
					descendant_matches, parent_matches)) {
			first_helper_entry = entry;
			first_helper_whole = whole_helper;
			first_helper_counts = counts;
			first_helper_parent_matches = parent_matches;
			break;
		}
	}
	if (first_helper_entry == nullptr) return;
	failure.first_helper_resno = first_helper_entry->resno;
	failure.whole_helper_valid = first_helper_whole;
	failure.finalized_batch_descendant_matches = first_helper_counts.batch;
	failure.finalized_base_descendant_matches = first_helper_counts.base;
	failure.current_parent_matches = first_helper_parent_matches;
}

/* Final setrefs must replace every propagated helper identity in an
 * executable Plan expression with the descendant owner's scan-slot Var.
 * A non-projecting node may retain the whole identity in its dummy targetlist,
 * but only when exactly one finalized descendant or current PerRow owner site
 * supplies that column.  Mixed parent/descendant ownership remains ambiguous.
 * Descriptor-only custom_scan_tlist/custom_private fields remain excluded. */
[[nodiscard]] static bool batch_join_plan_has_unowned_executable_match_helper(
		Plan* plan, const BioseqStubOids& oids, CustomScan* current_parent,
		BatchJoinPlanHelperAuditFirstFailure& first_failure,
		const char* boundary_encountered) {
	if (plan == nullptr) return false;
	check_stack_depth();
	const bool targetlist_has_helper = batch_join_expression_has_match_helper(
		reinterpret_cast<Node*>(plan->targetlist), oids);
	if (targetlist_has_helper
		&& (!IsA(plan, CustomScan)
			|| !base_scan_targetlist_has_only_finalized_match_helpers(
				reinterpret_cast<CustomScan*>(plan), oids))
		&& !dummy_targetlist_has_only_unique_finalized_owner_helpers(
			plan, oids, current_parent)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			is_projection_capable_plan(plan)
				? "projection-capable targetlist"
				: "dummy targetlist ownership proof failed",
			"Plan.targetlist", boundary_encountered, true);
		return true;
	}
	if (batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(plan->qual), oids)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			"executable expression", "Plan.qual",
			boundary_encountered, false);
		return true;
	}
	if ((IsA(plan, NestLoop) || IsA(plan, MergeJoin) || IsA(plan, HashJoin))
		&& batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(
				reinterpret_cast<Join*>(plan)->joinqual), oids)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			"executable expression", "Join.joinqual",
			boundary_encountered, false);
		return true;
	}
	if (IsA(plan, MergeJoin)
		&& batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(
				reinterpret_cast<MergeJoin*>(plan)->mergeclauses), oids)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			"executable expression", "MergeJoin.mergeclauses",
			boundary_encountered, false);
		return true;
	}
	if (IsA(plan, HashJoin)
		&& batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(
				reinterpret_cast<HashJoin*>(plan)->hashclauses), oids)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			"executable expression", "HashJoin.hashclauses",
			boundary_encountered, false);
		return true;
	}
	if (IsA(plan, Result)
		&& batch_join_expression_has_match_helper(
			reinterpret_cast<Node*>(
				reinterpret_cast<Result*>(plan)->resconstantqual), oids)) {
		record_batch_join_plan_helper_audit_failure(
			first_failure, plan, current_parent, oids,
			"executable expression", "Result.resconstantqual",
			boundary_encountered, false);
		return true;
	}
	if (IsA(plan, CustomScan)) {
		auto* custom = reinterpret_cast<CustomScan*>(plan);
		if (batch_join_expression_has_match_helper(
				reinterpret_cast<Node*>(custom->custom_exprs), oids)) {
			record_batch_join_plan_helper_audit_failure(
				first_failure, plan, current_parent, oids,
				"executable expression", "CustomScan.custom_exprs",
				boundary_encountered, false);
			return true;
		}
		for (Plan* child : PList<Plan>(custom->custom_plans)) {
			if (batch_join_plan_has_unowned_executable_match_helper(
					child, oids, current_parent, first_failure,
					boundary_encountered)) {
				return true;
			}
		}
		return false;
	}
	auto search_plan_list = [&oids, current_parent, &first_failure,
			boundary_encountered](List* plans) {
		for (Plan* child : PList<Plan>(plans)) {
			if (batch_join_plan_has_unowned_executable_match_helper(
					child, oids, current_parent, first_failure,
					boundary_encountered)) {
				return true;
			}
		}
		return false;
	};
	if (IsA(plan, Append)) {
		return search_plan_list(reinterpret_cast<Append*>(plan)->appendplans);
	}
	if (IsA(plan, MergeAppend)) {
		return search_plan_list(
			reinterpret_cast<MergeAppend*>(plan)->mergeplans);
	}
	if (IsA(plan, BitmapAnd)) {
		return search_plan_list(
			reinterpret_cast<BitmapAnd*>(plan)->bitmapplans);
	}
	if (IsA(plan, BitmapOr)) {
		return search_plan_list(
			reinterpret_cast<BitmapOr*>(plan)->bitmapplans);
	}
	if (IsA(plan, SubqueryScan)) {
		return batch_join_plan_has_unowned_executable_match_helper(
			reinterpret_cast<SubqueryScan*>(plan)->subplan, oids,
			nullptr, first_failure, "SubqueryScan");
	}
	return batch_join_plan_has_unowned_executable_match_helper(
			outerPlan(plan), oids, current_parent, first_failure,
			boundary_encountered)
		|| (innerPlan(plan) != outerPlan(plan)
			&& batch_join_plan_has_unowned_executable_match_helper(
				innerPlan(plan), oids, current_parent, first_failure,
				boundary_encountered));
}


/*
 * reparameterize_mutator changes all varnos referencing the topmost parent
 * of child_rel to instead reference child_rel directly. Both the Var and the
 * RestrictInfo are deep copied before being written (copy-before-write), and
 * a RestrictInfo's clause is recursively rewritten via the cursor.
 */
struct reparameterize_mutator {
	[[nodiscard]] pg_node_mutation
	operator()(pg_expression_mutation_cursor cursor, pg_node_view node, RelOptInfo &child_rel) const {
		if (Var *var = node.try_as<Var>())
		{
			if (bioseq_is_concrete_rte_varno(var->varno)
				&& bms_is_member(
					static_cast<int>(var->varno),
					child_rel.top_parent_relids))
			{
				var = pg_copy_node(var);
				var->varno = child_rel.relid;
			}
			return pg_node_mutation::with(pg_as_node(var));
		}

		if (RestrictInfo *rinfo = node.try_as<RestrictInfo>())
		{
			rinfo = pg_copy_node(rinfo);
			rinfo->clause = reinterpret_cast<Expr *>(cursor.descend(
				reinterpret_cast<Node *>(rinfo->clause)));
			return pg_node_mutation::with(pg_as_node(rinfo));
		}

		return pg_node_mutation::descend();
	}
};


/*
 * BioseqColumnScanPath_ReparameterizeCustomPathByChild is a method called when a
 * path is reparameterized directly to a child relation, rather than the
 * top-level parent.
 *
 * For instance, let there be a join of two partitioned columnar relations PX
 * and PY. A path for a BioseqColumnScan of PY3 might be parameterized by PX so
 * that the join qual "PY3.a = PX.a" (referencing the parent PX) can be pushed
 * down. But if the planner decides on a partition-wise join, then the path
 * will be reparameterized on the child table PX3 directly.
 *
 * When that happens, we need to update all Vars in the pushed-down quals to
 * reference PX3, not PX, to match the new parameterization. This method
 * notifies us that it needs to be done, and allows us to update the
 * information in custom_private.
 */
static List *
BioseqColumnScanPath_ReparameterizeCustomPathByChild(PlannerInfo *root,
												 List *custom_private,
												 RelOptInfo *child_rel)
{
	reparameterize_mutator mutator;
	return reinterpret_cast<List *>(pg_mutate_expression(reinterpret_cast<Node *>(custom_private), *child_rel, mutator));
}

static List* BioseqPerRowJoinPath_ReparameterizeCustomPathByChild(
		PlannerInfo* root, List* custom_private, RelOptInfo* child_rel) {
	if (root == nullptr || root->parse == nullptr || child_rel == nullptr
		|| child_rel->top_parent == nullptr
		|| list_length(custom_private)
			!= kBioseqPerRowJoinPathPrivateFields) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch child reparameterization state is invalid")));
	}
	for (const int index : {0, 1, 2, 3, 7, 8, 9}) {
		Node* value = reinterpret_cast<Node*>(list_nth(custom_private, index));
		if (value == nullptr || !IsA(value, Integer)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch child scalar ABI is invalid"),
				 errdetail("field=%d", index)));
		}
	}
	for (const int index : {4, 5, 6, 10, 11, 12}) {
		if (list_nth(custom_private, index) == nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch child expression ABI is invalid"),
				 errdetail("field=%d", index)));
		}
	}

	const Index target_varno = static_cast<Index>(
		intVal(list_nth(custom_private, 2)));
	const AttrNumber target_storage_attno = static_cast<AttrNumber>(
		intVal(list_nth(custom_private, 3)));
	const Oid target_relation_oid = static_cast<Oid>(
		intVal(list_nth(custom_private, 1)));
	/* Use PostgreSQL's multilevel appendrel translator, not a varno-only
	 * rewrite: attached partitions may have a distinct physical attno map. */
	List* rewritten = reinterpret_cast<List*>(
		adjust_appendrel_attrs_multilevel(
			root, reinterpret_cast<Node*>(custom_private),
			child_rel, child_rel->top_parent));
	if (!bioseq_is_concrete_rte_varno(target_varno)) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch target child varno is invalid")));
	}
	if (bms_is_member(
			static_cast<int>(target_varno), child_rel->top_parent_relids)) {
		if (!bioseq_is_concrete_rte_varno(child_rel->relid)
			|| child_rel->relid > static_cast<Index>(
				list_length(root->parse->rtable))) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch target child RTE is unavailable")));
		}
		RangeTblEntry* child_rte = rt_fetch(
			child_rel->relid, root->parse->rtable);
		if (child_rte == nullptr || child_rte->rtekind != RTE_RELATION
			|| !OidIsValid(child_rte->relid)
			|| !IsBioseqColumnTableAmTable(child_rte->relid)) {
			ereport(ERROR,
				(errcode(ERRCODE_WRONG_OBJECT_TYPE),
				 errmsg("BioseqPerRowMmsearch target partition is not a Bioseq relation")));
		}
		Oid target_type = InvalidOid;
		int32 target_typmod = -1;
		Oid target_collation = InvalidOid;
		get_atttypetypmodcoll(
			target_relation_oid, target_storage_attno,
			&target_type, &target_typmod, &target_collation);
		Var* parent_storage_var = makeVar(
			target_varno, target_storage_attno,
			target_type, target_typmod, target_collation, 0);
		Var* child_storage_var = pg_node_try_as<Var>(
			adjust_appendrel_attrs_multilevel(
				root, reinterpret_cast<Node*>(parent_storage_var),
				child_rel, child_rel->top_parent));
		if (child_storage_var == nullptr
			|| child_storage_var->varno != child_rel->relid
			|| child_storage_var->varattno <= 0
			|| child_storage_var->vartype
				!= get_cached_stub_oids().bioseq_seq_type_oid) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqPerRowMmsearch target partition column mapping is invalid")));
		}
		lfirst(list_nth_cell(rewritten, 1)) = makeInteger(
			static_cast<int>(child_rte->relid));
		lfirst(list_nth_cell(rewritten, 2)) = makeInteger(
			static_cast<int>(child_storage_var->varno));
		lfirst(list_nth_cell(rewritten, 3)) = makeInteger(
			static_cast<int>(child_storage_var->varattno));
	}
	return rewritten;
}


static Node *
BioseqColumnScan_CreateCustomScanState(CustomScan *cscan)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_CreateCustomScanState() entered");
	BioseqScanState* bioseq_scan_state = BioseqScanState::allocate();
	bioseq_scan_state->as_custom_scan_state()->methods = &BioseqColumnScanExecuteMethods;
	bioseq_scan_state->as_custom_scan_state()->ss.ss_currentScanDesc = NULL;
	/*
	 * Defer runtime allocation to BeginCustomScan: that's where we
	 * have the EState (and therefore the per-query MemoryContext we
	 * register the cleanup callback against). A scan that never enters
	 * Begin (e.g. EXPLAIN without ANALYZE) therefore never allocates
	 * a runtime — bioseq_runtime() in the Explain hook is the only
	 * other caller that would lazily allocate, and that case is
	 * benign because EXPLAIN doesn't run the executor body. The
	 * `void*` storage on BioseqScanState lets the public scan-state
	 * header stay standard-layout; we re-cast in bioseq_runtime().
	 */
	bioseq_scan_state->runtime = nullptr;
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_CreateCustomScanState() returning");
	return bioseq_scan_state->as_node();
}


/*
 * eval_params_mutator evaluates Params in the expression and replaces them
 * with Consts, preserving the existing ExecInitExprWithParams / ExecEvalExpr
 * folding path for every Param (not a PARAM_EXEC-only direct lookup).
 */
struct eval_params_mutator {
	[[nodiscard]] pg_node_mutation
	operator()(pg_expression_mutation_cursor, pg_node_view node, ExprContext &econtext) const {
		if (Param *param = node.try_as<Param>())
		{
			int16_t typLen;
			bool typByVal;
			bool isnull;

			get_typlenbyval(param->paramtype, &typLen, &typByVal);

			/* XXX: should save ExprState for efficiency */
			ExprState *exprState = ExecInitExprWithParams(pg_as_expr(node.raw()),
														  econtext.ecxt_param_list_info);
			Datum pval = ExecEvalExpr(exprState, &econtext, &isnull);

			return pg_node_mutation::with(reinterpret_cast<Node *>(makeConst(param->paramtype,
									  param->paramtypmod,
									  param->paramcollid,
									  static_cast<int>(typLen),
									  pval,
									  isnull,
									  typByVal)));
		}

		return pg_node_mutation::descend();
	}
};

/*
 * Thin wrapper for the direct callers (qual folding at Begin/ReScan and the
 * per-Param rebind fold) so they keep the (node, econtext) call shape.
 */
[[nodiscard]] static Node *
eval_params(Node *node, ExprContext *econtext)
{
	eval_params_mutator mutator;
	return pg_mutate_expression(node, *econtext, mutator);
}

enum class MmsearchParamResolution : std::uint8_t {
	configured,
	null_value,
};

/* Resolve the exact Param that registered the primary mmsearch query.  Both
 * supported Param kinds use PostgreSQL's expression machinery so PARAM_EXEC
 * and PARAM_EXTERN read from their correct executor-owned storage. */
[[nodiscard]] static MmsearchParamResolution resolve_mmsearch_param_query(
		BioseqScanRuntime& runtime,
		ExprContext* econtext,
		const char* phase) {
	if (!runtime.param_rebind.active || econtext == nullptr
		|| (runtime.param_rebind.paramkind != PARAM_EXEC
			&& runtime.param_rebind.paramkind != PARAM_EXTERN)
		|| runtime.param_rebind.mmsearch_fe == nullptr
		|| list_length(runtime.param_rebind.mmsearch_fe->args) < 2) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("bioseq mmsearch Param rebind metadata is invalid"),
			 errdetail("phase=%s paramid=%d paramkind=%d",
				phase,
				runtime.param_rebind.paramid,
				runtime.param_rebind.paramkind)));
	}

	PList<Node> arguments(runtime.param_rebind.mmsearch_fe->args);
	Param* param = pg_node_try_as<Param>(arguments.second());
	if (param == nullptr
		|| static_cast<int>(param->paramkind)
			!= runtime.param_rebind.paramkind
		|| param->paramid != runtime.param_rebind.paramid
		|| param->paramtype != runtime.param_rebind.param_typoid
		|| param->paramtypmod != runtime.param_rebind.param_typmod) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("bioseq mmsearch Param changed after registration"),
			 errdetail("phase=%s paramid=%d paramkind=%d",
				phase,
				runtime.param_rebind.paramid,
				runtime.param_rebind.paramkind)));
	}

	Node* folded = eval_params(reinterpret_cast<Node*>(param), econtext);
	Const* query_const = pg_node_try_as<Const>(folded);
	if (query_const == nullptr
		|| query_const->consttype != runtime.param_rebind.param_typoid
		|| query_const->consttypmod != runtime.param_rebind.param_typmod) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("bioseq mmsearch Param resolved to an invalid value"),
			 errdetail("phase=%s paramid=%d paramkind=%d",
				phase,
				runtime.param_rebind.paramid,
				runtime.param_rebind.paramkind)));
	}
	if (query_const->constisnull) {
		runtime.buffer.clear_mmsearch_context();
		runtime.mmsearch_null_input = true;
		bioseq_log<DBG>(
			"[bioseq] pg: {} mmsearch Param paramid={} kind={} resolved "
			"to NULL; strict qual matches no rows",
			phase,
			runtime.param_rebind.paramid,
			runtime.param_rebind.paramkind);
		return MmsearchParamResolution::null_value;
	}

	bioseq::pg_types::seq* query_hdr = reinterpret_cast<bioseq::pg_types::seq*>(
		PG_DETOAST_DATUM(query_const->constvalue));
	const auto query_type_params = query_hdr->get_type_params();
	if (runtime.param_rebind.param_typmod >= 0) {
		const auto declared_type_params =
			compact_sequence_stdc_type_params::decode(
				runtime.param_rebind.param_typmod);
		if (query_type_params != declared_type_params) {
			const unsigned declared_alphabet =
				declared_type_params.alphabet_code;
			const unsigned declared_width =
				declared_type_params.storage_unit_byte_width;
			const unsigned actual_alphabet =
				query_type_params.alphabet_code;
			const unsigned actual_width =
				query_type_params.storage_unit_byte_width;
			if (reinterpret_cast<void*>(query_hdr)
				!= reinterpret_cast<void*>(
					DatumGetPointer(query_const->constvalue))) {
				pfree(query_hdr);
			}
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("bioseq mmsearch Param payload disagrees with its declared typmod"),
				 errdetail(
					"phase=%s paramid=%d paramkind=%d paramtypmod=%d "
					"declared_alphabet=%u declared_width=%u "
					"actual_alphabet=%u actual_width=%u "
					"target_alphabet=%u target_width=%u",
					phase,
					runtime.param_rebind.paramid,
					runtime.param_rebind.paramkind,
					runtime.param_rebind.param_typmod,
					declared_alphabet,
					declared_width,
					actual_alphabet,
					actual_width,
					static_cast<unsigned>(
						runtime.param_rebind.alphabet_code),
					static_cast<unsigned>(runtime.param_rebind.
						storage_unit_byte_width))));
		}
	}
	const compact_sequence_stdc_type_params target_type_params{
		runtime.param_rebind.alphabet_code,
		runtime.param_rebind.storage_unit_byte_width};
	if (query_type_params.alphabet_code
			!= target_type_params.alphabet_code) {
		const auto mismatched_query_type_params = query_type_params;
		if (reinterpret_cast<void*>(query_hdr)
			!= reinterpret_cast<void*>(
				DatumGetPointer(query_const->constvalue))) {
			pfree(query_hdr);
		}
		raise_mmsearch_alphabet_mismatch(
			target_type_params, mismatched_query_type_params, phase);
	}
	if (!pgseq_supported_storage_unit_byte_widths::contains_runtime(
			query_type_params.storage_unit_byte_width)) {
		const unsigned actual_alphabet = query_type_params.alphabet_code;
		const unsigned actual_width =
			query_type_params.storage_unit_byte_width;
		if (reinterpret_cast<void*>(query_hdr)
			!= reinterpret_cast<void*>(
				DatumGetPointer(query_const->constvalue))) {
			pfree(query_hdr);
		}
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("bioseq mmsearch Param payload typmod is incompatible"),
			 errdetail(
				"phase=%s paramid=%d paramkind=%d "
				"expected_alphabet=%u expected_width=%u "
				"actual_alphabet=%u actual_width=%u",
				phase,
				runtime.param_rebind.paramid,
				runtime.param_rebind.paramkind,
				static_cast<unsigned>(target_type_params.alphabet_code),
				static_cast<unsigned>(
					target_type_params.storage_unit_byte_width),
				actual_alphabet,
				actual_width)));
	}
	const std::size_t query_total_bytes =
		static_cast<std::size_t>(VARSIZE(query_hdr));
	std::vector<char> query_varlena_bytes(query_total_bytes);
	std::memcpy(
		query_varlena_bytes.data(), query_hdr, query_total_bytes);
	const std::uint32_t bp_size = query_hdr->bp_size;
	std::vector<char> rewidthed_query_varlena_bytes;
	if (query_type_params.storage_unit_byte_width
			!= target_type_params.storage_unit_byte_width) {
		bioseq::pg_types::seq* rewidthed = ::bioseq::simd::active_target::
			stdc_rewidth_to_type_params(
				*query_hdr, target_type_params, pg_alloc);
		if (rewidthed == nullptr) {
			if (reinterpret_cast<void*>(query_hdr)
				!= reinterpret_cast<void*>(
					DatumGetPointer(query_const->constvalue))) {
				pfree(query_hdr);
			}
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("bioseq mmsearch Param rewidth rejected an incompatible alphabet")));
		}
		const std::size_t rewidthed_bytes =
			static_cast<std::size_t>(VARSIZE(rewidthed));
		rewidthed_query_varlena_bytes.assign(
			reinterpret_cast<const char*>(rewidthed),
			reinterpret_cast<const char*>(rewidthed) + rewidthed_bytes);
		pfree(rewidthed);
	}
	if (reinterpret_cast<void*>(query_hdr)
		!= reinterpret_cast<void*>(DatumGetPointer(query_const->constvalue))) {
		pfree(query_hdr);
	}
	runtime.buffer.configure_mmsearch(
		runtime.param_rebind.seq_attno,
		runtime.param_rebind.column_name,
		std::move(query_varlena_bytes),
		runtime.param_rebind.alphabet_code,
		runtime.param_rebind.storage_unit_byte_width,
		runtime.param_rebind.primary_key_attno);
	if (!rewidthed_query_varlena_bytes.empty()) {
		runtime.buffer.apply_typmod_coalesce(
			std::move(rewidthed_query_varlena_bytes));
	}
	runtime.mmsearch_null_input = false;
	bioseq_log<DBG>(
		"[bioseq] pg: {} rebound mmsearch query bp_size={} extras_count={} "
		"from Param paramid={} kind={}",
		phase,
		bp_size,
		runtime.buffer.extra_query_count(),
		runtime.param_rebind.paramid,
		runtime.param_rebind.paramkind);
	return MmsearchParamResolution::configured;
}

[[noreturn]] static void raise_column_scan_vulkan_error_as_cpp(
		std::string_view detail,
		std::string_view hint) {
	const std::string owned_detail{detail};
	const std::string owned_hint{hint};
	const char* detail_cstr = owned_detail.c_str();
	const char* hint_cstr = owned_hint.c_str();
	bioseq::pg_utils::invoke_pg_as_cpp([detail_cstr, hint_cstr] {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg_internal("%s", "Vulkan aligner execution failed"),
			 errdetail_internal("%s", detail_cstr),
			 errhint("%s", hint_cstr)));
	});
	pg_unreachable();
}


static void
BioseqColumnScan_BeginCustomScanImpl(CustomScanState *cscanstate, EState *estate, int eflags)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() entered");
	CustomScan *cscan = reinterpret_cast<CustomScan *>(cscanstate->ss.ps.plan);
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(cscanstate);
	ExprContext *stdecontext = cscanstate->ss.ps.ps_ExprContext;
	cscanstate->ss.ss_currentScanDesc = NULL;
	register_runtime_cleanup_callback(bioseqScanState, estate);
	BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);
	runtime.locator_passthrough = false;
	runtime.lazy_source_projection = false;
	runtime.lazy_source_projected_bindings.clear();
	runtime.lazy_source_physical_producer_ids.clear();
	runtime.lazy_source_physical_bound.clear();
	runtime.mmsearch_pre_eval_source_bound.clear();
	runtime.mmsearch_output_source_bound.clear();
	runtime.mmsearch_pre_eval_sources_present = false;
	runtime.locator_parent_token = 0;
	runtime.locator_rowno_resno = InvalidAttrNumber;
	runtime.edit_predicate_active = false;
	runtime.edit_exclusive_upper_bound = 0;
	runtime.edit_sequence_attno = InvalidAttrNumber;
	runtime.match_sequence_varno = 0;
	runtime.match_sequence_attno = InvalidAttrNumber;
	runtime.match_target_recipe = nullptr;
	runtime.match_query_recipe = nullptr;
	runtime.match_target_lineage = NIL;
	runtime.match_query_lineage = NIL;
	runtime.match_target_expr_state = nullptr;
	runtime.match_query_expr_state = nullptr;
	runtime.match_target_typmod = -1;
	runtime.match_query_typmod = -1;
	runtime.match_target_evaluated = false;
	runtime.match_query_evaluated = false;
	runtime.match_evaluated_submission = false;
	runtime.match_helper_sites = NIL;
	runtime.stable_match_id = 0;
	runtime.mmsearch_null_input = false;
	FrozenBioseqScanSemantics frozen_semantics{};
	if (!decode_bioseq_semantic_payload(
			cscan->custom_private, &frozen_semantics)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan semantic payload is malformed"),
			 errdetail("Expected semantic_payload format version %d with exactly %d typed fields.",
				kBioseqSemanticPayloadFormatVersion,
				kBioseqSemanticPayloadFieldCount)));
	}
	Node* base_match_target_recipe = initialize_base_match_owner_runtime(
		cscan, cscanstate->ss.ss_currentRelation, runtime);
	for (Node* private_node : PList<Node>(cscan->custom_private)) {
		if (private_node == nullptr || !IsA(private_node, List)) continue;
		List* tag = reinterpret_cast<List*>(private_node);
		if (list_length(tag) == 0
			|| !IsA(reinterpret_cast<Node*>(linitial(tag)), Integer)) continue;
		const int magic = intVal(linitial(tag));
		if (magic == kBioseqLocatorPassthroughMagic) {
			if (list_length(tag) != 4
				|| intVal(list_nth(tag, 1)) != kBioseqBatchJoinPlanVersion) {
				ereport(ERROR,
					(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
					 errmsg("Bioseq locator passthrough plan tag is invalid")));
			}
			runtime.locator_passthrough = true;
			runtime.locator_parent_token = intVal(list_nth(tag, 2));
			runtime.locator_rowno_resno = static_cast<AttrNumber>(
				intVal(list_nth(tag, 3)));
			} else if (magic == kBioseqSliceSourceMagic) {
				Node* version_node = list_length(tag) >= 2
					? reinterpret_cast<Node*>(list_nth(tag, 1)) : nullptr;
				Node* bindings_node = list_length(tag) == 3
					? reinterpret_cast<Node*>(list_nth(tag, 2)) : nullptr;
				if (list_length(tag) != 3
					|| version_node == nullptr || !IsA(version_node, Integer)
					|| intVal(version_node) != kBioseqSliceSourceVersion
					|| (bindings_node != nullptr && !IsA(bindings_node, List))) {
					ereport(ERROR,
						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
						 errmsg("Bioseq SliceProject source tag is invalid")));
				}
				runtime.lazy_source_projection = true;
				TupleDesc relation_descriptor = RelationGetDescr(
					cscanstate->ss.ss_currentRelation);
				const int relation_natts = relation_descriptor->natts;
				const int projected_natts = list_length(
					cscan->scan.plan.targetlist);
				runtime.lazy_source_projected_bindings.assign(
					static_cast<std::size_t>(projected_natts + 1), {});
				runtime.lazy_source_physical_producer_ids.assign(
					static_cast<std::size_t>(relation_natts + 1), 0u);
				runtime.lazy_source_physical_bound.assign(
					static_cast<std::size_t>(relation_natts + 1), 0u);
				const Oid seq_oid = get_cached_stub_oids().bioseq_seq_type_oid;
				List* bindings = bindings_node == nullptr ? NIL
					: reinterpret_cast<List*>(bindings_node);
				for (Node* raw_binding : PList<Node>(bindings)) {
					List* binding = raw_binding != nullptr && IsA(raw_binding, List)
						? reinterpret_cast<List*>(raw_binding) : NIL;
					if (list_length(binding) != 3
						|| !IsA(reinterpret_cast<Node*>(linitial(binding)), Integer)
						|| !IsA(reinterpret_cast<Node*>(lsecond(binding)), Integer)
						|| !IsA(reinterpret_cast<Node*>(lthird(binding)), Integer)) {
						ereport(ERROR,
							(errcode(ERRCODE_DATA_CORRUPTED),
							 errmsg("Bioseq SliceProject source binding is invalid")));
					}
					const int resno = intVal(linitial(binding));
					const int producer_id = intVal(lsecond(binding));
					const int column_attno = intVal(lthird(binding));
					TargetEntry* target_entry = resno > 0 && resno <= projected_natts
						? pg_node_try_as<TargetEntry>(reinterpret_cast<Node*>(
							list_nth(cscan->scan.plan.targetlist, resno - 1)))
						: nullptr;
					Form_pg_attribute relation_attribute =
						column_attno > 0 && column_attno <= relation_natts
							? TupleDescAttr(relation_descriptor, column_attno - 1)
							: nullptr;
					if (resno <= 0
						|| resno > projected_natts
						|| producer_id < 0
						|| column_attno <= 0
						|| column_attno > relation_natts
						|| target_entry == nullptr
						|| exprType(reinterpret_cast<Node*>(target_entry->expr))
							!= seq_oid
						|| relation_attribute == nullptr
						|| relation_attribute->attisdropped
						|| relation_attribute->atttypid != seq_oid
						|| runtime.lazy_source_projected_bindings[resno].
							physical_attno != InvalidAttrNumber
						|| runtime.lazy_source_physical_bound[column_attno]
							!= 0u) {
						ereport(ERROR,
							(errcode(ERRCODE_DATA_CORRUPTED),
							 errmsg("Bioseq SliceProject source binding is out of range")));
					}
					runtime.lazy_source_projected_bindings[resno] = {
						.producer_id = static_cast<std::uint32_t>(producer_id),
						.physical_attno = static_cast<AttrNumber>(column_attno),
					};
					runtime.lazy_source_physical_producer_ids[column_attno] =
						static_cast<std::uint32_t>(producer_id);
					runtime.lazy_source_physical_bound[column_attno] = 1u;
				}
		} else if (magic == kBioseqEditPredicateMagic) {
			Const* threshold = list_length(tag) == 4
				? pg_node_try_as<Const>(reinterpret_cast<Node*>(list_nth(tag, 2)))
				: nullptr;
			Node* sequence_attno_node = list_length(tag) == 4
				? reinterpret_cast<Node*>(list_nth(tag, 3))
				: nullptr;
			if (list_length(tag) != 4
				|| intVal(list_nth(tag, 1)) != kBioseqEditPredicateVersion
				|| threshold == nullptr || threshold->constisnull
				|| threshold->consttype != INT8OID
				|| sequence_attno_node == nullptr
				|| !IsA(sequence_attno_node, Integer)
				|| intVal(sequence_attno_node) <= 0
				|| intVal(sequence_attno_node) > MaxAttrNumber) {
				ereport(ERROR,
					(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
					 errmsg("Bioseq edit-predicate plan tag is invalid")));
			}
			runtime.edit_predicate_active = true;
			runtime.edit_exclusive_upper_bound =
				DatumGetInt64(threshold->constvalue);
			runtime.edit_sequence_attno = static_cast<AttrNumber>(
				intVal(sequence_attno_node));
		}
	}

	/*
	 * Make a new ExprContext just like the existing one, except that we don't
	 * reset it every tuple.
	 */
	ExecAssignExprContext(estate, &cscanstate->ss.ps);
	bioseqScanState->css_RuntimeContext = cscanstate->ss.ps.ps_ExprContext;
	cscanstate->ss.ps.ps_ExprContext = stdecontext;

	ResetExprContext(bioseqScanState->css_RuntimeContext);
	PList<List> custom_exprs(cscan->custom_exprs);
	List *plainClauses = custom_exprs.first();
	List* owned_mmsearch_quals = list_length(cscan->custom_exprs) >= 4
		? reinterpret_cast<List*>(list_nth(cscan->custom_exprs, 3))
		: NIL;
	if (list_length(owned_mmsearch_quals) > 2) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("Bioseq scan plan owns too many mmsearch expressions")));
	}
	if ((base_match_target_recipe != nullptr)
		!= (list_length(owned_mmsearch_quals) >= 1)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan match owner expression identity is incomplete")));
	}
	List *storagePlainClauses = storage_prunable_quals_without_mmsearch(
		plainClauses, get_cached_stub_oids());
	bioseqScanState->qual = reinterpret_cast<List *>(eval_params(
		reinterpret_cast<Node *>(storagePlainClauses), bioseqScanState->css_RuntimeContext));

	/*
	 * Third list in custom_exprs should contain vectorized qual list if not
	 * NULL.
	 */
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() examining custom_exprs for vectorized qual");
	List* vectorized_qual_list = custom_exprs.third();
	if (vectorized_qual_list != NIL) {
		bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() vectorized qual list present");
		bioseqScanState->vectorization.vectorizedQualList = vectorized_qual_list;
	}

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() iterating custom_private");
	for (auto private_node : PList<Node>(cscan->custom_private))
	{
		Const* private_const_node = pg_node_try_as<Const>(private_node);
		if (private_const_node == nullptr) {
			continue;
		}
		if (private_const_node->consttype == CUSTOM_SCAN_VECTORIZED_AGGREGATE)
		{
			bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() setting vectorizationAggregate");
			bioseqScanState->vectorization.vectorizationAggregate = private_const_node->constvalue;
		}
	}
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() custom_private iteration complete");

	/*
	 * Vectorization is enabled if global variable is set and there is at least one
	 * filter which can be vectorized.
	 */
	bioseqScanState->vectorization.vectorizationEnabled =
		bioseq::settings::enable_vectorization && !runtime.locator_passthrough
		&& !runtime.lazy_source_projection &&
		(bioseqScanState->vectorization.vectorizedQualList != NULL ||
		 bioseqScanState->vectorization.vectorizationAggregate);

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() guc_vec={} has_vec_qual={} vec_aggregate={}",
		bioseq::settings::enable_vectorization,
		bioseqScanState->vectorization.vectorizedQualList != NULL,
		bioseqScanState->vectorization.vectorizationAggregate);
	if (bioseqScanState->vectorization.vectorizationAggregate)
	{
		ScanState *node = reinterpret_cast<ScanState *>(&bioseqScanState->custom_scanstate.ss);

		if (node->ps.ps_ProjInfo)
		{
			bioseqScanState->vectorization.resultVectorSlot =
				CreateVectorTupleTableSlot(node->ps.ps_ProjInfo->pi_state.resultslot->tts_tupleDescriptor);
		}
		else
		{
			bioseqScanState->vectorization.resultVectorSlot =
				CreateVectorTupleTableSlot(node->ps.ps_ResultTupleDesc);
		}
	}

	if (bioseqScanState->vectorization.vectorizationEnabled)
	{
		bioseqScanState->vectorization.scanVectorSlot =
			CreateVectorTupleTableSlot(cscanstate->ss.ss_ScanTupleSlot->tts_tupleDescriptor);
	}

	/* The owned mmsearch was deliberately removed from plan.qual and lives in
	 * custom_exprs[3], but its target/query Vars remain physical scan-column
	 * dependencies.  In projection-free shapes such as count(*), omitting that
	 * private expression makes the columnar reader optimize the target column
	 * away and submit_scan observes a false NULL.  Combine only list cells for
	 * dependency discovery; the private expression remains non-executable. */
	List* attr_needed_custom_expressions = list_concat_copy(
		bioseqScanState->vectorization.vectorizedQualList,
		owned_mmsearch_quals);
	bioseqScanState->attrNeeded = BioseqColumnAttrNeeded(
		&cscanstate->ss, attr_needed_custom_expressions);
	list_free(attr_needed_custom_expressions);

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() iterating attrNeeded bitmap members");
	for (int attrIndex : bioseqScanState->attrNeeded)
	{
		bioseqScanState->vectorization.attrNeededList.append(attrIndex);
	}

	/*
	 * If we have pending changes that need to be flushed (row_mask after update/delete)
	 * or new stripe we need to to them here because sequential columnar scan 
	 * can have parallel execution and updated are not allowed in parallel mode.
	 */
	bioseqScanState->snapshot = estate->es_snapshot;
	bioseqScanState->snapshotRegisteredByUs = false;
	Oid relationOid = cscanstate->ss.ss_currentRelation->rd_locator.relNumber;

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() checking parallel mode");
	if(!IsInParallelMode())
	{
		RowMaskFlushWriteStateForRelfilenode(relationOid, GetCurrentSubTransactionId());

		FlushWriteStateWithNewSnapshot(relationOid, &bioseqScanState->snapshot,
									   &bioseqScanState->snapshotRegisteredByUs);
	}
	const bool owns_mmsearch_source = owned_mmsearch_quals != NIL;
	if (runtime.lazy_source_projection || runtime.locator_passthrough
		|| owns_mmsearch_source) {
		runtime.lazy_source_provider =
			bioseq::storage::create_pg_sequence_source_provider(
				cscanstate->ss.ss_currentRelation, bioseqScanState->snapshot);
		if (runtime.lazy_source_provider == nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
				 errmsg("Bioseq source provider is unavailable")));
		}
		runtime.buffer.bind_sequence_source_provider(
			runtime.lazy_source_provider);
	}

	/*
	 * Discover the primary-key column by scanning the unmutated
	 * targetlist for the first bioseq.<field>(Var) FuncExpr and using
	 * its Var argument's varattno. BeginCustomScan runs before
	 * CustomExecScan, so at this point cscan->scan.plan.targetlist
	 * still contains the FuncExprs — they haven't been rewritten to
	 * Const* yet (the rewrite target is newtargetlist, not
	 * scan.plan.targetlist).
	 */
	const BioseqStubOids& scan_stub_oids = get_cached_stub_oids();
	for (Node* executable_qual : PList<Node>(cscan->scan.plan.qual)) {
		if (contains_mmsearch_qualifier(executable_qual, scan_stub_oids)) {
			FuncExpr* top_level = pg_node_try_as<FuncExpr>(executable_qual);
			if (top_level == nullptr
				|| !is_mmsearch_funcid(top_level->funcid, scan_stub_oids)) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("nested mmsearch qualifier shape is unsupported"),
					 errdetail("mmsearch must be consumed by the alignment runtime; executing its SQL stub without alignment is forbidden"),
					 errhint("Place mmsearch(...) directly in a top-level AND conjunct.")));
			}
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("mmsearch qualifier is not owned by a Bioseq executor"),
				 errdetail("Nested, stacked, volatile, security-sensitive, or otherwise unsupported mmsearch shapes cannot execute through the SQL function."),
				 errhint("Use exactly one top-level mmsearch predicate with supported operands, or split the query into separate levels.")));
		}
	}
	AttrNumber primary_key_attno = InvalidAttrNumber;
	for (auto tgt : PList<TargetEntry>(cscan->scan.plan.targetlist))
	{
		if (tgt == nullptr) continue;
		FuncExpr* fe = pg_node_try_as<FuncExpr>(pg_as_node(tgt->expr));
		if (fe == nullptr) continue;
		if (!is_bioseq_projection_funcid(fe->funcid, scan_stub_oids)) continue;
		if (list_length(fe->args) < 1) continue;
		PList<Node> fe_args(fe->args);
		Node* arg0 = fe_args.first();
		Var* pk_var = pg_node_try_as<Var>(arg0);
		if (pk_var == nullptr) continue;
		if (pk_var->varattno <= 0) continue;
		/* Projection helpers are semantically tied to the current MatchResult,
		 * not to an int key argument.  The direct-query surface therefore
		 * permits bioseq.edit(seq) / bioseq.cigar(seq).  Retain the historical
		 * optional PK capture only when the supplied Var is actually INT4. */
		if (pk_var->vartype != INT4OID) continue;
		primary_key_attno = pk_var->varattno;
		bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() detected primary_key varattno={} from bioseq projection funcid={}",
				static_cast<int>(primary_key_attno), fe->funcid);
		break;
	}

	/*
	 * Register the per-query MemoryContext callback BEFORE touching
	 * the runtime so an ereport(ERROR) further down still triggers
	 * cleanup on transaction abort. Idempotent across rescans.
	 */
	register_runtime_cleanup_callback(bioseqScanState, estate);

	/*
	 * Decode the planner-owned expression set from custom_exprs and configure
	 * the dispatch buffer. The executable qual list is intentionally ignored.
	 */
	/* Begin is the only place that should drop extras as part of the
	 * primary reset — every Begin call repopulates them from scratch
	 * via the qual loop. ReScan / failure paths must NOT drop extras
	 * (see clear_mmsearch_context's comment for the §9 review fix). */
	runtime.buffer.clear_mmsearch_context(/*clear_extras=*/true);
	runtime.param_rebind = MmsearchParamRebind{};

	Relation relation_for_attname = cscanstate->ss.ss_currentRelation;
	const Oid relation_oid_for_attname = RelationGetRelid(relation_for_attname);

	/*
	 * State retained by the legacy classifier/configuration branches. Planner
	 * ownership guarantees this loop contains one primary expression and, only
	 * for the parameterized join shape, at most one same-target Const extra.
	 *
	 * `primary_configured` flips once the primary owned expression is installed
	 * through the Const, Param-rebind, or same-relation Var path.
	 */
	bool primary_configured = false;
	AttrNumber primary_seq_attno = InvalidAttrNumber;
	FuncExpr* primary_mmsearch_fe = nullptr;

	/*
	 * Process only the private expressions selected by the planner. Executable
	 * quals never participate in alignment ownership. General stacked calls are
	 * rejected before a CustomPath is built; the bounded Param-primary/Const-
	 * extra shape is sorted and configured here.
	 *
	 * Solution: classify quals first, then pick the primary by
	 * priority:
	 *   - Var-same-rel  > Param  > Const
	 * Var-same-rel and Param NEED to be the primary (their machinery
	 * lives in the buffer's mmsearch_context / param_rebind slots
	 * which only exist once per scan). Const can be either primary
	 * OR an extra. So putting Param first guarantees the AND-stack
	 * works regardless of planner qual order.
	 *
	 * If we discover a Var-same-rel and a Param in the same plan
	 * we reject the Param (we only have one primary slot); same for
	 * multi-Param or multi-Var-same-rel. Every top-level mmsearch qual must
	 * be accounted for below: unsupported combinations fail closed rather
	 * rather than reaching the fail-closed SQL rendezvous stub.
	 */
	struct ClassifiedMmsearchQual {
		FuncExpr* fe;
		Node* arg0;
		Node* arg1;
		bool is_const;
		bool is_param;
		bool is_var_same_rel;
		bool is_evaluated_row_query;
	};
	std::vector<ClassifiedMmsearchQual> classified_quals;
	std::size_t top_level_mmsearch_qual_count = 0;
	for (auto qual_node : PList<Node>(owned_mmsearch_quals))
	{
		FuncExpr* fe_classify = pg_node_try_as<FuncExpr>(qual_node);
		if (fe_classify == nullptr
			|| !is_mmsearch_funcid(fe_classify->funcid, scan_stub_oids)) {
			/* The storage-pruning copy deliberately drops every clause whose
			 * subtree contains mmsearch(), but the alignment runtime currently
			 * consumes only a top-level mmsearch FuncExpr. Letting a BooleanTest,
			 * NOT, CASE, COALESCE, or other wrapper proceed would leave the
			 * runtime unconfigured and evaluate the immutable SQL stub instead.
			 * That stub is only a planner/executor rendezvous marker and must never
			 * become the query's alignment result. */
			if (contains_mmsearch_qualifier(qual_node, scan_stub_oids)) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("nested mmsearch qualifier shape is unsupported"),
					 errdetail("mmsearch must be consumed by the alignment runtime; executing its SQL stub without alignment is forbidden"),
					 errhint("Place mmsearch(...) directly in a top-level AND conjunct.")));
			}
			continue;
		}
		++top_level_mmsearch_qual_count;
		/* Reject a parameterized/column-valued third argument even when this
		 * qualifier is later rejected as an unsupported primary/extra shape. */
		(void) require_aligner_options_const(fe_classify, scan_stub_oids);
		pg_first_two_node_args classify_args = pg_first_two_args_if_arity_between(*fe_classify, 2, 3);
		if (!classify_args.present()) {
			continue;
		}
		Node* a0 = classify_args.first;
		Node* a1 = classify_args.second;
		if (base_match_target_recipe == nullptr
			|| !equal(a0, base_match_target_recipe)) {
			continue;
		}
		const bool is_c = pg_node_view{a1}.is<Const>();
		const bool is_p = pg_node_view{a1}.is<Param>();
		Var* a1_var = pg_node_try_as<Var>(a1);
		const bool is_v = a1_var != nullptr
			&& a1_var->varno == cscan->scan.scanrelid
			&& a1_var->varattno > 0;
		const bool is_evaluated_query = !is_c && !is_p && !is_v
			&& a1 != nullptr
			&& exprType(a1) == scan_stub_oids.bioseq_seq_type_oid;
		if (!is_c && !is_p && !is_v && !is_evaluated_query) {
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() classifier skipping mmsearch (arg1 tag={} is not Const/Param/same-rel-Var)",
					pg_node_tag_name(pg_node_tag_or_invalid(a1)));
			continue;
		}
		classified_quals.push_back({
			fe_classify, a0, a1, is_c, is_p, is_v,
			is_evaluated_query});
	}
	/*
	 * Sort by priority (Var-same-rel > Param > Const) using stable
	 * partition so quals of equal priority keep planner order. The
	 * Var-same-rel and Param branches can each fire AT MOST ONCE per
	 * scan (they consume the single primary slot); unsupported subsequent
	 * quals fail closed below.
	 */
	std::stable_sort(classified_quals.begin(), classified_quals.end(),
		[](const ClassifiedMmsearchQual& lhs, const ClassifiedMmsearchQual& rhs) {
			auto pri = [](const ClassifiedMmsearchQual& q) {
			if (q.is_var_same_rel) return 0;
			if (q.is_evaluated_row_query) return 0;
				if (q.is_param)        return 1;
				return 2;  /* Const */
			};
			return pri(lhs) < pri(rhs);
		});

	std::size_t consumed_mmsearch_qual_count = 0;
	for (auto& classified : classified_quals)
	{
		FuncExpr* fe                 = classified.fe;
		Node* arg0                   = classified.arg0;
		Node* arg1                   = classified.arg1;
		const bool arg1_is_const     = classified.is_const;
		const bool arg1_is_param     = classified.is_param;
		const bool arg1_is_var_same_rel = classified.is_var_same_rel;
		const bool arg1_is_evaluated_row =
			classified.is_evaluated_row_query;
		Var* col_var = runtime.match_target_lineage == NIL ? nullptr
			: reinterpret_cast<Var*>(linitial(runtime.match_target_lineage));
		if (col_var == nullptr || arg0 == nullptr
			|| !equal(arg0, runtime.match_target_recipe)) continue;

		if (arg1_is_const)
		{
			Const* query_const = reinterpret_cast<Const*>(arg1);
			if (query_const->consttype != scan_stub_oids.bioseq_seq_type_oid)
			{
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg1 is not a bioseq.seq Const (type={}, null={})",
						query_const->consttype, query_const->constisnull);
				continue;
			}
		}
		else if (arg1_is_param)
		{
			Param* query_param = reinterpret_cast<Param*>(arg1);
			if (query_param->paramtype != scan_stub_oids.bioseq_seq_type_oid)
			{
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg1 Param has paramtype={}, expected bioseq.seq ({})",
						query_param->paramtype, scan_stub_oids.bioseq_seq_type_oid);
				continue;
			}
			/* PARAM_EXEC is installed by a parameterized Nested Loop;
			 * PARAM_EXTERN is supplied by PREPARE/client parameters. The
			 * shared evaluator below routes each kind through PostgreSQL's
			 * own ExprContext storage. */
			if (query_param->paramkind != PARAM_EXEC
				&& query_param->paramkind != PARAM_EXTERN)
			{
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg1 Param has unsupported paramkind={}",
						static_cast<int>(query_param->paramkind));
				continue;
			}
		}
		else if (arg1_is_var_same_rel)
		{
			Var* query_var = reinterpret_cast<Var*>(arg1);
			if (query_var->vartype != scan_stub_oids.bioseq_seq_type_oid)
			{
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg1 Var vartype={} not bioseq.seq",
						query_var->vartype);
				continue;
			}
		}
		else if (!arg1_is_evaluated_row)
		{
			continue;
		}

		TupleDesc tuple_descriptor = RelationGetDescr(relation_for_attname);
		if (col_var->varattno <= 0 || col_var->varattno > tuple_descriptor->natts)
		{
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg0 varattno={} out of range natts={}",
					static_cast<int>(col_var->varattno), tuple_descriptor->natts);
			continue;
		}
		Form_pg_attribute attribute_form = TupleDescAttr(tuple_descriptor, col_var->varattno - 1);
		if (attribute_form->atttypid != scan_stub_oids.bioseq_seq_type_oid)
		{
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg0 column type is {}, expected bioseq.seq ({})",
					attribute_form->atttypid, scan_stub_oids.bioseq_seq_type_oid);
			continue;
		}

		/*
		 * Resolve arg1's typmod. There are exactly three outcomes:
		 *   - same (alphabet, width): direct dispatch, no extras.
		 *   - same alphabet, different width: deterministic rewidth to
		 *     the target column's physical shape.
		 *   - different bound alphabets: SQLSTATE 42804 before any
		 *     detoast, dispatch, sidecar read, or generic recoder.
		 */
		if (runtime.match_target_typmod < 0)
		{
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg0 has unconstrained typmod; bioseq.seq columns require an explicit (alphabet,width)");
			continue;
		}
		int32 arg1_typmod = -1;
		if (arg1_is_const) {
			arg1_typmod = reinterpret_cast<Const*>(arg1)->consttypmod;
		} else if (arg1_is_param) {
			arg1_typmod = reinterpret_cast<Param*>(arg1)->paramtypmod;
		} else if (arg1_is_var_same_rel) {
			arg1_typmod = reinterpret_cast<Var*>(arg1)->vartypmod;
		} else {
			const BaseLocalSequenceTypmodResolution query_type =
				base_local_sequence_typmod_resolution(arg1, scan_stub_oids);
			if (query_type.invalid || query_type.typmod < 0) continue;
			arg1_typmod = query_type.typmod;
		}
		const bool runtime_typed_external_param =
			arg1_is_param && arg1_typmod < 0
			&& reinterpret_cast<Param*>(arg1)->paramkind == PARAM_EXTERN;
		if (arg1_typmod < 0 && !runtime_typed_external_param)
		{
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() mmsearch arg1 has unconstrained typmod; add ::bioseq.seq('dna4', N) to the literal/param");
			continue;
		}
		const auto unpacked_typmod = compact_sequence_stdc_type_params::decode(
			runtime.match_target_typmod);
		/* PostgreSQL's generic PREPARE Param retains only the base type OID and
		 * commonly reports paramtypmod=-1 even when the declaration spells a
		 * bioseq typmod.  Its varlena header remains authoritative and is checked
		 * on every Begin/ReScan by resolve_mmsearch_param_query(). */
		const auto unpacked_arg1_typmod = runtime_typed_external_param
			? unpacked_typmod
			: compact_sequence_stdc_type_params::decode(arg1_typmod);
		const bool same_alphabet =
			unpacked_typmod.alphabet_code == unpacked_arg1_typmod.alphabet_code;
		if (!runtime_typed_external_param && !same_alphabet) {
			raise_mmsearch_alphabet_mismatch(
				unpacked_typmod, unpacked_arg1_typmod,
				"column scan begin");
		}

		/*
		 * Sanity-check the primary key column: must be INT4 for the POC.
		 * If it is not INT4 or InvalidAttrNumber we still configure — the
		 * batch processor will treat the column as null-PK and filter
		 * those rows out (see TupleDispatchBuffer::run_batch_and_build_cursors).
		 */
		if (primary_key_attno != InvalidAttrNumber
			&& primary_key_attno <= tuple_descriptor->natts)
		{
			Form_pg_attribute pk_attr_form = TupleDescAttr(tuple_descriptor, primary_key_attno - 1);
			if (pk_attr_form->atttypid != INT4OID)
			{
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() primary key column type is {} not INT4OID; rows will be mis-keyed",
						pk_attr_form->atttypid);
			}
		}

		char* attname_cstr = get_attname(relation_oid_for_attname, col_var->varattno, /*missing_ok=*/true);
		if (attname_cstr == nullptr)
		{
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() get_attname returned NULL for attno={}",
					static_cast<int>(col_var->varattno));
			continue;
		}

		if (primary_configured)
		{
			if (!arg1_is_const || col_var->varattno != primary_seq_attno) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("stacked mmsearch qualifiers are unsupported"),
					 errdetail("Only a constant same-target filter can accompany a parameterized primary mmsearch.")));
			}
			Const* query_const = reinterpret_cast<Const*>(arg1);
			if (query_const->constisnull
				|| !bounded_batch_fallback_options_are_supported(
					primary_mmsearch_fe, fe, scan_stub_oids)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("Bioseq scan bounded mmsearch stack is invalid"),
					 errdetail("The constant extra must be non-NULL, use default biological options, and accompany an explicitly require-absent primary.")));
			} else {
				bioseq::pg_types::seq* query_hdr = reinterpret_cast<bioseq::pg_types::seq*>(
					PG_DETOAST_DATUM(query_const->constvalue));
				const auto physical_query_type = query_hdr->get_type_params();
				if (physical_query_type.alphabet_code
						!= unpacked_typmod.alphabet_code) {
					const auto mismatch = physical_query_type;
					if (reinterpret_cast<void*>(query_hdr)
						!= reinterpret_cast<void*>(DatumGetPointer(
							query_const->constvalue))) pfree(query_hdr);
					raise_mmsearch_alphabet_mismatch(
						unpacked_typmod, mismatch, "constant extra binding");
				}
				bioseq::pg_types::seq* normalized_query = query_hdr;
				if (physical_query_type != unpacked_typmod) {
					normalized_query = ::bioseq::simd::active_target::
						stdc_rewidth_to_type_params(
							*query_hdr, unpacked_typmod, pg_alloc);
					if (normalized_query == nullptr) {
						if (reinterpret_cast<void*>(query_hdr)
							!= reinterpret_cast<void*>(DatumGetPointer(
								query_const->constvalue))) pfree(query_hdr);
						ereport(ERROR,
							(errcode(ERRCODE_DATATYPE_MISMATCH),
							 errmsg("bioseq mmsearch constant extra rewidth rejected an incompatible alphabet")));
					}
				}
				const size_t query_total_bytes = static_cast<size_t>(
					VARSIZE(normalized_query));
				std::vector<char> query_varlena_bytes(query_total_bytes);
				std::memcpy(query_varlena_bytes.data(), normalized_query,
					query_total_bytes);
				if (normalized_query != query_hdr) pfree(normalized_query);
				if (reinterpret_cast<void*>(query_hdr)
					!= reinterpret_cast<void*>(DatumGetPointer(
						query_const->constvalue))) pfree(query_hdr);
				runtime.buffer.add_extra_const_query(
					std::move(query_varlena_bytes));
			}
			++consumed_mmsearch_qual_count;
			pfree(attname_cstr);
			continue;
		}

		if (arg1_is_const)
		{
			/*
			 * Literal-query case. Detoast the query bioseq.seq varlena once;
			 * submit_scan reuses the bytes across every row so the TOAST read
			 * never happens on the hot path. The buffer owns a std::vector<char>
			 * copy so the bytes outlive the planner's per-query memory context.
			 */
			Const* query_const = reinterpret_cast<Const*>(arg1);
			if (query_const->constisnull) {
				runtime.mmsearch_null_input = true;
			} else {
			bioseq::pg_types::seq* query_hdr = reinterpret_cast<bioseq::pg_types::seq*>(
				PG_DETOAST_DATUM(query_const->constvalue));
			const auto physical_query_type = query_hdr->get_type_params();
			if (physical_query_type.alphabet_code
					!= unpacked_typmod.alphabet_code) {
				const auto mismatch = physical_query_type;
				if (reinterpret_cast<void*>(query_hdr)
					!= reinterpret_cast<void*>(
						DatumGetPointer(query_const->constvalue))) {
					pfree(query_hdr);
				}
				raise_mmsearch_alphabet_mismatch(
					unpacked_typmod, mismatch, "literal binding");
			}
			const size_t query_total_bytes = static_cast<size_t>(VARSIZE(query_hdr));
			std::vector<char> query_varlena_bytes(query_total_bytes);
			std::memcpy(query_varlena_bytes.data(), query_hdr, query_total_bytes);
			if (reinterpret_cast<void*>(query_hdr)
				!= reinterpret_cast<void*>(DatumGetPointer(query_const->constvalue)))
			{
				pfree(query_hdr);
			}

			runtime.buffer.configure_mmsearch(col_var->varattno,
										  std::string(attname_cstr),
										  std::move(query_varlena_bytes),
										  unpacked_typmod.alphabet_code,
										  unpacked_typmod.storage_unit_byte_width,
										  primary_key_attno);
			/* Same-alphabet width coalescing preserves logical letters and keeps
			 * the target column's sidecar valid. Alphabet mismatch was rejected
			 * above and can never enter this block. */
			if (physical_query_type != unpacked_typmod) {
				/*
				 * Rewidth the literal at the column's typmod when its physical
				 * payload has not already been normalized to that shape. We
				 * have to re-detoast here because the previous
				 * detoast scope above already pfree'd the local
				 * copy. apply_typmod_coalesce stores the result
				 * inside the buffer's mmsearch_context.
				 */
				bioseq::pg_types::seq* src_hdr2 =
					reinterpret_cast<bioseq::pg_types::seq*>(
						PG_DETOAST_DATUM(query_const->constvalue));
				bioseq::pg_types::seq* rewidthed = ::bioseq::simd::active_target::
					stdc_rewidth_to_type_params(
						*src_hdr2, unpacked_typmod, pg_alloc);
				if (reinterpret_cast<void*>(src_hdr2)
					!= reinterpret_cast<void*>(DatumGetPointer(query_const->constvalue))) {
					pfree(src_hdr2);
				}
				if (rewidthed == nullptr) {
					ereport(ERROR,
						(errcode(ERRCODE_DATATYPE_MISMATCH),
						 errmsg("bioseq mmsearch literal rewidth rejected an incompatible alphabet")));
				}
				if (rewidthed != nullptr) {
					const size_t rewidthed_bytes =
						static_cast<size_t>(VARSIZE(rewidthed));
					std::vector<char> coalesced_bytes(rewidthed_bytes);
					std::memcpy(
						coalesced_bytes.data(), rewidthed, rewidthed_bytes);
					pfree(rewidthed);
					runtime.buffer.apply_typmod_coalesce(
						std::move(coalesced_bytes));
				}
			}
			}
		}
		else if (arg1_is_param)
		{
			/*
		 * Parameterized-query case. Stash the Param coordinates for the
		 * shared evaluator. PARAM_EXTERN is available and installed now;
		 * PARAM_EXEC remains inactive until its Nested Loop parent installs
		 * the value and calls ReScan.
			 */
			Param* query_param = reinterpret_cast<Param*>(arg1);
			runtime.param_rebind.active            = true;
			runtime.param_rebind.paramid           = query_param->paramid;
			runtime.param_rebind.paramkind         = static_cast<int>(query_param->paramkind);
			runtime.param_rebind.param_typoid      = query_param->paramtype;
			runtime.param_rebind.param_typmod      = query_param->paramtypmod;
			runtime.param_rebind.seq_attno         = col_var->varattno;
			runtime.param_rebind.column_name       = std::string(attname_cstr);
			runtime.param_rebind.alphabet_code     = unpacked_typmod.alphabet_code;
			runtime.param_rebind.storage_unit_byte_width        = unpacked_typmod.storage_unit_byte_width;
			runtime.param_rebind.primary_key_attno = primary_key_attno;
			runtime.param_rebind.mmsearch_fe       = fe;
			if (query_param->paramkind == PARAM_EXTERN) {
				(void)resolve_mmsearch_param_query(
					runtime, cscanstate->ss.ps.ps_ExprContext,
					"BeginCustomScan");
			}
			bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() registering param-driven mmsearch rebind paramid={} paramkind={} typmod=({},{})",
					query_param->paramid, static_cast<int>(query_param->paramkind),
					static_cast<unsigned>(unpacked_typmod.alphabet_code),
					static_cast<unsigned>(unpacked_typmod.storage_unit_byte_width));
		}
		else /* same-row raw Var or complete evaluated query recipe */
		{
			const bool evaluated_submission = runtime.match_target_evaluated
				|| arg1_is_evaluated_row;
			if (evaluated_submission) {
				runtime.match_evaluated_submission = true;
				runtime.match_query_evaluated = true;
				runtime.match_query_recipe = arg1;
				runtime.match_query_lineage = canonical_match_base_lineage(
					arg1, scan_stub_oids);
				runtime.match_query_typmod = arg1_typmod;
				runtime.buffer.configure_mmsearch_per_row_evaluated(
					col_var->varattno,
					std::string(attname_cstr),
					unpacked_typmod.alphabet_code,
					unpacked_typmod.storage_unit_byte_width,
					unpacked_arg1_typmod.alphabet_code,
					unpacked_arg1_typmod.storage_unit_byte_width,
					primary_key_attno);
			} else {
				Var* query_var = reinterpret_cast<Var*>(arg1);
				const bool self_alignment =
					query_var->varattno == col_var->varattno;
				runtime.buffer.configure_mmsearch_per_row(
					col_var->varattno,
					std::string(attname_cstr),
					query_var->varattno,
					self_alignment,
					unpacked_typmod.alphabet_code,
					unpacked_typmod.storage_unit_byte_width,
					unpacked_arg1_typmod.alphabet_code,
					unpacked_arg1_typmod.storage_unit_byte_width,
					primary_key_attno);
				bioseq_log<DBG>("[bioseq] pg: BeginCustomScan() registering per-row mmsearch col_attno={} arg1_attno={} self_alignment={}",
						static_cast<int>(col_var->varattno),
						static_cast<int>(query_var->varattno),
						self_alignment);
			}
		}
		if (runtime.match_target_evaluated) {
			runtime.match_evaluated_submission = true;
		}

		primary_configured = true;
		++consumed_mmsearch_qual_count;
		primary_mmsearch_fe = fe;
		primary_seq_attno = col_var->varattno;
		runtime.match_sequence_varno = col_var->varno;
		runtime.match_sequence_attno = col_var->varattno;

		pfree(attname_cstr);
		/*
		 * Don't break — subsequent loop iterations that also match
		 * an mmsearch FuncExpr will fall into the
		 * `primary_configured` branch above and stack as additional
		 * AND filters.
		 */
	}
	if (consumed_mmsearch_qual_count != top_level_mmsearch_qual_count
		&& (eflags & EXEC_FLAG_EXPLAIN_ONLY) == 0) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("mmsearch qualifier shape is unsupported"),
			 errdetail("the alignment runtime consumed %llu of %llu top-level mmsearch qualifiers; executing any remainder through the SQL stub is forbidden",
				static_cast<unsigned long long>(consumed_mmsearch_qual_count),
				static_cast<unsigned long long>(top_level_mmsearch_qual_count)),
				 errhint("Use a bioseq.seq column as the first argument and a non-null Const, PARAM_EXEC, PARAM_EXTERN, or same-relation bioseq.seq Var as the second argument.")));
	}
	Node* configured_match_target = primary_mmsearch_fe == nullptr
		|| list_length(primary_mmsearch_fe->args) < 1
		? nullptr : reinterpret_cast<Node*>(
			linitial(primary_mmsearch_fe->args));
	if (base_match_target_recipe != nullptr
		&& (configured_match_target == nullptr
			|| !equal(configured_match_target, base_match_target_recipe)
			|| runtime.match_target_lineage == NIL)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan configured match target disagrees with its finalized owner")));
	}
	if (runtime.match_evaluated_submission) {
		/* These are the exact post-setrefs argument cells in custom_exprs[3].
		 * The metadata-only mmsearch FuncExpr itself is never initialized. */
		runtime.match_target_recipe = configured_match_target;
		runtime.match_target_expr_state = ExecInitExpr(
			reinterpret_cast<Expr*>(configured_match_target),
			&cscanstate->ss.ps);
		if (runtime.match_query_evaluated) {
			if (runtime.match_query_recipe == nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqScan evaluated query recipe is missing")));
			}
			runtime.match_query_expr_state = ExecInitExpr(
				reinterpret_cast<Expr*>(runtime.match_query_recipe),
				&cscanstate->ss.ps);
		}
	}
	if (runtime.edit_predicate_active
		&& (runtime.match_target_evaluated
			|| primary_seq_attno == InvalidAttrNumber
			|| runtime.edit_sequence_attno != primary_seq_attno)) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("bioseq.edit predicate must reference the mmsearch target column"),
			 errdetail("bioseq.edit attribute %d does not match mmsearch target attribute %d",
				 static_cast<int>(runtime.edit_sequence_attno),
				 static_cast<int>(primary_seq_attno))));
	}

	/*
	 * Build the per-scan Minimap2Params from the planner-authored semantic
	 * payload, then flip conditional-pipeline flags based on which bioseq.*
	 * projections the finalized target list references.  The only live
	 * aligner GUC read here is performance-only profiling.
	 *
	 * The resulting struct is pushed into the TupleDispatchBuffer so every
	 * batch row inherits the same parameters, and copied into the per-scan
	 * runtime.aligner_state so EXPLAIN can reproduce the user-visible
	 * decision tree without re-walking the plan.
	 */
	BioseqScanFeatureFlags features = detect_feature_flags(
		cscan->scan.plan.targetlist, cscan->scan.plan.qual, scan_stub_oids);
	features.has_mmsearch = owned_mmsearch_quals != NIL;
	features.uses_edit = features.uses_edit || runtime.edit_predicate_active;
	features.any_match_projection =
		features.any_match_projection || runtime.edit_predicate_active;
	if (features.uses_edit && !features.has_mmsearch) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("bioseq.edit requires mmsearch in the same scan")));
	}
	if (features.has_mmsearch && IsParallelWorker()) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("bioseq alignment custom scans are parallel unsafe"),
			 errdetail("statement execution attestation is backend-local and DSM aggregation is not implemented")));
	}
	bioseq::simd::Minimap2Params aligner_params =
		frozen_semantics.params;
	if (features.has_mmsearch) {
		if (runtime.match_target_typmod < 0) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan mmsearch target typmod is missing")));
		}
		const auto match_target_type =
			compact_sequence_stdc_type_params::decode(
				runtime.match_target_typmod);
		if (!is_supported_alphabet_code(match_target_type.alphabet_code)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqScan mmsearch target alphabet is unsupported"),
				 errdetail("alphabet_code=%u",
					static_cast<unsigned>(
						match_target_type.alphabet_code))));
		}
		aligner_params.alphabet_code = match_target_type.alphabet_code;
	}
	/* Profiling is diagnostic/performance-only and deliberately remains live. */
	aligner_params.enable_profiling =
		bioseq::aligner::settings::enable_profiling;
	/*
	 * The explicitness bit selects only the prefilter execution backend and is
	 * not a result-semantic field.  Recover it from the already-frozen
	 * aligner_options Const without consulting any GUC; discard the decoded
	 * semantic values because semantic_payload is authoritative.
	 */
	bool primary_vulkan_enabled_explicit = false;
	auto explicitness_probe_params = aligner_params;
	auto explicitness_probe_requirement =
		frozen_semantics.index_read_requirement;
	(void)apply_aligner_options_override(
		primary_mmsearch_fe,
		explicitness_probe_params,
		explicitness_probe_requirement,
		scan_stub_oids,
		&primary_vulkan_enabled_explicit);
	finalize_simd_chaining_policy(aligner_params);
	const bioseq::indexing::IndexReadRequirement index_read_requirement =
		frozen_semantics.index_read_requirement;
	if (runtime.match_evaluated_submission
		&& index_read_requirement
			!= bioseq::indexing::IndexReadRequirement::require_absent) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan semantic payload has an invalid evaluated-target index policy")));
	}
	aligner_params.do_cigar           = features.uses_cigar || features.uses_edit;
	aligner_params.compute_divergence = features.uses_divergence;
	aligner_params.compute_mapq       = features.uses_mapq;
	aligner_params.compute_edit_distance = features.uses_edit;
	aligner_params.exact_edit_filter_enabled =
		runtime.edit_predicate_active;
	aligner_params.exact_edit_filter_exclusive_upper_bound =
		runtime.edit_exclusive_upper_bound;
	if (runtime.edit_predicate_active
		&& runtime.edit_exclusive_upper_bound > 0
		&& static_cast<std::uint64_t>(runtime.edit_exclusive_upper_bound - 1)
			<= (std::numeric_limits<std::uint32_t>::max)()) {
		aligner_params.prefilter_enabled = true;
		aligner_params.prefilter_max_edits = static_cast<std::uint32_t>(
			runtime.edit_exclusive_upper_bound - 1);
		const bool existing_vulkan_route =
			aligner_params.chaining_algorithm
				== bioseq::simd::ChainingAlgorithmType::VULKAN_TILED_DP
			|| aligner_params.minimizer_algorithm
				== bioseq::simd::MinimizerAlgorithmType::VULKAN_MINIMAP_INT
			|| aligner_params.vulkan_seed_hits_enabled
			|| aligner_params.vulkan_fused_frontend_enabled
			|| aligner_params.vulkan_gpu_index_build_enabled
			|| aligner_params.vulkan_extend_enabled;
		const bool standalone_vulkan_prefilter_requested =
			primary_vulkan_enabled_explicit && aligner_params.vulkan_enabled;
		aligner_params.prefilter_backend =
			(existing_vulkan_route || standalone_vulkan_prefilter_requested)
			? bioseq::prefilter_stats::PrefilterBackendType::VULKAN
			: (bioseq::settings::enable_vectorization
				? bioseq::prefilter_stats::PrefilterBackendType::SIMD
				: bioseq::prefilter_stats::PrefilterBackendType::SCALAR);
	}
	const bool selected_vulkan =
		bioseq::simd::pipe::vulkan_components_requested(
			aligner_params);
	const bool selected_vulkan_accelerator =
		bioseq::simd::pipe::vulkan_accelerator_requested(
			aligner_params);
	const bool executable_scan =
		(eflags & EXEC_FLAG_EXPLAIN_ONLY) == 0;
	/*
	 * C1 is deliberately fail-closed: the only currently readable persisted
	 * MPF/MPS layouts predate the revision-3 READY head+manifest identity.
	 * They cannot satisfy ordinal 2, and rebuilding pairs or trusting a warm
	 * assembled/GPU cache would counterfeit a persisted-compatible read.
	 * Reject executable scans here before Vulkan initialization and retain the
	 * typed-processor check as defence in depth for non-standard callers. Plain
	 * EXPLAIN keeps the ordinal visible without initializing either payload.
	 */
	if (index_read_requirement
		== bioseq::indexing::IndexReadRequirement::
			require_compatible_persisted
		&& executable_scan) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("required compatible persisted minimizer index unavailable"),
			 errdetail("ordinal 2 requires a revision-3 READY generation retained by the BatchJoin prepared-reader lifecycle; ordinary column scans have no compatible persisted reader"),
			 errhint("Use BioseqBatchJoin with a compatible READY generation, or choose index_read_requirement=allow/require_absent; recompute and cache fallback are forbidden.")));
	}
	/* Plain EXPLAIN must describe the selected pipeline without touching the
	 * process-owned Vulkan runtime or its immutable Metal policy.  PostgreSQL
	 * clears EXEC_FLAG_EXPLAIN_ONLY for SELECT and EXPLAIN (ANALYZE), so every
	 * executable path retains the fail-closed enablement, cache and device
	 * checks below. */
	const bool executable_vulkan =
		features.has_mmsearch
		&& selected_vulkan_accelerator
		&& executable_scan;
	if (executable_vulkan && !aligner_params.vulkan_enabled) {
		raise_column_scan_vulkan_error_as_cpp(
			"selected Vulkan execution requires "
			"bioseq.aligner.vulkan_enabled=on",
			"Set bioseq.aligner.vulkan_enabled=on, remove the per-call "
			"standalone Vulkan prefilter request, or select non-Vulkan "
			"minimizer/chaining algorithms before dispatch.");
	}
	if (executable_vulkan && aligner_params.vulkan_enabled) {
		auto& vulkan_runtime =
			bioseq::parallelism::pg::ensure_pg_vulkan_runtime_ready();
		if (!vulkan_runtime.usable()) {
			const std::string diagnostic = fmt::format(
				"selected Vulkan execution requires a usable Vulkan runtime; "
				"initialization_error={}",
				vulkan_runtime.initialization_error());
			raise_column_scan_vulkan_error_as_cpp(
				diagnostic,
				"Install a working Vulkan ICD, remove or set false the per-call "
				"aligner_options(vulkan_enabled) standalone prefilter request, "
				"or select non-Vulkan minimizer/chaining algorithms before dispatch.");
		}
		if (vulkan_runtime.features().software_device) {
			const std::string diagnostic = fmt::format(
				"selected Vulkan execution requires a hardware GPU; active "
				"Vulkan device '{}' is a software/CPU Vulkan device "
				"(VkPhysicalDeviceType={})",
				vulkan_runtime.features().device_name.data(),
				vulkan_runtime.features().device_type);
			raise_column_scan_vulkan_error_as_cpp(
				diagnostic,
				"Use a hardware Vulkan ICD, remove or set false the per-call "
				"aligner_options(vulkan_enabled) standalone prefilter request, "
				"or select non-Vulkan minimizer/chaining algorithms before dispatch.");
		}
	}

	runtime.aligner_state.params          = aligner_params;
	runtime.aligner_state.features        = features;
	runtime.aligner_state.index_read_requirement =
		index_read_requirement;
	runtime.aligner_state.read_sequence_index =
		frozen_semantics.read_sequence_index;
	runtime.aligner_state.params_captured = true;

	/*
	 * Capture the structured pipeline description for EXPLAIN.  Walks the
	 * same dispatch ladder `dispatch_pipeline` would but invokes each stage's
	 * `describe()` instead of `on_batch(...)`.  The cold planner selects the
	 * already-validated target alphabet once, then constructs its own empty
	 * query/target prototypes; this is not another dispatch-chain dimension.
	 */
	if (features.has_mmsearch) {
		runtime.aligner_state.pipeline_desc =
			DescribePipelineForPgAlphabet(
				aligner_params, aligner_params.alphabet_code,
				QuerySketchPlanRouteFor(index_read_requirement));
	}

	/*
	 * Only consult the sidecar when mmsearch is actually present. Without
	 * mmsearch there is no BatchProcessor call so opening the sidecar
	 * relation would be wasted work (and would surface a confusing
	 * "Recomputed" line in EXPLAIN on a query that doesn't use any index).
	 */
	const Oid resolved_user_relid =
		cscanstate->ss.ss_currentRelation != nullptr
			? RelationGetRelid(cscanstate->ss.ss_currentRelation)
			: InvalidOid;
	/*
	 * DOC0260 §9.4 — pass the parent's three-part physical identity
	 * (database, tablespace, relfilenode) so the dispatch buffer can route
	 * its per-bucket SM::fetch_payload_bulk calls to the right sub-tables.
	 */
	Oid scan_db_oid  = InvalidOid;
	Oid scan_spc_oid = InvalidOid;
	Oid scan_relfile = InvalidOid;
	if (cscanstate->ss.ss_currentRelation != nullptr) {
		scan_db_oid  = cscanstate->ss.ss_currentRelation->rd_locator.dbOid;
		scan_spc_oid = cscanstate->ss.ss_currentRelation->rd_locator.spcOid;
		scan_relfile = cscanstate->ss.ss_currentRelation->rd_locator.relNumber;
	}
	runtime.buffer.configure_params(aligner_params,
							index_read_requirement,
							features.has_mmsearch
								&& frozen_semantics.read_sequence_index
								&& !runtime.match_evaluated_submission,
							resolved_user_relid,
							scan_db_oid, scan_spc_oid, scan_relfile,
							cscanstate->ss.ss_currentRelation,
							bioseqScanState->snapshot,
							estate->es_query_cxt);
	if (features.has_mmsearch) {
		const int plan_node_id = cscan->scan.plan.plan_node_id;
		if (plan_node_id < 0) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("bioseq alignment scan has an invalid plan node id")));
		}
		runtime.alignment_registration =
			bioseq::pg::alignment_execution::bind_alignment_node(
				estate, static_cast<std::uint32_t>(plan_node_id));
		runtime.buffer.bind_persisted_gpu_operation_evidence_sink(
			*bioseq::pg::alignment_execution::
				borrow_persisted_gpu_operation_evidence_sink(
					runtime.alignment_registration));
	}

	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_BeginCustomScan() scan initialised successfully");
	/* scan slot is already initialized */
}

static void
BioseqColumnScan_BeginCustomScan(
		CustomScanState* cscanstate,
		EState* estate,
		int eflags)
{
	ErrorData* exact_error = nullptr;
	bool cpp_error = false;
	bool unknown_cpp_error = false;
	char detail[512] = "std::exception without detail";
	try {
		BioseqColumnScan_BeginCustomScanImpl(cscanstate, estate, eflags);
		return;
	} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
		exact_error = error.release_error_data();
	} catch (const std::exception& error) {
		strlcpy(
			detail,
			error.what() == nullptr ? "std::exception without detail" : error.what(),
			sizeof(detail));
		cpp_error = true;
	} catch (...) {
		unknown_cpp_error = true;
	}

	BioseqScanState* state =
		BioseqScanState::from_custom_scan_state(cscanstate);
	if (state != nullptr && state->runtime != nullptr) {
		auto* runtime = static_cast<BioseqScanRuntime*>(state->runtime);
		runtime->buffer.abandon_join_runtime_after_pg_error_noexcept();
	}
	if (exact_error != nullptr) {
		ReThrowError(exact_error);
	}
	if (cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqColumnScan Begin raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	if (unknown_cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqColumnScan Begin raised an unknown C++ exception")));
	}
}

/*
 * ExecScanFetch -- check interrupts & fetch next potential tuple
 *
 * This routine is concerned with substituting a test tuple if we are
 * inside an EvalPlanQual recheck.  If we aren't, just execute
 * the access method's next-tuple routine.
 */
static inline TupleTableSlot *
ExecScanFetch(ScanState *node,
			  ExecScanAccessMtd accessMtd,
			  ExecScanRecheckMtd recheckMtd)
{
	bioseq_log<DBG>("[bioseq] pg: ExecScanFetch() entered");
	EState	   *estate = node->ps.state;

	CHECK_FOR_INTERRUPTS();

	if (estate->es_epq_active != NULL)
	{
		EPQState   *epqstate = estate->es_epq_active;

		/*
		 * We are inside an EvalPlanQual recheck.  Return the test tuple if
		 * one is available, after rechecking any access-method-specific
		 * conditions.
		 */
		Index		scanrelid = reinterpret_cast<Scan *>(node->ps.plan)->scanrelid;

		if (scanrelid == 0)
		{
			/*
			 * This is a ForeignScan or CustomScan which has pushed down a
			 * join to the remote side.  The recheck method is responsible not
			 * only for rechecking the scan/join quals but also for storing
			 * the correct tuple in the slot.
			 */

			TupleTableSlot *slot = node->ss_ScanTupleSlot;

			if (!(*recheckMtd) (node, slot))
				ExecClearTuple(slot);	/* would not be returned by scan */
			return slot;
		}
		else if (epqstate->relsubs_done[scanrelid - 1])
		{
			/*
			 * Return empty slot, as we already performed an EPQ substitution
			 * for this relation.
			 */

			TupleTableSlot *slot = node->ss_ScanTupleSlot;

			/* Return empty slot, as we already returned a tuple */
			return ExecClearTuple(slot);
		}
		else if (epqstate->relsubs_slot[scanrelid - 1] != NULL)
		{
			/*
			 * Return replacement tuple provided by the EPQ caller.
			 */

			TupleTableSlot *slot = epqstate->relsubs_slot[scanrelid - 1];

			Assert(epqstate->relsubs_rowmark[scanrelid - 1] == NULL);

			/* Mark to remember that we shouldn't return more */
			epqstate->relsubs_done[scanrelid - 1] = true;

			/* Return empty slot if we haven't got a test tuple */
			if (TupIsNull(slot))
				return NULL;

			/* Check if it meets the access-method conditions */
			if (!(*recheckMtd) (node, slot))
				return ExecClearTuple(slot);	/* would not be returned by
												 * scan */
			return slot;
		}
		else if (epqstate->relsubs_rowmark[scanrelid - 1] != NULL)
		{
			/*
			 * Fetch and return replacement tuple using a non-locking rowmark.
			 */

			TupleTableSlot *slot = node->ss_ScanTupleSlot;

			/* Mark to remember that we shouldn't return more */
			epqstate->relsubs_done[scanrelid - 1] = true;

			if (!EvalPlanQualFetchRowMark(epqstate, scanrelid, slot))
				return NULL;

			/* Return empty slot if we haven't got a test tuple */
			if (TupIsNull(slot))
				return NULL;

			/* Check if it meets the access-method conditions */
			if (!(*recheckMtd) (node, slot))
				return ExecClearTuple(slot);	/* would not be returned by
												 * scan */
			return slot;
		}
	}

	/*
	 * Run the node-type-specific access method function to get the next tuple
	 */
	return (*accessMtd) (node);
}

/*
 * Dispatch table: given a matched funcid, which placeholder Const do we
 * substitute in? bioseq.score is an alias for bioseq.dp_score so both
 * resolve to the same Const* (paradedb's score/pdb.score alias pattern).
 */
static Const*
lookup_bioseq_placeholder_const(Oid funcid, const VarInjectorCtx* ctx)
{
	const BioseqStubOids* o = ctx->oids;
	const BioseqPlaceholderConsts* c = ctx->consts;
	if (funcid == o->score_oid || funcid == o->dp_score_oid)     return c->dp_score_node;
	if (funcid == o->query_len_oid)              return c->query_len_node;
	if (funcid == o->query_start_oid)            return c->query_start_node;
	if (funcid == o->query_end_oid)              return c->query_end_node;
	if (funcid == o->target_len_oid)             return c->target_len_node;
	if (funcid == o->target_start_oid)           return c->target_start_node;
	if (funcid == o->target_end_oid)             return c->target_end_node;
	if (funcid == o->num_matches_oid)            return c->num_matches_node;
	if (funcid == o->block_length_oid)           return c->block_length_node;
	if (funcid == o->edit_oid)                   return c->edit_distance_node;
	if (funcid == o->mapq_oid)                   return c->mapq_node;
	if (funcid == o->chain_score_oid)            return c->chain_score_node;
	if (funcid == o->dp_max_score_oid)           return c->dp_max_score_node;
	if (funcid == o->seed_count_oid)             return c->seed_count_node;
	if (funcid == o->secondary_chain_score_oid)  return c->secondary_chain_score_node;
	if (funcid == o->is_reverse_oid)             return c->is_reverse_node;
	if (funcid == o->is_primary_oid)             return c->is_primary_node;
	if (funcid == o->has_cigar_oid)              return c->has_cigar_node;
	if (funcid == o->divergence_oid)             return c->divergence_node;
	if (funcid == o->cigar_oid)                  return c->cigar_node;
	return nullptr;
}

[[nodiscard]] static bool base_match_helper_is_finalized_for_scan(
		FuncExpr* function, const VarInjectorCtx& context) {
	if (function == nullptr || context.oids == nullptr
		|| context.stable_match_id < 0
		|| context.match_helper_sites == NIL
		|| batch_join_well_formed_match_helper(
			reinterpret_cast<Node*>(function), *context.oids) == nullptr) {
		return false;
	}
	Node* argument = batch_join_match_helper_argument(function);
	if (argument == nullptr) return false;
	for (List* site : PList<List>(context.match_helper_sites)) {
		if (site == nullptr || !IsA(site, List)
			|| list_length(site) != kBioseqMatchHelperSiteFields) continue;
		Node* canonical_argument = reinterpret_cast<Node*>(list_nth(
			site, kMatchSiteCanonicalArgument));
		if (static_cast<Oid>(intVal(list_nth(site, kMatchSiteFuncid)))
				== function->funcid
			&& (static_cast<BioseqMatchHelperBindingKind>(intVal(list_nth(
				site, kMatchSiteBindingKind)))
					== BioseqMatchHelperBindingKind::exact_recipe
				|| static_cast<BioseqMatchHelperBindingKind>(intVal(list_nth(
					site, kMatchSiteBindingKind)))
					== BioseqMatchHelperBindingKind::unique_lineage)
			&& intVal(list_nth(site, kMatchSiteStableId))
				== context.stable_match_id
			&& canonical_argument != nullptr
			&& equal(canonical_argument, argument)) return true;
	}
	return false;
}

/*
 * Rewrite a single `bioseq.symbol_count(Var, 'L')` call site into a
 * placeholder Const that the executor populates per-row from meta_sidecar.
 * Returns the replacement Const*, or nullptr when the FuncExpr does not
 * match the supported shape (in which case the caller must leave the
 * original FuncExpr in place so the scalar O(n) path runs).
 *
 * Matching is deliberately strict: arg0 must be a Var (a column reference
 * with a concrete bioseq.seq typmod), and arg1 must be a single-byte
 * non-null text Const whose letter is in the column's alphabet. Any call
 * outside this shape — e.g. symbol_count('ACGT'::bioseq.seq, 'A') — keeps
 * its original FuncExpr and runs through the scalar entry point in
 * mod.cppm, which is cost-inflated by bioseq_symbol_count_support.
 */
static Const*
try_rewrite_symbol_count(FuncExpr* fe, VarInjectorCtx* ctx)
{
	if (ctx == nullptr || fe == nullptr || ctx->consts == nullptr) {
		return nullptr;
	}
	if (list_length(fe->args) != 2) {
		return nullptr;
	}
	PList<Node> fe_args(fe->args);
	Node* arg0 = fe_args.first();
	Node* arg1 = fe_args.second();
	if (arg0 == nullptr || arg1 == nullptr) {
		return nullptr;
	}
	Var* col_var = pg_node_try_as<Var>(arg0);
	Const* letter_const = pg_node_try_as<Const>(arg1);
	if (col_var == nullptr || letter_const == nullptr) {
		bioseq_log<DBG>("[bioseq] pg: var_injector_mutator() leaving symbol_count(...) alone; arg0_tag={} arg1_tag={}",
				static_cast<int>(nodeTag(arg0)),
				static_cast<int>(nodeTag(arg1)));
		return nullptr;
	}
	if (col_var->vartypmod < 0 || col_var->vartype != ctx->oids->bioseq_seq_type_oid) {
		bioseq_log<DBG>("[bioseq] pg: VarInjectorMutator() symbol_count arg0 has wrong type/typmod (type={}, typmod={})",
				col_var->vartype, col_var->vartypmod);
		return nullptr;
	}
	if (letter_const->constisnull) {
		bioseq_log<DBG>("[bioseq] pg: VarInjectorMutator() symbol_count arg1 is NULL; skipping");
		return nullptr;
	}

	text* letter_text = reinterpret_cast<text*>(DatumGetPointer(letter_const->constvalue));
	if (letter_text == nullptr) {
		return nullptr;
	}
	text* letter_detoasted = reinterpret_cast<text*>(PG_DETOAST_DATUM(letter_const->constvalue));
	const int32 letter_size = VARSIZE_ANY_EXHDR(letter_detoasted);
	if (letter_size != 1) {
		bioseq_log<DBG>("[bioseq] pg: VarInjectorMutator() symbol_count arg1 size={} (expected 1)", letter_size);
		if (reinterpret_cast<void*>(letter_detoasted)
			!= reinterpret_cast<void*>(DatumGetPointer(letter_const->constvalue))) {
			pfree(letter_detoasted);
		}
		return nullptr;
	}
	const char letter_char = *VARDATA_ANY(letter_detoasted);
	if (reinterpret_cast<void*>(letter_detoasted)
		!= reinterpret_cast<void*>(DatumGetPointer(letter_const->constvalue))) {
		pfree(letter_detoasted);
	}

	const compact_sequence_stdc_type_params typmod = compact_sequence_stdc_type_params::decode(col_var->vartypmod);
	const int rank = bioseq::storage::indexing::letter_to_rank(typmod.alphabet_code, letter_char);
	if (rank < 0) {
		bioseq_log<DBG>("[bioseq] pg: VarInjectorMutator() symbol_count letter '{}' not in alphabet_code={}; keeping scalar call",
				letter_char, static_cast<unsigned>(typmod.alphabet_code));
		return nullptr;
	}

	/*
	 * Build the placeholder Const. INT8 is byval on LP64 (pg_type.typbyval
	 * for bigint is 't'), so constbyval=true + constlen=8 is correct. The
	 * initial value is NULL until the executor populates it per-row.
	 */
		Const* placeholder = makeConst(
			INT8OID,
			-1,
			InvalidOid,
			8,
			bioseq::pg_utils::pg_datum::from(static_cast<std::int64_t>(0)).raw(),
			/*constisnull=*/ true,
			/*constbyval=*/ true);

	SymbolCountCallSite site;
	site.placeholder = placeholder;
	site.rank        = rank;
	site.letter      = letter_char;
	site.column_attno = static_cast<int16_t>(col_var->varattno);  // DOC0260 §11.1
	if (ctx->current_relation != nullptr
		&& col_var->varattno >= 1) {
		char* attname_cstr = get_attname(
			RelationGetRelid(ctx->current_relation), col_var->varattno, /*missing_ok=*/true);
		if (attname_cstr != nullptr) {
			site.column_name = std::string(attname_cstr);
			pfree(attname_cstr);
		}
	}
	bioseq_log<DBG>("[bioseq] pg: VarInjectorMutator() installing symbol_count placeholder column='{}' letter='{}' rank={}",
			site.column_name, letter_char, rank);

	ctx->consts->symbol_count_sites.push_back(std::move(site));
	return placeholder;
}

struct var_injector_mutator {
	[[nodiscard]] pg_node_mutation
	operator()(pg_expression_mutation_cursor, pg_node_view node, VarInjectorCtx &injector_context) const {
		if (FuncExpr* funcExpr = node.try_as<FuncExpr>()) {
			if (!edit_sequence_argument_matches_recipe(
					funcExpr,
					injector_context.match_target_recipe,
					injector_context.match_sequence_varno,
					injector_context.match_sequence_attno,
					*injector_context.oids)) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("bioseq.edit projection must reference the mmsearch target column")));
			}
			Const* replacement = base_match_helper_is_finalized_for_scan(
				funcExpr, injector_context)
				? lookup_bioseq_placeholder_const(
					funcExpr->funcid, &injector_context)
				: nullptr;
			if (replacement != nullptr) {
				bioseq_log<DBG>("[bioseq] pg: var_injector_mutator() replacing bioseq funcid={} with placeholder Const",
						funcExpr->funcid);
				return pg_node_mutation::with(pg_as_node(replacement));
			}
			if (funcExpr->funcid == injector_context.oids->symbol_count_oid) {
				Const* symbol_placeholder =
					try_rewrite_symbol_count(funcExpr, &injector_context);
				if (symbol_placeholder != nullptr) {
					return pg_node_mutation::with(pg_as_node(symbol_placeholder));
				}
				/* Call shape not supported (literal arg, non-Const letter,
				 * letter outside alphabet, …) — let the scalar entry point
				 * in mod.cppm handle it in place. */
			}
			/* Fall through to recurse into arg subtrees of unrelated FuncExprs. */
		}
		/*
		 * PlaceHolderVar handling. By Postgres convention the planner
		 * resolves PHVs to Vars / Params by execution time (pathnodes.h:
		 * "it is not recognized by the parser or executor"), so seeing
		 * one here is a planner bug. We log loudly and pass the node
		 * through — unwrapping would silently drop the PHV's
		 * phnullingrels metadata and could produce wrong results in
		 * outer-join nullable positions (a plain Const has no nulling
		 * semantics). Returning descend() does the right thing because
		 * the cursor recurses into phexpr, giving var_injector_mutator a
		 * chance to rewrite our FuncExpr in place; the PHV node itself is
		 * preserved.
		 */
		if (PlaceHolderVar* phv = node.try_as<PlaceHolderVar>()) {
			bioseq_log<DBG>("[bioseq] pg: var_injector_mutator() encountered PlaceHolderVar phid={} at exec time — passing through",
					phv->phid);
			/* fall through to descend */
		}
		return pg_node_mutation::descend();
	}
};

/*
 * Thin wrapper for the direct callers (execution-time targetlist rewrite)
 * so they keep the (node, ctx) call shape.
 */
[[nodiscard]] static Node *
var_injector(Node *node, VarInjectorCtx *injector_context)
{
	var_injector_mutator mutator;
	return pg_mutate_expression(node, *injector_context, mutator);
}

/*
 * Per-tuple update of every placeholder Const* from a MatchResult's
 * fields. Fields we don't have a Const for (because the query didn't
 * project them) are skipped thanks to the nullptr guard. The cigar text
 * Datum is allocated via CStringGetTextDatum in CurrentMemoryContext;
 * for the POC we accept the per-query leak (see SPEC_HOW_TO_CONNECT_ALIGNER_2.md §6.2).
 *
 * MatchResult and format_cigar live inside bioseq::simd::HWY_NAMESPACE
 * (expanded to the current Highway target namespace); this file does not use
 * HWY_BEFORE_NAMESPACE() so we qualify with the full path.
 */
static void
populate_placeholder_consts(BioseqPlaceholderConsts& consts,
							const bioseq::simd::MatchResult& match)
{
	using bioseq::simd::format_cigar;
	// DOC0274 §1.8 — MatchResult absolute coordinates / lengths are
	// `sequence_size_t` (uint64; minimap_port.cppm:334). They are projected
	// through BIGINT (int8) placeholders so positions / lengths in sequences
	// longer than `INT32_MAX` (~2.15 Gbp) are NOT truncated. `set_bigint`
	// fills those eight (query_len … block_length) via `Int64GetDatum`. The
	// remaining MatchResult fields (dp_score, mapq, chain_score, seed_count,
	// …) are genuinely `int32_t` in the struct, so they keep INT4 placeholders
	// and `set_int` — widening them at this boundary cannot recover precision
	// the source type never held.
	//
	// `set_bigint`'s Assert is a debug-time witness that no real coordinate
	// reaches the int64 sign boundary: the project's pessimistic ceiling is
	// 1 Tbp (~2^40), ~23 bits below INT64_MAX, so the uint64→int64 reinterpret
	// is always value-preserving.
	auto set_int = [](Const* node, int64_t value) {
			if (node == nullptr) return;
			Assert(value >= INT32_MIN && value <= INT32_MAX);
			node->constvalue = bioseq::pg_utils::pg_datum::from(static_cast<std::int32_t>(value)).raw();
			node->constisnull = false;
		};
	// Parameter is the underlying type of `sequence_size_t` (std::uint64_t)
	// spelled directly — this TU does not import bioseq_storage_size, so the
	// `sequence_size_t` alias is not in scope here.
	auto set_bigint = [](Const* node, std::uint64_t value) {
			if (node == nullptr) return;
			Assert(value <= static_cast<std::uint64_t>(INT64_MAX));
			node->constvalue = bioseq::pg_utils::pg_datum::from(static_cast<std::int64_t>(value)).raw();
			node->constisnull = false;
		};
		auto set_bool = [](Const* node, bool value) {
			if (node == nullptr) return;
			node->constvalue = bioseq::pg_utils::pg_datum::from(value).raw();
			node->constisnull = false;
		};
		auto set_float = [](Const* node, float value) {
			if (node == nullptr) return;
			node->constvalue = bioseq::pg_utils::pg_datum::from(value).raw();
			node->constisnull = false;
		};

	set_int(consts.dp_score_node,              match.dp_score);
	// The eight sequence_size_t (uint64) coordinates/lengths → BIGINT, no narrow.
	set_bigint(consts.query_len_node,          match.query_len);
	set_bigint(consts.query_start_node,        match.query_start);
	set_bigint(consts.query_end_node,          match.query_end);
	set_bigint(consts.target_len_node,         match.target_len);
	set_bigint(consts.target_start_node,       match.target_start);
	set_bigint(consts.target_end_node,         match.target_end);
	set_bigint(consts.num_matches_node,        match.num_matches);
	set_bigint(consts.block_length_node,       match.block_length);
	set_bigint(consts.edit_distance_node,      match.edit_distance);
	set_int(consts.mapq_node,                  match.mapq);
	set_int(consts.chain_score_node,           match.chain_score);
	set_int(consts.dp_max_score_node,          match.dp_max_score);
	set_int(consts.seed_count_node,            match.seed_count);
	set_int(consts.secondary_chain_score_node, match.secondary_chain_score);
	set_bool(consts.is_reverse_node,           match.is_reverse);
	set_bool(consts.is_primary_node,           match.is_primary);
	set_bool(consts.has_cigar_node,            match.has_cigar);
	set_float(consts.divergence_node,          match.divergence);

	if (consts.cigar_node != nullptr)
		{
			std::string cigar_str = format_cigar(match.cigar);
			consts.cigar_node->constvalue =
				bioseq::pg_utils::pg_datum::from_text_cstring(cigar_str.c_str()).raw();
			consts.cigar_node->constisnull = false;
			}
}

[[nodiscard]] static BioseqBatchJoinRuntime* batch_join_runtime(
		CustomScanState* node) noexcept {
	auto* state = reinterpret_cast<BioseqBatchJoinState*>(node);
	return state == nullptr
		? nullptr
		: static_cast<BioseqBatchJoinRuntime*>(state->runtime);
}

/* Recipe-aware custom scans expose virtual rows which borrow retained EOH
 * wrappers. Clear every parent-visible slot and expression-context pointer
 * before the owning dispatch arena is reset. */
static void clear_recipe_scan_parent_tuple_references(
		CustomScanState* node) {
	if (node == nullptr) return;
	std::array<TupleTableSlot*, 2> slots{
		node->ss.ps.ps_ResultTupleSlot,
		node->ss.ss_ScanTupleSlot,
	};
	for (std::size_t index = 0u; index < slots.size(); ++index) {
		TupleTableSlot* slot = slots[index];
		if (slot == nullptr) continue;
		bool duplicate = false;
		for (std::size_t previous = 0u; previous < index; ++previous) {
			duplicate = duplicate || slots[previous] == slot;
		}
		if (!duplicate) ExecClearTuple(slot);
	}
	if (ExprContext* context = node->ss.ps.ps_ExprContext;
		context != nullptr) {
		context->ecxt_scantuple = nullptr;
		context->ecxt_outertuple = nullptr;
		context->ecxt_innertuple = nullptr;
		ResetExprContext(context);
	}
}

static void batch_join_clear_parent_tuple_references(
		CustomScanState* node,
		BioseqBatchJoinRuntime& runtime) {
	clear_recipe_scan_parent_tuple_references(node);
	runtime.current_target_slot = nullptr;
}

static void batch_join_release_executor_resources_checked(
		CustomScanState* node,
		BioseqBatchJoinRuntime& runtime,
		const bool delete_query_context) {
	if (runtime.cleanup_done) {
		return;
	}
	bioseq::pg_utils::invoke_pg_as_cpp([node, &runtime] {
		batch_join_clear_parent_tuple_references(node, runtime);
	});
	if (runtime.target_active) {
		bioseq::pg_utils::invoke_pg_as_cpp([&runtime] {
			runtime.buffer.finish_join_target();
		});
		runtime.target_active = false;
	}
	bioseq::pg_utils::invoke_pg_as_cpp([&runtime] {
		runtime.buffer.reset_join_runtime_for_rescan();
	});
	bioseq::pg_utils::invoke_pg_as_cpp([&runtime] {
		runtime.buffer.release_join_slice_async_owner_after_drain();
	});
	runtime.buffer.clear_sequence_source_provider_binding();
	for (BioseqBatchJoinQueryTuple& query : runtime.query_tuples) {
		if (query.slot != nullptr) {
			TupleTableSlot* finished = query.slot;
			bioseq::pg_utils::invoke_pg_as_cpp(
				[finished] { ExecDropSingleTupleTableSlot(finished); });
			query.slot = nullptr;
		}
	}
	runtime.query_tuples.clear();
	runtime.all_query_refs.clear();
	if (runtime.query_staging_slot != nullptr) {
		TupleTableSlot* staging = runtime.query_staging_slot;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[staging] { ExecDropSingleTupleTableSlot(staging); });
		runtime.query_staging_slot = nullptr;
	}
	if (runtime.query_tuple_context != nullptr) {
		MemoryContext context = runtime.query_tuple_context;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[context, delete_query_context] {
				if (delete_query_context) {
					MemoryContextDelete(context);
				} else {
					MemoryContextReset(context);
				}
			});
		runtime.query_tuple_context = nullptr;
	}
	/* Release admission only after the owning tuple context was reset/deleted. */
	runtime.query_permits.clear();
	runtime.query_reserved_admission_bytes = 0;
	runtime.query_actual_materialized_bytes = 0;
	runtime.queries_materialized = false;
	if (runtime.query_child_initialized && !runtime.query_child_ended) {
		PlanState* finished = runtime.query_child;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[finished] { ExecEndNode(finished); });
		runtime.query_child_ended = true;
	}
	if (runtime.target_child_initialized && !runtime.target_child_ended) {
		PlanState* finished = runtime.target_child;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[finished] { ExecEndNode(finished); });
		runtime.target_child_ended = true;
	}
	if (node != nullptr) {
		node->custom_ps = NIL;
	}
	runtime.cleanup_done = true;
}

static void batch_join_abandon_executor_resources_after_error(
		CustomScanState* node,
		BioseqBatchJoinRuntime& runtime) noexcept {
	if (runtime.cleanup_done) {
		return;
	}
	runtime.buffer.abandon_join_runtime_after_pg_error_noexcept();
	runtime.buffer.clear_sequence_source_provider_binding();
	for (BioseqBatchJoinQueryTuple& query : runtime.query_tuples) {
		query.slot = nullptr;
		query.tuple = nullptr;
	}
	runtime.query_tuples.clear();
	runtime.all_query_refs.clear();
	runtime.placeholder_sites.clear();
	runtime.query_tuple_context = nullptr;
	runtime.query_staging_slot = nullptr;
	runtime.query_permits.clear();
	runtime.query_reserved_admission_bytes = 0;
	runtime.query_actual_materialized_bytes = 0;
	runtime.queries_materialized = false;
	runtime.target_active = false;
	runtime.current_target_slot = nullptr;
	runtime.query_child = nullptr;
	runtime.target_child = nullptr;
	runtime.query_child_ended = true;
	runtime.target_child_ended = true;
	runtime.query_child_initialized = false;
	runtime.target_child_initialized = false;
	if (node != nullptr) {
		node->custom_ps = NIL;
	}
	runtime.cleanup_done = true;
}

static void batch_join_runtime_cleanup(void* argument) {
	auto* state = static_cast<BioseqBatchJoinState*>(argument);
	if (state == nullptr || state->runtime == nullptr) {
		return;
	}
	auto* runtime = static_cast<BioseqBatchJoinRuntime*>(state->runtime);
	batch_join_abandon_executor_resources_after_error(
		&state->custom_scanstate, *runtime);
	state->runtime = nullptr;
	std::destroy_at(runtime);
}

static void batch_join_clear_query_tuples(
		BioseqBatchJoinRuntime& runtime,
		const bool drop_slots) {
	if (drop_slots) {
		for (BioseqBatchJoinQueryTuple& query : runtime.query_tuples) {
			if (query.slot != nullptr) {
				ExecDropSingleTupleTableSlot(query.slot);
				query.slot = nullptr;
			}
		}
	}
	runtime.query_tuples.clear();
	runtime.all_query_refs.clear();
	if (runtime.query_staging_slot != nullptr) {
		ExecDropSingleTupleTableSlot(runtime.query_staging_slot);
		runtime.query_staging_slot = nullptr;
	}
	if (runtime.query_tuple_context != nullptr) {
		MemoryContextReset(runtime.query_tuple_context);
	}
	/* The permit covers allocations owned by query_tuple_context (plus the
	 * MinimalTuple slots above).  Release only after those owners are gone. */
	runtime.query_permits.clear();
	runtime.query_reserved_admission_bytes = 0;
	runtime.query_actual_materialized_bytes = 0;
	runtime.queries_materialized = false;
}

/* A child PlanState may legally return a pass-through scan/child slot rather
 * than its ps_ResultTupleSlot.  Validate the slot that ExecProcNode actually
 * returned before reading or copying it; the post-setrefs Plan targetlist is
 * the planning ABI, while this is the independent executor ABI. */
static void batch_join_validate_returned_child_slot(
		TupleTableSlot* slot,
		const int expected_columns,
		const AttrNumber sequence_resno,
		const AttrNumber rowno_resno,
		const std::uint8_t alphabet_code,
		const std::uint8_t storage_unit_byte_width,
		const char* role) {
	TupleDesc descriptor = slot == nullptr
		? nullptr : slot->tts_tupleDescriptor;
	const bool rowno_required = rowno_resno != InvalidAttrNumber;
	if (descriptor == nullptr || expected_columns <= 0
		|| descriptor->natts != expected_columns
		|| sequence_resno <= 0 || sequence_resno > expected_columns
		|| (rowno_required
			&& (rowno_resno <= 0 || rowno_resno > expected_columns))) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin returned %s slot layout is invalid", role),
			 errdetail(
				"expected_columns=%d actual_columns=%d sequence_resno=%d rowno_resno=%d",
				expected_columns,
				descriptor == nullptr ? -1 : descriptor->natts,
				sequence_resno,
				rowno_resno)));
	}
	const Oid sequence_type = get_cached_stub_oids().bioseq_seq_type_oid;
	const int32 expected_typmod = compact_sequence_stdc_type_params{
		alphabet_code, storage_unit_byte_width}.encode();
	Form_pg_attribute sequence_attribute = TupleDescAttr(
		descriptor, sequence_resno - 1);
	Form_pg_attribute rowno_attribute = rowno_required
		? TupleDescAttr(descriptor, rowno_resno - 1) : nullptr;
	if (sequence_attribute->atttypid != sequence_type
		|| sequence_attribute->atttypmod != expected_typmod
		|| sequence_attribute->attcollation != get_typcollation(sequence_type)
		|| (rowno_required
			&& (rowno_attribute->atttypid != INT8OID
				|| rowno_attribute->atttypmod != -1
				|| OidIsValid(rowno_attribute->attcollation)))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("BioseqBatchJoin returned %s slot types are invalid", role),
			 errdetail(
				"sequence_type=%u sequence_typmod=%d sequence_collation=%u rowno_type=%u rowno_typmod=%d rowno_collation=%u",
				sequence_attribute->atttypid,
				sequence_attribute->atttypmod,
				sequence_attribute->attcollation,
				rowno_attribute == nullptr
					? InvalidOid : rowno_attribute->atttypid,
				rowno_attribute == nullptr
					? -1 : rowno_attribute->atttypmod,
				rowno_attribute == nullptr
					? InvalidOid : rowno_attribute->attcollation)));
	}
}

/* Convert validation failures raised while automatic C++ row metadata is live
 * into normal C++ unwinding. A raw PostgreSQL longjmp here would skip the two
 * retained-attribute vector destructors. */
[[noreturn]] static void batch_join_raise_materialization_as_cpp(
		const int sqlstate,
		const char* message,
		const std::string detail = {}) {
	const char* detail_cstr = detail.c_str();
	bioseq::pg_utils::invoke_pg_as_cpp(
		[sqlstate, message, detail_cstr] {
			if (detail_cstr[0] == '\0') {
				ereport(ERROR,
					(errcode(sqlstate), errmsg("%s", message)));
			}
			ereport(ERROR,
				(errcode(sqlstate), errmsg("%s", message),
				 errdetail("%s", detail_cstr)));
		});
	pg_unreachable();
}

static void batch_join_materialize_queries(
		BioseqBatchJoinRuntime& runtime) {
	if (runtime.queries_materialized) {
		return;
	}
	if (runtime.query_child == nullptr || runtime.query_tuple_context == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin query child is not initialized")));
	}
	if (!std::isfinite(runtime.query_planner_rows)
		|| runtime.query_planner_rows < 0.0
		|| runtime.query_planner_width < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqBatchJoin query planner estimate is invalid")));
	}
	/* Reserve the planner's rows*width envelope before asking the child for
	 * its first tuple.  Actual whole-MinimalTuple upper bounds below extend
	 * this reservation before detoast/copy whenever the estimate is low. */
	const double bounded_rows = std::min(
		runtime.query_planner_rows,
		static_cast<double>((std::numeric_limits<std::uint64_t>::max)()));
	const std::uint64_t planner_rows = static_cast<std::uint64_t>(
		std::ceil(bounded_rows));
	const std::uint64_t planner_tuple_bytes =
		bioseq::parallelism::saturating_add(
			static_cast<std::uint64_t>(runtime.query_planner_width),
			static_cast<std::uint64_t>(
				MAXALIGN(MINIMAL_TUPLE_DATA_OFFSET)
				+ sizeof(BioseqBatchJoinQueryTuple)
				+ sizeof(bioseq::scheduler::DispatchJoinQueryRef)
				+ 256u));
	const std::uint64_t scratch_metadata_bytes =
		bioseq::parallelism::saturating_mul(
			bioseq::parallelism::saturating_add(
				static_cast<std::uint64_t>(sizeof(TupleTableSlot)),
				bioseq::parallelism::saturating_mul(
					static_cast<std::uint64_t>(runtime.query_column_count),
					static_cast<std::uint64_t>(
						sizeof(Datum) + sizeof(bool)
						+ sizeof(BioseqBatchJoinQueryTuple::
							RetainedExpandedAttribute)))),
			bioseq::parallelism::kVectorPreallocationHeadroomFactor);
	/* One reusable virtual staging slot and one per-row descriptor vector are
	 * allocated after the planner permit but before the row-specific extension.
	 * Admit their worst query-column-count shape once, even when the planner
	 * estimated zero rows/width. */
	runtime.query_planner_admission_bytes =
		bioseq::parallelism::saturating_add(
			bioseq::parallelism::saturating_mul(
				planner_rows, planner_tuple_bytes),
			scratch_metadata_bytes);
	{
		auto planner_permit =
			bioseq::parallelism::MemoryAdmissionController::instance()
				.try_reserve(runtime.query_planner_admission_bytes);
		if (!planner_permit.has_value()) {
			batch_join_raise_materialization_as_cpp(
				ERRCODE_OUT_OF_MEMORY,
				"BioseqBatchJoin planned query relation cannot be admitted",
				fmt::format(
					"planned_rows={:.0f} planned_width={} required_bytes={}",
					runtime.query_planner_rows,
					runtime.query_planner_width,
					runtime.query_planner_admission_bytes));
		}
		runtime.query_reserved_admission_bytes =
			runtime.query_planner_admission_bytes;
		runtime.query_permits.push_back(std::move(*planner_permit));
	}
	slice_async_owner_guard* query_async_owner = nullptr;
	for (;;) {
		TupleTableSlot* source = ExecProcNode(runtime.query_child);
		if (TupIsNull(source)) {
			break;
		}
		batch_join_validate_returned_child_slot(
			source,
			runtime.query_column_count,
			runtime.query_slot_seq_resno,
			InvalidAttrNumber,
			runtime.query_alphabet_code,
			runtime.query_storage_unit_byte_width,
			"query");
		slot_getallattrs(source);
		bool query_is_null = source->tts_isnull[
			runtime.query_slot_seq_resno - 1];
		if (query_is_null) {
			/* Strict INNER predicate: a NULL query cannot produce a match. */
			continue;
		}
		const Datum original = source->tts_values[
			runtime.query_slot_seq_resno - 1];
		const bool expanded_query =
			VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(original));
		const Oid sequence_type = get_cached_stub_oids().bioseq_seq_type_oid;
		pg_sequence_descriptor recipe_descriptor{};
		std::vector<BioseqBatchJoinQueryTuple::RetainedExpandedAttribute>
			expanded_source_attributes{};
		expanded_source_attributes.reserve(
			static_cast<std::size_t>(source->tts_tupleDescriptor->natts));
		for (int index = 0; index < source->tts_tupleDescriptor->natts;
			 ++index) {
			if (source->tts_isnull[index]
				|| TupleDescAttr(source->tts_tupleDescriptor, index)->atttypid
					!= sequence_type) {
				continue;
			}
			const Datum attribute = source->tts_values[index];
			if (!VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(attribute))) {
				continue;
			}
			const pg_sequence_descriptor descriptor =
				bioseq::pg_utils::invoke_pg_as_cpp([attribute] {
					return classify_and_describe_sequence(attribute);
				});
			const bool expanded_kind = descriptor.kind
					== pg_sequence_datum_kind::expanded_read_only
				|| descriptor.kind
					== pg_sequence_datum_kind::expanded_read_write;
			if (!expanded_kind) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_DATA_CORRUPTED,
					"BioseqBatchJoin expanded output descriptor is invalid");
			}
			const AttrNumber attno = static_cast<AttrNumber>(index + 1);
			expanded_source_attributes.push_back({
				.attno = attno,
				.datum = attribute,
				.descriptor = descriptor,
			});
			if (attno == runtime.query_slot_seq_resno) {
				recipe_descriptor = descriptor;
			}
		}
		if (expanded_query) {
			const bool valid_query_descriptor =
				recipe_descriptor.alphabet_bound
				&& recipe_descriptor.alphabet_code
					== runtime.query_alphabet_code
				&& recipe_descriptor.storage_unit_byte_width
					== runtime.query_storage_unit_byte_width;
			if (!valid_query_descriptor) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_DATATYPE_MISMATCH,
					"BioseqBatchJoin expanded query typmod changed after planning");
			}
			auto* attachment = bioseq::pg_utils::invoke_pg_as_cpp(
				[original] {
					return pg_sequence_trace_attachment_for_datum(original);
				});
			auto* candidate =
				borrow_slice_async_owner_noexcept(attachment);
			if (candidate == nullptr) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE,
					"BioseqBatchJoin expanded query has no live async owner");
			}
			if (query_async_owner != nullptr
				&& query_async_owner != candidate) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE,
					"BioseqBatchJoin expanded queries have distinct async owners");
			}
			query_async_owner = candidate;
		}
		const bool row_has_expanded_sequence =
			!expanded_source_attributes.empty();
		if (row_has_expanded_sequence) {
			if (runtime.query_staging_slot == nullptr) {
				MemoryContext old = MemoryContextSwitchTo(
					runtime.query_tuple_context);
				try {
					runtime.query_staging_slot =
						bioseq::pg_utils::invoke_pg_as_cpp([source] {
							return MakeSingleTupleTableSlot(
								source->tts_tupleDescriptor, &TTSOpsVirtual);
						});
					MemoryContextSwitchTo(old);
				} catch (...) {
					MemoryContextSwitchTo(old);
					throw;
				}
			} else if (runtime.query_staging_slot->tts_tupleDescriptor
					!= source->tts_tupleDescriptor
				&& !bioseq::pg_utils::invoke_pg_as_cpp(
					[staging_descriptor =
						runtime.query_staging_slot->tts_tupleDescriptor,
					 source_descriptor = source->tts_tupleDescriptor] {
						return equalTupleDescs(
							staging_descriptor, source_descriptor);
					})) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_DATA_CORRUPTED,
					"BioseqBatchJoin query staging descriptor changed");
			}
			TupleTableSlot* staging_slot = runtime.query_staging_slot;
			bioseq::pg_utils::invoke_pg_as_cpp(
				[staging_slot] { ExecClearTuple(staging_slot); });
			const int natts = source->tts_tupleDescriptor->natts;
			std::memcpy(
				runtime.query_staging_slot->tts_values,
				source->tts_values,
				static_cast<std::size_t>(natts) * sizeof(Datum));
			std::memcpy(
				runtime.query_staging_slot->tts_isnull,
				source->tts_isnull,
				static_cast<std::size_t>(natts) * sizeof(bool));
			for (const auto& attribute : expanded_source_attributes) {
				runtime.query_staging_slot->tts_values[
					attribute.attno - 1] = Datum{0};
				runtime.query_staging_slot->tts_isnull[
					attribute.attno - 1] = true;
			}
			runtime.query_staging_slot->tts_nvalid = natts;
			bioseq::pg_utils::invoke_pg_as_cpp(
				[staging_slot] { ExecStoreVirtualTuple(staging_slot); });
		}
		const std::uint64_t retained_recipe_bytes = row_has_expanded_sequence
			? bioseq::parallelism::saturating_mul(
				static_cast<std::uint64_t>(
					expanded_source_attributes.size()),
				kBatchJoinRetainedRecipeAdmissionBytes)
			: 0u;
		const std::uint64_t flat_query_bytes = expanded_query
			? 0u
			: static_cast<std::uint64_t>(
				bioseq::pg_utils::invoke_pg_as_cpp([original] {
					return toast_raw_datum_size(original);
				}));
		const std::uint64_t retained_expanded_bytes =
			bioseq::parallelism::saturating_add(
				retained_recipe_bytes, flat_query_bytes);
		TupleTableSlot* tuple_shape_source = row_has_expanded_sequence
			? runtime.query_staging_slot : source;
		const Size source_tuple_data = bioseq::pg_utils::invoke_pg_as_cpp(
			[tuple_shape_source] {
				return heap_compute_data_size(
					tuple_shape_source->tts_tupleDescriptor,
					tuple_shape_source->tts_values,
					tuple_shape_source->tts_isnull);
			});
		std::uint64_t tuple_upper_bound =
			bioseq::parallelism::saturating_add(
				static_cast<std::uint64_t>(
					MAXALIGN(MINIMAL_TUPLE_DATA_OFFSET)),
				static_cast<std::uint64_t>(source_tuple_data));
		/* source_tuple_data includes the original (possibly external TOAST)
		 * sequence datum. Adding the raw size rather than subtracting that datum
		 * is deliberately conservative and covers the flat replacement without
		 * inspecting or allocating any pass-by-reference value. */
		tuple_upper_bound = bioseq::parallelism::saturating_add(
			tuple_upper_bound, retained_expanded_bytes);
		tuple_upper_bound = bioseq::parallelism::saturating_add(
			tuple_upper_bound,
			bioseq::parallelism::saturating_mul(
				bioseq::parallelism::saturating_mul(
					static_cast<std::uint64_t>(
						expanded_source_attributes.size()),
					static_cast<std::uint64_t>(sizeof(
						BioseqBatchJoinQueryTuple::RetainedExpandedAttribute))),
				bioseq::parallelism::kVectorPreallocationHeadroomFactor));
		tuple_upper_bound = bioseq::parallelism::saturating_add(
			tuple_upper_bound,
			static_cast<std::uint64_t>(
				sizeof(BioseqBatchJoinQueryTuple)
				+ sizeof(bioseq::scheduler::DispatchJoinQueryRef)
				+ sizeof(TupleTableSlot)
				+ static_cast<std::size_t>(
					source->tts_tupleDescriptor->natts)
					* (sizeof(Datum) + sizeof(bool))));
		const std::uint64_t required_after_row =
			bioseq::parallelism::saturating_add(
				runtime.query_actual_materialized_bytes,
				tuple_upper_bound);
		if (required_after_row
			== (std::numeric_limits<std::uint64_t>::max)()) {
			batch_join_raise_materialization_as_cpp(
				ERRCODE_PROGRAM_LIMIT_EXCEEDED,
				"BioseqBatchJoin query admission size overflow");
		}
		if (required_after_row > runtime.query_reserved_admission_bytes) {
			const std::uint64_t additional_bytes = required_after_row
				- runtime.query_reserved_admission_bytes;
			auto additional_permit =
				bioseq::parallelism::MemoryAdmissionController::instance()
					.try_reserve(additional_bytes);
			if (!additional_permit.has_value()) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_OUT_OF_MEMORY,
					"BioseqBatchJoin query child cannot be admitted",
					fmt::format(
						"query_ordinal={} required_additional_bytes={} whole_tuple_upper_bound={}",
						runtime.query_tuples.size(), additional_bytes,
						tuple_upper_bound));
			}
			runtime.query_permits.push_back(std::move(*additional_permit));
			runtime.query_reserved_admission_bytes = required_after_row;
		}
		/* Every following operation may allocate; the complete tuple upper
		 * bound is owned before the first retain/detoast/copy. */
		Datum retained_recipe = Datum{0};
		std::vector<BioseqBatchJoinQueryTuple::RetainedExpandedAttribute>
			retained_expanded_attributes{};
		retained_expanded_attributes.reserve(
			expanded_source_attributes.size());
		std::uint64_t newly_retained_wrapper_bytes = 0u;
		bioseq::pg_types::seq* flat = nullptr;
		TupleTableSlot* serialization_source = row_has_expanded_sequence
			? runtime.query_staging_slot : source;
		if (row_has_expanded_sequence) {
			MemoryContext old = MemoryContextSwitchTo(
				runtime.query_tuple_context);
			try {
				for (const auto& attribute : expanded_source_attributes) {
					const acquired_sequence acquired =
						bioseq::pg_utils::invoke_pg_as_cpp(
							[attribute_datum = attribute.datum] {
								const Datum read_only =
									MakeExpandedObjectReadOnly(
										attribute_datum, false, -1);
								return acquire_writable_pg_sequence(read_only);
							});
					newly_retained_wrapper_bytes =
						bioseq::parallelism::saturating_add(
							newly_retained_wrapper_bytes,
							static_cast<std::uint64_t>(
								MemoryContextMemAllocated(
									acquired.value->object_context,
									/*recurse=*/true)));
					const Datum retained =
						pg_sequence_ro_datum(acquired.value);
					retained_expanded_attributes.push_back({
						.attno = attribute.attno,
						.datum = retained,
						.descriptor = attribute.descriptor,
					});
					if (attribute.attno == runtime.query_slot_seq_resno) {
						retained_recipe = retained;
					}
				}
			} catch (...) {
				MemoryContextSwitchTo(old);
				throw;
			}
			MemoryContextSwitchTo(old);
			if (newly_retained_wrapper_bytes > retained_recipe_bytes) {
				batch_join_raise_materialization_as_cpp(
					ERRCODE_INTERNAL_ERROR,
					"BioseqBatchJoin retained recipe admission was under-estimated");
			}
		}
		if (!expanded_query) {
			flat = bioseq::pg_utils::invoke_pg_as_cpp([original] {
				return reinterpret_cast<bioseq::pg_types::seq*>(
					PG_DETOAST_DATUM(original));
			});
			if (bioseq::storage::is_locator_stub(flat)) {
				if (reinterpret_cast<void*>(flat)
					!= reinterpret_cast<void*>(DatumGetPointer(original))) {
					pfree(flat);
				}
				batch_join_raise_materialization_as_cpp(
					ERRCODE_FEATURE_NOT_SUPPORTED,
					"BioseqBatchJoin query child returned an unresolved locator");
			}
			if (flat->alphabet_code != runtime.query_alphabet_code
				|| flat->storage_unit_byte_width
					!= runtime.query_storage_unit_byte_width) {
				if (reinterpret_cast<void*>(flat)
					!= reinterpret_cast<void*>(DatumGetPointer(original))) {
					pfree(flat);
				}
				batch_join_raise_materialization_as_cpp(
					ERRCODE_DATATYPE_MISMATCH,
					"BioseqBatchJoin query typmod changed after planning");
			}
			TupleTableSlot* flat_destination = row_has_expanded_sequence
				? runtime.query_staging_slot : source;
			flat_destination->tts_values[runtime.query_slot_seq_resno - 1] =
				PointerGetDatum(flat);
			flat_destination->tts_isnull[
				runtime.query_slot_seq_resno - 1] = false;
		}
		/* The MinimalTuple and its owning slot are one retained query-row
		 * object.  Allocate both in the dedicated query context: execution may
		 * enter here with a transient expression context current, and retaining
		 * only the tuple there leaves the slot itself dangling before EndScan. */
		MemoryContext old = MemoryContextSwitchTo(
			runtime.query_tuple_context);
		MinimalTuple copy = nullptr;
		try {
			copy = bioseq::pg_utils::invoke_pg_as_cpp(
				[serialization_source] {
					return ExecCopySlotMinimalTuple(serialization_source);
				});
			MemoryContextSwitchTo(old);
		} catch (...) {
			MemoryContextSwitchTo(old);
			throw;
		}
		if (flat != nullptr && reinterpret_cast<void*>(flat)
			!= reinterpret_cast<void*>(DatumGetPointer(original))) {
			pfree(flat);
			if (!row_has_expanded_sequence) {
				source->tts_values[runtime.query_slot_seq_resno - 1] = original;
			}
		}
		if (copy == nullptr) {
			batch_join_raise_materialization_as_cpp(
				ERRCODE_OUT_OF_MEMORY,
				"BioseqBatchJoin failed to copy a query tuple");
		}
		const std::uint64_t ordinal = runtime.query_tuples.size();
		if (ordinal
			> static_cast<std::uint64_t>(
				(std::numeric_limits<std::int32_t>::max)())) {
			batch_join_raise_materialization_as_cpp(
				ERRCODE_PROGRAM_LIMIT_EXCEEDED,
				"BioseqBatchJoin query ordinal exceeds int32 dispatch ABI");
		}
		old = MemoryContextSwitchTo(runtime.query_tuple_context);
		TupleTableSlot* stable_slot = nullptr;
		try {
			stable_slot = bioseq::pg_utils::invoke_pg_as_cpp(
				[source, copy] {
					TupleTableSlot* result = MakeSingleTupleTableSlot(
						source->tts_tupleDescriptor, &TTSOpsMinimalTuple);
					ExecStoreMinimalTuple(copy, result, /*shouldFree=*/false);
					slot_getallattrs(result);
					return result;
				});
			for (const auto& attribute : retained_expanded_attributes) {
				stable_slot->tts_values[attribute.attno - 1] = attribute.datum;
				stable_slot->tts_isnull[attribute.attno - 1] = false;
			}
			MemoryContextSwitchTo(old);
		} catch (...) {
			MemoryContextSwitchTo(old);
			throw;
		}
		const std::uint64_t retained_vector_bytes =
			bioseq::parallelism::saturating_mul(
				static_cast<std::uint64_t>(
					retained_expanded_attributes.capacity()),
				static_cast<std::uint64_t>(
					sizeof(BioseqBatchJoinQueryTuple::
						RetainedExpandedAttribute)));
		const std::uint64_t actual_tuple_bytes =
			bioseq::parallelism::saturating_add(
				static_cast<std::uint64_t>(copy->t_len),
				bioseq::parallelism::saturating_add(
					newly_retained_wrapper_bytes,
					bioseq::parallelism::saturating_add(
						retained_vector_bytes,
						static_cast<std::uint64_t>(
							sizeof(BioseqBatchJoinQueryTuple)
								+ sizeof(bioseq::scheduler::DispatchJoinQueryRef)
								+ sizeof(TupleTableSlot)
								+ static_cast<std::size_t>(
									source->tts_tupleDescriptor->natts)
									* (sizeof(Datum) + sizeof(bool))))));
		runtime.query_actual_materialized_bytes =
			bioseq::parallelism::saturating_add(
				runtime.query_actual_materialized_bytes,
				actual_tuple_bytes);
		if (runtime.query_actual_materialized_bytes
			> runtime.query_reserved_admission_bytes) {
			batch_join_raise_materialization_as_cpp(
				ERRCODE_INTERNAL_ERROR,
				"BioseqBatchJoin whole-tuple admission under-estimated its allocation");
		}
		runtime.query_tuples.push_back(BioseqBatchJoinQueryTuple{
			.tuple = copy,
			.slot = stable_slot,
			.ordinal = ordinal,
			.recipe_datum = retained_recipe,
			.recipe_descriptor = recipe_descriptor,
			.expanded_sequence_attributes =
				std::move(retained_expanded_attributes),
		});
	}
	if (query_async_owner != nullptr) {
		runtime.buffer.bind_slice_async_owner(query_async_owner);
	}
	runtime.all_query_refs.reserve(runtime.query_tuples.size());
	for (BioseqBatchJoinQueryTuple& query : runtime.query_tuples) {
		runtime.all_query_refs.push_back(
			bioseq::scheduler::DispatchJoinQueryRef{
				.ordinal = query.ordinal,
				.query_slot = query.slot,
			});
	}
	runtime.queries_materialized = true;
}

static void batch_join_set_placeholder_value(
		TupleTableSlot* slot,
		const BioseqBatchJoinPlaceholderSite& site,
		const bioseq::simd::MatchResult& match,
		const BioseqStubOids& oids,
		MemoryContext output_context) {
	if (slot == nullptr || site.resno <= 0
		|| site.resno > slot->tts_tupleDescriptor->natts) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin placeholder resno is invalid")));
	}
	Datum value = static_cast<Datum>(0);
	bool is_null = false;
	auto bigint = [&value](const std::uint64_t input) {
		if (input > static_cast<std::uint64_t>(INT64_MAX)) {
			ereport(ERROR,
				(errcode(ERRCODE_NUMERIC_VALUE_OUT_OF_RANGE),
				 errmsg("BioseqBatchJoin match coordinate exceeds bigint")));
		}
		value = Int64GetDatum(static_cast<std::int64_t>(input));
	};
	if (site.funcid == oids.score_oid || site.funcid == oids.dp_score_oid) {
		value = Int32GetDatum(match.dp_score);
	} else if (site.funcid == oids.query_len_oid) {
		bigint(match.query_len);
	} else if (site.funcid == oids.query_start_oid) {
		bigint(match.query_start);
	} else if (site.funcid == oids.query_end_oid) {
		bigint(match.query_end);
	} else if (site.funcid == oids.target_len_oid) {
		bigint(match.target_len);
	} else if (site.funcid == oids.target_start_oid) {
		bigint(match.target_start);
	} else if (site.funcid == oids.target_end_oid) {
		bigint(match.target_end);
	} else if (site.funcid == oids.num_matches_oid) {
		bigint(match.num_matches);
	} else if (site.funcid == oids.block_length_oid) {
		bigint(match.block_length);
	} else if (site.funcid == oids.edit_oid) {
		bigint(match.edit_distance);
	} else if (site.funcid == oids.mapq_oid) {
		value = Int32GetDatum(match.mapq);
	} else if (site.funcid == oids.chain_score_oid) {
		value = Int32GetDatum(match.chain_score);
	} else if (site.funcid == oids.dp_max_score_oid) {
		value = Int32GetDatum(match.dp_max_score);
	} else if (site.funcid == oids.seed_count_oid) {
		value = Int32GetDatum(match.seed_count);
	} else if (site.funcid == oids.secondary_chain_score_oid) {
		value = Int32GetDatum(match.secondary_chain_score);
	} else if (site.funcid == oids.is_reverse_oid) {
		value = BoolGetDatum(match.is_reverse);
	} else if (site.funcid == oids.is_primary_oid) {
		value = BoolGetDatum(match.is_primary);
	} else if (site.funcid == oids.has_cigar_oid) {
		value = BoolGetDatum(match.has_cigar);
	} else if (site.funcid == oids.divergence_oid) {
		value = Float4GetDatum(match.divergence);
	} else if (site.funcid == oids.cigar_oid) {
		const std::string cigar =
			bioseq::simd::format_cigar(match.cigar);
		MemoryContext previous = MemoryContextSwitchTo(output_context);
		value = CStringGetTextDatum(cigar.c_str());
		MemoryContextSwitchTo(previous);
	} else {
		is_null = true;
	}
	slot->tts_values[site.resno - 1] = value;
	slot->tts_isnull[site.resno - 1] = is_null;
}

struct BatchJoinTargetSourceDatum {
	AttrNumber resno = InvalidAttrNumber;
	Datum datum = Datum{0};
};

struct BatchJoinTargetSourceRestore {
	BatchJoinTargetSourceDatum* sources = nullptr;
	std::size_t count = 0u;
};

[[nodiscard]] static BatchJoinTargetSourceRestore
capture_batch_join_target_sources(
		BioseqScanRuntime& target_runtime,
		TupleTableSlot* slot,
		MemoryContext output_context) {
	BatchJoinTargetSourceRestore restore{};
	if (!target_runtime.lazy_source_projection || slot == nullptr) {
		return restore;
	}
	if (output_context == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqBatchJoin target output context is unavailable")));
	}
	slot_getallattrs(slot);
	const std::size_t required_bindings = static_cast<std::size_t>(
		slot->tts_tupleDescriptor->natts + 1);
	if (target_runtime.lazy_source_projected_bindings.size()
			!= required_bindings) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqBatchJoin target source binding layout changed")));
	}
	for (int index = 0; index < slot->tts_tupleDescriptor->natts; ++index) {
		const AttrNumber resno = static_cast<AttrNumber>(index + 1);
		if (target_runtime.lazy_source_projected_bindings[resno].
				physical_attno == InvalidAttrNumber
			|| slot->tts_isnull[index]) {
			continue;
		}
		++restore.count;
	}
	if (restore.count == 0u) return restore;
	restore.sources = static_cast<BatchJoinTargetSourceDatum*>(
		MemoryContextAlloc(
			output_context,
			restore.count * sizeof(BatchJoinTargetSourceDatum)));
	std::size_t destination = 0u;
	for (int index = 0; index < slot->tts_tupleDescriptor->natts; ++index) {
		const AttrNumber resno = static_cast<AttrNumber>(index + 1);
		if (target_runtime.lazy_source_projected_bindings[resno].
				physical_attno == InvalidAttrNumber
			|| slot->tts_isnull[index]) {
			continue;
		}
		restore.sources[destination++] = BatchJoinTargetSourceDatum{
			.resno = resno,
			.datum = slot->tts_values[index],
		};
	}
	Assert(destination == restore.count);
	return restore;
}

static void restore_batch_join_target_sources(
		TupleTableSlot* slot,
		const BatchJoinTargetSourceRestore& restore) noexcept {
	if (slot == nullptr) return;
	for (std::size_t index = 0u; index < restore.count; ++index) {
		const AttrNumber resno = restore.sources[index].resno;
		if (resno > 0 && resno <= slot->tts_tupleDescriptor->natts) {
			slot->tts_values[resno - 1] = restore.sources[index].datum;
		}
	}
}

static void normalize_batch_join_target_sources(
		TupleTableSlot* slot,
		const BatchJoinTargetSourceRestore& restore,
		MemoryContext output_context) {
	for (std::size_t index = 0u; index < restore.count; ++index) {
		const BatchJoinTargetSourceDatum& source = restore.sources[index];
		if (VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(source.datum))) {
			continue;
		}
		/* The dispatch buffer owns a MinimalTuple copy, which may short-pack an
		 * extended sequence Datum.  BSS3's locator decoder requires the ordinary
		 * four-byte varlena header, so normalize in the output lifetime before it
		 * examines bioseq::pg_types::seq fields. */
		MemoryContext previous = MemoryContextSwitchTo(output_context);
		bioseq::pg_types::seq* flat = reinterpret_cast<bioseq::pg_types::seq*>(
			PG_DETOAST_DATUM(source.datum));
		MemoryContextSwitchTo(previous);
		if (static_cast<std::size_t>(VARSIZE(flat))
				< bioseq::pg_types::seq::header_bytes()) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin target source is truncated"),
				 errdetail("attribute=%d bytes=%zu",
					static_cast<int>(source.resno),
					static_cast<std::size_t>(VARSIZE(flat)))));
		}
		slot->tts_values[source.resno - 1] = PointerGetDatum(flat);
	}
}

static TupleTableSlot* batch_join_project_output(
		CustomScanState* node,
		BioseqBatchJoinRuntime& runtime,
		const bioseq::scheduler::DispatchNextOutput& output) {
	if (output.scan_slot_copy == nullptr || output.match == nullptr
		|| output.query_ordinal >= runtime.query_tuples.size()) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqBatchJoin output references invalid inputs")));
	}
	ExprContext* expression_context = node->ss.ps.ps_ExprContext;
	if (expression_context == nullptr
		|| expression_context->ecxt_per_tuple_memory == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin expression context is missing")));
	}
	/* We bypass ExecScan, so own the per-output reset it would normally do. */
	ResetExprContext(expression_context);
	TupleTableSlot* query_slot = runtime.query_tuples[
		output.query_ordinal].slot;
	TupleTableSlot* combined = node->ss.ss_ScanTupleSlot;
	ExecClearTuple(combined);
	slot_getallattrs(output.scan_slot_copy);
	slot_getallattrs(query_slot);
	if (runtime.target_column_count
		> output.scan_slot_copy->tts_tupleDescriptor->natts
		|| runtime.query_column_count
		> query_slot->tts_tupleDescriptor->natts
		|| runtime.target_column_count + runtime.query_column_count
			> combined->tts_tupleDescriptor->natts) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin combined tuple layout is invalid")));
	}
	/* A locator target remains deferred while BatchJoin aligns it.  Once the
	 * match has been produced, an enclosing SliceProject may consume that same
	 * target through a source-backed recipe, and an upper BatchJoin may bind a
	 * sibling sequence as PARAM_EXEC. Promote the output copy only now, into
	 * this output's per-tuple context, copy the promoted Datums, then restore
	 * the retained locator tuple before another match can reuse it. */
	BioseqScanRuntime* target_runtime = nullptr;
	if (runtime.target_child != nullptr
		&& IsA(runtime.target_child, CustomScanState)) {
		auto* target_custom =
			reinterpret_cast<CustomScanState*>(runtime.target_child);
		if (target_custom->methods == &BioseqColumnScanExecuteMethods) {
			auto* target_state =
				BioseqScanState::from_custom_scan_state(target_custom);
			target_runtime = &bioseq_runtime(target_state);
			if (!target_runtime->lazy_source_projection) {
				ereport(ERROR,
					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
					 errmsg("BioseqBatchJoin target source route is unavailable")));
			}
		}
	}
	if (target_runtime == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqBatchJoin target source provider is unavailable")));
	}
	const BatchJoinTargetSourceRestore target_source_restore =
		capture_batch_join_target_sources(
			*target_runtime, output.scan_slot_copy,
			expression_context->ecxt_per_tuple_memory);
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile promotion_pg_error = nullptr;
	std::exception_ptr promotion_cpp_error;
	PG_TRY();
	{
		try {
			auto* target_custom = reinterpret_cast<CustomScanState*>(
				runtime.target_child);
			auto* target_state =
				BioseqScanState::from_custom_scan_state(target_custom);
			normalize_batch_join_target_sources(
				output.scan_slot_copy, target_source_restore,
				expression_context->ecxt_per_tuple_memory);
			promote_slice_project_sources(
				target_state, output.scan_slot_copy,
				expression_context->ecxt_per_tuple_memory,
				/*allow_locator_passthrough=*/true,
				SliceProjectSourceSlotLayout::projected_child,
				ExecGetResultType(reinterpret_cast<PlanState*>(target_custom)));
			slot_getallattrs(output.scan_slot_copy);
			for (int i = 0; i < runtime.target_column_count; ++i) {
				combined->tts_values[i] = output.scan_slot_copy->tts_values[i];
				combined->tts_isnull[i] = output.scan_slot_copy->tts_isnull[i];
			}
			restore_batch_join_target_sources(
				output.scan_slot_copy, target_source_restore);
		} catch (...) {
			MemoryContextSwitchTo(saved_context);
			restore_batch_join_target_sources(
				output.scan_slot_copy, target_source_restore);
			promotion_cpp_error = std::current_exception();
		}
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		restore_batch_join_target_sources(
			output.scan_slot_copy, target_source_restore);
		promotion_pg_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	if (promotion_pg_error != nullptr) {
		ErrorData* exact_error = promotion_pg_error;
		ReThrowError(exact_error);
	}
	if (promotion_cpp_error != nullptr) {
		std::rethrow_exception(promotion_cpp_error);
	}
	for (int i = 0; i < runtime.query_column_count; ++i) {
		const int destination = runtime.target_column_count + i;
		combined->tts_values[destination] = query_slot->tts_values[i];
		combined->tts_isnull[destination] = query_slot->tts_isnull[i];
	}
	const BioseqStubOids& oids = get_cached_stub_oids();
	for (const BioseqBatchJoinPlaceholderSite& site : runtime.placeholder_sites) {
		batch_join_set_placeholder_value(
			combined, site, *output.match, oids,
			expression_context->ecxt_per_tuple_memory);
	}
	ExecStoreVirtualTuple(combined);
	expression_context->ecxt_scantuple = combined;
	if (node->ss.ps.qual != nullptr
		&& !ExecQual(node->ss.ps.qual, expression_context)) {
		InstrCountFiltered1(&node->ss, 1);
		/* A rejected output can be followed by finish_join_target() inside this
		 * same executor call. Drop borrowed query/target recipe Datums before that
		 * transition resets the dispatch arena. */
		clear_recipe_scan_parent_tuple_references(node);
		return nullptr;
	}
	return node->ss.ps.ps_ProjInfo != nullptr
		? ExecProject(node->ss.ps.ps_ProjInfo)
		: combined;
}

static Node* BioseqBatchJoin_CreateCustomScanState(CustomScan* cscan) {
	/* A PlannedStmt can outlive every executor context (prepared statements,
	 * generic plans, EXPLAIN followed by EXECUTE).  Treat the plan as immutable;
	 * planner setrefs must already have mapped each registered whole-helper
	 * identity to its INDEX_VAR descriptor. */
	if (cscan == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin executor plan is missing")));
	}
	auto* state = reinterpret_cast<BioseqBatchJoinState*>(
		newNode(sizeof(BioseqBatchJoinState), T_CustomScanState));
	state->custom_scanstate.methods = &BioseqBatchJoinExecuteMethods;
	state->runtime = nullptr;
	return reinterpret_cast<Node*>(&state->custom_scanstate);
}

[[nodiscard]] static bool bioseq_batch_join_is_post_join_recipe(
		CustomScanState const* node) noexcept {
	if (node == nullptr || node->ss.ps.plan == nullptr
		|| !IsA(node->ss.ps.plan, CustomScan)) return false;
	auto const* cscan = reinterpret_cast<CustomScan const*>(node->ss.ps.plan);
	if (list_length(cscan->custom_plans) != 1
		|| list_length(cscan->custom_private)
			!= kBioseqPerRowJoinPrivateFields) return false;
	Node* version = reinterpret_cast<Node*>(
		linitial(cscan->custom_private));
	return version != nullptr && IsA(version, Integer)
		&& intVal(version) == kBioseqPerRowJoinPlanVersion;
}

static void BioseqBatchJoin_BeginCustomScan(
		CustomScanState* node, EState* estate, int eflags) {
	if (bioseq_batch_join_is_post_join_recipe(node)) {
		BioseqPerRowJoin_BeginCustomScan(node, estate, eflags);
		return;
	}
	auto* cscan = reinterpret_cast<CustomScan*>(node->ss.ps.plan);
	if (IsParallelWorker() || cscan == nullptr
		|| cscan->scan.scanrelid != 0
		|| list_length(cscan->custom_plans) != 2
		|| cscan->custom_exprs != NIL
		|| node->custom_ps != NIL
		|| list_length(cscan->custom_private)
			!= kBioseqBatchJoinPrivateFields) {
			ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("BioseqBatchJoin executor shape is invalid or parallel")));
	}
	/* custom_scan_tlist deliberately retains original helper/PHV identities
	 * as descriptor-only columns, but PostgreSQL setrefs must have removed
	 * every helper from the executable plan targetlist.  If that contract ever
	 * changes, fail before child initialization instead of silently executing a
	 * rendezvous stub (which would fabricate a CPU-looking success). */
	for (TargetEntry* output : PList<TargetEntry>(
			cscan->scan.plan.targetlist)) {
		if (output != nullptr && output->expr != nullptr
			&& batch_join_expression_has_match_helper(
				reinterpret_cast<Node*>(output->expr),
				get_cached_stub_oids())) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin executable projection retained a match helper"),
				 errdetail(
					"setrefs did not map every helper identity to an executor-owned scan slot; no child was initialized")));
		}
	}
	auto* state = reinterpret_cast<BioseqBatchJoinState*>(node);
	state->runtime = nullptr;
	BioseqBatchJoinRuntime* volatile runtime = nullptr;
	bool volatile cleanup_registered = false;
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile original_error = nullptr;
	ErrorData* volatile converted_pg_error = nullptr;
	std::exception_ptr cpp_error;
	PG_TRY();
	{
	  try {
		runtime = std::construct_at(static_cast<BioseqBatchJoinRuntime*>(
			MemoryContextAlloc(
				estate->es_query_cxt, sizeof(BioseqBatchJoinRuntime))));
		state->runtime = runtime;
		runtime->cleanup_callback.func = batch_join_runtime_cleanup;
		runtime->cleanup_callback.arg = state;
		MemoryContextRegisterResetCallback(
			estate->es_query_cxt, &runtime->cleanup_callback);
		cleanup_registered = true;
		auto private_integer = [cscan](const int index) -> int {
			Node* encoded = reinterpret_cast<Node*>(
				list_nth(cscan->custom_private, index));
			if (encoded == nullptr || !IsA(encoded, Integer)) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqBatchJoin private integer ABI is invalid"),
					 errdetail("field=%d", index)));
			}
			return intVal(encoded);
		};
		const int version = private_integer(kBatchJoinVersion);
		const int token = private_integer(kBatchJoinToken);
		const int stable_match_id =
			validate_finalized_match_owner_descriptor(
				cscan, kBatchJoinMatchOwnerDescriptor);
		runtime->target_relation_oid = static_cast<Oid>(
			private_integer(kBatchJoinTargetRelationOid));
		runtime->target_storage_seq_attno = static_cast<AttrNumber>(
			private_integer(kBatchJoinTargetStorageSeqAttno));
		runtime->target_slot_seq_resno = static_cast<AttrNumber>(
			private_integer(kBatchJoinTargetSlotSeqResno));
		runtime->target_slot_rowno_resno = static_cast<AttrNumber>(
			private_integer(kBatchJoinTargetSlotRownoResno));
		runtime->query_slot_seq_resno = static_cast<AttrNumber>(
			private_integer(kBatchJoinQuerySlotSeqResno));
		runtime->target_column_count =
			private_integer(kBatchJoinTargetColumnCount);
		runtime->query_column_count =
			private_integer(kBatchJoinQueryColumnCount);
		const int raw_alphabet_code = private_integer(kBatchJoinAlphabetCode);
		const int raw_storage_width =
			private_integer(kBatchJoinStorageUnitByteWidth);
		const int raw_requirement =
			private_integer(kBatchJoinIndexReadRequirement);
		runtime->honest_startup_cost = batch_join_cost_from_node(
			reinterpret_cast<Node*>(list_nth(
				cscan->custom_private, kBatchJoinHonestStartupCost)),
			"honest_startup_cost");
		runtime->honest_total_cost = batch_join_cost_from_node(
			reinterpret_cast<Node*>(list_nth(
				cscan->custom_private, kBatchJoinHonestTotalCost)),
			"honest_total_cost");
		runtime->incumbent_cost_floor = batch_join_cost_from_node(
			reinterpret_cast<Node*>(list_nth(
				cscan->custom_private, kBatchJoinIncumbentCostFloor)),
			"incumbent_cost_floor");
		Node* sites_node = reinterpret_cast<Node*>(
			list_nth(cscan->custom_private, kBatchJoinPlaceholderSites));
		/* PostgreSQL's canonical empty List is NIL, i.e. a null pointer.  Keep
		 * shape validity separate from the decoded pointer so an empty helper
		 * set is valid while every non-List node remains fail-closed. */
		const bool sites_shape_valid =
			sites_node == nullptr || IsA(sites_node, List);
		List* sites = sites_node == nullptr
			? NIL : reinterpret_cast<List*>(sites_node);
		FuncExpr* mmsearch = pg_node_try_as<FuncExpr>(
			reinterpret_cast<Node*>(
				list_nth(cscan->custom_private, kBatchJoinMmsearchExpr)));
		if (version != kBioseqBatchJoinPlanVersion || token <= 0
			|| !OidIsValid(runtime->target_relation_oid)
			|| runtime->target_storage_seq_attno <= 0
			|| runtime->target_slot_seq_resno <= 0
			|| runtime->target_slot_rowno_resno <= 0
			|| runtime->query_slot_seq_resno <= 0
			|| runtime->target_column_count <= 0
			|| runtime->query_column_count <= 0
			|| raw_alphabet_code < 0 || raw_alphabet_code > UINT8_MAX
			|| (raw_storage_width != 1 && raw_storage_width != 2
				&& raw_storage_width != 4 && raw_storage_width != 8)
			|| !bioseq::indexing::index_read_requirement_ordinal_valid(
				raw_requirement)
			|| !sites_shape_valid || mmsearch == nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin executor private ABI is invalid")));
		}
		runtime->alphabet_code = static_cast<std::uint8_t>(raw_alphabet_code);
		runtime->storage_unit_byte_width =
			static_cast<std::uint8_t>(raw_storage_width);
		const int32 expected_typmod = compact_sequence_stdc_type_params{
			runtime->alphabet_code,
			runtime->storage_unit_byte_width}.encode();
		if (!batch_join_typmod_is_supported(expected_typmod)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqBatchJoin encoded typmod is unsupported")));
		}
		runtime->index_read_requirement =
			static_cast<bioseq::indexing::IndexReadRequirement>(
				raw_requirement);
		runtime->explain_only = (eflags & EXEC_FLAG_EXPLAIN_ONLY) != 0;

		/* Re-decode the catalog composite before any child initialization.  This
		 * catches catalog drift and proves the ordinal marker was not altered
		 * between planning and execution. */
		bioseq::simd::Minimap2Params prevalidated_params =
			build_params_from_gucs();
		bioseq::indexing::IndexReadRequirement decoded_requirement =
			bioseq::indexing::IndexReadRequirement::allow;
		(void)apply_aligner_options_override(
			mmsearch, prevalidated_params, decoded_requirement,
			get_cached_stub_oids());
		finalize_simd_chaining_policy(prevalidated_params);
		if (decoded_requirement != runtime->index_read_requirement) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin index requirement marker disagrees with options")));
		}
		/* A selected Vulkan BatchJoin is allowed to initialize its children and
		 * reach TupleDispatchBuffer's production Format-5 preparation path.  That
		 * path opens the exact PostgreSQL-owned MPS generation, validates READY,
		 * revision/ABI/source/device identity, and retains its three resident GPU
		 * buffers.  Missing or incompatible data still fails there before typed
		 * dispatch; the typed processor independently requires that exact GPU
		 * prepared target and has no CPU/SIMD/recompute fallback.  The older
		 * column-scan path remains rejected separately because it has no such
		 * prepared-target owner. */

		TupleDesc scan_desc = node->ss.ss_ScanTupleSlot == nullptr
			? nullptr : node->ss.ss_ScanTupleSlot->tts_tupleDescriptor;
		const std::int64_t child_column_count =
			static_cast<std::int64_t>(runtime->target_column_count)
			+ static_cast<std::int64_t>(runtime->query_column_count);
		if (scan_desc == nullptr || child_column_count <= 0
			|| child_column_count > scan_desc->natts) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin scan tuple/private layout is invalid"),
				 errdetail(
					"target_columns=%d query_columns=%d scan_columns=%d placeholder_sites=%d",
					runtime->target_column_count,
					runtime->query_column_count,
					scan_desc == nullptr ? -1 : scan_desc->natts,
					list_length(sites))));
		}
		Bitmapset* placeholder_resnos = nullptr;
		int appended_placeholder_count = 0;
		for (List* encoded : PList<List>(sites)) {
			Node* encoded_node = reinterpret_cast<Node*>(encoded);
			if (encoded_node == nullptr || !IsA(encoded_node, List)
				|| list_length(encoded) != kBioseqMatchHelperSiteFields) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqBatchJoin placeholder ABI is invalid")));
			}
			for (const int index : {
					kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
					kMatchSiteCollation, kMatchSiteBindingKind,
					kMatchSitePhid, kMatchSiteStableId}) {
				Node* value = reinterpret_cast<Node*>(list_nth(encoded, index));
				if (value == nullptr || !IsA(value, Integer)) {
					ereport(ERROR,
						(errcode(ERRCODE_INTERNAL_ERROR),
						 errmsg("BioseqBatchJoin placeholder scalar ABI is invalid")));
				}
			}
			const int raw_resno = intVal(list_nth(
				encoded, kMatchSiteResno));
			const bool duplicate_resno = raw_resno > 0
				&& bms_is_member(raw_resno, placeholder_resnos);
			const bool existing_target_resno = raw_resno > 0
				&& raw_resno <= runtime->target_column_count;
			const bool appended_resno = raw_resno > child_column_count
				&& raw_resno <= scan_desc->natts;
			if ((!existing_target_resno && !appended_resno)
				|| raw_resno > scan_desc->natts
				|| duplicate_resno) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqBatchJoin placeholder resno ABI is invalid"),
					 errdetail(
						"resno=%d child_columns=%lld scan_columns=%d duplicate=%s",
						raw_resno,
						static_cast<long long>(child_column_count),
						scan_desc->natts,
						duplicate_resno ? "true" : "false")));
			}
			if (appended_resno) ++appended_placeholder_count;
			placeholder_resnos = bms_add_member(
				placeholder_resnos, raw_resno);
			const BioseqBatchJoinPlaceholderSite site{
				.resno = static_cast<AttrNumber>(raw_resno),
				.funcid = static_cast<Oid>(intVal(list_nth(
					encoded, kMatchSiteFuncid))),
				.typmod = intVal(list_nth(encoded, kMatchSiteTypmod)),
				.collation = static_cast<Oid>(intVal(list_nth(
					encoded, kMatchSiteCollation))),
				.binding_kind = static_cast<BioseqMatchHelperBindingKind>(
					intVal(list_nth(encoded, kMatchSiteBindingKind))),
				.stable_match_id = intVal(list_nth(
					encoded, kMatchSiteStableId)),
			};
			Form_pg_attribute attribute = scan_desc == nullptr
				|| site.resno <= 0 || site.resno > scan_desc->natts
				? nullptr : TupleDescAttr(scan_desc, site.resno - 1);
			if (attribute == nullptr
				|| !is_bioseq_projection_funcid(
					site.funcid, get_cached_stub_oids())
				|| attribute->atttypid != get_func_rettype(site.funcid)
				|| attribute->atttypmod != site.typmod
				|| attribute->attcollation != site.collation
				|| (site.binding_kind
						!= BioseqMatchHelperBindingKind::exact_recipe
					&& site.binding_kind
						!= BioseqMatchHelperBindingKind::unique_lineage)
				|| site.stable_match_id != stable_match_id) {
				ereport(ERROR,
					(errcode(ERRCODE_DATATYPE_MISMATCH),
					 errmsg("BioseqBatchJoin placeholder type/resno ABI is invalid")));
			}
			runtime->placeholder_sites.push_back(site);
		}
		if (appended_placeholder_count
				!= scan_desc->natts - child_column_count) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin appended placeholder layout is invalid"),
				 errdetail(
					"child_columns=%lld scan_columns=%d appended_sites=%d total_sites=%d",
					static_cast<long long>(child_column_count),
					scan_desc->natts, appended_placeholder_count,
					list_length(sites))));
		}
		bms_free(placeholder_resnos);

		Plan* target_plan = reinterpret_cast<Plan*>(linitial(cscan->custom_plans));
		Plan* query_plan = reinterpret_cast<Plan*>(lsecond(cscan->custom_plans));
		if (target_plan == nullptr || query_plan == nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin child plan ABI is invalid")));
		}
		runtime->query_planner_rows = std::max(0.0, query_plan->plan_rows);
		runtime->query_planner_width = std::max(0, query_plan->plan_width);
		runtime->target_child = ExecInitNode(target_plan, estate, eflags);
		runtime->target_child_initialized = true;
		node->custom_ps = lappend(node->custom_ps, runtime->target_child);
		runtime->query_child = ExecInitNode(query_plan, estate, eflags);
		runtime->query_child_initialized = true;
		node->custom_ps = lappend(node->custom_ps, runtime->query_child);
		auto* target_custom = reinterpret_cast<CustomScan*>(target_plan);
		if (!IsA(target_plan, CustomScan)
			|| target_custom->methods != &BioseqColumnScanScanMethods) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin target provider is invalid")));
		}
		CustomScanState* target_custom_state =
			pg_node_try_as<CustomScanState>(
				reinterpret_cast<Node*>(runtime->target_child));
		if (target_custom_state == nullptr
			|| target_custom_state->methods != &BioseqColumnScanExecuteMethods
			|| target_custom_state->ss.ps.plan != target_plan
			|| target_custom_state->ss.ss_currentRelation == nullptr
			|| RelationGetRelid(target_custom_state->ss.ss_currentRelation)
				!= runtime->target_relation_oid) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin initialized target provider state is invalid")));
		}
		BioseqScanState* target_bioseq_state =
			BioseqScanState::from_custom_scan_state(target_custom_state);
		BioseqScanRuntime& target_scan_runtime =
			bioseq_runtime(target_bioseq_state);
		Snapshot target_snapshot = target_bioseq_state->snapshot;
		if (target_snapshot == nullptr
			|| !IsMVCCSnapshot(target_snapshot)
			|| target_snapshot->regd_count == 0) {
			ereport(ERROR,
				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
				 errmsg("BioseqBatchJoin target provider snapshot is not registered MVCC state")));
		}
		RangeTblEntry* target_rte = exec_rt_fetch(
			target_custom->scan.scanrelid, estate);
		if (target_rte == nullptr || target_rte->rtekind != RTE_RELATION
			|| target_rte->relid != runtime->target_relation_oid) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin target provider relation is invalid")));
		}
		List* locator_tag = nullptr;
		for (Node* raw_tag : PList<Node>(target_custom->custom_private)) {
			if (raw_tag == nullptr || !IsA(raw_tag, List)) continue;
			List* candidate = reinterpret_cast<List*>(raw_tag);
			if (list_length(candidate) != 4
				|| !IsA(reinterpret_cast<Node*>(linitial(candidate)), Integer)
				|| intVal(linitial(candidate))
					!= kBioseqLocatorPassthroughMagic) continue;
			if (locator_tag != nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqBatchJoin target has duplicate locator ownership")));
			}
			locator_tag = candidate;
		}
		if (locator_tag == nullptr || list_length(locator_tag) != 4
			|| intVal(list_nth(locator_tag, 0))
				!= kBioseqLocatorPassthroughMagic
			|| intVal(list_nth(locator_tag, 1))
				!= kBioseqBatchJoinPlanVersion
			|| intVal(list_nth(locator_tag, 2)) != token
			|| intVal(list_nth(locator_tag, 3))
				!= runtime->target_slot_rowno_resno) {
				ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin target locator token mismatch")));
		}
		/* Validate against the post-setrefs Plan targetlists.  They are stable
		 * planner ABI; ps_ResultTupleSlot is not, because projection-free and
		 * pass-through PlanStates may return a scan/child slot instead.  The
		 * actual slots are validated independently at each ExecProcNode edge. */
		if (runtime->target_column_count
				!= list_length(target_plan->targetlist)
			|| runtime->query_column_count
				!= list_length(query_plan->targetlist)
			|| runtime->target_slot_seq_resno <= 0
			|| runtime->target_slot_seq_resno
				> runtime->target_column_count
			|| runtime->target_slot_rowno_resno <= 0
			|| runtime->target_slot_rowno_resno
				> runtime->target_column_count
			|| runtime->query_slot_seq_resno <= 0
			|| runtime->query_slot_seq_resno
				> runtime->query_column_count) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin post-setrefs child targetlists are invalid"),
				 errdetail(
					"target_private_columns=%d target_plan_columns=%d query_private_columns=%d query_plan_columns=%d target_sequence_resno=%d target_rowno_resno=%d query_sequence_resno=%d",
					runtime->target_column_count,
					list_length(target_plan->targetlist),
					runtime->query_column_count,
					list_length(query_plan->targetlist),
					runtime->target_slot_seq_resno,
					runtime->target_slot_rowno_resno,
					runtime->query_slot_seq_resno)));
		}
		TargetEntry* target_seq_entry = reinterpret_cast<TargetEntry*>(
			list_nth(
				target_plan->targetlist,
				runtime->target_slot_seq_resno - 1));
		TargetEntry* target_rowno_entry = reinterpret_cast<TargetEntry*>(
			list_nth(
				target_plan->targetlist,
				runtime->target_slot_rowno_resno - 1));
		TargetEntry* query_seq_entry = reinterpret_cast<TargetEntry*>(
			list_nth(
				query_plan->targetlist,
				runtime->query_slot_seq_resno - 1));
		const int32 expected_sequence_typmod =
			compact_sequence_stdc_type_params{
				runtime->alphabet_code,
				runtime->storage_unit_byte_width}.encode();
		const int32 query_sequence_typmod = query_seq_entry == nullptr
			? -1 : exprTypmod(reinterpret_cast<Node*>(query_seq_entry->expr));
		const bool query_typmod_supported =
			batch_join_typmod_is_supported(query_sequence_typmod);
		const auto query_sequence_type_params = query_typmod_supported
			? compact_sequence_stdc_type_params::decode(query_sequence_typmod)
			: compact_sequence_stdc_type_params{};
		const Oid sequence_type =
			get_cached_stub_oids().bioseq_seq_type_oid;
		if (target_seq_entry == nullptr || target_rowno_entry == nullptr
			|| query_seq_entry == nullptr
			|| target_seq_entry->resno != runtime->target_slot_seq_resno
			|| target_rowno_entry->resno != runtime->target_slot_rowno_resno
			|| query_seq_entry->resno != runtime->query_slot_seq_resno
			|| !target_rowno_entry->resjunk
			|| exprType(reinterpret_cast<Node*>(target_seq_entry->expr))
				!= get_cached_stub_oids().bioseq_seq_type_oid
			|| exprType(reinterpret_cast<Node*>(query_seq_entry->expr))
				!= get_cached_stub_oids().bioseq_seq_type_oid
			|| exprTypmod(reinterpret_cast<Node*>(target_seq_entry->expr))
				!= expected_sequence_typmod
			|| !query_typmod_supported
			|| query_sequence_type_params.alphabet_code
				!= runtime->alphabet_code
			|| exprCollation(reinterpret_cast<Node*>(target_seq_entry->expr))
				!= exprCollation(reinterpret_cast<Node*>(query_seq_entry->expr))
			|| exprCollation(reinterpret_cast<Node*>(target_seq_entry->expr))
				!= get_typcollation(sequence_type)
			|| exprType(reinterpret_cast<Node*>(target_rowno_entry->expr))
				!= INT8OID
			|| exprTypmod(reinterpret_cast<Node*>(target_rowno_entry->expr)) != -1
			|| OidIsValid(exprCollation(
				reinterpret_cast<Node*>(target_rowno_entry->expr)))) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqBatchJoin post-setrefs child targetlist types are invalid"),
				 errdetail(
					"target_sequence_type=%u target_sequence_typmod=%d target_sequence_collation=%u query_sequence_type=%u query_sequence_typmod=%d query_sequence_collation=%u rowno_type=%u rowno_typmod=%d rowno_collation=%u rowno_resjunk=%s",
					target_seq_entry == nullptr ? InvalidOid
						: exprType(reinterpret_cast<Node*>(target_seq_entry->expr)),
					target_seq_entry == nullptr ? -1
						: exprTypmod(reinterpret_cast<Node*>(target_seq_entry->expr)),
					target_seq_entry == nullptr ? InvalidOid
						: exprCollation(reinterpret_cast<Node*>(target_seq_entry->expr)),
					query_seq_entry == nullptr ? InvalidOid
						: exprType(reinterpret_cast<Node*>(query_seq_entry->expr)),
					query_seq_entry == nullptr ? -1
						: exprTypmod(reinterpret_cast<Node*>(query_seq_entry->expr)),
					query_seq_entry == nullptr ? InvalidOid
						: exprCollation(reinterpret_cast<Node*>(query_seq_entry->expr)),
					target_rowno_entry == nullptr ? InvalidOid
						: exprType(reinterpret_cast<Node*>(target_rowno_entry->expr)),
					target_rowno_entry == nullptr ? -1
						: exprTypmod(reinterpret_cast<Node*>(target_rowno_entry->expr)),
					target_rowno_entry == nullptr ? InvalidOid
						: exprCollation(reinterpret_cast<Node*>(target_rowno_entry->expr)),
					target_rowno_entry != nullptr && target_rowno_entry->resjunk
						? "true" : "false")));
		}
		runtime->query_alphabet_code =
			query_sequence_type_params.alphabet_code;
		runtime->query_storage_unit_byte_width =
			query_sequence_type_params.storage_unit_byte_width;

		bioseq::simd::Minimap2Params params =
			build_params_from_gucs();
		bioseq::indexing::IndexReadRequirement requirement =
			bioseq::indexing::IndexReadRequirement::allow;
		(void)apply_aligner_options_override(
			mmsearch, params, requirement, get_cached_stub_oids());
		finalize_simd_chaining_policy(params);
		params.alphabet_code = runtime->alphabet_code;
		if (requirement != runtime->index_read_requirement) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqBatchJoin requirement changed after prevalidation")));
		}
		/* Plan setrefs has deliberately replaced every match-result helper
		 * with an INDEX_VAR into the combined scan tuple.  Derive expensive
		 * stage requirements from the validated private placeholder kinds,
		 * not by re-walking an executor targetlist in which helpers no longer
		 * exist. */
		params.do_cigar = false;
		params.compute_divergence = false;
		params.compute_mapq = false;
		params.compute_edit_distance = false;
		const BioseqStubOids& batch_oids = get_cached_stub_oids();
		for (const BioseqBatchJoinPlaceholderSite& site :
			 runtime->placeholder_sites) {
			params.do_cigar = params.do_cigar
				|| site.funcid == batch_oids.cigar_oid
				|| site.funcid == batch_oids.has_cigar_oid
				|| site.funcid == batch_oids.edit_oid;
			params.compute_edit_distance = params.compute_edit_distance
				|| site.funcid == batch_oids.edit_oid;
			params.compute_divergence = params.compute_divergence
				|| site.funcid == batch_oids.divergence_oid;
			params.compute_mapq = params.compute_mapq
				|| site.funcid == batch_oids.mapq_oid;
		}

		/* Reuse the target provider's executor-owned Relation. Its lock lives
		 * through ExecEndNode; this BatchJoin neither reopens nor closes it. */
		Relation target_relation =
			target_custom_state->ss.ss_currentRelation;
		if (target_relation == nullptr) {
			ereport(ERROR,
				(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
				 errmsg("BioseqBatchJoin target executor relation is unavailable")));
		}
		if (target_relation->rd_tableam != GetBioseqColumnTableAmRoutine()) {
			ereport(ERROR,
				(errcode(ERRCODE_WRONG_OBJECT_TYPE),
				 errmsg("BioseqBatchJoin target relation changed table AM")));
		}
		TupleDesc relation_desc = RelationGetDescr(target_relation);
		Form_pg_attribute storage_sequence_attribute =
			runtime->target_storage_seq_attno <= 0
			|| runtime->target_storage_seq_attno > relation_desc->natts
			? nullptr
			: TupleDescAttr(
				relation_desc, runtime->target_storage_seq_attno - 1);
		if (storage_sequence_attribute == nullptr
			|| storage_sequence_attribute->attisdropped
			|| storage_sequence_attribute->atttypid
				!= get_cached_stub_oids().bioseq_seq_type_oid
			|| storage_sequence_attribute->atttypmod
				!= expected_sequence_typmod
			|| storage_sequence_attribute->attcollation
				!= get_typcollation(sequence_type)) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqBatchJoin storage-column ABI changed after planning")));
		}
		char* target_column_name = get_attname(
			runtime->target_relation_oid,
			runtime->target_storage_seq_attno,
			/*missing_ok=*/false);
		/* The target child may have replaced the executor snapshot while
		 * flushing its columnar write state. Borrow that exact registered
		 * snapshot. batch_join_release_executor_resources_checked drains the
		 * buffer (and its fragment readers) before ExecEndNode(target_child)
		 * releases the child's registration. */
		runtime->aligner_params = params;
		runtime->aligner_params_captured = true;
		runtime->pipeline_desc = DescribePipelineForPgAlphabet(
			params, runtime->alphabet_code,
			QuerySketchPlanRouteFor(requirement));
		runtime->buffer.configure_params(
			params,
			requirement,
			bioseq::settings::read_sequence_index,
			runtime->target_relation_oid,
			target_relation->rd_locator.dbOid,
			target_relation->rd_locator.spcOid,
			target_relation->rd_locator.relNumber,
			target_relation,
			target_snapshot,
			estate->es_query_cxt);
		runtime->buffer.bind_sequence_source_provider(
			target_scan_runtime.lazy_source_provider);
		runtime->buffer.configure_mmsearch_join(
			runtime->target_relation_oid,
			runtime->target_storage_seq_attno,
			runtime->target_slot_seq_resno,
			runtime->target_slot_rowno_resno,
			runtime->query_slot_seq_resno,
			std::string{target_column_name},
			runtime->alphabet_code,
			runtime->storage_unit_byte_width,
			runtime->query_alphabet_code,
			runtime->query_storage_unit_byte_width);
		pfree(target_column_name);

		runtime->query_tuple_context = AllocSetContextCreate(
			estate->es_query_cxt,
			"BioseqBatchJoin query tuples",
			ALLOCSET_DEFAULT_SIZES);
		const int plan_node_id = cscan->scan.plan.plan_node_id;
		if (plan_node_id < 0) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqBatchJoin plan node id is invalid")));
		}
		runtime->alignment_registration =
			bioseq::pg::alignment_execution::bind_alignment_node(
				estate, static_cast<std::uint32_t>(plan_node_id));
		runtime->buffer.bind_persisted_gpu_operation_evidence_sink(
			*bioseq::pg::alignment_execution::
				borrow_persisted_gpu_operation_evidence_sink(
					runtime->alignment_registration));
		  } catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
			converted_pg_error = error.release_error_data();
		  } catch (...) {
			cpp_error = std::current_exception();
	  }
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		original_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	BioseqBatchJoinRuntime* stable_runtime = runtime;
	const bool stable_cleanup_registered = cleanup_registered;
	auto abandon = [node, state, stable_runtime,
		stable_cleanup_registered]() noexcept {
		if (stable_runtime == nullptr) return;
		batch_join_abandon_executor_resources_after_error(
			node, *stable_runtime);
		if (!stable_cleanup_registered) {
			state->runtime = nullptr;
			std::destroy_at(stable_runtime);
		}
	};
	if (original_error != nullptr) {
		abandon();
		ErrorData* exact_error = original_error;
		ReThrowError(exact_error);
	}
	if (converted_pg_error != nullptr) {
		abandon();
		ErrorData* exact_error = converted_pg_error;
		ReThrowError(exact_error);
	}
	if (cpp_error != nullptr) {
		abandon();
		char detail[512] = "unknown C++ exception";
		try {
			std::rethrow_exception(cpp_error);
		} catch (const std::exception& error) {
			strlcpy(detail,
				error.what() == nullptr ? "std::exception without detail"
					: error.what(),
				sizeof(detail));
		} catch (...) {
		}
		cpp_error = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin Begin raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
}

static TupleTableSlot* BioseqBatchJoin_ExecCustomScanImpl(
		CustomScanState* node) {
	BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
	if (runtime == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin runtime is missing")));
	}
	batch_join_clear_parent_tuple_references(node, *runtime);
	bioseq::pg::alignment_execution::ensure_alignment_node_registered(
		runtime->alignment_registration);
	batch_join_materialize_queries(*runtime);

	for (;;) {
		auto output = runtime->buffer.read_next_output();
		if (output.has_value()) {
			TupleTableSlot* projected = batch_join_project_output(
				node, *runtime, *output);
			if (projected != nullptr) return projected;
			continue;
		}
		if (runtime->target_active
			&& runtime->next_query_batch < runtime->all_query_refs.size()) {
			const std::size_t batch_end = std::min(
				runtime->all_query_refs.size(),
				runtime->next_query_batch + kBioseqRuntimeBufferReserve);
			const std::span<const bioseq::scheduler::DispatchJoinQueryRef> batch{
				runtime->all_query_refs.data() + runtime->next_query_batch,
				batch_end - runtime->next_query_batch};
			runtime->buffer.set_join_query_batch(batch);
			if (runtime->buffer.run_join_query_batch_and_build_cursors()) {
				const auto delta = runtime->buffer.execution_stats();
				runtime->aggregate_stats.merge(delta);
				bioseq::pg::alignment_execution::merge_alignment_batch(
					runtime->alignment_registration,
					delta);
			}
			runtime->next_query_batch = batch_end;
			++runtime->query_batch_count;
			continue;
		}
		if (runtime->target_active) {
			runtime->buffer.finish_join_target();
			runtime->target_active = false;
			runtime->current_target_slot = nullptr;
			runtime->next_query_batch = 0;
		}
		if (runtime->target_eof) {
			bioseq::pg::alignment_execution::mark_alignment_pass_fully_drained(
				runtime->alignment_registration);
			runtime->current_pass_fully_drained = true;
			return ExecClearTuple(node->ss.ps.ps_ResultTupleSlot);
		}
		TupleTableSlot* target = ExecProcNode(runtime->target_child);
		if (TupIsNull(target)) {
			runtime->target_eof = true;
			continue;
		}
		batch_join_validate_returned_child_slot(
			target,
			runtime->target_column_count,
			runtime->target_slot_seq_resno,
			runtime->target_slot_rowno_resno,
			runtime->alphabet_code,
			runtime->storage_unit_byte_width,
			"target");
		slot_getallattrs(target);
		if (target->tts_isnull[runtime->target_slot_seq_resno - 1]) {
			/* Strict INNER predicate: do not hand a NULL target to dispatch. */
			continue;
		}
		runtime->current_target_slot = target;
		runtime->buffer.begin_join_target(target);
		runtime->buffer.prepare_join_target_queries(
			std::span<const bioseq::scheduler::DispatchJoinQueryRef>{
				runtime->all_query_refs});
		runtime->target_active = true;
		++runtime->distinct_targets;
	}
}

static TupleTableSlot* BioseqBatchJoin_ExecCustomScan(
		CustomScanState* node) {
	if (bioseq_batch_join_is_post_join_recipe(node)) {
		return BioseqPerRowJoin_ExecCustomScan(node);
	}
	TupleTableSlot* result = nullptr;
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile original_error = nullptr;
	ErrorData* volatile converted_pg_error = nullptr;
	std::exception_ptr cpp_error;
	PG_TRY();
	{
		try {
			result = BioseqBatchJoin_ExecCustomScanImpl(node);
			} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
				converted_pg_error = error.release_error_data();
			} catch (...) {
				cpp_error = std::current_exception();
		}
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		original_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	if (original_error != nullptr) {
		if (BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
			runtime != nullptr) {
			batch_join_abandon_executor_resources_after_error(
				node, *runtime);
		}
		ErrorData* exact_error = original_error;
		ReThrowError(exact_error);
	}
	if (converted_pg_error != nullptr) {
		if (BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
			runtime != nullptr) {
			batch_join_abandon_executor_resources_after_error(
				node, *runtime);
		}
		ErrorData* exact_error = converted_pg_error;
		ReThrowError(exact_error);
	}
	if (cpp_error != nullptr) {
		if (BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
			runtime != nullptr) {
			batch_join_abandon_executor_resources_after_error(
				node, *runtime);
		}
		char detail[512] = "unknown C++ exception";
		try {
			std::rethrow_exception(cpp_error);
		} catch (const std::exception& error) {
			strlcpy(detail,
				error.what() == nullptr ? "std::exception without detail"
					: error.what(),
				sizeof(detail));
		} catch (...) {
		}
		cpp_error = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin Exec raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	return result;
}

static void BioseqBatchJoin_EndCustomScan(CustomScanState* node) {
	if (bioseq_batch_join_is_post_join_recipe(node)) {
		BioseqPerRowJoin_EndCustomScan(node);
		return;
	}
	BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
	if (runtime == nullptr || runtime->cleanup_done) {
		return;
	}
	ErrorData* exact_error = nullptr;
	bool cpp_error = false;
	bool unknown_cpp_error = false;
	char detail[512] = "std::exception without detail";
	try {
		batch_join_release_executor_resources_checked(
			node, *runtime, /*delete_query_context=*/false);
	} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
		exact_error = error.release_error_data();
	} catch (const std::exception& error) {
		strlcpy(detail,
			error.what() == nullptr ? "std::exception without detail"
				: error.what(),
			sizeof(detail));
		cpp_error = true;
	} catch (...) {
		unknown_cpp_error = true;
	}
	if (exact_error != nullptr || cpp_error || unknown_cpp_error) {
		batch_join_abandon_executor_resources_after_error(node, *runtime);
	}
	if (exact_error != nullptr) {
		ReThrowError(exact_error);
	}
	if (cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin checked End raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	if (unknown_cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin checked End raised an unknown C++ exception")));
	}
}

static void BioseqBatchJoin_ReScanCustomScan(CustomScanState* node) {
	if (bioseq_batch_join_is_post_join_recipe(node)) {
		BioseqPerRowJoin_ReScanCustomScan(node);
		return;
	}
	BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
	if (runtime == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin rescan runtime is missing")));
	}
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile original_error = nullptr;
	ErrorData* volatile converted_pg_error = nullptr;
	std::exception_ptr cpp_error;
	PG_TRY();
	{
		try {
			batch_join_clear_parent_tuple_references(node, *runtime);
			bioseq::pg::alignment_execution::mark_alignment_rescan(
				runtime->alignment_registration);
			if (runtime->target_active) {
				runtime->buffer.finish_join_target();
			}
			runtime->buffer.reset_join_runtime_for_rescan();
			runtime->buffer.release_join_slice_async_owner_after_drain();
			batch_join_clear_query_tuples(*runtime, /*drop_slots=*/true);
			runtime->target_active = false;
			runtime->target_eof = false;
			runtime->current_pass_fully_drained = false;
			runtime->current_target_slot = nullptr;
			runtime->next_query_batch = 0;
			runtime->active_query_batch_end = 0;
			ExecReScan(runtime->target_child);
			ExecReScan(runtime->query_child);
			} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
				converted_pg_error = error.release_error_data();
			} catch (...) {
				cpp_error = std::current_exception();
		}
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		original_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	if (original_error != nullptr) {
		batch_join_abandon_executor_resources_after_error(node, *runtime);
		ErrorData* exact_error = original_error;
		ReThrowError(exact_error);
	}
	if (converted_pg_error != nullptr) {
		batch_join_abandon_executor_resources_after_error(node, *runtime);
		ErrorData* exact_error = converted_pg_error;
		ReThrowError(exact_error);
	}
	if (cpp_error != nullptr) {
		batch_join_abandon_executor_resources_after_error(node, *runtime);
		char detail[512] = "unknown C++ exception";
		try {
			std::rethrow_exception(cpp_error);
		} catch (const std::exception& error) {
			strlcpy(detail,
				error.what() == nullptr ? "std::exception without detail"
					: error.what(),
				sizeof(detail));
		} catch (...) {
		}
		cpp_error = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin ReScan raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
}

static void BioseqBatchJoin_ExplainCustomScan(
		CustomScanState* node, List* ancestors, ExplainState* es) {
	if (bioseq_batch_join_is_post_join_recipe(node)) {
		BioseqPerRowJoin_ExplainCustomScan(node, ancestors, es);
		return;
	}
	(void)ancestors;
	BioseqBatchJoinRuntime* runtime = batch_join_runtime(node);
	ExplainPropertyInteger(
		"Bioseq Query Batch Capacity", nullptr,
		static_cast<std::int64_t>(kBioseqRuntimeBufferReserve), es);
	ExplainPropertyText(
		"Bioseq Residual Mmsearch Qual", "absent", es);
	ExplainPropertyInteger(
		"Bioseq Batch ABI Version", nullptr,
		static_cast<std::int64_t>(kBioseqBatchJoinPlanVersion), es);
	if (runtime == nullptr) {
		return;
	}
	ExplainPropertyFloat(
		"Bioseq Honest Startup Cost", nullptr,
		runtime->honest_startup_cost, 2, es);
	ExplainPropertyFloat(
		"Bioseq Honest Total Cost", nullptr,
		runtime->honest_total_cost, 2, es);
	ExplainPropertyFloat(
		"Bioseq Incumbent Cost Floor", nullptr,
		runtime->incumbent_cost_floor, 2, es);
	ExplainPropertyInteger(
		"Bioseq Match Placeholder Sites", nullptr,
		static_cast<std::int64_t>(runtime->placeholder_sites.size()), es);
	ExplainPropertyText(
		"Bioseq Index Read Requirement",
		bioseq::indexing::index_read_requirement_name(
			runtime->index_read_requirement).data(), es);
	ExplainPropertyBool(
		"Bioseq Requirement Executable",
		true,
		es);
	ExplainPropertyText(
		"Bioseq CPU Prepared Target",
		runtime->index_read_requirement
			== bioseq::indexing::IndexReadRequirement::require_absent
				? "disabled: ExactSimd target-sketch backend unavailable"
				: runtime->index_read_requirement
						== bioseq::indexing::IndexReadRequirement::
							require_compatible_persisted
					? "revision-3 grouped32 direct reader retained across query waves"
					: "persisted-only query-hash union; one target index per parameter group",
		es);
	ExplainPropertyFloat(
		"Bioseq Query Planner Rows", nullptr,
		runtime->query_planner_rows, 0, es);
	ExplainPropertyInteger(
		"Bioseq Query Planner Width", "bytes",
		static_cast<std::int64_t>(runtime->query_planner_width), es);
	ExplainPropertyInteger(
		"Bioseq Query Planner Admission", "bytes",
		static_cast<std::int64_t>(std::min<std::uint64_t>(
			runtime->query_planner_admission_bytes,
			static_cast<std::uint64_t>(INT64_MAX))), es);
	ExplainPropertyInteger(
		"Bioseq Query Actual Materialization", "bytes",
		static_cast<std::int64_t>(std::min<std::uint64_t>(
			runtime->query_actual_materialized_bytes,
			static_cast<std::uint64_t>(INT64_MAX))), es);
	ExplainPropertyInteger(
		"Bioseq Distinct Targets", nullptr,
		static_cast<std::int64_t>(runtime->distinct_targets), es);
	ExplainPropertyInteger(
		"Bioseq Query Batches", nullptr,
		static_cast<std::int64_t>(runtime->query_batch_count), es);
	ExplainPipelineExecutionStats(
		runtime->aggregate_stats, es,
		runtime->aligner_params_captured
			? &runtime->aligner_params : nullptr,
		runtime->pipeline_desc.has_value()
			? &*runtime->pipeline_desc : nullptr,
		QuerySketchPlanRouteFor(runtime->index_read_requirement),
		/*highway_dispatch_already_rendered=*/false);
}

[[nodiscard]] static BioseqPerRowJoinRuntime* per_row_join_runtime(
		CustomScanState* node) noexcept {
	auto* state = reinterpret_cast<BioseqPerRowJoinState*>(node);
	return state == nullptr
		? nullptr : static_cast<BioseqPerRowJoinRuntime*>(state->runtime);
}

static void per_row_join_abandon_after_error(
		CustomScanState* node, BioseqPerRowJoinRuntime& runtime) noexcept {
	if (runtime.cleanup_done) return;
	runtime.buffer.abandon_join_runtime_after_pg_error_noexcept();
	runtime.child = nullptr;
	runtime.target_relation = nullptr;
	runtime.child_initialized = false;
	runtime.child_ended = true;
	if (node != nullptr) node->custom_ps = NIL;
	runtime.cleanup_done = true;
}

static void per_row_join_runtime_cleanup(void* argument) {
	auto* state = static_cast<BioseqPerRowJoinState*>(argument);
	if (state == nullptr || state->runtime == nullptr) return;
	auto* runtime = static_cast<BioseqPerRowJoinRuntime*>(state->runtime);
	per_row_join_abandon_after_error(&state->custom_scanstate, *runtime);
	state->runtime = nullptr;
	std::destroy_at(runtime);
}

static void per_row_join_release_checked(
		CustomScanState* node, BioseqPerRowJoinRuntime& runtime) {
	if (runtime.cleanup_done) return;
	clear_recipe_scan_parent_tuple_references(node);
	runtime.buffer.clear_slots();
	runtime.buffer.release_per_row_slice_async_owner_after_drain();
	if (runtime.child_initialized && !runtime.child_ended
		&& runtime.child != nullptr) {
		ExecEndNode(runtime.child);
		runtime.child_ended = true;
	}
	if (runtime.target_relation != nullptr) {
		table_close(runtime.target_relation, NoLock);
		runtime.target_relation = nullptr;
	}
	runtime.child = nullptr;
	if (node != nullptr) node->custom_ps = NIL;
	runtime.cleanup_done = true;
}

static void BioseqPerRowJoin_BeginCustomScanImpl(
		CustomScanState* node, EState* estate, int eflags) {
	auto* cscan = reinterpret_cast<CustomScan*>(node->ss.ps.plan);
	if (IsParallelWorker() || cscan == nullptr
		|| cscan->scan.scanrelid != 0 || cscan->custom_exprs != NIL
		|| list_length(cscan->custom_plans) != 1
		|| list_length(cscan->custom_private)
			!= kBioseqPerRowJoinPrivateFields
		|| node->custom_ps != NIL) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("BioseqPerRowMmsearch executor shape is invalid or parallel")));
	}
	for (TargetEntry* output : PList<TargetEntry>(
			cscan->scan.plan.targetlist)) {
		if (output != nullptr && output->expr != nullptr
			&& batch_join_expression_has_match_helper(
				reinterpret_cast<Node*>(output->expr),
				get_cached_stub_oids())) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch executable projection retained a match helper")));
		}
	}
	auto* state = reinterpret_cast<BioseqPerRowJoinState*>(node);
	auto* runtime = std::construct_at(static_cast<BioseqPerRowJoinRuntime*>(
		MemoryContextAlloc(
			estate->es_query_cxt, sizeof(BioseqPerRowJoinRuntime))));
	state->runtime = runtime;
	runtime->cleanup_callback.func = per_row_join_runtime_cleanup;
	runtime->cleanup_callback.arg = state;
	MemoryContextRegisterResetCallback(
		estate->es_query_cxt, &runtime->cleanup_callback);
	runtime->cleanup_callback_registered = true;
	auto private_integer = [cscan](const int index) -> int {
		Node* value = reinterpret_cast<Node*>(
			list_nth(cscan->custom_private, index));
		if (value == nullptr || !IsA(value, Integer)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch executor integer ABI is invalid"),
				 errdetail("field=%d", index)));
		}
		return intVal(value);
	};
	const int version = private_integer(kPerRowVersion);
	const int stable_match_id = validate_finalized_match_owner_descriptor(
		cscan, kPerRowMatchOwnerDescriptor);
	const Oid target_relation_oid = static_cast<Oid>(
		private_integer(kPerRowTargetRelationOid));
	const AttrNumber target_storage_attno = static_cast<AttrNumber>(
		private_integer(kPerRowTargetStorageAttno));
	runtime->target_slot_resno = static_cast<AttrNumber>(
		private_integer(kPerRowTargetSlotResno));
	runtime->query_slot_resno = static_cast<AttrNumber>(
		private_integer(kPerRowQuerySlotResno));
	runtime->child_column_count = private_integer(kPerRowChildColumnCount);
	const int raw_alphabet = private_integer(kPerRowAlphabetCode);
	const int raw_width = private_integer(kPerRowStorageUnitByteWidth);
	const int raw_query_alphabet = private_integer(kPerRowQueryAlphabetCode);
	const int raw_query_width = private_integer(
		kPerRowQueryStorageUnitByteWidth);
	const int target_typmod_erased = private_integer(
		kPerRowTargetTypmodErasedProof);
	const int query_typmod_erased = private_integer(
		kPerRowQueryTypmodErasedProof);
	const int raw_requirement = private_integer(kPerRowIndexReadRequirement);
	runtime->honest_startup_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(cscan->custom_private,
			kPerRowHonestStartupCost)), "honest_startup_cost");
	runtime->honest_total_cost = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(cscan->custom_private,
			kPerRowHonestTotalCost)), "honest_total_cost");
	runtime->incumbent_cost_floor = batch_join_cost_from_node(
		reinterpret_cast<Node*>(list_nth(cscan->custom_private,
			kPerRowIncumbentCostFloor)), "incumbent_cost_floor");
	Node* sites_node = reinterpret_cast<Node*>(list_nth(
		cscan->custom_private, kPerRowPlaceholderSites));
	const bool sites_shape_valid = sites_node == nullptr || IsA(sites_node, List);
	List* sites = sites_node == nullptr
		? NIL : reinterpret_cast<List*>(sites_node);
	FuncExpr* mmsearch = pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
		list_nth(cscan->custom_private, kPerRowMmsearchExpr)));
	if (version != kBioseqPerRowJoinPlanVersion
		|| !OidIsValid(target_relation_oid) || target_storage_attno <= 0
		|| runtime->target_slot_resno <= 0 || runtime->query_slot_resno <= 0
		|| runtime->child_column_count <= 0
		|| raw_alphabet < 0 || raw_alphabet > UINT8_MAX
		|| (raw_width != 1 && raw_width != 2
			&& raw_width != 4 && raw_width != 8)
		|| raw_query_alphabet < 0 || raw_query_alphabet > UINT8_MAX
		|| (raw_query_width != 1 && raw_query_width != 2
			&& raw_query_width != 4 && raw_query_width != 8)
		|| (target_typmod_erased != 0 && target_typmod_erased != 1)
		|| (query_typmod_erased != 0 && query_typmod_erased != 1)
		|| raw_requirement != static_cast<int>(
			bioseq::indexing::IndexReadRequirement::require_absent)
		|| !sites_shape_valid || mmsearch == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch executor private ABI is invalid")));
	}
	runtime->alphabet_code = static_cast<std::uint8_t>(raw_alphabet);
	runtime->storage_unit_byte_width = static_cast<std::uint8_t>(raw_width);
	runtime->query_alphabet_code = static_cast<std::uint8_t>(
		raw_query_alphabet);
	runtime->query_storage_unit_byte_width = static_cast<std::uint8_t>(
		raw_query_width);
	if (runtime->alphabet_code != runtime->query_alphabet_code) {
		raise_mmsearch_alphabet_mismatch(
			compact_sequence_stdc_type_params{
				runtime->alphabet_code,
				runtime->storage_unit_byte_width},
			compact_sequence_stdc_type_params{
				runtime->query_alphabet_code,
				runtime->query_storage_unit_byte_width},
			"post-join recipe begin");
	}
	TupleDesc scan_desc = node->ss.ss_ScanTupleSlot == nullptr
		? nullptr : node->ss.ss_ScanTupleSlot->tts_tupleDescriptor;
	if (scan_desc == nullptr
		|| runtime->child_column_count > scan_desc->natts
		|| list_length(sites)
			!= scan_desc->natts - runtime->child_column_count
		|| runtime->target_slot_resno > runtime->child_column_count
		|| runtime->query_slot_resno > runtime->child_column_count) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch scan tuple layout is invalid")));
	}
	const int32 expected_typmod = compact_sequence_stdc_type_params{
		runtime->alphabet_code, runtime->storage_unit_byte_width}.encode();
	const int32 expected_query_typmod = compact_sequence_stdc_type_params{
		runtime->query_alphabet_code,
		runtime->query_storage_unit_byte_width}.encode();
	const std::array<AttrNumber, 2> operand_resnos{
		runtime->target_slot_resno, runtime->query_slot_resno};
	const std::array<int, 2> erased_proofs{
		target_typmod_erased, query_typmod_erased};
	for (std::size_t index = 0u; index < operand_resnos.size(); ++index) {
		const AttrNumber resno = operand_resnos[index];
		Form_pg_attribute attribute = TupleDescAttr(scan_desc, resno - 1);
		if (attribute->atttypid
				!= get_cached_stub_oids().bioseq_seq_type_oid
			|| attribute->atttypmod
				!= (erased_proofs[index] != 0
					? -1
					: (index == 0u
						? expected_typmod : expected_query_typmod))) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqPerRowMmsearch operand type is invalid")));
		}
	}
	Bitmapset* placeholder_resnos = nullptr;
	for (List* encoded : PList<List>(sites)) {
		if (encoded == nullptr || !IsA(encoded, List)
			|| list_length(encoded) != kBioseqMatchHelperSiteFields) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch placeholder ABI is invalid")));
		}
		for (const int index : {
				kMatchSiteResno, kMatchSiteFuncid, kMatchSiteTypmod,
				kMatchSiteCollation, kMatchSiteBindingKind,
				kMatchSitePhid, kMatchSiteStableId}) {
			Node* value = reinterpret_cast<Node*>(list_nth(encoded, index));
			if (value == nullptr || !IsA(value, Integer)) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("BioseqPerRowMmsearch placeholder scalar is invalid")));
			}
		}
		const int raw_resno = intVal(list_nth(
			encoded, kMatchSiteResno));
		if (raw_resno <= runtime->child_column_count
			|| raw_resno > scan_desc->natts
			|| bms_is_member(raw_resno, placeholder_resnos)) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("BioseqPerRowMmsearch placeholder resno is invalid")));
		}
		placeholder_resnos = bms_add_member(placeholder_resnos, raw_resno);
		const BioseqBatchJoinPlaceholderSite site{
			.resno = static_cast<AttrNumber>(raw_resno),
			.funcid = static_cast<Oid>(intVal(list_nth(
				encoded, kMatchSiteFuncid))),
			.typmod = intVal(list_nth(encoded, kMatchSiteTypmod)),
			.collation = static_cast<Oid>(intVal(list_nth(
				encoded, kMatchSiteCollation))),
			.binding_kind = static_cast<BioseqMatchHelperBindingKind>(
				intVal(list_nth(encoded, kMatchSiteBindingKind))),
			.stable_match_id = intVal(list_nth(
				encoded, kMatchSiteStableId)),
		};
		Form_pg_attribute attribute = TupleDescAttr(
			scan_desc, site.resno - 1);
		if (!is_bioseq_projection_funcid(
				site.funcid, get_cached_stub_oids())
			|| attribute->atttypid != get_func_rettype(site.funcid)
			|| attribute->atttypmod != site.typmod
			|| attribute->attcollation != site.collation
			|| (site.binding_kind
					!= BioseqMatchHelperBindingKind::exact_recipe
				&& site.binding_kind
					!= BioseqMatchHelperBindingKind::unique_lineage)
			|| site.stable_match_id != stable_match_id) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqBatchJoin post-join recipe placeholder type is invalid")));
		}
		runtime->placeholder_sites.push_back(site);
	}
	bms_free(placeholder_resnos);

	bioseq::simd::Minimap2Params params =
		build_params_from_gucs();
	bioseq::indexing::IndexReadRequirement decoded_requirement =
		bioseq::indexing::IndexReadRequirement::allow;
	(void)apply_aligner_options_override(
		mmsearch, params, decoded_requirement, get_cached_stub_oids());
	finalize_simd_chaining_policy(params);
	params.alphabet_code = runtime->alphabet_code;
	if (decoded_requirement
			== bioseq::indexing::IndexReadRequirement::require_compatible_persisted) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("transformed mmsearch target cannot require a persisted index")));
	}
	params.do_cigar = false;
	params.compute_divergence = false;
	params.compute_mapq = false;
	params.compute_edit_distance = false;
	const BioseqStubOids& placeholder_oids = get_cached_stub_oids();
	for (auto const& site : runtime->placeholder_sites) {
		params.do_cigar = params.do_cigar
			|| site.funcid == placeholder_oids.cigar_oid
			|| site.funcid == placeholder_oids.has_cigar_oid
			|| site.funcid == placeholder_oids.edit_oid;
		params.compute_edit_distance = params.compute_edit_distance
			|| site.funcid == placeholder_oids.edit_oid;
		params.compute_divergence = params.compute_divergence
			|| site.funcid == placeholder_oids.divergence_oid;
		params.compute_mapq = params.compute_mapq
			|| site.funcid == placeholder_oids.mapq_oid;
	}
	Plan* child_plan = reinterpret_cast<Plan*>(linitial(cscan->custom_plans));
	BatchJoinPlanHelperAuditFirstFailure helper_audit_failure{};
	if (batch_join_plan_has_unowned_executable_match_helper(
			child_plan, get_cached_stub_oids(), cscan,
			helper_audit_failure, "none")) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch child retained an executable match helper"),
			 errdetail("reason=%s; store=%s; plan_node_tag=%d; custom_name=%s; projection_capable=%s; first_helper_resno=%d; whole_helper_valid=%s; finalized_batch_descendant_matches=%zu; finalized_base_descendant_matches=%zu; current_parent_matches=%zu; boundary_encountered=%s; setrefs did not preserve the descendant-owner helper route; no child was initialized",
				helper_audit_failure.reason,
				helper_audit_failure.store,
				helper_audit_failure.plan_node_tag,
				helper_audit_failure.custom_name,
				helper_audit_failure.projection_capable ? "true" : "false",
				helper_audit_failure.first_helper_resno,
				helper_audit_failure.whole_helper_valid ? "true" : "false",
				helper_audit_failure.finalized_batch_descendant_matches,
				helper_audit_failure.finalized_base_descendant_matches,
				helper_audit_failure.current_parent_matches,
				helper_audit_failure.boundary_encountered)));
	}
	runtime->child = ExecInitNode(child_plan, estate, eflags);
	runtime->child_initialized = true;
	node->custom_ps = list_make1(runtime->child);
	runtime->target_relation = table_open(target_relation_oid, NoLock);
	if (runtime->target_relation == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_UNDEFINED_TABLE),
			 errmsg("BioseqPerRowMmsearch target relation is unavailable")));
	}
	if (runtime->target_relation->rd_tableam
			!= GetBioseqColumnTableAmRoutine()) {
		ereport(ERROR,
			(errcode(ERRCODE_WRONG_OBJECT_TYPE),
			 errmsg("BioseqPerRowMmsearch target relation changed table AM")));
	}
	TupleDesc relation_desc = RelationGetDescr(runtime->target_relation);
	Form_pg_attribute storage_attribute =
		target_storage_attno > relation_desc->natts
		? nullptr : TupleDescAttr(relation_desc, target_storage_attno - 1);
	if (storage_attribute == nullptr || storage_attribute->attisdropped
		|| storage_attribute->atttypid
			!= get_cached_stub_oids().bioseq_seq_type_oid
		|| storage_attribute->atttypmod != expected_typmod) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("BioseqPerRowMmsearch target storage column changed")));
	}
	runtime->aligner_params = params;
	runtime->aligner_params_captured = true;
	runtime->pipeline_desc = DescribePipelineForPgAlphabet(
		params, runtime->alphabet_code,
		QuerySketchPlanRouteFor(
			bioseq::indexing::IndexReadRequirement::require_absent));
	runtime->buffer.configure_params(
		params, bioseq::indexing::IndexReadRequirement::require_absent,
		/*read_sequence_index=*/false, target_relation_oid,
		runtime->target_relation->rd_locator.dbOid,
		runtime->target_relation->rd_locator.spcOid,
		runtime->target_relation->rd_locator.relNumber,
		runtime->target_relation, estate->es_snapshot,
		estate->es_query_cxt);
	char* column_name = get_attname(
		target_relation_oid, target_storage_attno, /*missing_ok=*/false);
	runtime->buffer.configure_mmsearch_per_row(
		runtime->target_slot_resno, std::string{column_name},
		runtime->query_slot_resno,
		runtime->target_slot_resno == runtime->query_slot_resno,
		runtime->alphabet_code, runtime->storage_unit_byte_width,
		runtime->query_alphabet_code,
		runtime->query_storage_unit_byte_width,
		InvalidAttrNumber);
	pfree(column_name);
	const int plan_node_id = cscan->scan.plan.plan_node_id;
	if (plan_node_id < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch plan node id is invalid")));
	}
	runtime->alignment_registration =
		bioseq::pg::alignment_execution::bind_alignment_node(
			estate, static_cast<std::uint32_t>(plan_node_id));
	runtime->buffer.bind_persisted_gpu_operation_evidence_sink(
		*bioseq::pg::alignment_execution::
			borrow_persisted_gpu_operation_evidence_sink(
				runtime->alignment_registration));
}

static void BioseqPerRowJoin_BeginCustomScan(
		CustomScanState* node, EState* estate, int eflags) {
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile original_error = nullptr;
	ErrorData* volatile converted_pg_error = nullptr;
	std::exception_ptr cpp_error;
	PG_TRY();
	{
		try {
			BioseqPerRowJoin_BeginCustomScanImpl(node, estate, eflags);
		} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
			converted_pg_error = error.release_error_data();
		} catch (...) {
			cpp_error = std::current_exception();
		}
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		original_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	auto abandon = [node]() noexcept {
		if (BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
			runtime != nullptr) {
			per_row_join_abandon_after_error(node, *runtime);
			if (!runtime->cleanup_callback_registered) {
				auto* state = reinterpret_cast<BioseqPerRowJoinState*>(node);
				state->runtime = nullptr;
				std::destroy_at(runtime);
			}
		}
	};
	if (original_error != nullptr) {
		abandon();
		ErrorData* exact = original_error;
		ReThrowError(exact);
	}
	if (converted_pg_error != nullptr) {
		abandon();
		ErrorData* exact = converted_pg_error;
		ReThrowError(exact);
	}
	if (cpp_error != nullptr) {
		abandon();
		char detail[512] = "unknown C++ exception";
		try {
			std::rethrow_exception(cpp_error);
		} catch (const std::exception& error) {
			strlcpy(detail,
				error.what() == nullptr ? "std::exception without detail"
					: error.what(),
				sizeof(detail));
		} catch (...) {
		}
		cpp_error = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin post-join recipe Begin raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
}

[[nodiscard]] static TupleTableSlot* per_row_join_project_output(
		CustomScanState* node, BioseqPerRowJoinRuntime& runtime,
		bioseq::scheduler::DispatchNextOutput const& output) {
	if (output.scan_slot_copy == nullptr || output.match == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqPerRowMmsearch output references invalid input")));
	}
	ExprContext* context = node->ss.ps.ps_ExprContext;
	if (context == nullptr || context->ecxt_per_tuple_memory == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin post-join recipe expression context is missing")));
	}
	ResetExprContext(context);
	TupleTableSlot* combined = node->ss.ss_ScanTupleSlot;
	ExecClearTuple(combined);
	slot_getallattrs(output.scan_slot_copy);
	if (runtime.child_column_count
			> output.scan_slot_copy->tts_tupleDescriptor->natts
		|| runtime.child_column_count
			> combined->tts_tupleDescriptor->natts) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch output tuple layout changed")));
	}
	for (int index = 0; index < runtime.child_column_count; ++index) {
		combined->tts_values[index] = output.scan_slot_copy->tts_values[index];
		combined->tts_isnull[index] = output.scan_slot_copy->tts_isnull[index];
	}
	const BioseqStubOids& oids = get_cached_stub_oids();
	for (auto const& site : runtime.placeholder_sites) {
		batch_join_set_placeholder_value(
			combined, site, *output.match, oids,
			context->ecxt_per_tuple_memory);
	}
	ExecStoreVirtualTuple(combined);
	context->ecxt_scantuple = combined;
	return combined;
}

static TupleTableSlot* BioseqPerRowJoin_ExecCustomScanImpl(
		CustomScanState* node) {
	BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
	if (runtime == nullptr || runtime->child == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch runtime is missing")));
	}
	/* ExecScan may reject an Access result and call us again without returning
	 * through BioseqPerRowJoin_ExecCustomScan. Clear that prior virtual row on
	 * every Access entry so a subsequent clear_slots() cannot invalidate a
	 * still-parent-visible expanded recipe. */
	clear_recipe_scan_parent_tuple_references(node);
	bioseq::pg::alignment_execution::ensure_alignment_node_registered(
		runtime->alignment_registration);
	for (;;) {
		if (runtime->buffer.has_finished_writing()) {
			auto output = runtime->buffer.read_next_output();
			if (output.has_value()) {
				return per_row_join_project_output(node, *runtime, *output);
			}
			if (runtime->source_exhausted) {
				if (!runtime->pass_fully_drained) {
					bioseq::pg::alignment_execution::
						mark_alignment_pass_fully_drained(
							runtime->alignment_registration);
					runtime->pass_fully_drained = true;
				}
				return ExecClearTuple(node->ss.ps.ps_ResultTupleSlot);
			}
			runtime->buffer.clear_slots();
			runtime->buffer.release_per_row_slice_async_owner_after_drain();
			continue;
		}
		TupleTableSlot* child_slot = ExecProcNode(runtime->child);
		if (TupIsNull(child_slot)) {
			runtime->source_exhausted = true;
			if (runtime->buffer.run_batch_and_build_cursors()) {
				auto delta = runtime->buffer.execution_stats();
				runtime->aggregate_stats.merge(delta);
				bioseq::pg::alignment_execution::merge_alignment_batch(
					runtime->alignment_registration, delta);
			}
			continue;
		}
		bool target_is_null = false;
		bool query_is_null = false;
		const Datum target = slot_getattr(child_slot,
			runtime->target_slot_resno, &target_is_null);
		const Datum query = slot_getattr(child_slot,
			runtime->query_slot_resno, &query_is_null);
		if (target_is_null || query_is_null) continue;
		slice_async_owner_guard* async_owner = nullptr;
		for (const Datum operand : std::array{target, query}) {
			auto* attachment = pg_sequence_trace_attachment_for_datum(operand);
			auto* candidate = borrow_slice_async_owner_noexcept(attachment);
			if (candidate == nullptr) continue;
			if (async_owner != nullptr && async_owner != candidate) {
				ereport(ERROR,
					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
					 errmsg("BioseqPerRowMmsearch operands have distinct async owners")));
			}
			async_owner = candidate;
		}
		if (async_owner != nullptr) {
			runtime->buffer.bind_slice_async_owner(async_owner);
		}
		runtime->buffer.submit_scan(child_slot);
		if (runtime->buffer.ready_to_dispatch()) {
			if (runtime->buffer.run_batch_and_build_cursors()) {
				auto delta = runtime->buffer.execution_stats();
				runtime->aggregate_stats.merge(delta);
				bioseq::pg::alignment_execution::merge_alignment_batch(
					runtime->alignment_registration, delta);
			}
		}
	}
}

[[nodiscard]] static TupleTableSlot* BioseqPerRowJoin_Access(
		ScanState* scan) {
	return BioseqPerRowJoin_ExecCustomScanImpl(
		reinterpret_cast<CustomScanState*>(scan));
}

[[nodiscard]] static bool BioseqPerRowJoin_Recheck(
		ScanState* scan, TupleTableSlot*) {
	auto* custom = reinterpret_cast<CustomScanState*>(scan);
	if (custom->ss.ps.state == nullptr
		|| custom->ss.ps.state->es_epq_active == nullptr) return true;
	/* The child plan is EPQ-aware. Pull its substituted row through the same
	 * owned recipe/alignment pipeline, but return only the scan tuple here:
	 * ExecScan performs the final projection exactly once after recheck. */
	return !TupIsNull(BioseqPerRowJoin_ExecCustomScanImpl(custom));
}

static TupleTableSlot* BioseqPerRowJoin_ExecCustomScan(
		CustomScanState* node) {
	TupleTableSlot* result = nullptr;
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* volatile original_error = nullptr;
	ErrorData* volatile converted_pg_error = nullptr;
	std::exception_ptr cpp_error;
	PG_TRY();
	{
		try {
			clear_recipe_scan_parent_tuple_references(node);
			result = ExecScan(
				&node->ss, BioseqPerRowJoin_Access,
				BioseqPerRowJoin_Recheck);
		} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
			converted_pg_error = error.release_error_data();
		} catch (...) {
			cpp_error = std::current_exception();
		}
	}
	PG_CATCH();
	{
		MemoryContextSwitchTo(saved_context);
		original_error = CopyErrorData();
		FlushErrorState();
	}
	PG_END_TRY();
	auto abandon = [node]() noexcept {
		if (BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
			runtime != nullptr) {
			per_row_join_abandon_after_error(node, *runtime);
		}
	};
	if (original_error != nullptr) {
		abandon();
		ErrorData* exact = original_error;
		ReThrowError(exact);
	}
	if (converted_pg_error != nullptr) {
		abandon();
		ErrorData* exact = converted_pg_error;
		ReThrowError(exact);
	}
	if (cpp_error != nullptr) {
		abandon();
		char detail[512] = "unknown C++ exception";
		try {
			std::rethrow_exception(cpp_error);
		} catch (const std::exception& error) {
			strlcpy(detail,
				error.what() == nullptr ? "std::exception without detail"
					: error.what(),
				sizeof(detail));
		} catch (...) {
		}
		cpp_error = nullptr;
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqBatchJoin post-join recipe Exec raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	return result;
}

static void BioseqPerRowJoin_EndCustomScan(CustomScanState* node) {
	BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
	if (runtime == nullptr || runtime->cleanup_done) return;
	try {
		per_row_join_release_checked(node, *runtime);
	} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
		per_row_join_abandon_after_error(node, *runtime);
		ErrorData* exact = error.release_error_data();
		ReThrowError(exact);
	} catch (const std::exception& error) {
		per_row_join_abandon_after_error(node, *runtime);
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch End raised a C++ exception"),
			 errdetail_internal("%s", error.what())));
	}
}

static void BioseqPerRowJoin_ReScanCustomScan(CustomScanState* node) {
	BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
	if (runtime == nullptr || runtime->child == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqPerRowMmsearch rescan runtime is missing")));
	}
	bioseq::pg::alignment_execution::mark_alignment_rescan(
		runtime->alignment_registration);
	clear_recipe_scan_parent_tuple_references(node);
	runtime->buffer.clear_slots();
	runtime->buffer.release_per_row_slice_async_owner_after_drain();
	runtime->source_exhausted = false;
	runtime->pass_fully_drained = false;
	/* Like SliceProject, this CustomScan owns its child through custom_ps.
	 * Transfer only the parameters relevant to that child's allParam before
	 * ExecReScan; UpdateChangedParamSet performs the required filtering and
	 * unions with any invalidation already owned by the child. */
	if (node->ss.ps.chgParam != nullptr) {
		UpdateChangedParamSet(runtime->child, node->ss.ps.chgParam);
	}
	ExecScanReScan(&node->ss);
	ExecReScan(runtime->child);
}

static void BioseqPerRowJoin_ExplainCustomScan(
		CustomScanState* node, List*, ExplainState* es) {
	BioseqPerRowJoinRuntime* runtime = per_row_join_runtime(node);
	ExplainPropertyText("Bioseq Mmsearch Ownership", "per-row recipe", es);
	ExplainPropertyText("Bioseq Reconstructed Join", "child plan", es);
	PerRowMmsearchPlanAudit child_audit{};
	auto* cscan = reinterpret_cast<CustomScan*>(node->ss.ps.plan);
	FuncExpr* owned_mmsearch = cscan != nullptr
		&& list_length(cscan->custom_private) == kBioseqPerRowJoinPrivateFields
		? pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(list_nth(
			cscan->custom_private, kPerRowMmsearchExpr))) : nullptr;
	if (cscan != nullptr && list_length(cscan->custom_plans) == 1) {
		per_row_audit_mmsearch_plan(
			reinterpret_cast<Plan*>(linitial(cscan->custom_plans)),
			child_audit, get_cached_stub_oids(), owned_mmsearch);
	}
	/* A nonzero path count cannot reach plan creation: the exact pointer gate
	 * above runs on the reconstructed Path before copyObject.  The remaining
	 * values are recomputed from the serialized executable plan, not constants. */
	ExplainPropertyInteger(
		"Bioseq Owned RestrictInfo Path Copies", nullptr, 0, es);
	ExplainPropertyInteger(
		"Bioseq Executable Mmsearch Qual Copies", nullptr,
		static_cast<std::int64_t>(child_audit.executable_qual_copies), es);
	ExplainPropertyInteger(
		"Bioseq Vector Mmsearch Qual Copies", nullptr,
		static_cast<std::int64_t>(child_audit.vector_qual_copies), es);
	ExplainPropertyInteger(
		"Bioseq Storage Mmsearch Qual Copies", nullptr,
		static_cast<std::int64_t>(child_audit.storage_qual_copies), es);
	ExplainPropertyInteger(
		"Bioseq Descendant Mmsearch Owner Copies", nullptr,
		static_cast<std::int64_t>(child_audit.descendant_owner_copies), es);
	ExplainPropertyText("Bioseq Residual Mmsearch Qual", "absent", es);
	ExplainPropertyInteger("Bioseq Batch Capacity", nullptr,
		static_cast<std::int64_t>(kBioseqRuntimeBufferReserve), es);
	ExplainPropertyText("Bioseq Index Read Requirement",
		"require_absent (transformed target)", es);
	if (runtime == nullptr) return;
	ExplainPropertyFloat("Bioseq Honest Startup Cost", nullptr,
		runtime->honest_startup_cost, 2, es);
	ExplainPropertyFloat("Bioseq Honest Total Cost", nullptr,
		runtime->honest_total_cost, 2, es);
	ExplainPropertyFloat("Bioseq Incumbent Cost Floor", nullptr,
		runtime->incumbent_cost_floor, 2, es);
	ExplainPropertyInteger("Bioseq Match Placeholder Sites", nullptr,
		static_cast<std::int64_t>(runtime->placeholder_sites.size()), es);
	ExplainPipelineExecutionStats(
		runtime->aggregate_stats, es,
		runtime->aligner_params_captured
			? &runtime->aligner_params : nullptr,
		runtime->pipeline_desc.has_value()
			? &*runtime->pipeline_desc : nullptr,
		QuerySketchPlanRouteFor(
			bioseq::indexing::IndexReadRequirement::require_absent),
		/*highway_dispatch_already_rendered=*/false);
}

/*
 * DOC0279 §12.5 — per-tuple populate for every `bioseq.symbol_count(Var, 'L')`
 * placeholder. For the current output row (resolved by columnar rowno) it
 * random-access reads the SEQ column header, then for each site:
 *   (2) if bioseq.read_sequence_index = on, tries the stored INLINE
 *       SymbolCountsIndex chunk (one heap PK lookup, the only thing the GUC
 *       gates here);
 *   (3) otherwise UNCONDITIONALLY recomputes tally_symbol_counts over the row
 *       (scanner_pg-streamed for a stored stub, in-memory for an inline value).
 * The recompute guarantees a non-NULL answer for every present row regardless
 * of the GUC — the GUC only chooses whether the stored chunk is preferred.
 * Replaces the deleted meta_sidecar / 49-stub path.
 */
struct SymbolCountReadResources {
	MemoryContext caller_context = nullptr;
	MemoryContext scratch = nullptr;
	bioseq::storage::seq_caches* caches = nullptr;
	BioseqColumnReadState* row_read_state = nullptr;
};

static void
release_symbol_count_read_resources_checked(
	SymbolCountReadResources* resources)
{
	if (resources == nullptr) {
		return;
	}
	if (resources->caller_context != nullptr
		&& CurrentMemoryContext != resources->caller_context) {
		bioseq::pg_utils::invoke_pg_as_cpp([resources] {
			MemoryContextSwitchTo(resources->caller_context);
		});
	}
	if (resources->row_read_state != nullptr) {
		BioseqColumnReadState* finished = resources->row_read_state;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[finished] { BioseqColumnEndRead(finished); });
		resources->row_read_state = nullptr;
	}
	if (resources->caches != nullptr) {
		bioseq::storage::seq_caches* finished = resources->caches;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[finished] { finished->close_all(/*commit=*/false); });
		bioseq::pg_utils::invoke_pg_as_cpp([finished] {
			bioseq::storage::destroy_seq_caches(finished);
		});
		resources->caches = nullptr;
	}
	if (resources->scratch != nullptr) {
		MemoryContext finished = resources->scratch;
		bioseq::pg_utils::invoke_pg_as_cpp(
			[finished] { MemoryContextDelete(finished); });
		resources->scratch = nullptr;
	}
}

static void
abandon_symbol_count_read_resources_after_error(
	SymbolCountReadResources* resources) noexcept
{
	if (resources == nullptr) {
		return;
	}
	// PostgreSQL's transaction/ResourceOwner will release readers, relations,
	// and palloc contexts.  Do not issue any PG call while preserving the
	// original ErrorData; only discharge ordinary C++ heap ownership.
	resources->row_read_state = nullptr;
	if (resources->caches != nullptr) {
		bioseq::storage::seq_caches* abandoned = std::exchange(
			resources->caches, nullptr);
		for (auto& [key, entry] : abandoned->entries) {
			(void)key;
			entry.rel = nullptr;
			entry.write_state = nullptr;
			entry.read_state = nullptr;
			entry.read_snapshot_source = nullptr;
			entry.pending_bytes_delta = 0;
			entry.pending_total_payload_delta = 0;
		}
		abandoned->entries.clear();
		abandoned->~seq_caches();
	}
	resources->scratch = nullptr;
}

[[noreturn]] static void symbol_count_error_as_cpp(
		int sqlstate,
		std::string_view message) {
	bioseq::pg_utils::invoke_pg_as_cpp([sqlstate, message] {
		ereport(ERROR,
			(errcode(sqlstate),
			 errmsg("%.*s", static_cast<int>(message.size()),
				message.data())));
	});
	pg_unreachable();
}

static void
populate_symbol_count_placeholders(BioseqPlaceholderConsts& consts,
								   Relation main, int64_t rowno,
								   Snapshot registered_snapshot,
								   const bool read_sequence_index)
{
	if (consts.symbol_count_sites.empty()) {
		return;
	}
	SymbolCountReadResources* resources = nullptr;
	ErrorData* exact_error = nullptr;
	bool cpp_error = false;
	bool unknown_cpp_error = false;
	char detail[512] = "std::exception without detail";
	try {
	if (registered_snapshot == nullptr
		|| !IsMVCCSnapshot(registered_snapshot)
		|| registered_snapshot->regd_count == 0) {
		symbol_count_error_as_cpp(
			ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE,
			"bioseq symbol-count read requires a registered MVCC executor snapshot");
	}
	auto set_all_null = [&]() {
		for (auto& s : consts.symbol_count_sites)
			if (s.placeholder != nullptr) s.placeholder->constisnull = true;
	};
	if (rowno < 0 || main == nullptr) { set_all_null(); return; }

	namespace bsi = bioseq::storage::indexing;
	const Oid relid = RelationGetRelid(main);
	const auto rid = bsi::index_relation_identity(relid);
	TupleDesc td   = RelationGetDescr(main);

	/* Mutable ownership lives in this record so ordinary C++ catches can either
	 * checked-close it on success or abandon PG handles without replacing the
	 * original ErrorData. */
	resources = bioseq::pg_utils::invoke_pg_as_cpp([] {
		return static_cast<SymbolCountReadResources*>(
			palloc0(sizeof(SymbolCountReadResources)));
	});
	resources->caller_context = CurrentMemoryContext;
	resources->scratch = bioseq::pg_utils::invoke_pg_as_cpp([] {
		return AllocSetContextCreate(CurrentMemoryContext,
			"bioseq_symcount", ALLOCSET_SMALL_SIZES);
	});
	resources->caches = bioseq::pg_utils::invoke_pg_as_cpp(
		[resources] {
			return bioseq::storage::alloc_seq_caches(resources->scratch);
		});
	resources->caches->side = bioseq::storage::seq_caches::Side::Read;
	resources->caches->lock_mode = AccessShareLock;
	resources->caches->read_state_mctx = resources->scratch;
	resources->caches->main_database_oid = rid.db_oid;
	resources->caches->main_tablespace_oid = rid.tablespace_oid;
	resources->caches->main_relfilenode = rid.relfilenode;

	auto* vals = bioseq::pg_utils::invoke_pg_as_cpp([resources, td] {
		return static_cast<Datum*>(MemoryContextAllocZero(
			resources->scratch,
			sizeof(Datum) * static_cast<std::size_t>(td->natts)));
	});
	auto* nulls = bioseq::pg_utils::invoke_pg_as_cpp([resources, td] {
		return static_cast<bool*>(MemoryContextAllocZero(
			resources->scratch,
			sizeof(bool) * static_cast<std::size_t>(td->natts)));
	});
		/* Project every distinct site column and keep the transient List plus
		 * direct read state inside scratch. Catch restores caller_context if an
		 * ereport jumps over this explicit context switch. */
		MemoryContext previous_context =
			bioseq::pg_utils::invoke_pg_as_cpp([resources] {
				return MemoryContextSwitchTo(resources->scratch);
			});
		List* projected = bioseq::pg_utils::invoke_pg_as_cpp([&consts] {
			List* result = NIL;
			for (auto& site : consts.symbol_count_sites) {
				if (site.placeholder != nullptr
					&& !list_member_int(result, site.column_attno)) {
					result = lappend_int(result, site.column_attno);
				}
			}
			return result;
		});
		resources->row_read_state = bioseq::pg_utils::invoke_pg_as_cpp(
			[&] {
				return BioseqColumnBeginRead(
					main, td, projected, NIL, resources->scratch,
					registered_snapshot,
					/*randomAccess=*/true, nullptr);
			});
		bioseq::pg_utils::invoke_pg_as_cpp([previous_context] {
			MemoryContextSwitchTo(previous_context);
		});
		const bool row_ok = bioseq::pg_utils::invoke_pg_as_cpp([&] {
			return BioseqColumnReadRowByRowNumber(
				resources->row_read_state, static_cast<uint64_t>(rowno),
				vals, nulls);
		});
		/* vals contains by-reference Datums owned by row_read_state's
		 * stripeReadContext.  Keep the reader alive until every symbol-count
		 * site has detoasted/consumed those values; the unified release below
		 * ends it on both success and ERROR. */

		for (auto& site : consts.symbol_count_sites) {
			if (site.placeholder == nullptr) continue;
			if (!row_ok || site.rank < 0 || nulls[site.column_attno - 1]) {
				site.placeholder->constisnull = true;
				continue;
			}
			MemoryContext old = bioseq::pg_utils::invoke_pg_as_cpp(
				[resources] {
					return MemoryContextSwitchTo(resources->scratch);
				});
			bioseq::pg_types::seq* hdr =
				bioseq::pg_utils::invoke_pg_as_cpp(
					[vals, column_attno = site.column_attno] {
						return reinterpret_cast<bioseq::pg_types::seq*>(
							PG_DETOAST_DATUM(vals[column_attno - 1]));
					});
			bioseq::pg_utils::invoke_pg_as_cpp(
				[old] { MemoryContextSwitchTo(old); });
			const std::uint8_t alpha = hdr->alphabet_code;
			const bool stub = bioseq::storage::is_locator_stub(hdr);
			const std::uint8_t bw = stub
				? bioseq::storage::logical_storage_unit_byte_width(hdr)
				: hdr->storage_unit_byte_width;
			bioseq::storage::seq_locator loc{};
			if (stub) loc = bioseq::storage::decode_locator_from_stub(hdr);

			/* (2) stored read — the ONLY thing read_sequence_index gates here. */
			std::optional<std::int64_t> stored;
			if (read_sequence_index && stub) {
				auto store = bsi::open_sequence_storage(
						relid, rid.db_oid, rid.tablespace_oid,
						rid.relfilenode, site.column_attno,
						bioseq::indexing::SymbolCountsIndex<
							bsi::IndexStorageSequencePg>::index_name,
						loc, static_cast<uint64_t>(rowno),
						resources->caches, resources->scratch);
				try {
					stored = bioseq::indexing::SymbolCountsIndex<
						bsi::IndexStorageSequencePg>::read_count(
							store, static_cast<std::size_t>(site.rank));
					store.close_checked();
				} catch (...) {
					store.abandon_after_pg_error_noexcept();
					throw;
				}
			}
			if (stored.has_value()) {
				site.placeholder->constvalue =
					bioseq::pg_utils::pg_datum::from(
						static_cast<std::int64_t>(*stored)).raw();
				site.placeholder->constisnull = false;
				continue;
			}

			/* (3) unconditional recompute fallback (never gated by the GUC). */
			std::int64_t cnt = 0;
			bioseq::pg_types::seq::dispatch_instance(
				alpha,
				bw,
				[stub, rid, column_attno = site.column_attno,
				 rank = site.rank, loc, registered_snapshot,
				 caches = resources->caches, scratch = resources->scratch,
				 &cnt, hdr]<class S>() {
				if (stub) {
					using SourceBinding =
						bioseq::storage::postgres_lazy_sequence_binding<S>;
					const SourceBinding source_binding{
						rid.db_oid, rid.tablespace_oid, rid.relfilenode,
						column_attno, loc,
						SourceBinding::expected_last_fragment_padding(loc),
						registered_snapshot, caches, scratch};
					bioseq::storage::with_lazy_postgres<S>(
						source_binding, [rank, &cnt](auto lazy_view) {
							auto counts =
								bioseq::indexing::tally_symbol_counts(lazy_view);
							if (static_cast<std::size_t>(rank) < counts.size())
								cnt = counts[rank];
						});
				} else {
					compact_sequence_range<S> range{*hdr};
					auto lazy = bioseq::storage::make_lazy_in_memory(range);
					const auto lazy_view =
						bioseq::storage::as_lazy_sequence_view(lazy);
					auto counts =
						bioseq::indexing::tally_symbol_counts(lazy_view);
					if (static_cast<std::size_t>(rank) < counts.size())
						cnt = counts[rank];
				}
			});
			site.placeholder->constvalue =
				bioseq::pg_utils::pg_datum::from(cnt).raw();
			site.placeholder->constisnull = false;
		}
		release_symbol_count_read_resources_checked(resources);
		bioseq::pg_utils::invoke_pg_as_cpp(
			[resources] { pfree(resources); });
		resources = nullptr;
	} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
		exact_error = error.release_error_data();
	} catch (const std::exception& error) {
		strlcpy(detail,
			error.what() == nullptr ? "std::exception without detail"
				: error.what(),
			sizeof(detail));
		cpp_error = true;
	} catch (...) {
		unknown_cpp_error = true;
	}
	if (exact_error != nullptr || cpp_error || unknown_cpp_error) {
		abandon_symbol_count_read_resources_after_error(resources);
	}
	if (exact_error != nullptr) {
		ReThrowError(exact_error);
	}
	if (cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("bioseq symbol-count read raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	if (unknown_cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("bioseq symbol-count read raised an unknown C++ exception")));
	}
}


static void promote_slice_project_sources(
		BioseqScanState* state, TupleTableSlot* slot,
		MemoryContext result_context,
		const bool allow_locator_passthrough,
		const SliceProjectSourceSlotLayout layout,
		TupleDesc expected_descriptor) {
	BioseqScanRuntime& runtime = bioseq_runtime(state);
	if (!runtime.lazy_source_projection
		|| (runtime.locator_passthrough && !allow_locator_passthrough)) return;
	if (runtime.lazy_source_provider == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqSliceProject source provider is not initialized")));
	}
	if (slot == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqSliceProject source slot is unavailable")));
	}
	slot_getallattrs(slot);
	const Oid seq_oid = get_cached_stub_oids().bioseq_seq_type_oid;
	if (result_context == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqSliceProject result context is unavailable")));
	}
	TupleDesc actual_descriptor = slot->tts_tupleDescriptor;
	if (actual_descriptor == nullptr || expected_descriptor == nullptr
		|| (actual_descriptor != expected_descriptor
			&& !equalTupleDescs(actual_descriptor, expected_descriptor))) {
		ereport(ERROR,
			(errcode(ERRCODE_DATATYPE_MISMATCH),
			 errmsg("BioseqSliceProject source slot layout changed"),
			 errdetail("layout=%s",
				layout == SliceProjectSourceSlotLayout::physical_relation
					? "physical relation" : "projected child")));
	}
	const std::size_t required_entries = static_cast<std::size_t>(
		actual_descriptor->natts + 1);
	if ((layout == SliceProjectSourceSlotLayout::physical_relation
			&& (runtime.lazy_source_physical_producer_ids.size()
				!= required_entries
				|| runtime.lazy_source_physical_bound.size()
					!= required_entries))
		|| (layout == SliceProjectSourceSlotLayout::projected_child
			&& runtime.lazy_source_projected_bindings.size()
				!= required_entries)) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqSliceProject source binding layout changed")));
	}
	for (int index = 0; index < slot->tts_tupleDescriptor->natts; ++index) {
		const AttrNumber resno = static_cast<AttrNumber>(index + 1);
		std::uint32_t producer_id = 0u;
		AttrNumber column_attno = InvalidAttrNumber;
		bool bound = false;
		if (layout == SliceProjectSourceSlotLayout::physical_relation) {
			bound = runtime.lazy_source_physical_bound[resno] != 0u;
			producer_id = runtime.lazy_source_physical_producer_ids[resno];
			column_attno = resno;
		} else {
			auto const& binding =
				runtime.lazy_source_projected_bindings[resno];
			bound = binding.physical_attno != InvalidAttrNumber;
			producer_id = binding.producer_id;
			column_attno = binding.physical_attno;
		}
		if (!bound) continue;
		if (TupleDescAttr(actual_descriptor, index)->atttypid != seq_oid) {
			ereport(ERROR,
				(errcode(ERRCODE_DATATYPE_MISMATCH),
				 errmsg("BioseqSliceProject bound source is not a sequence"),
				 errdetail("layout_attribute=%d physical_attribute=%d",
					static_cast<int>(resno),
					static_cast<int>(column_attno))));
		}
		if (slot->tts_isnull[index]) continue;
		Datum source = slot->tts_values[index];
		if (VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(source))) {
			if (producer_id != 0u
				&& runtime.lazy_trace_attachment != nullptr
				&& runtime.lazy_trace_attachment->runtime != nullptr
				&& runtime.lazy_trace_attachment->runtime->collection_enabled
				&& !attach_slice_trace_provenance(
					source, runtime.lazy_trace_attachment, producer_id)) {
				ereport(ERROR,
					(errcode(ERRCODE_DATA_CORRUPTED),
					 errmsg("BioseqSliceProject expanded source lost provenance")));
			}
			continue;
		}
		auto* value = reinterpret_cast<const bioseq::pg_types::seq*>(
			DatumGetPointer(source));
		if (!bioseq::storage::is_locator_stub(value)) {
			/* A small inline sequence has no EOH metadata field on which to keep
			 * the planned producer identity.  Under ANALYZE only, adopt that flat
			 * value once into the row context and attach observation metadata before
			 * the lazy expression runs.  The backing copy is a real source-adoption
			 * allocation (and remains visible to the allocator probe); it is not a
			 * SliceProject slot-publication materialization. */
			if (producer_id == 0u
				|| runtime.lazy_trace_attachment == nullptr
				|| runtime.lazy_trace_attachment->runtime == nullptr
				|| !runtime.lazy_trace_attachment->runtime->collection_enabled) {
				continue;
			}
			MemoryContext previous = MemoryContextSwitchTo(result_context);
			try {
				source = bioseq::pg_utils::invoke_pg_as_cpp(
					[source, trace = runtime.lazy_trace_attachment,
					 producer_id] {
						auto adopted = acquire_writable_pg_sequence(
							source, trace, producer_id);
						return MakeExpandedObjectReadOnly(
							pg_sequence_rw_datum(adopted.value), false, -1);
					});
				MemoryContextSwitchTo(previous);
			} catch (...) {
				MemoryContextSwitchTo(previous);
				throw;
			}
			slot->tts_values[index] = source;
			continue;
		}
		if (column_attno <= 0) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("BioseqSliceProject locator lost its physical column"),
				 errdetail("result_attribute=%d", static_cast<int>(resno))));
		}
		slot->tts_values[index] =
			bioseq::storage::promote_pg_sequence_locator(
				runtime.lazy_source_provider, column_attno, source, result_context,
				runtime.lazy_trace_attachment, producer_id);
	}
}

enum class MmsearchSourceCaptureRole : std::uint8_t {
	evaluated_operand,
	output_projection,
};

struct MmsearchSourceRestoreEntry {
	AttrNumber attno = InvalidAttrNumber;
	Datum datum{};
};

/* Four physical sources cover the ordinary target/query/output case without
 * a per-MatchResult allocation.  Wider projections spill into the executor
 * per-tuple MemoryContext, which PostgreSQL releases even when ERROR skips C++
 * destructors.  The object is populated before PG_TRY and never mutated in
 * its setjmp region, so either storage form is safe to read from PG_CATCH. */
struct MmsearchSourceRestore {
	static constexpr std::size_t inline_capacity = 4u;
	std::array<MmsearchSourceRestoreEntry, inline_capacity> inline_entries{};
	MmsearchSourceRestoreEntry* overflow_entries = nullptr;
	std::size_t count = 0u;

	[[nodiscard]] MmsearchSourceRestoreEntry& entry(
			const std::size_t index) noexcept {
		return overflow_entries == nullptr
			? inline_entries[index] : overflow_entries[index];
	}

	[[nodiscard]] const MmsearchSourceRestoreEntry& entry(
			const std::size_t index) const noexcept {
		return overflow_entries == nullptr
			? inline_entries[index] : overflow_entries[index];
	}
};

static void mark_mmsearch_physical_sequence_source(
		std::vector<std::uint8_t>& roles,
		TupleDesc relation_descriptor,
		const AttrNumber attno,
		const Oid sequence_type_oid) {
	if (relation_descriptor == nullptr) return;
	const int natts = relation_descriptor->natts;
	if (attno == 0) {
		for (int index = 0; index < natts; ++index) {
			Form_pg_attribute attribute = TupleDescAttr(
				relation_descriptor, index);
			if (attribute != nullptr && !attribute->attisdropped
				&& attribute->atttypid == sequence_type_oid) {
				roles[static_cast<std::size_t>(index + 1)] = 1u;
			}
		}
		return;
	}
	if (attno <= 0 || attno > natts) return;
	Form_pg_attribute attribute = TupleDescAttr(
		relation_descriptor, attno - 1);
	if (attribute != nullptr && !attribute->attisdropped
		&& attribute->atttypid == sequence_type_oid) {
		roles[static_cast<std::size_t>(attno)] = 1u;
	}
}

/* Mark physical sequence Vars from one finalized executor expression tree.
 * This mirrors BioseqColumnAttrNeeded's Var/whole-row rules, but records only
 * sequence columns and keeps the lifetime role separate from read demand. */
static void mark_mmsearch_sequence_sources_from_expression(
		std::vector<std::uint8_t>& roles,
		TupleDesc relation_descriptor,
		Node* expression,
		const Oid sequence_type_oid) {
	if (expression == nullptr) return;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* variables = pull_var_clause(expression, pull_flags);
	for (Var* variable : PList<Var>(variables)) {
		if (variable != nullptr) mark_mmsearch_physical_sequence_source(
			roles, relation_descriptor, variable->varattno,
			sequence_type_oid);
	}
	list_free(variables);
}

/* Derive timing from the final executor trees, not the broader BSS3 provider
 * tag.  newtargetlist is the exact per-MatchResult projection after helper
 * injection; plan.qual is the executable residual frontier.  Operand lineage
 * is added because evaluated submission executes both operand ExprStates even
 * when only one side is syntactically transformed. */
static void derive_mmsearch_source_lifetime_roles(
		BioseqScanRuntime& runtime,
		Plan* plan,
		TupleDesc relation_descriptor) {
	runtime.mmsearch_pre_eval_sources_present = false;
	if (relation_descriptor == nullptr) return;
	const std::size_t role_count = static_cast<std::size_t>(
		relation_descriptor->natts + 1);
	runtime.mmsearch_pre_eval_source_bound.assign(role_count, 0u);
	runtime.mmsearch_output_source_bound.assign(role_count, 0u);
	const Oid sequence_type_oid = get_cached_stub_oids().bioseq_seq_type_oid;
	mark_mmsearch_sequence_sources_from_expression(
		runtime.mmsearch_output_source_bound,
		relation_descriptor,
		reinterpret_cast<Node*>(runtime.newtargetlist),
		sequence_type_oid);
	if (plan != nullptr) mark_mmsearch_sequence_sources_from_expression(
		runtime.mmsearch_pre_eval_source_bound,
		relation_descriptor,
		reinterpret_cast<Node*>(plan->qual),
		sequence_type_oid);
	if (runtime.match_evaluated_submission) {
		for (Var* source : PList<Var>(runtime.match_target_lineage)) {
			if (source != nullptr) mark_mmsearch_physical_sequence_source(
				runtime.mmsearch_pre_eval_source_bound,
				relation_descriptor, source->varattno, sequence_type_oid);
		}
		if (runtime.match_query_evaluated) {
			for (Var* source : PList<Var>(runtime.match_query_lineage)) {
				if (source != nullptr) mark_mmsearch_physical_sequence_source(
					runtime.mmsearch_pre_eval_source_bound,
					relation_descriptor, source->varattno, sequence_type_oid);
			}
		}
	}
	runtime.mmsearch_pre_eval_sources_present = std::any_of(
		runtime.mmsearch_pre_eval_source_bound.begin(),
		runtime.mmsearch_pre_eval_source_bound.end(),
		[](const std::uint8_t bound) { return bound != 0u; });
}

[[nodiscard]] static bool mmsearch_source_matches_capture_role(
		const BioseqScanRuntime& runtime,
		const AttrNumber attno,
		const MmsearchSourceCaptureRole role) noexcept {
	const auto& roles = role == MmsearchSourceCaptureRole::output_projection
		? runtime.mmsearch_output_source_bound
		: runtime.mmsearch_pre_eval_source_bound;
	const std::size_t index = static_cast<std::size_t>(attno);
	return index < roles.size() && roles[index] != 0u;
}

/* Capture each physical attribute at most once.  Iterating the slot's attno
 * namespace forms the exact union required by the role: evaluated operand
 * leaves before ExprState execution, or finalized output-projection sources
 * before per-MatchResult projection. */
[[nodiscard]] static MmsearchSourceRestore capture_mmsearch_sources(
		BioseqScanRuntime& runtime,
		TupleTableSlot* slot,
		MemoryContext restore_context,
		const MmsearchSourceCaptureRole role) {
	MmsearchSourceRestore restore{};
	if (runtime.lazy_source_provider == nullptr || slot == nullptr
		|| slot->tts_tupleDescriptor == nullptr
		|| restore_context == nullptr) return restore;
	slot_getallattrs(slot);
	const int natts = slot->tts_tupleDescriptor->natts;
	std::size_t count = 0u;
	for (int index = 0; index < natts; ++index) {
		const AttrNumber attno = static_cast<AttrNumber>(index + 1);
		if (!slot->tts_isnull[index]
			&& mmsearch_source_matches_capture_role(runtime, attno, role)) {
			++count;
		}
	}
	if (count == 0u) return restore;
	restore.count = count;
	if (count > MmsearchSourceRestore::inline_capacity) {
		restore.overflow_entries = static_cast<MmsearchSourceRestoreEntry*>(
			MemoryContextAlloc(
				restore_context,
				count * sizeof(MmsearchSourceRestoreEntry)));
	}
	std::size_t captured = 0u;
	for (int index = 0; index < natts; ++index) {
		const AttrNumber attno = static_cast<AttrNumber>(index + 1);
		if (slot->tts_isnull[index]
			|| !mmsearch_source_matches_capture_role(runtime, attno, role)) {
			continue;
		}
		restore.entry(captured) = MmsearchSourceRestoreEntry{
			.attno = attno,
			.datum = slot->tts_values[index],
		};
		++captured;
	}
	return restore;
}

[[nodiscard]] static std::size_t promote_mmsearch_sources(
		BioseqScanRuntime& runtime,
		TupleTableSlot* slot,
		MemoryContext output_context,
		const MmsearchSourceRestore& restore) {
	if (runtime.lazy_source_provider == nullptr || slot == nullptr
		|| output_context == nullptr) {
		return 0u;
	}
	std::size_t promoted_count = 0u;
	for (std::size_t index = 0u; index < restore.count; ++index) {
		const AttrNumber attno = restore.entry(index).attno;
		if (attno <= 0 || attno > slot->tts_tupleDescriptor->natts) continue;
		const Datum source = restore.entry(index).datum;
		if (VARATT_IS_EXTERNAL_EXPANDED(DatumGetPointer(source))) continue;

		/* ExecCopySlotMinimalTuple may short-pack this STORAGE=extended value.
		 * Promotion and the locator ABI require the ordinary four-byte varlena
		 * header, so detoast in the output lifetime before inspecting it. */
		MemoryContext previous = MemoryContextSwitchTo(output_context);
		bioseq::pg_types::seq* flat = nullptr;
		try {
			flat = reinterpret_cast<bioseq::pg_types::seq*>(PG_DETOAST_DATUM(source));
			MemoryContextSwitchTo(previous);
		} catch (...) {
			MemoryContextSwitchTo(previous);
			throw;
		}
		if (static_cast<std::size_t>(VARSIZE(flat)) < bioseq::pg_types::seq::header_bytes()) {
			ereport(ERROR,
				(errcode(ERRCODE_DATA_CORRUPTED),
				 errmsg("buffered bioseq output source is truncated"),
				 errdetail("attribute=%d bytes=%zu",
					static_cast<int>(attno),
					static_cast<std::size_t>(VARSIZE(flat)))));
		}
		if (!bioseq::storage::is_locator_stub(flat)) continue;
		std::uint32_t producer_id = 0u;
		slice_trace_attachment* trace_attachment = nullptr;
		if (runtime.lazy_source_projection) {
			const std::size_t binding_index = static_cast<std::size_t>(attno);
			if (binding_index < runtime.lazy_source_physical_bound.size()
				&& binding_index
					< runtime.lazy_source_physical_producer_ids.size()
				&& runtime.lazy_source_physical_bound[binding_index] != 0u) {
				trace_attachment = runtime.lazy_trace_attachment;
				producer_id =
					runtime.lazy_source_physical_producer_ids[binding_index];
			}
		}
		slot->tts_values[attno - 1] =
			bioseq::storage::promote_pg_sequence_locator(
				runtime.lazy_source_provider,
				attno,
				PointerGetDatum(flat),
				output_context,
				trace_attachment,
				producer_id);
		++promoted_count;
	}
	return promoted_count;
}

static void restore_mmsearch_sources(
		TupleTableSlot* slot,
		const MmsearchSourceRestore& restore) noexcept {
	if (slot == nullptr) return;
	for (std::size_t index = 0u; index < restore.count; ++index) {
		const AttrNumber attno = restore.entry(index).attno;
		if (attno > 0 && attno <= slot->tts_tupleDescriptor->natts) {
			slot->tts_values[attno - 1] = restore.entry(index).datum;
		}
	}
}

[[nodiscard]] static bool mmsearch_sources_restored_exactly(
		TupleTableSlot* slot,
		const MmsearchSourceRestore& restore) noexcept {
	if (slot == nullptr || slot->tts_tupleDescriptor == nullptr) {
		return restore.count == 0u;
	}
	for (std::size_t index = 0u; index < restore.count; ++index) {
		const AttrNumber attno = restore.entry(index).attno;
		if (attno <= 0 || attno > slot->tts_tupleDescriptor->natts
			|| slot->tts_values[attno - 1]
				!= restore.entry(index).datum) {
			return false;
		}
	}
	return true;
}

struct MmsearchRowEvaluation {
	bool qual_passed = false;
	Datum target{};
	bool target_is_null = true;
	Datum query{};
	bool query_is_null = true;
};

/* Evaluate the residual frontier and, when configured, both mmsearch operand
 * ExprStates while only their physical sources are promoted.  The scan slot is
 * restored on normal completion, C++ unwind, and PostgreSQL longjmp before a
 * caller can buffer it. */
[[nodiscard]] static MmsearchRowEvaluation evaluate_mmsearch_input_row(
		BioseqScanRuntime& runtime,
		TupleTableSlot* slot,
		ExprState* qual,
		ExprContext* expression_context) {
	MmsearchRowEvaluation result{};
	if (!runtime.match_evaluated_submission
		&& !runtime.mmsearch_pre_eval_sources_present) {
		result.qual_passed = qual == nullptr
			|| ExecQual(qual, expression_context);
		return result;
	}
	const MmsearchSourceRestore source_restore = capture_mmsearch_sources(
		runtime,
		slot,
		expression_context->ecxt_per_tuple_memory,
		MmsearchSourceCaptureRole::evaluated_operand);
	if (source_restore.count == 0u && !runtime.match_evaluated_submission) {
		result.qual_passed = qual == nullptr
			|| ExecQual(qual, expression_context);
		return result;
	}
	MemoryContext saved_context = CurrentMemoryContext;
	ErrorData* exact_pg_error = nullptr;
	{
		std::exception_ptr cpp_error;
		ErrorData* volatile pg_error = nullptr;
		PG_TRY();
		{
			try {
				(void)promote_mmsearch_sources(
					runtime,
					slot,
					expression_context->ecxt_per_tuple_memory,
					source_restore);
				result.qual_passed = qual == nullptr
					|| ExecQual(qual, expression_context);
				if (result.qual_passed && runtime.match_evaluated_submission) {
					if (runtime.match_target_expr_state == nullptr) {
						ereport(ERROR,
							(errcode(ERRCODE_DATA_CORRUPTED),
							 errmsg("BioseqScan evaluated target ExprState is missing")));
					}
					result.target = ExecEvalExprSwitchContext(
						runtime.match_target_expr_state,
						expression_context,
						&result.target_is_null);
					if (runtime.match_query_evaluated) {
						if (runtime.match_query_expr_state == nullptr) {
							ereport(ERROR,
								(errcode(ERRCODE_DATA_CORRUPTED),
								 errmsg("BioseqScan evaluated query ExprState is missing")));
						}
						/* Preserve SQL argument order even when the target is NULL. */
						result.query = ExecEvalExprSwitchContext(
							runtime.match_query_expr_state,
							expression_context,
							&result.query_is_null);
					}
				}
				restore_mmsearch_sources(slot, source_restore);
			} catch (...) {
				MemoryContextSwitchTo(saved_context);
				restore_mmsearch_sources(slot, source_restore);
				cpp_error = std::current_exception();
			}
		}
		PG_CATCH();
		{
			MemoryContextSwitchTo(saved_context);
			restore_mmsearch_sources(slot, source_restore);
			pg_error = CopyErrorData();
			FlushErrorState();
		}
		PG_END_TRY();
		if (pg_error != nullptr) exact_pg_error = pg_error;
		if (cpp_error != nullptr) std::rethrow_exception(cpp_error);
	}
	/* Re-enter PostgreSQL only after std::exception_ptr has been destroyed. */
	if (exact_pg_error != nullptr) ReThrowError(exact_pg_error);
	return result;
}

	/*
	 * VectorAgg consumes one VectorColumn pointer per projected attribute.
	 * The ordinary scan path extracts scalar rows, so build a projected
	 * vector batch explicitly when the planner attached VectorAgg.
	 */
	static TupleTableSlot *
	NextVectorizedAggregateBatch(BioseqScanState *bioseqScanState,
				   ExecScanAccessMtd accessMtd,
				   ExecScanRecheckMtd recheckMtd)
	{
		ScanState *node = reinterpret_cast<ScanState *>(
			&bioseqScanState->custom_scanstate.ss);
		BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);
		ExprContext *econtext = node->ps.ps_ExprContext;
		ExprState *qual = node->ps.qual;
		TupleTableSlot *result_slot =
			bioseqScanState->vectorization.resultVectorSlot;
		auto *result_vector =
			reinterpret_cast<VectorTupleTableSlot *>(result_slot);
		TupleTableSlot *scalar_scan_slot = node->ss_ScanTupleSlot;
		const bool projects_attributes =
			result_slot->tts_tupleDescriptor->natts != 0;
		ProjectionInfo *projection = projects_attributes
			? ExecBuildProjectionInfo(
				runtime.newtargetlist,
				econtext,
				node->ps.ps_ResultTupleSlot,
				&node->ps,
				scalar_scan_slot->tts_tupleDescriptor)
			: nullptr;

		for (;;)
		{
			TupleTableSlot *slot =
				ExecScanFetch(node, accessMtd, recheckMtd);
			if (TupIsNull(slot))
			{
				runtime.source_exhausted = true;
				return ExecClearTuple(result_slot);
			}
			if (!IsVectorTupleTableSlot(slot))
			{
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("VectorAgg input is not a vector tuple slot")));
			}

			auto *scan_vector =
				reinterpret_cast<VectorTupleTableSlot *>(slot);
			if (bioseqScanState->vectorization.vectorizedQualList != NULL)
			{
				if (bioseqScanState->vectorization.constructedVectorizedQualList
					== NULL)
				{
					bioseqScanState->vectorization.constructedVectorizedQualList =
						ConstructVectorizedQualList(
							slot,
							bioseqScanState->vectorization.vectorizedQualList);
				}
				bool *result_qual = ExecuteVectorizedQual(
					slot,
					bioseqScanState->vectorization.constructedVectorizedQualList,
					AND_EXPR,
					econtext);
				memcpy(
					scan_vector->keep,
					result_qual,
					scan_vector->dimension * sizeof(bool));
			}

			std::uint32_t result_dimension = 0;
			for (std::uint32_t row_index = 0;
				 row_index < scan_vector->dimension;
				 ++row_index)
			{
				if (!scan_vector->keep[row_index])
					continue;

				ResetExprContext(econtext);
				ExecClearTuple(scalar_scan_slot);
				ExtractTupleFromVectorSlot(
					scalar_scan_slot,
					scan_vector,
					static_cast<std::int32_t>(row_index),
					bioseqScanState->vectorization.attrNeededList);
				scalar_scan_slot->tts_tid =
					row_number_to_tid(scan_vector->rowNumber[row_index]);
				econtext->ecxt_scantuple = scalar_scan_slot;

				if (qual != nullptr && !ExecQual(qual, econtext))
				{
					InstrCountFiltered1(node, 1);
					continue;
				}

				if (projects_attributes)
				{
					TupleTableSlot *projected = ExecProject(projection);
					WriteTupleToVectorSlot(
						projected,
						result_vector,
						static_cast<std::int32_t>(result_dimension));
				}
				++result_dimension;
			}

			bioseqScanState->vectorization.vectorPendingRowNumber = 0;
			bioseqScanState->vectorization.vectorRowIndex =
				scan_vector->dimension;
			if (result_dimension == 0)
				continue;

			result_vector->dimension = result_dimension;
			memset(result_vector->keep, true, result_dimension);
			ExecStoreVirtualTuple(result_slot);
			return result_slot;
		}
	}

	static TupleTableSlot *
	Inner_CustomExecScan(BioseqScanState *bioseqScanState,
			   ExecScanAccessMtd accessMtd,
			   ExecScanRecheckMtd recheckMtd)
{
	bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() entered");
	ExprContext *econtext;
	ExprState  *qual;

	ScanState *node = reinterpret_cast<ScanState *>(&bioseqScanState->custom_scanstate.ss);
	BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);

	qual     = node->ps.qual;
	econtext = node->ps.ps_ExprContext;

	if (bioseqScanState->vectorization.vectorizationAggregate)
	{
		ExecClearTuple(bioseqScanState->vectorization.resultVectorSlot);
		return NextVectorizedAggregateBatch(
			bioseqScanState, accessMtd, recheckMtd);
	}

	/*
	 * Two-phase state machine:
	 *
	 *   Phase 1 (writing): pull tuples from the access method, run qual,
	 *                      buffer passing tuples via buffer.submit_scan.
	 *                      When source is exhausted, run batch processor
	 *                      and transition.
	 *   Phase 2 (reading): drain buffered output entries, setting
	 *                      placeholder const nodes from MatchResults and
	 *                      projecting via ExecProject.
	 *
	 * buffer.has_finished_writing() flips from false → true at the
	 * transition.
	 */
	for (;;)
	{
		/* ---- Phase 2: drain buffered output ---- */
		if (runtime.buffer.has_finished_writing())
		{
			bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() draining output cursor");
			/* The parent has consumed the previously returned result before it
			 * invokes this scan again.  Drop that tuple-visible EOH first, then
			 * release every detoasted locator and source-backed output allocated
			 * in the ordinary executor per-tuple context.  Buffered MinimalTuple
			 * slots and MatchResults have independent lifetimes. */
			ExecClearTuple(node->ps.ps_ResultTupleSlot);
			ResetExprContext(econtext);
			econtext->ecxt_scantuple = nullptr;
			econtext->ecxt_outertuple = nullptr;
			econtext->ecxt_innertuple = nullptr;
			auto next = runtime.buffer.read_next_output();
			if (!next)
			{
				if (runtime.source_exhausted) {
					bioseq::pg::alignment_execution::
						mark_alignment_pass_fully_drained(
							runtime.alignment_registration);
					bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() final output cursor drained; returning empty slot (EOF)");
					return ExecClearTuple(node->ps.ps_ResultTupleSlot);
				}
				/* A capacity rollover completed. Drop only that physical
				 * batch and resume the still-live access-method scan. */
				runtime.buffer.clear_slots();
				continue;
			}
			bioseq::storage::note_mmsearch_output_context_reset_for_test();

			if (runtime.edit_predicate_active
				&& (runtime.edit_exclusive_upper_bound <= 0
					|| next->match->edit_distance
						>= static_cast<std::uint64_t>(
							runtime.edit_exclusive_upper_bound))) {
				/* SneakySnake is only a lower-bound gate.  Every survivor is
				 * aligned, and this exact comparison is the authoritative SQL
				 * predicate (strict `<`, including the boundary case). */
				InstrCountFiltered1(node, 1);
				continue;
			}

			/*
			 * Update every placeholder Const from the MatchResult. The
			 * subsequent ExecProject reads the current constvalue of
			 * every Const node referenced in newtargetlist.
			 */
			populate_placeholder_consts(runtime.placeholder_consts, *next->match);

			/*
			 * symbol_count placeholders are independent of MatchResult;
			 * they are resolved from meta_sidecar by (relid, rowno) so
			 * we populate them alongside the per-match fields.
			 */
			populate_symbol_count_placeholders(runtime.placeholder_consts,
											   node->ss_currentRelation,
											   next->sequence_rowno,
											   bioseqScanState->snapshot,
											   runtime.aligner_state.
												   read_sequence_index);

			/* The alignment path retains locator stubs in its buffered row. Promote
			 * only for this output projection, then restore the stable locator so a
			 * second match from the same row never points into a reset per-tuple
			 * context. */
			const MmsearchSourceRestore source_restore =
				capture_mmsearch_sources(
					runtime,
					next->scan_slot_copy,
					econtext->ecxt_per_tuple_memory,
					MmsearchSourceCaptureRole::output_projection);
			TupleTableSlot* projected = nullptr;
			std::exception_ptr projection_error;
			MemoryContext saved_context = CurrentMemoryContext;
			ErrorData* volatile projection_pg_error = nullptr;

			/* PostgreSQL ERROR skips C++ destructors. Keep the immutable restore
			 * snapshot outside the setjmp region and restore the locator slot on
			 * normal return, C++ unwind, and PG longjmp alike. */
			PG_TRY();
			{
				try {
					const std::size_t promoted_source_count =
						promote_mmsearch_sources(
							runtime,
							next->scan_slot_copy,
							econtext->ecxt_per_tuple_memory,
							source_restore);
					bioseq::storage::
						note_mmsearch_output_locator_promotion_for_test(
							promoted_source_count != 0u);
					bioseq::storage::
						inject_mmsearch_output_after_promotion_failure_for_test();

					/* Re-install the buffered scan slot as the current scan
					 * tuple so Var references resolve off the right row. */
					econtext->ecxt_scantuple = next->scan_slot_copy;

					ProjectionInfo* proj = ExecBuildProjectionInfo(
						runtime.newtargetlist,
						econtext,
						node->ps.ps_ResultTupleSlot,
						&(node->ps),
						next->scan_slot_copy->tts_tupleDescriptor);
					projected = ExecProject(proj);
					restore_mmsearch_sources(
						next->scan_slot_copy, source_restore);
				} catch (...) {
					MemoryContextSwitchTo(saved_context);
					restore_mmsearch_sources(
						next->scan_slot_copy, source_restore);
					projection_error = std::current_exception();
				}
			}
			PG_CATCH();
			{
				MemoryContextSwitchTo(saved_context);
				restore_mmsearch_sources(
					next->scan_slot_copy, source_restore);
				bioseq::storage::
					note_mmsearch_output_pg_error_restore_for_test(
						mmsearch_sources_restored_exactly(
							next->scan_slot_copy, source_restore));
				projection_pg_error = CopyErrorData();
				FlushErrorState();
			}
			PG_END_TRY();
			if (projection_pg_error != nullptr) {
				ErrorData* exact_error = projection_pg_error;
				throw bioseq::pg_utils::PostgresErrorAsCpp{exact_error};
			}
			if (projection_error != nullptr) {
				std::rethrow_exception(projection_error);
			}
			return projected;
		}

		/* ---- Phase 1: writing ---- */
		TupleTableSlot *slot = NULL;

		/*
		 * Scalar fetch path: pull one scan tuple and run qual on it.
		 */
		if (!bioseqScanState->vectorization.vectorizationEnabled)
		{
			bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() scalar fetch via ExecScanFetch");
			slot = ExecScanFetch(node, accessMtd, recheckMtd);

				if (TupIsNull(slot))
				{
					runtime.source_exhausted = true;
					bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() source exhausted; running batch processor");
				if (runtime.buffer.run_batch_and_build_cursors()) {
					bioseq::pg::alignment_execution::merge_alignment_batch(
						runtime.alignment_registration,
						runtime.buffer.execution_stats());
				}
				continue; /* Next iteration enters Phase 2. */
			}
		}
		/*
		 * Vectorized fetch path: pull a vector slot, apply vectorized
		 * qual mask, then extract a single scalar tuple per iteration
		 * until the vector is exhausted.
		 */
		else
		{
			/*
			 * First vector pull or after previous vector drained.
			 */
			if (bioseqScanState->vectorization.vectorPendingRowNumber == 0)
			{
				bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() vectorized fetch (initial vector pull)");
				slot = ExecScanFetch(node, accessMtd, recheckMtd);

					if (TupIsNull(slot))
					{
						runtime.source_exhausted = true;
						bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() vectorized source exhausted; running batch processor");
					if (runtime.buffer.run_batch_and_build_cursors()) {
						bioseq::pg::alignment_execution::merge_alignment_batch(
							runtime.alignment_registration,
							runtime.buffer.execution_stats());
					}
					continue;
				}

				if (bioseqScanState->vectorization.vectorizedQualList != NULL)
				{
					if (bioseqScanState->vectorization.constructedVectorizedQualList == NULL)
					{
						bioseqScanState->vectorization.constructedVectorizedQualList =
							ConstructVectorizedQualList(slot, bioseqScanState->vectorization.vectorizedQualList);
					}

					VectorTupleTableSlot *vectorSlot = reinterpret_cast<VectorTupleTableSlot *>(slot);
					bool *resultQual = ExecuteVectorizedQual(
						slot,
						bioseqScanState->vectorization.constructedVectorizedQualList,
						AND_EXPR, econtext);
					memcpy(vectorSlot->keep, resultQual, BIOSEQ_COLUMN_VECTOR_COLUMN_SIZE);
				}
			}

			/*
			 * Extract one kept row from the vector slot into the scalar
			 * scan slot. Skip entries where keep[i] is false.
			 */
			bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() vectorized extraction");
			VectorTupleTableSlot *vectorSlot = reinterpret_cast<VectorTupleTableSlot *>(
				bioseqScanState->vectorization.scanVectorSlot);

			bool rowFound = false;
			while (bioseqScanState->vectorization.vectorPendingRowNumber != 0 && !rowFound)
			{
				if (vectorSlot->keep[bioseqScanState->vectorization.vectorRowIndex])
				{
					slot = bioseqScanState->custom_scanstate.ss.ss_ScanTupleSlot;
					ExecClearTuple(slot);
					ExtractTupleFromVectorSlot(slot,
											   vectorSlot,
											   bioseqScanState->vectorization.vectorRowIndex,
											   bioseqScanState->vectorization.attrNeededList);

					uint64_t rowNumber = vectorSlot->rowNumber[bioseqScanState->vectorization.vectorRowIndex];
					slot->tts_tid = row_number_to_tid(rowNumber);
					rowFound = true;
				}
				bioseqScanState->vectorization.vectorPendingRowNumber--;
				bioseqScanState->vectorization.vectorRowIndex++;
			}

			/*
			 * Vector exhausted without finding a kept row: go back to
			 * pull another vector or finalize.
			 */
			if (!rowFound)
				continue;
		}

		/* Every fetched input row owns a fresh expression/root arena.  BSS3
		 * promotion and the authoritative operand ExprStates retain only until
		 * submit_scan_evaluated copies their small EOH wrappers into the batch
		 * arena. */
		ResetExprContext(econtext);
		econtext->ecxt_scantuple = slot;

		/*
		 * DOC0260 §9 — the scan runs with defer_seq_hydration=true, so `slot`
		 * carries 40-byte locator stubs. When there is an mmsearch qual the
		 * row is buffered (submit_scan captures the locator; the batch path
		 * bulk-hydrates per bucket), so we leave the stub in place. Without an
		 * mmsearch qual the row is projected immediately below, so hydrate the
		 * SEQ columns now (force=true overrides the defer flag) — this covers
		 * both the scalar and vectorized convergence and is the analogue of
		 * the inline hydration bioseq_getnextslot performs on non-deferred
		 * scan paths.
		 */
			if (!runtime.buffer.mmsearch_active()
				&& !runtime.locator_passthrough
				&& !runtime.lazy_source_projection) {
				bioseq_hydrate_scan_slot(node->ss_currentScanDesc, slot, /*force=*/true);
			}
			/* A non-mmsearch scan projects immediately and may promote every BSS3
			 * source.  Alignment scans instead retain stable locators in their
			 * buffered row.  Evaluated operand leaves are promoted temporarily at
			 * their ExprState boundary below; output-only sources are promoted once
			 * per MatchResult under the PG_TRY restoration boundary above. */
			if (runtime.lazy_source_projection
				&& !runtime.locator_passthrough
				&& !runtime.buffer.mmsearch_active()) {
				promote_slice_project_sources(
					bioseqScanState, slot,
					econtext->ecxt_per_tuple_memory,
					/*allow_locator_passthrough=*/false,
					SliceProjectSourceSlotLayout::physical_relation,
					slot->tts_tupleDescriptor);
			}

		/*
		 * Place the current tuple into the expr context and run the
		 * non-vectorized qual (e.g. mmsearch()). Both scalar and
		 * vectorized paths converge here.
		 */
		bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() applying qual filter");
		MmsearchRowEvaluation mmsearch_evaluation{};
		bool qual_passed = false;
		if (runtime.buffer.mmsearch_active()) {
			mmsearch_evaluation = evaluate_mmsearch_input_row(
				runtime, econtext->ecxt_scantuple, qual, econtext);
			qual_passed = mmsearch_evaluation.qual_passed;
		} else {
			qual_passed = qual == nullptr || ExecQual(qual, econtext);
		}
		if (qual_passed)
		{
				if (runtime.buffer.mmsearch_active()) {
					bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() qual passed; buffering scan tuple");
					if (runtime.match_evaluated_submission) {
						if (runtime.mmsearch_null_input) continue;
						runtime.buffer.submit_scan_evaluated(
							econtext->ecxt_scantuple,
							mmsearch_evaluation.target,
							mmsearch_evaluation.target_is_null,
							runtime.match_query_evaluated,
							mmsearch_evaluation.query,
							mmsearch_evaluation.query_is_null);
					} else {
						if (runtime.mmsearch_null_input) continue;
						bool target_is_null = false;
						(void)slot_getattr(
							econtext->ecxt_scantuple,
							runtime.match_sequence_attno,
							&target_is_null);
						if (target_is_null) continue;
						runtime.buffer.submit_scan(econtext->ecxt_scantuple);
					}
					if (runtime.buffer.ready_to_dispatch()) {
						if (runtime.buffer.run_batch_and_build_cursors()) {
							bioseq::pg::alignment_execution::merge_alignment_batch(
								runtime.alignment_registration,
								runtime.buffer.execution_stats());
						}
					}
				}
			else {
				if (runtime.mmsearch_null_input) {
					/* A NULL global Const/Param leaves the buffer inactive.  An
					 * evaluated target still has SQL effects and must run once. */
					if (runtime.match_evaluated_submission
						&& runtime.match_target_expr_state != nullptr) {
						bool ignored_null = false;
						(void)ExecEvalExprSwitchContext(
							runtime.match_target_expr_state, econtext,
							&ignored_null);
					}
					continue;
				}
				/*
				 * No WHERE mmsearch(...) qual installed -> there is nothing
				 * to batch. Project the scan tuple to the CustomScan target
				 * list so the output slot layout matches what an outer Result
				 * node expects. PlanCustomPath filters this target list to
				 * plain Vars plus bioseq-owned placeholders; ordinary
				 * expressions such as seq::text and bioseq.len(seq) remain in
				 * the outer Result and evaluate against this projected tuple.
				 */
				bioseq_log<DBG>("[bioseq] pg: Inner_CustomExecScan() qual passed; no mmsearch qual");

				/*
				 * symbol_count fast-path requires the row number; the
				 * access method set it on slot->tts_tid above. Convert
				 * once per projected row rather than stashing a
				 * (relid, rowno) in a shared struct (which was the
				 * anti-pattern this module used to carry).
				 */
				{
					int64_t row_number = -1;
					if (ItemPointerIsValid(&slot->tts_tid)) {
						row_number = static_cast<int64_t>(tid_to_row_number(slot->tts_tid));
					}
					populate_symbol_count_placeholders(runtime.placeholder_consts,
											   node->ss_currentRelation, row_number,
											   bioseqScanState->snapshot,
											   runtime.aligner_state.
												   read_sequence_index);
				}

				ProjectionInfo* proj = ExecBuildProjectionInfo(
					runtime.newtargetlist,
					econtext,
					node->ps.ps_ResultTupleSlot,
					&(node->ps),
					slot->tts_tupleDescriptor);
					TupleTableSlot* projected = ExecProject(proj);
					if (runtime.locator_passthrough) {
						if (!ItemPointerIsValid(&slot->tts_tid)
							|| runtime.locator_rowno_resno <= 0
							|| runtime.locator_rowno_resno
								> projected->tts_tupleDescriptor->natts) {
							ereport(ERROR,
								(errcode(ERRCODE_INTERNAL_ERROR),
								 errmsg("Bioseq locator passthrough row-number projection is invalid")));
						}
						Form_pg_attribute rowno_attribute = TupleDescAttr(
							projected->tts_tupleDescriptor,
							runtime.locator_rowno_resno - 1);
						if (rowno_attribute->atttypid != INT8OID) {
							ereport(ERROR,
								(errcode(ERRCODE_DATATYPE_MISMATCH),
								 errmsg("Bioseq locator passthrough row-number column is not bigint")));
						}
						slot_getallattrs(projected);
						projected->tts_values[
							runtime.locator_rowno_resno - 1] =
							Int64GetDatum(static_cast<std::int64_t>(
								tid_to_row_number(slot->tts_tid)));
						projected->tts_isnull[
							runtime.locator_rowno_resno - 1] = false;
					}
					return projected;
			}
		}
		else
		{
			InstrCountFiltered1(node, 1);
		}
	}
}


static TupleTableSlot *
CustomExecScan(BioseqScanState *bioseqScanState,
			   ExecScanAccessMtd accessMtd,
			   ExecScanRecheckMtd recheckMtd) {

	// Testing custom exec scan
	bioseq_log<DBG>("[bioseq] pg: CustomExecScan() entered");

	ScanState *node = reinterpret_cast<ScanState *>(&bioseqScanState->custom_scanstate.ss);
	PlanState ps = node->ps;
	BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);

	bioseq_log<DBG>("[bioseq] pg: CustomExecScan() reading plan targetlist");
	auto targetlist = ps.plan->targetlist;
	bioseq_log<DBG>("[bioseq] pg: CustomExecScan() targetlist_is_null={}", targetlist == nullptr);
	bioseq_log<DBG>("[bioseq] pg: CustomExecScan() targetlist iteration complete");

	if (runtime.placeholder_consts.dp_score_node == nullptr) {
		bioseq_log<DBG>("[bioseq] pg: CustomExecScan() allocating placeholder const nodes");

		/* INT4: byval, len=4, no collation. Used for the int32_t MatchResult
		 * fields (dp_score, mapq, chain_score, dp_max_score, seed_count,
		 * secondary_chain_score). */
		const auto int_placeholder = []() {
			return makeConst(
				INT4OID,
				-1,
				InvalidOid,
				4,
				static_cast<Datum>(static_cast<int32_t>(0)),
				/*constisnull=*/ true,
				/*constbyval=*/ true
			);
		};
		/* INT8: byval on LP64 (pg_type.typbyval for bigint is 't'), len=8.
		 * Used for the eight sequence_size_t (uint64) coordinate/length
		 * fields (query_len … block_length) so positions in sequences longer
		 * than INT32_MAX are not truncated — DOC0274 §1.8. Matches the SQL
		 * DDL where those eight projections RETURN BIGINT. */
		const auto bigint_placeholder = []() {
			return makeConst(
					INT8OID,
					-1,
					InvalidOid,
					8,
					bioseq::pg_utils::pg_datum::from(static_cast<std::int64_t>(0)).raw(),
					/*constisnull=*/ true,
					/*constbyval=*/ true
				);
		};
		/* BOOL: byval, len=1, no collation. */
		const auto bool_placeholder = []() {
			return makeConst(
					BOOLOID,
					-1,
					InvalidOid,
					1,
					bioseq::pg_utils::pg_datum::from(false).raw(),
					/*constisnull=*/ true,
					/*constbyval=*/ true
				);
		};
		/* FLOAT4: byval, len=4, no collation. */
		const auto float_placeholder = []() {
			return makeConst(
					FLOAT4OID,
					-1,
					InvalidOid,
					4,
					bioseq::pg_utils::pg_datum::from(0.0F).raw(),
					/*constisnull=*/ true,
					/*constbyval=*/ true
				);
		};
		/* TEXT: byref, len=-1 (varlena), default collation. */
		const auto text_placeholder = []() {
			return makeConst(
					TEXTOID,
					-1,
					DEFAULT_COLLATION_OID,
					-1,
					bioseq::pg_utils::pg_datum::from_pointer(nullptr).raw(),
					/*constisnull=*/ true,
					/*constbyval=*/ false
				);
		};

		runtime.placeholder_consts.symbol_count_sites.clear();
		runtime.placeholder_consts.dp_score_node              = int_placeholder();
		runtime.placeholder_consts.query_len_node             = bigint_placeholder();
		runtime.placeholder_consts.query_start_node           = bigint_placeholder();
		runtime.placeholder_consts.query_end_node             = bigint_placeholder();
		runtime.placeholder_consts.target_len_node            = bigint_placeholder();
		runtime.placeholder_consts.target_start_node          = bigint_placeholder();
		runtime.placeholder_consts.target_end_node            = bigint_placeholder();
		runtime.placeholder_consts.num_matches_node           = bigint_placeholder();
		runtime.placeholder_consts.block_length_node          = bigint_placeholder();
		runtime.placeholder_consts.edit_distance_node         = bigint_placeholder();
		runtime.placeholder_consts.mapq_node                  = int_placeholder();
		runtime.placeholder_consts.chain_score_node           = int_placeholder();
		runtime.placeholder_consts.dp_max_score_node          = int_placeholder();
		runtime.placeholder_consts.seed_count_node            = int_placeholder();
		runtime.placeholder_consts.secondary_chain_score_node = int_placeholder();
		runtime.placeholder_consts.is_reverse_node            = bool_placeholder();
		runtime.placeholder_consts.is_primary_node            = bool_placeholder();
		runtime.placeholder_consts.has_cigar_node             = bool_placeholder();
		runtime.placeholder_consts.divergence_node            = float_placeholder();
		runtime.placeholder_consts.cigar_node                 = text_placeholder();

		/*
		 * Reset only the slot buffer; keep the mmsearch_context that
		 * BeginCustomScan configured earlier for this scan.
		 */
		runtime.buffer.clear_slots();

		const BioseqStubOids& oids_snapshot = get_cached_stub_oids();
		VarInjectorCtx injector_ctx;
		injector_ctx.consts           = &runtime.placeholder_consts;
		injector_ctx.oids             = &oids_snapshot;
		injector_ctx.current_relation = bioseqScanState->custom_scanstate.ss.ss_currentRelation;
		injector_ctx.match_sequence_varno = runtime.match_sequence_varno;
		injector_ctx.match_sequence_attno = runtime.match_sequence_attno;
		injector_ctx.match_target_recipe = runtime.match_target_recipe;
		injector_ctx.match_target_lineage = runtime.match_target_lineage;
		injector_ctx.match_helper_sites = runtime.match_helper_sites;
		injector_ctx.stable_match_id = runtime.stable_match_id;

		runtime.newtargetlist = reinterpret_cast<List *>(var_injector(
			reinterpret_cast<Node *>(targetlist),
			&injector_ctx));
		derive_mmsearch_source_lifetime_roles(
			runtime,
			ps.plan,
			bioseqScanState->custom_scanstate.ss.ss_ScanTupleSlot
				->tts_tupleDescriptor);
	}


	bioseq_log<DBG>("[bioseq] pg: CustomExecScan() dispatching to Inner_CustomExecScan");

	auto tupleSlot = Inner_CustomExecScan(bioseqScanState, accessMtd, recheckMtd);
	return tupleSlot;
}


static TupleTableSlot *
BioseqColumnScanNext(BioseqScanState *bioseqScanState)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanNext() entered");
	CustomScanState *node = bioseqScanState->as_custom_scan_state();

	/*
	 * get information from the estate and scan state
	 */
	TableScanDesc scandesc = node->ss.ss_currentScanDesc;
	EState *estate = node->ss.ps.state;
	ScanDirection direction = estate->es_direction;
	bool vectorizationEnabled = bioseqScanState->vectorization.vectorizationEnabled;

	TupleTableSlot *slot = nullptr;

	if (vectorizationEnabled)
		slot = bioseqScanState->vectorization.scanVectorSlot;
	else
		slot = node->ss.ss_ScanTupleSlot;

	if (scandesc != NULL && scandesc->rs_rd == NULL)
	{
		bioseq_log<DBG>("[bioseq] pg: BioseqColumnScanNext() found stale scan descriptor with null relation; reopening");
		node->ss.ss_currentScanDesc = NULL;
		scandesc = NULL;
	}

	if (scandesc == NULL)
	{
		/* the columnar access method does not use the flags, they are specific to heap */
		uint32_t flags = 0;

		/*
		 * We reach here if the scan is not parallel, or if we're serially
		 * executing a scan that was planned to be parallel.
		 */
			BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);
			const bool needs_deferred_hydration =
				(runtime.locator_passthrough
				 || runtime.lazy_source_projection
				 || runtime.buffer.mmsearch_active() || runtime.param_rebind.active)
				&& !runtime.buffer.per_row_self_alignment();

		/*
		 * DOC0260 §8/§9 — the batched mmsearch and locator-passthrough paths
		 * consume locator stubs directly.  A lazy SliceProject source also stays
		 * deferred, then promotes only its bound columns through the owning
		 * provider immediately before projection.  Plain scans may be projected
		 * by an upper Result node, so they use the ordinary table-AM scan and
		 * return fully hydrated bioseq.seq varlenas. Same-column self-alignment
		 * (`mmsearch(seq, seq)`) stays non-deferred: submit_scan can copy the
		 * hydrated value once as both target and per-row query, avoiding the cold
		 * post-load descriptor path while preserving deferred hydration for real
		 * target/query scans.
		 */
		if (needs_deferred_hydration) {
			scandesc = bioseq_beginscan_deferred_c(node->ss.ss_currentRelation,
											 bioseqScanState->snapshot,
											 0, NULL, NULL, flags,
											 bioseqScanState->attrNeeded,
											 bioseqScanState->qual,
											 bioseqScanState->parallelBioseqColumnScan,
												 vectorizationEnabled);
		} else {
			scandesc = bioseq_beginscan_extended_c(node->ss.ss_currentRelation,
											 bioseqScanState->snapshot,
											 0, NULL, NULL, flags,
											 bioseqScanState->attrNeeded,
											 bioseqScanState->qual,
											 bioseqScanState->parallelBioseqColumnScan,
												 vectorizationEnabled);
		}

		node->ss.ss_currentScanDesc = scandesc;
	}

	if (scandesc == NULL || scandesc->rs_rd == NULL)
	{
		ereport(ERROR,
				(errmsg("bioseq: failed to initialize columnar scan descriptor "
						"for relation %u",
						node->ss.ss_currentRelation == nullptr
							? InvalidOid
							: RelationGetRelid(node->ss.ss_currentRelation))));
	}

	if (table_scan_getnextslot(scandesc, direction, slot))
	{
		/*
		* Setup custom scan state for reading tuples directly from stored
		* vector tuple table slot
		*/
		if (vectorizationEnabled)
		{
			bioseqScanState->vectorization.vectorPendingRowNumber =
				reinterpret_cast<VectorTupleTableSlot *>(slot)->dimension;
			bioseqScanState->vectorization.vectorRowIndex = 0;
		}
		return slot;
	}

	return NULL;
}


/*
 * SeqRecheck -- access method routine to recheck a tuple in EvalPlanQual
 */
static bool
BioseqColumnScanRecheck(BioseqScanState *node, TupleTableSlot *slot)
{
	return true;
}


static TupleTableSlot *
BioseqColumnScan_ExecCustomScan(CustomScanState *node)
{
	TupleTableSlot* result = nullptr;
	ErrorData* exact_error = nullptr;
	bool cpp_error = false;
	bool unknown_cpp_error = false;
	char detail[512] = "std::exception without detail";
	try {
		BioseqScanState* state = BioseqScanState::from_custom_scan_state(node);
		BioseqScanRuntime& runtime = bioseq_runtime(state);
		if (runtime.mmsearch_null_input
			&& !runtime.match_evaluated_submission) {
			/* A raw target with a NULL owned query is statement-empty.  An
			 * evaluated target must still run once for every residual-admitted row
			 * before strict NULL semantics discard the result, so only the raw
			 * owner may bypass the table scan here. */
			if (runtime.alignment_registration.registered()) {
				bioseq::pg::alignment_execution::
					mark_alignment_pass_fully_drained(
						runtime.alignment_registration);
			}
			return ExecClearTuple(node->ss.ps.ps_ResultTupleSlot);
		}
		bioseq::pg::alignment_execution::ensure_alignment_node_registered(
			runtime.alignment_registration);
		result = CustomExecScan(
			state,
			reinterpret_cast<ExecScanAccessMtd>(BioseqColumnScanNext),
			reinterpret_cast<ExecScanRecheckMtd>(BioseqColumnScanRecheck));
		return result;
	} catch (bioseq::pg_utils::PostgresErrorAsCpp& error) {
		exact_error = error.release_error_data();
	} catch (const std::exception& error) {
		strlcpy(
			detail,
			error.what() == nullptr ? "std::exception without detail" : error.what(),
			sizeof(detail));
		cpp_error = true;
	} catch (...) {
		unknown_cpp_error = true;
	}

	BioseqScanState* state = BioseqScanState::from_custom_scan_state(node);
	if (state != nullptr && state->runtime != nullptr) {
		auto* runtime = static_cast<BioseqScanRuntime*>(state->runtime);
		runtime->buffer.abandon_join_runtime_after_pg_error_noexcept();
	}
	if (exact_error != nullptr) {
		ReThrowError(exact_error);
	}
	if (cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqColumnScan Exec raised a C++ exception"),
			 errdetail_internal("%s", detail)));
	}
	if (unknown_cpp_error) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("BioseqColumnScan Exec raised an unknown C++ exception")));
	}
	return result;
}


static void
BioseqColumnScan_EndCustomScan(CustomScanState *node)
{
	TableScanDesc scanDesc = node->ss.ss_currentScanDesc;
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);

	/*
	 * Profiler summary lives here (not inside the per-batch dispatch
	 * fork) so multi-batch scans emit exactly one block of summary
	 * lines. After dumping, reset_all() clears the persistent
	 * per-process aggregate so the next scan starts with fresh counts.
	 * Part 48.5 / 48.8 of NEW_PROFILING_RESEARCH.md.
	 */
	if (bioseq::aligner::settings::enable_profiling) {
		bioseq::instr::access::write_summary_to_justlog();
		bioseq::instr::access::reset_all();
	}

	/*
	 * Free buffered scan slots HERE, while the per-query ResourceOwner
	 * that pinned their TupleDesc refs is still active. Deferring this
	 * to the next query's init would leak TupleDesc refcounts onto a
	 * dead ResourceOwner and produce
	 *   "WARNING: resource was not closed: TupleDesc ..."
	 * followed by
	 *   "ERROR: tupdesc reference ... is not owned by resource owner Portal"
	 * when the next query tries to release them.
	 *
	 * After clear_slots, free the BioseqScanRuntime itself. Owning the
	 * std::vector / std::map storage on the C++ heap (rather than in a
	 * Postgres MemoryContext) means we have to reach the destructor
	 * here — Postgres' MemoryContext teardown wouldn't run them.
	 */
	if (bioseqScanState->runtime != nullptr) {
		BioseqScanRuntime* runtime_ptr =
			static_cast<BioseqScanRuntime*>(bioseqScanState->runtime);
		/*
		 * Clear MinimalTuple slots while the per-query ResourceOwner
		 * is still alive — Postgres tuple-desc refcounts are tracked
		 * against it. The MemoryContext reset callback fires later
		 * (during es_query_cxt teardown) and is forbidden from
		 * touching slots, so we MUST do this here.
		 *
		 * We deliberately do NOT delete the runtime here. The
		 * MemoryContextCallback struct that bioseq_runtime_cleanup_callback
		 * uses lives inside the runtime; freeing the runtime now would
		 * dangle the callback pointer in es_query_cxt's reset chain
		 * and SIGSEGV on context teardown. The callback handles the
		 * delete safely once the context begins to tear down.
		 */
		/* Drop every tuple-visible reference before resetting the expression
		 * contexts that own promoted EOHs. Result and scan slots may alias in a
		 * projection-free shape, so clear the physical slot exactly once. */
		clear_recipe_scan_parent_tuple_references(node);

		/* Locator promotion uses the ordinary executor ExprContext. The private
		 * runtime context can independently retain evaluated Params, so drain it
		 * too while the exact source provider remains live. */
		ExprContext* expression_context = node->ss.ps.ps_ExprContext;
		if (bioseqScanState->css_RuntimeContext != nullptr
			&& bioseqScanState->css_RuntimeContext != expression_context) {
			ReScanExprContext(bioseqScanState->css_RuntimeContext);
		}

		/* Tuple-visible EOH references are gone; the retained batch arena may
		 * now release its wrappers and source-domain edges. */
		runtime_ptr->buffer.clear_slots();

		if (runtime_ptr->lazy_source_provider != nullptr) {
			bioseq::storage::close_pg_sequence_source_provider(
				runtime_ptr->lazy_source_provider, /*is_commit=*/true);
			runtime_ptr->lazy_source_provider = nullptr;
		}
		runtime_ptr->buffer.clear_sequence_source_provider_binding();
		if (runtime_ptr->lazy_trace_attachment != nullptr) {
			release_slice_trace_attachment(
				runtime_ptr->lazy_trace_attachment);
			runtime_ptr->lazy_trace_attachment = nullptr;
		}
		runtime_ptr->cleanup_done = true;
	}

	/*
	 * Cleanup BMS of selected scan attributes
	 */
	bioseqScanState->attrNeeded.free();

	/* A failed/partial Begin may not have allocated runtime state. */
	if (bioseqScanState->runtime == nullptr) {
		TupleTableSlot* result_slot = node->ss.ps.ps_ResultTupleSlot;
		TupleTableSlot* scan_slot = node->ss.ss_ScanTupleSlot;
		if (result_slot != nullptr) ExecClearTuple(result_slot);
		if (scan_slot != nullptr && scan_slot != result_slot) {
			ExecClearTuple(scan_slot);
		}
	}

	/*
	 * close heap scan
	 */
	if (scanDesc != NULL)
	{
		table_endscan(scanDesc);
		node->ss.ss_currentScanDesc = NULL;
	}

	/* Unregister snapshot */
	if (bioseqScanState->snapshotRegisteredByUs)
	{
		UnregisterSnapshot(bioseqScanState->snapshot);
	}
}


static void
BioseqColumnScan_ReScanCustomScan(CustomScanState *node)
{
	CustomScan *cscan = reinterpret_cast<CustomScan *>(node->ss.ps.plan);
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);
	BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);
	bioseq::pg::alignment_execution::mark_alignment_rescan(
		runtime.alignment_registration);

	clear_recipe_scan_parent_tuple_references(node);
	if (bioseqScanState->css_RuntimeContext
			!= node->ss.ps.ps_ExprContext) {
		ResetExprContext(bioseqScanState->css_RuntimeContext);
	}
	List *allClauses = PList<List>(cscan->custom_exprs).second();
	List *storageClauses = storage_prunable_quals_without_mmsearch(
		allClauses, get_cached_stub_oids());
	bioseqScanState->qual = reinterpret_cast<List *>(eval_params(
		reinterpret_cast<Node *>(storageClauses), bioseqScanState->css_RuntimeContext));

	/*
	 * Drop every buffered tuple, output cursor and match map left over
	 * from the previous scan iteration. Without this, an inner-side
	 * scan that drained its cursor on iteration N would re-enter Phase
	 * 2 immediately on iteration N+1 (because output_position stayed
	 * pointing past the cursor end) and return EOF without ever pulling
	 * a tuple from the access method. ReScan is the natural reset
	 * point: BeginCustomScan only fires once per query, so we cannot
	 * defer this to there.
	 */
	runtime.buffer.clear_slots();
	runtime.source_exhausted = false;

	/*
	 * Param-driven mmsearch rebind: when the planner rewrote the
	 * second mmsearch argument as a Param (parameterized inner-side
	 * scan in a Nested Loop), each rescan needs to install the current
	 * Param value as the new query. The Param lives in the scan
	 * node's PlanState ExprContext (filled by the NL parent before
	 * triggering rescan), so we resolve it via EvalParamsMutator
	 * against a copy of the original FuncExpr argument.
	 *
	 * MmsearchParamRebind retains the exact plan FuncExpr because the copied
	 * storage qual has already folded Params and planner order may put a Const
	 * extra before the Param-driven primary.
	 */
	if (runtime.param_rebind.active)
	{
		/* The stashed FuncExpr identifies the exact primary Param even when
		 * planner qual ordering puts a Const extra first.  NULL clears only
		 * the primary context; BMO v2 rejects NULL Const extras during planning,
		 * while registered non-NULL extras survive for a later non-NULL rescan. */
		(void)resolve_mmsearch_param_query(
			runtime, node->ss.ps.ps_ExprContext,
			"ReScanCustomScan");
	}

	TableScanDesc scanDesc = node->ss.ss_currentScanDesc;

	if (scanDesc != NULL)
	{
		/* XXX: hack to pass quals as scan keys */
		ScanKey scanKeys = reinterpret_cast<ScanKey>(bioseqScanState->qual.ptr());
		table_rescan(node->ss.ss_currentScanDesc,
					 scanKeys);
	}
}


static void
ExplainPrefilterExecutionProof(
	const bioseq::pipeline_stats::PipelineOperationalStats& operational,
	ExplainState* es)
{
	if (!operational.prefilter_execution_proof_present) return;
	const auto& proof = operational.prefilter_execution_proof;
	ExplainPropertyBool("Prefilter Proof Present", true, es);
	ExplainPropertyText(
		"Prefilter Resolved Algorithm", proof.resolved_algorithm_name(), es);
	ExplainPropertyText(
		"Prefilter Resolved Backend", proof.resolved_backend_name(), es);
	ExplainPropertyUInteger(
		"Prefilter Dispatches", nullptr, proof.dispatches, es);
	ExplainPropertyUInteger(
		"Prefilter SneakySnake Dispatches", nullptr,
		proof.sneaky_snake_dispatches, es);
	ExplainPropertyUInteger(
		"Prefilter GateKeeper Dispatches", nullptr,
		proof.gatekeeper_dispatches, es);
	ExplainPropertyUInteger(
		"Prefilter Scalar Dispatches", nullptr, proof.scalar_dispatches, es);
	ExplainPropertyUInteger(
		"Prefilter SIMD Dispatches", nullptr, proof.simd_dispatches, es);
	ExplainPropertyUInteger(
		"Prefilter Vulkan Dispatches", nullptr, proof.vulkan_dispatches, es);
	ExplainPropertyUInteger("Prefilter Jobs", nullptr, proof.jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Evaluated Jobs", nullptr, proof.evaluated_jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Length 64 Jobs", nullptr, proof.length_64_jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Unequal-Length Jobs", nullptr,
		proof.length_difference_jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Unsupported Jobs", nullptr, proof.unsupported_jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Rejected Jobs", nullptr, proof.rejected_jobs, es);
	ExplainPropertyUInteger(
		"Prefilter Rejected Regions", nullptr, proof.rejected_regions, es);
	ExplainPropertyUInteger(
		"Prefilter Surviving Regions", nullptr, proof.surviving_regions, es);
	ExplainPropertyUInteger(
		"Prefilter Mask Rejection Candidates", nullptr,
		proof.mask_rejection_candidates, es);
	ExplainPropertyUInteger(
		"Prefilter Exact Guard Activations", nullptr,
		proof.exact_guard_activations, es);
	ExplainPropertyUInteger(
		"Prefilter Guard Confirmed Rejections", nullptr,
		proof.guard_confirmed_rejections, es);
	ExplainPropertyUInteger(
		"Prefilter Hamming Exact Rejections", nullptr,
		proof.hamming_exact_rejections, es);
	ExplainPropertyBool(
		"Prefilter Proof Saturated", proof.saturated, es);
	ExplainPropertyBool("Prefilter Proof Valid", proof.valid(), es);
}

static void
AppendHighwayTargetNames(
    std::string& destination,
    const std::int64_t mask)
{
    const auto names = bioseq::simd_dispatch::highway_target_names(mask);
    if (names.empty()) {
        destination = "none";
        return;
    }
    for (const std::string_view name : names) {
        if (!destination.empty()) destination += ", ";
        destination.append(name);
    }
}

[[nodiscard]] static std::string
HighwayTargetNames(const std::int64_t mask)
{
    std::string names;
    AppendHighwayTargetNames(names, mask);
    return names.empty() ? std::string{"none"} : names;
}

[[nodiscard]] static std::string
HighwayTargetName(const std::int64_t target)
{
    if (target == 0) return "none";
    const auto names = bioseq::simd_dispatch::highway_target_names(target);
    return names.empty() ? std::string{"none"} : std::string{names.front()};
}

[[nodiscard]] static bioseq::simd_dispatch::HighwayKernelSet
PlannedQueryMinimizerHighwayKernels(
		const bioseq::simd::Minimap2Params* params,
		const bioseq::simd::pipe::QuerySketchPlanRoute query_sketch_route)
{
	if (params == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Highway EXPLAIN has no frozen aligner parameters")));
	}
	const auto resolved =
		bioseq::simd::pipe::planned_query_minimizer_highway_kernels(
			*params, query_sketch_route);
	if (!resolved.has_value()) {
		ereport(ERROR,
			(errcode(ERRCODE_INTERNAL_ERROR),
			 errmsg("Highway EXPLAIN cannot resolve the query minimizer route"),
			 errdetail(
				"minimizer_algorithm=%u alphabet_code=%u window_size=%d "
				"kmer_size=%d query_sketch_route=%u",
				static_cast<unsigned>(params->minimizer_algorithm),
				static_cast<unsigned>(params->alphabet_code),
				params->window_size,
				params->kmer_size,
				static_cast<unsigned>(query_sketch_route))));
	}
	return *resolved;
}

[[nodiscard]] static bioseq::simd_dispatch::HighwayKernelSet
HighwayKernelsForExplainStage(
		const bioseq::simd::pipe::StageDescription& stage,
		const std::uint64_t indexing_grouped32_validate_calls)
{
	auto kernels = stage.algorithm.has_value()
		? stage.algorithm->highway_kernels
		: bioseq::simd_dispatch::HighwayKernelSet{};
	/* A plan cannot know which persisted wire format a row will resolve to.
	 * Merge grouped32 only from completed runtime evidence, and only into the
	 * seed lookup that consumes that reader. Plain EXPLAIN and
	 * recomputed/non-grouped routes keep the plan-owned set unchanged. */
	if (indexing_grouped32_validate_calls != 0
		&& stage.stage_name == "SeedHitStage") {
		kernels |= bioseq::simd_dispatch::highway_kernel_set(
			bioseq::simd_dispatch::HighwayKernelId::
				indexing_grouped32_validate);
	}
	return kernels;
}

template <class Visitor>
static void
VisitPlannedHighwayFunctions(
		const bioseq::simd_dispatch::HighwayKernelSet&
			top_level_query_kernels,
		const bioseq::simd::pipe::PipelineDescription* pipeline_desc,
		const std::uint64_t indexing_grouped32_validate_calls,
		Visitor&& visitor)
{
	const auto visit_kernel_set = [&visitor](
			const bioseq::simd_dispatch::HighwayKernelSet& kernels,
			const char* stage_name) {
		for (std::size_t kernel_index = 0;
			 kernel_index < bioseq::simd_dispatch::highway_kernel_count;
			 ++kernel_index) {
			if (!kernels[kernel_index]) continue;
			visitor(
				static_cast<bioseq::simd_dispatch::HighwayKernelId>(
					kernel_index),
				stage_name);
		}
	};

	visit_kernel_set(top_level_query_kernels, "query sketch");
	if (pipeline_desc == nullptr) return;
	for (const auto& stage : pipeline_desc->stages) {
		if (!stage.algorithm.has_value()) continue;
		visit_kernel_set(
			HighwayKernelsForExplainStage(
				stage, indexing_grouped32_validate_calls),
			stage.stage_name.c_str());
	}
}

static void
ExplainPipelineExecutionStats(
	const bioseq::pipeline_stats::PipelineExecutionStats& stats,
	ExplainState* es,
	const bioseq::simd::Minimap2Params* aligner_params,
	const bioseq::simd::pipe::PipelineDescription* pipeline_desc,
	const bioseq::simd::pipe::QuerySketchPlanRoute query_sketch_route,
	const bool highway_dispatch_already_rendered)
{
	const auto requested_backend =
		bioseq::pipeline_stats::executed_backend_name(stats.requested_backend);
	const auto actual_backend =
		bioseq::pipeline_stats::executed_backend_name(stats.actual_backend);
	const auto requested_source =
		bioseq::pipeline_stats::target_index_source_name(
			stats.requested_target_index_source);
	const auto actual_source =
		bioseq::pipeline_stats::target_index_source_name(
			stats.actual_target_index_source);
	const auto& operational = stats.operational;
	const auto& query_sketch_timing = operational.timing[
		bioseq::pipeline_stats::stage_index(
			bioseq::pipeline_stats::PipelineStage::query_sketch)];
	const auto& target_index_build_timing = operational.timing[
		bioseq::pipeline_stats::stage_index(
			bioseq::pipeline_stats::PipelineStage::target_index_build)];

	/*
	 * BatchJoin and per-row owners pass their frozen structured pipeline
	 * descriptions here, so this combined group advertises the exact kernels
	 * selected by every stage. ColumnScan passes
	 * `highway_dispatch_already_rendered=true` because its richer pipeline-tree
	 * renderer owns the same plan/runtime dispatch group.
	 */
	if (!highway_dispatch_already_rendered) {
		const std::size_t query_sketch_stage_owners =
			pipeline_desc == nullptr
				? 0u
				: bioseq::simd::pipe::query_sketch_stage_owner_count(
					*pipeline_desc);
		if (query_sketch_stage_owners > 1u) {
			ereport(ERROR,
				(errcode(ERRCODE_INTERNAL_ERROR),
				 errmsg("Highway EXPLAIN has duplicate query-sketch stage owners"),
				 errdetail("owners=%zu", query_sketch_stage_owners)));
		}
		const auto top_level_query_kernels =
			query_sketch_stage_owners == 1u
				? bioseq::simd_dispatch::HighwayKernelSet{}
				: PlannedQueryMinimizerHighwayKernels(
					aligner_params, query_sketch_route);
		/* This union controls only whether the structured array is empty.
		 * Rendering still visits every stage so a shared kernel keeps each of
		 * its semantically distinct stage owners. */
		auto all_planned_kernels = top_level_query_kernels;
		if (pipeline_desc != nullptr) {
			for (const auto& stage : pipeline_desc->stages) {
				if (stage.algorithm.has_value()) {
					all_planned_kernels |= HighwayKernelsForExplainStage(
						stage,
						operational.indexing_grouped32_validate_calls);
				}
			}
		}
		/* Complete every fail-closed plan check before constructing strings:
		 * ereport(ERROR) longjmps and cannot unwind nontrivial C++ locals. */
		const auto highway_plan =
			bioseq::scheduler::highway_dispatch_info_for_plan();
		const std::string planned =
			HighwayTargetName(highway_plan.planned_target);
		const std::string supported =
			HighwayTargetNames(highway_plan.cpu_supported_targets);
		const std::string compiled =
			HighwayTargetNames(highway_plan.compiled_targets);
		const std::string runnable =
			HighwayTargetNames(highway_plan.runnable_targets);
		if (es->format == EXPLAIN_FORMAT_TEXT) {
			const auto print_plan_property = [es](
					const char* name, const std::string& value) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str, "%s: %s\n", name, value.c_str());
			};
			print_plan_property("Highway Planned Architecture", planned);
			print_plan_property(
				"Highway CPU-Supported Architectures", supported);
			print_plan_property("Highway Compiled Architectures", compiled);
			print_plan_property("Highway Runnable Architectures", runnable);
			VisitPlannedHighwayFunctions(
				top_level_query_kernels, pipeline_desc,
				operational.indexing_grouped32_validate_calls,
				[es, &planned](
						const bioseq::simd_dispatch::HighwayKernelId kernel,
						const char* stage_name) {
					const std::string_view function =
						bioseq::simd_dispatch::highway_kernel_name(kernel);
					appendStringInfoSpaces(es->str, es->indent * 2);
					appendStringInfo(es->str,
						"Highway Function: %.*s [planned architecture: %s] "
						"[stage: %s]\n",
						static_cast<int>(function.size()), function.data(),
						planned.c_str(), stage_name);
				});
			if (stats.environment.highway_executed_target_mixed) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfoString(es->str,
					"* Highway Executed Architecture: mixed\n");
			} else if (stats.environment.highway_executed_target != 0) {
				const std::string executed = HighwayTargetName(
					stats.environment.highway_executed_target);
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"* Highway Executed Architecture: %s\n",
					executed.c_str());
			}
		} else {
			ExplainOpenGroup(
				"Highway SIMD Dispatch", "Highway SIMD Dispatch", true, es);
			ExplainPropertyText("Planned Architecture", planned.c_str(), es);
			ExplainPropertyText(
				"CPU-Supported Architectures", supported.c_str(), es);
			ExplainPropertyText(
				"Compiled Architectures", compiled.c_str(), es);
			ExplainPropertyText(
				"Runnable Architectures", runnable.c_str(), es);
			if (all_planned_kernels.any()) {
				ExplainOpenGroup(
					"Planned Highway Functions",
					"Planned Highway Functions", false, es);
				VisitPlannedHighwayFunctions(
					top_level_query_kernels, pipeline_desc,
					operational.indexing_grouped32_validate_calls,
					[es, &planned](
							const bioseq::simd_dispatch::HighwayKernelId kernel,
							const char* stage_name) {
						const std::string_view function =
							bioseq::simd_dispatch::highway_kernel_name(kernel);
						const std::string function_text{function};
						ExplainOpenGroup(
							"Highway Function", nullptr, true, es);
						ExplainPropertyText(
							"Function", function_text.c_str(), es);
						ExplainPropertyText(
							"Planned Architecture", planned.c_str(), es);
						ExplainPropertyText(
							"Stage", stage_name, es);
						ExplainCloseGroup(
							"Highway Function", nullptr, true, es);
					});
				ExplainCloseGroup(
					"Planned Highway Functions",
					"Planned Highway Functions", false, es);
			}
			if (stats.environment.highway_executed_target_mixed) {
				ExplainPropertyText("Executed Architecture", "mixed", es);
			} else if (stats.environment.highway_executed_target != 0) {
				const std::string executed = HighwayTargetName(
					stats.environment.highway_executed_target);
				ExplainPropertyText(
					"Executed Architecture", executed.c_str(), es);
			}
			ExplainCloseGroup(
				"Highway SIMD Dispatch", "Highway SIMD Dispatch", true, es);
		}
	}

	if (es->format == EXPLAIN_FORMAT_TEXT) {
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"* Execution proof [requested_backend=%.*s actual_backend=%.*s "
			"requested_index_source=%.*s actual_index_source=%.*s "
			"attempted=%llu fully_attested=%llu unattested=%llu "
			"environment_mixed=%s persisted_identity_mixed=%s "
			"identity_conflict=%s saturated=%s]\n",
			static_cast<int>(requested_backend.size()), requested_backend.data(),
			static_cast<int>(actual_backend.size()), actual_backend.data(),
			static_cast<int>(requested_source.size()), requested_source.data(),
			static_cast<int>(actual_source.size()), actual_source.data(),
			static_cast<unsigned long long>(stats.attempted_alignment_jobs),
			static_cast<unsigned long long>(stats.fully_attested_alignment_jobs),
			static_cast<unsigned long long>(stats.unattested_alignment_jobs),
			stats.environment.mixed_invalid ? "true" : "false",
			stats.mixed_persisted_identity ? "true" : "false",
			operational.operational_identity_conflict ? "true" : "false",
			operational.stats_saturated ? "true" : "false");
		if (stats.unattested_alignment_jobs != 0) {
			appendStringInfoSpaces(es->str, es->indent * 2);
			appendStringInfo(es->str,
				"* First unattested [target_row=%llu query_ordinal=%llu]\n",
				static_cast<unsigned long long>(
					stats.first_unattested_target_row),
				static_cast<unsigned long long>(
					stats.first_unattested_query_ordinal));
		}
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"* Index outcomes [targets=%llu persisted=%llu missing_persisted=%llu "
			"recomputed=%llu]\n",
			static_cast<unsigned long long>(operational.target_rows),
			static_cast<unsigned long long>(operational.persisted_index_rows),
			static_cast<unsigned long long>(
				operational.missing_persisted_index_rows),
			static_cast<unsigned long long>(
				operational.recomputed_target_index_rows));
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"* GPU dispatch [seed=%llu chain=%llu chain_backtrack=%llu "
				"coordinate_vote=%llu extend=%llu backend_declines=%llu "
				"backend_fallbacks=%llu]\n",
				static_cast<unsigned long long>(operational.gpu_seed_dispatches),
				static_cast<unsigned long long>(operational.gpu_chain_dispatches),
				static_cast<unsigned long long>(
					operational.gpu_chain_backtrack_dispatches),
				static_cast<unsigned long long>(
					operational.gpu_coordinate_vote_dispatches),
				static_cast<unsigned long long>(operational.gpu_extend_dispatches),
			static_cast<unsigned long long>(operational.backend_declines),
			static_cast<unsigned long long>(operational.backend_fallbacks));
		/*
		 * Keep the compact headline above for human scans, and also expose the
		 * algorithm-identity counters as ordinary textual EXPLAIN properties.
		 * These values come from the same completed PipelineExecutionStats
		 * aggregate as the headline; selection flags never populate them.
		 */
		ExplainPropertyUInteger("GPU Chain Dispatches", nullptr,
			operational.gpu_chain_dispatches, es);
		ExplainPropertyUInteger("GPU Chain Backtrack Dispatches", nullptr,
			operational.gpu_chain_backtrack_dispatches, es);
		ExplainPropertyUInteger("GPU Coordinate Vote Dispatches", nullptr,
			operational.gpu_coordinate_vote_dispatches, es);
		appendStringInfoSpaces(es->str, es->indent * 2);
		appendStringInfo(es->str,
			"* Host evidence [query_sketch_ns=%llu target_index_build_ns=%llu "
			"query_hash_readbacks=%llu query_symbol_packing=%llu "
			"target_symbol_packing=%llu alignment_classification=%llu "
			"cigar_construction=%llu]\n",
			static_cast<unsigned long long>(query_sketch_timing.host_wall_ns),
			static_cast<unsigned long long>(
				target_index_build_timing.host_wall_ns),
			static_cast<unsigned long long>(
				operational.host_query_hash_readbacks),
			static_cast<unsigned long long>(
				operational.host_query_symbol_packing_calls),
			static_cast<unsigned long long>(
				operational.host_target_symbol_packing_calls),
			static_cast<unsigned long long>(
				operational.host_alignment_job_classification_calls),
			static_cast<unsigned long long>(
				operational.host_cigar_construction_calls));
		ExplainPrefilterExecutionProof(operational, es);
		return;
	}

	ExplainOpenGroup(
		"Bioseq Execution Proof", "Bioseq Execution Proof", true, es);
	ExplainPropertyText(
		"Requested Backend", requested_backend.data(), es);
	ExplainPropertyText(
		"Actual Backend", actual_backend.data(), es);
	ExplainPropertyText(
		"Requested Target Index Source", requested_source.data(), es);
	ExplainPropertyText(
		"Actual Target Index Source", actual_source.data(), es);
	ExplainPropertyUInteger("Attempted Alignment Jobs", nullptr,
		stats.attempted_alignment_jobs, es);
	ExplainPropertyUInteger("Fully Attested Alignment Jobs", nullptr,
		stats.fully_attested_alignment_jobs, es);
	ExplainPropertyUInteger("Unattested Alignment Jobs", nullptr,
		stats.unattested_alignment_jobs, es);
	if (stats.unattested_alignment_jobs != 0) {
		ExplainPropertyUInteger("First Unattested Target Row", nullptr,
			stats.first_unattested_target_row, es);
		ExplainPropertyUInteger("First Unattested Query Ordinal", nullptr,
			stats.first_unattested_query_ordinal, es);
	}
	ExplainPropertyBool(
		"Environment Mixed Invalid", stats.environment.mixed_invalid, es);
	ExplainPropertyBool(
		"Mixed Persisted Identity", stats.mixed_persisted_identity, es);
	ExplainPropertyBool("Operational Identity Conflict",
		operational.operational_identity_conflict, es);
	ExplainPropertyBool(
		"Stats Saturated", operational.stats_saturated, es);
	ExplainPropertyUInteger("Target Rows", nullptr,
		operational.target_rows, es);
	ExplainPropertyUInteger("Persisted Index Rows", nullptr,
		operational.persisted_index_rows, es);
	ExplainPropertyUInteger("Missing Persisted Index Rows", nullptr,
		operational.missing_persisted_index_rows, es);
	ExplainPropertyUInteger("Recomputed Target Index Rows", nullptr,
		operational.recomputed_target_index_rows, es);
	ExplainPropertyUInteger("GPU Seed Dispatches", nullptr,
		operational.gpu_seed_dispatches, es);
	ExplainPropertyUInteger("GPU Chain Dispatches", nullptr,
		operational.gpu_chain_dispatches, es);
	ExplainPropertyUInteger("GPU Chain Backtrack Dispatches", nullptr,
		operational.gpu_chain_backtrack_dispatches, es);
	ExplainPropertyUInteger("GPU Coordinate Vote Dispatches", nullptr,
		operational.gpu_coordinate_vote_dispatches, es);
	ExplainPropertyUInteger("GPU Extend Dispatches", nullptr,
		operational.gpu_extend_dispatches, es);
	ExplainPropertyUInteger("Backend Declines", nullptr,
		operational.backend_declines, es);
	ExplainPropertyUInteger("Backend Fallbacks", nullptr,
		operational.backend_fallbacks, es);
	ExplainPropertyUInteger("Query Sketch Host Wall Ns", nullptr,
		query_sketch_timing.host_wall_ns, es);
	ExplainPropertyUInteger("Target Index Build Host Wall Ns", nullptr,
		target_index_build_timing.host_wall_ns, es);
	ExplainPropertyUInteger("Host Query Hash Readbacks", nullptr,
		operational.host_query_hash_readbacks, es);
	ExplainPropertyUInteger("Host Query Symbol Packing Calls", nullptr,
		operational.host_query_symbol_packing_calls, es);
	ExplainPropertyUInteger("Host Target Symbol Packing Calls", nullptr,
		operational.host_target_symbol_packing_calls, es);
	ExplainPropertyUInteger("Host Alignment Job Classification Calls", nullptr,
		operational.host_alignment_job_classification_calls, es);
	ExplainPropertyUInteger("Host CIGAR Construction Calls", nullptr,
		operational.host_cigar_construction_calls, es);
	ExplainPrefilterExecutionProof(operational, es);
	ExplainCloseGroup(
		"Bioseq Execution Proof", "Bioseq Execution Proof", true, es);
}

static void
BioseqColumnScan_ExplainCustomScan(CustomScanState *node, List *ancestors,
							   ExplainState *es)
{
	bioseq_log<DBG>("[bioseq] pg: BioseqColumnScan_ExplainCustomScan() entered");
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);

	List *context = set_deparse_context_planstate(
		es->deparse_cxt, reinterpret_cast<Node *>(&node->ss.ps), ancestors);

	List *projectedColumns = BioseqColumnVarNeeded(bioseqScanState);
	const char *projectedColumnsStr = BioseqColumnProjectedColumnsStr(
		context, projectedColumns);
	ExplainPropertyText("Bioseq Projected Columns",
						projectedColumnsStr, es);

	CustomScan *cscan = pg_node_expect<CustomScan>(pg_as_node(node->ss.ps.plan));
	List *chunkGroupFilter = storage_prunable_quals_without_mmsearch(
		PList<List>(cscan->custom_exprs).second(), get_cached_stub_oids());
	if (chunkGroupFilter != NULL)
	{
		const char *pushdownClausesStr = BioseqColumnPushdownClausesStr(
			context, chunkGroupFilter);
		ExplainPropertyText("Bioseq Chunk Group Filters",
							pushdownClausesStr, es);

		BioseqColumnScanDesc bioseqColumnScanDesc =
			reinterpret_cast<BioseqColumnScanDesc>(node->ss.ss_currentScanDesc);
		if (bioseqColumnScanDesc != NULL)
		{
			ExplainPropertyInteger(
				"Bioseq Chunk Groups Removed by Filter",
				NULL, BioseqColumnScanChunkGroupsFiltered(bioseqColumnScanDesc), es);
		}
	}

	if (bioseqScanState->vectorization.vectorizationEnabled &&
		bioseqScanState->vectorization.vectorizedQualList != NULL)
	{
		const char *vectorizedWhereClauses = BioseqColumnPushdownClausesStr(
					context, bioseqScanState->vectorization.vectorizedQualList);
		ExplainPropertyText("Bioseq Vectorized Filter",
							vectorizedWhereClauses, es);
	}

	/*
	 * List every per-column metadata lookup the scan resolves without
	 * touching the base relation's varlena. Today this is just the
	 * symbol_count fast path — each rewritten call-site shows up as
	 * "<column>.symbol_count('<letter>', rank=<n>)". The list is
	 * recomputed here by walking the plan's target list instead of
	 * inspecting `placeholder_consts.symbol_count_sites` directly: the
	 * latter is populated lazily on first ExecScan, but EXPLAIN (without
	 * ANALYZE) never runs ExecScan and would therefore show an empty
	 * line. Re-deriving from the plan keeps EXPLAIN output useful for
	 * planners inspecting queries that have not yet executed. When
	 * future metadata is surfaced via the same pattern (min_qual,
	 * gc_ratio, …) they should extend this walker accordingly.
	 */
	{
		StringInfoData meta_buf;
		initStringInfo(&meta_buf);
		bool first = true;
		const BioseqStubOids& oids_snapshot = get_cached_stub_oids();
		Relation scan_rel = node->ss.ss_currentRelation;
		for (auto tgt : PList<TargetEntry>(node->ss.ps.plan->targetlist)) {
			if (tgt == nullptr) {
				continue;
			}
			FuncExpr* fe = pg_node_try_as<FuncExpr>(pg_as_node(tgt->expr));
			if (fe == nullptr
				|| fe->funcid != oids_snapshot.symbol_count_oid
				|| list_length(fe->args) != 2) {
				continue;
			}
			PList<Node> args(fe->args);
			Var* col_var = pg_node_try_as<Var>(args.first());
			Const* letter_const = pg_node_try_as<Const>(args.second());
			if (col_var == nullptr || letter_const == nullptr) {
				continue;
			}
			if (letter_const->constisnull || col_var->vartypmod < 0) {
				continue;
			}
			text* letter_detoasted = reinterpret_cast<text*>(
				PG_DETOAST_DATUM(letter_const->constvalue));
			if (VARSIZE_ANY_EXHDR(letter_detoasted) != 1) {
				if (reinterpret_cast<void*>(letter_detoasted)
					!= reinterpret_cast<void*>(DatumGetPointer(letter_const->constvalue))) {
					pfree(letter_detoasted);
				}
				continue;
			}
			const char letter_char = *VARDATA_ANY(letter_detoasted);
			if (reinterpret_cast<void*>(letter_detoasted)
				!= reinterpret_cast<void*>(DatumGetPointer(letter_const->constvalue))) {
				pfree(letter_detoasted);
			}
			const compact_sequence_stdc_type_params typmod = compact_sequence_stdc_type_params::decode(col_var->vartypmod);
			const int rank = bioseq::storage::indexing::letter_to_rank(typmod.alphabet_code, letter_char);
			if (rank < 0) {
				continue;
			}
			std::string col_name;
			if (scan_rel != nullptr && col_var->varattno >= 1) {
				char* attname_cstr = get_attname(
					RelationGetRelid(scan_rel), col_var->varattno, /*missing_ok=*/true);
				if (attname_cstr != nullptr) {
					col_name.assign(attname_cstr);
					pfree(attname_cstr);
				}
			}
			if (!first) {
				appendStringInfoString(&meta_buf, ", ");
			}
			first = false;
			appendStringInfo(&meta_buf,
							 "%s.symbol_count('%c', rank=%d)",
							 col_name.empty() ? "<unknown>" : col_name.c_str(),
							 letter_char, rank);
		}
		if (!first) {
			ExplainPropertyText("Bioseq Fetched From Meta", meta_buf.data, es);
		}
		pfree(meta_buf.data);
	}

	/*
	 * Two-tier EXPLAIN:
	 *   1. A "Bioseq Fetched From Sequence Index" / "Bioseq Recomputed"
	 *      summary line — surfaces only when the plan actually runs the
	 *      minimap2 pipeline (i.e. mmsearch is part of the plan).
	 *   2. A full One-to-many alignment breakdown showing each pipeline
	 *      stage and the Minimap2Params values that drive it. The stage
	 *      list is gated by params.do_cigar / compute_divergence /
	 *      compute_mapq so users see exactly what will (or will not) run.
	 *
	 * The distinction from the previous implementation is that the
	 * sidecar/recomputed line never prints for a pass-through scan. Plans
	 * that only use symbol_count/meta projections still show the "Fetched
	 * From Meta" line above but never a minimizer-index line — because
	 * they never consult index_sidecar.
	 */
	/*
	 * Per-scan aligner snapshot captured at BeginCustomScan. Hoisted to
	 * the outer scope so the pipeline-step breakdown block below can
	 * reuse it without a second runtime lookup.
	 */
	BioseqScanState* explainScanState = BioseqScanState::from_custom_scan_state(node);
	const BioseqScanRuntime* explain_runtime =
		(explainScanState != nullptr && explainScanState->runtime != nullptr)
			? static_cast<const BioseqScanRuntime*>(explainScanState->runtime)
			: nullptr;
	const PerScanAlignerState* aligner_snapshot =
		(explain_runtime != nullptr) ? &explain_runtime->aligner_state : nullptr;
	FrozenBioseqScanSemantics explain_frozen_semantics{};
	const bool explain_semantics_valid =
		aligner_snapshot != nullptr && aligner_snapshot->params_captured
			? true
			: decode_bioseq_semantic_payload(
				cscan->custom_private, &explain_frozen_semantics);
	const bool explain_read_sequence_index =
		aligner_snapshot != nullptr && aligner_snapshot->params_captured
			? aligner_snapshot->read_sequence_index
			: explain_semantics_valid
				? explain_frozen_semantics.read_sequence_index
				: false;
	const bioseq::indexing::IndexReadRequirement
		explain_index_read_requirement =
			aligner_snapshot != nullptr && aligner_snapshot->params_captured
				? aligner_snapshot->index_read_requirement
				: explain_semantics_valid
					? explain_frozen_semantics.index_read_requirement
					: bioseq::indexing::IndexReadRequirement::allow;

	{
		/*
		 * Use the feature flags captured on BeginCustomScan when
		 * available (executor ran). For EXPLAIN without ANALYZE the
		 * BeginCustomScan may not have fired — recompute locally using
		 * the plan targetlist/qual so the printed output is still
		 * accurate.
		 */
		const BioseqStubOids& explain_oids = get_cached_stub_oids();
		List* explain_owned_mmsearch = cscan != nullptr
			&& list_length(cscan->custom_exprs) >= 4
			? reinterpret_cast<List*>(list_nth(cscan->custom_exprs, 3))
			: NIL;
		BioseqScanFeatureFlags features =
			(aligner_snapshot != nullptr && aligner_snapshot->params_captured)
				? aligner_snapshot->features
				: detect_feature_flags(node->ss.ps.plan->targetlist,
									   node->ss.ps.plan->qual, explain_oids);
		features.has_mmsearch = features.has_mmsearch
			|| explain_owned_mmsearch != NIL;
		bool evaluated_operand_owner = explain_runtime != nullptr
			&& explain_runtime->match_evaluated_submission;
		if (!evaluated_operand_owner && explain_owned_mmsearch != NIL) {
			FuncExpr* owned = pg_node_try_as<FuncExpr>(
				reinterpret_cast<Node*>(linitial(explain_owned_mmsearch)));
			if (owned != nullptr && list_length(owned->args) >= 2) {
				Node* target = reinterpret_cast<Node*>(linitial(owned->args));
				Node* query = reinterpret_cast<Node*>(lsecond(owned->args));
				Var* query_var = pg_node_try_as<Var>(query);
				evaluated_operand_owner = pg_node_try_as<Var>(target) == nullptr
					|| (pg_node_try_as<Const>(query) == nullptr
						&& pg_node_try_as<Param>(query) == nullptr
						&& query_var == nullptr);
			}
		}

		/*
		 * Only the WHERE mmsearch(...) pipeline consults the minimizer
		 * index. A bare SELECT with only symbol_count/metadata projections
		 * stays on the meta-sidecar side and should not see a minimizer
		 * line at all (the previous behaviour printed one unconditionally
		 * and was misleading).
		 */
		if (features.has_mmsearch)
		{
			ExplainPropertyText(
				"Bioseq Index Read Requirement",
				bioseq::indexing::index_read_requirement_name(
					explain_index_read_requirement).data(),
				es);
			if (evaluated_operand_owner) {
				ExplainPropertyText(
					"Bioseq Match Operand Evaluation",
					"base-local ExprState (target then query; persisted target index absent)",
					es);
			}
			/*
			 * DOC0279 — plan-time typmod-coalesce hint. `EXPLAIN` without
			 * `ANALYZE` never populates the runtime coalesce buffer, so the
			 * runtime-gated "...coalesce to..." sub-clause further below cannot
			 * fire for a plain `EXPLAIN`. Re-derive the decision from the plan
			 * qual here so the coalesce is always visible in the plan (restores
			 * the pre-DOC0279 plain-EXPLAIN behaviour the §11.5 rewrite dropped).
			 */
			{
				const ExplainTypmodCoalesce coalesce_hint =
					explain_detect_typmod_coalesce(
						explain_owned_mmsearch != NIL
							? explain_owned_mmsearch : node->ss.ps.plan->qual,
						explain_oids);
				if (coalesce_hint.active) {
					const auto coa_name =
						pgseq_supported_alphabets::name_of_alphabet_code(coalesce_hint.col_alpha);
					StringInfoData coa_buf;
					initStringInfo(&coa_buf);
					appendStringInfo(&coa_buf, "coalesce to seq('%.*s', %u)",
						static_cast<int>(coa_name.size()), coa_name.data(),
						static_cast<unsigned>(coalesce_hint.col_byte_width) * 8u);
					ExplainPropertyText("Bioseq Typmod Coalesce", coa_buf.data, es);
					pfree(coa_buf.data);
				}
			}
			Oid user_relid = InvalidOid;
			double rel_tuples = -1.0;
			if (node->ss.ss_currentRelation != nullptr) {
				user_relid = RelationGetRelid(node->ss.ss_currentRelation);
				if (node->ss.ss_currentRelation->rd_rel != nullptr) {
					rel_tuples = static_cast<double>(
						node->ss.ss_currentRelation->rd_rel->reltuples);
				}
			} else if (cscan != nullptr && node->ss.ps.state != nullptr) {
				RangeTblEntry* rte = rt_fetch(cscan->scan.scanrelid,
											  node->ss.ps.state->es_range_table);
				if (rte != nullptr) {
					user_relid = rte->relid;
				}
			}

				if (user_relid != InvalidOid) {
					if (rel_tuples < 0.0) {
						HeapTuple cls_tup = SearchSysCache1(RELOID,
															bioseq::pg_utils::pg_datum::from_oid(user_relid).raw());
					if (HeapTupleIsValid(cls_tup)) {
						Form_pg_class cls = reinterpret_cast<Form_pg_class>(GETSTRUCT(cls_tup));
						rel_tuples = static_cast<double>(cls->reltuples);
						ReleaseSysCache(cls_tup);
					}
				}
				/*
				 * Index-presence estimate is the plan-time view of how
				 * many rows have a prebuilt sidecar blob. With
				 * read_sequence_index off we always recompute — surface
				 * that explicitly. With it on we display both the
				 * "fetched from sidecar" and "recomputed" halves so the
				 * user can see exactly what the pipeline did (or will
				 * do): fetched = min(presence, 1), recomputed = 1 -
				 * fetched. The two lines sum to 100%. Different bound
				 * alphabets are rejected before a scan reaches EXPLAIN runtime
				 * state, so there is no alphabet-specific recompute branch.
				 */
				const float index_presence =
					bioseq::storage::indexing::estimate_index_presence(
						user_relid, rel_tuples,
						bioseq::indexing::DEFAULT_ACTIVE_READ_INDEX);
				float fetched_pct    = 0.0f;
				float recomputed_pct = 100.0f;
				const bool runtime_coalesce_active =
					(explain_runtime != nullptr)
					&& explain_runtime->buffer.coalesce_active();
				if (evaluated_operand_owner) {
					ExplainPropertyText("Bioseq Recomputed",
						"minimizers 100% (evaluated logical view requires index absence)",
						es);
				} else if (explain_read_sequence_index) {
					fetched_pct    = index_presence * 100.0f;
					recomputed_pct = (1.0f - index_presence) * 100.0f;
					if (fetched_pct > 0.0f) {
						StringInfoData presence_buf;
						initStringInfo(&presence_buf);
						appendStringInfo(&presence_buf,
										 "minimizers (index presence: %.0f%%",
										 static_cast<double>(fetched_pct));
						if (runtime_coalesce_active && explain_runtime != nullptr) {
							/*
							 * Surface the typmod-coalesce decision next to
							 * the index-presence percentage so users can
							 * see "we re-encoded your literal at the
							 * column's typmod, then used the prebuilt
							 * minimizer index". Without this line the user
							 * sees a successful scan and has no idea their
							 * literal was silently re-encoded.
							 */
							const auto col_alpha = explain_runtime->buffer.mmsearch_alphabet_code();
							const auto col_width = explain_runtime->buffer.mmsearch_storage_unit_byte_width();
							// mmsearch_storage_unit_byte_width() returns the
							// storage unit width in BYTES (1/2/4/8), so the
							// typmod width in bits is byte_width * 8 (e.g. 4
							// bytes -> seq('dna4', 32)). The previous
							// `8u << byte_width` formula treated the byte count
							// as a log2 code and rendered 4 bytes as 128.
							const auto width_to_bits = [](uint8_t byte_width) {
								return static_cast<unsigned>(byte_width) * 8u;
							};
							const auto col_name =
								pgseq_supported_alphabets::name_of_alphabet_code(col_alpha);
							appendStringInfo(&presence_buf,
								", coalesce to seq('%.*s', %u)",
								static_cast<int>(col_name.size()), col_name.data(),
								width_to_bits(col_width));
						}
						appendStringInfoString(&presence_buf, ")");
						ExplainPropertyText("Bioseq Fetched From Sequence Index",
											presence_buf.data, es);
						pfree(presence_buf.data);
					}
					if (recomputed_pct > 0.0f) {
						StringInfoData recompute_buf;
						initStringInfo(&recompute_buf);
						appendStringInfo(&recompute_buf,
										 "minimizers %.0f%%",
										 static_cast<double>(recomputed_pct));
						ExplainPropertyText("Bioseq Recomputed",
											recompute_buf.data, es);
						pfree(recompute_buf.data);
					}
				} else {
					/* 100% recomputed because the GUC is off. */
					ExplainPropertyText("Bioseq Recomputed",
										"minimizers 100% (read_sequence_index disabled)",
										es);
				}
			}

			{
				const auto scheduler =
					bioseq::parallelism::pg::snapshot();
				const auto scheduler_mode =
					bioseq::parallelism::to_string(scheduler.mode);
				StringInfoData scheduler_buf;
				initStringInfo(&scheduler_buf);
				appendStringInfo(&scheduler_buf,
					"supervisor=%s mode=%.*s workers=%u/%u batches=%llu/%llu awaiting=%llu queries=%llu/%llu qps=%.3f async_persist_waiting=%llu index_memory_reserved=%llu",
					scheduler.supervisor ? "on" : "local",
					static_cast<int>(scheduler_mode.size()),
					scheduler_mode.data(),
					static_cast<unsigned>(scheduler.current_threads),
					static_cast<unsigned>(scheduler.max_threads),
					static_cast<unsigned long long>(scheduler.batches_processed),
					static_cast<unsigned long long>(scheduler.batches_scheduled),
					static_cast<unsigned long long>(scheduler.batches_awaiting),
					static_cast<unsigned long long>(scheduler.queries_processed),
					static_cast<unsigned long long>(scheduler.queries_waiting),
					scheduler.queries_per_sec,
					static_cast<unsigned long long>(scheduler.async_persist_jobs_waiting),
					static_cast<unsigned long long>(scheduler.index_memory_reserved_bytes));
				ExplainPropertyText("Bioseq Scheduler", scheduler_buf.data, es);
				pfree(scheduler_buf.data);
			}
		}
	}

	/*
	 * Rich pipeline-step breakdown. Only shown when mmsearch is present
	 * (without mmsearch the minimap2 pipeline never runs). Uses the
	 * per-scan params captured at BeginCustomScan so every printed value
	 * is the one actually fed to the batch processor — not a recomputation
	 * off GUCs that might have changed since.
	 */
	if (aligner_snapshot != nullptr
		&& aligner_snapshot->params_captured
		&& aligner_snapshot->features.has_mmsearch)
	{
		using bioseq::simd::ChainingAlgorithmType;
		using bioseq::simd::BaseAlignmentAlgorithmType;
		using bioseq::simd::chaining_algorithm_name;
		using bioseq::simd::base_alignment_algorithm_name;
		const auto& params = aligner_snapshot->params;
		const auto& features = aligner_snapshot->features;
		const auto highway_plan =
			bioseq::scheduler::highway_dispatch_info_for_plan();
		const std::string highway_planned_architecture =
			HighwayTargetName(highway_plan.planned_target);
		const std::string highway_cpu_supported_architectures =
			HighwayTargetNames(highway_plan.cpu_supported_targets);
		const std::string highway_compiled_architectures =
			HighwayTargetNames(highway_plan.compiled_targets);
		const std::string highway_runnable_architectures =
			HighwayTargetNames(highway_plan.runnable_targets);
		/*
		 * Renderer driven by the structured `PipelineDescription` populated at
		 * `BeginCustomScan` (DOC0249 §12.3).  The renderer no longer hardcodes
		 * which parameters belong to which stage — adding a new stage / new
		 * algorithm trait surfaces automatically once it appears in
		 * `PipelineDescription::stages`.
		 *
		 * When the describe path did not populate a description (e.g. a
		 * cold-path branch that bypassed BeginCustomScan), `pipeline_desc` is
		 * `std::nullopt`; in that case we emit a minimal placeholder line so
		 * EXPLAIN still surfaces the algorithm choice the executor will run.
		 */
			const bool has_pipeline_desc =
				aligner_snapshot->pipeline_desc.has_value();
			const std::size_t query_sketch_stage_owners =
				has_pipeline_desc
				? bioseq::simd::pipe::query_sketch_stage_owner_count(
					*aligner_snapshot->pipeline_desc)
				: 0u;
			if (query_sketch_stage_owners > 1u) {
				ereport(ERROR,
					(errcode(ERRCODE_INTERNAL_ERROR),
					 errmsg("Highway EXPLAIN has duplicate query-sketch stage owners"),
					 errdetail("owners=%zu", query_sketch_stage_owners)));
			}
			/*
			 * A structured QuerySketchStage owns its exact function set. The
			 * top-level list is solely the cold/legacy fallback for descriptions
			 * that could not represent that semantic stage.
			 */
			const auto top_level_query_highway_kernels =
				query_sketch_stage_owners == 1u
				? bioseq::simd_dispatch::HighwayKernelSet{}
				: PlannedQueryMinimizerHighwayKernels(
					&params,
					QuerySketchPlanRouteFor(
						explain_index_read_requirement));
			const auto pipeline_scheduler =
				bioseq::parallelism::pg::snapshot();
			const auto pipeline_mode =
				bioseq::parallelism::to_string(pipeline_scheduler.mode);
			const std::string pipeline_mode_text{pipeline_mode};
			const char* pipeline_label =
				pipeline_scheduler.mode
					== bioseq::parallelism::PipelineConcurrencyMode::SINGLE
				? "Single thread"
				: pipeline_scheduler.mode
					== bioseq::parallelism::PipelineConcurrencyMode::PARALLEL
				? "Parallel dispatch"
				: "Task-parallel";
			const auto highway_kernels_for_stage =
				[explain_runtime](
					const bioseq::simd::pipe::StageDescription& stage) {
					return HighwayKernelsForExplainStage(
						stage,
						explain_runtime == nullptr
							? 0u
							: explain_runtime->buffer.execution_stats()
								.operational
								.indexing_grouped32_validate_calls);
				};

			if (es->format == EXPLAIN_FORMAT_TEXT) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfoString(es->str,
					"One-to-many alignment:\n");
				++es->indent;
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"%s [mode=%.*s, workers=%u, index_memory_reserved=%llu bytes]:\n",
					pipeline_label,
					static_cast<int>(pipeline_mode.size()),
					pipeline_mode.data(),
					static_cast<unsigned>(pipeline_scheduler.max_threads),
					static_cast<unsigned long long>(
						pipeline_scheduler.index_memory_reserved_bytes));
				++es->indent;
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"Highway Planned Architecture: %s\n",
					highway_planned_architecture.c_str());
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"Highway CPU-Supported Architectures: %s\n",
					highway_cpu_supported_architectures.c_str());
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"Highway Compiled Architectures: %s\n",
					highway_compiled_architectures.c_str());
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"Highway Runnable Architectures: %s\n",
					highway_runnable_architectures.c_str());
				for (std::size_t kernel_index = 0;
					 kernel_index < bioseq::simd_dispatch::highway_kernel_count;
					 ++kernel_index) {
					if (!top_level_query_highway_kernels[kernel_index]) continue;
					const auto kernel = static_cast<
						bioseq::simd_dispatch::HighwayKernelId>(kernel_index);
					const std::string_view function =
						bioseq::simd_dispatch::highway_kernel_name(kernel);
					appendStringInfoSpaces(es->str, es->indent * 2);
					appendStringInfo(es->str,
						"Highway Function: %.*s [planned architecture: %s] "
						"[stage: query sketch]\n",
						static_cast<int>(function.size()), function.data(),
						highway_planned_architecture.c_str());
				}
				if (explain_runtime != nullptr) {
					const auto& environment =
						explain_runtime->buffer.execution_stats().environment;
					if (environment.highway_executed_target_mixed) {
						appendStringInfoSpaces(es->str, es->indent * 2);
						appendStringInfoString(es->str,
							"* Highway Executed Architecture: mixed\n");
					} else if (environment.highway_executed_target != 0) {
						const std::string executed = HighwayTargetName(
							environment.highway_executed_target);
						appendStringInfoSpaces(es->str, es->indent * 2);
						appendStringInfo(es->str,
							"* Highway Executed Architecture: %s\n",
							executed.c_str());
					}
				}

			/*
			 * Sidecar-divergence warning: when the prebuilt-index path is
			 * active for some fraction of the batch, those rows pin
			 * k=15/w=10 regardless of the user's GUC (see
			 * dispatch_buffer.cppm).  Surfaced as a header line above the
			 * pipeline tree so it is not visually attached to any one stage.
			 */
			const bool sidecar_path_active = explain_read_sequence_index;
			const bool user_kw_differs =
				sidecar_path_active &&
				(params.kmer_size != 15 || params.window_size != 10);
			if (user_kw_differs) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfoString(es->str,
					"NOTE: sidecar rows pin kmer_size=15 window_size=10\n");
			}

			if (has_pipeline_desc) {
				for (const auto& stage :
					aligner_snapshot->pipeline_desc->stages)
				{
					/*
					 * Skip stages whose `algorithm` is std::nullopt AND
					 * carry no `extra_description` — those are stages
					 * disabled by their `enabled` flag (e.g. DivergenceStage
					 * when compute_divergence=false).  DOC0249 §11.4.
					 */
					if (!stage.algorithm.has_value()
						&& !stage.extra_description.has_value())
					{
						continue;
					}

					appendStringInfoSpaces(es->str, es->indent * 2);
					if (stage.algorithm.has_value()) {
						const auto stage_highway_kernels =
							highway_kernels_for_stage(stage);
						appendStringInfo(es->str, "| %s: %s\n",
							stage.stage_name.c_str(),
							stage.algorithm->name.c_str());
						for (const auto& p : stage.algorithm->parameters) {
							appendStringInfoSpaces(es->str,
								(es->indent + 1) * 2);
							appendStringInfo(es->str, "%s: %s\n",
								p.name.c_str(), p.value.c_str());
						}
						for (const auto& p : stage.algorithm->computed_properties) {
							appendStringInfoSpaces(es->str,
								(es->indent + 1) * 2);
							appendStringInfo(es->str, "[%s: %s]\n",
								p.name.c_str(), p.value.c_str());
						}
						for (std::size_t kernel_index = 0;
							kernel_index < bioseq::simd_dispatch::highway_kernel_count;
							++kernel_index) {
							if (!stage_highway_kernels[kernel_index]) {
								continue;
							}
							const auto kernel = static_cast<
								bioseq::simd_dispatch::HighwayKernelId>(kernel_index);
							const std::string_view function =
								bioseq::simd_dispatch::highway_kernel_name(kernel);
							appendStringInfoSpaces(es->str,
								(es->indent + 1) * 2);
							appendStringInfo(es->str,
								"Highway Function: %.*s [planned architecture: %s]\n",
								static_cast<int>(function.size()), function.data(),
								highway_planned_architecture.c_str());
						}
					} else {
						appendStringInfo(es->str, "| %s — %s\n",
							stage.stage_name.c_str(),
							stage.extra_description->c_str());
					}
					if (stage.estimated_batch_size.has_value()) {
						appendStringInfoSpaces(es->str,
							(es->indent + 1) * 2);
						appendStringInfo(es->str, "[reserved: %zu]\n",
							*stage.estimated_batch_size);
					}
				}
			} else {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"| Pipeline (chaining=%s, base_alignment=%s)\n",
					chaining_algorithm_name(params.chaining_algorithm),
					base_alignment_algorithm_name(params.base_alignment_algorithm));
			}

			/*
			 * Surface canonical pipeline stats. Only meaningful after ANALYZE has
			 * actually run the scan (target_rows is zero before the first
			 * completed batch).
			 */
			auto print_submit = [&](const char* label) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str, "* %s\n", label);
			};
			if (explain_runtime != nullptr) {
				const auto& stats = explain_runtime->buffer.execution_stats();
				const auto& operational = stats.operational;
				if (operational.target_rows > 0) {
					StringInfoData submit_label;
					initStringInfo(&submit_label);
					appendStringInfo(&submit_label,
						"Submit results [targets=%llu persisted_index=%llu recomputed=%llu]",
						static_cast<unsigned long long>(
							operational.target_rows),
						static_cast<unsigned long long>(
							operational.persisted_index_rows),
						static_cast<unsigned long long>(
							operational.recomputed_target_index_rows));
					print_submit(submit_label.data);
					pfree(submit_label.data);
				} else {
					print_submit("Submit results");
				}
				ExplainPipelineExecutionStats(
					stats, es, &params,
					aligner_snapshot->pipeline_desc.has_value()
						? &*aligner_snapshot->pipeline_desc : nullptr,
					QuerySketchPlanRouteFor(
						explain_index_read_requirement),
					/*highway_dispatch_already_rendered=*/true);
			} else {
				print_submit("Submit results");
			}

			if (params.enable_profiling) {
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfoString(es->str, "Runtime:\n");
				++es->indent;
				appendStringInfoSpaces(es->str, es->indent * 2);
				appendStringInfo(es->str,
					"profiling: enabled (see bioseq_log<DBG> for per-stage μs/ns counters)\n");
				appendStringInfoSpaces(es->str, es->indent * 2);
				if (explain_runtime != nullptr) {
					const auto& stats = explain_runtime->buffer.execution_stats();
					const auto& operational = stats.operational;
					appendStringInfo(es->str,
						"batch summary: target_rows=%llu, persisted_index=%llu, "
						"recomputed=%llu, attempted_jobs=%llu, unattested_jobs=%llu\n",
						static_cast<unsigned long long>(
							operational.target_rows),
						static_cast<unsigned long long>(
							operational.persisted_index_rows),
						static_cast<unsigned long long>(
							operational.recomputed_target_index_rows),
						static_cast<unsigned long long>(
							stats.attempted_alignment_jobs),
						static_cast<unsigned long long>(
							stats.unattested_alignment_jobs));
				}
				--es->indent;
			}

			es->indent -= 2;
			(void) features;  // currently only has_mmsearch is load-bearing
		} else {
			/*
			 * Structured formats: emit the same per-stage information via
			 * `ExplainOpenGroup` + `ExplainPropertyText` so EXPLAIN (FORMAT
			 * JSON / YAML / XML) consumes the same metadata as the TEXT
			 * renderer (DOC0249 §12.4).
			 */
			ExplainOpenGroup("Bioseq Pipeline", "Bioseq Pipeline", true, es);
			ExplainPropertyText("Chaining Algorithm",
								chaining_algorithm_name(params.chaining_algorithm), es);
			ExplainPropertyText("Base Alignment Algorithm",
								base_alignment_algorithm_name(params.base_alignment_algorithm), es);
			ExplainPropertyText("Pipeline Concurrency Mode",
				pipeline_mode_text.c_str(), es);
			ExplainPropertyUInteger("Max Concurrency", NULL,
				static_cast<uint64_t>(pipeline_scheduler.max_threads), es);
			ExplainPropertyUInteger("Index Memory Reserved Bytes", NULL,
				static_cast<uint64_t>(
					pipeline_scheduler.index_memory_reserved_bytes), es);
			ExplainOpenGroup(
				"Highway SIMD Dispatch", "Highway SIMD Dispatch", true, es);
			ExplainPropertyText("Planned Architecture",
				highway_planned_architecture.c_str(), es);
			ExplainPropertyText("CPU-Supported Architectures",
				highway_cpu_supported_architectures.c_str(), es);
			ExplainPropertyText("Compiled Architectures",
				highway_compiled_architectures.c_str(), es);
			ExplainPropertyText("Runnable Architectures",
				highway_runnable_architectures.c_str(), es);
			if (top_level_query_highway_kernels.any()) {
				ExplainOpenGroup(
					"Planned Highway Functions",
					"Planned Highway Functions", false, es);
				for (std::size_t kernel_index = 0;
					 kernel_index
						< bioseq::simd_dispatch::highway_kernel_count;
					 ++kernel_index) {
					if (!top_level_query_highway_kernels[kernel_index]) continue;
					const auto kernel = static_cast<
						bioseq::simd_dispatch::HighwayKernelId>(kernel_index);
					const std::string_view function =
						bioseq::simd_dispatch::highway_kernel_name(kernel);
					const std::string function_text{function};
					ExplainOpenGroup("Highway Function", nullptr, true, es);
					ExplainPropertyText(
						"Function", function_text.c_str(), es);
					ExplainPropertyText(
						"Planned Architecture",
						highway_planned_architecture.c_str(), es);
					ExplainPropertyText("Stage", "query sketch", es);
					ExplainCloseGroup("Highway Function", nullptr, true, es);
				}
				ExplainCloseGroup(
					"Planned Highway Functions",
					"Planned Highway Functions", false, es);
			}
			if (explain_runtime != nullptr) {
				const auto& environment =
					explain_runtime->buffer.execution_stats().environment;
				if (environment.highway_executed_target_mixed) {
					ExplainPropertyText(
						"Executed Architecture", "mixed", es);
				} else if (environment.highway_executed_target != 0) {
					const std::string executed = HighwayTargetName(
						environment.highway_executed_target);
					ExplainPropertyText(
						"Executed Architecture", executed.c_str(), es);
				}
			}
			ExplainCloseGroup(
				"Highway SIMD Dispatch", "Highway SIMD Dispatch", true, es);
			if (has_pipeline_desc) {
				ExplainOpenGroup("Pipeline Stages", "Pipeline Stages", false, es);
				for (const auto& stage :
					aligner_snapshot->pipeline_desc->stages)
				{
					if (!stage.algorithm.has_value()
						&& !stage.extra_description.has_value())
					{
						continue;
					}
					// Each stage is an unlabeled object inside the "Pipeline
					// Stages" array: a labeled group here would emit
					// `[ "IndexStage": { ... } ]`, which is not valid JSON. The
					// stage name is preserved by the "Stage Name" property below.
					ExplainOpenGroup("Stage", nullptr, true, es);
					ExplainPropertyText("Stage Name",
						stage.stage_name.c_str(), es);
					if (stage.algorithm.has_value()) {
						const auto stage_highway_kernels =
							highway_kernels_for_stage(stage);
						ExplainPropertyText("Algorithm",
							stage.algorithm->name.c_str(), es);
						for (const auto& p : stage.algorithm->parameters) {
							ExplainPropertyText(p.name.c_str(),
								p.value.c_str(), es);
						}
						for (const auto& p : stage.algorithm->computed_properties) {
							ExplainPropertyText(p.name.c_str(),
								p.value.c_str(), es);
						}
						if (stage_highway_kernels.any()) {
							ExplainOpenGroup(
								"Highway Functions", "Highway Functions", false, es);
							for (std::size_t kernel_index = 0;
								kernel_index
									< bioseq::simd_dispatch::highway_kernel_count;
								++kernel_index) {
								if (!stage_highway_kernels[kernel_index]) {
									continue;
								}
								const auto kernel = static_cast<
									bioseq::simd_dispatch::HighwayKernelId>(kernel_index);
								const std::string_view function =
									bioseq::simd_dispatch::highway_kernel_name(kernel);
								const std::string function_text{function};
								ExplainOpenGroup("Highway Function", nullptr, true, es);
								ExplainPropertyText(
									"Function", function_text.c_str(), es);
								ExplainPropertyText(
									"Planned Architecture",
									highway_planned_architecture.c_str(), es);
								ExplainCloseGroup("Highway Function", nullptr, true, es);
							}
							ExplainCloseGroup(
								"Highway Functions", "Highway Functions", false, es);
						}
					} else if (stage.extra_description.has_value()) {
						ExplainPropertyText("Description",
							stage.extra_description->c_str(), es);
					}
					if (stage.estimated_batch_size.has_value()) {
						ExplainPropertyUInteger("Estimated Batch Size",
							NULL,
							static_cast<uint64_t>(*stage.estimated_batch_size),
							es);
					}
					ExplainCloseGroup("Stage", nullptr, true, es);
				}
				ExplainCloseGroup("Pipeline Stages", "Pipeline Stages", false, es);
			}
			ExplainCloseGroup("Bioseq Pipeline", "Bioseq Pipeline", true, es);
			if (explain_runtime != nullptr) {
				const auto& stats = explain_runtime->buffer.execution_stats();
				ExplainPipelineExecutionStats(
					stats, es, &params,
					aligner_snapshot->pipeline_desc.has_value()
						? &*aligner_snapshot->pipeline_desc : nullptr,
					QuerySketchPlanRouteFor(
						explain_index_read_requirement),
					/*highway_dispatch_already_rendered=*/true);
			}
		}
	}

	if (bioseq::settings::enable_column_cache)
	{
		ExplainOpenGroup("Cache", "Cache", true, es);
		if (es->format == EXPLAIN_FORMAT_TEXT)
		{
			appendStringInfoSpaces(es->str, es->indent * 2);
			appendStringInfo(es->str, "->  Cache\n");
			es->indent += 3;
		}

		BioseqColumnCacheStatistics *statistics = BioseqColumnGetCacheStatistics();

		ExplainPropertyUInteger(
			"Cache Hits",
			NULL,
			statistics->hits,
			es);

		ExplainPropertyUInteger(
			"Cache Misses",
			NULL,
			statistics->misses,
			es);

		ExplainPropertyUInteger(
			"Cache Evictions",
			NULL,
			statistics->evictions,
			es);

		ExplainPropertyUInteger(
			"Cache Writes",
			NULL,
			statistics->writes,
			es);

		ExplainPropertyUInteger(
			"Cache Maximum Size",
			NULL,
			statistics->maximumCacheSize,
			es);

		ExplainPropertyUInteger(
			"Cache Ending Size", 
			NULL, 
			statistics->endingCacheSize,
			es);

		ExplainPropertyUInteger(
			"Total Cache Entries",
			NULL,
			statistics->entries,
			es
		);
		ExplainCloseGroup("Cache", "Cache", true, es);
		if (es->format == EXPLAIN_FORMAT_TEXT)
		{
			es->indent -= 3;
		}
	}
}


/* Parallel Execution */

constexpr std::uint32_t kParallelBioseqColumnScanVersion = 3u;

[[nodiscard]] static slice_dsm_worker_header*
BioseqColumnParallelCounterSlot(
		ParallelBioseqColumnScan pscan, std::uint32_t slot_index,
		std::uint32_t expected_entry_count,
		std::uint32_t expected_slot_count) noexcept {
	if (pscan == nullptr
		|| pscan->version != kParallelBioseqColumnScanVersion
		|| pscan->entry_count != expected_entry_count
		|| pscan->slot_count != expected_slot_count
		|| slot_index >= pscan->slot_count
		|| pscan->counters_offset
			< MAXALIGN(offsetof(ParallelBioseqColumnScanData, snapshotData))) {
		return nullptr;
	}
	SliceProjectDsmLayout layout{};
	if (!slice_project_dsm_layout_noexcept(
			pscan->entry_count, pscan->slot_count, &layout)
		|| pscan->slot_stride != layout.slot_stride) return nullptr;
	return reinterpret_cast<slice_dsm_worker_header*>(
		reinterpret_cast<char*>(pscan) + pscan->counters_offset
		+ static_cast<Size>(slot_index) * pscan->slot_stride);
}

static Size 
BioseqColumn_EstimateDSMCustomScan(CustomScanState *node,
								   ParallelContext *pcxt)
{
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);
	if (pcxt == nullptr || pcxt->nworkers < 0) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan parallel context is invalid")));
	}
	const Size snapshot_end = add_size(
		offsetof(ParallelBioseqColumnScanData, snapshotData),
		EstimateSnapshotSpace(bioseqScanState->snapshot));
	const Size counters_offset = MAXALIGN(snapshot_end);
	const Size slot_count = add_size(
		static_cast<Size>(pcxt->nworkers), 1u);
	constexpr std::uint32_t entry_count = 0u;
	const Size slot_stride = MAXALIGN(add_size(
		sizeof(slice_dsm_worker_header),
		mul_size(entry_count, sizeof(slice_dsm_counter))));
	return add_size(counters_offset, mul_size(slot_count, slot_stride));
}


static void 
BioseqColumn_InitializeDSMCustomScan(CustomScanState *node,
								 ParallelContext *pcxt,
								 void *coordinate)
{
	ParallelBioseqColumnScan pscan = reinterpret_cast<ParallelBioseqColumnScan>(coordinate);
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);
	if (pcxt == nullptr || pcxt->nworkers < 0 || pscan == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan DSM initialization is invalid")));
	}
	const Size snapshot_end = add_size(
		offsetof(ParallelBioseqColumnScanData, snapshotData),
		EstimateSnapshotSpace(bioseqScanState->snapshot));
	const Size counters_offset = MAXALIGN(snapshot_end);
	const Size slot_count = add_size(
		static_cast<Size>(pcxt->nworkers), 1u);
	constexpr std::uint32_t entry_count = 0u;
	const Size slot_stride = MAXALIGN(add_size(
		sizeof(slice_dsm_worker_header),
		mul_size(entry_count, sizeof(slice_dsm_counter))));
	pscan->version = kParallelBioseqColumnScanVersion;
	pscan->counters_offset = counters_offset;
	pscan->entry_count = entry_count;
	pscan->slot_count = static_cast<std::uint32_t>(slot_count);
	pscan->slot_stride = slot_stride;
	std::memset(reinterpret_cast<char*>(pscan) + counters_offset, 0,
		mul_size(slot_count, slot_stride));
	
	/* 
	 * Serialize scan snapshot for workers so they see changes
	 * if we have flushed stripe / row_mask during this scan.
	 */
	SerializeSnapshot(bioseqScanState->snapshot, pscan->snapshotData);

	/* Stripe numbers are starting from index 1 */
	pg_atomic_init_u64(&pscan->nextStripeId, 1);

	if(parallel_leader_participation)
		bioseqScanState->parallelBioseqColumnScan = pscan;
	else
		bioseqScanState->parallelBioseqColumnScan = NULL;
}


static void 
BioseqColumn_ReinitializeDSMCustomScan(CustomScanState *node,
								   ParallelContext *pcxt,
								   void *coordinate)
{
	ParallelBioseqColumnScan pscan = reinterpret_cast<ParallelBioseqColumnScan>(coordinate);
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);
	if (pcxt == nullptr || pcxt->nworkers < 0 || pscan == nullptr
		|| pscan->slot_count
			!= static_cast<std::uint32_t>(pcxt->nworkers + 1)
		|| BioseqColumnParallelCounterSlot(
			pscan, 0u, pscan->entry_count, pscan->slot_count) == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan DSM reinitialization is invalid")));
	}

	/* Reset atomic nextStripeId to initial value */
	pg_atomic_init_u64(&pscan->nextStripeId, 1);
	std::memset(reinterpret_cast<char*>(pscan) + pscan->counters_offset, 0,
		mul_size(pscan->slot_count, pscan->slot_stride));

	if(parallel_leader_participation)
		bioseqScanState->parallelBioseqColumnScan = pscan;
	else
		bioseqScanState->parallelBioseqColumnScan = NULL;
}


static void 
BioseqColumn_InitializeWorkerCustomScan(CustomScanState *node,
									shm_toc *toc,
									void *coordinate)
{
	BioseqScanState* bioseqScanState = BioseqScanState::from_custom_scan_state(node);
	ParallelBioseqColumnScan pscan = reinterpret_cast<ParallelBioseqColumnScan>(coordinate);
	if (pscan == nullptr || pscan->slot_count == 0u
		|| ParallelWorkerNumber < 0
		|| static_cast<std::uint32_t>(ParallelWorkerNumber)
			>= pscan->slot_count - 1u
		|| BioseqColumnParallelCounterSlot(
			pscan, 1u + static_cast<std::uint32_t>(ParallelWorkerNumber),
			pscan->entry_count, pscan->slot_count) == nullptr) {
		ereport(ERROR,
			(errcode(ERRCODE_DATA_CORRUPTED),
			 errmsg("BioseqScan worker counter coordinate is invalid")));
	}
	bioseqScanState->parallelBioseqColumnScan = pscan;
	if (bioseqScanState->snapshotRegisteredByUs) {
		UnregisterSnapshot(bioseqScanState->snapshot);
		bioseqScanState->snapshotRegisteredByUs = false;
	}
	bioseqScanState->snapshot = RegisterSnapshot(
		RestoreSnapshot(pscan->snapshotData));
	bioseqScanState->snapshotRegisteredByUs = true;
	BioseqScanRuntime& runtime = bioseq_runtime(bioseqScanState);
	if (runtime.lazy_source_provider != nullptr) {
		bioseq::storage::rebind_pg_sequence_source_provider_snapshot(
			runtime.lazy_source_provider, bioseqScanState->snapshot);
	} else if (runtime.lazy_source_projection || runtime.locator_passthrough) {
		ereport(ERROR,
			(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
			 errmsg("BioseqScan worker source provider is unavailable")));
	}
	runtime.buffer.replace_executor_snapshot(bioseqScanState->snapshot);
}


/*
 * BioseqColumnPushdownClausesStr represents the clauses to push down as a string.
 */
static const char *
BioseqColumnPushdownClausesStr(List *context, List *clauses)
{
	Expr *conjunction;

	PList<Expr> clauseList{ clauses };
	Assert(clauseList.length() > 0);

	if (clauseList.length() == 1)
	{
		conjunction = clauseList.first();
	}
	else
	{
		conjunction = make_andclause(clauses);
	}

	bool useTableNamePrefix = false;
	bool showImplicitCast = false;
	return deparse_expression(reinterpret_cast<Node *>(conjunction), context,
							  useTableNamePrefix, showImplicitCast);
}


/*
 * BioseqColumnProjectedColumnsStr generates projected column string for
 * explain output.
 */
static const char *
BioseqColumnProjectedColumnsStr(List *context, List *projectedColumns)
{
	if (list_length(projectedColumns) == 0)
	{
		return "<columnar optimized out all columns>";
	}

	bool useTableNamePrefix = false;
	bool showImplicitCast = false;
	return deparse_expression(reinterpret_cast<Node *>(projectedColumns), context,
							  useTableNamePrefix, showImplicitCast);
}


/*
 * BioseqColumnVarNeeded returns a list of Var objects for the ones that are
 * needed during columnar custom scan.
 * Throws an error if finds a Var referencing to an attribute not supported
 * by BioseqColumnScan.
 */
static List *
BioseqColumnVarNeeded(BioseqScanState *bioseqScanState)
{
	ScanState *scanState = &bioseqScanState->custom_scanstate.ss;

	PList<Var> varList;

	PBitmapset neededAttrSet =
		BioseqColumnAttrNeeded(scanState, bioseqScanState->vectorization.vectorizedQualList);

	for (int bmsMember : neededAttrSet)
	{
		Relation bioseqColumnRelation = scanState->ss_currentRelation;

		/* neededAttrSet already represents 0-indexed attribute numbers */
		Form_pg_attribute columnForm =
			TupleDescAttr(RelationGetDescr(bioseqColumnRelation), bmsMember);
		if (columnForm->attisdropped)
		{
			bioseq_report<ERR, PG>().code(ERRCODE_UNDEFINED_COLUMN)
							.msg("cannot explain column with attrNum={} "
								 "of columnar table {} since it is dropped",
								 bmsMember + 1,
								 RelationGetRelationName(bioseqColumnRelation));
		}
		else if (columnForm->attnum <= 0)
		{
			/*
			 * BioseqColumnAttrNeeded should have already thrown an error for
			 * system columns. Similarly, it should have already expanded
			 * whole-row references to individual attributes.
			 */
			bioseq_report<ERR, PG>().code(ERRCODE_FEATURE_NOT_SUPPORTED)
							.msg("cannot explain column with attrNum={} "
								 "of columnar table {} since it is either "
								 "a system column or a whole-row "
								 "reference", columnForm->attnum,
								 RelationGetRelationName(bioseqColumnRelation));
		}


		/*
		 * varlevelsup is used to figure out the (query) level of the Var
		 * that we are investigating. Since we are dealing with a particular
		 * relation, it is useless here.
		 */
		Index varlevelsup = 0;

		CustomScan *customScan = reinterpret_cast<CustomScan *>(bioseqScanState->plan_state()->plan);
		Index scanrelid = customScan->scan.scanrelid;
		Var *var = makeVar(scanrelid, columnForm->attnum, columnForm->atttypid,
						   columnForm->atttypmod, columnForm->attcollation,
						   varlevelsup);
		varList.append(var);
	}

	return varList.release();
}


/*
 * set_deparse_context_planstate forwards to set_deparse_context_plan, going
 * through the PlanState* indirection that the EXPLAIN code already holds.
 */
static List *
set_deparse_context_planstate(List *dpcontext, Node *node, List *ancestors)
{
	PlanState *ps = reinterpret_cast<PlanState *>(node);
	return set_deparse_context_plan(dpcontext, ps->plan, ancestors);
}
