static void promote_slice_project_sources(
	BioseqScanState* state, TupleTableSlot* slot,
	MemoryContext result_context, bool allow_locator_passthrough,
	SliceProjectSourceSlotLayout layout, TupleDesc expected_descriptor);

/*
 * Centralised accessor: each BioseqScanState owns exactly one
 * BioseqScanRuntime, allocated by BeginCustomScan via
 * register_runtime_cleanup_callback and torn down by the per-query
 * MemoryContext reset callback. The runtime is held as `void*` on
 * BioseqScanState so the public scan-state header stays
 * standard-layout; this file is the only one that knows the concrete
 * BioseqScanRuntime type and casts back to it.
 *
 * If we somehow get here before BeginCustomScan fired (no current
 * call path does, but future hooks could regress) we lazy-allocate
 * without registering a cleanup callback — that allocation WILL
 * leak its std::vector / std::map storage on context teardown
 * because no callback is wired to call the destructor. The bioseq_log<DBG>
 * makes the regression loud so a future maintainer notices.
 */
[[nodiscard]] static BioseqScanRuntime& bioseq_runtime(BioseqScanState* state) {
	if (state->runtime == nullptr) {
		bioseq_log<DBG>("[bioseq] pg: bioseq_runtime() lazy-allocating runtime — BeginCustomScan did not fire first; this allocation will leak unless a cleanup callback is wired");
		state->runtime = static_cast<void*>(new BioseqScanRuntime{});
	}
	return *static_cast<BioseqScanRuntime*>(state->runtime);
}

/*
 * MemoryContext reset callback for BioseqScanRuntime. Postgres invokes
 * this when `estate->es_query_cxt` is destroyed — both on normal end
 * of query and on transaction abort. The callback is the safety net
 * that prevents leaks when an ereport(ERROR, ...) longjmps over
 * BioseqColumnScan_EndCustomScan.
 *
 * Important lifecycle constraint: the MemoryContextCallback struct
 * itself is embedded INSIDE the BioseqScanRuntime, so it must not be
 * freed before this callback fires. We therefore do NOT `delete
 * runtime_ptr` in EndCustomScan — that would dangle the callback
 * pointer in the context's reset-cb chain and crash on context
 * teardown. Instead EndCustomScan only releases per-tuple resources
 * (`buffer.clear_slots()`) while the per-query ResourceOwner is still
 * alive, sets `cleanup_done = true`, and lets this callback do the
 * actual delete when the context tears down.
 *
 * On the abort path (EndCustomScan never ran) we get `cleanup_done =
 * false` and must skip touching any Postgres tuple-table machinery
 * because the ResourceOwner is also being torn down. Postgres' own
 * bookkeeping handles the tuple-desc refcount cleanup; just freeing
 * the C++ heap is enough.
 */
static void bioseq_runtime_cleanup_callback(void* arg) {
	auto* state = static_cast<BioseqScanState*>(arg);
	if (state == nullptr || state->runtime == nullptr) {
		return;
	}
	auto* runtime_ptr = static_cast<BioseqScanRuntime*>(state->runtime);
	if (runtime_ptr->cleanup_done) {
		bioseq_log<DBG>("[bioseq] pg: bioseq_runtime_cleanup_callback() normal-path delete after EndCustomScan");
	} else {
		bioseq_log<DBG>("[bioseq] pg: bioseq_runtime_cleanup_callback() abort-path delete (slots not released)");
	}
	if (runtime_ptr->lazy_source_provider != nullptr) {
		bioseq::storage::close_pg_sequence_source_provider(
			runtime_ptr->lazy_source_provider,
			/*is_commit=*/runtime_ptr->cleanup_done);
		runtime_ptr->lazy_source_provider = nullptr;
	}
	if (runtime_ptr->lazy_trace_attachment != nullptr) {
		release_slice_trace_attachment(
			runtime_ptr->lazy_trace_attachment);
		runtime_ptr->lazy_trace_attachment = nullptr;
	}
	state->runtime = nullptr;
	delete runtime_ptr;
}

/*
 * Wire the cleanup callback so Postgres frees the runtime on
 * transaction abort. Idempotent — callable multiple times across
 * Begin / ReScan without effect; the callback list is keyed on the
 * MemoryContextCallback struct address, and we always pass the same
 * embedded address.
 */
static void register_runtime_cleanup_callback(BioseqScanState* state,
											  EState* estate)
{
	if (state == nullptr || estate == nullptr) {
		return;
	}
	BioseqScanRuntime& runtime = bioseq_runtime(state);
	if (runtime.owning_state == state) {
		return;  /* already registered */
	}
	runtime.owning_state             = state;
	runtime.memcontext_callback.func = bioseq_runtime_cleanup_callback;
	runtime.memcontext_callback.arg  = static_cast<void*>(state);
	MemoryContextRegisterResetCallback(estate->es_query_cxt,
									   &runtime.memcontext_callback);
}

/*
 * OIDs looked up from pg_proc for the bioseq extension's SQL stubs.
 * Resolved on demand via LookupStubOids() and cached by
 * get_cached_stub_oids() for the lifetime of a backend. The cache is
 * flushed on any relcache invalidation (which covers DROP/CREATE
 * EXTENSION re-registering the pg_proc rows with new OIDs).
 */
struct BioseqStubOids {
	Oid mmsearch_oid;
	Oid mmsearch_with_opts_oid;       // mmsearch(bioseq.seq, bioseq.seq, bioseq_aligner_options)
	Oid bioseq_seq_type_oid;          // resolves to bioseq.seq pg_type row
	Oid bioseq_aligner_options_type_oid;

	Oid score_oid;                    // bioseq.score (alias for dp_score)
	Oid dp_score_oid;
	Oid query_len_oid;
	Oid query_start_oid;
	Oid query_end_oid;
	Oid target_len_oid;
	Oid target_start_oid;
	Oid target_end_oid;
	Oid num_matches_oid;
	Oid block_length_oid;
	Oid edit_oid;
	Oid mapq_oid;
	Oid chain_score_oid;
	Oid dp_max_score_oid;
	Oid seed_count_oid;
	Oid secondary_chain_score_oid;
	Oid is_reverse_oid;
	Oid is_primary_oid;
	Oid has_cigar_oid;
	Oid divergence_oid;
	Oid cigar_oid;
	Oid symbol_count_oid;
	/* DOC0377 lazy sequence projection surface.  These are resolved by exact
	 * signatures; the planner never classifies an operation by its name. */
	Oid seq_concat_oid;
	Oid seq_concat_text_oid;
	Oid text_concat_seq_oid;
	Oid seq_concat_varchar_oid;
	Oid varchar_concat_seq_oid;
	Oid seq_concat_text_array_oid;
	Oid text_array_concat_seq_oid;
	Oid seq_concat_letter_array_oid;
	Oid letter_array_concat_seq_oid;
	Oid seq_reverse_oid;
	Oid seq_reverse_complement_oid;
	Oid seq_array_cat_oid;
	Oid seq_array_length_oid;
	Oid seq_cardinality_oid;
	Oid seq_to_text_oid;
	Oid seq_to_varchar_oid;
	Oid seq_to_array_oid;
	Oid seq_from_letter_array_infer_oid;
	Oid seq_from_letter_array_named_oid;
	Oid seq_len_oid;
	Oid seq_cast_oid;
};

/*
 * The create_upper_paths hook is live while CREATE EXTENSION is still
 * executing.  Its catalog surface is therefore allowed to be absent or only
 * partially installed.  These missing-ok probes are deliberately separate
 * from LookupStubOids(): the executor/planner hot paths retain the exact,
 * throwing lookup once the complete surface has been proven ready.
 */
[[nodiscard]] static Oid lookup_defined_type_missing_ok(
		const char* schema_name, const char* type_name) {
	const Oid namespace_oid = get_namespace_oid(
		schema_name, /*missing_ok=*/true);
	if (!OidIsValid(namespace_oid)) return InvalidOid;
	const Oid type_oid = GetSysCacheOid2(
		TYPENAMENSP, Anum_pg_type_oid,
		PointerGetDatum(type_name), ObjectIdGetDatum(namespace_oid));
	if (!OidIsValid(type_oid)) return InvalidOid;
	HeapTuple tuple = SearchSysCache1(TYPEOID, ObjectIdGetDatum(type_oid));
	if (!HeapTupleIsValid(tuple)) return InvalidOid;
	const bool is_defined =
		reinterpret_cast<Form_pg_type>(GETSTRUCT(tuple))->typisdefined;
	ReleaseSysCache(tuple);
	return is_defined ? type_oid : InvalidOid;
}

[[nodiscard]] static std::optional<std::string>
bioseq_extension_schema_missing_ok() {
	const Oid extension_oid = get_extension_oid(
		"bioseq", /*missing_ok=*/true);
	if (!OidIsValid(extension_oid)) return std::nullopt;
	const Oid namespace_oid = get_extension_schema(extension_oid);
	if (!OidIsValid(namespace_oid)) return std::nullopt;
	char* raw_name = get_namespace_name(namespace_oid);
	if (raw_name == nullptr) return std::nullopt;
	std::string result{raw_name};
	pfree(raw_name);
	return result;
}

[[nodiscard]] static Oid exact_function_oid(
		const char* schema_name, const char* function_name,
		std::initializer_list<Oid> argument_types,
		bool missing_ok) {
	for (const Oid argument_type : argument_types) {
		if (!OidIsValid(argument_type)) return InvalidOid;
	}
	List* qualified_name = list_make2(
		makeString(pstrdup(schema_name)),
		makeString(pstrdup(function_name)));
	const Oid function_oid = LookupFuncName(
		qualified_name, static_cast<int>(argument_types.size()),
		argument_types.begin(), missing_ok);
	list_free_deep(qualified_name);
	return function_oid;
}

[[nodiscard]] static bool exact_function_exists_missing_ok(
		const char* schema_name, const char* function_name,
		std::initializer_list<Oid> argument_types) {
	return OidIsValid(exact_function_oid(
		schema_name, function_name, argument_types,
		/*missing_ok=*/true));
}

[[nodiscard]] static bool bioseq_stub_oid_surface_ready() {
	const std::optional<std::string> extension_schema =
		bioseq_extension_schema_missing_ok();
	if (!extension_schema) return false;
	const Oid seq_oid = lookup_defined_type_missing_ok("bioseq", "seq");
	const Oid letter_oid = lookup_defined_type_missing_ok(
		"bioseq", "letter");
	const Oid options_oid = lookup_defined_type_missing_ok(
		extension_schema->c_str(), "bioseq_aligner_options");
	const Oid letter_array_oid = OidIsValid(letter_oid)
		? get_array_type(letter_oid) : InvalidOid;
	if (!OidIsValid(seq_oid) || !OidIsValid(letter_oid)
		|| !OidIsValid(options_oid) || !OidIsValid(letter_array_oid)) {
		return false;
	}

	if (!exact_function_exists_missing_ok(
			extension_schema->c_str(), "mmsearch", {seq_oid, seq_oid})
		|| !exact_function_exists_missing_ok(
			extension_schema->c_str(), "mmsearch",
			{seq_oid, seq_oid, options_oid})
		|| !exact_function_exists_missing_ok(
			"bioseq", "symbol_count", {seq_oid, TEXTOID})) {
		return false;
	}

	constexpr std::array<const char*, 21> projection_functions{
		"score", "dp_score", "query_len", "query_start", "query_end",
		"target_len", "target_start", "target_end", "num_matches",
		"block_length", "edit", "mapq", "chain_score", "dp_max_score",
		"seed_count", "secondary_chain_score", "is_reverse", "is_primary",
		"has_cigar", "divergence", "cigar"
	};
	for (const char* function_name : projection_functions) {
		if (!exact_function_exists_missing_ok(
				"bioseq", function_name, {ANYELEMENTOID})) {
			return false;
		}
	}

	return exact_function_exists_missing_ok(
			"bioseq", "seq_concat", {seq_oid, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "seq_concat_text", {seq_oid, TEXTOID})
		&& exact_function_exists_missing_ok(
			"bioseq", "text_concat_seq", {TEXTOID, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "seq_concat_varchar", {seq_oid, VARCHAROID})
		&& exact_function_exists_missing_ok(
			"bioseq", "varchar_concat_seq", {VARCHAROID, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "seq_concat_text_array", {seq_oid, TEXTARRAYOID})
		&& exact_function_exists_missing_ok(
			"bioseq", "text_array_concat_seq", {TEXTARRAYOID, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "seq_concat_letter_array", {seq_oid, letter_array_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "letter_array_concat_seq", {letter_array_oid, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "reverse", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "reverse_complement", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "array_cat", {seq_oid, seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "array_length", {seq_oid, INT4OID})
		&& exact_function_exists_missing_ok(
			"bioseq", "cardinality", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "to_text", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "to_varchar", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "to_array", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "from_array", {letter_array_oid, INT4OID})
		&& exact_function_exists_missing_ok(
			"bioseq", "from_array", {letter_array_oid, TEXTOID, INT4OID})
		&& exact_function_exists_missing_ok(
			"bioseq", "len", {seq_oid})
		&& exact_function_exists_missing_ok(
			"bioseq", "seq_cast", {seq_oid, INT4OID, BOOLOID});
}

/*
 * LookupStubOids resolves all bioseq stub OIDs via regprocedurein,
 * which raises ereport(ERROR, ...) if any function is missing. We
 * assume CREATE EXTENSION bioseq has already succeeded before any
 * path below runs. Prefer get_cached_stub_oids() on the hot path —
 * this builder is kept public so the cache can repopulate on
 * relcache invalidation.
 */
[[nodiscard]] static BioseqStubOids LookupStubOids() {
	BioseqStubOids result{};
	auto resolve = [](const char* signature) {
		return DatumGetObjectId(DirectFunctionCall1(regprocedurein,
			CStringGetDatum(signature)));
	};
	auto resolve_type = [](const char* type_name) {
		return DatumGetObjectId(DirectFunctionCall1(regtypein,
			CStringGetDatum(type_name)));
	};
	const std::optional<std::string> extension_schema =
		bioseq_extension_schema_missing_ok();
	if (!extension_schema) {
		ereport(
			ERROR,
			(errcode(ERRCODE_UNDEFINED_OBJECT),
			 errmsg("bioseq extension installation schema is unavailable")));
	}
	const Oid seq_type_oid = resolve_type("bioseq.seq");
	const Oid aligner_options_type_oid =
		lookup_defined_type_missing_ok(
			extension_schema->c_str(), "bioseq_aligner_options");
	if (!OidIsValid(aligner_options_type_oid)) {
		ereport(
			ERROR,
			(errcode(ERRCODE_UNDEFINED_OBJECT),
			 errmsg("bioseq aligner options type is unavailable")));
	}
	result.mmsearch_oid = exact_function_oid(
		extension_schema->c_str(), "mmsearch",
		{seq_type_oid, seq_type_oid}, /*missing_ok=*/false);
	result.mmsearch_with_opts_oid = exact_function_oid(
		extension_schema->c_str(), "mmsearch",
		{seq_type_oid, seq_type_oid, aligner_options_type_oid},
		/*missing_ok=*/false);
	result.bioseq_seq_type_oid       = seq_type_oid;
	result.bioseq_aligner_options_type_oid =
		aligner_options_type_oid;
	result.score_oid                 = resolve("bioseq.score(anyelement)");
	result.dp_score_oid              = resolve("bioseq.dp_score(anyelement)");
	result.query_len_oid             = resolve("bioseq.query_len(anyelement)");
	result.query_start_oid           = resolve("bioseq.query_start(anyelement)");
	result.query_end_oid             = resolve("bioseq.query_end(anyelement)");
	result.target_len_oid            = resolve("bioseq.target_len(anyelement)");
	result.target_start_oid          = resolve("bioseq.target_start(anyelement)");
	result.target_end_oid            = resolve("bioseq.target_end(anyelement)");
	result.num_matches_oid           = resolve("bioseq.num_matches(anyelement)");
	result.block_length_oid          = resolve("bioseq.block_length(anyelement)");
	result.edit_oid                  = resolve("bioseq.edit(anyelement)");
	result.mapq_oid                  = resolve("bioseq.mapq(anyelement)");
	result.chain_score_oid           = resolve("bioseq.chain_score(anyelement)");
	result.dp_max_score_oid          = resolve("bioseq.dp_max_score(anyelement)");
	result.seed_count_oid            = resolve("bioseq.seed_count(anyelement)");
	result.secondary_chain_score_oid = resolve("bioseq.secondary_chain_score(anyelement)");
	result.is_reverse_oid            = resolve("bioseq.is_reverse(anyelement)");
	result.is_primary_oid            = resolve("bioseq.is_primary(anyelement)");
	result.has_cigar_oid             = resolve("bioseq.has_cigar(anyelement)");
	result.divergence_oid            = resolve("bioseq.divergence(anyelement)");
	result.cigar_oid                 = resolve("bioseq.cigar(anyelement)");
	result.symbol_count_oid          = resolve("bioseq.symbol_count(bioseq.seq, text)");
	result.seq_concat_oid = resolve(
		"bioseq.seq_concat(bioseq.seq,bioseq.seq)");
	result.seq_concat_text_oid = resolve(
		"bioseq.seq_concat_text(bioseq.seq,text)");
	result.text_concat_seq_oid = resolve(
		"bioseq.text_concat_seq(text,bioseq.seq)");
	result.seq_concat_varchar_oid = resolve(
		"bioseq.seq_concat_varchar(bioseq.seq,character varying)");
	result.varchar_concat_seq_oid = resolve(
		"bioseq.varchar_concat_seq(character varying,bioseq.seq)");
	result.seq_concat_text_array_oid = resolve(
		"bioseq.seq_concat_text_array(bioseq.seq,text[])");
	result.text_array_concat_seq_oid = resolve(
		"bioseq.text_array_concat_seq(text[],bioseq.seq)");
	result.seq_concat_letter_array_oid = resolve(
		"bioseq.seq_concat_letter_array(bioseq.seq,bioseq.letter[])");
	result.letter_array_concat_seq_oid = resolve(
		"bioseq.letter_array_concat_seq(bioseq.letter[],bioseq.seq)");
	result.seq_reverse_oid = resolve("bioseq.reverse(bioseq.seq)");
	result.seq_reverse_complement_oid = resolve(
		"bioseq.reverse_complement(bioseq.seq)");
	result.seq_array_cat_oid = resolve(
		"bioseq.array_cat(bioseq.seq,bioseq.seq)");
	result.seq_array_length_oid = resolve(
		"bioseq.array_length(bioseq.seq,integer)");
	result.seq_cardinality_oid = resolve(
		"bioseq.cardinality(bioseq.seq)");
	result.seq_to_text_oid = resolve("bioseq.to_text(bioseq.seq)");
	result.seq_to_varchar_oid = resolve("bioseq.to_varchar(bioseq.seq)");
	result.seq_to_array_oid = resolve("bioseq.to_array(bioseq.seq)");
	result.seq_from_letter_array_infer_oid = resolve(
		"bioseq.from_array(bioseq.letter[],integer)");
	result.seq_from_letter_array_named_oid = resolve(
		"bioseq.from_array(bioseq.letter[],text,integer)");
	result.seq_len_oid = resolve("bioseq.len(bioseq.seq)");
	result.seq_cast_oid = resolve(
		"bioseq.seq_cast(bioseq.seq,integer,boolean)");
	return result;
}

/*
 * Per-backend cache for BioseqStubOids. The prior implementation called
 * LookupStubOids() from every planner path entry (AddBioseqColumnScanPath,
 * CustomExecScan first-call init, ExplainCustomScan) — that is ~22
 * regprocedurein syscache hits per query. The cache is backed by pg_proc and
 * pg_type syscache invalidation, plus relcache invalidation for relation-driven
 * replans, so DROP/CREATE EXTENSION in one backend flushes the resolved OIDs
 * before the next lookup.
 */
struct CachedStubOids {
	BioseqStubOids oids{};
	bool           initialised = false;
};
static CachedStubOids g_cached_stub_oids{};

static void invalidate_cached_stub_oids(Datum /*arg*/, Oid /*relid*/) {
	g_cached_stub_oids.initialised = false;
}

static void invalidate_cached_stub_oids_syscache(Datum /*arg*/, int /*cacheid*/,
												 uint32 /*hashvalue*/) {
	g_cached_stub_oids.initialised = false;
}

[[nodiscard]] static bool oid_exists_in_syscache(int cache_id, Oid oid) {
	if (!OidIsValid(oid)) {
		return false;
	}
	HeapTuple tuple = SearchSysCache1(cache_id, bioseq::pg_utils::pg_datum::from_oid(oid).raw());
	if (!HeapTupleIsValid(tuple)) {
		return false;
	}
	ReleaseSysCache(tuple);
	return true;
}

[[nodiscard]] static bool cached_stub_oids_are_valid(const BioseqStubOids& o) {
	const Oid func_oids[] = {
		o.mmsearch_oid,
		o.mmsearch_with_opts_oid,
		o.score_oid,
		o.dp_score_oid,
		o.query_len_oid,
		o.query_start_oid,
		o.query_end_oid,
		o.target_len_oid,
		o.target_start_oid,
		o.target_end_oid,
		o.num_matches_oid,
		o.block_length_oid,
		o.edit_oid,
		o.mapq_oid,
		o.chain_score_oid,
		o.dp_max_score_oid,
		o.seed_count_oid,
		o.secondary_chain_score_oid,
		o.is_reverse_oid,
		o.is_primary_oid,
		o.has_cigar_oid,
		o.divergence_oid,
		o.cigar_oid,
		o.symbol_count_oid,
		o.seq_concat_oid,
		o.seq_concat_text_oid,
		o.text_concat_seq_oid,
		o.seq_concat_varchar_oid,
		o.varchar_concat_seq_oid,
		o.seq_concat_text_array_oid,
		o.text_array_concat_seq_oid,
		o.seq_concat_letter_array_oid,
		o.letter_array_concat_seq_oid,
		o.seq_reverse_oid,
		o.seq_reverse_complement_oid,
		o.seq_array_cat_oid,
		o.seq_array_length_oid,
		o.seq_cardinality_oid,
		o.seq_to_text_oid,
		o.seq_to_varchar_oid,
		o.seq_to_array_oid,
		o.seq_from_letter_array_infer_oid,
		o.seq_from_letter_array_named_oid,
		o.seq_len_oid,
		o.seq_cast_oid,
	};
	for (const Oid oid : func_oids) {
		if (!oid_exists_in_syscache(PROCOID, oid)) {
			return false;
		}
	}
	return oid_exists_in_syscache(TYPEOID, o.bioseq_seq_type_oid)
		&& oid_exists_in_syscache(
			TYPEOID, o.bioseq_aligner_options_type_oid);
}

[[nodiscard]] static const BioseqStubOids& get_cached_stub_oids() {
	if (g_cached_stub_oids.initialised
		&& cached_stub_oids_are_valid(g_cached_stub_oids.oids)) {
		return g_cached_stub_oids.oids;
	}
	static bool invalidation_registered = false;
	if (!invalidation_registered) {
		CacheRegisterRelcacheCallback(invalidate_cached_stub_oids,
									  PointerGetDatum(NULL));
		CacheRegisterSyscacheCallback(PROCOID,
									  invalidate_cached_stub_oids_syscache,
									  PointerGetDatum(NULL));
		CacheRegisterSyscacheCallback(TYPEOID,
									  invalidate_cached_stub_oids_syscache,
									  PointerGetDatum(NULL));
		invalidation_registered = true;
	}
	g_cached_stub_oids.oids        = LookupStubOids();
	g_cached_stub_oids.initialised = true;
	return g_cached_stub_oids.oids;
}

/* Planner hooks use this entrypoint while CREATE/DROP EXTENSION can expose a
 * partial catalog surface. A partial probe neither calls the throwing lookup
 * nor marks the cache initialized. */
[[nodiscard]] static const BioseqStubOids*
try_get_cached_stub_oids() {
	if (g_cached_stub_oids.initialised
		&& cached_stub_oids_are_valid(g_cached_stub_oids.oids)) {
		return &g_cached_stub_oids.oids;
	}
	g_cached_stub_oids.initialised = false;
	if (!bioseq_stub_oid_surface_ready()) return nullptr;
	return &get_cached_stub_oids();
}

/* Bitmapsets of relation ids contain only concrete range-table indexes.
 * PostgreSQL 17 represents INNER/OUTER/INDEX/ROWID_VAR with negative special
 * varnos (stored through the unsigned Index type), so every Var consumer must
 * apply this predicate before passing varno to bms_is_member() or rt_fetch(). */
[[nodiscard]] static constexpr bool bioseq_is_concrete_rte_varno(
		const Index varno) noexcept {
	return varno != 0 && !IS_SPECIAL_VARNO(varno);
}
static_assert(bioseq_is_concrete_rte_varno(1));
static_assert(!bioseq_is_concrete_rte_varno(0));
static_assert(!bioseq_is_concrete_rte_varno(
	static_cast<Index>(INNER_VAR)));
static_assert(!bioseq_is_concrete_rte_varno(
	static_cast<Index>(OUTER_VAR)));
static_assert(!bioseq_is_concrete_rte_varno(
	static_cast<Index>(INDEX_VAR)));
static_assert(!bioseq_is_concrete_rte_varno(
	static_cast<Index>(ROWID_VAR)));

/*
 * Classifier used by planner ownership and BeginCustomScan discovery. Returns
 * true if funcid
 * matches any of the bioseq projection stubs (i.e. anything that
 * VarInjectorMutator will rewrite into a placeholder Const).
 */
/*
 * Accepts either the 2-arg mmsearch(seq, seq) or the 3-arg
 * mmsearch(seq, seq, bioseq_aligner_options). Call sites care about
 * "is this a match qual" rather than the arity, so funnelling both
 * overloads here avoids scattering the same disjunction everywhere.
 */
[[nodiscard]] static inline bool is_mmsearch_funcid(Oid funcid, const BioseqStubOids& o) {
	return funcid == o.mmsearch_oid || funcid == o.mmsearch_with_opts_oid;
}

struct RawMmsearchOptionsValidation {
	const BioseqStubOids* oids = nullptr;
};

[[nodiscard]] static inline bool is_volatile_sql_function(
		const Oid function_oid) {
	HeapTuple procedure_tuple = SearchSysCache1(
		PROCOID, ObjectIdGetDatum(function_oid));
	if (!HeapTupleIsValid(procedure_tuple)) return false;
	const Form_pg_proc procedure = reinterpret_cast<Form_pg_proc>(
		GETSTRUCT(procedure_tuple));
	const bool result = procedure->provolatile == PROVOLATILE_VOLATILE
		&& procedure->prolang == SQLlanguageId;
	ReleaseSysCache(procedure_tuple);
	return result;
}

static inline bool contains_volatile_sql_function_node(
	Node* node, void* context);

[[nodiscard]] static inline bool contains_volatile_sql_function_query(
		Query* query, void* context) {
	return query != nullptr && query_tree_walker(
		query, contains_volatile_sql_function_node, context,
		QTW_EXAMINE_RTES_BEFORE);
}

[[nodiscard]] static inline bool contains_volatile_sql_function_node(
		Node* node, void* context) {
	if (node == nullptr) return false;
	if (FuncExpr* expression = pg_node_try_as<FuncExpr>(node);
		expression != nullptr
		&& is_volatile_sql_function(expression->funcid)) return true;
	if (IsA(node, RangeTblEntry)) {
		/* query_tree_walker owns traversal of RTE expressions and subqueries. */
		return false;
	}
	if (Query* query = pg_node_try_as<Query>(node)) {
		return contains_volatile_sql_function_query(query, context);
	}
	return expression_tree_walker(
		node, contains_volatile_sql_function_node, context);
}

/* Identify only volatile SQL functions whose wrapper provenance can be lost
 * when standard_planner simplifies their options subtree.  This catalog walk
 * inspects nodes without invoking any expression. */
[[nodiscard]] static inline bool contains_volatile_sql_function(
		Node* expression) {
	return contains_volatile_sql_function_node(expression, nullptr);
}

static inline bool validate_raw_mmsearch_options_node(
	Node* node, RawMmsearchOptionsValidation* validation);

static inline void validate_raw_mmsearch_options_query(
	Query* query, RawMmsearchOptionsValidation* validation)
{
	if (query == nullptr) {
		return;
	}
	(void)query_tree_walker(
		query, validate_raw_mmsearch_options_node, validation,
		QTW_EXAMINE_RTES_BEFORE);
}

static inline bool validate_raw_mmsearch_options_node(
	Node* node, RawMmsearchOptionsValidation* validation)
{
	if (node == nullptr) {
		return false;
	}
	if (FuncExpr* expression = pg_node_try_as<FuncExpr>(node);
		expression != nullptr
		&& is_mmsearch_funcid(expression->funcid, *validation->oids)
		&& expression->funcid == validation->oids->mmsearch_with_opts_oid
		&& list_length(expression->args) == 3) {
		Node* options = reinterpret_cast<Node*>(
			list_nth(expression->args, 2));
		if (contains_volatile_sql_function(options)) {
			ereport(ERROR,
				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
				 errmsg("mmsearch qualifier is not owned by a Bioseq executor"),
				 errdetail("Volatile aligner options cannot be reduced to a statement-stable executor-owned value."),
				 errhint("Pass a constant bioseq_aligner_options value as the third argument.")));
		}
	}
	if (IsA(node, RangeTblEntry)) {
		/* query_tree_walker owns traversal of RTE expressions and subqueries. */
		return false;
	}
	if (IsA(node, Query)) {
		validate_raw_mmsearch_options_query(
			castNode(Query, node), validation);
		return false;
	}
	return expression_tree_walker(
		node, validate_raw_mmsearch_options_node, validation);
}

/* Called by the top-level planner hook while the analyzed Query still retains
 * SQL-function volatility.  standard_planner simplification may erase that
 * provenance by replacing the wrapper with its constant body. */
export void bioseq_validate_raw_mmsearch_options(Query* query)
{
	const BioseqStubOids* oids = try_get_cached_stub_oids();
	if (query == nullptr || oids == nullptr) {
		return;
	}
	RawMmsearchOptionsValidation validation{oids};
	validate_raw_mmsearch_options_query(query, &validation);
}

struct MmsearchQualifierWalker {
	const BioseqStubOids* oids = nullptr;
};

struct mmsearch_qualifier_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, MmsearchQualifierWalker& data) const {
		if (FuncExpr* fe = node.try_as<FuncExpr>()) {
			if (is_mmsearch_funcid(fe->funcid, *data.oids)) {
				return pg_walk_step::stop;
			}
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool
contains_mmsearch_qualifier(Node* node, const BioseqStubOids& oids)
{
	MmsearchQualifierWalker data{ &oids };
	mmsearch_qualifier_visitor visitor;
	return pg_walk_expression_including_root(node, data, visitor);
}

struct MmsearchOccurrenceCounter {
	const BioseqStubOids* oids = nullptr;
	std::size_t count = 0;
};

struct mmsearch_occurrence_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node,
			   MmsearchOccurrenceCounter& data) const {
		if (FuncExpr* fe = node.try_as<FuncExpr>();
			fe != nullptr && is_mmsearch_funcid(fe->funcid, *data.oids)) {
			++data.count;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static std::size_t
count_mmsearch_occurrences(Node* node, const BioseqStubOids& oids)
{
	MmsearchOccurrenceCounter data{ &oids, 0 };
	mmsearch_occurrence_visitor visitor;
	pg_walk_expression_including_root(node, data, visitor);
	return data.count;
}

struct OwnedMmsearchRestriction {
	RestrictInfo* restriction = nullptr;
	FuncExpr* normalized_expr = nullptr;
	List* extra_restrictions = NIL;
	List* extra_normalized_exprs = NIL;
};

/* Cheap prefilter used by the early clause-ownership pass.  The complete
 * grammar/nulling/type proof lives beside the per-row recipe validator (which
 * is declared later in this translation unit); this predicate only keeps a
 * potentially base-local sequence expression alive until that exact proof can
 * run in AddBioseqColumnScanPath.  Volatility inside an operand is deliberately
 * not rejected: the expression remains at its original baserel frontier and is
 * evaluated once by its authoritative ExprState. */
[[nodiscard]] static bool coarse_base_mmsearch_operand_candidate(
		Node* expression, RelOptInfo* rel, const BioseqStubOids& oids,
		const bool require_sequence_var) {
	if (expression == nullptr || rel == nullptr
		|| exprType(expression) != oids.bioseq_seq_type_oid
		|| expression_returns_set(expression)
		|| contain_subplans(expression)) return false;
	constexpr int pull_flags = PVC_RECURSE_AGGREGATES
		| PVC_RECURSE_WINDOWFUNCS | PVC_RECURSE_PLACEHOLDERS;
	List* variables = pull_var_clause(expression, pull_flags);
	bool saw_sequence_var = false;
	bool valid = true;
	for (Var* variable : PList<Var>(variables)) {
		if (variable == nullptr
			|| !bioseq_is_concrete_rte_varno(variable->varno)
			|| variable->varno != rel->relid
			|| variable->varattno <= 0 || variable->varlevelsup != 0
			|| !bms_is_empty(variable->varnullingrels)) {
			valid = false;
			break;
		}
		if (variable->vartype == oids.bioseq_seq_type_oid) {
			saw_sequence_var = true;
		}
	}
	list_free(variables);
	return valid && (!require_sequence_var || saw_sequence_var);
}

[[nodiscard]] static bool
bounded_batch_fallback_options_are_supported(
	FuncExpr* primary, FuncExpr* extra, const BioseqStubOids& oids);

/*
 * Choose the bounded RestrictInfo set the custom scan is allowed to execute:
 * either one semantic call, or the narrow BatchJoin-fallback shape consisting
 * of an ordinary-relation outer Var primary plus one same-target Const base
 * filter.  The decision is deliberately made against the original planner
 * nodes: their pointer identities are the proof later used to remove only
 * these restrictions from executable quals and to prune competing paths that
 * would execute them.
 */
[[nodiscard]] static OwnedMmsearchRestriction
choose_owned_mmsearch_restriction(PlannerInfo* root, RelOptInfo* rel,
								 RangeTblEntry* rte, List* restrictions,
								 List* ppi_restrictions,
								 Relids param_relids,
								 const BioseqStubOids& oids)
{
	std::size_t semantic_calls = 0;
	List* semantic_restrictions = NIL;
	for (RestrictInfo* rinfo : PList<RestrictInfo>(restrictions)) {
		const std::size_t in_clause = count_mmsearch_occurrences(
			reinterpret_cast<Node*>(rinfo->clause), oids);
		semantic_calls += in_clause;
		if (in_clause != 0) semantic_restrictions = lappend(
			semantic_restrictions, rinfo);
	}
	if (semantic_calls == 0 || semantic_restrictions == NIL) {
		return {};
	}
	if (semantic_calls != static_cast<std::size_t>(
			list_length(semantic_restrictions))) {
		/* More than one occurrence inside one Boolean expression is never the
		 * narrow Param-primary/Const-extra ownership shape below. */
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("stacked mmsearch qualifiers are unsupported"),
			 errhint("Split the alignment predicates into separate query levels.")));
	}

	/* Fail closed under row-level security, security-barrier quals, leaky
	 * ordering, pseudoconstants, or volatile siblings. */
	if (root == nullptr || root->parse == nullptr || root->parse->hasRowSecurity
		|| rte == nullptr || rte->securityQuals != NIL) {
		return {};
	}
	for (RestrictInfo* sibling : PList<RestrictInfo>(restrictions)) {
		if (!list_member_ptr(semantic_restrictions, sibling)
			&& contain_volatile_functions(
				reinterpret_cast<Node*>(sibling->clause))) {
			return {};
		}
	}

	/* A parameterized baserel candidate can rendezvous restrictions from any
	 * number of higher owners.  Provenance, not operand syntax, decides whether
	 * this candidate may classify them together. */
	if (semantic_calls > 1u) {
		/* Walk PostgreSQL Lists directly.  Do not retain a std::vector (or any
		 * other nontrivial C++ owner) across ereport(ERROR): PostgreSQL's longjmp
		 * would skip its destructor in the backend. */
		for (ListCell* current_cell = list_head(semantic_restrictions);
				 current_cell != nullptr;
				 current_cell = lnext(semantic_restrictions, current_cell)) {
			RestrictInfo* current = reinterpret_cast<RestrictInfo*>(
				lfirst(current_cell));
			FuncExpr* current_expression = current == nullptr ? nullptr
				: pg_node_try_as<FuncExpr>(reinterpret_cast<Node*>(
					current->clause));
			const bool exact_expression = current_expression != nullptr
				&& is_mmsearch_funcid(current_expression->funcid, oids)
				&& ((current_expression->funcid == oids.mmsearch_oid
						&& list_length(current_expression->args) == 2)
					|| (current_expression->funcid
							== oids.mmsearch_with_opts_oid
						&& list_length(current_expression->args) == 3));
			const bool current_base = current != nullptr
				&& list_member_ptr(rel->baserestrictinfo, current);
			const bool current_ppi = current != nullptr
				&& list_member_ptr(ppi_restrictions, current);
			if (!exact_expression || current_base == current_ppi
				|| current->required_relids == nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("stacked mmsearch qualifiers are unsupported"),
					 errhint("Split the alignment predicates into separate query levels.")));
			}

			for (ListCell* prior_cell = list_head(semantic_restrictions);
					 prior_cell != current_cell;
					 prior_cell = lnext(semantic_restrictions, prior_cell)) {
				RestrictInfo* prior = reinterpret_cast<RestrictInfo*>(
					lfirst(prior_cell));
				const bool prior_base = list_member_ptr(
					rel->baserestrictinfo, prior);
				if (current_base == prior_base
					&& bms_equal(current->required_relids,
						prior->required_relids)) {
					ereport(ERROR,
						(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
						 errmsg("stacked mmsearch qualifiers are unsupported"),
						 errdetail("Two semantic mmsearch calls share one ownership frontier."),
						 errhint("Split the alignment predicates into separate query levels.")));
				}
			}
		}

		bool legacy_bounded_fallback_candidate = false;
		if (semantic_calls == 2u) {
			RestrictInfo* first = reinterpret_cast<RestrictInfo*>(
				linitial(semantic_restrictions));
			RestrictInfo* second = reinterpret_cast<RestrictInfo*>(
				lsecond(semantic_restrictions));
			const bool first_base = list_member_ptr(
				rel->baserestrictinfo, first);
			const bool second_base = list_member_ptr(
				rel->baserestrictinfo, second);
			if (first_base != second_base) {
				RestrictInfo* base_restriction = first_base ? first : second;
				RestrictInfo* ppi_restriction = first_base ? second : first;
				FuncExpr* base_expression = pg_node_try_as<FuncExpr>(
					reinterpret_cast<Node*>(base_restriction->clause));
				FuncExpr* ppi_expression = pg_node_try_as<FuncExpr>(
					reinterpret_cast<Node*>(ppi_restriction->clause));
				Node* base_target = reinterpret_cast<Node*>(
					linitial(base_expression->args));
				Node* base_query = reinterpret_cast<Node*>(
					lsecond(base_expression->args));
				Node* ppi_target = reinterpret_cast<Node*>(
					linitial(ppi_expression->args));
				Node* ppi_query = reinterpret_cast<Node*>(
					lsecond(ppi_expression->args));
				Var* ppi_query_var = pg_node_try_as<Var>(ppi_query);
				Const* base_query_const = pg_node_try_as<Const>(base_query);
				legacy_bounded_fallback_candidate =
					pg_node_try_as<Var>(base_target) != nullptr
					&& pg_node_try_as<Var>(ppi_target) != nullptr
					&& equal(base_target, ppi_target)
					&& base_query_const != nullptr
					&& base_query_const->consttype
						== oids.bioseq_seq_type_oid
					&& ppi_query_var != nullptr
					&& ppi_query_var->varlevelsup == 0
					&& ppi_query_var->varattno > 0
					&& ppi_query_var->vartype
						== oids.bioseq_seq_type_oid
					&& bms_is_empty(ppi_query_var->varnullingrels)
					&& bms_is_member(
						static_cast<int>(ppi_query_var->varno),
						param_relids);
			}
		}
		if (!legacy_bounded_fallback_candidate) return {};
	}

	RestrictInfo* primary_restriction = nullptr;
	FuncExpr* primary_expr = nullptr;
	RestrictInfo* constant_restriction = nullptr;
	FuncExpr* constant_expr = nullptr;
	for (RestrictInfo* semantic_restriction :
			PList<RestrictInfo>(semantic_restrictions)) {
		/* Nested Boolean/CASE/NOT shapes are not equivalent to a consumed,
		 * strict top-level predicate and therefore remain executable SQL quals. */
		FuncExpr* original = pg_node_try_as<FuncExpr>(
			reinterpret_cast<Node*>(semantic_restriction->clause));
		if (original == nullptr || !is_mmsearch_funcid(original->funcid, oids)
			|| semantic_restriction->pseudoconstant
			|| semantic_restriction->security_level != 0
			|| !restriction_is_securely_promotable(
				semantic_restriction, rel)) return {};
		const int arity = list_length(original->args);
		if ((original->funcid == oids.mmsearch_oid && arity != 2)
			|| (original->funcid == oids.mmsearch_with_opts_oid
				&& arity != 3)) return {};
		pg_first_two_node_args args = pg_first_two_args_if_arity_between(
			*original, 2, 3);
		Node* target_node = args.present() ? args.first : nullptr;
		Var* target = pg_node_try_as<Var>(target_node);
		const bool raw_target = target != nullptr
			&& target->varlevelsup == 0
			&& target->varno == rel->relid && target->varattno > 0
			&& bms_is_empty(target->varnullingrels)
			&& target->vartype == oids.bioseq_seq_type_oid
			&& target->vartypmod >= 0;
		if (!raw_target && !coarse_base_mmsearch_operand_candidate(
				target_node, rel, oids,
				/*require_sequence_var=*/true)) return {};

		Node* query = args.second;
		Const* query_constant = pg_node_try_as<Const>(query);
		const bool constant_query = query_constant != nullptr
			&& query_constant->consttype == oids.bioseq_seq_type_oid
			&& query_constant->consttypmod >= 0;
		bool parameterized_query = false;
		if (!constant_query) {
			if (Param* param = pg_node_try_as<Param>(query)) {
				parameterized_query = param->paramtype
					== oids.bioseq_seq_type_oid
					&& (param->paramkind == PARAM_EXEC
						|| param->paramkind == PARAM_EXTERN)
					&& (param->paramtypmod >= 0
						|| param->paramkind == PARAM_EXTERN);
			} else if (Var* query_var = pg_node_try_as<Var>(query)) {
				const bool concrete_varno = bioseq_is_concrete_rte_varno(
					query_var->varno);
				const bool same_relation = concrete_varno
					&& query_var->varno == rel->relid;
				const bool available_outer = concrete_varno
					&& bms_is_member(static_cast<int>(query_var->varno),
						param_relids);
				parameterized_query = query_var->varlevelsup == 0
					&& query_var->varattno > 0
					&& query_var->vartype == oids.bioseq_seq_type_oid
					&& query_var->vartypmod >= 0
					&& (same_relation || available_outer);
				/* A same-relation per-row query remains a valid sole owner, but
				 * cannot be combined with a constant extra: the dispatcher has one
				 * dynamic primary slot and the bounded stacked contract is specifically
				 * the parameterized join case. */
				if (same_relation && semantic_calls == 2) {
					parameterized_query = false;
				}
			} else {
				/* A complete base-local query recipe (slice/concat/reverse,
				 * CASE/COALESCE, dynamic bounds, or an opaque effectful arm) is
				 * evaluated once per row after the target.  The later exact proof
				 * validates every Var/nulling frontier and derives its bound type. */
				parameterized_query = semantic_calls == 1
					&& coarse_base_mmsearch_operand_candidate(
						query, rel, oids,
						/*require_sequence_var=*/false);
			}
		}
		if (!constant_query && !parameterized_query) {
			if (semantic_calls == 2) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("stacked mmsearch qualifiers are unsupported"),
					 errdetail("Only one parameterized mmsearch plus one constant filter on the same target column can share a Bioseq scan.")));
			}
			return {};
		}

		FuncExpr* normalized = copyObject(original);
		if (arity == 3) {
			Node* option = reinterpret_cast<Node*>(list_nth(
				normalized->args, 2));
			if (contain_volatile_functions(option)) return {};
			Node* folded = eval_const_expressions(root, option);
			Const* option_const = pg_node_try_as<Const>(folded);
			if (option_const == nullptr || option_const->consttype
					!= oids.bioseq_aligner_options_type_oid) return {};
			lfirst(list_nth_cell(normalized->args, 2)) = folded;
		}
		if (constant_query) {
			if (constant_expr != nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("stacked mmsearch qualifiers are unsupported"),
					 errdetail("Two constant mmsearch filters cannot share one MatchResult owner.")));
			}
			constant_restriction = semantic_restriction;
			constant_expr = normalized;
		} else {
			if (primary_expr != nullptr) {
				ereport(ERROR,
					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
					 errmsg("stacked mmsearch qualifiers are unsupported"),
					 errdetail("Two dynamic mmsearch filters cannot share one MatchResult owner.")));
			}
			primary_restriction = semantic_restriction;
			primary_expr = normalized;
		}
	}

	if (semantic_calls == 1) {
		return primary_expr != nullptr
			? OwnedMmsearchRestriction{
				primary_restriction, primary_expr, NIL, NIL}
			: OwnedMmsearchRestriction{
				constant_restriction, constant_expr, NIL, NIL};
	}
	Node* primary_target = primary_expr == nullptr ? nullptr
		: reinterpret_cast<Node*>(linitial(primary_expr->args));
	Node* constant_target = constant_expr == nullptr ? nullptr
		: reinterpret_cast<Node*>(linitial(constant_expr->args));
	Node* primary_query = primary_expr == nullptr
		|| list_length(primary_expr->args) < 2 ? nullptr
		: reinterpret_cast<Node*>(lsecond(primary_expr->args));
	Node* constant_query = constant_expr == nullptr
		|| list_length(constant_expr->args) < 2 ? nullptr
		: reinterpret_cast<Node*>(lsecond(constant_expr->args));
	Var* primary_query_var = pg_node_try_as<Var>(primary_query);
	Const* constant_query_value = pg_node_try_as<Const>(constant_query);
	RangeTblEntry* primary_query_rte = primary_query_var == nullptr
		|| !bioseq_is_concrete_rte_varno(primary_query_var->varno)
		|| primary_query_var->varno > static_cast<Index>(
			list_length(root->parse->rtable))
		? nullptr : rt_fetch(primary_query_var->varno, root->parse->rtable);
	/* Preserve the established general stacked-qualifier rejection.  The sole
	 * admitted exception is the BatchJoin fallback contract: an explicitly
	 * require-absent primary over an outer Var from an ordinary relation becomes
	 * PARAM_EXEC for a Bioseq target scan whose same target column also has one
	 * non-NULL, default-options Const filter.  Both calls therefore share the
	 * exact biological parameters, while require-absent is a valid execution of
	 * the extra's default "allow" index policy.  A second Bioseq relation,
	 * PARAM_EXTERN, same-row Var, view/subquery, security-qualified provider,
	 * NULL extra, or independent option set remains unsupported; accepting those
	 * would silently broaden the generic multi-owner surface beyond the one
	 * executor shape that has an AND-stack runtime and integration contract. */
	const bool bounded_batch_fallback = primary_query_var != nullptr
		&& bms_is_member(static_cast<int>(primary_query_var->varno),
			param_relids)
		&& constant_query_value != nullptr
		&& !constant_query_value->constisnull
		&& primary_query_rte != nullptr
		&& primary_query_rte->rtekind == RTE_RELATION
		&& primary_query_rte->securityQuals == NIL
		&& OidIsValid(primary_query_rte->relid)
		&& !IsBioseqColumnTableAmTable(primary_query_rte->relid)
		&& bounded_batch_fallback_options_are_supported(
			primary_expr, constant_expr, oids);
	if (primary_restriction == nullptr || primary_expr == nullptr
		|| constant_restriction == nullptr || constant_expr == nullptr
		|| !equal(primary_target, constant_target)
		|| !bounded_batch_fallback) {
		ereport(ERROR,
			(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
			 errmsg("stacked mmsearch qualifiers are unsupported"),
			 errdetail("Only one parameterized mmsearch plus one constant filter on the same target column can share a Bioseq scan."),
			 errhint("Split the alignment predicates into separate query levels.")));
	}
	return OwnedMmsearchRestriction{
		primary_restriction, primary_expr,
		list_make1(constant_restriction), list_make1(constant_expr)};
}

[[nodiscard]] static List*
restrictions_without_owned_mmsearch(List* restrictions, List* owned,
								 bool restrictions_are_private_copies)
{
	PList<RestrictInfo> result;
	for (RestrictInfo* rinfo : PList<RestrictInfo>(restrictions)) {
		bool is_owned = false;
		for (RestrictInfo* owner : PList<RestrictInfo>(owned)) {
			if (rinfo == owner || (restrictions_are_private_copies
				&& owner != nullptr
				&& equal(rinfo->clause, owner->clause))) {
				is_owned = true;
				break;
			}
		}
		if (is_owned) continue;
		result.append(rinfo);
	}
	return result.release();
}

/*
 * The owned mmsearch is removed before these storage quals are built. Keep a
 * defensive filter at the reader boundary so an unowned/nested rendezvous
 * expression can never be mistaken for a min/max pruning predicate.
 */
[[nodiscard]] static List*
storage_prunable_quals_without_mmsearch(List* quals, const BioseqStubOids& oids)
{
	PList<Node> filtered;
	for (auto qual : PList<Node>(quals)) {
		if (qual == nullptr) {
			continue;
		}
		if (contains_mmsearch_qualifier(qual, oids)) {
			continue;
		}
		filtered.append(qual);
	}
	return filtered.release();
}

[[nodiscard]] static inline bool is_bioseq_projection_funcid(Oid funcid, const BioseqStubOids& o) {
	return funcid == o.score_oid
		|| funcid == o.dp_score_oid
		|| funcid == o.query_len_oid
		|| funcid == o.query_start_oid
		|| funcid == o.query_end_oid
		|| funcid == o.target_len_oid
		|| funcid == o.target_start_oid
		|| funcid == o.target_end_oid
		|| funcid == o.num_matches_oid
		|| funcid == o.block_length_oid
		|| funcid == o.edit_oid
		|| funcid == o.mapq_oid
		|| funcid == o.chain_score_oid
		|| funcid == o.dp_max_score_oid
		|| funcid == o.seed_count_oid
		|| funcid == o.secondary_chain_score_oid
		|| funcid == o.is_reverse_oid
		|| funcid == o.is_primary_oid
		|| funcid == o.has_cigar_oid
		|| funcid == o.divergence_oid
		|| funcid == o.cigar_oid;
}

/* `anyelement` match helpers traditionally accept a target-owned row marker
 * such as the primary key.  When bioseq.edit is instead given a bioseq.seq
 * Var, that Var carries biological meaning and must be the exact sequence
 * column aligned by mmsearch; silently substituting another column's helper
 * with the shared MatchResult edit count would return a plausible wrong value. */
[[nodiscard]] static bool edit_sequence_argument_matches_target(
		const FuncExpr* function,
		Index target_relid,
		AttrNumber target_sequence_attno,
		const BioseqStubOids& oids) noexcept {
	if (function == nullptr || function->funcid != oids.edit_oid) return true;
	if (list_length(function->args) != 1) return false;
	Node* argument_node = reinterpret_cast<Node*>(linitial(function->args));
	if (argument_node == nullptr
		|| exprType(argument_node) != oids.bioseq_seq_type_oid) {
		/* Preserve the established target-owned row-marker helper form. */
		return true;
	}
	Var* argument = pg_node_try_as<Var>(argument_node);
	if (argument == nullptr) {
		/* A sequence-valued wrapper (COALESCE, cast, PHV expression, etc.)
		 * has biological identity that the shared MatchResult cannot safely
		 * infer.  Only the exact mmsearch target Var is supported. */
		return false;
	}
	return target_relid != 0
		&& target_sequence_attno > 0
		&& argument->varno == target_relid
		&& argument->varattno == target_sequence_attno
		&& argument->varlevelsup == 0
		&& bms_is_empty(argument->varnullingrels);
}

/* A transformed target has biological identity in its complete canonical
 * recipe, not merely in the first storage Var below that recipe.  Preserve the
 * legacy raw-Var check above for base scans, while allowing bioseq.edit() to
 * name the exact owned transformed expression. */
[[nodiscard]] static bool edit_sequence_argument_matches_recipe(
		const FuncExpr* function,
		Node* target_expression,
		Index target_relid,
		AttrNumber target_sequence_attno,
		const BioseqStubOids& oids) noexcept {
	if (function == nullptr || function->funcid != oids.edit_oid) return true;
	if (list_length(function->args) != 1 || target_expression == nullptr) {
		return false;
	}
	Node* argument = reinterpret_cast<Node*>(linitial(function->args));
	/* A sequence-valued helper argument is biological identity, not a legacy
	 * row marker.  It must name the complete owned recipe; accepting the raw
	 * storage Var of a sliced/reversed/concatenated target would silently report
	 * the transformed match as if it belonged to the whole stored sequence. */
	if (argument != nullptr
		&& exprType(argument) == oids.bioseq_seq_type_oid) {
		return equal(argument, target_expression);
	}
	/* Only non-sequence legacy row-marker spellings reach the historical
	 * target-owned fallback.  The surrounding helper registration has already
	 * proved that such a Var belongs to target_relid. */
	return edit_sequence_argument_matches_target(
		function, target_relid, target_sequence_attno, oids);
}

/*
 * Walk a target list for bioseq.* function calls and set the matching
 * feature-flags. We also recurse into arg subtrees so "bioseq.cigar(a) + 1"
 * is still counted. The shape used for detection matches the shape used by
 * VarInjectorMutator so the flags agree with which placeholders actually
 * populate at execution time.
 */
struct BioseqFeatureDetector {
	const BioseqStubOids* oids = nullptr;
	BioseqScanFeatureFlags flags;
};

struct feature_flag_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, BioseqFeatureDetector& detector) const {
		if (FuncExpr* fe = node.try_as<FuncExpr>()) {
			const BioseqStubOids* o = detector.oids;
			if (is_mmsearch_funcid(fe->funcid, *o)) {
				detector.flags.has_mmsearch = true;
			}
			if (fe->funcid == o->cigar_oid || fe->funcid == o->has_cigar_oid) {
				detector.flags.uses_cigar = true;
			}
			if (fe->funcid == o->edit_oid) {
				detector.flags.uses_edit = true;
			}
			if (fe->funcid == o->divergence_oid) {
				detector.flags.uses_divergence = true;
			}
			if (fe->funcid == o->mapq_oid) {
				detector.flags.uses_mapq = true;
			}
			if (is_bioseq_projection_funcid(fe->funcid, *o)) {
				detector.flags.any_match_projection = true;
			}
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static BioseqScanFeatureFlags
detect_feature_flags(List* targetlist, List* qual, const BioseqStubOids& oids)
{
	BioseqFeatureDetector detector{ &oids, BioseqScanFeatureFlags{} };
	feature_flag_visitor visitor;
	for (auto tgt : PList<TargetEntry>(targetlist)) {
		if (tgt == nullptr) {
			continue;
		}
		pg_walk_expression_including_root(pg_as_node(tgt->expr), detector, visitor);
	}
	for (auto q : PList<Node>(qual)) {
		if (q == nullptr) {
			continue;
		}
		pg_walk_expression_including_root(q, detector, visitor);
	}
	return detector.flags;
}

constexpr int kBioseqEditPredicateMagic = 0x42534531; /* BSE1 */
constexpr int kBioseqEditPredicateVersion = 1;

struct StrictEditPredicate {
	std::int64_t exclusive_upper_bound = 0;
	AttrNumber sequence_attno = InvalidAttrNumber;
};

struct EditFunctionProbe {
	const BioseqStubOids* oids = nullptr;
	bool found = false;
};

struct edit_function_probe_visitor {
	[[nodiscard]] pg_walk_step operator()(
		pg_expression_walk_cursor, pg_node_view node,
		EditFunctionProbe& probe) const {
		if (FuncExpr* function = node.try_as<FuncExpr>();
			function != nullptr && function->funcid == probe.oids->edit_oid) {
			probe.found = true;
			return pg_walk_step::stop;
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static bool contains_bioseq_edit(
		Node* expression, const BioseqStubOids& oids) {
	if (expression == nullptr) return false;
	EditFunctionProbe probe{&oids, false};
	edit_function_probe_visitor visitor;
	pg_walk_expression_including_root(expression, probe, visitor);
	return probe.found;
}

/* Supported SQL contract: one top-level `bioseq.edit(Var) < integer Const`.
 * The predicate is removed from the pre-alignment qual and enforced against
 * MatchResult::edit_distance while draining aligned output. */
[[nodiscard]] static Node* strict_edit_operand(
		Node* operand, Index scan_relid) noexcept {
	PlaceHolderVar* placeholder = pg_node_try_as<PlaceHolderVar>(operand);
	if (placeholder == nullptr) return operand;
	/* bioseq_placeholder_support introduces this exact wrapper for aggregate
	 * and join plans.  Accept only a scan-owned, non-nulled PHV; unwrapping a
	 * generic or outer-join-nullable PHV would discard planner semantics. */
	if (!bioseq_is_concrete_rte_varno(scan_relid)
		|| placeholder->phid == 0 || placeholder->phlevelsup != 0
		|| !bms_is_empty(placeholder->phnullingrels)
		|| bms_num_members(placeholder->phrels) != 1
		|| !bms_is_member(static_cast<int>(scan_relid), placeholder->phrels)) {
		return nullptr;
	}
	return reinterpret_cast<Node*>(placeholder->phexpr);
}

[[nodiscard]] static std::optional<StrictEditPredicate>
decode_strict_edit_upper_bound(
		Node* expression, Index scan_relid, const BioseqStubOids& oids) {
	OpExpr* comparison = pg_node_try_as<OpExpr>(expression);
	if (comparison == nullptr || comparison->opresulttype != BOOLOID
		|| list_length(comparison->args) != 2) {
		return std::nullopt;
	}
	PList<Node> arguments(comparison->args);
	FuncExpr* edit = pg_node_try_as<FuncExpr>(
		strict_edit_operand(arguments.first(), scan_relid));
	Const* upper = pg_node_try_as<Const>(arguments.second());
	if (edit == nullptr || edit->funcid != oids.edit_oid
		|| edit->funcresulttype != INT8OID || list_length(edit->args) != 1
		|| upper == nullptr || upper->constisnull) {
		return std::nullopt;
	}
	/* Operator names are schema-overloadable.  A bare SQL literal such as 10
	 * is int4, so PostgreSQL resolves BIGINT < 10 to its built-in int84lt
	 * implementation rather than inserting an int8 cast.  Accept only the
	 * three exact built-in RHS integer widths and normalize their Const datum;
	 * an arbitrary operator merely named `<` must remain fail-closed. */
	const Oid opcode = get_opcode(comparison->opno);
	std::int64_t exclusive_upper_bound = 0;
	switch (upper->consttype) {
	case INT8OID:
		if (opcode != F_INT8LT) return std::nullopt;
		exclusive_upper_bound = DatumGetInt64(upper->constvalue);
		break;
	case INT4OID:
		if (opcode != F_INT84LT) return std::nullopt;
		exclusive_upper_bound = static_cast<std::int64_t>(
			DatumGetInt32(upper->constvalue));
		break;
	case INT2OID:
		if (opcode != F_INT82LT) return std::nullopt;
		exclusive_upper_bound = static_cast<std::int64_t>(
			DatumGetInt16(upper->constvalue));
		break;
	default:
		return std::nullopt;
	}
	Var* sequence = pg_node_try_as<Var>(
		reinterpret_cast<Node*>(linitial(edit->args)));
	if (sequence == nullptr || sequence->varno != scan_relid
		|| sequence->varattno <= 0 || sequence->varlevelsup != 0
		|| !bms_is_empty(sequence->varnullingrels)
		|| sequence->vartype != oids.bioseq_seq_type_oid) {
		return std::nullopt;
	}
	return StrictEditPredicate{
		.exclusive_upper_bound = exclusive_upper_bound,
		.sequence_attno = sequence->varattno,
	};
}

[[nodiscard]] static List* quals_without_bioseq_edit(
		List* quals, const BioseqStubOids& oids) {
	PList<Node> filtered;
	for (Node* qual : PList<Node>(quals)) {
		if (qual != nullptr && !contains_bioseq_edit(qual, oids)) {
			filtered.append(qual);
		}
	}
	return filtered.release();
}

/* Planner baserestrictinfo is a List<RestrictInfo>, not an expression list.
 * Expression walkers deliberately do not know how to descend RestrictInfo
 * (PostgreSQL reports "unrecognized node type"), so unwrap only the exact
 * clause field and fail closed if a future planner shape violates that ABI. */
[[nodiscard]] static std::optional<BioseqScanFeatureFlags>
detect_restrictinfo_feature_flags(
		List* restrictions,
		const BioseqStubOids& oids) {
	BioseqFeatureDetector detector{&oids, BioseqScanFeatureFlags{}};
	feature_flag_visitor visitor;
	for (Node* node : PList<Node>(restrictions)) {
		RestrictInfo* restriction = pg_node_try_as<RestrictInfo>(node);
		if (restriction == nullptr || restriction->clause == nullptr) {
			return std::nullopt;
		}
		pg_walk_expression_including_root(
			reinterpret_cast<Node*>(restriction->clause), detector, visitor);
	}
	return detector.flags;
}

/*
 * DOC0279 — plan-time detection of an mmsearch typmod-coalesce (same alphabet,
 * different storage width between the bioseq.seq column and the query literal).
 *
 * BioseqColumnScan_ExplainCustomScan needs this because the "coalesce to
 * seq('<alpha>', <bits>)" hint used to be surfaced from the runtime buffer
 * (`coalesce_active()`), which is ONLY populated when BeginCustomScan ran —
 * i.e. NOT for `EXPLAIN` without `ANALYZE`. The coalesce decision is, however,
 * fully determined at plan time by the column Var's typmod vs the literal's
 * typmod, so we re-derive it from the plan qual here. Mirrors the BeginCustomScan
 * typmod logic (same `compact_sequence_stdc_type_params::decode`), reading no
 * runtime state. A mismatch we cannot classify simply yields `active=false`
 * (no hint, never a crash).
 */
struct ExplainTypmodCoalesce { bool active = false; uint8_t col_alpha = 0; uint8_t col_byte_width = 0; };
struct ExplainCoalesceWalkCtx { const BioseqStubOids* oids; ExplainTypmodCoalesce result; };

struct typmod_coalesce_visitor {
	[[nodiscard]] pg_walk_step
	operator()(pg_expression_walk_cursor, pg_node_view node, ExplainCoalesceWalkCtx& ctx) const {
		if (!ctx.result.active) {
			if (FuncExpr* fe = node.try_as<FuncExpr>()) {
				if (is_mmsearch_funcid(fe->funcid, *ctx.oids) && list_length(fe->args) >= 2) {
					Node* arg0 = reinterpret_cast<Node*>(linitial(fe->args));   // bioseq.seq column
					Node* arg1 = reinterpret_cast<Node*>(lsecond(fe->args));    // query literal / param / var
					if (arg0 != nullptr && arg1 != nullptr && pg_node_view{arg0}.is<Var>()) {
						const int32 col_typmod = pg_node_expect<Var>(arg0)->vartypmod;
						int32 arg1_typmod = -1;
						if (Const* arg1_const = pg_node_try_as<Const>(arg1)) {
							arg1_typmod = arg1_const->consttypmod;
						} else if (Param* arg1_param = pg_node_try_as<Param>(arg1)) {
							arg1_typmod = arg1_param->paramtypmod;
						} else if (Var* arg1_var = pg_node_try_as<Var>(arg1)) {
							arg1_typmod = arg1_var->vartypmod;
						}
						if (col_typmod >= 0 && arg1_typmod >= 0) {
							const auto col = compact_sequence_stdc_type_params::decode(col_typmod);
							const auto qry = compact_sequence_stdc_type_params::decode(arg1_typmod);
							if (col.alphabet_code == qry.alphabet_code
								&& col.storage_unit_byte_width != qry.storage_unit_byte_width) {
								ctx.result.active = true;
								ctx.result.col_alpha = col.alphabet_code;
								ctx.result.col_byte_width = col.storage_unit_byte_width;
							}
						}
					}
				}
			}
		}
		return pg_walk_step::descend;
	}
};

[[nodiscard]] static ExplainTypmodCoalesce
explain_detect_typmod_coalesce(List* qual, const BioseqStubOids& oids)
{
	ExplainCoalesceWalkCtx ctx{ &oids, ExplainTypmodCoalesce{} };
	typmod_coalesce_visitor visitor;
	for (auto q : PList<Node>(qual)) {
		if (q != nullptr) {
			pg_walk_expression_including_root(q, ctx, visitor);
		}
	}
	return ctx.result;
}

/*
 * Snapshot the bioseq.aligner.* GUCs into a Minimap2Params struct.
 * A subsequent pass (parse_aligner_options_override) may overlay per-call
 * fields that the user supplied via aligner_options() in the mmsearch
 * FuncExpr. Keeping the two passes separate makes the precedence order
 * obvious: GUC → aligner_options() override → size-heuristic → pipeline.
 */
[[nodiscard]] static bioseq::simd::Minimap2Params
build_params_from_gucs()
{
	bioseq::simd::Minimap2Params params;
	params.kmer_size        = bioseq::aligner::settings::kmer_size;
	params.window_size      = bioseq::aligner::settings::window_size;
	params.max_gap          = bioseq::aligner::settings::max_gap;
	params.max_gap_ref      = bioseq::aligner::settings::max_gap_ref;
	params.bandwidth        = bioseq::aligner::settings::bandwidth;
	params.max_chain_skip   = bioseq::aligner::settings::max_chain_skip;
	params.max_chain_iter   = bioseq::aligner::settings::max_chain_iter;
	params.min_seed_count   = bioseq::aligner::settings::min_seed_count;
	params.min_chain_score  = bioseq::aligner::settings::min_chain_score;
	params.chain_gap_scale  = static_cast<float>(bioseq::aligner::settings::chain_gap_scale);
	params.chain_skip_scale = static_cast<float>(bioseq::aligner::settings::chain_skip_scale);
	params.mask_level       = static_cast<float>(bioseq::aligner::settings::mask_level);
	params.mask_len         = bioseq::aligner::settings::mask_len;
	params.pri_ratio        = static_cast<float>(bioseq::aligner::settings::pri_ratio);
	params.best_n           = bioseq::aligner::settings::best_n;
	params.match_score      = bioseq::aligner::settings::match_score;
	params.mismatch_pen     = bioseq::aligner::settings::mismatch_pen;
	params.gap_open1        = bioseq::aligner::settings::gap_open1;
	params.gap_ext1         = bioseq::aligner::settings::gap_ext1;
	params.gap_open2        = bioseq::aligner::settings::gap_open2;
	params.gap_ext2         = bioseq::aligner::settings::gap_ext2;
	params.sc_ambi          = bioseq::aligner::settings::sc_ambi;
	params.zdrop            = bioseq::aligner::settings::zdrop;
	params.end_bonus        = bioseq::aligner::settings::end_bonus;
	params.max_occ          = bioseq::aligner::settings::max_occ;
	params.mid_occ          = bioseq::aligner::settings::mid_occ;
	params.block_min_size   = static_cast<size_t>(bioseq::aligner::settings::block_min_size);
	params.block_max_size   = static_cast<size_t>(bioseq::aligner::settings::block_max_size);
	params.bandwidth_long   = bioseq::aligner::settings::bandwidth_long;
	params.chaining_algorithm =
		static_cast<bioseq::simd::ChainingAlgorithmType>(
			static_cast<int>(bioseq::aligner::settings::chaining_algorithm.value()));
	params.base_alignment_algorithm =
		static_cast<bioseq::simd::BaseAlignmentAlgorithmType>(
			static_cast<int>(bioseq::aligner::settings::base_alignment_algorithm.value()));
	params.minimizer_algorithm =
		static_cast<bioseq::simd::MinimizerAlgorithmType>(
			static_cast<int>(bioseq::aligner::settings::minimizer_algorithm.value()));
	params.enable_profiling = bioseq::aligner::settings::enable_profiling;
	params.vulkan_enabled = bioseq::aligner::settings::vulkan_enabled;
	params.vulkan_seed_hits_enabled = bioseq::aligner::settings::vulkan_seed_hits_enabled;
	params.vulkan_index_cache_enabled = bioseq::aligner::settings::vulkan_index_cache_enabled;
	/* DOC0310 Phase C — resident two-submit frontend + GPU index build. */
	params.vulkan_fused_frontend_enabled = bioseq::aligner::settings::vulkan_fused_frontend_enabled;
	params.vulkan_gpu_index_build_enabled = bioseq::aligner::settings::vulkan_gpu_index_build_enabled;
	params.vulkan_extend_enabled = bioseq::aligner::settings::vulkan_extend_enabled;
	params.vulkan_phase_c_tile_bp =
		static_cast<uint32_t>(bioseq::aligner::settings::vulkan_phase_c_tile_bp);
	params.vulkan_phase_c_radix_bits =
		static_cast<uint32_t>(bioseq::aligner::settings::vulkan_phase_c_radix_bits);
	return params;
}

/*
 * Versioned, self-describing result-semantic snapshot for BioseqScan.
 *
 * The payload is one named List embedded in CustomScan.custom_private:
 *
 *   ["semantic_payload", INT4(version), INT4(field_count), fields...]
 *
 * Every scalar is a typed PostgreSQL Const so copyObject(), prepared-plan
 * storage, parallel plan transfer, and node serialization retain the exact
 * value without any process-local C++ pointer.  Floating-point parameters are
 * stored as their exact IEEE-754 binary32 bits in an INT8 Const.
 */
constexpr char kBioseqSemanticPayloadName[] = "semantic_payload";
constexpr std::int32_t kBioseqSemanticPayloadFormatVersion = 1;
constexpr std::int32_t kBioseqSemanticPayloadFieldCount = 42;
constexpr int kBioseqSemanticPayloadHeaderNodes = 3;

enum class BioseqSemanticField : int {
	kmer_size = 0,
	window_size,
	max_gap,
	max_gap_ref,
	bandwidth,
	max_chain_skip,
	max_chain_iter,
	min_seed_count,
	min_chain_score,
	chain_gap_scale,
	chain_skip_scale,
	mask_level,
	mask_len,
	pri_ratio,
	best_n,
	match_score,
	mismatch_pen,
	gap_open1,
	gap_ext1,
	gap_open2,
	gap_ext2,
	sc_ambi,
	zdrop,
	end_bonus,
	max_occ,
	mid_occ,
	block_min_size,
	block_max_size,
	bandwidth_long,
	chaining_algorithm,
	base_alignment_algorithm,
	minimizer_algorithm,
	vulkan_enabled,
	vulkan_seed_hits_enabled,
	vulkan_index_cache_enabled,
	vulkan_fused_frontend_enabled,
	vulkan_gpu_index_build_enabled,
	vulkan_extend_enabled,
	vulkan_phase_c_tile_bp,
	vulkan_phase_c_radix_bits,
	read_sequence_index,
	index_read_requirement,
};

static_assert(
	static_cast<int>(BioseqSemanticField::index_read_requirement) + 1
	== kBioseqSemanticPayloadFieldCount);

struct FrozenBioseqScanSemantics {
	bioseq::simd::Minimap2Params params{};
	bool read_sequence_index = false;
	bioseq::indexing::IndexReadRequirement index_read_requirement =
		bioseq::indexing::IndexReadRequirement::allow;
};

[[nodiscard]] static Const* make_semantic_int4_const(
		const std::int32_t value) {
	return makeConst(
		INT4OID, -1, InvalidOid, sizeof(std::int32_t),
		Int32GetDatum(value), false, true);
}

[[nodiscard]] static Const* make_semantic_int8_const(
		const std::int64_t value) {
	return makeConst(
		INT8OID, -1, InvalidOid, sizeof(std::int64_t),
		Int64GetDatum(value), false, FLOAT8PASSBYVAL);
}

[[nodiscard]] static Const* make_semantic_bool_const(const bool value) {
	return makeConst(
		BOOLOID, -1, InvalidOid, sizeof(bool),
		BoolGetDatum(value), false, true);
}

[[nodiscard]] static Const* make_semantic_float_bits_const(
		const float value) {
	const std::uint32_t bits = std::bit_cast<std::uint32_t>(value);
	return make_semantic_int8_const(static_cast<std::int64_t>(bits));
}

[[nodiscard]] static List* make_bioseq_semantic_payload(
		const FrozenBioseqScanSemantics& semantics) {
	const auto& params = semantics.params;
	List* payload = list_make3(
		makeString(pstrdup(kBioseqSemanticPayloadName)),
		make_semantic_int4_const(kBioseqSemanticPayloadFormatVersion),
		make_semantic_int4_const(kBioseqSemanticPayloadFieldCount));
	payload = lappend(payload, make_semantic_int8_const(params.kmer_size));
	payload = lappend(payload, make_semantic_int8_const(params.window_size));
	payload = lappend(payload, make_semantic_int8_const(params.max_gap));
	payload = lappend(payload, make_semantic_int8_const(params.max_gap_ref));
	payload = lappend(payload, make_semantic_int8_const(params.bandwidth));
	payload = lappend(payload, make_semantic_int8_const(params.max_chain_skip));
	payload = lappend(payload, make_semantic_int8_const(params.max_chain_iter));
	payload = lappend(payload, make_semantic_int8_const(params.min_seed_count));
	payload = lappend(payload, make_semantic_int8_const(params.min_chain_score));
	payload = lappend(
		payload, make_semantic_float_bits_const(params.chain_gap_scale));
	payload = lappend(
		payload, make_semantic_float_bits_const(params.chain_skip_scale));
	payload = lappend(payload, make_semantic_float_bits_const(params.mask_level));
	payload = lappend(payload, make_semantic_int8_const(params.mask_len));
	payload = lappend(payload, make_semantic_float_bits_const(params.pri_ratio));
	payload = lappend(payload, make_semantic_int8_const(params.best_n));
	payload = lappend(payload, make_semantic_int8_const(params.match_score));
	payload = lappend(payload, make_semantic_int8_const(params.mismatch_pen));
	payload = lappend(payload, make_semantic_int8_const(params.gap_open1));
	payload = lappend(payload, make_semantic_int8_const(params.gap_ext1));
	payload = lappend(payload, make_semantic_int8_const(params.gap_open2));
	payload = lappend(payload, make_semantic_int8_const(params.gap_ext2));
	payload = lappend(payload, make_semantic_int8_const(params.sc_ambi));
	payload = lappend(payload, make_semantic_int8_const(params.zdrop));
	payload = lappend(payload, make_semantic_int8_const(params.end_bonus));
	payload = lappend(payload, make_semantic_int8_const(params.max_occ));
	payload = lappend(payload, make_semantic_int8_const(params.mid_occ));
	payload = lappend(
		payload,
		make_semantic_int8_const(static_cast<std::int64_t>(
			params.block_min_size)));
	payload = lappend(
		payload,
		make_semantic_int8_const(static_cast<std::int64_t>(
			params.block_max_size)));
	payload = lappend(payload, make_semantic_int8_const(params.bandwidth_long));
	payload = lappend(
		payload,
		make_semantic_int4_const(static_cast<std::int32_t>(
			params.chaining_algorithm)));
	payload = lappend(
		payload,
		make_semantic_int4_const(static_cast<std::int32_t>(
			params.base_alignment_algorithm)));
	payload = lappend(
		payload,
		make_semantic_int4_const(static_cast<std::int32_t>(
			params.minimizer_algorithm)));
	payload = lappend(payload, make_semantic_bool_const(params.vulkan_enabled));
	payload = lappend(
		payload,
		make_semantic_bool_const(params.vulkan_seed_hits_enabled));
	payload = lappend(
		payload,
		make_semantic_bool_const(params.vulkan_index_cache_enabled));
	payload = lappend(
		payload,
		make_semantic_bool_const(params.vulkan_fused_frontend_enabled));
	payload = lappend(
		payload,
		make_semantic_bool_const(params.vulkan_gpu_index_build_enabled));
	payload = lappend(
		payload,
		make_semantic_bool_const(params.vulkan_extend_enabled));
	payload = lappend(
		payload,
		make_semantic_int8_const(static_cast<std::int64_t>(
			params.vulkan_phase_c_tile_bp)));
	payload = lappend(
		payload,
		make_semantic_int8_const(static_cast<std::int64_t>(
			params.vulkan_phase_c_radix_bits)));
	payload = lappend(
		payload,
		make_semantic_bool_const(semantics.read_sequence_index));
	payload = lappend(
		payload,
		make_semantic_int4_const(static_cast<std::int32_t>(
			semantics.index_read_requirement)));
	Assert(
		list_length(payload)
		== kBioseqSemanticPayloadHeaderNodes
			+ kBioseqSemanticPayloadFieldCount);
	return payload;
}

[[nodiscard]] static bool semantic_const_metadata_valid(
		const Const* constant,
		const Oid type_oid,
		const int16_t type_length,
		const bool by_value) noexcept {
	return constant != nullptr
		&& constant->consttype == type_oid
		&& constant->consttypmod == -1
		&& constant->constcollid == InvalidOid
		&& constant->constlen == type_length
		&& constant->constbyval == by_value
		&& !constant->constisnull
		&& (by_value
			|| DatumGetPointer(constant->constvalue) != nullptr);
}

[[nodiscard]] static bool decode_semantic_int4(
		const Node* node, std::int32_t* output) noexcept {
	const Const* constant =
		node != nullptr && IsA(node, Const)
			? reinterpret_cast<const Const*>(node) : nullptr;
	if (output == nullptr
		|| !semantic_const_metadata_valid(
			constant, INT4OID, sizeof(std::int32_t), true)) {
		return false;
	}
	*output = DatumGetInt32(constant->constvalue);
	return true;
}

[[nodiscard]] static bool decode_semantic_int8(
		const Node* node, std::int64_t* output) noexcept {
	const Const* constant =
		node != nullptr && IsA(node, Const)
			? reinterpret_cast<const Const*>(node) : nullptr;
	if (output == nullptr
		|| !semantic_const_metadata_valid(
			constant, INT8OID, sizeof(std::int64_t), FLOAT8PASSBYVAL)) {
		return false;
	}
	*output = DatumGetInt64(constant->constvalue);
	return true;
}

[[nodiscard]] static bool decode_semantic_bool(
		const Node* node, bool* output) noexcept {
	const Const* constant =
		node != nullptr && IsA(node, Const)
			? reinterpret_cast<const Const*>(node) : nullptr;
	if (output == nullptr
		|| !semantic_const_metadata_valid(
			constant, BOOLOID, sizeof(bool), true)
		|| (constant->constvalue != BoolGetDatum(false)
			&& constant->constvalue != BoolGetDatum(true))) {
		return false;
	}
	*output = DatumGetBool(constant->constvalue);
	return true;
}

[[nodiscard]] static const Node* semantic_field_node(
		const List* payload, const BioseqSemanticField field) noexcept {
	if (payload == nullptr) return nullptr;
	const int index = kBioseqSemanticPayloadHeaderNodes
		+ static_cast<int>(field);
	return index >= 0 && index < list_length(payload)
		? reinterpret_cast<const Node*>(list_nth(payload, index))
		: nullptr;
}

[[nodiscard]] static bool decode_semantic_int32_field(
		const List* payload,
		const BioseqSemanticField field,
		std::int32_t* output) noexcept {
	std::int64_t decoded = 0;
	if (!decode_semantic_int8(semantic_field_node(payload, field), &decoded)
		|| decoded < (std::numeric_limits<std::int32_t>::min)()
		|| decoded > (std::numeric_limits<std::int32_t>::max)()) {
		return false;
	}
	*output = static_cast<std::int32_t>(decoded);
	return true;
}

[[nodiscard]] static bool decode_semantic_size_field(
		const List* payload,
		const BioseqSemanticField field,
		std::size_t* output) noexcept {
	std::int64_t decoded = 0;
	if (!decode_semantic_int8(semantic_field_node(payload, field), &decoded)
		|| decoded < 0
		|| static_cast<std::uint64_t>(decoded)
			> static_cast<std::uint64_t>(
				(std::numeric_limits<std::size_t>::max)())) {
		return false;
	}
	*output = static_cast<std::size_t>(decoded);
	return true;
}

[[nodiscard]] static bool decode_semantic_uint32_field(
		const List* payload,
		const BioseqSemanticField field,
		std::uint32_t* output) noexcept {
	std::int64_t decoded = 0;
	if (!decode_semantic_int8(semantic_field_node(payload, field), &decoded)
		|| decoded < 0
		|| static_cast<std::uint64_t>(decoded)
			> (std::numeric_limits<std::uint32_t>::max)()) {
		return false;
	}
	*output = static_cast<std::uint32_t>(decoded);
	return true;
}

[[nodiscard]] static bool decode_semantic_float_field(
		const List* payload,
		const BioseqSemanticField field,
		float* output) noexcept {
	std::int64_t decoded = 0;
	if (!decode_semantic_int8(semantic_field_node(payload, field), &decoded)
		|| decoded < 0
		|| static_cast<std::uint64_t>(decoded)
			> (std::numeric_limits<std::uint32_t>::max)()) {
		return false;
	}
	*output = std::bit_cast<float>(static_cast<std::uint32_t>(decoded));
	return true;
}

[[nodiscard]] static const List* find_bioseq_semantic_payload(
		const List* custom_private) noexcept {
	const List* found = nullptr;
	for (const Node* candidate : PList<Node>(
			const_cast<List*>(custom_private))) {
		if (candidate == nullptr || !IsA(candidate, List)) continue;
		const List* list = reinterpret_cast<const List*>(candidate);
		const Node* name_node = list == NIL ? nullptr
			: reinterpret_cast<const Node*>(linitial(list));
		if (name_node == nullptr || !IsA(name_node, String)
			|| strVal(name_node) == nullptr
			|| std::strcmp(strVal(name_node), kBioseqSemanticPayloadName) != 0) {
			continue;
		}
		if (found != nullptr) return nullptr;
		found = list;
	}
	return found;
}

[[nodiscard]] static bool decode_bioseq_semantic_payload(
		const List* custom_private,
		FrozenBioseqScanSemantics* output) noexcept {
	if (output == nullptr) return false;
	const List* payload = find_bioseq_semantic_payload(custom_private);
	if (payload == nullptr
		|| list_length(payload)
			!= kBioseqSemanticPayloadHeaderNodes
				+ kBioseqSemanticPayloadFieldCount) {
		return false;
	}
	std::int32_t version = 0;
	std::int32_t field_count = 0;
	if (!decode_semantic_int4(
			reinterpret_cast<const Node*>(list_nth(payload, 1)), &version)
		|| !decode_semantic_int4(
			reinterpret_cast<const Node*>(list_nth(payload, 2)), &field_count)
		|| version != kBioseqSemanticPayloadFormatVersion
		|| field_count != kBioseqSemanticPayloadFieldCount) {
		return false;
	}

	FrozenBioseqScanSemantics decoded{};
	auto& params = decoded.params;
	if (!decode_semantic_int32_field(
			payload, BioseqSemanticField::kmer_size, &params.kmer_size)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::window_size, &params.window_size)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::max_gap, &params.max_gap)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::max_gap_ref, &params.max_gap_ref)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::bandwidth, &params.bandwidth)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::max_chain_skip,
			&params.max_chain_skip)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::max_chain_iter,
			&params.max_chain_iter)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::min_seed_count,
			&params.min_seed_count)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::min_chain_score,
			&params.min_chain_score)
		|| !decode_semantic_float_field(
			payload, BioseqSemanticField::chain_gap_scale,
			&params.chain_gap_scale)
		|| !decode_semantic_float_field(
			payload, BioseqSemanticField::chain_skip_scale,
			&params.chain_skip_scale)
		|| !decode_semantic_float_field(
			payload, BioseqSemanticField::mask_level, &params.mask_level)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::mask_len, &params.mask_len)
		|| !decode_semantic_float_field(
			payload, BioseqSemanticField::pri_ratio, &params.pri_ratio)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::best_n, &params.best_n)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::match_score, &params.match_score)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::mismatch_pen,
			&params.mismatch_pen)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::gap_open1, &params.gap_open1)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::gap_ext1, &params.gap_ext1)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::gap_open2, &params.gap_open2)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::gap_ext2, &params.gap_ext2)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::sc_ambi, &params.sc_ambi)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::zdrop, &params.zdrop)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::end_bonus, &params.end_bonus)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::max_occ, &params.max_occ)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::mid_occ, &params.mid_occ)
		|| !decode_semantic_size_field(
			payload, BioseqSemanticField::block_min_size,
			&params.block_min_size)
		|| !decode_semantic_size_field(
			payload, BioseqSemanticField::block_max_size,
			&params.block_max_size)
		|| !decode_semantic_int32_field(
			payload, BioseqSemanticField::bandwidth_long,
			&params.bandwidth_long)) {
		return false;
	}

	std::int32_t chaining = 0;
	std::int32_t base_alignment = 0;
	std::int32_t minimizer = 0;
	if (!decode_semantic_int4(
			semantic_field_node(
				payload, BioseqSemanticField::chaining_algorithm),
			&chaining)
		|| !decode_semantic_int4(
			semantic_field_node(
				payload, BioseqSemanticField::base_alignment_algorithm),
			&base_alignment)
		|| !decode_semantic_int4(
			semantic_field_node(
				payload, BioseqSemanticField::minimizer_algorithm),
			&minimizer)) {
		return false;
	}
	using Chaining =
		bioseq::simd::ChainingAlgorithmType;
	using BaseAlignment =
		bioseq::simd::BaseAlignmentAlgorithmType;
	using Minimizer =
		bioseq::simd::MinimizerAlgorithmType;
	switch (static_cast<Chaining>(chaining)) {
		case Chaining::SCALAR_MM2:
		case Chaining::SIMD_MM2:
		case Chaining::RMQ:
		case Chaining::VULKAN_TILED_DP:
			params.chaining_algorithm = static_cast<Chaining>(chaining);
			break;
		default:
			return false;
	}
	switch (static_cast<BaseAlignment>(base_alignment)) {
		case BaseAlignment::KSW2:
		case BaseAlignment::BLOCK_ALIGNER:
		case BaseAlignment::KSW2_BATCHED:
			params.base_alignment_algorithm =
				static_cast<BaseAlignment>(base_alignment);
			break;
		default:
			return false;
	}
	switch (static_cast<Minimizer>(minimizer)) {
		case Minimizer::SCALAR:
		case Minimizer::SIMD_MINIMAP2_SLOW:
		case Minimizer::TWO_STACK_NTHASH:
		case Minimizer::VULKAN_MINIMAP_INT:
		case Minimizer::PAPER_NTHASH_SIMD:
			params.minimizer_algorithm = static_cast<Minimizer>(minimizer);
			break;
		default:
			return false;
	}

	if (!decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_enabled),
			&params.vulkan_enabled)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_seed_hits_enabled),
			&params.vulkan_seed_hits_enabled)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_index_cache_enabled),
			&params.vulkan_index_cache_enabled)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_fused_frontend_enabled),
			&params.vulkan_fused_frontend_enabled)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_gpu_index_build_enabled),
			&params.vulkan_gpu_index_build_enabled)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::vulkan_extend_enabled),
			&params.vulkan_extend_enabled)
		|| !decode_semantic_uint32_field(
			payload, BioseqSemanticField::vulkan_phase_c_tile_bp,
			&params.vulkan_phase_c_tile_bp)
		|| !decode_semantic_uint32_field(
			payload, BioseqSemanticField::vulkan_phase_c_radix_bits,
			&params.vulkan_phase_c_radix_bits)
		|| !decode_semantic_bool(
			semantic_field_node(
				payload, BioseqSemanticField::read_sequence_index),
			&decoded.read_sequence_index)) {
		return false;
	}
	std::int32_t requirement = 0;
	if (!decode_semantic_int4(
			semantic_field_node(
				payload, BioseqSemanticField::index_read_requirement),
			&requirement)
		|| !bioseq::indexing::index_read_requirement_ordinal_valid(
			requirement)) {
		return false;
	}
	decoded.index_read_requirement =
		static_cast<bioseq::indexing::IndexReadRequirement>(requirement);
	*output = decoded;
	return true;
}

[[nodiscard]] static bool mmsearch_plans_admitted_packed_regions(
		bioseq::simd::Minimap2Params const& params) noexcept {
	using Algorithm = bioseq::simd::MinimizerAlgorithmType;
	switch (params.minimizer_algorithm) {
		case Algorithm::SCALAR:
		case Algorithm::SIMD_MINIMAP2_SLOW:
			return false;
		case Algorithm::TWO_STACK_NTHASH:
		case Algorithm::PAPER_NTHASH_SIMD:
		case Algorithm::VULKAN_MINIMAP_INT:
			return true;
	}
	return false;
}

[[nodiscard]] static Const*
require_aligner_options_const(FuncExpr* mmsearch_fe, const BioseqStubOids& oids)
{
	if (mmsearch_fe == nullptr) {
		return nullptr;
	}
	const int arity = list_length(mmsearch_fe->args);
	if (mmsearch_fe->funcid == oids.mmsearch_oid && arity == 2) {
		return nullptr;
	}
	if (arity != 3 || mmsearch_fe->funcid != oids.mmsearch_with_opts_oid) {
		ereport(ERROR,
			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
			 errmsg("mmsearch aligner-options call has an invalid function shape"),
			 errdetail("arity=%d funcid=%u expected_funcid=%u",
				arity,
				mmsearch_fe->funcid,
				oids.mmsearch_with_opts_oid)));
	}
	PList<Node> args(mmsearch_fe->args);
	Node* opt_node = args.third();
	Const* opt_const = pg_node_try_as<Const>(opt_node);
	if (opt_const == nullptr) {
		const std::string_view node_tag_name =
			pg_node_tag_name(pg_node_tag_or_invalid(opt_node));
		ereport(ERROR,
			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
			 errmsg("mmsearch aligner_options must be a plan-time constant"),
			 errdetail("third argument node tag is %.*s",
				static_cast<int>(node_tag_name.size()),
				node_tag_name.data()),
			 errhint("Pass aligner_options(...) directly; parameterized or column-valued option records are not supported.")));
	}
	if (opt_const->consttype != oids.bioseq_aligner_options_type_oid) {
		ereport(ERROR,
			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
			 errmsg("mmsearch aligner_options constant has the wrong type"),
			 errdetail("consttype=%u expected=%u",
				opt_const->consttype,
				oids.bioseq_aligner_options_type_oid)));
	}
	return opt_const;
}

/* The dispatch buffer owns one Minimap2Params object for every query attached
 * to a scan.  Consequently the bounded Param-primary/Const-extra exception can
 * share that buffer only when the primary changes no biological option and the
 * extra requests the default option set.  The sole permitted difference is an
 * explicit require-absent index policy on the primary: the extra's inherited
 * `allow` policy admits the same no-index execution, so this does not alter its
 * Boolean result or error contract. */
[[nodiscard]] static bool
bounded_batch_fallback_options_are_supported(
		FuncExpr* primary, FuncExpr* extra,
		const BioseqStubOids& oids) {
	if (primary == nullptr || extra == nullptr
		|| primary->funcid != oids.mmsearch_with_opts_oid
		|| list_length(primary->args) != 3
		|| extra->funcid != oids.mmsearch_oid
		|| list_length(extra->args) != 2) return false;
	Const* options = pg_node_try_as<Const>(reinterpret_cast<Node*>(
		list_nth(primary->args, 2)));
	if (options == nullptr || options->constisnull
		|| options->consttype != oids.bioseq_aligner_options_type_oid) {
		return false;
	}

	HeapTupleHeader header = reinterpret_cast<HeapTupleHeader>(
		PG_DETOAST_DATUM(options->constvalue));
	auto free_detoasted_header = [&] {
		if (reinterpret_cast<void*>(header)
			!= reinterpret_cast<void*>(DatumGetPointer(options->constvalue))) {
			pfree(header);
		}
	};
	const Oid row_typeoid = HeapTupleHeaderGetTypeId(header);
	if (row_typeoid != oids.bioseq_aligner_options_type_oid) {
		free_detoasted_header();
		return false;
	}
	TupleDesc tupdesc = lookup_rowtype_tupdesc(
		row_typeoid, HeapTupleHeaderGetTypMod(header));
	constexpr std::size_t kExpectedOptionAttrs =
		aligner_options_codec::fields_count;
	if (tupdesc->natts
		!= static_cast<int>(kExpectedOptionAttrs)) {
		ReleaseTupleDesc(tupdesc);
		free_detoasted_header();
		return false;
	}
	for (const bioseq::pg_utils::row_descriptor_field& expected :
		 aligner_options_codec::expected_descriptor) {
		const Form_pg_attribute attribute = TupleDescAttr(
			tupdesc, expected.attribute_number - 1);
		if (attribute->attnum != expected.attribute_number
			|| attribute->attisdropped
			|| attribute->atttypid != expected.type_oid
			|| attribute->attnotnull != !expected.nullable
			|| std::string_view{NameStr(attribute->attname)}
				!= expected.name) {
			ReleaseTupleDesc(tupdesc);
			free_detoasted_header();
			return false;
		}
	}
	HeapTupleData tuple{};
	tuple.t_len = HeapTupleHeaderGetDatumLength(header);
	tuple.t_data = header;
	ItemPointerSetInvalid(&tuple.t_self);
	tuple.t_tableOid = InvalidOid;
	std::array<Datum, kExpectedOptionAttrs> values{};
	std::array<bool, kExpectedOptionAttrs> nulls{};
	heap_deform_tuple(&tuple, tupdesc, values.data(), nulls.data());
	constexpr std::size_t index_policy_index =
		static_cast<std::size_t>(
			aligner_options_codec::attribute_number<
				&aligner_options_catalog_row::index_read_requirement>()
			- 1);
	bool only_index_policy_is_explicit = true;
	for (std::size_t index = 0; index < kExpectedOptionAttrs; ++index) {
		if (index != index_policy_index) {
			only_index_policy_is_explicit =
				only_index_policy_is_explicit && nulls[index];
		}
	}
	const bool requires_absent = !nulls[index_policy_index]
		&& DatumGetInt32(values[index_policy_index])
			== static_cast<int32>(
				bioseq::indexing::IndexReadRequirement::require_absent);
	ReleaseTupleDesc(tupdesc);
	free_detoasted_header();
	return only_index_policy_is_explicit && requires_absent;
}

/*
 * If the third argument of a mmsearch FuncExpr is a row-typed Const
 * representing aligner_options(), decode its fields and overlay any
 * non-NULL values on top of `params`. NULL field values signal "inherit
 * the GUC" so they are skipped here.
 *
 * The generated row codec validates and decodes the exact
 * bioseq_aligner_options composite layout.
 */
[[nodiscard]] static bool
apply_aligner_options_override(FuncExpr* mmsearch_fe,
							   bioseq::simd::Minimap2Params& params,
							   bioseq::indexing::IndexReadRequirement& index_read_requirement,
							   const BioseqStubOids& oids,
							   bool* vulkan_enabled_explicit = nullptr)
{
	if (vulkan_enabled_explicit != nullptr) {
		*vulkan_enabled_explicit = false;
	}
	Const* opt_const = require_aligner_options_const(mmsearch_fe, oids);
	if (opt_const == nullptr) {
		return false;
	}
	if (opt_const->constisnull) {
		return false;
	}
	/*
	 * The composite comes through as a HeapTupleHeader varlena. Deconstruct
	 * it via heap_deform_tuple against the pg_type tupdesc.
	 */
	HeapTupleHeader header = reinterpret_cast<HeapTupleHeader>(
		PG_DETOAST_DATUM(opt_const->constvalue));
	Oid row_typeoid    = HeapTupleHeaderGetTypeId(header);
	int32 row_typmod   = HeapTupleHeaderGetTypMod(header);
	auto free_detoasted_header = [&] {
		if (reinterpret_cast<void*>(header)
			!= reinterpret_cast<void*>(DatumGetPointer(opt_const->constvalue))) {
			pfree(header);
		}
	};
	if (row_typeoid != oids.bioseq_aligner_options_type_oid) {
		const Oid actual_row_typeoid = row_typeoid;
		free_detoasted_header();
		ereport(ERROR,
			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
			 errmsg("mmsearch aligner_options payload has the wrong row type"),
			 errdetail("header_typeoid=%u expected=%u",
				actual_row_typeoid,
				oids.bioseq_aligner_options_type_oid)));
	}
	TupleDesc tupdesc  = lookup_rowtype_tupdesc(row_typeoid, row_typmod);

	HeapTupleData heap_tuple{};
	heap_tuple.t_len  = HeapTupleHeaderGetDatumLength(header);
	heap_tuple.t_data = header;
	ItemPointerSetInvalid(&heap_tuple.t_self);
	heap_tuple.t_tableOid = InvalidOid;

	std::optional<aligner_options_catalog_row> decoded_options;
	try {
		decoded_options.emplace(aligner_options_codec::deform(
			&heap_tuple, tupdesc, CurrentMemoryContext));
	} catch (const bioseq::pg_utils::row_codec_error& error) {
		const std::string detail{error.what()};
		ReleaseTupleDesc(tupdesc);
		free_detoasted_header();
		ereport(ERROR,
			(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
			 errmsg("bioseq_aligner_options catalog layout is incompatible"),
			 errdetail("%s", detail.c_str())));
	}
	const aligner_options_catalog_row& options = *decoded_options;
	bool index_read_requirement_present = false;
	if (options.kmer_size) params.kmer_size = *options.kmer_size;
	if (options.window_size) params.window_size = *options.window_size;
	if (options.max_gap) params.max_gap = *options.max_gap;
	if (options.max_gap_ref) params.max_gap_ref = *options.max_gap_ref;
	if (options.bandwidth) params.bandwidth = *options.bandwidth;
	if (options.bandwidth_long) {
		params.bandwidth_long = *options.bandwidth_long;
	}
	if (options.max_chain_skip) {
		params.max_chain_skip = *options.max_chain_skip;
	}
	if (options.max_chain_iter) {
		params.max_chain_iter = *options.max_chain_iter;
	}
	if (options.min_seed_count) {
		params.min_seed_count = *options.min_seed_count;
	}
	if (options.min_chain_score) {
		params.min_chain_score = *options.min_chain_score;
	}
	if (options.chain_gap_scale) {
		params.chain_gap_scale =
			static_cast<float>(*options.chain_gap_scale);
	}
	if (options.chain_skip_scale) {
		params.chain_skip_scale =
			static_cast<float>(*options.chain_skip_scale);
	}
	if (options.mask_level) {
		params.mask_level = static_cast<float>(*options.mask_level);
	}
	if (options.mask_len) params.mask_len = *options.mask_len;
	if (options.pri_ratio) {
		params.pri_ratio = static_cast<float>(*options.pri_ratio);
	}
	if (options.best_n) params.best_n = *options.best_n;
	if (options.match_score) params.match_score = *options.match_score;
	if (options.mismatch_pen) params.mismatch_pen = *options.mismatch_pen;
	if (options.gap_open1) params.gap_open1 = *options.gap_open1;
	if (options.gap_ext1) params.gap_ext1 = *options.gap_ext1;
	if (options.gap_open2) params.gap_open2 = *options.gap_open2;
	if (options.gap_ext2) params.gap_ext2 = *options.gap_ext2;
	if (options.sc_ambi) params.sc_ambi = *options.sc_ambi;
	if (options.zdrop) params.zdrop = *options.zdrop;
	if (options.end_bonus) params.end_bonus = *options.end_bonus;
	if (options.max_occ) params.max_occ = *options.max_occ;
	if (options.mid_occ) params.mid_occ = *options.mid_occ;
	if (options.block_min_size) {
		params.block_min_size =
			static_cast<size_t>(*options.block_min_size);
	}
	if (options.block_max_size) {
		params.block_max_size =
			static_cast<size_t>(*options.block_max_size);
	}
	if (options.chaining_algorithm) {
		/*
		 * Range-check before the enum cast — otherwise a crafted caller
		 * (aligner_options(chaining_algorithm => 42)) injects an invalid
		 * enum value into params.chaining_algorithm, which produces UB
		 * via the constexpr switch in to_chaining_params(). Known-good
		 * ordinals: 0=SCALAR_MM2, 1=SIMD_MM2, 2=RMQ, 3=VULKAN_TILED_DP.
		 */
		const std::int32_t raw = *options.chaining_algorithm;
		if (raw >= 0 && raw <= 3) {
			params.chaining_algorithm =
				static_cast<bioseq::simd::ChainingAlgorithmType>(raw);
		} else {
			ereport(ERROR,
				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
				 errmsg("aligner_options.chaining_algorithm out of range: %d (expected 0..3)", raw)));
		}
	}
	if (options.base_alignment_algorithm) {
		const std::int32_t raw =
			*options.base_alignment_algorithm;
		if (raw >= 0 && raw <= 1) {
			params.base_alignment_algorithm =
				static_cast<bioseq::simd::BaseAlignmentAlgorithmType>(raw);
		} else {
			ereport(ERROR,
				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
				 errmsg("aligner_options.base_alignment_algorithm out of range: %d (expected 0..1)", raw)));
		}
	}
	// Known-good minimizer ordinals are 0 through 4.
	if (options.minimizer_algorithm) {
		const std::int32_t raw = *options.minimizer_algorithm;
		if (raw >= 0 && raw <= 4) {
			params.minimizer_algorithm =
				static_cast<bioseq::simd::MinimizerAlgorithmType>(raw);
		} else {
			ereport(ERROR,
				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
					 errmsg("aligner_options.minimizer_algorithm out of range: %d (expected 0..4)", raw)));
		}
	}
	if (options.vulkan_enabled) {
		params.vulkan_enabled = *options.vulkan_enabled;
		if (vulkan_enabled_explicit != nullptr) {
			*vulkan_enabled_explicit = true;
		}
	}
	if (options.vulkan_seed_hits_enabled) {
		params.vulkan_seed_hits_enabled =
			*options.vulkan_seed_hits_enabled;
	}
	if (options.vulkan_index_cache_enabled) {
		params.vulkan_index_cache_enabled =
			*options.vulkan_index_cache_enabled;
	}
	if (options.index_read_requirement) {
		const std::int32_t raw = *options.index_read_requirement;
		if (!bioseq::indexing::index_read_requirement_ordinal_valid(raw)) {
			ereport(ERROR,
				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
				 errmsg("aligner_options.index_read_requirement out of range: %d (expected 0..2)", raw)));
		}
		index_read_requirement =
			static_cast<bioseq::indexing::IndexReadRequirement>(raw);
		index_read_requirement_present = true;
	}
	ReleaseTupleDesc(tupdesc);
	/* Free the detoasted copy if PG_DETOAST_DATUM actually copied. */
	free_detoasted_header();
	return index_read_requirement_present;
}

/*
 * Resolve the SIMD chaining policy only after the final per-call override.
 * The C++ API deliberately defaults to exact_visited.  PostgreSQL promotes
 * the explicitly selected SIMD_MM2 route to the named bounded candidate so
 * integration and performance gates exercise the real production choice.
 * Every non-SIMD algorithm is reset to exact: a stale bounded value must not
 * leak through a copied parameter object, and no unsupported request may be
 * translated into a different biological algorithm.
 */
static void
finalize_simd_chaining_policy(
	bioseq::simd::Minimap2Params& params)
{
	using bioseq::simd::ChainingAlgorithmType;
	using bioseq::simd::SimdChainingPolicy;
	switch (params.chaining_algorithm) {
		case ChainingAlgorithmType::SIMD_MM2:
			params.simd_chaining_policy =
				SimdChainingPolicy::bounded_batch_approximate;
			return;
		case ChainingAlgorithmType::SCALAR_MM2:
		case ChainingAlgorithmType::RMQ:
		case ChainingAlgorithmType::VULKAN_TILED_DP:
			params.simd_chaining_policy = SimdChainingPolicy::exact_visited;
			return;
	}
	ereport(ERROR,
		(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
		 errmsg("final SIMD chaining policy cannot be selected"),
		 errdetail("chaining_algorithm has unknown ordinal %u",
			 static_cast<unsigned>(params.chaining_algorithm)),
		 errhint("Select scalar_mm2, simd_mm2, rmq, or vulkan_tiled_dp explicitly; no fallback is performed.")));
}

/*
 * Context passed to VarInjectorMutator through the void* context arg.
 * Bundles the allocated placeholder Consts with the resolved OIDs so
 * the mutator can dispatch on funcid -> Const* without a global.
 *
 * `current_relation` is used exclusively when rewriting
 * `symbol_count(Var, 'L')` call sites to resolve the column name
 * (attname) referenced by the Var — so the EXPLAIN output can say
 * "Fetched from meta: seq.symbol_count('A') AS ...".
 */
struct VarInjectorCtx {
	BioseqPlaceholderConsts* consts;
	const BioseqStubOids*    oids;
	Relation                 current_relation;
	Index                    match_sequence_varno;
	AttrNumber               match_sequence_attno;
	Node*                    match_target_recipe;
	List*                    match_target_lineage;
	List*                    match_helper_sites;
	int                      stable_match_id;
};

