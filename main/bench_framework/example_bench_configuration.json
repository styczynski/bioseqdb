{
  "params": {
    "std_sort": {
      "size_hint": {
        "type": "integer",
        "default": 0,
        "description": "passthrough hint, no effect on the algorithm"
      }
    },
    "std_stable_sort": {
      "size_hint": {
        "type": "integer",
        "default": 0,
        "description": "passthrough hint, no effect on the algorithm"
      }
    },
    "naive_count": {
      "stride": {
        "type": "integer",
        "default": 1,
        "description": "stride between counted elements; 1 = exact count"
      }
    }
  },
  "test_cases": {
    "TINY": {
      "description": "1k random integers",
      "concurrency": 4,
      "data": {
        "length": 1024,
        "seed": 13
      }
    },
    "SMALL": {
      "description": "16k random integers (serial — exercises the concurrency=1 path)",
      "concurrency": 1,
      "data": {
        "length": 16384,
        "seed": 21
      }
    },
    "BUGGY_INPUT": {
      "description": "V12 demo: build_count_input throws the first 2 attempts. Drives the on_input retry UI.",
      "concurrency": 1,
      "data": {
        "length": 256,
        "seed": 99,
        "buggy_input": 2
      }
    }
  },
  "bench_sort": {
    "description": "Compare std::sort vs std::stable_sort latency",
    "fast": false,
    "concurrency": {
      "bench_lock": false,
      "concurrency": true
    },
    "matrix": {
      "for": {
        "TINY": 50,
        "SMALL": 40
      },
      "over": {
        "std_sort": {},
        "std_stable_sort": {}
      },
      "by_regions": true,
      "metrics": {
        "wall_clock_ns": {
          "rules": [
            [
              "sort_within_2x_of_stable_sort",
              { "key": "std_sort" },
              { "compare": "=", "tolerance%": 99, "aggregate": "p50" },
              { "key": "std_stable_sort" }
            ]
          ]
        },
        "region_total_ns": {
          "type": "region",
          "rules": []
        },
        "region_visits": {
          "type": "region",
          "rules": []
        },
        "region_max_ns": {
          "type": "region",
          "region": "sort_run",
          "rules": []
        },
        "output_size": {
          "type": "evaluation",
          "rules": []
        }
      }
    }
  },
  "bench_count": {
    "description": "Sanity-check the even-count algorithm",
    "fast": false,
    "concurrency": {
      "bench_lock": false,
      "concurrency": false
    },
    "matrix": {
      "for": {
        "TINY": 5,
        "SMALL": 3,
        "BUGGY_INPUT": 2
      },
      "over": {
        "naive_count": {
          "stride": [1]
        }
      },
      "by_regions": false,
      "metrics": {
        "even_count": {
          "type": "evaluation",
          "rules": [
            [
              "naive_count_self_consistent",
              { "key": "naive_count" },
              { "compare": "=", "tolerance%": 0 },
              { "key": "naive_count" }
            ]
          ]
        },
        "even_count_match": {
          "type": "evaluation",
          "rules": []
        },
        "loop_total_iterations": {
          "type": "loop",
          "rules": []
        },
        "loop_mean_per_iter_ns": {
          "type": "loop",
          "rules": []
        }
      }
    }
  },
  "bench_buggy_cleanup": {
    "description": "V12 demo: on_cleanup always throws. Drives the cleanup-retry UI and the cleanup_function_failing warning.",
    "fast": false,
    "concurrency": {
      "bench_lock": false,
      "concurrency": false
    },
    "matrix": {
      "for": {
        "TINY": 1
      },
      "over": {
        "naive_count": {
          "stride": [1]
        }
      },
      "by_regions": false,
      "metrics": {
        "even_count": {
          "type": "evaluation",
          "rules": []
        },
        "even_count_match": {
          "type": "evaluation",
          "rules": []
        }
      }
    }
  },
  "regression_rules": [
    {
      "name": "wall_clock_p50_stable",
      "metric": "wall_clock_ns",
      "aggregate": "p50",
      "operator": { "compare": "<", "tolerance%": 100 },
      "exclude_cases": ["TINY"]
    },
    {
      "name": "even_count_deterministic",
      "benchmarks": ["bench_count"],
      "metric": "even_count",
      "aggregate": "sum",
      "operator": { "compare": "=", "tolerance%": 0 }
    }
  ]
}
