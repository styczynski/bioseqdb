@Article{mmseqs2_gpu_paper,
author={Kallenborn, Felix
and Chacon, Alejandro
and Hundt, Christian
and Sirelkhatim, Hassan
and Didi, Kieran
and Cha, Sooyoung
and Dallago, Christian
and Mirdita, Milot
and Schmidt, Bertil
and Steinegger, Martin},
title={GPU-accelerated homology search with MMseqs2},
journal={Nature Methods},
year={2025},
month={Oct},
day={01},
volume={22},
number={10},
pages={2024-2027},
abstract={Rapidly growing protein databases demand faster sensitive search tools. Here the graphics processing unit (GPU)-accelerated MMseqs2 delivers 6{\texttimes} faster single-protein searches than CPU methods on 2{\thinspace}{\texttimes}{\thinspace}64 cores, speeds previously requiring large protein batches. For larger query batches, it is the most cost-effective solution, outperforming the fastest alternative method by 2.4-fold with eight GPUs. It accelerates protein structure prediction with ColabFold 31.8{\texttimes} over the standard AlphaFold2 pipeline and protein structure search with Foldseek by 4--27{\texttimes}. MMseqs2-GPU is available under an open-source license at https://mmseqs.com/.},
issn={1548-7105},
doi={10.1038/s41592-025-02819-8},
url={https://doi.org/10.1038/s41592-025-02819-8}
}

