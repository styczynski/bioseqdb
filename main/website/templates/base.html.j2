<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="{{ page.canonical }}">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page.canonical }}">
<meta property="og:image" content="{{ site.social_image_url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.social_image_url }}">
<link rel="icon" href="{{ site.favicon_url }}">
<link rel="stylesheet" href="{{ site.prism_css_url }}">
<link rel="stylesheet" href="{{ site.css_url }}">
<script type="application/ld+json">{{ page.jsonld }}</script>
{% block head_extra %}{% endblock %}
</head>
<body id="page-top" class="{% block body_class %}docs-page{% endblock %}">
{% block skip_link %}<a class="skip-link" href="#main">Skip to main content</a>{% endblock %}
{% block header %}
<header class="site-header docs-header">
  <nav class="site-nav" aria-label="Primary">
    <a class="brand" href="{{ site.base_path }}">
      <img class="brand-mark" src="{{ site.assets_base_url }}bioseq-mark.svg" width="30" height="30" alt="">
      <span class="brand-word">Bioseq<span>DB</span></span>
      <span class="docs-badge">Docs</span>
    </a>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-primary" aria-label="Toggle navigation menu">
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>
    <div class="nav-primary" id="nav-primary">
      <ul class="nav-links">
        <li><a href="{{ nav.documentation }}">Docs</a></li>
        <li><a href="{{ site.base_path }}">Product</a></li>
        <li><a href="{{ nav.tutorials }}">Tutorials</a></li>
        <li><a href="{{ nav.reference }}">Reference</a></li>
      </ul>
      <div class="nav-actions">
        <button type="button" class="search-button" id="search-button" aria-haspopup="dialog" aria-expanded="false" aria-controls="search-dialog">
          <span class="search-button-label">Search</span>
          <kbd class="search-button-kbd" aria-hidden="true">Ctrl K</kbd>
        </button>
        <details class="version-selector" id="version-selector">
          <summary class="version-current">{{ site.version }}</summary>
          <div class="version-menu">
            <ul class="version-list" id="version-list" data-versions="{{ site.versions_url }}">
              <li><a href="{{ nav.documentation }}" aria-current="true">{{ site.version }}</a></li>
            </ul>
            <a class="version-all" href="{{ site.versions_page_url }}">All versions</a>
          </div>
        </details>
        <a class="repo-link button-quiet" href="{{ site.repository_url }}" rel="noreferrer">GitHub</a>
      </div>
    </div>
  </nav>
</header>
{% endblock %}
<dialog class="search-dialog" id="search-dialog" data-search-index="{{ site.search_index_url }}" aria-label="Search documentation">
  <form class="search-form" method="dialog" role="search">
    <label class="search-label" for="search-input">Search documentation</label>
    <input type="search" id="search-input" class="search-input" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Search tutorials, SQL, and C++ reference">
    <button type="submit" class="search-close" value="close">Close</button>
  </form>
  <div class="search-results" id="search-results" role="listbox" aria-label="Search results"></div>
  <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
  <p class="search-fallback"><a href="{{ nav.reference }}">Browse the full reference index</a></p>
</dialog>
<div class="layout{% if page.doc_nav %} layout-doc{% endif %}">
  {% block breadcrumb %}
  {% if page.breadcrumb %}
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
    {% for c in page.breadcrumb %}
      <li>{% if c.url %}<a href="{{ c.url }}">{{ c.name }}</a>{% else %}<span aria-current="page">{{ c.name }}</span>{% endif %}</li>
    {% endfor %}
    </ol>
  </nav>
  {% endif %}
  {% endblock %}
  {% block doc_navigation %}
  {% if page.doc_nav %}
  <aside class="doc-nav" aria-label="Documentation navigation">
    <nav>
    {% for s in page.doc_nav %}
      <p class="doc-nav-title">{{ s.label }}</p>
      <ul>
      {% for i in s.items %}
        <li><a href="{{ i.url }}">{{ i.label }}</a></li>
      {% endfor %}
      </ul>
    {% endfor %}
    </nav>
  </aside>
  {% endif %}
  {% endblock %}
  <main id="main">
{% block main %}{% endblock %}
  </main>
  {% block doc_toc %}
  {% if page.on_this_page %}
  <aside class="doc-toc" aria-label="On this page">
    <p class="doc-toc-title">On this page</p>
    <ul>
    {% for h in page.on_this_page %}
      <li class="toc-l{{ h.level }}"><a href="#{{ h.anchor }}">{{ h.text }}</a></li>
    {% endfor %}
    </ul>
  </aside>
  {% endif %}
  {% endblock %}
</div>
{% block footer %}
<footer class="site-footer">
  <div class="footer-watermark" aria-hidden="true">BioseqDB</div>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-intro">
        <a class="brand footer-brand" href="{{ site.base_path }}">
          <img class="brand-mark" src="{{ site.assets_base_url }}bioseq-mark.svg" width="32" height="32" alt="">
          <span class="brand-word">Bioseq<span>DB</span></span>
          <span class="docs-badge">Docs</span>
        </a>
        <p>SQL-native search for biological sequence data. Load, store, and query FASTA and FASTQ beside their metadata.</p>
        <span class="open-source-badge"><span aria-hidden="true"></span>Free &amp; open source</span>
      </div>
      <div class="footer-column">
        <p class="footer-title">Documentation</p>
        <a href="{{ nav.documentation }}">Documentation home</a>
        <a href="{{ nav.tutorials }}">Tutorials</a>
        <a href="{{ nav.reference }}">API reference</a>
      </div>
      <div class="footer-column">
        <p class="footer-title">Explore</p>
        <a href="{{ site.base_path }}#workflow">Workflow</a>
        <a href="{{ site.base_path }}#examples">Examples</a>
        <a href="{{ site.base_path }}#capabilities">Capabilities</a>
        <a href="{{ site.base_path }}#scale">Scale</a>
      </div>
      <div class="footer-column">
        <p class="footer-title">Project</p>
        <a href="{{ site.repository_url }}" rel="noreferrer">GitHub</a>
        <a href="{{ site.versions_page_url }}">All versions</a>
        <span class="footer-status">{{ site.status_label }} &#183; {{ site.version }}</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&#169; {{ site.copyright_year }} {{ site.copyright_holder }}</span>
      <nav aria-label="Footer"><a href="{{ site.repository_url }}" rel="noreferrer">License</a><a href="#page-top">Back to top &#8593;</a></nav>
    </div>
  </div>
</footer>
{% endblock %}
<script src="{{ site.prism_js_url }}"></script>
<script type="module" src="{{ site.js_url }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
