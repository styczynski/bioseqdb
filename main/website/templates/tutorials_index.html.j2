{% extends "base.html.j2" %}
{% block main %}
<article class="tutorials-index">
  <h1>Tutorials</h1>
  {% if tutorials %}
  <ul class="tutorial-list">
  {% for t in tutorials %}
    <li><a href="{{ t.route }}">{{ t.title }}</a><span class="desc"> — {{ t.description }}</span></li>
  {% endfor %}
  </ul>
  {% else %}
  <p>No tutorials are published for this version yet.</p>
  {% endif %}
</article>
{% endblock %}
