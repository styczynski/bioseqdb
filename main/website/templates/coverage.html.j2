{% extends "base.html.j2" %}
{% block main %}
<article class="coverage">
  <h1>Documentation coverage</h1>
  <p>{{ page.documented_total }} of {{ page.public_total }} public entities documented.</p>

  {% if page.groups %}
  <h2>By module and SQL domain</h2>
  <table class="coverage-groups">
    <thead><tr><th>Group</th><th>Documented</th><th>Public</th></tr></thead>
    <tbody>
    {% for g in page.groups %}
      <tr><td><code>{{ g.group }}</code></td><td>{{ g.documented_total }}</td><td>{{ g.public_total }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if page.fatal_missing %}
  <h2>Required but undocumented (fatal)</h2>
  <ul class="fatal-list">
  {% for id in page.fatal_missing %}<li><code>{{ id }}</code></li>{% endfor %}
  </ul>
  {% endif %}

  {% if page.missing %}
  <h2>Missing summaries (warnings)</h2>
  <ul class="missing-list">
  {% for id in page.missing %}<li><code>{{ id }}</code></li>{% endfor %}
  </ul>
  {% endif %}

  {% if page.missing_parameters %}
  <h2>Missing parameter documentation (warnings)</h2>
  <ul class="missing-parameters">
  {% for id in page.missing_parameters %}<li><code>{{ id }}</code></li>{% endfor %}
  </ul>
  {% endif %}

  {% if page.missing_returns %}
  <h2>Missing return documentation (warnings)</h2>
  <ul class="missing-returns">
  {% for id in page.missing_returns %}<li><code>{{ id }}</code></li>{% endfor %}
  </ul>
  {% endif %}
</article>
{% endblock %}
