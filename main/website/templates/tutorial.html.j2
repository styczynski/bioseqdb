{% extends "base.html.j2" %}
{% block main %}
<section data-page-panel data-screen-label="Docs · Tutorial" class="dd-s0040 design-page">
  <header data-reveal class="dd-s0041 design-page-header">
    <nav aria-label="Breadcrumb" class="dd-s0042 design-breadcrumb">
      {% for crumb in page.breadcrumb %}<a href="{{ crumb.url }}">{{ crumb.name }}</a><span class="dd-s0043" aria-hidden="true">/</span>{% endfor %}
    </nav>
    <h1 class="dd-s0045">{{ page.title }}</h1>
    <p class="dd-s0046">{{ page.description }}</p>
  </header>

  <div class="docs-content tutorial-body">{{ page.body_html }}</div>

  {% if page.previous_url %}
  <nav class="dd-s0084" aria-label="Previous and next tutorial">
    <div class="dd-s0085">
      <a href="{{ page.previous_url }}" class="dd-s0106 dd-h005"><span class="dd-s0087">&#8592; Previous</span><span class="dd-s0088">{% if page.previous_title %}{{ page.previous_title }}{% else %}Previous tutorial{% endif %}</span></a>
      {% if page.next_url %}<a href="{{ page.next_url }}" class="dd-s0086 dd-h005"><span class="dd-s0087">Next &#8594;</span><span class="dd-s0088">{% if page.next_title %}{{ page.next_title }}{% else %}Next tutorial{% endif %}</span></a>{% endif %}
    </div>
  </nav>
  {% else %}
    {% if page.next_url %}
    <nav class="dd-s0084" aria-label="Next tutorial"><div class="dd-s0085"><a href="{{ page.next_url }}" class="dd-s0086 dd-h005"><span class="dd-s0087">Next &#8594;</span><span class="dd-s0088">{% if page.next_title %}{{ page.next_title }}{% else %}Next tutorial{% endif %}</span></a></div></nav>
    {% endif %}
  {% endif %}
</section>
{% endblock %}
