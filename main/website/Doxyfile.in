# Doxyfile.in — website C++ reference XML generation (§11.1).
#
# Doxygen 1.9.8 is the sole documentation-comment interpreter. Its native parser
# owns comments and XML; the exact Clang 22 AST pass owns C++ semantics. The
# mismatched libclang-18 path is deliberately disabled (CLANG_ASSISTED_PARSING =
# NO); do not enable it and do not build a second comment parser.
#
# INPUT is the newline-separated reachable_interface_units list from the
# validated source_graph artifact — never a recursive main/bioseq directory —
# so build trees, generated files, vendor code, tests, benchmarks, design_source,
# implementation-only units, privately imported partitions, and third-party
# sources cannot enter by working-directory accident.

PROJECT_NAME           = "@BIOSEQ_WEBSITE_PROJECT_NAME@"
OUTPUT_DIRECTORY       = @BIOSEQ_WEBSITE_DOXYGEN_OUTPUT@

GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO
XML_PROGRAMLISTING     = NO

RECURSIVE              = YES
FILE_PATTERNS          = *.cppm *.cpp *.hpp *.h
EXTENSION_MAPPING      = cppm=C++
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = @BIOSEQ_WEBSITE_STRIP_FROM_PATH@

CLANG_ASSISTED_PARSING = NO
HAVE_DOT               = NO
QUIET                  = YES

# Missing docs / parameter docs are owned by the coverage policy (§11.4), not by
# Doxygen warnings; hence the two disabled warning flags below. Documentation
# syntax errors and unresolved references are fatal (WARN_IF_DOC_ERROR).
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = @BIOSEQ_WEBSITE_DOXYGEN_WARN_LOG@

# Neutralize PostgreSQL registration macros so a future configured public unit
# containing them parses cleanly. CXX_PG_FUNCTION_INFO_V1 is declared at
# main/bioseq/backend/pg/include/bioseq/pg_compat.h; keep this list in sync with it.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "CXX_PG_FUNCTION_INFO_V1(funcname)=" \
                         "POSTGRES_FN(name)=" \
                         "E_POSTGRES_FN(name)="

# INPUT is set exclusively by the build-time fragment below, which the website
# source_graph stage generates from the validated reachable interface-unit closure
# (§11.1) — never a recursive directory glob. The @INCLUDE fragment overrides this
# empty default with exactly the closure files before Doxygen runs.
INPUT                  =
@INCLUDE               = @BIOSEQ_WEBSITE_DOXYGEN_INPUT_INCLUDE@
