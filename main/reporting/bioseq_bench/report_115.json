w performs no biological work and exists only because framework rules compare rows rather than literals. Ordinary rules reject failures while preserving complete report and raw evidence; wall time and endpoint maxima remain diagnostics.","location":"/Users/styczynski/Code/bioseqdb/main/bench/bench_v10_configuration.json","test_case_descriptions":{"SHORT_HIFI":"300 bp fragments, ~0.2% HiFi-style error, 3 kbp reference","SHORT_CCS":"300 bp fragments, ~1.5% CCS-style error","SHORT_ONT_MODERN":"300 bp fragments, ~5% ONT-modern error","SHORT_ONT_LEGACY":"300 bp fragments, ~10% ONT-legacy error","SHORT_HIGH_INDEL_LOW_SUB":"300 bp fragments, ~8% indel-only","SHORT_HIGH_SUB_LOW_INDEL":"300 bp fragments, ~5% sub-only","MEDIUM_HIFI":"5 kbp fragments, ~0.2% HiFi-style error, 30 kbp reference","MEDIUM_CCS":"5 kbp fragments, ~1.5% CCS-style error","MEDIUM_ONT_MODERN":"5 kbp fragments, ~5% ONT-modern error","MEDIUM_ONT_LEGACY":"5 kbp fragments, ~10% ONT-legacy error","MEDIUM_HIGH_INDEL_LOW_SUB":"5 kbp fragments, ~8% indel-only","MEDIUM_HIGH_SUB_LOW_INDEL":"5 kbp fragments, ~5% sub-only","LONG_HIFI":"50 kbp fragments, ~0.2% HiFi error, 250 kbp reference","LONG_CCS":"50 kbp fragments, ~1.5% CCS error","LONG_ONT_MODERN":"50 kbp fragments, ~5% ONT-modern error","LONG_HIGH_SUB_LOW_INDEL":"50 kbp fragments, ~5% sub-only","VERY_LONG_HIFI":"1 Mbp fragments, ~0.2% HiFi error","VERY_LONG_CCS":"1 Mbp fragments, ~1.5% CCS error","VERY_LONG_ONT_MODERN":"1 Mbp fragments, ~5% ONT-modern error","VERY_LONG_HIGH_SUB_LOW_INDEL":"1 Mbp fragments, ~5% sub-only","XL_HIFI":"5 Mbp fragments, ~0.2% HiFi error","FAST_LONG":"500 kbp fragments, ~0.2% HiFi error","FAST_VERY_LONG":"5 Mbp fragments, ~0.2% HiFi error","XL_CCS":"5 Mbp fragments, ~1.5% CCS error","XXL_HIFI":"Single-group 0.5 Gbp reference to 5 Mbp fragment, ~0.2% HiFi error; serial grouping leaves admission headroom for the Vulkan query sketch nested under the segmented target-wave permit","XXL_HIFI_PAIRED":"Single-group copy of XXL_HIFI for 11-repeat paired serial acceptance; identical generated workload and seed","REPR_STORAGE_K7_MEDIUM":"K=7 / MEDIUM HiFi — exercises 32-bit MinimizerRepr<15,7>","REPR_STORAGE_K27_XL":"K=27 / XL HiFi — exercises 128-bit MinimizerRepr<28,27>","RMQ_REPRO_LONG_CCS":"Pinned (LONG, CCS) seed that previously segfaulted on bioseq-RMQ chaining","CURATED_UNIQUE_FRAGMENT":"Single error-free fragment from a 2 kbp random reference — trivial alignment","CURATED_SEAL_BATCH":"SEAL-style 8-fragment batch with mild error and reverse-complement","SIMD_CHAINING_ENDPOINT_FIXED_CORPUS":"One source-fixed corpus callback spanning nearby short exact-read sizes, reverse-strand and nonzero-penalty fixed seeds, a structurally constructed cutoff/rescue case, generated error profiles, constructed repetitive decoys, and SHORT through report-76 XXL_HIFI endpoint sizes; generic fixed-seed cases make no unverified anchor-shape claim, and all targets fit bundled minimap2's signed-32-bit ABI","GROUPED32_LOCAL32_ONE_70K":"One long 70k-word scatter-false span; primary contiguous-throughput case","GROUPED32_LOCAL32_256_X_256":"256 medium controls with 256 contiguous local32 words each","GROUPED32_LOCAL32_4096_X_16":"4096 short controls; exposes the SIMD cutoff and per-span reduction cost","GROUPED32_LOCAL32_65536_X_1":"Singleton negative control; vector candidates should naturally remain on scalar boundaries","GROUPED32_LOCAL32_ZIPF_64K":"Deterministic skewed control lengths summing to 65536 local32 words"},"execution_tuples":[{"tuple":{"simd_chaining_endpoint_qualification":{"_":0}},"test_cases":{}},{"tuple":{"simd_chaining_endpoint_zero_reference":{"_":0}},"test_cases":{}}],"raw_samples":[]}}}