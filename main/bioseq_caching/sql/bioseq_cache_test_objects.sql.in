CREATE FUNCTION bioseq_cache_test.assert_prepared_reusable_plan(
    prepared_name text,
    expected_nodes integer,
    expected_selected_branches integer)
RETURNS void
LANGUAGE plpgsql VOLATILE PARALLEL UNSAFE
AS $$
DECLARE
    plan_line text;
    coverage_nodes integer := 0;
    runtime_recipes integer := 0;
    selected_branches integer := 0;
BEGIN
    FOR plan_line IN EXECUTE format(
        'EXPLAIN (COSTS OFF) EXECUTE %I', prepared_name)
    LOOP
        IF plan_line LIKE '%Custom Scan (BioseqReusableCoverageScan)%' THEN
            coverage_nodes := coverage_nodes + 1;
        END IF;
        IF btrim(plan_line) = 'Provider Runtime Recipe Valid: true' THEN
            runtime_recipes := runtime_recipes + 1;
        END IF;
        IF btrim(plan_line) ~ '^Selected Cache Branches: [0-9]+$' THEN
            selected_branches := selected_branches
                + split_part(btrim(plan_line), ': ', 2)::integer;
        END IF;
    END LOOP;
    IF coverage_nodes <> expected_nodes
        OR runtime_recipes <> expected_nodes
        OR selected_branches <> expected_selected_branches THEN
        RAISE EXCEPTION
            'unexpected reusable plan shape: nodes %, recipes %, branches %',
            coverage_nodes, runtime_recipes, selected_branches;
    END IF;
END;
$$;

