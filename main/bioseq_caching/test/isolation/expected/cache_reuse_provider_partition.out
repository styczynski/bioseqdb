step partition_pinned_state: 
  SELECT
    count(*) FILTER (
      WHERE kind = 'ReusableCoverage'
        AND state = 'COMPLETE'
        AND readers = 1
        AND sql LIKE '%cache_provider_partition_source_a%') = 1
      AS a_reader_pinned,
    count(*) FILTER (
      WHERE kind = 'ReusableCoverage'
        AND state = 'COMPLETE'
        AND readers = 0
