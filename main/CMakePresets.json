{
    "version": 3,
    "configurePresets": [
      {
        "name": "dev",
        "displayName": "Default development config",
         "description": "Default build using Ninja generator",
        "generator": "Ninja",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_BUILD_TYPE": "Debug"
        }
      },
      {
        "name": "dev-opt",
        "displayName": "Default development config",
         "description": "Default build using Ninja generator",
        "generator": "Ninja",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_BUILD_TYPE": "RelWithDebInfo",
          "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer -fsanitize=address -g",
          "CMAKE_LINKER_FLAGS": "-fno-omit-frame-pointer -fsanitize=address -g"
        }
      },
      {
        "name": "prod",
        "displayName": "Default release config",
         "description": "Default build using Ninja generator",
        "generator": "Ninja",
        "cacheVariables": {
          "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
          "CMAKE_BUILD_TYPE": "Release"
        }
      }
    ]
  }