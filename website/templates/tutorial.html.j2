{% extends "base.html.j2" %}
{% block main %}
<section data-page-panel data-screen-label="Docs · Tutorial" class="dd-s0040 design-page">
  <header data-reveal class="dd-s0041 design-page-header">
    <nav aria-label="Breadcrumb" class="dd-s0042 design-breadcrumb">
      {% for crumb in page.breadcrumb %}<a href="{{ crumb.url }}">{{ crumb.name }}</a><span class="dd-s0043" aria-hidden="true">/</span>{% endfor %}
    </nav>
    <h1 class="dd-s0046">{{ page.title }}</h1>
    {% if page.description != page.title %}<p class="dd-s0047">{{ page.description }}</p>{% endif %}
  </header>

  <div class="docs-content tutorial-body">{{ page.body_html }}</div>

  {% if page.external_sources_html %}{{ page.external_sources_html }}{% endif %}

  {% if page.previous_url or page.next_url %}
  <nav class="tutorial-pagination" aria-label="Previous and next tutorial">
    {% if page.previous_url %}<a href="{{ page.previous_url }}" class="tutorial-pagination-link tutorial-pagination-previous" rel="prev"><span class="tutorial-pagination-label">&#8592; Previous</span><span class="tutorial-pagination-title">{% if page.previous_title %}{{ page.previous_title }}{% else %}Previous tutorial{% endif %}</span></a>{% endif %}
    {% if page.next_url %}<a href="{{ page.next_url }}" class="tutorial-pagination-link tutorial-pagination-next" rel="next"><span class="tutorial-pagination-label">Next &#8594;</span><span class="tutorial-pagination-title">{% if page.next_title %}{{ page.next_title }}{% else %}Next tutorial{% endif %}</span></a>{% endif %}
  </nav>
  {% endif %}
</section>
{% endblock %}
