<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="{{ page.canonical }}">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page.canonical }}">
<meta property="og:image" content="{{ site.social_image_url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page.title }}">
<meta name="twitter:description" content="{{ page.description }}">
<meta name="twitter:image" content="{{ site.social_image_url }}">
<link rel="icon" href="{{ site.favicon_url }}">
<link rel="stylesheet" href="{{ site.prism_css_url }}">
<link rel="stylesheet" href="{{ site.css_url }}">
{% block design_css %}<link rel="stylesheet" href="{{ site.assets_base_url }}css/docs-design.css">{% endblock %}
<link rel="stylesheet" href="{{ site.assets_base_url }}css/code-theme.css">
<link rel="stylesheet" href="{{ site.assets_base_url }}css/project-content.css">
<link rel="stylesheet" href="{{ site.assets_base_url }}vendor/katex/katex.min.css">
<link rel="stylesheet" href="{{ site.assets_base_url }}css/project-benchmarks.css">
<link rel="stylesheet" href="{{ site.assets_base_url }}css/site-header.css">
<link rel="stylesheet" href="{{ site.assets_base_url }}css/responsive.css">
</head>
<body id="page-top" class="{% block body_class %}docs-design-page{% endblock %}">
{% block skip_link %}<a class="skip-link" href="#doc-main">Skip to main content</a>{% endblock %}
{% block page %}
<div data-screen-label="BioseqDB documentation" class="dd-s0001">

  <!-- ============ TOP NAV ============ -->
  <header id="dnav" class="site-header" data-site-header data-search-loading="{{ landing.search.loading_search_index }}" data-search-no-matches="{{ landing.search.no_matches_for }}" data-search-unavailable="{{ landing.search.search_index_is_unavailable }}" data-search-error="{{ landing.search.search_is_temporarily_unavailable }}" data-search-tutorial="{{ landing.search.tutorial }}" data-search-function="{{ landing.search.function }}" data-search-class="{{ landing.search.class }}" data-search-type="{{ landing.search.type }}" data-search-setting="{{ landing.search.setting }}" data-search-sql="{{ landing.search.sql_object }}" data-search-domain-sql="{{ landing.search.sql }}" data-search-domain-documentation="{{ landing.search.documentation }}" data-search-domain-cpp="{{ landing.search.c }}">
  <div class="site-header-inner">
    <button type="button" data-menu class="site-menu" aria-label="{{ landing.header.documentation_menu }}"><span></span><span></span><span></span></button>
    <a data-nav class="site-brand" href="{{ site.base_path }}" aria-label="{{ landing.header.bioseqdb_home }}">
      <img src="{{ site.assets_base_url }}bioseq-mark.svg" width="30" height="30" alt="">
      <span>{{ landing.header.bioseq }}<span>{{ landing.header.db }}</span></span>
    </a>
    <nav data-topnav class="site-navigation" aria-label="{{ landing.header.main_navigation }}">
      <a href="{{ nav.documentation }}" data-nav-prefix="{{ site.base_path }}{{ site.version }}/">{{ landing.header.docs }}</a>
      <a href="{{ site.base_path }}benchmarks/">{{ landing.header.benchmarks }}</a>
    </nav>
    <div data-search-wrap class="site-search-wrap">
      <div data-search-box class="site-search-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"></circle><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
        <input id="doc-search" type="search" role="combobox" aria-label="{{ landing.header.search_documentation }}" aria-autocomplete="list" aria-controls="search-dd" aria-expanded="false" data-search-index="{{ site.search_index_url }}" placeholder="{{ landing.header.search_docs_functions_types }}" autocomplete="off" spellcheck="false">
        <kbd>{{ landing.header.symbol }}</kbd>
      </div>
      <div id="search-dd" class="site-search-dropdown" role="listbox" aria-label="{{ landing.header.search_results }}"></div>
    </div>
    <div data-ver-wrap class="site-version-wrap">
      <button id="ver-btn" type="button" class="site-version-button">{{ site.version }} <span class="site-version-status">{{ site.status_label }}</span><span data-caret class="site-version-caret"></span></button>
      <div id="ver-menu" class="site-version-menu" data-versions-url="{{ site.versions_url }}">
        <a data-ver href="{{ nav.documentation }}" aria-current="page" class="site-version-link">{{ site.version }} <span class="site-version-current">{{ landing.header.current }}</span></a>
        <a data-ver-all href="{{ site.versions_page_url }}" class="site-version-link">{{ landing.header.all_versions }}</a>
      </div>
    </div>
    <a data-ghbtn class="site-github" href="{{ site.repository_url }}" rel="noreferrer">{{ landing.header.github }}</a>
  </div>
</header>

  <!-- ============ BODY GRID ============ -->
  <div data-bodygrid class="dd-s0032">

    <!-- ===== LEFT SIDEBAR ===== -->
    <aside id="sidebar" class="dd-s0033">
      {% if page.doc_nav %}
      {% for section in page.doc_nav %}
      <div data-chapter>
        <button type="button" data-chap-toggle aria-expanded="true" class="dd-s0034">
          <span data-caret class="dd-s0035"></span>{{ section.label }}
        </button>
        <div data-chap-list class="dd-s0036">
          {% for item in section.items %}<a data-doc-link href="{{ item.url }}" class="dd-s0037">{{ item.label }}</a>{% endfor %}
        </div>
      </div>
      {% endfor %}
      {% else %}
      <div data-chapter>
        <div data-static-chapter class="dd-s0036">
          <a data-doc-link href="{{ nav.documentation }}" class="dd-s0037">Documentation</a>
          <a data-doc-link href="{{ nav.reference }}" class="dd-s0037">API reference</a>
        </div>
      </div>
      {% endif %}
      <div class="dd-s0038">
        <a href="{{ site.repository_url }}" rel="noreferrer" class="dd-s0039">Edit on GitHub</a>
      </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="doc-main" class="dd-s0040">
      {% block main %}{% endblock %}
    </main>

    <!-- ===== RIGHT TOC ===== -->
    <aside data-rightrail class="dd-s0234">
      <div class="dd-s0235">On this page</div>
      <div id="toc-list" class="dd-s0236">
        {% if page.on_this_page %}{% for heading in page.on_this_page %}<a data-toc-link data-level="{{ heading.level }}" href="#{{ heading.anchor }}">{{ heading.text }}</a>{% endfor %}{% endif %}
      </div>
    </aside>

  </div>

  <!-- ============ SITE FOOTER ============ -->
  <footer data-screen-label="Docs · Footer" class="dd-s0237">
    <div aria-hidden="true" class="dd-s0238">BioseqDB</div>

    <div class="dd-s0239">
      <div data-footcols class="dd-s0240">
        <div>
          <div class="dd-s0241">
            <img src="{{ site.assets_base_url }}bioseq-mark.svg" width="32" height="32" alt="BioseqDB logo" class="dd-s0007">
            <span class="dd-s0242">Bioseq<span class="dd-s0243">DB</span></span>
            <span class="dd-s0244">DOCS</span>
          </div>
          <p class="dd-s0245">SQL-native search for biological sequence data. Load, store, and query FASTA and FASTQ beside their metadata.</p>
          <span class="dd-s0246"><span class="dd-s0247"></span>Free &amp; open source</span>
        </div>

        <div>
          <div class="dd-s0248">Documentation</div>
          <div class="dd-s0249">
            {% if page.doc_nav %}
            {% for section in page.doc_nav %}{% for item in section.items %}<a href="{{ item.url }}" class="dd-s0250 dd-h009">{{ item.label }}</a>{% endfor %}{% endfor %}
            {% else %}<a href="{{ nav.documentation }}" class="dd-s0250 dd-h009">Documentation home</a><a href="{{ nav.reference }}" class="dd-s0250 dd-h009">API reference</a>{% endif %}
          </div>
        </div>

        <div>
          <div class="dd-s0248">Explore</div>
          <div class="dd-s0249">
            <a href="{{ site.base_path }}" class="dd-s0250 dd-h009">Product home</a>
            <a href="{{ site.base_path }}#workflow" class="dd-s0250 dd-h009">Workflow</a>
            <a href="{{ site.base_path }}#examples" class="dd-s0250 dd-h009">Examples</a>
            <a href="{{ site.base_path }}#index" class="dd-s0250 dd-h009">Index</a>
            <a href="{{ site.base_path }}#scale" class="dd-s0250 dd-h009">Scale</a>
          </div>
        </div>

        <div>
          <div class="dd-s0248">Project</div>
          <div class="dd-s0249">
            <a data-nav href="{{ nav.documentation }}" class="dd-s0250 dd-h009">Documentation</a>
            <a href="{{ site.repository_url }}" rel="noreferrer" class="dd-s0251">GitHub</a>
            <span class="dd-s0252">{{ site.status_label }} &middot; {{ site.version }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="dd-s0253">
      <div class="dd-s0254"></div>
      <div class="dd-s0255">
        <span class="dd-s0256">&copy; {{ site.copyright_year }} {{ site.copyright_holder }} &mdash; an independent open-source project.</span>
        <nav class="dd-s0257">
          <a href="{{ site.repository_url }}/blob/main/LICENSE" rel="noreferrer" class="dd-s0258 dd-h010">License (MIT)</a>
          <a href="{{ site.versions_page_url }}" class="dd-s0258 dd-h010">Versions</a>
          <a data-totop href="#page-top" class="dd-s0258 dd-h010">Back to top ↑</a>
        </nav>
      </div>
    </div>
  </footer>

  <div data-backdrop class="dd-s0259"></div>

  <!-- ===== ENTITY POPOVER ===== -->


</div>
{% endblock %}
<div id="entity-pop"></div>
{% if page.jsonld %}<script type="application/ld+json">{{ page.jsonld }}</script>{% endif %}
<script src="{{ site.assets_base_url }}js/prism-init.js"></script>
<script src="{{ site.prism_js_url }}"></script>
<script src="{{ site.assets_base_url }}js/prism-languages.js"></script>
<script src="{{ site.assets_base_url }}vendor/katex/katex.min.js"></script>
<script src="{{ site.assets_base_url }}js/project-math.js"></script>
<script type="module" src="{{ site.assets_base_url }}js/project-benchmarks.mjs"></script>
<script type="module" src="{{ site.js_url }}"></script>
<script type="module" src="{{ site.assets_base_url }}js/site-header.mjs"></script>
<script type="module" src="{{ site.assets_base_url }}js/docs-design.mjs"></script>
{% block design_script %}{% endblock %}
</body>
</html>
