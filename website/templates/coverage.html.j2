{% extends "base.html.j2" %}
{% block main %}
<section data-page-panel data-screen-label="Docs · Coverage" class="dd-s0040 design-page">
  <header data-reveal class="dd-s0041 design-page-header"><h1 class="dd-s0045">Documentation coverage</h1><p class="dd-s0046">{{ page.documented_total }} of {{ page.public_total }} public entities documented.</p></header>
  {% if page.groups %}<section class="design-entity-section"><h2 class="hx design-section-heading" id="by-module-and-sql-domain" data-toc data-title="By module and SQL domain">By module and SQL domain<a data-hash href="#by-module-and-sql-domain" class="dd-s0052">#</a></h2><div class="design-table-wrap"><table class="design-table"><thead><tr><th scope="col">Group</th><th scope="col">Documented</th><th scope="col">Public</th></tr></thead><tbody>{% for group in page.groups %}<tr><td><code>{{ group.group }}</code></td><td>{{ group.documented_total }}</td><td>{{ group.public_total }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
  {% if page.fatal_missing %}<section class="design-entity-section design-severity-error"><h2 class="hx design-section-heading" id="required-but-undocumented" data-toc data-title="Required but undocumented">Required but undocumented<a data-hash href="#required-but-undocumented" class="dd-s0052">#</a></h2><ul class="design-code-list">{% for id in page.fatal_missing %}<li><code>{{ id }}</code></li>{% endfor %}</ul></section>{% endif %}
  {% if page.missing %}<section class="design-entity-section"><h2 class="hx design-section-heading" id="missing-summaries" data-toc data-title="Missing summaries">Missing summaries<a data-hash href="#missing-summaries" class="dd-s0052">#</a></h2><ul class="design-code-list">{% for id in page.missing %}<li><code>{{ id }}</code></li>{% endfor %}</ul></section>{% endif %}
  {% if page.missing_parameters %}<section class="design-entity-section"><h2 class="hx design-section-heading" id="missing-parameter-documentation" data-toc data-title="Missing parameter documentation">Missing parameter documentation<a data-hash href="#missing-parameter-documentation" class="dd-s0052">#</a></h2><ul class="design-code-list">{% for id in page.missing_parameters %}<li><code>{{ id }}</code></li>{% endfor %}</ul></section>{% endif %}
  {% if page.missing_returns %}<section class="design-entity-section"><h2 class="hx design-section-heading" id="missing-return-documentation" data-toc data-title="Missing return documentation">Missing return documentation<a data-hash href="#missing-return-documentation" class="dd-s0052">#</a></h2><ul class="design-code-list">{% for id in page.missing_returns %}<li><code>{{ id }}</code></li>{% endfor %}</ul></section>{% endif %}
</section>
{% endblock %}
