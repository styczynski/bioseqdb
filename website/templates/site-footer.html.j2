<footer data-screen-label="Docs · Footer" class="dd-s0237">
    <div aria-hidden="true" class="dd-s0238">BioseqDB</div>

    <div class="dd-s0239">
      <div data-footcols class="dd-s0240">
        <div>
          <div class="dd-s0241">
            <img src="{{ site.assets_base_url }}bioseq-mark.svg" width="32" height="32" alt="BioseqDB logo" class="dd-s0007">
            <span class="dd-s0242">Bioseq<span class="dd-s0243">DB</span></span>
            <span class="dd-s0244">DOCS</span>
          </div>
          <p class="dd-s0245">SQL-native search for biological sequence data. Load, store, and query FASTA and FASTQ beside their metadata.</p>
          <span class="dd-s0246"><span class="dd-s0247"></span>Free &amp; open source</span>
        </div>

        <div>
          <div class="dd-s0248">Documentation</div>
          <div class="dd-s0249">
            {% if page.doc_nav %}
            {% for section in page.doc_nav %}{% for item in section.items %}<a href="{{ item.url }}" class="dd-s0250 dd-h009">{{ item.label }}</a>{% endfor %}{% endfor %}
            {% else %}<a href="{{ nav.documentation }}" class="dd-s0250 dd-h009">Documentation home</a><a href="{{ nav.reference }}" class="dd-s0250 dd-h009">API reference</a>{% endif %}
          </div>
        </div>

        <div>
          <div class="dd-s0248">Explore</div>
          <div class="dd-s0249">
            <a href="{{ site.base_path }}" class="dd-s0250 dd-h009">Product home</a>
            <a href="{{ site.base_path }}#workflow" class="dd-s0250 dd-h009">Workflow</a>
            <a href="{{ site.base_path }}#examples" class="dd-s0250 dd-h009">Examples</a>
            <a href="{{ site.base_path }}#index" class="dd-s0250 dd-h009">Index</a>
            <a href="{{ site.base_path }}#scale" class="dd-s0250 dd-h009">Scale</a>
          </div>
        </div>

        <div>
          <div class="dd-s0248">Project</div>
          <div class="dd-s0249">
            <a data-nav href="{{ nav.documentation }}" class="dd-s0250 dd-h009">Documentation</a>
            <a href="{{ site.repository_url }}" rel="noreferrer" class="dd-s0251">GitHub</a>
            <span class="dd-s0252">{{ site.status_label }} &middot; {{ site.version }}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="dd-s0253">
      <div class="dd-s0254"></div>
      <div class="dd-s0255">
        <span class="dd-s0256">&copy; {{ site.copyright_year }} {{ site.copyright_holder }}</span>
        <nav class="site-footer-links dd-s0257">
          <a href="{{ site.repository_url }}/blob/main/LICENSE" rel="noreferrer" class="dd-s0258 dd-h010">{{ landing.footer.license_mit }}</a>
          <a href="{{ site.versions_page_url }}" class="dd-s0258 dd-h010">Versions</a>
          <a href="{{ landing.social.crunchbase_url }}" rel="noreferrer" class="dd-s0258 dd-h010 site-footer-profile">{{ landing.footer.crunchbase }}</a>
          <a href="{{ landing.social.medium_url }}" rel="noreferrer" class="dd-s0258 dd-h010 site-footer-profile">{{ landing.footer.medium }}</a>
          <a href="{{ landing.social.linkedin_url }}" rel="noreferrer" class="dd-s0258 dd-h010 site-footer-profile">{{ landing.footer.bioseqdb_linkedin }}</a>
          <a href="{{ landing.social.author_linkedin_url }}" rel="noreferrer" class="dd-s0258 dd-h010 site-footer-profile">{{ landing.footer.linkedin }}</a>
          <a href="{{ landing.social.author_github_url }}" rel="noreferrer" class="dd-s0258 dd-h010 site-footer-profile">{{ landing.footer.author_github }}</a>
          <a data-totop href="#page-top" class="dd-s0258 dd-h010">Back to top ↑</a>
        </nav>
      </div>
    </div>
  </footer>
